        { "hebraico": "רְח֤וּם", "transliteral": "rə-ḥūm", "traducao_palavra": "Reum" },
        { "hebraico": "בְּעֵל־טְעֵם֙", "transliteral": "bə-ʿēl-ṭə-ʿēm", "traducao_palavra": "comandante" },
        { "hebraico": "וְשִׁמְשַׁ֣י", "transliteral": "wə-šim-šay", "traducao_palavra": "e Sinsai" },
        { "hebraico": "סָפְרָ֔א", "transliteral": "sā-p̄ə-rā", "traducao_palavra": "o escrivão" },
        { "hebraico": "וּשְׁאָ֖ר", "transliteral": "ū-šə-ʾār", "traducao_palavra": "e o restante de" },
        { "hebraico": "כְּנָוָתְהֹ֑ון", "transliteral": "kə-nā-wā-ṯə-hō-wn", "traducao_palavra": "seus colegas" }
      ]
    },
    "10": {
      "traducao_completa": "e as outras nações que o grande e honrado Osnapar transportou, e que fez habitar na cidade de Samaria e nas outras regiões dalém do rio, etc.",
      "palavras": [
        { "hebraico": "וּשְׁאָ֣ר", "transliteral": "ū-šə-ʾār", "traducao_palavra": "e o restante de" },
        { "hebraico": "אֻמַּיָּ֗א", "transliteral": "ʾum-may-yā", "traducao_palavra": "as nações" },
        { "hebraico": "דִּ֤י", "transliteral": "dî", "traducao_palavra": "que" },
        { "hebraico": "הַגְלִ֧י", "transliteral": "haḡ-lî", "traducao_palavra": "transportou" },
        { "hebraico": "אָסְנַפַּר֙", "transliteral": "ʾās-nap-par", "traducao_palavra": "Osnapar" },
        { "hebraico": "רַבָּ֣א", "transliteral": "rab-bā", "traducao_palavra": "o grande" },
        { "hebraico": "וְיַקִּירָ֔א", "transliteral": "wə-yaq-qî-rā", "traducao_palavra": "e honrado" }
      ]
    },
    "11": {
      "traducao_completa": "Esta é a cópia da carta que enviaram ao rei Artaxerxes: Teus servos, os homens dalém do rio, etc.",
      "palavras": [
        { "hebraico": "דְּנָה֙", "transliteral": "də-nāh", "traducao_palavra": "esta [é]" },
        { "hebraico": "פַּרְשֶׁ֣גֶן", "transliteral": "par-še-ḡen", "traducao_palavra": "a cópia de" },
        { "hebraico": "אִגַּרְתָּ֔א", "transliteral": "ʾig-gar-tā", "traducao_palavra": "a carta" }
      ]
    },
    "12": {
      "traducao_completa": "Saiba o rei que os judeus que subiram de ti a nós vieram a Jerusalém e reedificam aquela rebelde e má cidade, e vão restaurando os seus muros, e reparando os seus fundamentos.",
      "palavras": [
        { "hebraico": "יְדִ֙יעַ֙", "transliteral": "yə-ḏî-aʿ", "traducao_palavra": "seja sabido" },
        { "hebraico": "לֶהֱוֵ֣א", "transliteral": "le-hĕ-wē", "traducao_palavra": "que seja" },
        { "hebraico": "לְמַלְכָּ֔א", "transliteral": "lə-mal-kā", "traducao_palavra": "ao rei" }
      ]
    },
    "13": {
      "traducao_completa": "Agora saiba o rei que, se aquela cidade se reedificar, e os muros se restaurarem, eles não pagarão os direitos, os tributos e os pedágios; e assim se danificará a fazenda dos reis.",
      "palavras": [
        { "hebraico": "כְּעַ֞ן", "transliteral": "kə-ʿan", "traducao_palavra": "agora" },
        { "hebraico": "יְדִ֙יעַ֙", "transliteral": "yə-ḏî-aʿ", "traducao_palavra": "sabido" },
        { "hebraico": "לֶהֱוֵ֣א", "transliteral": "le-hĕ-wē", "traducao_palavra": "seja" },
        { "hebraico": "לְמַלְכָּ֔א", "transliteral": "lə-mal-kā", "traducao_palavra": "ao rei" }
      ]
    },
    "14": {
      "traducao_completa": "Agora, pois, como comemos o sal do palácio, e não nos convém ver a desonra do rei, por isso enviamos a dar aviso ao rei,",
      "palavras": [
        { "hebraico": "כְּעַ֗ן", "transliteral": "kə-ʿan", "traducao_palavra": "agora" },
        { "hebraico": "כָּל־קֳבֵ֞ל", "transliteral": "kāl-qo-ḇêl", "traducao_palavra": "visto que" },
        { "hebraico": "דִּֽי־מְלַ֧ח", "transliteral": "dî-mə-laḥ", "traducao_palavra": "o sal de" },
        { "hebraico": "הֵיכְלָ֣א", "transliteral": "hê-ḵə-lā", "traducao_palavra": "o palácio" }
      ]
    },
    "15": {
      "traducao_completa": "para que se busque no livro das crônicas de teus pais; e acharás no livro das crônicas, e saberás que aquela cidade é uma cidade rebelde, e danosa a reis e províncias, e que nela houve rebelião em tempos antigos; por que foi aquela cidade destruída.",
      "palavras": [
        { "hebraico": "דִּ֠י", "transliteral": "dî", "traducao_palavra": "para que" },
        { "hebraico": "יְבַקַּ֨ר", "transliteral": "yə-ḇaq-qar", "traducao_palavra": "se busque" },
        { "hebraico": "בִּֽסְפַר־", "transliteral": "bis-p̄ar-", "traducao_palavra": "no livro de" },
        { "hebraico": "דָּכְרָנַיָּ֜א", "transliteral": "dā-ḵə-rā-nay-yā", "traducao_palavra": "as memórias" }
      ]
    },
    "16": {
      "traducao_completa": "Nós fazemos saber ao rei que, se aquela cidade se reedificar, e os seus muros se restaurarem, não terás porção alguma desta banda do rio.",
      "palavras": [
        { "hebraico": "מְהֹודְעִ֤ין", "transliteral": "mə-hō-w-ḏə-ʿîn", "traducao_palavra": "fazemos saber" },
        { "hebraico": "אֲנַ֙חְנָה֙", "transliteral": "ʾă-naḥ-nāh", "traducao_palavra": "nós" },
        { "hebraico": "לְמַלְכָּ֔א", "transliteral": "lə-mal-kā", "traducao_palavra": "ao rei" }
      ]
    },
    "17": {
      "traducao_completa": "O rei enviou esta resposta a Reum, o comandante, e a Sinsai, o escrivão, e aos seus outros companheiros que habitavam em Samaria, e aos demais que estavam dalém do rio: Paz e saúde.",
      "palavras": [
        { "hebraico": "פִּתְגָ֞מָא", "transliteral": "piṯ-ḡā-mā", "traducao_palavra": "uma resposta" },
        { "hebraico": "שְׁלַ֣ח", "transliteral": "šə-laḥ", "traducao_palavra": "enviou" },
        { "hebraico": "מַלְכָּ֗א", "transliteral": "mal-kā", "traducao_palavra": "o rei" }
      ]
    },
    "18": {
      "traducao_completa": "A carta que nos enviastes foi distintamente lida perante mim.",
      "palavras": [
        { "hebraico": "נִשְׁתְּוָנָ֖א", "transliteral": "niš-tə-wā-nā", "traducao_palavra": "a carta" },
        { "hebraico": "דִּ֣י", "transliteral": "dî", "traducao_palavra": "que" },
        { "hebraico": "שְׁלַחְתּוּן", "transliteral": "šə-laḥ-tūn", "traducao_palavra": "enviastes" }
      ]
    },
    "19": {
      "traducao_completa": "E por mim se deu ordem, e buscaram, e acharam que aquela cidade, desde tempos antigos, se levantou contra os reis, e que nela se tem feito rebelião e sedição.",
      "palavras": [
        { "hebraico": "וּמִנִּי֙", "transliteral": "ū-min-nî", "traducao_palavra": "e por mim" },
        { "hebraico": "שִׂ֣ים", "transliteral": "śîm", "traducao_palavra": "foi dado" },
        { "hebraico": "טְעֵ֔ם", "transliteral": "ṭə-ʿēm", "traducao_palavra": "um decreto" }
      ]
    },
    "20": {
      "traducao_completa": "E houve reis poderosos sobre Jerusalém, que dominaram em tudo o que está além do rio; e se lhes pagavam direitos, tributos e pedágios.",
      "palavras": [
        { "hebraico": "וּמַלְכִ֣ין", "transliteral": "ū-mal-ḵîn", "traducao_palavra": "e reis" },
        { "hebraico": "תַּקִּיפִ֔ין", "transliteral": "taq-qî-p̄în", "traducao_palavra": "poderosos" },
        { "hebraico": "הֲוֹ֖ו", "transliteral": "hă-wō-w", "traducao_palavra": "houve" }
      ]
    },
    "21": {
      "traducao_completa": "Agora, pois, dai ordem para que aqueles homens parem, e não se edifique aquela cidade, até que por mim se dê outra ordem.",
      "palavras": [
        { "hebraico": "כְּעַן֙", "transliteral": "kə-ʿan", "traducao_palavra": "agora" },
        { "hebraico": "שִׂ֣ימוּ", "transliteral": "śî-mū", "traducao_palavra": "dai" },
        { "hebraico": "טְעֵ֔ם", "transliteral": "ṭə-ʿēm", "traducao_palavra": "ordem" }
      ]
    },
    "22": {
      "traducao_completa": "E guardai-vos de cometerdes erro nisto; por que cresceria o dano para prejuízo dos reis?",
      "palavras": [
        { "hebraico": "וּזְהִירִ֥ין", "transliteral": "ū-zə-hî-rîn", "traducao_palavra": "e sede cautelosos" },
        { "hebraico": "הֱוֹ֛ו", "transliteral": "hĕ-wō-w", "traducao_palavra": "para ser" }
      ]
    },
    "23": {
      "traducao_completa": "Então, logo que a cópia da carta do rei Artaxerxes se leu perante Reum, e Sinsai, o escrivão, e seus companheiros, apressadamente foram eles a Jerusalém, aos judeus, e os impediram com força e com poder.",
      "palavras": [
        { "hebraico": "אֱדַ֗יִן", "transliteral": "ʾĕ-ḏa-yin", "traducao_palavra": "então" },
        { "hebraico": "מִן־", "transliteral": "min-", "traducao_palavra": "desde" },
        { "hebraico": "דִּ֞י", "transliteral": "dî", "traducao_palavra": "quando" },
        { "hebraico": "פַּרְשֶׁ֤גֶן", "transliteral": "par-še-ḡen", "traducao_palavra": "a cópia de" }
      ]
    },
    "24": {
      "traducao_completa": "Então cessou a obra da casa de Deus, que está em Jerusalém; e cessou até ao segundo ano do reinado de Dario, rei da Pérsia.",
      "palavras": [
        { "hebraico": "בֵּאדַ֙יִן֙", "transliteral": "bê-ḏa-yin", "traducao_palavra": "então" },
        { "hebraico": "בְּטֵלַ֔ת", "transliteral": "bə-ṭê-laṯ", "traducao_palavra": "cessou" },
        { "hebraico": "עֲבִידַת֙", "transliteral": "ʿă-ḇî-ḏaṯ", "traducao_palavra": "a obra de" },
        { "hebraico": "בֵּית־", "transliteral": "bêṯ-", "traducao_palavra": "casa de" },
        { "hebraico": "אֱלָהָ֔א", "transliteral": "ʾĕ-lā-hā", "traducao_palavra": "Deus" },
        { "hebraico": "דִּ֖י", "transliteral": "dî", "traducao_palavra": "que" },
        { "hebraico": "בִּירוּשְׁלֶ֑ם", "transliteral": "bî-rū-šə-lem", "traducao_palavra": "em Jerusalém" },
        { "hebraico": "וַהֲוָ֣ת", "transliteral": "wa-hă-wāṯ", "traducao_palavra": "e ela foi" },
        { "hebraico": "בָּֽטְלָ֔א", "transliteral": "bā-ṭə-lā", "traducao_palavra": "cessada" },
        { "hebraico": "עַ֚ד", "transliteral": "ʿaḏ", "traducao_palavra": "até" },
        { "hebraico": "שְׁנַ֣ת", "transliteral": "šə-naṯ", "traducao_palavra": "o ano de" },
        { "hebraico": "תַּרְתֵּ֔ין", "transliteral": "tar-tên", "traducao_palavra": "dois" },
        { "hebraico": "לְמַלְכ֖וּת", "transliteral": "lə-mal-ḵūṯ", "traducao_palavra": "para o reinado de" },
        { "hebraico": "דָּרְיָ֥וֶשׁ", "transliteral": "dā-rə-yā-weš", "traducao_palavra": "Dario" },
        { "hebraico": "מֶֽלֶךְ־", "transliteral": "me-leḵ-", "traducao_palavra": "rei de" },
        { "hebraico": "פָּרָֽס׃", "transliteral": "pā-rās", "traducao_palavra": "Pérsia" }
      ]
    }
  }
