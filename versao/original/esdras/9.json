        { "hebraico": "אֱלֹהֵ֗ינוּ", "transliteral": "ʾĕ-lō-hê-nū", "traducao_palavra": "nosso Deus" },
        { "hebraico": "חָׂשַ֧כְתָּֽ", "transliteral": "ḥā-śaḵ-tā", "traducao_palavra": "poupaste/retiveste" },
