        { "hebraico": "בִיהוּד֙", "transliteral": "ḇî-hūḏ", "traducao_palavra": "em Judá" },
        { "hebraico": "וּבִירֽוּשְׁלֶ֔ם", "transliteral": "ū-ḇî-rū-šə-lem", "traducao_palavra": "e em Jerusalém" },
        { "hebraico": "בְּשֵׁ֛ם", "transliteral": "bə-šēm", "traducao_palavra": "em nome de" },
