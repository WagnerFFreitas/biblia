{
  "livro": "Esdras - עֶזְרָא - ʿEzrāʾ",
  "capítulo": 5,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "E os profetas Ageu, o profeta, e Zacarias, filho de Iddo, profetizaram aos judeus que estavam em Judá e em Jerusalém, em nome do Deus de Israel, que estava sobre eles.",
      "palavras": [
        { "hebraico": "וְהִתְנַבִּ֞י", "transliteral": "wə-hiṯ-nab-bî", "traducao_palavra": "e profetizaram" },
