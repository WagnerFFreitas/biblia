        { "hebraico": "בֹּוזְנַ֖י", "transliteral": "bō-wz-nay", "traducao_palavra": "Bozenai" },
        { "hebraico": "וּכְנָוָתְהֹ֑ון", "transliteral": "ū-ḵə-nā-wā-ṯə-hō-wn", "traducao_palavra": "e seus companheiros" },
        { "hebraico": "וְכֵן֙", "transliteral": "wə-ḵēn", "traducao_palavra": "e assim" },
        { "hebraico": "אָמְרִ֣ין", "transliteral": "ʾā-mə-rîn", "traducao_palavra": "dizendo" },
        { "hebraico": "לְהֹ֔ם", "transliteral": "lə-hōm", "traducao_palavra": "a eles" },
        { "hebraico": "מַן־", "transliteral": "man-", "traducao_palavra": "quem" },
        { "hebraico": "שָׂ֨ם", "transliteral": "śām", "traducao_palavra": "pôs (deu)" },
        { "hebraico": "לְכֶ֜ם", "transliteral": "lə-ḵem", "traducao_palavra": "para vós" },
        { "hebraico": "טְעֵ֗ם", "transliteral": "ṭə-ʿēm", "traducao_palavra": "decreto" },
        { "hebraico": "בַּיְתָ֤א", "transliteral": "bay-ṯā", "traducao_palavra": "casa" },
        { "hebraico": "דְנָה֙", "transliteral": "ḏə-nā", "traducao_palavra": "esta" },
        { "hebraico": "לִבְנֵ֔א", "transliteral": "liḇ-nê", "traducao_palavra": "para edificar" },
        { "hebraico": "וְאֻשַּׁרְנָ֥א", "transliteral": "wə-ʾuš-šar-nā", "traducao_palavra": "e esta estrutura" },
        { "hebraico": "דְנָ֖ה", "transliteral": "ḏə-nā", "traducao_palavra": "esta" },
        { "hebraico": "לְשַׁכְלָלָֽה׃", "transliteral": "lə-šaḵ-lā-lā", "traducao_palavra": "para terminar" }
      ]
    },
    "4": {
      "traducao_completa": "Então lhes dissemos quais eram os nomes dos homens que edificavam este edifício.",
      "palavras": [
        { "hebraico": "אֱדַ֤יִן", "transliteral": "ʾĕ-ḏayin", "traducao_palavra": "então" },
        { "hebraico": "כְּנֵ֙מָא֙", "transliteral": "kə-nē-mā", "traducao_palavra": "como segue" },
        { "hebraico": "אֲמַ֣רְנָא", "transliteral": "ʾă-mar-nā", "traducao_palavra": "dissemos" },
        { "hebraico": "לְהֹ֑ם", "transliteral": "lə-hōm", "traducao_palavra": "a eles" },
        { "hebraico": "מַן־", "transliteral": "man-", "traducao_palavra": "quais" },
        { "hebraico": "אִנּוּן֙", "transliteral": "ʾin-nūn", "traducao_palavra": "[são]" },
        { "hebraico": "שְׁמָהָ֣ת", "transliteral": "šə-mā-hāṯ", "traducao_palavra": "os nomes de" },
        { "hebraico": "גֻּבְרַיָּ֔א", "transliteral": "guḇ-ray-yā", "traducao_palavra": "os homens" },
        { "hebraico": "דִּֽי־", "transliteral": "ḏî-", "traducao_palavra": "que" },
        { "hebraico": "בִנְיָנָ֥א", "transliteral": "ḇin-yā-nā", "traducao_palavra": "o edifício" },
        { "hebraico": "דְנָ֖ה", "transliteral": "ḏə-nā", "traducao_palavra": "este" },
        { "hebraico": "בָּנַֽיִן׃", "transliteral": "bā-na-yin", "traducao_palavra": "estão edificando" }
      ]
    },
    "5": {
      "traducao_completa": "Porém os olhos do seu Deus estavam sobre os anciãos dos judeus, e não os impediram, até que o assunto chegasse a Dario, e então respondessem por carta sobre isso.",
      "palavras": [
        { "hebraico": "וְעֵ֣ין", "transliteral": "wə-ʿên", "traducao_palavra": "e o olho de" },
        { "hebraico": "אֱלָהֲהֹ֔ם", "transliteral": "ʾĕ-lā-hă-hōm", "traducao_palavra": "Deus deles" },
        { "hebraico": "הֲוָ֖ת", "transliteral": "hă-wāṯ", "traducao_palavra": "estava" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre" },
        { "hebraico": "שָׂבֵ֣י", "transliteral": "śā-ḇê", "traducao_palavra": "os anciãos de" },
        { "hebraico": "יְהוּדָיֵ֑א", "transliteral": "yə-hū-ḏā-yê", "traducao_palavra": "os judeus" },
        { "hebraico": "וְלָא־", "transliteral": "wə-lā-", "traducao_palavra": "e não" },
        { "hebraico": "בַטִּ֣לוּ", "transliteral": "ḇaṭ-ṭi-lū", "traducao_palavra": "impediram" },
        { "hebraico": "הִמֹּ֔ו", "transliteral": "him-mōw", "traducao_palavra": "eles" },
        { "hebraico": "עַד־", "transliteral": "ʿaḏ-", "traducao_palavra": "até" },
        { "hebraico": "טַעְמָא֙", "transliteral": "ṭa-ʿəmā", "traducao_palavra": "o relato" },
        { "hebraico": "לְדָרְיָ֣וֶשׁ", "transliteral": "lə-ḏā-rə-yā-weš", "traducao_palavra": "a Dario" },
        { "hebraico": "יְהָ֑ךְ", "transliteral": "yə-hāḵ", "traducao_palavra": "fosse" },
        { "hebraico": "וֶאֱדַ֛יִן", "transliteral": "we-ʾĕ-ḏayin", "traducao_palavra": "e então" },
        { "hebraico": "יְתִיב֥וּן", "transliteral": "yə-ṯî-ḇūn", "traducao_palavra": "eles respondessem" },
        { "hebraico": "נִשְׁתְּוָנָ֖א", "transliteral": "niš-tə-wā-nā", "traducao_palavra": "[por] carta" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre" },
        { "hebraico": "דְּנָֽה׃", "transliteral": "ḏə-nā", "traducao_palavra": "isso" }
      ]
    },
    "6": {
      "traducao_completa": "A cópia da carta que Tatnai, o governador de além do rio, e Setar-Bozenai, e os seus companheiros, os afarsaquitas, que estavam além do rio, enviaram ao rei Dario.",
      "palavras": [
        { "hebraico": "פַּרְשֶׁ֣גֶן", "transliteral": "par-še-ḡen", "traducao_palavra": "cópia de" },
        { "hebraico": "אִגַּרְתָּ֗א", "transliteral": "ʾig-gar-tā", "traducao_palavra": "a carta" }
      ]
    },
    "7": {
      "traducao_completa": "Enviaram-lhe um relatório, no qual estava escrito: Ao rei Dario, toda a paz.",
      "palavras": [
        { "hebraico": "פִּתְגָמָא֙", "transliteral": "piṯ-ḡā-mā", "traducao_palavra": "um relato" },
        { "hebraico": "שְׁלַ֣חוּ", "transliteral": "šə-la-ḥū", "traducao_palavra": "enviaram" }
      ]
    },
    "8": {
      "traducao_completa": "Saiba o rei que fomos à província de Judá, à casa do grande Deus, a qual se edifica com grandes pedras, e a madeira já está sendo posta nas paredes; e esta obra se faz com diligência, e prospera em suas mãos.",
      "palavras": [
        { "hebraico": "יְדִ֣יעַ", "transliteral": "yə-ḏî-aʿ", "traducao_palavra": "sabido" },
        { "hebraico": "לֶהֱוֵ֣א", "transliteral": "le-hĕ-wē", "traducao_palavra": "seja" },
        { "hebraico": "לְמַלְכָּ֔א", "transliteral": "lə-mal-kā", "traducao_palavra": "ao rei" }
      ]
    },
    "9": {
      "traducao_completa": "Então perguntamos àqueles anciãos, e lhes dissemos assim: Quem vos deu ordem para edificar esta casa, e para concluir este muro?",
      "palavras": [
        { "hebraico": "אֱדַ֙יִן֙", "transliteral": "ʾĕ-ḏayin", "traducao_palavra": "então" },
        { "hebraico": "שְׁאֵ֣לְנָא", "transliteral": "šə-ʾêl-nā", "traducao_palavra": "perguntamos" }
      ]
    },
    "10": {
      "traducao_completa": "E também lhes perguntamos os seus nomes, para te fazermos saber, para que pudéssemos escrever os nomes dos homens que estavam à frente deles.",
      "palavras": [
        { "hebraico": "וְאַ֧ף", "transliteral": "wə-ʾap̄", "traducao_palavra": "e também" },
        { "hebraico": "שְׁמָהָתְהֹ֖ם", "transliteral": "šə-mā-hā-ṯə-hōm", "traducao_palavra": "os nomes deles" }
      ]
    },
    "11": {
      "traducao_completa": "E esta resposta nos deram, dizendo: Nós somos servos do Deus dos céus e da terra, e reedificamos a casa que há muitos anos fora edificada, a qual um grande rei de Israel edificou e concluiu.",
      "palavras": [
        { "hebraico": "אֲנַ֨חְנָא", "transliteral": "ʾă-naḥ-nā", "traducao_palavra": "nós" },
        { "hebraico": "הִמֹּ֜ו", "transliteral": "him-mōw", "traducao_palavra": "somos" },
        { "hebraico": "עַבְדֹוהִי", "transliteral": "ʿaḇ-ḏō-whî", "traducao_palavra": "servos de" },
        { "hebraico": "אֱלָ֧הּ", "transliteral": "ʾĕ-lāh", "traducao_palavra": "o Deus de" },
        { "hebraico": "שְׁמַיָּ֣א", "transliteral": "šə-may-yā", "traducao_palavra": "os céus" }
      ]
    },
    "12": {
      "traducao_completa": "Mas depois que nossos pais provocaram à ira o Deus dos céus, ele os entregou na mão de Nabucodonosor, rei de Babilônia, o caldeu, o qual destruiu esta casa, e transportou o povo para Babilônia.",
      "palavras": [
        { "hebraico": "מִן־", "transliteral": "min-", "traducao_palavra": "depois" },
        { "hebraico": "דִּ֠י", "transliteral": "dî", "traducao_palavra": "que" },
        { "hebraico": "הַרְגִּ֨זוּ", "transliteral": "har-gi-zū", "traducao_palavra": "provocaram à ira" }
      ]
    },
    "13": {
      "traducao_completa": "Porém, no primeiro ano de Ciro, rei de Babilônia, o rei Ciro deu ordem para que esta casa de Deus se reedificasse.",
      "palavras": [
        { "hebraico": "בְּרַם֙", "transliteral": "bə-ram", "traducao_palavra": "contudo" },
        { "hebraico": "בִּשְׁנַ֣ת", "transliteral": "biš-naṯ", "traducao_palavra": "no ano de" },
        { "hebraico": "חֲדָ֔ה", "transliteral": "ḥă-ḏā", "traducao_palavra": "um" }
      ]
    },
    "14": {
      "traducao_completa": "E também os vasos de ouro e de prata da casa de Deus, que Nabucodonosor tirara do templo que estava em Jerusalém e os levara para o templo de Babilônia, o rei Ciro os tirou do templo de Babilônia, e foram entregues a um cujo nome era Sesbazar, a quem nomeara governador.",
      "palavras": [
        { "hebraico": "וְאַ֠ף", "transliteral": "wə-ʾap̄", "traducao_palavra": "e também" },
        { "hebraico": "מָאנַיָּ֣א", "transliteral": "mā-nay-yā", "traducao_palavra": "os vasos" }
      ]
    },
    "15": {
      "traducao_completa": "E disse-lhe: Toma estes vasos, vai e leva-os ao templo que está em Jerusalém, e reedifique-se a casa de Deus no seu lugar.",
      "palavras": [
        { "hebraico": "וַאֲמַר־", "transliteral": "wa-ʾă-mar-", "traducao_palavra": "e disse" },
        { "hebraico": "לֵהּ", "transliteral": "lēh", "traducao_palavra": "a ele" }
      ]
    },
    "16": {
      "traducao_completa": "Então veio o mesmo Sesbazar, e lançou os fundamentos da casa de Deus, que está em Jerusalém; e desde então até agora se vem edificando, e ainda não está concluída.",
      "palavras": [
        { "hebraico": "אֱדַ֙יִן֙", "transliteral": "ʾĕ-ḏayin", "traducao_palavra": "então" },
        { "hebraico": "שֵׁשְׁבַּצַּ֣ר", "transliteral": "šê-šə-baṣ-ṣar", "traducao_palavra": "Sesbazar" }
      ]
    },
    "17": {
      "traducao_completa": "Agora, pois, se parecer bem ao rei, busque-se na casa dos tesouros do rei, que está ali em Babilônia, se é verdade que pelo rei Ciro foi dado ordem para edificar esta casa de Deus em Jerusalém; e sobre isso nos envie o rei a sua vontade.",
