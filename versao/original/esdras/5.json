      ]
    },
    "3": {
      "traducao_completa": "Naquele tempo veio a eles Tatnai, governador de além do Rio, e Setar-Bozenai e seus companheiros, e disseram-lhes assim: Quem vos deu ordem para edificar esta casa e concluir este muro?",
      "palavras": [
        { "hebraico": "בֵּהּ־", "transliteral": "bêh-", "traducao_palavra": "nele (naquele)" },
        { "hebraico": "זִמְנָ֞א", "transliteral": "zim-nā", "traducao_palavra": "tempo" },
        { "hebraico": "אֲתָ֧א", "transliteral": "ʾă-ṯā", "traducao_palavra": "veio" },
        { "hebraico": "עֲלֵיהֹ֛ון", "transliteral": "ʿă-lê-hō-wn", "traducao_palavra": "sobre eles" },
        { "hebraico": "תַּתְּנַ֥י", "transliteral": "tat-tə-nay", "traducao_palavra": "Tatnai" },
        { "hebraico": "פַּחַת", "transliteral": "pa-ḥaṯ", "traducao_palavra": "governador de" },
        { "hebraico": "עֲבַֽר־", "transliteral": "ʿă-ḇar-", "traducao_palavra": "além de" },
        { "hebraico": "נַהֲרָ֖ה", "transliteral": "na-hă-rā", "traducao_palavra": "o rio" },
