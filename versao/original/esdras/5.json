      ]
    },
    "2": {
      "traducao_completa": "Então se levantaram Zorobabel, filho de Sealtiel, e Jesua, filho de Jozadaque, e começaram a edificar a casa de Deus que está em Jerusalém; e com eles os profetas de Deus, que os ajudavam.",
      "palavras": [
        { "hebraico": "בֵּאדַ֜יִן", "transliteral": "bê-ḏa-yin", "traducao_palavra": "então" },
        { "hebraico": "קָ֣מוּ", "transliteral": "qā-mū", "traducao_palavra": "levantaram-se" },
