        { "hebraico": "דִּ֧י", "transliteral": "dî", "traducao_palavra": "onde" },
        { "hebraico": "גִנְזַיָּ֛א", "transliteral": "ḡin-zay-yā", "traducao_palavra": "os tesouros" },
        { "hebraico": "מְהַחֲתִ֥ין", "transliteral": "mə-ha-ḥă-ṯîn", "traducao_palavra": "eram depositados" },
        { "hebraico": "תַּמָּ֖ה", "transliteral": "tam-mā", "traducao_palavra": "ali" },
        { "hebraico": "בְּבָבֶֽל׃", "transliteral": "bə-ḇā-ḇel", "traducao_palavra": "em Babilônia" }
      ]
    },
    "2": {
      "traducao_completa": "E achou-se em Acmeta, no palácio que está na província da Média, um rolo, e nele estava escrito um memorial assim:",
      "palavras": [
        { "hebraico": "וְהִשְׁתְּכַ֣ח", "transliteral": "wə-hiš-tə-ḵaḥ", "traducao_palavra": "e achou-se" },
        { "hebraico": "בְּאַחְמְתָ֗א", "transliteral": "bə-ʾaḥ-mə-ṯā", "traducao_palavra": "em Acmeta" },
        { "hebraico": "בְּבִֽירְתָא֙", "transliteral": "bə-ḇî-rə-ṯā", "traducao_palavra": "no palácio" },
        { "hebraico": "דִּ֚י", "transliteral": "dî", "traducao_palavra": "que [está]" },
        { "hebraico": "בִּמְדִינַ֣ת", "transliteral": "bim-ḏî-naṯ", "traducao_palavra": "na província de" },
        { "hebraico": "מָדַ֔י", "transliteral": "mā-ḏay", "traducao_palavra": "Média" },
        { "hebraico": "מְגִלָּ֖ה", "transliteral": "mə-ḡil-lā", "traducao_palavra": "um rolo" },
        { "hebraico": "חֲדָ֑ה", "transliteral": "ḥă-ḏā", "traducao_palavra": "um" },
        { "hebraico": "וְכֵן־", "transliteral": "wə-ḵēn-", "traducao_palavra": "e assim" },
        { "hebraico": "דִּכְרֹונָ֖ה", "transliteral": "diḵ-rō-w-nā", "traducao_palavra": "um memorial" },
        { "hebraico": "כְּתִ֥יב", "transliteral": "kə-ṯîḇ", "traducao_palavra": "estava escrito" },
        { "hebraico": "בְּגַוַּהּ׃", "transliteral": "bə-ḡaw-wah", "traducao_palavra": "dentro dele" }
      ]
    },
    "3": {
      "traducao_completa": "No primeiro ano do rei Ciro, o rei Ciro deu uma ordem acerca da casa de Deus em Jerusalém: Edifique-se a casa, lugar onde se ofereçam sacrifícios...",
      "palavras": [
        { "hebraico": "בִּשְׁנַ֨ת", "transliteral": "biš-naṯ", "traducao_palavra": "no ano de" },
        { "hebraico": "חֲדָ֜ה", "transliteral": "ḥă-ḏā", "traducao_palavra": "um" },
        { "hebraico": "לְכֹ֣ורֶשׁ", "transliteral": "lə-ḵō-w-reš", "traducao_palavra": "de Ciro" }
      ]
    },
    "4": {
      "traducao_completa": "Com três carreiras de grandes pedras, e uma carreira de madeira nova; e a despesa se pagará da casa do rei.",
      "palavras": [
        { "hebraico": "נִדְבָּכִין", "transliteral": "niḏ-bā-ḵîn", "traducao_palavra": "carreiras" },
        { "hebraico": "תְּלָתָא", "transliteral": "tə-lā-ṯā", "traducao_palavra": "três" }
      ]
    },
    "5": {
      "traducao_completa": "E também os vasos de ouro e de prata da casa de Deus... sejam restituídos e levados ao seu lugar no templo de Jerusalém.",
      "palavras": [
        { "hebraico": "וְאַ֨ף", "transliteral": "wə-ʾap̄", "traducao_palavra": "e também" },
        { "hebraico": "מָאנֵ֣י", "transliteral": "mā-nê", "traducao_palavra": "os vasos de" }
      ]
    },
    "6": {
      "traducao_completa": "Agora, pois, Tatnai, governador de além do rio, Setar-Bozenai, e os seus companheiros... apartai-vos dali.",
      "palavras": [
        { "hebraico": "כְּעַ֞ן", "transliteral": "kə-ʿan", "traducao_palavra": "agora" },
        { "hebraico": "תַּתְּנַ֣י", "transliteral": "tat-tə-nay", "traducao_palavra": "Tatnai" }
      ]
    },
    "7": {
      "traducao_completa": "Deixai prosseguir a obra desta casa de Deus; que o governador dos judeus e os seus anciãos edifiquem esta casa de Deus no seu lugar.",
      "palavras": [
        { "hebraico": "שְׁבֻ֕קוּ", "transliteral": "šə-ḇu-qū", "traducao_palavra": "deixai" },
        { "hebraico": "לַעֲבִידַ֥ת", "transliteral": "la-ʿă-ḇî-ḏaṯ", "traducao_palavra": "a obra de" }
      ]
    },
    "8": {
      "traducao_completa": "Também por mim se dá ordem... que da fazenda do rei, dos tributos de além do rio, se pague prontamente a despesa a estes homens, para que não parem.",
      "palavras": [
        { "hebraico": "וּמִנִּי֙", "transliteral": "ū-min-nî", "traducao_palavra": "e por mim" },
        { "hebraico": "שִׂ֣ים", "transliteral": "śîm", "traducao_palavra": "foi dado" },
        { "hebraico": "טְעֵ֔ם", "transliteral": "ṭə-ʿēm", "traducao_palavra": "decreto" }
      ]
    },
    "9": {
      "traducao_completa": "E o que for necessário, como bezerros, carneiros e cordeiros, para holocaustos ao Deus dos céus... dê-se-lhes de dia em dia, sem falta.",
      "palavras": [
        { "hebraico": "וּמָ֣ה", "transliteral": "ū-mā", "traducao_palavra": "e o que" },
        { "hebraico": "חַשְׁחָן֩", "transliteral": "ḥaš-ḥān", "traducao_palavra": "for necessário" }
      ]
    },
    "10": {
      "traducao_completa": "Para que ofereçam sacrifícios de cheiro suave ao Deus dos céus, e orem pela vida do rei e de seus filhos.",
      "palavras": [
        { "hebraico": "דִּֽי־", "transliteral": "dî-", "traducao_palavra": "para que" },
        { "hebraico": "לֶהֱוֹ֧ן", "transliteral": "le-hĕ-wōn", "traducao_palavra": "eles sejam" },
        { "hebraico": "מְקָרְבִ֛ין", "transliteral": "mə-qā-rə-ḇîn", "traducao_palavra": "oferecendo" }
      ]
    },
    "11": {
      "traducao_completa": "Também por mim se deu ordem que a qualquer homem que mudar este decreto, se arranque uma viga de sua casa, e levantada, seja nela enforcado...",
      "palavras": [
        { "hebraico": "וּמִנִּי֮", "transliteral": "ū-min-nî", "traducao_palavra": "e por mim" },
        { "hebraico": "שִׂ֣ים", "transliteral": "śîm", "traducao_palavra": "foi dado" },
        { "hebraico": "טְעֵם֒", "transliteral": "ṭə-ʿēm", "traducao_palavra": "decreto" }
      ]
    },
    "12": {
      "traducao_completa": "E o Deus que fez habitar ali o seu nome derrube a todos os reis e povos que estenderem a sua mão para mudar o decreto e para destruir esta casa de Deus, que está em Jerusalém.",
      "palavras": [
        { "hebraico": "וֵאלָהָא֠", "transliteral": "wê-lā-hā", "traducao_palavra": "e o Deus" },
        { "hebraico": "דִּ֣י", "transliteral": "dî", "traducao_palavra": "que" },
        { "hebraico": "שַׁכִּ֨ן", "transliteral": "šak-kin", "traducao_palavra": "fez habitar" }
      ]
    },
    "13": {
      "traducao_completa": "Então Tatnai... fizeram diligentemente conforme o que o rei Dario tinha ordenado.",
      "palavras": [
        { "hebraico": "אֱדַ֜יִן", "transliteral": "ʾĕ-ḏa-yin", "traducao_palavra": "então" },
        { "hebraico": "תַּתְּנַ֣י", "transliteral": "tat-tə-nay", "traducao_palavra": "Tatnai" }
      ]
    },
    "14": {
      "traducao_completa": "E os anciãos dos judeus iam edificando e prosperando pela profecia do profeta Ageu e de Zacarias, filho de Iddo...",
      "palavras": [
        { "hebraico": "וְשָׂבֵ֤י", "transliteral": "wə-śā-ḇê", "traducao_palavra": "e os anciãos de" },
        { "hebraico": "יְהוּדָיֵא֙", "transliteral": "yə-hū-ḏā-yê", "traducao_palavra": "os judeus" }
      ]
    },
    "15": {
      "traducao_completa": "E acabou-se esta casa no terceiro dia do mês de Adar, que era o sexto ano do reinado do rei Dario.",
      "palavras": [
        { "hebraico": "וְשֵׁיצִיא֙", "transliteral": "wə-šê-ṣî", "traducao_palavra": "e terminou" },
        { "hebraico": "בַיְתָ֣א", "transliteral": "ḇay-ṯā", "traducao_palavra": "a casa" },
        { "hebraico": "דְנָ֔ה", "transliteral": "ḏə-nā", "traducao_palavra": "esta" },
        { "hebraico": "עַ֛ד", "transliteral": "ʿaḏ", "traducao_palavra": "até" },
        { "hebraico": "יֹ֥ום", "transliteral": "yō-wm", "traducao_palavra": "o dia" },
        { "hebraico": "תְּלָתָ֖ה", "transliteral": "tə-lā-ṯā", "traducao_palavra": "três" },
        { "hebraico": "לְיַ֣רַח", "transliteral": "lə-ya-raḥ", "traducao_palavra": "para o mês de" },
        { "hebraico": "אֲדָ֑ר", "transliteral": "ʾă-ḏār", "traducao_palavra": "Adar" },
        { "hebraico": "דִּֽי־", "transliteral": "ḏî-", "traducao_palavra": "que [era]" },
        { "hebraico": "הִיא֙", "transliteral": "hî", "traducao_palavra": "ela (ele)" },
        { "hebraico": "שְׁנַת־", "transliteral": "šə-naṯ-", "traducao_palavra": "ano de" },
        { "hebraico": "שֵׁ֔ת", "transliteral": "šēṯ", "traducao_palavra": "seis" },
        { "hebraico": "לְמַלְכ֖וּת", "transliteral": "lə-mal-ḵūṯ", "traducao_palavra": "para o reinado de" },
        { "hebraico": "דָּרְיָ֥וֶשׁ", "transliteral": "dā-rə-yā-weš", "traducao_palavra": "Dario" },
