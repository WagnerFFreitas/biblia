{
  "livro": "Esdras - עֶזְרָא - ʿEzrāʾ",
  "capítulo": 6,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Então o rei Dario deu uma ordem, e buscaram na casa dos arquivos, onde os tesouros eram depositados ali em Babilônia.",
      "palavras": [
        { "hebraico": "בֵּאדַ֙יִן֙", "transliteral": "bê-ḏa-yin", "traducao_palavra": "então" },
        { "hebraico": "דָּרְיָ֣וֶשׁ", "transliteral": "dā-rə-yā-weš", "traducao_palavra": "Dario" },
        { "hebraico": "מַלְכָּ֔א", "transliteral": "mal-kā", "traducao_palavra": "o rei" },
        { "hebraico": "שָׂ֣ם", "transliteral": "śām", "traducao_palavra": "pôs (deu)" },
        { "hebraico": "טְעֵ֑ם", "transliteral": "ṭə-ʿēm", "traducao_palavra": "um decreto" },
        { "hebraico": "וּבַקַּ֣רוּ", "transliteral": "ū-ḇaq-qa-rū", "traducao_palavra": "e buscaram" },
