      ]
    },
    "16": {
      "traducao_completa": "E os filhos de Israel, os sacerdotes, os levitas e o restante dos filhos do cativeiro, fizeram a dedicação desta casa de Deus com alegria.",
      "palavras": [
        { "hebraico": "וַעֲבַ֣דוּ", "transliteral": "wa-ʿă-ḇa-ḏū", "traducao_palavra": "e fizeram" },
        { "hebraico": "בְנֵֽי־יִ֠שְׂרָאֵל", "transliteral": "ḇə-nê-yiś-rā-ʾēl", "traducao_palavra": "os filhos de Israel" }
      ]
    },
    "17": {
      "traducao_completa": "E ofereceram para a dedicação desta casa de Deus cem bezerros, duzentos carneiros, quatrocentos cordeiros...",
      "palavras": [
        { "hebraico": "וְהַקְרִ֜בוּ", "transliteral": "wə-haq-ri-ḇū", "traducao_palavra": "e ofereceram" }
      ]
    },
    "18": {
      "traducao_completa": "E puseram os sacerdotes nas suas turmas, e os levitas nas suas divisões... conforme o que está escrito no livro de Moisés.",
      "palavras": [
        { "hebraico": "וַהֲקִ֨ימוּ", "transliteral": "wa-hă-qî-mū", "traducao_palavra": "e puseram" }
      ]
    },
    "19": {
      "traducao_completa": "E os filhos do cativeiro celebraram a Páscoa no décimo quarto dia do primeiro mês.",
      "palavras": [
        { "hebraico": "וַיַּעֲשׂ֧וּ", "transliteral": "way-ya-ʿă-śū", "traducao_palavra": "e fizeram" },
        { "hebraico": "בְנֵi־", "transliteral": "ḇə-nê-", "traducao_palavra": "os filhos de" },
        { "hebraico": "הַגֹּולָ֛ה", "transliteral": "haḡ-ḡō-w-lāh", "traducao_palavra": "o exílio" },
        { "hebraico": "אֶת־", "transliteral": "ʾeṯ-", "traducao_palavra": "[partícula acusativa]" },
        { "hebraico": "הַפָּ֖סַח", "transliteral": "hap-pā-saḥ", "traducao_palavra": "a páscoa" },
        { "hebraico": "בְּאַרְבָּעָ֥ה", "transliteral": "bə-ʾar-bā-ʿāh", "traducao_palavra": "no quatro" },
        { "hebraico": "עָשָׂ֖ר", "transliteral": "ʿā-śār", "traducao_palavra": "dez (décimo quarto)" },
        { "hebraico": "לַחֹ֥דֶשׁ", "transliteral": "la-ḥō-ḏeš", "traducao_palavra": "para o mês" },
        { "hebraico": "הָרִאשֹֽׁון׃", "transliteral": "hā-ri-šō-wn", "traducao_palavra": "o primeiro" }
      ]
    },
    "20": {
      "traducao_completa": "Porque os sacerdotes e levitas se tinham purificado como um só homem; todos estavam limpos...",
      "palavras": [
        { "hebraico": "כִּ֣י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "הִֽטַּהֲר֧וּ", "transliteral": "hiṭ-ṭa-hă-rū", "traducao_palavra": "purificaram-se" }
      ]
    },
    "21": {
      "traducao_completa": "Assim comeram a Páscoa os filhos de Israel que tinham voltado do cativeiro, com todos os que se tinham apartado da imundícia das nações da terra...",
      "palavras": [
        { "hebraico": "וַיֹּאכְל֣וּ", "transliteral": "way-yō-ḵə-lū", "traducao_palavra": "e comeram" },
        { "hebraico": "בְנֵֽי־יִשְׂרָאֵ֥ל", "transliteral": "ḇə-nê-yiś-rā-ʾēl", "traducao_palavra": "os filhos de Israel" }
      ]
    },
    "22": {
      "traducao_completa": "E celebraram a festa dos pães ázimos por sete dias com alegria; porque YHWH os tinha alegrado, e tinha mudado o coração do rei da Assíria para com eles, para lhes fortalecer as mãos na obra da casa de Deus, o Deus de Israel.",
      "palavras": [
        { "hebraico": "וַיַּעֲשׂ֧וּ", "transliteral": "way-ya-ʿă-śū", "traducao_palavra": "e fizeram" },
        { "hebraico": "חַג־", "transliteral": "ḥaḡ-", "traducao_palavra": "festa de" },
        { "hebraico": "מַצֹּ֛ות", "transliteral": "maṣ-ṣō-wṯ", "traducao_palavra": "pães ázimos" },
        { "hebraico": "שִׁבְעַ֥ת", "transliteral": "šiḇ-ʿaṯ", "traducao_palavra": "sete" },
        { "hebraico": "יָמִ֖ים", "transliteral": "yā-mîm", "traducao_palavra": "dias" },
        { "hebraico": "בְּשִׂמְחָ֑ה", "transliteral": "bə-śim-ḥāh", "traducao_palavra": "com alegria" },
        { "hebraico": "כִּ֣י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "שִׂמְּחָ֣ם", "transliteral": "śim-mə-ḥām", "traducao_palavra": "alegrou-os" },
        { "hebraico": "יְהוָ֗ה", "transliteral": "la-YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "וְהֵסֵ֨ב", "transliteral": "wə-hē-sēḇ", "traducao_palavra": "e ele virou (mudou)" },
        { "hebraico": "לֵ֤ב", "transliteral": "lēḇ", "traducao_palavra": "o coração de" },
        { "hebraico": "מֶֽלֶךְ־", "transliteral": "me-leḵ-", "traducao_palavra": "rei de" },
        { "hebraico": "אַשּׁוּר֙", "transliteral": "ʾaš-šūr", "traducao_palavra": "Assíria" },
