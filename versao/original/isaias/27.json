    "1": {
      "traducao_completa": "Naquele dia YHWH castigará com a sua dura, grande e forte espada, o leviatã, a serpente veloz, e o leviatã, a serpente tortuosa, e matará o dragão que está no mar.",
      "palavras": [
        { "hebraico": "בַּיֹּ֣ום", "transliteral": "bay-yôm", "traducao_palavra": "No dia" },
        { "hebraico": "הַה֡וּא", "transliteral": "ha-hû", "traducao_palavra": "aquele" },
        { "hebraico": "יִפְקֹ֣ד", "transliteral": "yip̄-qōḏ", "traducao_palavra": "castigará/visitara" },
        { "hebraico": "יְהוָה֩", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "בְּחַרְבֹ֨ו", "transliteral": "bə-ḥar-bô", "traducao_palavra": "com sua espada" },
