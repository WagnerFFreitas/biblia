        { "hebraico": "אֲשֵׁרִ֖ים", "transliteral": "ʾă-šê-rîm", "traducao_palavra": "[os] Asherins" },
        { "hebraico": "וְחַמָּנִֽים׃", "transliteral": "wə-ḥam-mā-nîm", "traducao_palavra": "e imagens do sol" }
      ]
