        { "hebraico": "בִּיבֹ֤שׁ", "transliteral": "bi-yə-ḇōš", "traducao_palavra": "Ao secarem" },
        { "hebraico": "קְצִירָהּ֙", "transliteral": "qə-ṣî-rāh", "traducao_palavra": "seus ramos" },
        { "hebraico": "תִּשָּׁבַ֔רְנָה", "transliteral": "tiš-šā-ḇar-nā", "traducao_palavra": "serão quebrados" },
        { "hebraico": "נָשִׁ֣ים", "transliteral": "nā-šîm", "traducao_palavra": "mulheres" },
