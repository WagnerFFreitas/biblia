        { "hebraico": "תְּנוּבָֽה׃", "transliteral": "tə-nû-ḇā", "traducao_palavra": "[de] fruto" }
      ]
    },
    "7": {
      "traducao_completa": "Porventura feriu-o ele como feriu àquele que o feria? Ou foi ele morto como foram mortos aqueles que por ele foram mortos?",
      "palavras": [
        { "hebraico": "הַכְּמַכַּ֥ת", "transliteral": "hak-kə-mak-kaṯ", "traducao_palavra": "Acaso como a ferida de" },
        { "hebraico": "מַכֵּ֖הוּ", "transliteral": "mak-kê-hû", "traducao_palavra": "quem o feria" },
        { "hebraico": "הִכָּ֑הוּ", "transliteral": "hik-kā-hû", "traducao_palavra": "feriu-o?" },
        { "hebraico": "אִם־", "transliteral": "ʾim-", "traducao_palavra": "ou" },
        { "hebraico": "כְּהֶ֥רֶג", "transliteral": "kə-he-reḡ", "traducao_palavra": "como a matança de" },
        { "hebraico": "הֲרֻגָ֖יו", "transliteral": "hă-ru-ḡāyw", "traducao_palavra": "seus mortos" },
        { "hebraico": "הֹרָֽג׃", "transliteral": "hō-rāḡ", "traducao_palavra": "foi morto?" }
      ]
