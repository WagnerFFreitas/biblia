        { "hebraico": "נֹֽצְרָ֔הּ", "transliteral": "nō-ṣə-rāh", "traducao_palavra": "a guardo" },
        { "hebraico": "לִרְגָעִ֖ים", "transliteral": "lir-ḡā-ʿîm", "traducao_palavra": "a cada momento" },
        { "hebraico": "אַשְׁקֶ֑נָּה", "transliteral": "ʾaš-qen-nā", "traducao_palavra": "a regarei" },
        { "hebraico": "פֶּן־", "transliteral": "pen-", "traducao_palavra": "para que não" },
        { "hebraico": "יִפְקֹ֣ד", "transliteral": "yip̄-qōḏ", "traducao_palavra": "ataque/visite" },
