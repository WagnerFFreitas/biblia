        { "hebraico": "נָחָ֖שׁ", "transliteral": "nā-ḥāš", "traducao_palavra": "serpente" },
        { "hebraico": "עֲקַלָּתֹ֑ון", "transliteral": "ʿă-qal-lā-ṯôn", "traducao_palavra": "tortuosa" },
        { "hebraico": "וְהָרַ֥ג", "transliteral": "wə-hā-raḡ", "traducao_palavra": "e matará" },
        { "hebraico": "אֶת־הַתַּנִּ֖ין", "transliteral": "ʾeṯ-hat-tan-nîn", "traducao_palavra": "[objeto] o dragão/monstro" },
