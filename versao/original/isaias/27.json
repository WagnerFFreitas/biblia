    "10": {
      "traducao_completa": "Porque a cidade forte está solitária, habitação abandonada e deixada como um deserto; ali pastará o bezerro, e ali se deitará, e consumirá os seus ramos.",
      "palavras": [
        { "hebraico": "כִּ֣י", "transliteral": "kî", "traducao_palavra": "Porque" },
        { "hebraico": "עִ֤יר", "transliteral": "ʿîr", "traducao_palavra": "[a] cidade" },
        { "hebraico": "בְּצוּרָה֙", "transliteral": "bə-ṣû-rā", "traducao_palavra": "fortificada" },
        { "hebraico": "בָּדָ֔ד", "transliteral": "bā-ḏāḏ", "traducao_palavra": "[está] só/solitária" },
        { "hebraico": "נָוֶ֧ה", "transliteral": "nā-weh", "traducao_palavra": "habitação" },
        { "hebraico": "מְשֻׁלָּ֛ח", "transliteral": "mə-šul-lāḥ", "traducao_palavra": "abandonada" },
        { "hebraico": "וְנֶעֱזָ֖ב", "transliteral": "wə-ne-ʿĕ-zāḇ", "traducao_palavra": "e deixada" },
        { "hebraico": "כַּמִּדְבָּ֑ר", "transliteral": "kam-miḏ-bār", "traducao_palavra": "como deserto" },
        { "hebraico": "שָׁ֣ם", "transliteral": "šām", "traducao_palavra": "ali" },
        { "hebraico": "יִרְעֶ֥ה", "transliteral": "yir-ʿeh", "traducao_palavra": "pastará" },
        { "hebraico": "עֵ֛גֶל", "transliteral": "ʿê-ḡel", "traducao_palavra": "[o] bezerro" },
        { "hebraico": "וְשָׁ֥ם", "transliteral": "wə-šām", "traducao_palavra": "e ali" },
        { "hebraico": "יִרְבָּ֖ץ", "transliteral": "yir-bāṣ", "traducao_palavra": "se deitará" },
        { "hebraico": "וְכִלָּ֥ה", "transliteral": "wə-ḵil-lā", "traducao_palavra": "e consumirá" },
