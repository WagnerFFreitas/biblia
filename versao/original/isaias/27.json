    "6": {
      "traducao_completa": "Dias virão em que Jacó lançará raízes, e Israel florescerá e brotará, e encherão de fruto a face do mundo.",
      "palavras": [
        { "hebraico": "הַבָּאִים֙", "transliteral": "hab-bā-ʾîm", "traducao_palavra": "[Nos dias] que vêm" },
        { "hebraico": "יַשְׁרֵ֣שׁ", "transliteral": "yaš-rêš", "traducao_palavra": "lançará raízes" },
        { "hebraico": "יַעֲקֹ֔ב", "transliteral": "ya-ʿă-qōḇ", "traducao_palavra": "Jacó" },
        { "hebraico": "יָצִ֥יץ", "transliteral": "yā-ṣîṣ", "traducao_palavra": "florescerá" },
