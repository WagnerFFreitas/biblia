        { "hebraico": "בְּסַאסְּאָ֖ה", "transliteral": "bə-śa-ʾəsə-ʾā", "traducao_palavra": "Com medida/pelo seá" },
        { "hebraico": "בְּשַׁלְחָ֥הּ", "transliteral": "bə-šal-ḥāh", "traducao_palavra": "ao enviá-la fora" },
        { "hebraico": "תְּרִיבֶ֑נָּה", "transliteral": "tə-rî-ḇen-nā", "traducao_palavra": "litigaste com ela" },
        { "hebraico": "הָגָ֛ה", "transliteral": "hā-ḡā", "traducao_palavra": "removeu/afastou" },
        { "hebraico": "בְּרוּחֹ֥ו", "transliteral": "bə-rû-ḥô", "traducao_palavra": "com seu vento" },
        { "hebraico": "הַקָּשָׁ֖ה", "transliteral": "haq-qā-šā", "traducao_palavra": "forte" },
        { "hebraico": "בְּיֹ֥ום", "transliteral": "bə-yôm", "traducao_palavra": "no dia de" },
        { "hebraico": "קָדִֽים׃", "transliteral": "qā-ḏîm", "traducao_palavra": "vento leste" }
      ]
    },
    "9": {
      "traducao_completa": "Por isso se expiará a iniquidade de Jacó, e este será todo o fruto de se haver tirado o seu pecado; quando ele fizer a todas as pedras do altar como pedras de cal feitas em pedaços, de modo que os bosques e as imagens do sol não possam mais levantar-se.",
      "palavras": [
        { "hebraico": "לָכֵן֙", "transliteral": "lā-ḵên", "traducao_palavra": "Portanto" },
        { "hebraico": "בְּזֹ֣את", "transliteral": "bə-zōṯ", "traducao_palavra": "por isto" },
        { "hebraico": "יְכֻפַּ֣ר", "transliteral": "yə-ḵup-par", "traducao_palavra": "será expiada" },
        { "hebraico": "עֲוֹן־", "transliteral": "ʿă-wōn-", "traducao_palavra": "a iniquidade de" },
        { "hebraico": "יַעֲקֹ֔ב", "transliteral": "ya-ʿă-qōḇ", "traducao_palavra": "Jacó" },
        { "hebraico": "וְזֶ֕ה", "transliteral": "wə-zeh", "traducao_palavra": "e este [é]" },
        { "hebraico": "כָּל־", "transliteral": "kāl-", "traducao_palavra": "todo" },
        { "hebraico": "פְּרִ֖י", "transliteral": "pə-rî", "traducao_palavra": "[o] fruto de" },
        { "hebraico": "הָסִ֣ר", "transliteral": "hā-śir", "traducao_palavra": "tirar/remover" },
        { "hebraico": "חַטָּאתֹ֑ו", "transliteral": "ḥaṭ-ṭā-ṯô", "traducao_palavra": "seu pecado" },
        { "hebraico": "בְּשׂוּמֹ֣ו ׀", "transliteral": "bə-śû-mô", "traducao_palavra": "ao pôr ele" },
        { "hebraico": "כָּל־אַבְנֵי", "transliteral": "kāl-ʾaḇ-nê", "traducao_palavra": "todas as pedras de" },
        { "hebraico": "מִזְבֵּ֗חַ", "transliteral": "miz-bê-aḥ", "traducao_palavra": "altar" },
        { "hebraico": "כְּאַבְנֵי־", "transliteral": "kə-ʾaḇ-nê-", "traducao_palavra": "como pedras de" },
        { "hebraico": "גִ֣ר", "transliteral": "ḡir", "traducao_palavra": "cal" },
        { "hebraico": "מְנֻפָּצֹ֔ות", "transliteral": "mə-nu-pā-ṣôṯ", "traducao_palavra": "esmiuçadas/despedaçadas" },
