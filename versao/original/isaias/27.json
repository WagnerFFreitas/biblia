        { "hebraico": "יָֽחַד׃", "transliteral": "yā-ḥaḏ", "traducao_palavra": "juntamente" }
      ]
    },
    "5": {
      "traducao_completa": "Ou que se apodere da minha força, e faça paz comigo; sim, que faça paz comigo.",
      "palavras": [
        { "hebraico": "אֹ֚ו", "transliteral": "ʾô", "traducao_palavra": "Ou" },
        { "hebraico": "יַחֲזֵ֣ק", "transliteral": "ya-ḥă-zēq", "traducao_palavra": "[que] se apodere/segure" },
        { "hebraico": "בְּמָעוּזִּ֔י", "transliteral": "bə-mā-ʿûz-zî", "traducao_palavra": "na minha força/refúgio" },
        { "hebraico": "יַעֲשֶׂ֥ה", "transliteral": "ya-ʿă-śeh", "traducao_palavra": "[que] faça" },
        { "hebraico": "שָׁלֹ֖ום", "transliteral": "šā-lôm", "traducao_palavra": "paz" },
        { "hebraico": "לִ֑י", "transliteral": "lî", "traducao_palavra": "comigo" },
        { "hebraico": "שָׁלֹ֖ום", "transliteral": "šā-lôm", "traducao_palavra": "paz" },
