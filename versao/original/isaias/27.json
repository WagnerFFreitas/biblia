        { "hebraico": "אֵ֣ין", "transliteral": "ʾên", "traducao_palavra": "não [há]" },
        { "hebraico": "לִ֑י", "transliteral": "lî", "traducao_palavra": "em mim" },
        { "hebraico": "מִֽי־יִתְּנֵ֜נִי", "transliteral": "mî-yit-tə-nê-nî", "traducao_palavra": "quem me daria" },
        { "hebraico": "שָׁמִ֥יר", "transliteral": "šā-mîr", "traducao_palavra": "sarça" },
        { "hebraico": "שַׁ֨יִת֙", "transliteral": "ša-yiṯ", "traducao_palavra": "[e] espinheiro" },
        { "hebraico": "בַּמִּלְחָמָ֔ה", "transliteral": "bam-mil-ḥā-mā", "traducao_palavra": "na guerra" },
        { "hebraico": "אֶפְשְׂעָ֥ה", "transliteral": "ʾep̄-śə-ʿā", "traducao_palavra": "eu marcharia" },
        { "hebraico": "בָ֖הּ", "transliteral": "ḇāh", "traducao_palavra": "contra ela" },
