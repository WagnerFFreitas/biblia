    "20": {
      "traducao_completa": "O empobrecido, que não pode oferecer tanto, escolhe madeira que não apodrece; busca para si um artífice sábio, para assentar uma imagem que não se mova.",
      "palavras": [
        { "hebraico": "הַֽמְסֻכָּ֣ן", "transliteral": "ham-su-kān", "traducao_palavra": "O empobrecido" },
        { "hebraico": "תְּרוּמָ֔ה", "transliteral": "tə-rū-māh", "traducao_palavra": "[para] a oferta" },
