        { "hebraico": "מִ֤י", "transliteral": "mî", "traducao_palavra": "quem" },
        { "hebraico": "נֹועָץ֙", "transliteral": "nō-w-ʿāṣ", "traducao_palavra": "tomou conselho" },
        { "hebraico": "וַיְבִינֵ֔הוּ", "transliteral": "way-ḇî-nē-hū", "traducao_palavra": "para que lhe desse entendimento" },
