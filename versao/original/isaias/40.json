        { "hebraico": "אִיִּ֖ים", "transliteral": "ʾiy-yîm", "traducao_palavra": "ilhas" },
        { "hebraico": "כַּדַּ֥ק", "transliteral": "kad-daq", "traducao_palavra": "como pó fino" },
        { "hebraico": "יִטֹּֽול׃", "transliteral": "yiṭ-ṭō-wl", "traducao_palavra": "ele levanta." }
      ]
    },
    "16": {
      "traducao_completa": "E o Líbano não basta para o fogo, nem os seus animais bastam para o holocausto.",
      "palavras": [
        { "hebraico": "וּלְבָנֹ֕ון", "transliteral": "ū-lə-ḇā-nō-wn", "traducao_palavra": "E o Líbano" },
        { "hebraico": "אֵ֥ין", "transliteral": "ʾên", "traducao_palavra": "não [há]" },
        { "hebraico": "דֵּ֖י", "transliteral": "dê", "traducao_palavra": "suficiente" },
