        { "hebraico": "מִדְּלִ֔י", "transliteral": "mid-də-lî", "traducao_palavra": "um balde" },
        { "hebraico": "וּכְשַׁ֥חַק", "transliteral": "ū-ḵə-ša-ḥaq", "traducao_palavra": "e como pó" },
