        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "[que] não" },
        { "hebraico": "יִרְקַ֖ב", "transliteral": "yir-qaḇ", "traducao_palavra": "apodrece" },
        { "hebraico": "יִבְחָ֑ר", "transliteral": "yiḇ-ḥār", "traducao_palavra": "escolhe" },
        { "hebraico": "חָרָ֤שׁ", "transliteral": "ḥā-rāš", "traducao_palavra": "um artífice" },
        { "hebraico": "חָכָם֙", "transliteral": "ḥā-ḵām", "traducao_palavra": "sábio" },
        { "hebraico": "יְבַקֶּשׁ־", "transliteral": "yə-ḇaq-qeš-", "traducao_palavra": "busca" },
        { "hebraico": "לֹ֔ו", "transliteral": "lō-w", "traducao_palavra": "para si" },
        { "hebraico": "לְהָכִ֥ין", "transliteral": "lə-hā-ḵîn", "traducao_palavra": "para estabelecer/preparar" },
        { "hebraico": "פֶּ֖סֶל", "transliteral": "pe-sel", "traducao_palavra": "uma imagem" },
        { "hebraico": "לֹ֥א", "transliteral": "lō", "traducao_palavra": "[que] não" },
        { "hebraico": "יִמֹּֽוט׃", "transliteral": "yim-mō-wṭ", "traducao_palavra": "se abale/mova." }
      ]
