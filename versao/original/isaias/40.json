        { "hebraico": "דַ֔עַת", "transliteral": "da-ʿaṯ", "traducao_palavra": "conhecimento" },
        { "hebraico": "וְדֶ֥רֶךְ", "transliteral": "wə-ḏe-reḵ", "traducao_palavra": "e o caminho de" },
        { "hebraico": "תְּבוּנֹ֖ות", "transliteral": "tə-ḇū-nō-wṯ", "traducao_palavra": "entendimentos" },
        { "hebraico": "יֹודִיעֶֽנּוּ׃", "transliteral": "yō-w-ḏî-ʿen-nū", "traducao_palavra": "lhe mostrasse." }
