    "21": {
      "traducao_completa": "Porventura não sabeis? Porventura não ouvis? Não vos foi anunciado desde o princípio? Não compreendestes desde os fundamentos da terra?",
      "palavras": [
        { "hebraico": "הֲלֹ֤וא", "transliteral": "hă-lō-w", "traducao_palavra": "Acaso não" },
        { "hebraico": "תֵדְעוּ֙", "transliteral": "ṯê-ḏə-ʿū", "traducao_palavra": "sabeis?" },
        { "hebraico": "הֲלֹ֣וא", "transliteral": "hă-lō-w", "traducao_palavra": "Acaso não" },
        { "hebraico": "תִשְׁמָ֔עוּ", "transliteral": "ṯiš-mā-ʿū", "traducao_palavra": "ouvis?" },
        { "hebraico": "הֲלֹ֛וא", "transliteral": "hă-lō-w", "traducao_palavra": "Acaso não" },
        { "hebraico": "הֻגַּ֥ד", "transliteral": "hug-gaḏ", "traducao_palavra": "foi anunciado" },
        { "hebraico": "מֵרֹ֖אשׁ", "transliteral": "mē-rōš", "traducao_palavra": "desde o princípio" },
        { "hebraico": "לָכֶ֑ם", "transliteral": "lā-ḵem", "traducao_palavra": "a vós?" },
        { "hebraico": "הֲלֹוא֙", "transliteral": "hă-lō-w", "traducao_palavra": "Acaso não" },
        { "hebraico": "הֲבִינֹותֶ֔ם", "transliteral": "hă-ḇî-nō-w-ṯem", "traducao_palavra": "compreendestes" },
        { "hebraico": "מֹוסְדֹ֖ות", "transliteral": "mō-w-śə-ḏō-wṯ", "traducao_palavra": "[desde] os fundamentos de" },
        { "hebraico": "הָאָֽרֶץ׃", "transliteral": "hā-ʾā-reṣ", "traducao_palavra": "a terra?" }
      ]
    },
    "22": {
      "traducao_completa": "Ele é o que está assentado sobre o círculo da terra, cujos moradores são para ele como gafanhotos; ele é o que estende os céus como cortina, e os desenrola como tenda para neles habitar.",
      "palavras": [
        { "hebraico": "הַיֹּשֵׁב֙", "transliteral": "hay-yō-šēḇ", "traducao_palavra": "O que se assenta" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre" },
        { "hebraico": "ח֣וּג", "transliteral": "ḥūḡ", "traducao_palavra": "o círculo de" },
        { "hebraico": "הָאָ֔רֶץ", "transliteral": "hā-ʾā-reṣ", "traducao_palavra": "a terra" },
        { "hebraico": "וְיֹשְׁבֶ֖יהָ", "transliteral": "wə-yō-šə-ḇe-hā", "traducao_palavra": "e seus moradores" },
        { "hebraico": "כַּחֲגָבִ֑ים", "transliteral": "ka-ḥă-ḡā-ḇîm", "traducao_palavra": "[são] como gafanhotos" },
        { "hebraico": "הַנֹּוטֶ֤ה", "transliteral": "han-nō-w-ṭeh", "traducao_palavra": "o que estende" },
        { "hebraico": "כַדֹּק֙", "transliteral": "ḵa-dōq", "traducao_palavra": "como cortina fina" },
        { "hebraico": "שָׁמַ֔יִם", "transliteral": "šā-ma-yim", "traducao_palavra": "[os] céus" },
        { "hebraico": "וַיִּמְתָּחֵ֥ם", "transliteral": "way-yim-tā-ḥêm", "traducao_palavra": "e os desenrola/estica" },
        { "hebraico": "כָּאֹ֖הֶל", "transliteral": "kā-ʾō-hel", "traducao_palavra": "como tenda" },
        { "hebraico": "לָשָֽׁבֶת׃", "transliteral": "lā-šā-ḇeṯ", "traducao_palavra": "para habitar." }
      ]
    },
    "23": {
      "traducao_completa": "O que reduz os príncipes a nada, e torna em coisa vã os juízes da terra.",
      "palavras": [
        { "hebraico": "הַנֹּותֵ֥ן", "transliteral": "han-nō-w-ṯên", "traducao_palavra": "O que torna/entrega" },
        { "hebraico": "רֹוזְנִ֖ים", "transliteral": "rō-w-zə-nîm", "traducao_palavra": "príncipes" },
        { "hebraico": "לְאָ֑יִן", "transliteral": "lə-ʾā-yin", "traducao_palavra": "em nada" },
        { "hebraico": "שֹׁ֥פְטֵי", "transliteral": "šō-p̄ə-ṭê", "traducao_palavra": "juízes de" },
        { "hebraico": "אֶ֖רֶץ", "transliteral": "ʾe-reṣ", "traducao_palavra": "terra" },
        { "hebraico": "כַּתֹּ֥הוּ", "transliteral": "kat-tō-hū", "traducao_palavra": "como vácuo/caos" },
        { "hebraico": "עָשָֽׂה׃", "transliteral": "ʿā-śāh", "traducao_palavra": "ele faz." }
      ]
    },
    "24": {
      "traducao_completa": "Mal se plantaram, mal se semearam, mal se arraigou na terra o seu tronco; logo sopra sobre eles, e secam-se, e um tufão os leva como restolho.",
      "palavras": [
        { "hebraico": "אַ֣ף", "transliteral": "ʾap̄", "traducao_palavra": "Mal/também" },
        { "hebraico": "בַּל־", "transliteral": "bal-", "traducao_palavra": "não" },
        { "hebraico": "נִטָּ֔עוּ", "transliteral": "niṭ-ṭā-ʿū", "traducao_palavra": "foram plantados" },
        { "hebraico": "אַ֖ף", "transliteral": "ʾap̄", "traducao_palavra": "mal/também" },
