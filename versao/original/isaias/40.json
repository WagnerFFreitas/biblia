        { "hebraico": "גֶּיא֙", "transliteral": "ge-ʾ", "traducao_palavra": "vale" },
        { "hebraico": "יִנָּשֵׂ֔א", "transliteral": "yin-nā-śē", "traducao_palavra": "será exaltado" },
        { "hebraico": "וְכָל־", "transliteral": "wə-ḵāl-", "traducao_palavra": "e todo" },
