    "8": {
      "traducao_completa": "Mas o nobre projeta coisas nobres, e por coisas nobres subsistirá.",
      "palavras": [
        { "hebraico": "וְנָדִ֖יב", "transliteral": "wə-nā-ḏîḇ", "traducao_palavra": "Mas o nobre" },
