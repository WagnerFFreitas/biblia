    "15": {
      "traducao_completa": "até que se derrame sobre nós o espírito lá do alto; então o deserto se tornará em campo fértil, e o campo fértil será reputado por um bosque.",
      "palavras": [
        { "hebraico": "עַד־יֵ֨עָרֶ֥ה", "transliteral": "ʿaḏ-yê-ʿā-reh", "traducao_palavra": "Até que se derrame" },
        { "hebraico": "עָלֵ֤ינוּ", "transliteral": "ʿā-lê-nû", "traducao_palavra": "sobre nós" },
        { "hebraico": "ר֨וּחַ", "transliteral": "rû-aḥ", "traducao_palavra": "espírito" },
        { "hebraico": "מִמָּרֹ֑ום", "transliteral": "mim-mā-rôm", "traducao_palavra": "do alto" },
        { "hebraico": "וְהָיָ֤ה", "transliteral": "wə-hā-yā", "traducao_palavra": "e será/tornará" },
        { "hebraico": "מִדְבָּר֙", "transliteral": "miḏ-bār", "traducao_palavra": "[o] deserto" },
        { "hebraico": "לַכַּרְמֶ֔ל", "transliteral": "lak-kar-mel", "traducao_palavra": "em campo fértil" },
        { "hebraico": "וְהַכַּרְמֶ֖ל", "transliteral": "wə-hak-kar-mel", "traducao_palavra": "e o campo fértil" },
        { "hebraico": "לַיַּ֥עַר", "transliteral": "lay-ya-ʿar", "traducao_palavra": "por bosque" },
        { "hebraico": "יֵחָשֵֽׁב׃", "transliteral": "yê-ḥā-šêḇ", "traducao_palavra": "será considerado" }
      ]
    },
    "16": {
      "traducao_completa": "E o juízo habitará no deserto, e a justiça morará no campo fértil.",
      "palavras": [
        { "hebraico": "וְשָׁכַ֥ן", "transliteral": "wə-šā-ḵan", "traducao_palavra": "E habitará" },
