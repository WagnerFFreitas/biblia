        { "hebraico": "הָיָ֨ה", "transliteral": "hā-yā", "traducao_palavra": "serão" },
        { "hebraico": "בְעַד־מְעָרֹ֥ות", "transliteral": "ḇə-ʿaḏ-mə-ʿā-rôṯ", "traducao_palavra": "por cavernas" },
        { "hebraico": "עַד־עֹולָ֑ם", "transliteral": "ʿaḏ-ʿô-lām", "traducao_palavra": "para sempre" },
        { "hebraico": "מְשֹׂ֥ושׂ", "transliteral": "mə-śôś", "traducao_palavra": "[para] alegria de" },
        { "hebraico": "פְּרָאִ֖ים", "transliteral": "pə-rā-ʾîm", "traducao_palavra": "jumentos monteses" },
        { "hebraico": "מִרְעֵ֥ה", "transliteral": "mir-ʿēh", "traducao_palavra": "pasto de" },
