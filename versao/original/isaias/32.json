        { "hebraico": "יָבִ֣ין", "transliteral": "yā-ḇîn", "traducao_palavra": "entenderá" },
        { "hebraico": "לָדָ֑עַת", "transliteral": "lā-ḏā-ʿaṯ", "traducao_palavra": "para conhecer" },
        { "hebraico": "וּלְשֹׁ֥ון", "transliteral": "ū-lə-šôn", "traducao_palavra": "e a língua de" },
