      ]
    },
    "10": {
      "traducao_completa": "Dentro de um ano e dias tereis pavor, ó mulheres que estais seguras; porque a vindima se acabará, e a colheita não virá.",
      "palavras": [
        { "hebraico": "יָמִים֙", "transliteral": "yā-mîm", "traducao_palavra": "Dias" },
        { "hebraico": "עַל־שָׁנָ֔ה", "transliteral": "ʿal-šā-nā", "traducao_palavra": "sobre um ano [um ano e pouco]" },
        { "hebraico": "תִּרְגַּ֖זְנָה", "transliteral": "tir-ga-zə-nā", "traducao_palavra": "tremereis" },
        { "hebraico": "בֹּֽטְחֹ֑ות", "transliteral": "bō-ṭə-ḥôṯ", "traducao_palavra": "[ó] confiantes" },
        { "hebraico": "כִּ֚י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "כָּלָ֣ה", "transliteral": "kā-lā", "traducao_palavra": "acabou" },
