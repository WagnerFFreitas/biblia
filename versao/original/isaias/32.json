      ]
    },
    "9": {
      "traducao_completa": "Levantai-vos, mulheres que estais em repouso, e ouvi a minha voz; e vós, filhas, que estais tão seguras, inclinai os ouvidos às minhas palavras.",
      "palavras": [
        { "hebraico": "נָשִׁים֙", "transliteral": "nā-šîm", "traducao_palavra": "Mulheres" },
