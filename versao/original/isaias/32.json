      "palavras": [
        { "hebraico": "וְלֹ֥א", "transliteral": "wə-lō", "traducao_palavra": "E não" },
        { "hebraico": "תִשְׁעֶ֖ינָה", "transliteral": "ṯiš-ʿe-nā", "traducao_palavra": "serão cegados/ofuscados" },
        { "hebraico": "עֵינֵ֣י", "transliteral": "ʿê-nê", "traducao_palavra": "os olhos de" },
        { "hebraico": "רֹאִ֑ים", "transliteral": "rō-ʾîm", "traducao_palavra": "os que veem" },
        { "hebraico": "וְאָזְנֵ֥י", "transliteral": "wə-ʾāz-nê", "traducao_palavra": "e os ouvidos de" },
        { "hebraico": "שֹׁמְעִ֖ים", "transliteral": "šō-mə-ʿîm", "traducao_palavra": "os que ouvem" },
        { "hebraico": "תִּקְשַׁ֥בְנָה׃", "transliteral": "tiq-šaḇ-nā", "traducao_palavra": "estarão atentos" }
      ]
    },
    "4": {
      "traducao_completa": "E o coração dos temerários entenderá o conhecimento, e a língua dos gagos estará pronta para falar distintamente.",
