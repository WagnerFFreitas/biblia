    },
    "14": {
      "traducao_completa": "Porque o palácio será abandonado, a multidão da cidade cessará; o outeiro e a torre da vigia servirão de cavernas para sempre, para folguedo de jumentos monteses e para pasto de rebanhos;",
      "palavras": [
        { "hebraico": "כִּֽי־אַרְמֹ֣ון", "transliteral": "kî-ʾar-môn", "traducao_palavra": "Porque [o] palácio" },
