        { "hebraico": "אָ֖סִף", "transliteral": "ʾā-śip̄", "traducao_palavra": "[a] colheita" },
        { "hebraico": "בְּלִ֥י", "transliteral": "bə-lî", "traducao_palavra": "sem" },
        { "hebraico": "יָבֹֽוא׃", "transliteral": "yā-ḇô", "traducao_palavra": "vir" }
      ]
    },
    "11": {
      "traducao_completa": "Tremei, mulheres que estais em repouso; turbai-vos, vós que estais seguras; despi-vos, e ponde-vos nuas, e cingis os vossos lombos com sacos.",
      "palavras": [
        { "hebraico": "חִרְדּוּ֙", "transliteral": "ḥir-ḏû", "traducao_palavra": "tremei" },
        { "hebraico": "שַׁאֲנַנֹּ֔ות", "transliteral": "ša-ʾă-nan-nôṯ", "traducao_palavra": "[ó] tranquilas" },
        { "hebraico": "רְגָ֖זָה", "transliteral": "rə-ḡā-zā", "traducao_palavra": "turbai-vos/tremei" },
        { "hebraico": "בֹּֽטְחֹ֑ות", "transliteral": "bō-ṭə-ḥôṯ", "traducao_palavra": "[ó] seguras/confiantes" },
        { "hebraico": "פְּשֹׁ֣טָה", "transliteral": "pə-šō-ṭā", "traducao_palavra": "despi-vos" },
        { "hebraico": "וְעֹ֔רָה", "transliteral": "wə-ʿō-rā", "traducao_palavra": "e ficai nuas" },
        { "hebraico": "וַחֲגֹ֖ורָה", "transliteral": "wa-ḥă-ḡô-rā", "traducao_palavra": "e cingis" },
        { "hebraico": "עַל־חֲלָצָֽיִם׃", "transliteral": "ʿal-ḥă-lā-ṣā-yim", "traducao_palavra": "sobre os lombos [com sacos]" }
      ]
    },
    "12": {
      "traducao_completa": "Batei nos peitos, pelos campos desejáveis e pelas vinhas frutíferas.",
      "palavras": [
        { "hebraico": "עַל־שָׁדַ֖יִם", "transliteral": "ʿal-šā-ḏa-yim", "traducao_palavra": "Sobre os peitos" },
        { "hebraico": "סֹֽפְדִ֑ים", "transliteral": "sō-p̄ə-ḏîm", "traducao_palavra": "lamentando/batendo" },
        { "hebraico": "עַל־שְׂדֵי־", "transliteral": "ʿal-śə-ḏê-", "traducao_palavra": "pelos campos de" },
