        { "hebraico": "הַצֶּ֨דֶק֙", "transliteral": "ha-ṣe-ḏeq", "traducao_palavra": "a justiça" },
        { "hebraico": "שָׁלֹ֑ום", "transliteral": "šā-lôm", "traducao_palavra": "[a] paz" },
