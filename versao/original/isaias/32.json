        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "Não" },
        { "hebraico": "יִקָּרֵ֥א", "transliteral": "yiq-qā-rê", "traducao_palavra": "será chamado" },
        { "hebraico": "עֹ֖וד", "transliteral": "ʿôḏ", "traducao_palavra": "mais" },
        { "hebraico": "לְנָבָ֣ל", "transliteral": "lə-nā-ḇāl", "traducao_palavra": "ao vil/insensato" },
        { "hebraico": "נָדִ֑יב", "transliteral": "nā-ḏîḇ", "traducao_palavra": "nobre" },
        { "hebraico": "וּלְכִילַ֕י", "transliteral": "ū-lə-ḵî-lay", "traducao_palavra": "e ao trapaceiro/avarento" },
        { "hebraico": "לֹ֥א", "transliteral": "lō", "traducao_palavra": "não" },
