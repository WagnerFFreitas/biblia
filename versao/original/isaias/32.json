        { "hebraico": "עֻזָּ֑ב", "transliteral": "ʿuz-zāḇ", "traducao_palavra": "foi deixada" },
        { "hebraico": "עֹ֣פֶל", "transliteral": "ʿō-p̄el", "traducao_palavra": "[o] outeiro" },
