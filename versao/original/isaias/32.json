        { "hebraico": "לְצֶ֖דֶק", "transliteral": "lə-ṣe-ḏeq", "traducao_palavra": "em/com justiça" },
        { "hebraico": "יִמְלָךְ־", "transliteral": "yim-loḵ-", "traducao_palavra": "reinará" },
        { "hebraico": "מֶ֑לֶךְ", "transliteral": "me-leḵ", "traducao_palavra": "um rei" },
        { "hebraico": "וּלְשָׂרִ֖ים", "transliteral": "ū-lə-śā-rîm", "traducao_palavra": "e príncipes" },
        { "hebraico": "לְמִשְׁפָּ֥ט", "transliteral": "lə-miš-pāṭ", "traducao_palavra": "com juízo/justiça" },
        { "hebraico": "יָשֹֽׂרוּ׃", "transliteral": "yā-śō-rû", "traducao_palavra": "governarão" }
      ]
    },
    "2": {
      "traducao_completa": "E será cada um como um esconderijo contra o vento, e um refúgio contra a tempestade, como canais de águas em lugares secos, como a sombra de uma grande rocha em terra sedenta.",
