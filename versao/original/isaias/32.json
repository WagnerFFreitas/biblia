    "18": {
      "traducao_completa": "E o meu povo habitará em morada de paz, e em moradas bem seguras, e em lugares quietos de repouso.",
      "palavras": [
        { "hebraico": "וְיָשַׁ֥ב", "transliteral": "wə-yā-šaḇ", "traducao_palavra": "E habitará" },
        { "hebraico": "עַמִּ֖י", "transliteral": "ʿam-mî", "traducao_palavra": "meu povo" },
        { "hebraico": "בִּנְוֵ֣ה", "transliteral": "bin-wēh", "traducao_palavra": "em habitação de" },
        { "hebraico": "שָׁלֹ֑ום", "transliteral": "šā-lôm", "traducao_palavra": "paz" },
        { "hebraico": "וּבְמִשְׁכְּנֹות֙", "transliteral": "ū-ḇə-miš-kə-nôṯ", "traducao_palavra": "e em moradas" },
        { "hebraico": "מִבְטַחִ֔ים", "transliteral": "miḇ-ṭa-ḥîm", "traducao_palavra": "seguras" },
        { "hebraico": "וּבִמְנוּחֹ֖ת", "transliteral": "ū-ḇim-nû-ḥōṯ", "traducao_palavra": "e em descansos" },
        { "hebraico": "שַׁאֲנַנֹּֽות׃", "transliteral": "ša-ʾă-nan-nôṯ", "traducao_palavra": "tranquilos" }
