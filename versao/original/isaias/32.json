        { "hebraico": "קֹ֖מְנָה", "transliteral": "qō-mə-nā", "traducao_palavra": "levantai-vos" },
        { "hebraico": "שְׁמַ֣עְנָה", "transliteral": "šə-maʿ-nā", "traducao_palavra": "ouvi" },
        { "hebraico": "קֹולִ֑י", "transliteral": "qô-lî", "traducao_palavra": "minha voz" },
