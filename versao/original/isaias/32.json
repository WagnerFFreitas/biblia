        { "hebraico": "כְּמַחֲבֵא־", "transliteral": "kə-ma-ḥă-ḇê-", "traducao_palavra": "como um esconderijo contra" },
        { "hebraico": "ר֨וּחַ֙", "transliteral": "rû-aḥ", "traducao_palavra": "o vento" },
        { "hebraico": "וְסֵ֣תֶר", "transliteral": "wə-śê-ṯer", "traducao_palavra": "e um refúgio de" },
        { "hebraico": "זָ֔רֶם", "transliteral": "zā-rem", "traducao_palavra": "tempestade" },
        { "hebraico": "כְּפַלְגֵי־", "transliteral": "kə-p̄al-ḡê-", "traducao_palavra": "como canais de" },
        { "hebraico": "מַ֖יִם", "transliteral": "ma-yim", "traducao_palavra": "águas" },
        { "hebraico": "בְּצָיֹ֑ון", "transliteral": "bə-ṣā-yôn", "traducao_palavra": "em lugar seco" },
        { "hebraico": "כְּצֵ֥ל", "transliteral": "kə-ṣêl", "traducao_palavra": "como a sombra de" },
        { "hebraico": "סֶֽלַע־", "transliteral": "se-laʿ-", "traducao_palavra": "rocha" },
        { "hebraico": "כָּבֵ֖ד", "transliteral": "kā-ḇēḏ", "traducao_palavra": "pesada/grande" },
        { "hebraico": "בְּאֶ֥רֶץ", "transliteral": "bə-ʾe-reṣ", "traducao_palavra": "em terra" },
