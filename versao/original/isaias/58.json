        { "hebraico": "תֵדָ֑ע", "transliteral": "ṯê-ḏā-ʿ", "traducao_palavra": "sabes/atentas?" },
        { "hebraico": "הֵ֣ן", "transliteral": "hên", "traducao_palavra": "Eis que" },
        { "hebraico": "בְּיֹ֤ום", "transliteral": "bə-yō-wm", "traducao_palavra": "no dia de" },
