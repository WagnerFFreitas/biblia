        { "hebraico": "יֹ֤ום", "transliteral": "yō-wm", "traducao_palavra": "dia" },
        { "hebraico": "יֹום֙", "transliteral": "yō-wm", "traducao_palavra": "dia" },
        { "hebraico": "יִדְרֹשׁ֔וּן", "transliteral": "yiḏ-rō-šūn", "traducao_palavra": "buscam" },
