        { "hebraico": "וּלְבֵ֥ית", "transliteral": "ū-lə-ḇêṯ", "traducao_palavra": "e à casa de" },
        { "hebraico": "יַעֲקֹ֖ב", "transliteral": "ya-ʿă-qōḇ", "traducao_palavra": "Jacó" },
        { "hebraico": "חַטֹּאתָֽם׃", "transliteral": "ḥaṭ-ṭō-w-ṯām", "traducao_palavra": "os pecados deles." }
