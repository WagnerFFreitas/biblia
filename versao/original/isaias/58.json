        { "hebraico": "אֹורֶ֔ךָ", "transliteral": "ʾō-w-re-ḵā", "traducao_palavra": "tua luz" },
        { "hebraico": "וַאֲפֵלָתְךָ֖", "transliteral": "wa-ʾă-p̄ê-lā-ṯə-ḵā", "traducao_palavra": "e tua escuridão" },
        { "hebraico": "כַּֽצָּהֳרָֽיִם׃", "transliteral": "kaṣ-ṣā-ho-rā-yim", "traducao_palavra": "como o meio-dia." }
