        { "hebraico": "שָׂפָה֙", "transliteral": "śā-p̄ā", "traducao_palavra": "lábio/fala" },
        { "hebraico": "מִשְּׁמֹ֔ועַ", "transliteral": "miš-šə-mô-aʿ", "traducao_palavra": "para não ouvir/perceber" },
        { "hebraico": "נִלְעַ֥ג", "transliteral": "nil-ʿaḡ", "traducao_palavra": "balbuciante/estranha" },
        { "hebraico": "לָשֹׁ֖ון", "transliteral": "lā-šôn", "traducao_palavra": "língua" },
        { "hebraico": "אֵ֥ין", "transliteral": "ʾên", "traducao_palavra": "sem" },
        { "hebraico": "בִּינָֽה׃", "transliteral": "bî-nā", "traducao_palavra": "entendimento" }
      ]
    },
    "20": {
      "traducao_completa": "Olha para Sião, a cidade das nossas solenidades; os teus olhos verão Jerusalém, habitação tranquila, tenda que não será removida, cujas estacas nunca serão arrancadas, e das suas cordas nenhuma se quebrará.",
      "palavras": [
        { "hebraico": "חֲזֵ֣ה", "transliteral": "ḥă-zê", "traducao_palavra": "Olha" },
        { "hebraico": "צִיֹּ֔ון", "transliteral": "ṣî-yôn", "traducao_palavra": "Sião" },
        { "hebraico": "קִרְיַ֖ת", "transliteral": "qir-yaṯ", "traducao_palavra": "cidade de" },
        { "hebraico": "מֹועֲדֵ֑נוּ", "transliteral": "mô-ʿă-ḏê-nû", "traducao_palavra": "nossas festas" },
        { "hebraico": "עֵינֶ֨יךָ֙", "transliteral": "ʿê-ne-ḵā", "traducao_palavra": "teus olhos" },
        { "hebraico": "תִּרְאֶ֨ינָה֙", "transliteral": "tir-ʾe-nā", "traducao_palavra": "verão" },
        { "hebraico": "יְרוּשָׁלִַ֨ם֙", "transliteral": "yə-rû-šā-la-yim", "traducao_palavra": "Jerusalém" },
        { "hebraico": "נָוֶ֣ה", "transliteral": "nā-weh", "traducao_palavra": "habitação" },
        { "hebraico": "שַׁאֲנָ֔ן", "transliteral": "ša-ʾă-nān", "traducao_palavra": "tranquila" },
        { "hebraico": "אֹ֣הֶל", "transliteral": "ʾō-hel", "traducao_palavra": "tenda" },
        { "hebraico": "בַּל־יִצְעָ֔ן", "transliteral": "bal-yiṣ-ʿān", "traducao_palavra": "que não será removida" },
        { "hebraico": "בַּל־יִסַּ֤ע", "transliteral": "bal-yis-saʿ", "traducao_palavra": "não se arrancará" },
        { "hebraico": "יְתֵדֹתָיו֙", "transliteral": "yə-ṯê-ḏō-ṯāyw", "traducao_palavra": "suas estacas" },
        { "hebraico": "לָנֶ֔צַח", "transliteral": "lā-ne-ṣaḥ", "traducao_palavra": "jamais" },
        { "hebraico": "וְכָל־חֲבָלָ֖יו", "transliteral": "wə-ḵāl-ḥă-ḇā-lāyw", "traducao_palavra": "e todas as suas cordas" },
        { "hebraico": "בַּל־יִנָּתֵֽקוּ׃", "transliteral": "bal-yin-nā-ṯê-qû", "traducao_palavra": "não se romperão" }
      ]
    },
    "21": {
      "traducao_completa": "Mas ali YHWH nos será glorioso, lugar de rios e correntes largas; barco de remos não passará por eles, nem navio grande navegará por eles.",
      "palavras": [
        { "hebraico": "כִּ֣י", "transliteral": "kî", "traducao_palavra": "Mas" },
        { "hebraico": "אִם־שָׁ֞ם", "transliteral": "ʾim-šām", "traducao_palavra": "se ali" },
        { "hebraico": "אַדִּ֧יר", "transliteral": "ʾad-dîr", "traducao_palavra": "glorioso/majestoso" },
        { "hebraico": "יְהוָ֣ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "לָ֔נוּ", "transliteral": "lā-nû", "traducao_palavra": "para nós" },
        { "hebraico": "מְקֹום־", "transliteral": "mə-qôm-", "traducao_palavra": "lugar de" },
        { "hebraico": "יְאֹרִ֥ים", "transliteral": "yə-ʾō-rîm", "traducao_palavra": "rios" },
        { "hebraico": "נְהָרִ֖ים", "transliteral": "nə-hā-rîm", "traducao_palavra": "correntes" },
        { "hebraico": "רַחֲבֵ֣י", "transliteral": "ra-ḥă-ḇê", "traducao_palavra": "largos de" },
        { "hebraico": "יָדָ֑יִם", "transliteral": "yā-ḏā-yim", "traducao_palavra": "mãos/espaço" },
        { "hebraico": "בַּל־תֵּ֥לֶךְ", "transliteral": "bal-tê-leḵ", "traducao_palavra": "não passará" },
        { "hebraico": "בֹּו֙", "transliteral": "bô", "traducao_palavra": "nele" },
        { "hebraico": "אֳנִי־שַׁ֔יִט", "transliteral": "ʾŏ-nî-ša-yiṭ", "traducao_palavra": "barco de remo" },
        { "hebraico": "וְצִ֥י", "transliteral": "wə-ṣî", "traducao_palavra": "e navio" },
