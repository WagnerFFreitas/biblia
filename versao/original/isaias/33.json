        { "hebraico": "יִצַּֽתּוּ׃", "transliteral": "yiṣ-ṣat-tû", "traducao_palavra": "arderão" }
      ]
    },
    "13": {
      "traducao_completa": "Ouvi, vós os que estais longe, o que eu tenho feito; e vós que estais perto, conhecei o meu poder.",
