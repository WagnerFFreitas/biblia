    },
    "14": {
      "traducao_completa": "Os pecadores em Sião se assombraram, o tremor apoderou-se dos hipócritas. Quem dentre nós habitará com o fogo consumidor? Quem dentre nós habitará com as labaredas eternas?",
      "palavras": [
        { "hebraico": "פָּחֲד֤וּ", "transliteral": "pā-ḥă-ḏû", "traducao_palavra": "Aterrorizaram-se" },
        { "hebraico": "בְצִיֹּון֙", "transliteral": "ḇə-ṣî-yôn", "traducao_palavra": "em Sião" },
        { "hebraico": "חַטָּאִ֔ים", "transliteral": "ḥaṭ-ṭā-ʾîm", "traducao_palavra": "[os] pecadores" },
