      ]
    },
    "22": {
      "traducao_completa": "Porque YHWH é o nosso Juiz; YHWH é o nosso Legislador; YHWH é o nosso Rei; ele nos salvará.",
      "palavras": [
        { "hebraico": "כִּ֤י", "transliteral": "kî", "traducao_palavra": "Porque" },
        { "hebraico": "יְהוָה֙", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "שֹׁפְטֵ֔נוּ", "transliteral": "šō-p̄ə-ṭê-nû", "traducao_palavra": "[é] nosso Juiz" },
        { "hebraico": "יְהוָ֖ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "מְחֹקְקֵ֑נוּ", "transliteral": "mə-ḥō-qə-qê-nû", "traducao_palavra": "[é] nosso Legislador" },
        { "hebraico": "יְהוָ֥ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "מַלְכֵּ֖נוּ", "transliteral": "mal-kê-nû", "traducao_palavra": "[é] nosso Rei" },
        { "hebraico": "ה֥וּא", "transliteral": "hû", "traducao_palavra": "ele" },
        { "hebraico": "יֹושִׁיעֵֽנוּ׃", "transliteral": "yô-šî-ʿê-nû", "traducao_palavra": "nos salvará" }
      ]
    },
    "23": {
      "traducao_completa": "As tuas cordas se afrouxaram; não puderam sustentar o seu mastro, nem desfraldar a vela; então a presa de abundantes despojos se repartirá; até os coxos saquearão a presa.",
      "palavras": [
        { "hebraico": "נִטְּשׁ֖וּ", "transliteral": "niṭ-ṭə-šû", "traducao_palavra": "Afrouxaram-se" },
        { "hebraico": "חֲבָלָ֑יִךְ", "transliteral": "ḥă-ḇā-la-yiḵ", "traducao_palavra": "tuas cordas" },
        { "hebraico": "בַּל־יְחַזְּק֤וּ", "transliteral": "bal-yə-ḥaz-zə-qû", "traducao_palavra": "não puderam sustentar" },
        { "hebraico": "כֵן־תָּרְנָם֙", "transliteral": "kên-tār-nām", "traducao_palavra": "a base de seu mastro" },
        { "hebraico": "בַּל־פָּרְשׂ֣וּ", "transliteral": "bal-pā-rə-śû", "traducao_palavra": "não estenderam/desfraldaram" },
        { "hebraico": "נֵ֔ס", "transliteral": "nêś", "traducao_palavra": "[a] vela/bandeira" },
        { "hebraico": "אָ֤ז", "transliteral": "ʾāz", "traducao_palavra": "então" },
        { "hebraico": "חֻלַּק֙", "transliteral": "ḥul-laq", "traducao_palavra": "foi repartido" },
        { "hebraico": "עַד־שָׁלָ֣ל", "transliteral": "ʿaḏ-šā-lāl", "traducao_palavra": "presas de despojo" },
        { "hebraico": "מַרְבֶּ֔ה", "transliteral": "mar-beh", "traducao_palavra": "muito" },
        { "hebraico": "פִּסְחִ֖ים", "transliteral": "piś-ḥîm", "traducao_palavra": "coxos" },
        { "hebraico": "בָּ֥זְזוּ", "transliteral": "bā-zə-zû", "traducao_palavra": "saquearão" },
        { "hebraico": "בַֽז׃", "transliteral": "ḇaz", "traducao_palavra": "[a] presa" }
      ]
    },
    "24": {
      "traducao_completa": "E habitante nenhum dirá: Estou doente; o povo que nela habitará será perdoado da sua iniquidade.",
      "palavras": [
        { "hebraico": "וּבַל־יֹאמַ֥ר", "transliteral": "ū-ḇal-yō-mar", "traducao_palavra": "E não dirá" },
