    },
    "11": {
      "traducao_completa": "Concebestes palha, dareis à luz restolho; e o vosso sopro será um fogo que vos consumirá.",
      "palavras": [
        { "hebraico": "תַּהֲר֥וּ", "transliteral": "ta-hă-rû", "traducao_palavra": "Concebereis" },
