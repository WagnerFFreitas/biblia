        { "hebraico": "מֶרְחַקִּֽים׃", "transliteral": "mer-ḥaq-qîm", "traducao_palavra": "longínqua/distante" }
      ]
    },
    "18": {
      "traducao_completa": "O teu coração meditará no terror, dizendo: Onde está o escrivão? Onde está o que pesou o tributo? Onde está o que contou as torres?",
      "palavras": [
        { "hebraico": "לִבְּךָ֖", "transliteral": "lib-bə-ḵā", "traducao_palavra": "Teu coração" },
        { "hebraico": "יֶהְגֶּ֣ה", "transliteral": "yeh-geh", "traducao_palavra": "meditará" },
        { "hebraico": "אֵימָ֑ה", "transliteral": "ʾê-mā", "traducao_palavra": "[no] terror" },
        { "hebraico": "אַיֵּ֤ה", "transliteral": "ʾay-yê", "traducao_palavra": "Onde [está]" },
        { "hebraico": "סֹפֵר֙", "transliteral": "śō-p̄êr", "traducao_palavra": "[o] escrivão?" },
        { "hebraico": "אַיֵּ֣ה", "transliteral": "ʾay-yê", "traducao_palavra": "onde [está]" },
        { "hebraico": "שֹׁקֵ֔ל", "transliteral": "šō-qêl", "traducao_palavra": "[o] que pesou?" },
        { "hebraico": "אַיֵּ֖ה", "transliteral": "ʾay-yê", "traducao_palavra": "onde [está]" },
        { "hebraico": "סֹפֵ֥ר", "transliteral": "śō-p̄êr", "traducao_palavra": "[o] que contou" },
        { "hebraico": "אֶת־הַמִּגְדָּלִֽים׃", "transliteral": "ʾeṯ-ham-miḡ-dā-lîm", "traducao_palavra": "as torres?" }
      ]
    },
    "19": {
      "traducao_completa": "Não verás mais aquele povo feroz, povo de fala tão profunda que se não pode perceber, de língua tão estranha que se não pode entender.",
      "palavras": [
        { "hebraico": "אֶת־עַ֥ם", "transliteral": "ʾeṯ-ʿam", "traducao_palavra": "[Objeto] o povo" },
        { "hebraico": "נֹועָ֖ז", "transliteral": "nô-ʿāz", "traducao_palavra": "feroz/insolente" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "תִרְאֶ֑ה", "transliteral": "ṯir-ʾeh", "traducao_palavra": "verás" },
        { "hebraico": "עַ֣ם", "transliteral": "ʿam", "traducao_palavra": "povo de" },
