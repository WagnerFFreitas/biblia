        { "hebraico": "לַחְמֹ֥ו", "transliteral": "laḥ-mô", "traducao_palavra": "seu pão" },
        { "hebraico": "נִתָּ֖ן", "transliteral": "nit-tān", "traducao_palavra": "foi dado/será dado" },
        { "hebraico": "מֵימָ֥יו", "transliteral": "mê-māyw", "traducao_palavra": "suas águas" },
        { "hebraico": "נֶאֱמָנִֽים׃", "transliteral": "ne-ʾĕ-mā-nîm", "traducao_palavra": "[são] fiéis/certas" }
      ]
    },
    "17": {
      "traducao_completa": "Os teus olhos verão o rei na sua formosura; verão a terra que se estende ao longe.",
      "palavras": [
        { "hebraico": "מֶ֥לֶךְ", "transliteral": "me-leḵ", "traducao_palavra": "Rei" },
        { "hebraico": "בְּיָפְיֹ֖ו", "transliteral": "bə-yā-p̄ə-yô", "traducao_palavra": "em sua beleza" },
        { "hebraico": "תֶּחֱזֶ֣ינָה", "transliteral": "te-ḥĕ-ze-y-nā", "traducao_palavra": "verão" },
        { "hebraico": "עֵינֶ֑יךָ", "transliteral": "ʿê-ne-ḵā", "traducao_palavra": "teus olhos" },
        { "hebraico": "תִּרְאֶ֖ינָה", "transliteral": "tir-ʾe-nā", "traducao_palavra": "verão" },
