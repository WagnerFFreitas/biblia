        { "hebraico": "שִׁמְע֥וּ", "transliteral": "šim-ʿû", "traducao_palavra": "Ouvi" },
        { "hebraico": "רְחֹוקִ֖ים", "transliteral": "rə-ḥô-qîm", "traducao_palavra": "[vós os que estais] longe" },
        { "hebraico": "אֲשֶׁ֣ר", "transliteral": "ʾă-šer", "traducao_palavra": "o que" },
        { "hebraico": "עָשִׂ֑יתִי", "transliteral": "ʿā-śî-ṯî", "traducao_palavra": "tenho feito" },
