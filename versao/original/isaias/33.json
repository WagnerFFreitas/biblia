    "16": {
      "traducao_completa": "Este habitará nas alturas; as fortalezas das rochas serão o seu alto refúgio; o seu pão lhe será dado, as suas águas serão certas.",
      "palavras": [
        { "hebraico": "ה֚וּא", "transliteral": "hû", "traducao_palavra": "Ele" },
        { "hebraico": "מְרֹומִ֣ים", "transliteral": "mə-rô-mîm", "traducao_palavra": "[nas] alturas" },
        { "hebraico": "יִשְׁכֹּ֔ן", "transliteral": "yiš-kōn", "traducao_palavra": "habitará" },
        { "hebraico": "מְצָדֹ֥ות", "transliteral": "mə-ṣā-ḏôṯ", "traducao_palavra": "fortalezas de" },
