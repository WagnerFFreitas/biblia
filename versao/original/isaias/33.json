        { "hebraico": "לְךָ֣", "transliteral": "lə-ḵā", "traducao_palavra": "em ti" },
        { "hebraico": "קִוִּ֑ינוּ", "transliteral": "qiw-wî-nû", "traducao_palavra": "esperamos" },
