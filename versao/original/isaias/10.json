        { "hebraico": "יְכַלֶּ֑ה", "transliteral": "yə-ḵal-leh", "traducao_palavra": "ele consumirá" },
        { "hebraico": "וְהָיָ֖ה", "transliteral": "wə-hā-yā", "traducao_palavra": "e será" },
        { "hebraico": "כִּמְסֹ֥ס", "transliteral": "kim-śōs", "traducao_palavra": "como o desfalecer de" },
        { "hebraico": "נֹסֵֽס׃", "transliteral": "nō-śêś", "traducao_palavra": "um doente/porta-bandeira" }
      ]
    },
    "19": {
      "traducao_completa": "E o resto das árvores da sua floresta será em número tão pequeno que um menino as poderá contar.",
      "palavras": [
        { "hebraico": "וּשְׁאָ֥ר", "transliteral": "ū-šə-ʾār", "traducao_palavra": "E o resto de" },
