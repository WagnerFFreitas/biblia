        { "hebraico": "הַה֗וּא", "transliteral": "ha-hû", "traducao_palavra": "aquele" },
        { "hebraico": "לֹא־יֹוסִ֨יף", "transliteral": "lō-yô-śîp̄", "traducao_palavra": "não mais tornará" },
