{
  "livro": "Isaías - יְשַׁעְיָהוּ - Yeshayahu",
  "capítulo": 10,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Ai dos que decretam leis injustas, e dos escrivães que escrevem perversidades,",
      "palavras": [
        { "hebraico": "הֹ֚וי", "transliteral": "hôy", "traducao_palavra": "Ai" },
        { "hebraico": "הַחֹקְקִ֥ים", "transliteral": "ha-ḥō-qə-qîm", "traducao_palavra": "dos que decretam" },
        { "hebraico": "חִקְקֵי־אָ֑וֶן", "transliteral": "ḥiq-qê-ʾā-wen", "traducao_palavra": "estatutos/leis de iniquidade" },
        { "hebraico": "וּמְכַתְּבִ֥ים", "transliteral": "ū-mə-ḵat-tə-ḇîm", "traducao_palavra": "e dos escritores [que]" },
        { "hebraico": "עָמָ֖ל", "transliteral": "ʿā-māl", "traducao_palavra": "perversidade/opressão" },
        { "hebraico": "כִּתֵּֽבוּ׃", "transliteral": "kit-tê-ḇû", "traducao_palavra": "escreveram" }
      ]
    },
    "2": {
