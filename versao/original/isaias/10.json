        { "hebraico": "לְהִשָּׁעֵ֖ן", "transliteral": "lə-hiš-šā-ʿên", "traducao_palavra": "a se apoiar" },
        { "hebraico": "עַל־מַכֵּ֑הוּ", "transliteral": "ʿal-mak-kê-hû", "traducao_palavra": "sobre quem os feriu" },
        { "hebraico": "וְנִשְׁעַ֗ן", "transliteral": "wə-niš-ʿan", "traducao_palavra": "mas se apoiará" },
