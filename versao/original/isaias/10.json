        { "hebraico": "אִם־יִתְגַּדֵּ֥ל", "transliteral": "ʾim-yiṯ-gad-dêl", "traducao_palavra": "ou se engrandecerá" },
        { "hebraico": "הַמַּשֹּׂ֖ור", "transliteral": "ham-maś-śôr", "traducao_palavra": "a serra" },
        { "hebraico": "עַל־מְנִיפֹ֑ו", "transliteral": "ʿal-mə-nî-p̄ô", "traducao_palavra": "sobre o que a move" },
        { "hebraico": "כְּהָנִ֥יף", "transliteral": "kə-hā-nîp̄", "traducao_palavra": "como se movesse" },
        { "hebraico": "שֵׁ֨בֶט֙", "transliteral": "šē-ḇeṭ", "traducao_palavra": "[a] vara" },
        { "hebraico": "אֶת־מְרִימָ֔יו", "transliteral": "ʾeṯ-mə-rî-māyw", "traducao_palavra": "aos que a levantam" },
        { "hebraico": "כְּהָרִ֥ים", "transliteral": "kə-hā-rîm", "traducao_palavra": "como se levantasse" },
