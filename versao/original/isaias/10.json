        { "hebraico": "דַּלִּ֗ים", "transliteral": "dal-lîm", "traducao_palavra": "[os] pobres" },
        { "hebraico": "וְלִגְזֹל֙", "transliteral": "wə-liḡ-zōl", "traducao_palavra": "e para roubar" },
        { "hebraico": "מִשְׁפַּ֞ט", "transliteral": "miš-paṭ", "traducao_palavra": "[o] direito de" },
        { "hebraico": "עֲנִיֵּ֣י", "transliteral": "ʿă-nî-yê", "traducao_palavra": "aflitos de" },
        { "hebraico": "עַמִּ֔י", "transliteral": "ʿam-mî", "traducao_palavra": "meu povo" },
        { "hebraico": "לִהְיֹ֥ות", "transliteral": "lih-yôṯ", "traducao_palavra": "para serem" },
        { "hebraico": "אַלְמָנֹ֖ות", "transliteral": "ʾal-mā-nôṯ", "traducao_palavra": "viúvas" },
        { "hebraico": "שְׁלָלָ֑ם", "transliteral": "šə-lā-lām", "traducao_palavra": "despojo deles" },
        { "hebraico": "וְאֶת־יְתֹומִ֖ים", "transliteral": "wə-ʾeṯ-yə-ṯô-mîm", "traducao_palavra": "e os órfãos" },
        { "hebraico": "יָבֹֽזּוּ׃", "transliteral": "yā-ḇōz-zû", "traducao_palavra": "saquearem/roubarem" }
      ]
    },
    "3": {
      "traducao_completa": "Mas que fareis vós no dia da visitação, e na desolação que há de vir de longe? A quem recorrereis para obter socorro, e onde deixareis a vossa glória,",
      "palavras": [
        { "hebraico": "וּמַֽה־תַּעֲשׂוּ֙", "transliteral": "ū-mah-ta-ʿă-śû", "traducao_palavra": "E o que fareis" },
        { "hebraico": "לְיֹ֣ום", "transliteral": "lə-yôm", "traducao_palavra": "no dia de" },
        { "hebraico": "פְּקֻדָּ֔ה", "transliteral": "pə-qud-dā", "traducao_palavra": "visitação/castigo" },
        { "hebraico": "וּלְשֹׁאָ֖ה", "transliteral": "ū-lə-šô-ʾā", "traducao_palavra": "e na desolação [que]" },
        { "hebraico": "מִמֶּרְחָ֣ק", "transliteral": "mim-mer-ḥāq", "traducao_palavra": "de longe" },
        { "hebraico": "תָּבֹ֑וא", "transliteral": "tā-ḇô", "traducao_palavra": "virá" },
        { "hebraico": "עַל־מִי֙", "transliteral": "ʿal-mî", "traducao_palavra": "para quem" },
        { "hebraico": "תָּנ֣וּסוּ", "transliteral": "tā-nû-śû", "traducao_palavra": "fugireis" },
        { "hebraico": "לְעֶזְרָ֔ה", "transliteral": "lə-ʿez-rā", "traducao_palavra": "por socorro" },
        { "hebraico": "וְאָ֥נָה", "transliteral": "wə-ʾā-nā", "traducao_palavra": "e onde" },
        { "hebraico": "תַעַזְב֖וּ", "transliteral": "ta-ʿaz-ḇû", "traducao_palavra": "deixareis" },
        { "hebraico": "כְּבֹודְכֶֽם׃", "transliteral": "kə-ḇô-ḏə-ḵem", "traducao_palavra": "vossa glória/riqueza" }
      ]
    },
    "4": {
      "traducao_completa": "sem que vos tenhais de curvar entre os presos, ou cair entre os mortos? Com tudo isto não se apartou a sua ira, mas ainda está estendida a sua mão.",
      "palavras": [
        { "hebraico": "בִּלְתִּ֣י", "transliteral": "bil-tî", "traducao_palavra": "Exceto/sem que" },
        { "hebraico": "כָרַ֗ע", "transliteral": "ḵā-raʿ", "traducao_palavra": "[se] curve" },
        { "hebraico": "תַּ֧חַת", "transliteral": "ta-ḥaṯ", "traducao_palavra": "entre/debaixo de" },
        { "hebraico": "אַסִּיר", "transliteral": "ʾaś-śîr", "traducao_palavra": "presos" },
        { "hebraico": "וְתַ֥חַת", "transliteral": "wə-ṯa-ḥaṯ", "traducao_palavra": "e entre" },
        { "hebraico": "הֲרוּגִ֖ים", "transliteral": "hă-rû-ḡîm", "traducao_palavra": "mortos" },
        { "hebraico": "יִפֹּ֑לוּ", "transliteral": "yip-pō-lû", "traducao_palavra": "cairão" },
        { "hebraico": "בְּכָל־זֹאת֙", "transliteral": "bə-ḵāl-zōṯ", "traducao_palavra": "com tudo isto" },
        { "hebraico": "לֹא־שָׁ֣ב", "transliteral": "lō-šāḇ", "traducao_palavra": "não cessou" },
        { "hebraico": "אַפֹּ֔ו", "transliteral": "ap-pô", "traducao_palavra": "sua ira" },
        { "hebraico": "וְעֹ֥וד", "transliteral": "wə-ʿôḏ", "traducao_palavra": "e ainda" },
        { "hebraico": "יָדֹֹ֖ו", "transliteral": "yā-ḏô", "traducao_palavra": "sua mão" },
        { "hebraico": "נְטוּיָֽה׃", "transliteral": "nə-ṭû-yā", "traducao_palavra": "está estendida" }
      ]
    },
    "5": {
      "traducao_completa": "Ai da Assíria, a vara da minha ira! O bordão da minha indignação está na sua mão.",
      "palavras": [
        { "hebraico": "הֹ֥וי", "transliteral": "hôy", "traducao_palavra": "Ai de" },
        { "hebraico": "אַשּׁ֖וּר", "transliteral": "ʾaš-šûr", "traducao_palavra": "Assíria" },
        { "hebraico": "שֵׁ֣בֶט", "transliteral": "šē-ḇeṭ", "traducao_palavra": "vara de" },
        { "hebraico": "אַפִּ֑י", "transliteral": "ʾap-pî", "traducao_palavra": "minha ira" },
        { "hebraico": "וּמַטֶּה־", "transliteral": "ū-maṭ-ṭeh-", "traducao_palavra": "e o bordão/cajado" },
        { "hebraico": "ה֤וּא", "transliteral": "hû", "traducao_palavra": "que" },
        { "hebraico": "בְיָדָם֙", "transliteral": "ḇə-yā-ḏām", "traducao_palavra": "na mão deles [está]" },
        { "hebraico": "זַעְמִֽי׃", "transliteral": "zaʿ-mî", "traducao_palavra": "minha indignação" }
      ]
    },
    "6": {
      "traducao_completa": "Enviá-lo-ei contra uma nação hipócrita, e contra o povo do meu furor lhe darei ordem, para que lhe tire o despojo, e lhe roube a presa, e o ponha para ser pisado como a lama das ruas.",
      "palavras": [
        { "hebraico": "בְּגֹ֥וי", "transliteral": "bə-ḡôy", "traducao_palavra": "Contra nação" },
        { "hebraico": "חָנֵ֖ף", "transliteral": "ḥā-nêp̄", "traducao_palavra": "hipócrita" },
        { "hebraico": "אֲשַׁלְּחֶ֑נּוּ", "transliteral": "ʾă-šal-lə-ḥen-nû", "traducao_palavra": "enviá-lo-ei" },
        { "hebraico": "וְעַל־עַ֥ם", "transliteral": "wə-ʿal-ʿam", "traducao_palavra": "e contra o povo de" },
        { "hebraico": "עֶבְרָתִ֖י", "transliteral": "ʿeḇ-rā-ṯî", "traducao_palavra": "meu furor" },
        { "hebraico": "אֲצַוֶּ֜נּוּ", "transliteral": "ʾă-ṣaw-wen-nû", "traducao_palavra": "darei a ele ordem" },
        { "hebraico": "לִשְׁלֹ֥ל", "transliteral": "liš-lōl", "traducao_palavra": "para despojar" },
        { "hebraico": "שָׁלָ֛ל", "transliteral": "šā-lāl", "traducao_palavra": "[o] despojo" },
        { "hebraico": "וְלָבֹ֥ז", "transliteral": "wə-lā-ḇōz", "traducao_palavra": "e para saquear" },
        { "hebraico": "בַּ֖ז", "transliteral": "baz", "traducao_palavra": "[a] presa" },
        { "hebraico": "וּלְשׂוּמֹ֥ו", "transliteral": "ū-lə-śû-mô", "traducao_palavra": "e para pô-lo" },
        { "hebraico": "מִרְמָ֖ס", "transliteral": "mir-mās", "traducao_palavra": "[como] pisoteio" },
        { "hebraico": "כְּחֹ֥מֶר", "transliteral": "kə-ḥō-mer", "traducao_palavra": "como lama de" },
        { "hebraico": "חוּצֹֽות׃", "transliteral": "ḥû-ṣôṯ", "traducao_palavra": "ruas" }
      ]
    },
    "7": {
      "traducao_completa": "Contudo ele não o imagina assim, nem o seu coração o pensa desta maneira; antes no seu coração intenta destruir e desarraigar não poucas nações.",
      "palavras": [
        { "hebraico": "וְהוּא֙", "transliteral": "wə-hû", "traducao_palavra": "Mas ele" },
        { "hebraico": "לֹא־כֵ֣ן", "transliteral": "lō-ḵên", "traducao_palavra": "não assim" },
        { "hebraico": "יְדַמֶּ֔ה", "transliteral": "yə-ḏam-meh", "traducao_palavra": "imagina/planeja" },
        { "hebraico": "וּלְבָבֹ֖ו", "transliteral": "ū-lə-ḇā-ḇô", "traducao_palavra": "e seu coração" },
        { "hebraico": "לֹא־כֵ֣ן", "transliteral": "lō-ḵên", "traducao_palavra": "não assim" },
        { "hebraico": "יַחְשֹׁ֑ב", "transliteral": "yaḥ-šōḇ", "traducao_palavra": "pensa" },
        { "hebraico": "כִּ֚י", "transliteral": "kî", "traducao_palavra": "antes" },
        { "hebraico": "לְהַשְׁמִ֣יד", "transliteral": "lə-haš-mîḏ", "traducao_palavra": "para destruir" },
        { "hebraico": "בִּלְבָבֹ֔ו", "transliteral": "bil-ḇā-ḇô", "traducao_palavra": "[está] no seu coração" },
        { "hebraico": "וּלְהַכְרִ֥ית", "transliteral": "ū-lə-haḵ-rîṯ", "traducao_palavra": "e para cortar/extirpar" },
        { "hebraico": "גֹּויִ֖ם", "transliteral": "gô-yim", "traducao_palavra": "nações" },
        { "hebraico": "לֹ֥א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "מְעָֽט׃", "transliteral": "mə-ʿāṭ", "traducao_palavra": "poucas" }
      ]
    },
    "8": {
      "traducao_completa": "Porque diz: Não são meus príncipes todos eles reis?",
      "palavras": [
        { "hebraico": "כִּ֖י", "transliteral": "kî", "traducao_palavra": "Porque" },
        { "hebraico": "יֹאמַ֑ר", "transliteral": "yō-mar", "traducao_palavra": "disse [ele]" },
        { "hebraico": "הֲלֹ֥א", "transliteral": "hă-lō", "traducao_palavra": "Acaso não" },
        { "hebraico": "שָׂרַ֛י", "transliteral": "śā-ray", "traducao_palavra": "meus príncipes" },
        { "hebraico": "יַחְדָּ֖ו", "transliteral": "yaḥ-dāw", "traducao_palavra": "juntamente" },
        { "hebraico": "מְלָכִֽים׃", "transliteral": "mə-lā-ḵîm", "traducao_palavra": "[são] reis?" }
      ]
    },
    "9": {
      "traducao_completa": "Não é Calno como Carquemis? Não é Hamate como Arpade? E Samaria como Damasco?",
      "palavras": [
        { "hebraico": "הֲלֹ֥א", "transliteral": "hă-lō", "traducao_palavra": "Acaso não [é]" },
        { "hebraico": "כְּכַרְכְּמִ֖ישׁ", "transliteral": "kə-ḵar-kə-mîš", "traducao_palavra": "como Carquemis" },
        { "hebraico": "כַּלְנֹ֑ו", "transliteral": "kal-nô", "traducao_palavra": "Calno?" },
        { "hebraico": "אִם־לֹ֥א", "transliteral": "ʾim-lō", "traducao_palavra": "ou não [é]" },
        { "hebraico": "כְאַרְפַּ֖ד", "transliteral": "ḵə-ʾar-pad", "traducao_palavra": "como Arpade" },
        { "hebraico": "חֲמָ֑ת", "transliteral": "ḥă-māṯ", "traducao_palavra": "Hamate?" },
        { "hebraico": "אִם־לֹ֥א", "transliteral": "ʾim-lō", "traducao_palavra": "ou não [é]" },
        { "hebraico": "כְדַמֶּ֖שֶׂק", "transliteral": "ḵə-ḏam-me-śeq", "traducao_palavra": "como Damasco" },
        { "hebraico": "שֹׁמְרֹֽון׃", "transliteral": "šō-mə-rôn", "traducao_palavra": "Samaria?" }
      ]
    },
    "10": {
      "traducao_completa": "Como a minha mão alcançou os reinos dos ídolos, cujas imagens de escultura eram melhores do que as de Jerusalém e de Samaria,",
      "palavras": [
        { "hebraico": "כַּאֲשֶׁ֨ר", "transliteral": "ka-ʾă-šer", "traducao_palavra": "Conforme/como" },
        { "hebraico": "מָצְאָ֤ה", "transliteral": "mā-ṣə-ʾā", "traducao_palavra": "alcançou" },
        { "hebraico": "יָדִי֙", "transliteral": "yā-ḏî", "traducao_palavra": "minha mão" },
        { "hebraico": "לְמַמְלְכֹ֣ת", "transliteral": "lə-mam-lə-ḵōṯ", "traducao_palavra": "os reinos de" },
        { "hebraico": "הָאֱלִ֑יל", "transliteral": "hā-ʾĕ-lîl", "traducao_palavra": "ídolos" },
        { "hebraico": "וּפְסִ֣ילֵיהֶ֔ם", "transliteral": "ū-p̄ə-śî-lê-hem", "traducao_palavra": "e suas imagens esculpidas" },
        { "hebraico": "מִירוּשָׁלִַ֖ם", "transliteral": "mî-rû-šā-la-yim", "traducao_palavra": "[melhores] que as de Jerusalém" },
        { "hebraico": "וּמִשֹּׁמְרֹֽון׃", "transliteral": "ū-miš-šō-mə-rôn", "traducao_palavra": "e de Samaria" }
      ]
    },
    "11": {
      "traducao_completa": "porventura, como fiz a Samaria e aos seus ídolos, não faria eu assim também a Jerusalém e aos seus ídolos?",
      "palavras": [
        { "hebraico": "הֲלֹ֗א", "transliteral": "hă-lō", "traducao_palavra": "Acaso não" },
        { "hebraico": "כַּאֲשֶׁ֥ר", "transliteral": "ka-ʾă-šer", "traducao_palavra": "conforme" },
        { "hebraico": "עָשִׂ֛יתִי", "transliteral": "ʿā-śî-ṯî", "traducao_palavra": "eu fiz" },
        { "hebraico": "לְשֹׁמְרֹ֖ון", "transliteral": "lə-šō-mə-rôn", "traducao_palavra": "a Samaria" },
        { "hebraico": "וּלְאֱלִילֶ֑יהָ", "transliteral": "ū-lə-ʾĕ-lî-le-hā", "traducao_palavra": "e aos seus ídolos" },
        { "hebraico": "כֵּ֥ן", "transliteral": "kên", "traducao_palavra": "assim" },
        { "hebraico": "אֶעֱשֶׂ֛ה", "transliteral": "ʾe-ʿĕ-śeh", "traducao_palavra": "farei" },
        { "hebraico": "לִירֽוּשָׁלִַ֖ם", "transliteral": "lî-rû-šā-la-yim", "traducao_palavra": "a Jerusalém" },
        { "hebraico": "וְלַעֲצַבֶּֽיהָ׃", "transliteral": "wə-la-ʿă-ṣab-be-hā", "traducao_palavra": "e às suas imagens/ídolos?" }
      ]
    },
    "12": {
      "traducao_completa": "Por isso acontecerá que, havendo o Senhor acabado toda a sua obra no monte Sião e em Jerusalém, então castigarei o fruto da arrogância do coração do rei da Assíria e a pompa da altivez dos seus olhos.",
      "palavras": [
        { "hebraico": "וְהָיָ֗ה", "transliteral": "wə-hā-yā", "traducao_palavra": "E acontecerá" },
        { "hebraico": "כִּֽי־יְבַצַּ֤ע", "transliteral": "kî-yə-ḇaṣ-ṣaʿ", "traducao_palavra": "quando completar" },
        { "hebraico": "אֲדֹנָי֙", "transliteral": "ʾă-ḏō-nāy", "traducao_palavra": "o Senhor" },
        { "hebraico": "אֶת־כָּל־מַעֲשֵׂ֔הוּ", "transliteral": "ʾeṯ-kāl-ma-ʿă-śê-hû", "traducao_palavra": "toda a sua obra" },
        { "hebraico": "בְּהַ֥ר", "transliteral": "bə-har", "traducao_palavra": "no monte" },
        { "hebraico": "צִיֹּ֖ון", "transliteral": "ṣî-yôn", "traducao_palavra": "Sião" },
        { "hebraico": "וּבִירוּשָׁלִָ֑ם", "transliteral": "ū-ḇî-rû-šā-la-yim", "traducao_palavra": "e em Jerusalém" },
        { "hebraico": "אֶפְקֹ֥ד", "transliteral": "ʾep̄-qōḏ", "traducao_palavra": "eu visitarei/punirei" },
        { "hebraico": "עַל־פְּרִי־גֹ֣דֶל", "transliteral": "ʿal-pə-rî-ḡō-ḏel", "traducao_palavra": "o fruto da grandeza de" },
        { "hebraico": "לֵבָ֣ב", "transliteral": "lê-ḇāḇ", "traducao_palavra": "coração" },
        { "hebraico": "מֶֽלֶךְ־אַשּׁ֔וּר", "transliteral": "me-leḵ-ʾaš-šûr", "traducao_palavra": "[do] rei da Assíria" },
        { "hebraico": "וְעַל־תִּפְאֶ֖רֶת", "transliteral": "wə-ʿal-tip̄-ʾe-reṯ", "traducao_palavra": "e a glória/pompa de" },
