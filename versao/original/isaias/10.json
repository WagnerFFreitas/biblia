        { "hebraico": "אֶחָֽד׃", "transliteral": "ʾe-ḥāḏ", "traducao_palavra": "único" }
      ]
    },
    "18": {
      "traducao_completa": "Também consumirá a glória da sua floresta e do seu campo fértil, desde a alma até à carne; e será como quando desfalece um porta-bandeira.",
      "palavras": [
