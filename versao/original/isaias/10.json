        { "hebraico": "כִּי־עֹ֥וד", "transliteral": "kî-ʿôḏ", "traducao_palavra": "Porque ainda" },
        { "hebraico": "מְעַ֖ט", "transliteral": "mə-ʿaṭ", "traducao_palavra": "um pouco" },
        { "hebraico": "מִזְעָ֑ר", "transliteral": "miz-ʿār", "traducao_palavra": "muito breve" },
        { "hebraico": "וְכָ֣לָה", "transliteral": "wə-ḵā-lā", "traducao_palavra": "e terminará" },
        { "hebraico": "זַ֔עַם", "transliteral": "za-ʿam", "traducao_palavra": "[a] indignação" },
