        { "hebraico": "אֹור־יִשְׂרָאֵל֙", "transliteral": "ʾôr-yiś-rā-ʾēl", "traducao_palavra": "a luz de Israel" },
        { "hebraico": "לְאֵ֔שׁ", "transliteral": "lə-ʾēš", "traducao_palavra": "por fogo" },
        { "hebraico": "וּקְדֹושֹׁ֖ו", "transliteral": "ū-qə-ḏô-šô", "traducao_palavra": "e o seu Santo" },
        { "hebraico": "לְלֶהָבָ֑ה", "transliteral": "lə-le-hā-ḇā", "traducao_palavra": "por labareda" },
