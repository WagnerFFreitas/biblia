    "15": {
      "traducao_completa": "Porventura gloriar-se-á o machado contra o que corta com ele? Ou se engrandecerá a serra contra o que a maneja? Como se a vara movesse o que a levanta, ou como se o bordão levantasse o que não é madeira!",
      "palavras": [
        { "hebraico": "הֲיִתְפָּאֵ֤ר", "transliteral": "hă-yiṯ-pā-ʾēr", "traducao_palavra": "Acaso se gloriará" },
        { "hebraico": "הַגַּרְזֶן֙", "transliteral": "hag-gar-zen", "traducao_palavra": "o machado" },
        { "hebraico": "עַ֖ל", "transliteral": "ʿal", "traducao_palavra": "sobre/contra" },
