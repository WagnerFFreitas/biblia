      ]
    },
    "11": {
      "traducao_completa": "Eis que todos os seus companheiros serão envergonhados; pois os próprios artífices são apenas homens; ajuntem-se todos eles, apresentem-se; temerão e serão envergonhados juntamente.",
      "palavras": [
        { "hebraico": "הֵן", "transliteral": "hēn", "traducao_palavra": "Eis" },
        { "hebraico": "כָּל־", "transliteral": "kāl-", "traducao_palavra": "todos" },
        { "hebraico": "חֲבֵרָ֣יו", "transliteral": "ḥă-ḇê-rāy-w", "traducao_palavra": "seus companheiros" },
        { "hebraico": "יֵבֹ֔שׁוּ", "transliteral": "yē-ḇō-šū", "traducao_palavra": "serão envergonhados" },
        { "hebraico": "וְחָרָשִׁ֥ים", "transliteral": "wə-ḥā-rā-šîm", "traducao_palavra": "e os artífices" },
        { "hebraico": "הֵ֖מָּה", "transliteral": "hêm-māh", "traducao_palavra": "eles" },
        { "hebraico": "מֵאָדָ֑ם", "transliteral": "mē-ʾā-ḏām", "traducao_palavra": "[são] de homens" },
        { "hebraico": "יִֽתְקַבְּצ֤וּ", "transliteral": "yiṯ-qab-bə-ṣū", "traducao_palavra": "ajuntem-se" },
        { "hebraico": "כֻלָּם֙", "transliteral": "ḵul-lām", "traducao_palavra": "todos eles" },
        { "hebraico": "יַעֲמֹ֔דוּ", "transliteral": "ya-ʿă-mō-ḏū", "traducao_palavra": "apresentem-se" },
        { "hebraico": "יִפְחֲד֥וּ", "transliteral": "yip̄-ḥă-ḏū", "traducao_palavra": "temerão" },
        { "hebraico": "יֵבֹ֖שׁוּ", "transliteral": "yē-ḇō-šū", "traducao_palavra": "serão envergonhados" },
        { "hebraico": "יַחְדָּֽו׃", "transliteral": "yaḥ-dāw", "traducao_palavra": "juntamente." }
      ]
    },
    "12": {
      "traducao_completa": "O ferreiro trabalha com a ferramenta no fogo, e forma a imagem com martelos, e a trabalha com a força do seu braço; ele tem fome e a sua força desfalece; não bebe água e cansa-se.",
      "palavras": [
        { "hebraico": "חָרַ֤שׁ", "transliteral": "ḥā-raš", "traducao_palavra": "Trabalhou/cortou" },
        { "hebraico": "בַּרְזֶל֙", "transliteral": "bar-zel", "traducao_palavra": "[o de] ferro" },
        { "hebraico": "מַֽעֲצָ֔ד", "transliteral": "ma-ʿă-ṣāḏ", "traducao_palavra": "[com a] ferramenta/machadinha" },
        { "hebraico": "וּפָעַל֙", "transliteral": "ū-p̄ā-ʿal", "traducao_palavra": "e operou" },
        { "hebraico": "בַּפֶּחָ֔ם", "transliteral": "bap-pe-ḥām", "traducao_palavra": "no carvão/fogo" },
        { "hebraico": "וּבַמַּקָּבֹ֖ות", "transliteral": "ū-ḇam-maq-qā-ḇō-wṯ", "traducao_palavra": "e com martelos" },
        { "hebraico": "יִצְּרֵ֑הוּ", "transliteral": "yiṣ-ṣə-rē-hū", "traducao_palavra": "a formou" },
        { "hebraico": "וַיִּפְעָלֵ֖הוּ", "transliteral": "way-yip̄-ʿā-lē-hū", "traducao_palavra": "e a operou" },
        { "hebraico": "בִּזְרֹ֣עַ", "transliteral": "biz-rō-aʿ", "traducao_palavra": "com [o] braço de" },
        { "hebraico": "כֹּחֹ֑ו", "transliteral": "kō-ḥō-w", "traducao_palavra": "sua força" },
        { "hebraico": "גַּם־", "transliteral": "gam-", "traducao_palavra": "também" },
        { "hebraico": "רָעֵב֙", "transliteral": "rā-ʿēḇ", "traducao_palavra": "tem fome" },
        { "hebraico": "וְאֵ֣ין", "transliteral": "wə-ʾên", "traducao_palavra": "e não há" },
        { "hebraico": "כֹּ֔חַ", "transliteral": "kō-aḥ", "traducao_palavra": "força" },
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "שָׁ֥תָה", "transliteral": "šā-ṯāh", "traducao_palavra": "bebeu" },
        { "hebraico": "מַ֖יִם", "transliteral": "ma-yim", "traducao_palavra": "águas" },
        { "hebraico": "וַיִּיעָֽף׃", "transliteral": "way-yî-ʿāp̄", "traducao_palavra": "e cansa-se." }
      ]
    },
    "13": {
      "traducao_completa": "O artífice de madeira estende a corda, desenha com o giz, trabalha com o cinzel e desenha com o compasso; e a faz à semelhança de um homem, conforme a beleza de um homem, para habitar em uma casa.",
      "palavras": [
        { "hebraico": "חָרַ֣שׁ", "transliteral": "ḥā-raš", "traducao_palavra": "Trabalhou/cortou" },
        { "hebraico": "עֵצִים֮", "transliteral": "ʿê-ṣîm", "traducao_palavra": "madeiras" },
        { "hebraico": "נָ֣טָה", "transliteral": "nā-ṭāh", "traducao_palavra": "estendeu" },
        { "hebraico": "קָו֒", "transliteral": "qāw", "traducao_palavra": "[o] cordel" },
        { "hebraico": "יְתָאֲרֵ֣הוּ", "transliteral": "yə-ṯā-ʾă-rē-hū", "traducao_palavra": "desenhou-a" },
        { "hebraico": "בַשֶּׂ֗רֶד", "transliteral": "ḇaś-śe-reḏ", "traducao_palavra": "com giz/estilete" },
        { "hebraico": "יַעֲשֵׂ֙הוּ֙", "transliteral": "ya-ʿă-śē-hū", "traducao_palavra": "trabalha nela" },
        { "hebraico": "בַּמַּקְצֻעֹ֔ות", "transliteral": "bam-maq-ṣu-ʿō-wṯ", "traducao_palavra": "com as plainas" },
        { "hebraico": "וּבַמְּחוּגָ֖ה", "transliteral": "ū-ḇam-mə-ḥū-ḡāh", "traducao_palavra": "e com o compasso" },
        { "hebraico": "יְתָאֳרֵ֑הוּ", "transliteral": "yə-ṯā-ʾo-rē-hū", "traducao_palavra": "desenha-a" },
        { "hebraico": "וַֽיַּעֲשֵׂ֙הוּ֙", "transliteral": "way-ya-ʿă-śē-hū", "traducao_palavra": "e a faz" },
        { "hebraico": "כְּתַבְנִ֣ית", "transliteral": "kə-ṯaḇ-nîṯ", "traducao_palavra": "conforme a forma de" },
        { "hebraico": "אִ֔ישׁ", "transliteral": "ʾîš", "traducao_palavra": "um homem" },
        { "hebraico": "כְּתִפְאֶ֥רֶת", "transliteral": "kə-ṯip̄-ʾe-reṯ", "traducao_palavra": "conforme a beleza de" },
        { "hebraico": "אָדָ֖ם", "transliteral": "ʾā-ḏām", "traducao_palavra": "um humano" },
        { "hebraico": "לָשֶׁ֥בֶת", "transliteral": "lā-še-ḇeṯ", "traducao_palavra": "para habitar [em]" },
        { "hebraico": "בָּֽיִת׃", "transliteral": "bā-yiṯ", "traducao_palavra": "uma casa." }
      ]
    },
    "14": {
      "traducao_completa": "Corta para si cedros, e toma o cipreste e o carvalho, e escolhe para si entre as árvores do bosque; planta um olmo, e a chuva o faz crescer.",
      "palavras": [
        { "hebraico": "לִכְרָת־", "transliteral": "liḵ-rāṯ-", "traducao_palavra": "Para cortar" },
        { "hebraico": "לֹ֣ו", "transliteral": "lō-w", "traducao_palavra": "para si" },
        { "hebraico": "אֲרָזִ֔ים", "transliteral": "ʾă-rā-zîm", "traducao_palavra": "cedros" },
        { "hebraico": "וַיִּקַּ֤ח", "transliteral": "way-yiq-qaḥ", "traducao_palavra": "e tomou" },
        { "hebraico": "תִּרְזָה֙", "transliteral": "tir-zāh", "traducao_palavra": "cipreste" },
        { "hebraico": "וְאַלֹּ֔ון", "transliteral": "wə-ʾal-lō-wn", "traducao_palavra": "e carvalho" },
        { "hebraico": "וַיְאַמֶּץ־", "transliteral": "way-ʾam-meṣ-", "traducao_palavra": "e escolheu/fortaleceu" },
        { "hebraico": "לֹ֖ו", "transliteral": "lō-w", "traducao_palavra": "para si" },
        { "hebraico": "בַּעֲצֵי־", "transliteral": "ba-ʿă-ṣê-", "traducao_palavra": "entre as árvores de" },
        { "hebraico": "יָ֑עַר", "transliteral": "yā-ʿar", "traducao_palavra": "[o] bosque" },
        { "hebraico": "נָטַ֥ע", "transliteral": "nā-ṭaʿ", "traducao_palavra": "plantou" },
        { "hebraico": "אֹ֖רֶן", "transliteral": "ʾō-ren", "traducao_palavra": "um olmo/pinheiro" },
        { "hebraico": "וְגֶ֥שֶׁם", "transliteral": "wə-ḡe-šem", "traducao_palavra": "e a chuva" },
        { "hebraico": "יְגַדֵּֽל׃", "transliteral": "yə-ḡad-dēl", "traducao_palavra": "fez crescer." }
      ]
    },
    "15": {
      "traducao_completa": "Então serve ao homem para queimar; e toma deles e se aquece; e também acende o fogo e coze o pão; e também faz um deus e se prostra diante dele; faz dele uma imagem de escultura e se encurva diante dela.",
      "palavras": [
        { "hebraico": "וְהָיָ֥ה", "transliteral": "wə-hā-yāh", "traducao_palavra": "E foi/serviu" },
        { "hebraico": "לְאָדָ֖ם", "transliteral": "lə-ʾā-ḏām", "traducao_palavra": "para o homem" },
        { "hebraico": "לְבָעֵ֑ר", "transliteral": "lə-ḇā-ʿēr", "traducao_palavra": "para queimar" },
        { "hebraico": "וַיִּקַּ֤ח", "transliteral": "way-yiq-qaḥ", "traducao_palavra": "e tomou" },
        { "hebraico": "מֵהֶם֙", "transliteral": "mē-hem", "traducao_palavra": "deles" },
        { "hebraico": "וַיָּ֔חַם", "transliteral": "way-yā-ḥam", "traducao_palavra": "e se aqueceu" },
        { "hebraico": "אַף־", "transliteral": "ʾap̄-", "traducao_palavra": "também" },
        { "hebraico": "יַשִּׂ֖יק", "transliteral": "yaś-śîq", "traducao_palavra": "acendeu" },
        { "hebraico": "וְאָ֣פָה", "transliteral": "wə-ʾā-p̄āh", "traducao_palavra": "e cozeu" },
        { "hebraico": "לָ֑חֶם", "transliteral": "lā-ḥem", "traducao_palavra": "pão" },
        { "hebraico": "אַף־", "transliteral": "ʾap̄-", "traducao_palavra": "também" },
        { "hebraico": "יִפְעַל־", "transliteral": "yip̄-ʿal-", "traducao_palavra": "faz" },
        { "hebraico": "אֵל֙", "transliteral": "ʾēl", "traducao_palavra": "um deus" },
        { "hebraico": "וַיִּשְׁתָּ֔חוּ", "transliteral": "way-yiš-tā-ḥū", "traducao_palavra": "e se prostra" },
        { "hebraico": "עָשָׂ֥הוּ", "transliteral": "ʿā-śā-hū", "traducao_palavra": "faz dele" },
        { "hebraico": "פֶ֖סֶל", "transliteral": "p̄e-sel", "traducao_palavra": "imagem esculpida" },
        { "hebraico": "וַיִּסְגַּד־", "transliteral": "way-yis-gad-", "traducao_palavra": "e se encurva" },
        { "hebraico": "לָֽמֹו׃", "transliteral": "lā-mōw", "traducao_palavra": "diante dela." }
      ]
    },
    "16": {
      "traducao_completa": "Metade dele queimou no fogo; com essa metade come carne, assa o assado e se farta; também se aquece e diz: Ah! já me aqueci, vi o fogo.",
      "palavras": [
        { "hebraico": "חֶצְיֹו֙", "transliteral": "ḥeṣ-yō-w", "traducao_palavra": "Metade dele" },
        { "hebraico": "שָׂרַ֣ף", "transliteral": "śā-rap̄", "traducao_palavra": "queimou" },
        { "hebraico": "בְּמֹו־", "transliteral": "bə-mō-", "traducao_palavra": "no" },
        { "hebraico": "אֵ֔שׁ", "transliteral": "ʾēš", "traducao_palavra": "fogo" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre" },
        { "hebraico": "חֶצְיֹ֥ו", "transliteral": "ḥeṣ-yō-w", "traducao_palavra": "metade dele" },
        { "hebraico": "בָּשָׂ֥ר", "transliteral": "bā-śār", "traducao_palavra": "carne" },
        { "hebraico": "יֹאכֵ֖ל", "transliteral": "yō-w-ḵēl", "traducao_palavra": "ele come" },
        { "hebraico": "יִצְלֶ֥ה", "transliteral": "yiṣ-leh", "traducao_palavra": "ele assa" },
        { "hebraico": "צָלִ֖י", "transliteral": "ṣā-lî", "traducao_palavra": "o assado" },
        { "hebraico": "וְיִשְׂבָּ֑ע", "transliteral": "wə-yiś-bā-ʿ", "traducao_palavra": "e se farta" },
        { "hebraico": "אַף־", "transliteral": "ʾap̄-", "traducao_palavra": "também" },
        { "hebraico": "יָחַם֙", "transliteral": "yā-ḥam", "traducao_palavra": "se aquece" },
        { "hebraico": "וַיֹּאמַ֣ר", "transliteral": "way-yō-mar", "traducao_palavra": "e diz" },
        { "hebraico": "הֶאָ֔ח", "transliteral": "he-ʾāḥ", "traducao_palavra": "Ah!" },
        { "hebraico": "חַמֹּותִ֖י", "transliteral": "ḥam-mō-w-ṯî", "traducao_palavra": "aqueci-me" },
        { "hebraico": "רָאִ֥יתִי", "transliteral": "rā-ʾî-ṯî", "traducao_palavra": "vi" },
        { "hebraico": "אֹֽור׃", "transliteral": "ʾō-wr", "traducao_palavra": "o fogo/luz." }
      ]
    },
    "17": {
      "traducao_completa": "E do resto dele faz um deus, a sua imagem de escultura; encurva-se diante dela, e se prostra, e lhe roga, e diz: Livra-me, porquanto tu és o meu deus.",
      "palavras": [
        { "hebraico": "וּשְׁאֵרִיתֹו֙", "transliteral": "ū-šə-ʾē-rî-ṯō-w", "traducao_palavra": "E o resto dele" },
        { "hebraico": "לְאֵ֣ל", "transliteral": "lə-ʾēl", "traducao_palavra": "para deus" },
        { "hebraico": "עָשָׂ֔ה", "transliteral": "ʿā-śā", "traducao_palavra": "fez" },
        { "hebraico": "לְפִסְלֹ֖ו", "transliteral": "lə-p̄is-lō-w", "traducao_palavra": "para sua imagem esculpida" },
        { "hebraico": "יִסְגָּד־", "transliteral": "yis-gāḏ-", "traducao_palavra": "encurva-se" },
        { "hebraico": "לֹ֥ו", "transliteral": "lō-w", "traducao_palavra": "diante dele" },
        { "hebraico": "וְיִשְׁתַּ֖חוּ", "transliteral": "wə-yiš-ta-ḥū", "traducao_palavra": "e se prostra" },
        { "hebraico": "וְיִתְפַּלֵּ֣ל", "transliteral": "wə-yiṯ-pal-lēl", "traducao_palavra": "e roga" },
        { "hebraico": "אֵלָ֑יו", "transliteral": "ʾē-lāy-w", "traducao_palavra": "a ele" },
        { "hebraico": "וַיֹּאמַר֙", "transliteral": "way-yō-mar", "traducao_palavra": "e diz" },
        { "hebraico": "הַצִּילֵ֔נִי", "transliteral": "haṣ-ṣî-lē-nî", "traducao_palavra": "livra-me" },
        { "hebraico": "כִּ֥י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "אֵלִ֖י", "transliteral": "ʾē-lî", "traducao_palavra": "meu deus" },
        { "hebraico": "אָֽתָּה׃", "transliteral": "ʾāt-tāh", "traducao_palavra": "[és] tu." }
      ]
    },
    "18": {
      "traducao_completa": "Não sabem, nem entendem; porque ele lhes fechou os olhos, para que não vejam, e os seus corações, para que não entendam.",
      "palavras": [
        { "hebraico": "לֹ֥א", "transliteral": "lō", "traducao_palavra": "Não" },
        { "hebraico": "יָדְע֖וּ", "transliteral": "yā-ḏə-ʿū", "traducao_palavra": "sabem" },
        { "hebraico": "וְלֹ֣א", "transliteral": "wə-lō", "traducao_palavra": "nem" },
        { "hebraico": "יָבִ֑ינוּ", "transliteral": "yā-ḇî-nū", "traducao_palavra": "entendem" },
        { "hebraico": "כִּ֣י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "טַ֤ח", "transliteral": "ṭaḥ", "traducao_palavra": "ele untou/fechou" },
        { "hebraico": "מֵרְאֹות֙", "transliteral": "mē-rə-ʾō-wṯ", "traducao_palavra": "de ver" },
        { "hebraico": "עֵינֵיהֶ֔ם", "transliteral": "ʿê-nê-hem", "traducao_palavra": "os olhos deles" },
        { "hebraico": "מֵהַשְׂכִּ֖יל", "transliteral": "mē-haś-kîl", "traducao_palavra": "de entender" },
        { "hebraico": "לִבֹּתֵיהֶֽם׃", "transliteral": "lib-bō-ṯê-hem", "traducao_palavra": "seus corações." }
      ]
    },
    "19": {
      "traducao_completa": "E ninguém reflete em seu coração, nem tem conhecimento nem entendimento para dizer: Metade dele queimei no fogo, e também cozi pão sobre as suas brasas, assei carne e a comi; e faria eu do resto uma abominação? Encurvar-me-ia eu ao tronco de uma árvore?",
      "palavras": [
        { "hebraico": "וְלֹא־", "transliteral": "wə-lō-", "traducao_palavra": "E não" },
        { "hebraico": "יָשִׁ֣יב", "transliteral": "yā-šîḇ", "traducao_palavra": "torna/reflete" },
        { "hebraico": "אֶל־", "transliteral": "ʾel-", "traducao_palavra": "em" },
        { "hebraico": "לִבֹּ֗ו", "transliteral": "lib-bō-w", "traducao_palavra": "seu coração" },
        { "hebraico": "וְלֹ֥א", "transliteral": "wə-lō", "traducao_palavra": "nem" },
        { "hebraico": "דַ֛עַת", "transliteral": "ḏa-ʿaṯ", "traducao_palavra": "conhecimento" },
        { "hebraico": "וְלֹא־", "transliteral": "wə-lō-", "traducao_palavra": "nem" },
        { "hebraico": "תְבוּנָ֥ה", "transliteral": "ṯə-ḇū-nā", "traducao_palavra": "entendimento" },
        { "hebraico": "לֵאמֹר֮", "transliteral": "lē-ʾmōr", "traducao_palavra": "para dizer" },
        { "hebraico": "חֶצְיֹו֮", "transliteral": "ḥeṣ-yō-w", "traducao_palavra": "metade dele" },
        { "hebraico": "שָׂרַ֣פְתִּי", "transliteral": "śā-rap̄-tî", "traducao_palavra": "queimei" },
        { "hebraico": "בְמֹו־", "transliteral": "ḇə-mō-", "traducao_palavra": "no" },
        { "hebraico": "אֵשׁ֒", "transliteral": "ʾēš", "traducao_palavra": "fogo" },
        { "hebraico": "וְאַף֩", "transliteral": "wə-ʾap̄", "traducao_palavra": "e também" },
        { "hebraico": "אָפִ֨יתִי", "transliteral": "ʾā-p̄î-ṯî", "traducao_palavra": "cozi" },
