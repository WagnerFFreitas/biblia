        { "hebraico": "וּבְשֵׁ֥ם", "transliteral": "ū-ḇə-šēm", "traducao_palavra": "e pelo nome de" },
        { "hebraico": "יִשְׂרָאֵ֖ל", "transliteral": "yiś-rā-ʾēl", "traducao_palavra": "Israel" },
