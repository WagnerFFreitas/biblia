        { "hebraico": "יִקְרָ֗א", "transliteral": "yiq-rā", "traducao_palavra": "chamará" },
        { "hebraico": "וְיַגִּידֶ֥הָ", "transliteral": "wə-yag-gî-ḏe-hā", "traducao_palavra": "e anunciará ela" },
        { "hebraico": "וְיַעְרְכֶ֖הָ", "transliteral": "wə-ya-ʿrə-ḵe-hā", "traducao_palavra": "e porá em ordem ela" },
        { "hebraico": "לִ֑י", "transliteral": "lî", "traducao_palavra": "para mim" },
