        { "hebraico": "עֹשֶׂ֛ךָ", "transliteral": "ʿō-śe-ḵā", "traducao_palavra": "teu Criador" },
        { "hebraico": "וְיֹצֶרְךָ֥", "transliteral": "wə-yō-ṣer-ḵā", "traducao_palavra": "e teu Formador" },
