        { "hebraico": "וַאֲשֶׁ֥ר", "transliteral": "wa-ʾă-šer", "traducao_palavra": "e as que" },
        { "hebraico": "תָּבֹ֖אנָה", "transliteral": "tā-ḇō-ne-nāh", "traducao_palavra": "hão de vir" },
        { "hebraico": "יַגִּ֥ידוּ", "transliteral": "yag-gî-ḏū", "traducao_palavra": "anunciem" },
        { "hebraico": "לָֽמֹו׃", "transliteral": "lā-mōw", "traducao_palavra": "eles." }
      ]
    },
    "8": {
      "traducao_completa": "Não vos assombreis, nem temais; porventura desde então não vo-lo fiz ouvir, e não vo-lo anunciei? E vós sois as minhas testemunhas. Há outro Deus fora de mim? Não, não há Rocha que eu conheça.",
      "palavras": [
        { "hebraico": "אַל־", "transliteral": "ʾal-", "traducao_palavra": "Não" },
        { "hebraico": "תִּפְחֲד֥וּ", "transliteral": "tip̄-ḥă-ḏū", "traducao_palavra": "vos assombreis" },
        { "hebraico": "וְאַל־", "transliteral": "wə-ʾal-", "traducao_palavra": "e não" },
        { "hebraico": "תִּרְה֑וּ", "transliteral": "tir-hū", "traducao_palavra": "temais" },
        { "hebraico": "הֲלֹ֨א", "transliteral": "hă-lō", "traducao_palavra": "acaso não" },
        { "hebraico": "מֵאָ֤ז", "transliteral": "mē-ʾāz", "traducao_palavra": "desde então" },
        { "hebraico": "הִשְׁמַעְתִּ֙יךָ֙", "transliteral": "hiš-ma-ʿ-tî-ḵā", "traducao_palavra": "fiz ouvir a ti" },
        { "hebraico": "וְהִגַּ֔דְתִּי", "transliteral": "wə-hig-gaḏ-tî", "traducao_palavra": "e anunciei" },
        { "hebraico": "וְאַתֶּ֥ם", "transliteral": "wə-ʾat-tem", "traducao_palavra": "e vós" },
        { "hebraico": "עֵדָ֑י", "transliteral": "ʿē-ḏāy", "traducao_palavra": "minhas testemunhas" },
        { "hebraico": "הֲיֵ֤שׁ", "transliteral": "hă-yēš", "traducao_palavra": "Há" },
        { "hebraico": "אֱלֹ֙והַּ֙", "transliteral": "ʾĕ-lō-w-ah", "traducao_palavra": "Deus" },
        { "hebraico": "מִבַּלְעָדַ֔י", "transliteral": "mib-bal-ʿā-ḏay", "traducao_palavra": "fora de mim?" },
        { "hebraico": "וְאֵ֥ין", "transliteral": "wə-ʾên", "traducao_palavra": "e não há" },
        { "hebraico": "צ֖וּר", "transliteral": "ṣūr", "traducao_palavra": "Rocha" },
        { "hebraico": "בַּל־", "transliteral": "bal-", "traducao_palavra": "não" },
        { "hebraico": "יָדָֽעְתִּי׃", "transliteral": "yā-ḏā-ʿ-tî", "traducao_palavra": "conheço." }
      ]
    },
    "9": {
      "traducao_completa": "Todos os escultores de imagens são vaidade, e as suas coisas mais desejáveis não aproveitam nada; e as suas próprias testemunhas não veem nem entendem, para que eles sejam envergonhados.",
      "palavras": [
        { "hebraico": "יֹֽצְרֵי־", "transliteral": "yō-ṣə-rê-", "traducao_palavra": "Os formadores de" },
        { "hebraico": "פֶ֙סֶל֙", "transliteral": "p̄e-sel", "traducao_palavra": "imagem de escultura" },
        { "hebraico": "כֻּלָּ֣ם", "transliteral": "kul-lām", "traducao_palavra": "todos eles" },
        { "hebraico": "תֹּ֔הוּ", "transliteral": "tō-hū", "traducao_palavra": "vácuo/vaidade" },
        { "hebraico": "וַחֲמוּדֵיהֶ֖ם", "transliteral": "wa-ḥă-mū-ḏê-hem", "traducao_palavra": "e suas coisas desejáveis" },
        { "hebraico": "בַּל־", "transliteral": "bal-", "traducao_palavra": "não" },
        { "hebraico": "יֹועִ֑ילוּ", "transliteral": "yō-w-ʿî-lū", "traducao_palavra": "aproveitam" },
        { "hebraico": "וְעֵדֵיהֶ֣ם", "transliteral": "wə-ʿê-ḏê-hem", "traducao_palavra": "e suas testemunhas" },
