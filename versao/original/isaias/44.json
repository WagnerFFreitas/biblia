        { "hebraico": "בַּל־", "transliteral": "bal-", "traducao_palavra": "não" },
        { "hebraico": "יִרְא֥וּ", "transliteral": "yir-ʾū", "traducao_palavra": "veem" },
        { "hebraico": "וּבַל־", "transliteral": "ū-ḇal-", "traducao_palavra": "e não" },
        { "hebraico": "יֵדְע֖וּ", "transliteral": "yê-ḏə-ʿū", "traducao_palavra": "sabem/entendem" },
        { "hebraico": "לְמַ֥עַן", "transliteral": "lə-ma-ʿan", "traducao_palavra": "para que" },
        { "hebraico": "יֵבֹֽשׁוּ׃", "transliteral": "yē-ḇō-šū", "traducao_palavra": "sejam envergonhados." }
      ]
    },
    "10": {
      "traducao_completa": "Quem formou um deus e fundiu uma imagem de escultura, que para nada aproveita?",
      "palavras": [
        { "hebraico": "מִֽי־", "transliteral": "mî-", "traducao_palavra": "Quem" },
        { "hebraico": "יָצַ֥ר", "transliteral": "yā-ṣar", "traducao_palavra": "formou" },
        { "hebraico": "אֵ֖ל", "transliteral": "ʾēl", "traducao_palavra": "deus" },
        { "hebraico": "וּפֶ֣סֶל", "transliteral": "ū-p̄e-sel", "traducao_palavra": "e imagem esculpida" },
        { "hebraico": "נָסָ֑ךְ", "transliteral": "nā-śāḵ", "traducao_palavra": "fundiu" },
        { "hebraico": "לְבִלְתִּ֖י", "transliteral": "lə-ḇil-tî", "traducao_palavra": "para não" },
