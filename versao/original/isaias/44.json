        { "hebraico": "וַאֲנִ֣י", "transliteral": "wa-ʾă-nî", "traducao_palavra": "e eu [sou]" },
        { "hebraico": "אַחֲרֹ֔ון", "transliteral": "ʾa-ḥă-rō-wn", "traducao_palavra": "[o] último" },
        { "hebraico": "וּמִבַּלְעָדַ֖י", "transliteral": "ū-mib-bal-ʿā-ḏay", "traducao_palavra": "e fora de mim" },
        { "hebraico": "אֵ֥ין", "transliteral": "ʾên", "traducao_palavra": "não há" },
        { "hebraico": "אֱלֹהִֽים׃", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "Deus." }
      ]
    },
    "7": {
      "traducao_completa": "E quem, como eu, chamará, e anunciará isto, e o porá em ordem diante de mim, desde que estabeleci o povo antigo? E as coisas vindouras, e as que hão de vir, anunciem-nas eles.",
      "palavras": [
