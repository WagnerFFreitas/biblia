    "8": {
      "traducao_completa": "Porque todas as mesas estão cheias de vômitos e de imundícia, de modo que não há lugar limpo.",
      "palavras": [
        { "hebraico": "כִּ֚י", "transliteral": "kî", "traducao_palavra": "Porque" },
        { "hebraico": "כָּל־שֻׁלְחָנֹ֔ות", "transliteral": "kāl-šul-ḥā-nôṯ", "traducao_palavra": "todas as mesas" },
