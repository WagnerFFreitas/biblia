        { "hebraico": "וְכַמֹּ֖ן", "transliteral": "wə-ḵam-mōn", "traducao_palavra": "e cominho" },
        { "hebraico": "יִזְרֹ֑ק", "transliteral": "yiz-rōq", "traducao_palavra": "semeia/lança" },
