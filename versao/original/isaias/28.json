        { "hebraico": "אַל־תִּתְלֹֹוצָ֔צוּ", "transliteral": "ʾal-tiṯ-lô-ṣā-ṣû", "traducao_palavra": "não escarneçais" },
        { "hebraico": "פֶּן־יֶחְזְק֖וּ", "transliteral": "pen-yeḥ-zə-qû", "traducao_palavra": "para que não se fortaleçam" },
