        { "hebraico": "כָזָ֔ב", "transliteral": "ḵā-zāḇ", "traducao_palavra": "mentira" },
        { "hebraico": "וְסֵ֥תֶר", "transliteral": "wə-śê-ṯer", "traducao_palavra": "e o esconderijo" },
        { "hebraico": "מַ֖יִם", "transliteral": "ma-yim", "traducao_palavra": "águas" },
        { "hebraico": "יִשְׁטֹֽפוּ׃", "transliteral": "yiš-ṭō-p̄û", "traducao_palavra": "inundarão" }
      ]
    },
    "18": {
      "traducao_completa": "E a vossa aliança com a morte será anulada; e o vosso acordo com o Seol não subsistirá; quando o flagelo inundante passar, sereis por ele pisados.",
      "palavras": [
        { "hebraico": "וְכֻפַּ֤ר", "transliteral": "wə-ḵup-par", "traducao_palavra": "E será anulada/expiada" },
        { "hebraico": "בְּרִֽיתְכֶם֙", "transliteral": "bə-rî-ṯə-ḵem", "traducao_palavra": "vossa aliança" },
        { "hebraico": "אֶת־מָ֔וֶת", "transliteral": "ʾeṯ-mā-weṯ", "traducao_palavra": "com a morte" },
        { "hebraico": "וְחָזוּתְכֶ֥ם", "transliteral": "wə-ḥā-zû-ṯə-ḵem", "traducao_palavra": "e vosso acordo/visão" },
        { "hebraico": "אֶת־שְׁאֹ֖ול", "transliteral": "ʾeṯ-šə-ʾôl", "traducao_palavra": "com o Seol" },
        { "hebraico": "לֹ֣א תָק֑וּם", "transliteral": "lō ṯā-qûm", "traducao_palavra": "não subsistirá" },
        { "hebraico": "שֹׁ֣וט", "transliteral": "šôṭ", "traducao_palavra": "[o] açoite/flagelo" },
