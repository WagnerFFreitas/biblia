    "7": {
      "traducao_completa": "Mas também estes erram por causa do vinho, e com a bebida forte se desencaminham; o sacerdote e o profeta erram por causa da bebida forte, são tragados pelo vinho, desencaminham-se por causa da bebida forte; erram na visão, tropeçam no juízo.",
      "palavras": [
        { "hebraico": "וְגַם־אֵ֨לֶּה֙", "transliteral": "wə-ḡam-ʾēl-leh", "traducao_palavra": "E também estes" },
        { "hebraico": "בַּיַּ֣יִן", "transliteral": "bay-ya-yin", "traducao_palavra": "pelo vinho" },
        { "hebraico": "שָׁג֔וּ", "transliteral": "šā-ḡû", "traducao_palavra": "erraram" },
        { "hebraico": "וּבַשֵּׁכָ֖ר", "transliteral": "ū-ḇaš-šê-ḵār", "traducao_palavra": "e pela bebida forte" },
