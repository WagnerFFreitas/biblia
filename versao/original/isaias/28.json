        { "hebraico": "אִם־שִׁוָּ֣ה", "transliteral": "ʾim-ši-wā", "traducao_palavra": "quando aplainou" },
        { "hebraico": "פָנֶ֔יהָ", "transliteral": "p̄ā-ne-y-hā", "traducao_palavra": "sua face" },
        { "hebraico": "וְהֵפִ֣יץ", "transliteral": "wə-hê-p̄îṣ", "traducao_palavra": "e espalhou" },
