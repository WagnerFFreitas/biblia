        { "hebraico": "אֶת־מִ֖י", "transliteral": "ʾeṯ-mî", "traducao_palavra": "A quem" },
        { "hebraico": "יֹורֶ֣ה", "transliteral": "yô-reh", "traducao_palavra": "ensinaria" },
        { "hebraico": "דֵּ֑עָה", "transliteral": "dê-ʿā", "traducao_palavra": "[o] conhecimento" },
        { "hebraico": "וְאֶת־מִי֙", "transliteral": "wə-ʾeṯ-mî", "traducao_palavra": "e a quem" },
        { "hebraico": "יָבִ֣ין", "transliteral": "yā-ḇîn", "traducao_palavra": "faria entender" },
        { "hebraico": "שְׁמוּעָ֔ה", "transliteral": "šə-mû-ʿā", "traducao_palavra": "[o que foi] ouvido/notícia" },
        { "hebraico": "גְּמוּלֵי֙", "transliteral": "gə-mû-lê", "traducao_palavra": "[aos] desmamados" },
        { "hebraico": "מֵחָלָ֔ב", "transliteral": "mē-ḥā-lāḇ", "traducao_palavra": "do leite" },
        { "hebraico": "עַתִּיקֵ֖י", "transliteral": "ʿat-tî-qê", "traducao_palavra": "retirados de" },
        { "hebraico": "שָׁדָֽיִם׃", "transliteral": "šā-ḏā-yim", "traducao_palavra": "seios" }
      ]
    },
    "10": {
      "traducao_completa": "Porque é preceito sobre preceito, preceito sobre preceito; regra sobre regra, regra sobre regra; um pouco aqui, um pouco ali.",
