        { "hebraico": "כִּ֣י", "transliteral": "kî", "traducao_palavra": "Porque" },
        { "hebraico": "אֲמַרְתֶּ֗ם", "transliteral": "ʾă-mar-tem", "traducao_palavra": "dissestes" },
