        { "hebraico": "כִּֽי־יַעֲבֹ֣ר", "transliteral": "kî-ya-ʿă-ḇōr", "traducao_palavra": "quando passar" },
        { "hebraico": "לֹא־יְבֹואֵ֔נוּ", "transliteral": "lō-yə-ḇô-ʾê-nû", "traducao_palavra": "não chegará a nós" },
