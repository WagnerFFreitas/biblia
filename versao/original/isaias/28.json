        { "hebraico": "כִּ֣י יַֽעֲבֹ֔ר", "transliteral": "kî ya-ʿă-ḇōr", "traducao_palavra": "quando passar" },
        { "hebraico": "וִהְיִיתֶ֥ם", "transliteral": "wih-yî-ṯem", "traducao_palavra": "e sereis" },
        { "hebraico": "לֹ֖ו", "transliteral": "lô", "traducao_palavra": "para ele" },
