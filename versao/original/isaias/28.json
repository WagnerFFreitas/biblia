        { "hebraico": "עֲטֶ֥רֶת", "transliteral": "ʿă-ṭe-reṯ", "traducao_palavra": "[a] coroa de" },
        { "hebraico": "גֵּא֖וּת", "transliteral": "gê-ʾût", "traducao_palavra": "soberba de" },
