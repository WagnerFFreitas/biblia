        { "hebraico": "כִּ֤י", "transliteral": "kî", "traducao_palavra": "Porque" },
        { "hebraico": "כְהַר־פְּרָצִים֙", "transliteral": "ḵə-har-pə-rā-ṣîm", "traducao_palavra": "como no monte Perazim" },
        { "hebraico": "יָק֣וּם", "transliteral": "yā-qûm", "traducao_palavra": "se levantará" },
        { "hebraico": "יְהוָ֔ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "כְּעֵ֥מֶק", "transliteral": "kə-ʿê-meq", "traducao_palavra": "como no vale de" },
