    "19": {
      "traducao_completa": "Desde que comece a passar, vos arrebatará; porque manhã após manhã passará, de dia e de noite; e será somente um terror o entender tal notícia.",
      "palavras": [
        { "hebraico": "מִדֵּ֤י", "transliteral": "mid-dê", "traducao_palavra": "Sempre que" },
        { "hebraico": "עָבְרֹו֙", "transliteral": "ʿā-ḇə-rô", "traducao_palavra": "passar" },
        { "hebraico": "יִקַּ֣ח", "transliteral": "yiq-qaḥ", "traducao_palavra": "levará/arrebatará" },
        { "hebraico": "אֶתְכֶ֔ם", "transliteral": "ʾeṯ-ḵem", "traducao_palavra": "vós" },
        { "hebraico": "כִּֽי־בַבֹּקֶר֩", "transliteral": "kî-ḇab-bō-qer", "traducao_palavra": "porque pela manhã" },
        { "hebraico": "בַּבֹּ֨קֶר֙", "transliteral": "bab-bō-qer", "traducao_palavra": "pela manhã" },
        { "hebraico": "יַעֲבֹ֔ר", "transliteral": "ya-ʿă-ḇōr", "traducao_palavra": "passará" },
        { "hebraico": "בַּיֹּ֖ום", "transliteral": "bay-yôm", "traducao_palavra": "de dia" },
        { "hebraico": "וּבַלָּ֑יְלָה", "transliteral": "ū-ḇal-lay-lā", "traducao_palavra": "e de noite" },
        { "hebraico": "וְהָיָ֥ה", "transliteral": "wə-hā-yā", "traducao_palavra": "e será" },
        { "hebraico": "רַק־זְוָעָ֖ה", "transliteral": "raq-zə-wā-ʿā", "traducao_palavra": "somente pavor" },
        { "hebraico": "הָבִ֥ין", "transliteral": "hā-ḇîn", "traducao_palavra": "[o] entender" },
        { "hebraico": "שְׁמוּעָֽה׃", "transliteral": "šə-mû-ʿā", "traducao_palavra": "[a] mensagem/notícia" }
      ]
    },
    "20": {
      "traducao_completa": "Porque a cama será tão curta que ninguém se poderá estender nela; e o cobertor tão estreito que ninguém se poderá envolver nele.",
