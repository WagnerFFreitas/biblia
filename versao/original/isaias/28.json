        { "hebraico": "חָזָ֤ק", "transliteral": "ḥā-zāq", "traducao_palavra": "[um] forte" },
        { "hebraico": "וְאַמִּיץ֙", "transliteral": "wə-ʾam-mîṣ", "traducao_palavra": "e poderoso" },
        { "hebraico": "לַֽאדֹנָ֔י", "transliteral": "la-ʾă-ḏō-nāy", "traducao_palavra": "[tem] o Senhor" },
