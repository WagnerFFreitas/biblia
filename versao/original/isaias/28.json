        { "hebraico": "מֵֽהִשְׂתָּרֵ֑עַ", "transliteral": "mê-hiś-tā-rê-aʿ", "traducao_palavra": "para estender-se" },
        { "hebraico": "וְהַמַּסֵּכָ֥ה", "transliteral": "wə-ham-maś-śê-ḵā", "traducao_palavra": "e a cobertura/lençol" },
        { "hebraico": "צָ֝רָ֗ה", "transliteral": "ṣā-rā", "traducao_palavra": "[é] estreita" },
        { "hebraico": "כְּהִתְכַּנֵּֽס׃", "transliteral": "kə-hiṯ-kan-nēś", "traducao_palavra": "para envolver-se" }
      ]
    },
    "21": {
      "traducao_completa": "Porque YHWH se levantará como no monte Perazim, e se irará como no vale de Gibeão, para fazer a sua obra, a sua estranha obra, e para executar o seu ato, o seu estranho ato.",
