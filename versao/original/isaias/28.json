        { "hebraico": "קִ֣יא", "transliteral": "qî", "traducao_palavra": "vômito" },
        { "hebraico": "צֹאָ֑ה", "transliteral": "ṣō-ʾā", "traducao_palavra": "[e] imundícia" },
        { "hebraico": "בְּלִ֖י", "transliteral": "bə-lî", "traducao_palavra": "sem" },
        { "hebraico": "מָקֹֽום׃", "transliteral": "mā-qôm", "traducao_palavra": "lugar [limpo]" }
      ]
