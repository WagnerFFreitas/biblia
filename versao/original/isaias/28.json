        { "hebraico": "כִּֽי־כָלָ֨ה", "transliteral": "kî-ḵā-lā", "traducao_palavra": "porque destruição" },
        { "hebraico": "וְנֶחֱרָצָ֗ה", "transliteral": "wə-ne-ḥĕ-rā-ṣā", "traducao_palavra": "e decretada" },
        { "hebraico": "שָׁמַ֨עְתִּי֙", "transliteral": "šā-ma-ʿatî", "traducao_palavra": "ouvi" },
        { "hebraico": "מֵאֵ֨ת אֲדֹנָ֧י", "transliteral": "mê-ʾêṯ ʾă-ḏō-nāy", "traducao_palavra": "da parte do Senhor" },
        { "hebraico": "יְהוִ֛ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "צְבָאֹ֖ות", "transliteral": "ṣə-ḇā-ʾôṯ", "traducao_palavra": "Exércitos" },
        { "hebraico": "עַל־כָּל־הָאָֽרֶץ׃", "transliteral": "ʿal-kāl-hā-ʾā-reṣ", "traducao_palavra": "sobre toda a terra" }
