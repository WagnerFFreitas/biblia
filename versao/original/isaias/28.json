        { "hebraico": "הַאֲזִ֥ינוּ", "transliteral": "ha-ʾă-zî-nû", "traducao_palavra": "Inclinai os ouvidos" },
        { "hebraico": "וְשִׁמְע֖וּ", "transliteral": "wə-šim-ʿû", "traducao_palavra": "e ouvi" },
        { "hebraico": "קֹולִ֑י", "transliteral": "qô-lî", "traducao_palavra": "minha voz" },
        { "hebraico": "הַקְשִׁ֥יבוּ", "transliteral": "haq-šî-ḇû", "traducao_palavra": "atendei" },
