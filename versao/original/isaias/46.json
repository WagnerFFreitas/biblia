    "7": {
      "traducao_completa": "Levantam-no sobre o ombro, carregam-no, e o põem no seu lugar; ali fica em pé, do seu lugar não se move; e, se alguém clama a ele, não responde, nem o livra da sua tribulação.",
      "palavras": [
        { "hebraico": "יִשָּׂאֻ֨הוּ", "transliteral": "yiś-śā-ʾu-hū", "traducao_palavra": "Levantam-no" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre" },
        { "hebraico": "כָּתֵ֜ף", "transliteral": "kā-ṯēp̄", "traducao_palavra": "[o] ombro" },
        { "hebraico": "יִסְבְּלֻ֗הוּ", "transliteral": "yis-bə-lu-hū", "traducao_palavra": "carregam-no" },
        { "hebraico": "וַיַּנִּיחֻ֤הוּ", "transliteral": "way-yan-nî-ḥu-hū", "traducao_palavra": "e o põem" },
        { "hebraico": "תַחְתָּיו֙", "transliteral": "taḥ-tāy-w", "traducao_palavra": "em seu lugar" },
        { "hebraico": "וְיַֽעֲמֹ֔ד", "transliteral": "wə-ya-ʿă-mōḏ", "traducao_palavra": "e fica em pé" },
