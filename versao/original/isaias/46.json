        { "hebraico": "רֹעִ֔י", "transliteral": "rō-ʿî", "traducao_palavra": "[é] meu pastor" },
        { "hebraico": "וְכָל־", "transliteral": "wə-ḵāl-", "traducao_palavra": "e todo" },
        { "hebraico": "חֶפְצִ֖י", "transliteral": "ḥep̄-ṣî", "traducao_palavra": "meu desejo" },
        { "hebraico": "יַשְׁלִ֑ם", "transliteral": "yaš-lim", "traducao_palavra": "cumprirá" },
        { "hebraico": "וְלֵאמֹ֤ur", "transliteral": "wə-lē-ʾmōr", "traducao_palavra": "e dizendo" },
        { "hebraico": "לִירוּשָׁלִַ֙ם֙", "transliteral": "li-y-rū-šā-la-im", "traducao_palavra": "a Jerusalém" },
        { "hebraico": "תִּבָּנֶ֔ה", "transliteral": "tib-bā-neh", "traducao_palavra": "será edificada" },
        { "hebraico": "וְהֵיכָ֖ל", "transliteral": "wə-hê-ḵāl", "traducao_palavra": "e o templo" },
        { "hebraico": "תִּוָּסֵֽד׃", "transliteral": "tiw-wā-śēḏ", "traducao_palavra": "será fundado." }
      ]
    },
    "8": {
      "traducao_completa": "Lembrai-vos disto, e sede homens; trazei-o à mente, ó transgressores.",
      "palavras": [
        { "hebraico": "זִכְרוּ־", "transliteral": "ziḵ-rū-", "traducao_palavra": "Lembrai-vos" },
        { "hebraico": "זֹ֖את", "transliteral": "zōṯ", "traducao_palavra": "disto" },
        { "hebraico": "וְהִתְאֹשָׁ֑שׁוּ", "transliteral": "wə-hiṯ-ʾō-šā-šū", "traducao_palavra": "e sede homens/fundamentai-vos" },
        { "hebraico": "הָשִׁ֥יבוּ", "transliteral": "hā-šî-ḇū", "traducao_palavra": "trazei de volta" },
        { "hebraico": "פֹושְׁעִ֖ים", "transliteral": "p̄ō-w-šə-ʿîm", "traducao_palavra": "ó transgressores" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre" },
        { "hebraico": "לֵֽב׃", "transliteral": "lēḇ", "traducao_palavra": "[o] coração/mente." }
      ]
    },
    "9": {
      "traducao_completa": "Lembrai-vos das coisas passadas desde a antiguidade; que eu sou Deus, e não há outro Deus, não há outro semelhante a mim.",
