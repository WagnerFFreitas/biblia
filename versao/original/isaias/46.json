      "palavras": [
        { "hebraico": "קָרְס֨וּ", "transliteral": "qā-rə-śū", "traducao_palavra": "Abaixaram-se" },
        { "hebraico": "כָרְע֧וּ", "transliteral": "ḵā-rə-ʿū", "traducao_palavra": "encurvaram-se" },
        { "hebraico": "יַחְדָּ֛ו", "transliteral": "yaḥ-dāw", "traducao_palavra": "juntamente" },
        { "hebraico": "לֹ֥א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "יָכְל֖וּ", "transliteral": "yā-ḵə-lū", "traducao_palavra": "puderam" },
        { "hebraico": "מַלֵּ֣ט", "transliteral": "mal-lēṭ", "traducao_palavra": "livrar/escapar" },
