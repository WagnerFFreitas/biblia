        { "hebraico": "זִכְר֥וּ", "transliteral": "ziḵ-rū", "traducao_palavra": "Lembrai-vos de" },
        { "hebraico": "רִאשֹׁנֹ֖ות", "transliteral": "ri-šō-nō-wṯ", "traducao_palavra": "coisas primeiras/passadas" },
        { "hebraico": "מֵעֹולָ֑ם", "transliteral": "mē-ʿō-w-lām", "traducao_palavra": "desde a antiguidade" },
        { "hebraico": "כִּ֣י", "transliteral": "kî", "traducao_palavra": "que" },
        { "hebraico": "אָנֹכִ֥י", "transliteral": "ʾā-nō-ḵî", "traducao_palavra": "eu [sou]" },
        { "hebraico": "אֵל֙", "transliteral": "ʾēl", "traducao_palavra": "Deus" },
        { "hebraico": "וְאֵ֣ין", "transliteral": "wə-ʾên", "traducao_palavra": "e não há" },
        { "hebraico": "עֹ֥וד", "transliteral": "ʿō-wḏ", "traducao_palavra": "outro" },
        { "hebraico": "אֱלֹהִ֔ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "Deus" },
        { "hebraico": "וְאֶ֥פֶס", "transliteral": "wə-ʾe-p̄es", "traducao_palavra": "e nada/não há" },
        { "hebraico": "כָּמֹֽונִי׃", "transliteral": "kā-mō-w-nî", "traducao_palavra": "como eu." }
      ]
    },
    "10": {
      "traducao_completa": "Que anuncio o fim desde o princípio, e desde a antiguidade as coisas que ainda não sucederam; que digo: O meu conselho subsistirá, e farei toda a minha vontade.",
