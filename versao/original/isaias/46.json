        { "hebraico": "מַגִּ֤יד", "transliteral": "mag-gîḏ", "traducao_palavra": "Anunciando" },
        { "hebraico": "מֵֽרֵאשִׁית֙", "transliteral": "mē-rē-šîṯ", "traducao_palavra": "desde o princípio" },
        { "hebraico": "אַחֲרִ֔ית", "transliteral": "ʾa-ḥă-rîṯ", "traducao_palavra": "[o] fim" },
