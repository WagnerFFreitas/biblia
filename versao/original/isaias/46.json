    "28": {
      "traducao_completa": "Que digo de Cores: É meu pastor, e cumprirá todo o meu desejo; dizendo também a Jerusalém: Sê edificada; e ao templo: Sê fundado.",
      "palavras": [
        { "hebraico": "הָאֹמֵ֤ר", "transliteral": "hā-ʾō-mēr", "traducao_palavra": "O que diz" },
