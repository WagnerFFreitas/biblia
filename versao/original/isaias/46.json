        { "hebraico": "וְכֶ֙סֶף֙", "transliteral": "wə-ḵe-sep̄", "traducao_palavra": "e prata" },
        { "hebraico": "בַּקָּנֶ֣ה", "transliteral": "baq-qā-neh", "traducao_palavra": "na cana (balança)" },
