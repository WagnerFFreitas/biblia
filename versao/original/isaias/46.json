    "6": {
      "traducao_completa": "Os que prodigalizam o ouro da bolsa, e pesam a prata na balança, contratam um ourives, e ele faz um deus; e eles se prostram e se encurvam.",
      "palavras": [
        { "hebraico": "הַזָּלִ֨ים", "transliteral": "haz-zā-lîm", "traducao_palavra": "Os que derramam/prodigalizam" },
