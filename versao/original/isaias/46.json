        { "hebraico": "תְדַמְּי֖וּנִי", "transliteral": "ṯə-ḏam-mə-yū-nî", "traducao_palavra": "me assemelhareis" },
        { "hebraico": "וְתַשְׁו֑וּ", "transliteral": "wə-ṯaš-wū", "traducao_palavra": "e [me] igualareis" },
        { "hebraico": "וְתַמְשִׁל֖וּנִי", "transliteral": "wə-ṯam-ši-lū-nî", "traducao_palavra": "e me comparareis" },
        { "hebraico": "וְנִדְמֶֽה׃", "transliteral": "wə-niḏ-meh", "traducao_palavra": "para que sejamos semelhantes?" }
      ]
