        { "hebraico": "אַף־", "transliteral": "ʾap̄-", "traducao_palavra": "também" },
        { "hebraico": "יִצְעַ֤ק", "transliteral": "yiṣ-ʿaq", "traducao_palavra": "se clamar" },
        { "hebraico": "אֵלָיו֙", "transliteral": "ʾē-lāy-w", "traducao_palavra": "a ele" },
        { "hebraico": "וְלֹ֣א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "יַעֲנֶ֔ה", "transliteral": "ya-ʿă-neh", "traducao_palavra": "responderá" },
