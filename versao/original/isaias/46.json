        { "hebraico": "וְיַעֲשֵׂ֣הוּ", "transliteral": "wə-ya-ʿă-śē-hū", "traducao_palavra": "e ele o faz" },
        { "hebraico": "אֵ֑ל", "transliteral": "ʾēl", "traducao_palavra": "[um] deus" },
        { "hebraico": "יִסְגְּד֖וּ", "transliteral": "yis-gə-ḏū", "traducao_palavra": "prostram-se" },
        { "hebraico": "אַף־", "transliteral": "ʾap̄-", "traducao_palavra": "também" },
        { "hebraico": "יִשְׁתַּחֲוּֽוּ׃", "transliteral": "yiš-ta-ḥă-wwū", "traducao_palavra": "encurvam-se." }
