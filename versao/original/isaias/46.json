        { "hebraico": "קֹרֵ֣ס", "transliteral": "qō-rēs", "traducao_palavra": "abaixa-se" },
        { "hebraico": "נְבֹ֔ו", "transliteral": "nə-ḇō-w", "traducao_palavra": "Nebo" },
        { "hebraico": "הָי֧וּ", "transliteral": "hā-yū", "traducao_palavra": "foram/são" },
        { "hebraico": "עֲצַבֵּיהֶ֛ם", "transliteral": "ʿă-ṣab-bê-hem", "traducao_palavra": "os ídolos deles" },
        { "hebraico": "לַחַיָּ֖ה", "transliteral": "la-ḥay-yāh", "traducao_palavra": "para a fera/animal" },
        { "hebraico": "וְלַבְּהֵמָ֑ה", "transliteral": "wə-lab-bə-hē-māh", "traducao_palavra": "e para o gado" },
