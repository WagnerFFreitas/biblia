    "5": {
      "traducao_completa": "Porque, como o jovem se casa com a virgem, assim teus filhos se casarão contigo; e como o noivo se alegra da noiva, assim se alegrará de ti o teu Deus.",
      "palavras": [
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "Porque" },
        { "hebraico": "יִבְעַ֤ל", "transliteral": "yiḇ-ʿal", "traducao_palavra": "[como] se casa" },
        { "hebraico": "בָּחוּר֙", "transliteral": "bā-ḥūr", "traducao_palavra": "[o] jovem" },
        { "hebraico": "בְּתוּלָ֔ה", "transliteral": "bə-ṯū-lāh", "traducao_palavra": "[com a] virgem" },
