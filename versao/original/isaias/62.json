        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "אֶחֱשֶׁ֔ה", "transliteral": "ʾe-ḥĕ-šeh", "traducao_palavra": "me calarei" },
