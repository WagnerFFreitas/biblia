        { "hebraico": "כִּ֧י", "transliteral": "kî", "traducao_palavra": "Porque" },
        { "hebraico": "הַמְאַסְפָ֛יו", "transliteral": "ham-ʾas-p̄āy-w", "traducao_palavra": "os que o ajuntam" },
