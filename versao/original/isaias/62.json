        { "hebraico": "יָשִׂ֥ישׂ", "transliteral": "yā-śîś", "traducao_palavra": "se alegrará" },
        { "hebraico": "עָלַ֖יִךְ", "transliteral": "ʿā-la-yiḵ", "traducao_palavra": "sobre ti" },
        { "hebraico": "אֱלֹהָֽיִךְ׃", "transliteral": "ʾĕ-lō-hā-yiḵ", "traducao_palavra": "teu Deus." }
