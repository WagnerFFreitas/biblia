        { "hebraico": "בָּנָ֑יִךְ", "transliteral": "bā-na-yiḵ", "traducao_palavra": "teus filhos" },
        { "hebraico": "וּמְשֹׂ֤ושׂ", "transliteral": "ū-mə-śō-wś", "traducao_palavra": "e [como o] gozo de" },
        { "hebraico": "חָתָן֙", "transliteral": "ḥā-ṯān", "traducao_palavra": "noivo" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre" },
