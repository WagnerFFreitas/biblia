        { "hebraico": "בִּלְבָבֵ֔ךְ", "transliteral": "bil-ḇā-ḇêḵ", "traducao_palavra": "em teu coração" },
        { "hebraico": "מִ֣י", "transliteral": "mî", "traducao_palavra": "Quem" },
        { "hebraico": "יָֽלַד־", "transliteral": "yā-laḏ-", "traducao_palavra": "gerou" },
