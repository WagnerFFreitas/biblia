        { "hebraico": "אֶת־", "transliteral": "ʾeṯ-", "traducao_palavra": "[partícula acusativa]" },
        { "hebraico": "אֵ֔לֶּה", "transliteral": "ʾēl-leh", "traducao_palavra": "estes?" },
        { "hebraico": "וַאֲנִ֥י", "transliteral": "wa-ʾă-nî", "traducao_palavra": "visto que eu" },
        { "hebraico": "שְׁכוּלָ֖ה", "transliteral": "šə-ḵū-lāh", "traducao_palavra": "[estava] privada de filhos" },
        { "hebraico": "וְגַלְמוּדָ֑ה", "transliteral": "wə-ḡal-mū-ḏāh", "traducao_palavra": "e solitária/estéril" },
