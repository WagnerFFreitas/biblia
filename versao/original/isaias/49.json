      "palavras": [
        { "hebraico": "לֵאמֹ֤ר", "transliteral": "lē-ʾmōr", "traducao_palavra": "Para dizer" },
        { "hebraico": "לַֽאֲסוּרִים֙", "transliteral": "la-ʾă-śū-rîm", "traducao_palavra": "aos presos" },
        { "hebraico": "צֵ֔אוּ", "transliteral": "ṣê-ʾū", "traducao_palavra": "Saí" },
        { "hebraico": "לַאֲשֶׁ֥ר", "transliteral": "la-ʾă-šer", "traducao_palavra": "para aqueles que" },
        { "hebraico": "בַּחֹ֖שֶׁךְ", "transliteral": "ba-ḥō-šeḵ", "traducao_palavra": "em trevas [estão]" },
        { "hebraico": "הִגָּל֑וּ", "transliteral": "hig-gā-lū", "traducao_palavra": "Aparecei/revelai-vos" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre" },
        { "hebraico": "דְּרָכִ֣ים", "transliteral": "də-rā-ḵîm", "traducao_palavra": "caminhos" },
        { "hebraico": "יִרְע֔וּ", "transliteral": "yir-ʿū", "traducao_palavra": "pastarão" },
        { "hebraico": "וּבְכָל־", "transliteral": "ū-ḇə-ḵāl-", "traducao_palavra": "e em todas" },
        { "hebraico": "שְׁפָיִ֖ים", "transliteral": "šə-p̄ā-yîm", "traducao_palavra": "colinas nuas" },
        { "hebraico": "מַרְעִיתָֽם׃", "transliteral": "mar-ʿî-ṯām", "traducao_palavra": "[será] o seu pasto." }
      ]
    },
    "10": {
      "traducao_completa": "Nunca terão fome nem sede, nem o calor nem o sol os afligirá; porque o que se compadece deles os guiará e os conduzirá mansamente aos mananciais das águas.",
      "palavras": [
        { "hebraico": "לֹ֤א", "transliteral": "lō", "traducao_palavra": "Não" },
        { "hebraico": "יִרְעָ֙בוּ֙", "transliteral": "yir-ʿā-ḇū", "traducao_palavra": "terão fome" },
        { "hebraico": "וְלֹ֣א", "transliteral": "wə-lō", "traducao_palavra": "nem" },
        { "hebraico": "יִצְמָ֔אוּ", "transliteral": "yiṣ-mā-ʾū", "traducao_palavra": "terão sede" },
        { "hebraico": "וְלֹא־", "transliteral": "wə-lō-", "traducao_palavra": "nem" },
        { "hebraico": "יַכֵּ֥ם", "transliteral": "yak-kêm", "traducao_palavra": "ferirá/baterá neles" },
        { "hebraico": "שָׁרָ֖ב", "transliteral": "šā-rāḇ", "traducao_palavra": "[o] calor abrasador" },
        { "hebraico": "וָשָׁ֑מֶשׁ", "transliteral": "wā-šā-meš", "traducao_palavra": "e o sol" },
        { "hebraico": "כִּי־", "transliteral": "kî-", "traducao_palavra": "porque" },
        { "hebraico": "מְרַחֲמָ֣ם", "transliteral": "mə-ra-ḥă-mām", "traducao_palavra": "o que tem misericórdia deles" },
        { "hebraico": "יְנַהֲגֵ֔ם", "transliteral": "yə-na-hă-ḡêm", "traducao_palavra": "os guiará" },
        { "hebraico": "וְעַל־", "transliteral": "wə-ʿal-", "traducao_palavra": "e para" },
        { "hebraico": "מַבּ֥וּעֵי", "transliteral": "mab-bū-ʿê", "traducao_palavra": "fontes de" },
        { "hebraico": "מַ֖יִם", "transliteral": "ma-yim", "traducao_palavra": "águas" },
        { "hebraico": "יְנַהֲלֵֽם׃", "transliteral": "yə-na-hă-lêm", "traducao_palavra": "os conduzirá." }
      ]
    },
    "11": {
      "traducao_completa": "E farei de todos os meus montes um caminho; e as minhas estradas serão levantadas.",
      "palavras": [
        { "hebraico": "וְשַׂמְתִּ֥י", "transliteral": "wə-śam-tî", "traducao_palavra": "E farei/porei" },
        { "hebraico": "כָל־", "transliteral": "ḵāl-", "traducao_palavra": "todos" },
        { "hebraico": "הָרַ֖י", "transliteral": "hā-ray", "traducao_palavra": "meus montes" },
        { "hebraico": "לַדָּ֑רֶךְ", "transliteral": "lad-dā-reḵ", "traducao_palavra": "em caminho" },
        { "hebraico": "וּמְסִלֹּתַ֖י", "transliteral": "ū-mə-śil-lō-ṯay", "traducao_palavra": "e minhas estradas" },
        { "hebraico": "יְרֻמֽוּן׃", "transliteral": "yə-ru-mūn", "traducao_palavra": "serão exaltadas/erguidas." }
      ]
    },
    "12": {
      "traducao_completa": "Eis que estes virão de longe, e eis que aqueles do norte, e do ocidente, e aqueles outros da terra de Sinim.",
      "palavras": [
        { "hebraico": "הִנֵּה־", "transliteral": "hin-nēh-", "traducao_palavra": "Eis que" },
        { "hebraico": "אֵ֙לֶּה֙", "transliteral": "ʾēl-leh", "traducao_palavra": "estes" },
        { "hebraico": "מֵרָחֹ֣וק", "transliteral": "mē-rā-ḥō-wq", "traducao_palavra": "de longe" },
        { "hebraico": "יָבֹ֔אוּ", "transliteral": "yā-ḇō-ʾū", "traducao_palavra": "virão" },
        { "hebraico": "וְהִנֵּה־", "transliteral": "wə-hin-nēh-", "traducao_palavra": "e eis que" },
        { "hebraico": "אֵ֥לֶּה", "transliteral": "ʾēl-leh", "traducao_palavra": "estes" },
        { "hebraico": "מִצָּפֹ֖ון", "transliteral": "miṣ-ṣā-p̄ō-wn", "traducao_palavra": "do norte" },
        { "hebraico": "וּמִיָּ֑ם", "transliteral": "ū-miy-yām", "traducao_palavra": "e do mar/ocidente" },
        { "hebraico": "וְאֵ֖לֶּה", "transliteral": "wə-ʾēl-leh", "traducao_palavra": "e aqueles" },
        { "hebraico": "מֵאֶ֥רֶץ", "transliteral": "mê-ʾe-reṣ", "traducao_palavra": "da terra de" },
        { "hebraico": "סִינִֽים׃", "transliteral": "śî-nîm", "traducao_palavra": "Sinim." }
      ]
    },
    "13": {
      "traducao_completa": "Cantai, ó céus, e exulta, ó terra, e vós, montes, estalai de júbilo; porque YHWH consolou o seu povo, e dos seus aflitos se compadecerá.",
      "palavras": [
        { "hebraico": "רָנּ֤וּ", "transliteral": "rān-nū", "traducao_palavra": "Cantai" },
        { "hebraico": "שָׁמַ֙יִם֙", "transliteral": "šā-ma-yim", "traducao_palavra": "céus" },
        { "hebraico": "וְגִ֣ילִי", "transliteral": "wə-ḡî-lî", "traducao_palavra": "e exulta" },
        { "hebraico": "אָ֔רֶץ", "transliteral": "ʾā-reṣ", "traducao_palavra": "terra" },
        { "hebraico": "יפצחו", "transliteral": "ū-p̄iṣ-ḥū", "traducao_palavra": "e rompam" },
        { "hebraico": "הָרִ֖ים", "transliteral": "hā-rîm", "traducao_palavra": "montes" },
        { "hebraico": "רִנָּ֑ה", "transliteral": "rin-nā", "traducao_palavra": "[em] júbilo" },
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "porque" },
        { "hebraico": "נִחַ֤ם", "transliteral": "ni-ḥam", "traducao_palavra": "consolou" },
        { "hebraico": "יְהוָה֙", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "עַמֹּ֔ו", "transliteral": "ʿam-mō-w", "traducao_palavra": "seu povo" },
        { "hebraico": "וַעֲנִיָּ֖ו", "transliteral": "wa-ʿă-niy-yāw", "traducao_palavra": "e dos seus aflitos" },
        { "hebraico": "יְרַחֵֽם׃", "transliteral": "yə-ra-ḥēm", "traducao_palavra": "se compadecerá." }
      ]
    },
    "14": {
      "traducao_completa": "Mas Sião disse: YHWH me desamparou, e o Senhor se esqueceu de mim.",
      "palavras": [
        { "hebraico": "וַתֹּ֥אמֶר", "transliteral": "wat-tō-mer", "traducao_palavra": "Mas disse" },
        { "hebraico": "צִיֹּ֖ון", "transliteral": "ṣiy-yō-wn", "traducao_palavra": "Sião" },
        { "hebraico": "עֲזָבַ֣נִי", "transliteral": "ʿă-zā-ḇa-nî", "traducao_palavra": "desamparou-me" },
        { "hebraico": "יְהוָ֑ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "וַאדֹנָ֖י", "transliteral": "wa-ḏō-nāy", "traducao_palavra": "e o Senhor" },
        { "hebraico": "שְׁכֵחָֽנִי׃", "transliteral": "šə-ḵê-ḥā-nî", "traducao_palavra": "esqueceu-me." }
      ]
    },
    "15": {
      "traducao_completa": "Acaso pode uma mulher esquecer-se de seu filho que mama, de modo que não se compadeça do filho do seu ventre? Mas ainda que estas se esquecessem, eu, todavia, não me esquecerei de ti.",
      "palavras": [
        { "hebraico": "הֲתִשְׁכַּ֤ח", "transliteral": "hă-ṯiš-kaḥ", "traducao_palavra": "Acaso esquecerá" },
        { "hebraico": "אִשָּׁה֙", "transliteral": "ʾiš-šāh", "traducao_palavra": "uma mulher" },
        { "hebraico": "עוּלָ֔הּ", "transliteral": "ʿū-lāh", "traducao_palavra": "seu lactante/filho que mama" },
        { "hebraico": "מֵרַחֵ֖ם", "transliteral": "mē-ra-ḥēm", "traducao_palavra": "de ter compaixão de" },
        { "hebraico": "בֶּן־", "transliteral": "ben-", "traducao_palavra": "o filho de" },
        { "hebraico": "בִּטְנָ֑הּ", "transliteral": "biṭ-nāh", "traducao_palavra": "seu ventre" },
        { "hebraico": "גַּם־", "transliteral": "gam-", "traducao_palavra": "também/até" },
        { "hebraico": "אֵ֣לֶּה", "transliteral": "ʾēl-leh", "traducao_palavra": "estas" },
        { "hebraico": "תִשְׁכַּ֔חְנָה", "transliteral": "ṯiš-kaḥ-nāh", "traducao_palavra": "se esquecessem" },
        { "hebraico": "וְאָנֹכִ֖י", "transliteral": "wə-ʾā-nō-ḵî", "traducao_palavra": "mas eu" },
        { "hebraico": "לֹ֥א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "אֶשְׁכָּחֵֽךְ׃", "transliteral": "ʾeš-kā-ḥēḵ", "traducao_palavra": "esquecerei de ti." }
      ]
    },
    "16": {
      "traducao_completa": "Eis que nas palmas das minhas mãos te gravei; os teus muros estão continuamente diante de mim.",
      "palavras": [
        { "hebraico": "הֵ֥ן", "transliteral": "hên", "traducao_palavra": "Eis que" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre" },
        { "hebraico": "כַּפַּ֖יִם", "transliteral": "kap-pa-yim", "traducao_palavra": "[as] palmas" },
        { "hebraico": "חֲקֹתִ֑יךְ", "transliteral": "ḥă-qō-ṯîḵ", "traducao_palavra": "gravei-te" },
        { "hebraico": "חֹומֹתַ֥יִךְ", "transliteral": "ḥō-w-mō-ṯa-yiḵ", "traducao_palavra": "teus muros" },
        { "hebraico": "נֶגְדִּ֖י", "transliteral": "neḡ-dî", "traducao_palavra": "perante mim" },
        { "hebraico": "תָּמִֽיד׃", "transliteral": "tā-mîḏ", "traducao_palavra": "continuamente." }
      ]
    },
    "17": {
      "traducao_completa": "Os teus filhos apressuradamente virão; mas os teus destruidores e os teus assoladores sairão de ti.",
      "palavras": [
        { "hebraico": "מִהֲר֖וּ", "transliteral": "mi-hă-rū", "traducao_palavra": "Apressaram-se" },
        { "hebraico": "בָּנָ֑יִךְ", "transliteral": "bā-nā-yiḵ", "traducao_palavra": "teus filhos" },
        { "hebraico": "מְהָרְסַ֥יִךְ", "transliteral": "mə-hā-rə-sa-yiḵ", "traducao_palavra": "teus destruidores" },
        { "hebraico": "וּמַחֲרִבַ֖יִךְ", "transliteral": "ū-ma-ḥă-ri-ḇa-yiḵ", "traducao_palavra": "e teus assoladores" },
        { "hebraico": "מִמֵּ֥ךְ", "transliteral": "mim-mêḵ", "traducao_palavra": "de ti" },
        { "hebraico": "יֵצֵֽאוּ׃", "transliteral": "yê-ṣê-ʾū", "traducao_palavra": "sairão." }
      ]
    },
    "18": {
      "traducao_completa": "Levanta os teus olhos ao redor, e olha; todos estes se ajuntam, e vêm a ti; vivo eu, diz YHWH, que de todos estes te vestirás como de um ornamento, e te cingirás deles como uma noiva.",
      "palavras": [
        { "hebraico": "שְׂאִֽי־", "transliteral": "śə-ʾî-", "traducao_palavra": "Levanta" },
        { "hebraico": "סָבִ֤יב", "transliteral": "śā-ḇîḇ", "traducao_palavra": "ao redor" },
        { "hebraico": "עֵינַ֙יִךְ֙", "transliteral": "ʿê-na-yiḵ", "traducao_palavra": "teus olhos" },
        { "hebraico": "וּרְאִ֔י", "transliteral": "ū-rə-ʾî", "traducao_palavra": "e olha" },
        { "hebraico": "כֻּלָּ֖ם", "transliteral": "kul-lām", "traducao_palavra": "todos eles" },
        { "hebraico": "נִקְבְּצ֥וּ", "transliteral": "niq-bə-ṣū", "traducao_palavra": "ajuntaram-se" },
        { "hebraico": "בָֽאוּ־", "transliteral": "ḇā-ʾū-", "traducao_palavra": "vieram" },
        { "hebraico": "לָ֑ךְ", "transliteral": "lāḵ", "traducao_palavra": "a ti" },
        { "hebraico": "חַי־", "transliteral": "ḥay-", "traducao_palavra": "[Como] vivo" },
        { "hebraico": "אָ֣נִי", "transliteral": "ʾā-nî", "traducao_palavra": "[sou] eu" },
        { "hebraico": "נְאֻם־", "transliteral": "nə-ʾum-", "traducao_palavra": "diz/oráculo de" },
        { "hebraico": "יְהוָ֗ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "כִּ֤י", "transliteral": "kî", "traducao_palavra": "que" },
        { "hebraico": "כֻלָּם֙", "transliteral": "kul-lām", "traducao_palavra": "todos eles" },
        { "hebraico": "כָּעֲדִ֣י", "transliteral": "kā-ʿă-ḏî", "traducao_palavra": "como ornamento" },
        { "hebraico": "תִּלְבָּ֔שִׁי", "transliteral": "til-bā-šî", "traducao_palavra": "vestirás" },
        { "hebraico": "וּֽתְקַשְּׁרִ֖ים", "transliteral": "ū-ṯə-qaš-šə-rîm", "traducao_palavra": "e os atarás" },
        { "hebraico": "כַּכַּלָּֽה׃", "transliteral": "kak-kal-lāh", "traducao_palavra": "como a noiva." }
      ]
    },
    "19": {
      "traducao_completa": "Porque nos teus lugares desertos e assolados, e na tua terra destruída, agora certamente serás estreita demais para os moradores, e os que te devoravam se afastarão para longe.",
      "palavras": [
        { "hebraico": "כִּ֤י", "transliteral": "kî", "traducao_palavra": "Porque" },
        { "hebraico": "חָרְבֹתַ֙יִךְ֙", "transliteral": "ḥār-bō-ṯa-yiḵ", "traducao_palavra": "teus lugares assolados" },
        { "hebraico": "וְשֹׁמְמֹתַ֔יִךְ", "transliteral": "wə-šō-mə-mō-ṯa-yiḵ", "traducao_palavra": "e teus desertos" },
        { "hebraico": "וְאֶ֖רֶץ", "transliteral": "wə-ʾe-reṣ", "traducao_palavra": "e a terra de" },
        { "hebraico": "הֲרִֽסֻתֵ֑ךְ", "transliteral": "hă-ri-śu-ṯēḵ", "traducao_palavra": "tua destruição" },
        { "hebraico": "כִּ֤י", "transliteral": "kî", "traducao_palavra": "pois" },
        { "hebraico": "עַתָּה֙", "transliteral": "ʿat-tāh", "traducao_palavra": "agora" },
        { "hebraico": "תֵּצְרִ֣י", "transliteral": "tê-ṣə-rî", "traducao_palavra": "serás estreita" },
        { "hebraico": "מִיֹּושֵׁ֔ב", "transliteral": "miy-yō-w-šēḇ", "traducao_palavra": "por causa do morador" },
        { "hebraico": "וְרָחֲק֖וּ", "transliteral": "wə-rā-ḥă-qū", "traducao_palavra": "e se afastarão" },
        { "hebraico": "מְבַלְּעָֽיִךְ׃", "transliteral": "mə-ḇal-lə-ʿā-yiḵ", "traducao_palavra": "teus devoradores." }
      ]
    },
    "20": {
      "traducao_completa": "Até os filhos da tua orfandade dirão aos teus ouvidos: Muito estreito é para mim este lugar; dá-me espaço para que eu possa habitar.",
      "palavras": [
        { "hebraico": "עֹ֥וד", "transliteral": "ʿō-wḏ", "traducao_palavra": "Ainda" },
        { "hebraico": "יֹאמְר֛וּ", "transliteral": "yō-mə-rū", "traducao_palavra": "dirão" },
        { "hebraico": "בְאָזְנַ֖יִךְ", "transliteral": "ḇə-ʾā-zə-na-yiḵ", "traducao_palavra": "em teus ouvidos" },
        { "hebraico": "בְּנֵ֣י", "transliteral": "bə-nê", "traducao_palavra": "[os] filhos de" },
        { "hebraico": "שִׁכֻּלָ֑יִךְ", "transliteral": "šik-ku-la-yiḵ", "traducao_palavra": "tua orfandade/perda" },
        { "hebraico": "צַר־", "transliteral": "ṣar-", "traducao_palavra": "estreito [é]" },
        { "hebraico": "לִ֥י", "transliteral": "lî", "traducao_palavra": "para mim" },
        { "hebraico": "הַמָּקֹ֖ום", "transliteral": "ham-mā-qō-wm", "traducao_palavra": "o lugar" },
        { "hebraico": "גְּשָׁה־", "transliteral": "gə-šāh-", "traducao_palavra": "dá-me/aproxima-te" },
        { "hebraico": "לִּ֥י", "transliteral": "lî", "traducao_palavra": "[lugar] para mim" },
        { "hebraico": "וְאֵשֵֽׁבָה׃", "transliteral": "wə-ʾê-šê-ḇāh", "traducao_palavra": "e habitarei." }
      ]
    },
    "21": {
      "traducao_completa": "E dirás no teu coração: Quem me gerou estes? Pois eu estava órfã de filhos e solitária, exilada e errante; quem, pois, me criou estes? Eis que eu fui deixada só; estes, onde estavam?",
      "palavras": [
