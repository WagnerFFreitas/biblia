        { "hebraico": "כְּחֶ֣רֶב", "transliteral": "kə-ḥe-reḇ", "traducao_palavra": "como espada" },
        { "hebraico": "חַדָּ֔ה", "transliteral": "ḥad-dāh", "traducao_palavra": "aguda" },
        { "hebraico": "בְּצֵ֥ל", "transliteral": "bə-ṣēl", "traducao_palavra": "na sombra de" },
