        { "hebraico": "וּמְלָכִ֖ים", "transliteral": "ū-mə-lā-ḵîm", "traducao_palavra": "e reis" },
        { "hebraico": "לְנֹ֥גַהּ", "transliteral": "lə-nō-ḡah", "traducao_palavra": "ao resplendor de" },
        { "hebraico": "זַרְחֵֽךְ׃", "transliteral": "zar-ḥēḵ", "traducao_palavra": "teu nascimento/alvorada." }
