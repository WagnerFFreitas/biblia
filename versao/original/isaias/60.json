        { "hebraico": "וּבִרְצֹונִ֖י", "transliteral": "ū-ḇir-ṣō-w-nî", "traducao_palavra": "mas no meu favor" },
        { "hebraico": "רִחַמְתִּֽיךְ׃", "transliteral": "ri-ḥam-tîḵ", "traducao_palavra": "tive misericórdia de ti." }
      ]
    },
    "11": {
      "traducao_completa": "E as tuas portas estarão abertas de contínuo; não se fecharão de dia nem de noite; para que tragam a ti as riquezas das nações, e conduzidos com elas os seus reis.",
