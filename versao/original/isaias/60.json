        { "hebraico": "נֵכָר֙", "transliteral": "nê-ḵār", "traducao_palavra": "estrangeiro" },
        { "hebraico": "חֹמֹתַ֔יִךְ", "transliteral": "ḥō-mō-ṯa-yiḵ", "traducao_palavra": "teus muros" },
        { "hebraico": "וּמַלְכֵיהֶ֖ם", "transliteral": "ū-mal-ḵê-hem", "traducao_palavra": "e os reis deles" },
        { "hebraico": "יְשָׁרְתֽוּנֶךְ", "transliteral": "yə-šā-rə-ṯū-ne-ḵā", "traducao_palavra": "servirão a ti" },
