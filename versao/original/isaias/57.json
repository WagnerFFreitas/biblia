        { "hebraico": "אֶשְׁכֹּ֔ון", "transliteral": "ʾeš-kō-wn", "traducao_palavra": "habito" },
        { "hebraico": "וְאֶת־", "transliteral": "wə-ʾeṯ-", "traducao_palavra": "e com" },
        { "hebraico": "דַּכָּ֖א", "transliteral": "dak-kā", "traducao_palavra": "contrito" },
        { "hebraico": "וּשְׁפַל־", "transliteral": "ū-šə-p̄al-", "traducao_palavra": "e abatido de" },
        { "hebraico": "ר֑וּחַ", "transliteral": "rū-aḥ", "traducao_palavra": "espírito" },
