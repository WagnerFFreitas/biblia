        { "hebraico": "גֹורָלֵ֑ךְ", "transliteral": "ḡō-w-rā-lêḵ", "traducao_palavra": "tua sorte" },
        { "hebraico": "גַּם־", "transliteral": "gam-", "traducao_palavra": "também" },
