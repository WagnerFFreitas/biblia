        { "hebraico": "יִשָּׂא־", "transliteral": "yiś-śā-", "traducao_palavra": "levará" },
        { "hebraico": "ר֖וּחַ", "transliteral": "rū-aḥ", "traducao_palavra": "[o] vento" },
        { "hebraico": "יִקַּח־", "transliteral": "yiq-qaḥ-", "traducao_palavra": "tomará" },
        { "hebraico": "הָ֑בֶל", "transliteral": "hā-base-l", "traducao_palavra": "[um] sopro/vaidade" },
        { "hebraico": "וְהַחֹוסֶ֥ה", "transliteral": "wə-ha-ḥō-w-śeh", "traducao_palavra": "mas o que confia" },
        { "hebraico": "בִ֖י", "transliteral": "ḇî", "traducao_palavra": "em mim" },
        { "hebraico": "יִנְחַל־", "transliteral": "yin-ḥal-", "traducao_palavra": "herdará" },
        { "hebraico": "אֶ֕רֶץ", "transliteral": "ʾe-reṣ", "traducao_palavra": "terra" },
        { "hebraico": "וְיִירַ֥שׁ", "transliteral": "wə-yî-raš", "traducao_palavra": "e possuirá" },
        { "hebraico": "הַר־", "transliteral": "har-", "traducao_palavra": "monte de" },
