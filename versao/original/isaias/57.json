        { "hebraico": "גָּבֹ֤הַּ", "transliteral": "gā-ḇō-ah", "traducao_palavra": "alto" },
        { "hebraico": "וְנִשָּׂא֙", "transliteral": "wə-niś-śā", "traducao_palavra": "e elevado" },
        { "hebraico": "שַׂ֣מְתְּ", "transliteral": "śamtə", "traducao_palavra": "puseste" },
