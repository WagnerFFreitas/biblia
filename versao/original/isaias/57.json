    "10": {
      "traducao_completa": "Na multidão dos teus caminhos te cansaste; mas não disseste: Não há esperança; achaste vida na tua mão, por isso não adoeceste.",
      "palavras": [
        { "hebraico": "בְּרֹ֥ב", "transliteral": "bə-rōḇ", "traducao_palavra": "Na multidão de" },
        { "hebraico": "דַּרְכֵּ֖ךְ", "transliteral": "dar-kêḵ", "traducao_palavra": "teu caminho" },
