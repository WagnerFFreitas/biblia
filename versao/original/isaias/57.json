    "9": {
      "traducao_completa": "E foste ao rei com óleo, e multiplicaste os teus perfumes, e enviaste os teus embaixadores para longe, e te abateste até ao inferno.",
      "palavras": [
        { "hebraico": "וַתָּשֻׁ֤רִי", "transliteral": "wat-tā-šu-rî", "traducao_palavra": "E foste/viajaste" },
