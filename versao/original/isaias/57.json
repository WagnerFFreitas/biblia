        { "hebraico": "סֹ֛לּוּ", "transliteral": "sōl-lū", "traducao_palavra": "aplanai" },
        { "hebraico": "פַּנּוּ־", "transliteral": "pan-nū-", "traducao_palavra": "preparai" },
