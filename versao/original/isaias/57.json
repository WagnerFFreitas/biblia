        { "hebraico": "עַד־", "transliteral": "ʿaḏ-", "traducao_palavra": "até" },
        { "hebraico": "שְׁאֹֽול׃", "transliteral": "šə-ʾō-wl", "traducao_palavra": "[ao] Sheol/inferno." }
