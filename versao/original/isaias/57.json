        { "hebraico": "שָׁלֹ֜ום", "transliteral": "šā-lō-wm", "traducao_palavra": "paz" },
        { "hebraico": "לָרָחֹ֧וק", "transliteral": "lā-rā-ḥō-wq", "traducao_palavra": "para o longe" },
        { "hebraico": "וְלַקָּרֹ֛וב", "transliteral": "wə-laq-qā-rō-wḇ", "traducao_palavra": "e para o perto" },
