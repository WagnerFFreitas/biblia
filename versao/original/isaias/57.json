    "13": {
      "traducao_completa": "Quando clamares, livrem-te as tuas multidões; mas o vento a todas levará, e a vaidade as arrebatará; mas o que confia em mim herdará a terra e possuirá o meu santo monte.",
      "palavras": [
        { "hebraico": "בְּזַעֲקֵךְ֙", "transliteral": "bə-za-ʿă-qêḵ", "traducao_palavra": "No teu clamar" },
