        { "hebraico": "קָצַ֥ףְתִּי", "transliteral": "qā-ṣap̄-tî", "traducao_palavra": "irei-me" },
        { "hebraico": "וְאַכֵּ֖הוּ", "transliteral": "wə-ʾak-kê-hū", "traducao_palavra": "e feri ele" },
