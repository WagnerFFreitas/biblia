      ]
    },
    "16": {
      "traducao_completa": "Porque não contenderei para sempre, nem me irarei continuamente; porque o espírito perante a minha face desfaleceria, e as almas que eu fiz.",
      "palavras": [
        { "hebraico": "כִּ֣י", "transliteral": "kî", "traducao_palavra": "Porque" },
        { "hebraico": "לֹ֤א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "לְעֹולָם֙", "transliteral": "lə-ʿō-w-lām", "traducao_palavra": "para sempre" },
        { "hebraico": "אָרִ֔יב", "transliteral": "ʾā-rîḇ", "traducao_palavra": "contenderei" },
        { "hebraico": "וְלֹ֥א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
