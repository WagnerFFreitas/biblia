        { "hebraico": "בַּשֶּׁ֔מֶן", "transliteral": "baš-še-men", "traducao_palavra": "com óleo" },
        { "hebraico": "וַתַּרְבִּ֖י", "transliteral": "wat-tar-bî", "traducao_palavra": "e multiplicaste" },
        { "hebraico": "רִקֻּחָ֑יִךְ", "transliteral": "riq-qu-ḥā-yiḵ", "traducao_palavra": "teus perfumes" },
