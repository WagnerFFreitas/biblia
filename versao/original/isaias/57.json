        { "hebraico": "בֹּורֵ֖א", "transliteral": "bō-w-rē", "traducao_palavra": "Criando" },
        { "hebraico": "נוב", "transliteral": "nîḇ", "traducao_palavra": "[o] fruto de [Qere: nyb]" },
        { "hebraico": "שְׂפָתָ֑יִם", "transliteral": "śə-p̄ā-ṯā-yim", "traducao_palavra": "lábios" },
