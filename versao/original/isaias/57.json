        { "hebraico": "לִבֹּֽו׃", "transliteral": "lib-bō-w", "traducao_palavra": "seu coração." }
      ]
    },
    "18": {
      "traducao_completa": "Eu vi os seus caminhos, e o sararei; e o guiarei, e lhe tornarei a dar consolações, a ele e aos seus pranteadores.",
      "palavras": [
        { "hebraico": "דְּרָכָ֥יו", "transliteral": "də-rā-ḵāy-w", "traducao_palavra": "Caminhos dele" },
        { "hebraico": "רָאִ֖יתִי", "transliteral": "rā-ʾî-ṯî", "traducao_palavra": "eu vi" },
        { "hebraico": "וְאֶרְפָּאֵ֑הוּ", "transliteral": "wə-ʾer-pā-ʾê-hū", "traducao_palavra": "e o sararei" },
        { "hebraico": "וְאַנְחֵ֕הוּ", "transliteral": "wə-ʾan-ḥê-hū", "traducao_palavra": "e o guiarei" },
