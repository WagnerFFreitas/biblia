        { "hebraico": "נִחֻמִ֛ים", "transliteral": "ni-ḥu-mîm", "traducao_palavra": "consolações" },
        { "hebraico": "לֹ֖ו", "transliteral": "lō-w", "traducao_palavra": "para ele" },
        { "hebraico": "וְלַאֲבֵלָֽיו׃", "transliteral": "wə-la-ʾă-ḇê-lāy-w", "traducao_palavra": "e para seus pranteadores." }
