        { "hebraico": "וּנְשָׁמֹ֖ות", "transliteral": "ū-nə-šā-mō-wṯ", "traducao_palavra": "e as almas/fôlegos" },
        { "hebraico": "אֲנִ֥י", "transliteral": "ʾă-nî", "traducao_palavra": "eu" },
