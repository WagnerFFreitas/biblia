        { "hebraico": "נִגְרָ֑שׁ", "transliteral": "niḡ-rāš", "traducao_palavra": "agitado" },
        { "hebraico": "כִּ֧י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "הַשְׁקֵ֣ט", "transliteral": "haš-qēṭ", "traducao_palavra": "sossegar" },
