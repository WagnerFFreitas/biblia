        { "hebraico": "יְהוָ֖ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "וּרְפָאתִֽיו׃", "transliteral": "ū-rə-p̄ā-ṯî-w", "traducao_palavra": "e sararei ele." }
      ]
    },
    "20": {
      "traducao_completa": "Mas os ímpios são como o mar agitado, que não se pode sossegar, e cujas águas lançam de si lama e lodo.",
