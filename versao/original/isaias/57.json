        { "hebraico": "שְׁפָלִ֔ים", "transliteral": "šə-p̄ā-lîm", "traducao_palavra": "abatidos" },
        { "hebraico": "וּֽלְהַחֲיֹ֖ות", "transliteral": "ū-lə-ha-ḥă-yō-wṯ", "traducao_palavra": "e para vivificar" },
        { "hebraico": "לֵ֥ב", "transliteral": "lēḇ", "traducao_palavra": "coração de" },
