      ]
    },
    "12": {
      "traducao_completa": "Na cidade só resta a desolação, e a porta está reduzida a ruínas.",
      "palavras": [
        { "hebraico": "נִשְׁאַ֥ר", "transliteral": "niš-ʾar", "traducao_palavra": "Restou" },
        { "hebraico": "בָּעִ֖יר", "transliteral": "bā-ʿîr", "traducao_palavra": "na cidade" },
        { "hebraico": "שַׁמָּ֑ה", "transliteral": "šam-mā", "traducao_palavra": "desolação" },
