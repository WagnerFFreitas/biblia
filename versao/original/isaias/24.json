        { "hebraico": "הָאָ֔רֶץ", "transliteral": "hā-ʾā-reṣ", "traducao_palavra": "a terra" },
        { "hebraico": "אֻמְלְלָ֥ה", "transliteral": "ʾum-lə-lā", "traducao_palavra": "enfraqueceu" },
