        { "hebraico": "יֹ֣שְׁבֵי", "transliteral": "yō-šə-ḇê", "traducao_palavra": "moradores de" },
        { "hebraico": "בָ֑הּ", "transliteral": "bāh", "traducao_palavra": "nela" },
