      ]
    },
    "10": {
      "traducao_completa": "Demolida está a cidade da confusão; todas as casas se fecharam, para ninguém nelas entrar.",
      "palavras": [
        { "hebraico": "נִשְׁבְּרָ֖ה", "transliteral": "niš-bə-rā", "traducao_palavra": "Foi quebrada/demolida" },
        { "hebraico": "קִרְיַת־", "transliteral": "qir-yaṯ-", "traducao_palavra": "cidade de" },
