        { "hebraico": "בֹּוקֵ֣ק", "transliteral": "bô-qēq", "traducao_palavra": "esvazia" },
        { "hebraico": "הָאָ֔רֶץ", "transliteral": "hā-ʾā-reṣ", "traducao_palavra": "a terra" },
        { "hebraico": "וּבֹולְקָ֑הּ", "transliteral": "ū-ḇô-lə-qāh", "traducao_palavra": "e a desola/devasta" },
