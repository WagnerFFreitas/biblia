    "11": {
      "traducao_completa": "Há clamor por vinho nas ruas; toda a alegria se escureceu, desterrou-se o gozo da terra.",
      "palavras": [
        { "hebraico": "צְוָחָ֥ה", "transliteral": "ṣə-wā-ḥā", "traducao_palavra": "Grito/clamor" },
        { "hebraico": "עַל־הַיַּ֖יִן", "transliteral": "ʿal-hay-ya-yin", "traducao_palavra": "pelo vinho" },
        { "hebraico": "בַּחוּצֹ֑ות", "transliteral": "ba-ḥû-ṣôṯ", "traducao_palavra": "nas ruas" },
        { "hebraico": "עָֽרְבָה֙", "transliteral": "ʿā-rə-ḇā", "traducao_palavra": "escureceu-se/entardeceu" },
        { "hebraico": "כָּל־שִׂמְחָ֔ה", "transliteral": "kāl-śim-ḥā", "traducao_palavra": "toda alegria" },
        { "hebraico": "גָּלָ֖ה", "transliteral": "gā-lā", "traducao_palavra": "exilou-se/foi-se" },
        { "hebraico": "מְשֹׂ֥ושׂ", "transliteral": "mə-śôś", "traducao_palavra": "[o] gozo de" },
