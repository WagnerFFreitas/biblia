        { "hebraico": "כָעָם֙", "transliteral": "ḵā-ʿām", "traducao_palavra": "como o povo" },
        { "hebraico": "כַּכֹּהֵ֔ן", "transliteral": "kak-kō-hên", "traducao_palavra": "assim o sacerdote" },
