        { "hebraico": "חָנְפָ֖ה", "transliteral": "ḥā-nə-p̄ā", "traducao_palavra": "foi profanada/contaminada" },
        { "hebraico": "תַּ֣חַת", "transliteral": "ta-ḥaṯ", "traducao_palavra": "sob" },
        { "hebraico": "יֹשְׁבֶ֑יהָ", "transliteral": "yō-šə-ḇe-y-hā", "traducao_palavra": "seus moradores" },
        { "hebraico": "כִּֽי־עָבְר֤וּ", "transliteral": "kî-ʿā-ḇə-rû", "traducao_palavra": "porque transgrediram" },
        { "hebraico": "תֹורֹת֙", "transliteral": "ṯô-rōṯ", "traducao_palavra": "[as] leis" },
