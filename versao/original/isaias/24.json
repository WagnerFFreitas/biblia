        { "hebraico": "יֹשְׁבֶֽיהָ׃", "transliteral": "yō-šə-ḇe-y-hā", "traducao_palavra": "os seus moradores" }
      ]
    },
    "2": {
      "traducao_completa": "E o que suceder ao povo, sucederá ao sacerdote; ao servo, como ao seu senhor; à serva, como à sua senhora; ao comprador, como ao vendedor; ao que empresta, como ao que toma emprestado; ao que dá usura, como ao que paga usura.",
