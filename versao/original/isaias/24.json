      ]
    },
    "6": {
      "traducao_completa": "Por isso a maldição consome a terra; e os que habitam nela serão achados culpados; por isso serão queimados os moradores da terra, e poucos homens restarão.",
      "palavras": [
        { "hebraico": "עַל־כֵּ֗ן", "transliteral": "ʿal-kên", "traducao_palavra": "Por isso" },
        { "hebraico": "אָ֤לָה", "transliteral": "ʾā-lā", "traducao_palavra": "[a] maldição" },
        { "hebraico": "אָ֣כְלָה", "transliteral": "ʾā-ḵə-lā", "traducao_palavra": "consumiu" },
        { "hebraico": "אֶ֔רֶץ", "transliteral": "ʾe-reṣ", "traducao_palavra": "[a] terra" },
