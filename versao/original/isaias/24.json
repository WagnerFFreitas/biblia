        { "hebraico": "נֹשֶׁ֥א", "transliteral": "nō-še", "traducao_palavra": "deve" },
        { "hebraico": "בֹֽו׃", "transliteral": "ḇô", "traducao_palavra": "a ele" }
      ]
    },
    "3": {
      "traducao_completa": "De todo se esvaziará a terra, e de todo será saqueada, porque YHWH proferiu esta palavra.",
