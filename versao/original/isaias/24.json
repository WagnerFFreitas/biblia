        { "hebraico": "כַּלֹּוֶ֔ה", "transliteral": "kal-lō-weh", "traducao_palavra": "assim o que toma emprestado" },
        { "hebraico": "כַּנֹּשֶׁ֕א", "transliteral": "kan-nō-še", "traducao_palavra": "como o credor" },
