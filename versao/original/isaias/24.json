        { "hebraico": "אָ֗רֶץ", "transliteral": "ʾā-reṣ", "traducao_palavra": "terra" },
        { "hebraico": "וְנִשְׁאָ֥ר", "transliteral": "wə-niš-ʾār", "traducao_palavra": "e restaram" },
        { "hebraico": "אֱנֹ֖وشׁ", "transliteral": "ʾĕ-nôš", "traducao_palavra": "homens" },
        { "hebraico": "מִזְעָֽר׃", "transliteral": "miz-ʿār", "traducao_palavra": "poucos" }
