        { "hebraico": "כֵּ֣ן", "transliteral": "kēn", "traducao_palavra": "Assim" },
        { "hebraico": "הָיוּ־", "transliteral": "hā-yū-", "traducao_palavra": "foram" },
        { "hebraico": "לָ֠ךְ", "transliteral": "lāḵ", "traducao_palavra": "para ti" },
        { "hebraico": "אֲשֶׁ֣ר", "transliteral": "ʾă-šer", "traducao_palavra": "aqueles que" },
        { "hebraico": "יָגָ֑עַתְּ", "transliteral": "yā-ḡā-ʿat", "traducao_palavra": "trabalhaste" },
