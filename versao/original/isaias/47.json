        { "hebraico": "אֶת־", "transliteral": "ʾeṯ-", "traducao_palavra": "[partícula acusativa]" },
        { "hebraico": "נַפְשָׁ֖ם", "transliteral": "nap̄-šām", "traducao_palavra": "sua alma" },
        { "hebraico": "מִיַּ֣ד", "transliteral": "miy-yaḏ", "traducao_palavra": "da mão de/poder de" },
        { "hebraico": "לֶהָבָ֑ה", "transliteral": "le-hā-ḇāh", "traducao_palavra": "chama" },
        { "hebraico": "אֵֽין־", "transliteral": "ʾên-", "traducao_palavra": "não há" },
        { "hebraico": "גַּחֶ֣לֶת", "transliteral": "ga-ḥe-leṯ", "traducao_palavra": "brasa" },
        { "hebraico": "לַחְמָ֔ם", "transliteral": "la-ḥə-mām", "traducao_palavra": "[para] aquecer eles" },
        { "hebraico": "אֹ֖ור", "transliteral": "ʾō-wr", "traducao_palavra": "[nem] fogo/luz" },
        { "hebraico": "לָשֶׁ֥בֶת", "transliteral": "lā-še-ḇeṯ", "traducao_palavra": "para assentar-se" },
