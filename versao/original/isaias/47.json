        { "hebraico": "נָ֣א", "transliteral": "nā", "traducao_palavra": "pois/agora" },
        { "hebraico": "בַחֲבָרַ֗יִךְ", "transliteral": "ḇa-ḥă-ḇā-ra-yiḵ", "traducao_palavra": "com teus encantamentos" },
        { "hebraico": "וּבְרֹ֥ב", "transliteral": "ū-ḇə-rōḇ", "traducao_palavra": "e com a multidão de" },
        { "hebraico": "כְּשָׁפַ֛יִךְ", "transliteral": "kə-šā-p̄a-yiḵ", "traducao_palavra": "tuas feitiçarias" },
        { "hebraico": "בַּאֲשֶׁ֥ר", "transliteral": "ba-ʾă-šer", "traducao_palavra": "nas quais" },
        { "hebraico": "יָגַ֖עַתְּ", "transliteral": "yā-ḡa-ʿat", "traducao_palavra": "trabalhaste" },
        { "hebraico": "מִנְּעוּרָ֑יִךְ", "transliteral": "min-nə-ʿū-rā-yiḵ", "traducao_palavra": "desde tua mocidade" },
        { "hebraico": "אוּלַ֛י", "transliteral": "ʾū-lay", "traducao_palavra": "talvez" },
        { "hebraico": "תּוּכְלִ֥י", "transliteral": "ṯū-ḵə-lî", "traducao_palavra": "poderás" },
        { "hebraico": "הֹועִ֖יל", "transliteral": "hō-w-ʿîl", "traducao_palavra": "tirar proveito" },
        { "hebraico": "אוּלַ֥י", "transliteral": "ʾū-lay", "traducao_palavra": "talvez" },
        { "hebraico": "תַּעֲרֹֽוצִי׃", "transliteral": "ṯa-ʿă-rō-w-ṣî", "traducao_palavra": "aterrorizarás/prevalecerás." }
      ]
    },
    "13": {
      "traducao_completa": "Cansaste-te na multidão dos teus conselhos; apresentem-se agora e salvem-te os que medem os céus, os que observam os astros, os que anunciam as luas novas, o que há de vir sobre ti.",
      "palavras": [
        { "hebraico": "נִלְאֵ֖ית", "transliteral": "nil-ʾêṯ", "traducao_palavra": "Cansaste-te" },
        { "hebraico": "בְּרֹ֣ב", "transliteral": "bə-rōḇ", "traducao_palavra": "na multidão de" },
        { "hebraico": "עֲצָתָ֑יִךְ", "transliteral": "ʿă-ṣā-ṯā-yiḵ", "traducao_palavra": "teus conselhos" },
        { "hebraico": "יַעַמְדוּ־", "transliteral": "ya-ʿam-ḏū-", "traducao_palavra": "apresentem-se" },
        { "hebraico": "נָ֨א", "transliteral": "nā", "traducao_palavra": "pois/agora" },
        { "hebraico": "וְיֹושִׁיעֻ֜ךְ", "transliteral": "wə-yō-w-šî-ʿuḵ", "traducao_palavra": "e salvem-te" },
        { "hebraico": "הֹבְרֵ֣י", "transliteral": "hō-ḇə-rê", "traducao_palavra": "os que mapeiam/medem" },
        { "hebraico": "שָׁמַ֗יִם", "transliteral": "šā-ma-yim", "traducao_palavra": "[os] céus" },
        { "hebraico": "הַחֹוזִים֙", "transliteral": "ha-ḥō-w-zîm", "traducao_palavra": "os observadores de" },
        { "hebraico": "בַּכֹּוכָבִ֔ים", "transliteral": "bak-kō-w-ḵā-ḇîm", "traducao_palavra": "astros/estrelas" },
        { "hebraico": "מֹודִיעִים֙", "transliteral": "mō-w-ḏî-ʿîm", "traducao_palavra": "anunciando" },
        { "hebraico": "לֶחֳדָשִׁ֔ים", "transliteral": "le-ḥo-ḏā-šîm", "traducao_palavra": "nas luas novas" },
        { "hebraico": "מֵאֲשֶׁ֥ר", "transliteral": "mē-ʾă-šer", "traducao_palavra": "do que" },
        { "hebraico": "יָבֹ֖אוּ", "transliteral": "yā-ḇō-ʾū", "traducao_palavra": "virá" },
        { "hebraico": "עָלָֽיִךְ׃", "transliteral": "ʿā-lā-yiḵ", "traducao_palavra": "sobre ti." }
      ]
    },
    "14": {
      "traducao_completa": "Eis que serão como o restolho, o fogo os queimará; não poderão livrar a sua vida do poder da chama; não haverá brasas para se aquecer, nem fogo para se assentar junto a ele.",
      "palavras": [
        { "hebraico": "הִנֵּ֨ה", "transliteral": "hin-nēh", "traducao_palavra": "Eis que" },
        { "hebraico": "הָי֤וּ", "transliteral": "hā-yū", "traducao_palavra": "foram/serão" },
        { "hebraico": "כְקַשׁ֙", "transliteral": "ḵə-qaš", "traducao_palavra": "como restolho" },
        { "hebraico": "אֵ֣שׁ", "transliteral": "ʾēš", "traducao_palavra": "[o] fogo" },
        { "hebraico": "שְׂרָפָ֔ם", "transliteral": "śə-rā-p̄ām", "traducao_palavra": "queimará eles" },
        { "hebraico": "לֹֽא־", "transliteral": "lō-", "traducao_palavra": "não" },
