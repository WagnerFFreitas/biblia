        { "hebraico": "תָּע֔וּ", "transliteral": "tā-ʿū", "traducao_palavra": "vagaram" },
        { "hebraico": "אֵ֖ין", "transliteral": "ʾên", "traducao_palavra": "não há" },
        { "hebraico": "מֹושִׁיעֵֽךְ׃", "transliteral": "mō-w-šî-ʿēḵ", "traducao_palavra": "quem te salve." }
