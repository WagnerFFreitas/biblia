        { "hebraico": "אָמַרְתְּ֙", "transliteral": "ʾā-mar-tə", "traducao_palavra": "disseste" },
        { "hebraico": "אֵ֣ין", "transliteral": "ʾên", "traducao_palavra": "não há" },
        { "hebraico": "רֹאָ֔נִי", "transliteral": "rō-ʾā-nî", "traducao_palavra": "[quem] me veja" },
        { "hebraico": "חָכְמָתֵ֥ךְ", "transliteral": "ḥāḵ-mā-ṯēḵ", "traducao_palavra": "tua sabedoria" },
        { "hebraico": "וְדַעְתֵּ֖ךְ", "transliteral": "wə-ḏa-ʿ-tēḵ", "traducao_palavra": "e teu conhecimento" },
        { "hebraico": "הִ֣יא", "transliteral": "hî", "traducao_palavra": "ela" },
        { "hebraico": "שֹׁובְבָ֑תֶךְ", "transliteral": "šō-w-ḇə-ḇā-ṯeḵ", "traducao_palavra": "fez-te desviar" },
        { "hebraico": "וַתֹּאמְרִ֣י", "transliteral": "wat-tō-mə-rî", "traducao_palavra": "e disseste" },
        { "hebraico": "בְלִבֵּ֔ךְ", "transliteral": "ḇə-lib-bēḵ", "traducao_palavra": "em teu coração" },
        { "hebraico": "אֲנִ֖י", "transliteral": "ʾă-nî", "traducao_palavra": "Eu" },
        { "hebraico": "וְאַפְּסִ֥י", "transliteral": "wə-ʾap-pə-śî", "traducao_palavra": "e fora de mim nada" },
        { "hebraico": "עֹֽוד׃", "transliteral": "ʿō-wḏ", "traducao_palavra": "outro." }
      ]
    },
    "11": {
      "traducao_completa": "Portanto sobre ti virá mal de que não saberás a origem; e cairá sobre ti calamidade que não poderás afastar; e virá sobre ti de repente assolação que não conhecias.",
      "palavras": [
        { "hebraico": "וּבָ֨א", "transliteral": "ū-ḇā", "traducao_palavra": "E virá" },
        { "hebraico": "עָלַ֜יִךְ", "transliteral": "ʿā-la-yiḵ", "traducao_palavra": "sobre ti" },
        { "hebraico": "רָעָ֗ה", "transliteral": "rā-ʿāh", "traducao_palavra": "mal" },
        { "hebraico": "לֹ֤א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "תֵדְעִי֙", "transliteral": "ṯê-ḏə-ʿî", "traducao_palavra": "saberás" },
        { "hebraico": "שַׁחְרָ֔הּ", "transliteral": "ša-ḥərāh", "traducao_palavra": "seu amanhecer/origem" },
        { "hebraico": "וְתִפֹּ֤ל", "transliteral": "wə-ṯip-pōl", "traducao_palavra": "e cairá" },
        { "hebraico": "עָלַ֙יִךְ֙", "transliteral": "ʿā-la-yiḵ", "traducao_palavra": "sobre ti" },
        { "hebraico": "הֹוָ֔ה", "transliteral": "hō-w-wāh", "traducao_palavra": "calamidade/desastre" },
        { "hebraico": "לֹ֥א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "תוּכְלִ֖י", "transliteral": "ṯū-ḵə-lî", "traducao_palavra": "poderás" },
        { "hebraico": "כַּפְּרָ֑הּ", "transliteral": "kap-pə-rāh", "traducao_palavra": "expiá-la/afastá-la" },
        { "hebraico": "וְתָבֹ֨א", "transliteral": "wə-ṯā-ḇō", "traducao_palavra": "e virá" },
        { "hebraico": "עָלַ֧יִךְ", "transliteral": "ʿā-la-yiḵ", "traducao_palavra": "sobre ti" },
        { "hebraico": "פִּתְאֹ֛ם", "transliteral": "piṯ-ʾōm", "traducao_palavra": "de repente" },
        { "hebraico": "שֹׁאָ֖ה", "transliteral": "šō-ʾāh", "traducao_palavra": "assolação" },
        { "hebraico": "לֹ֥א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "תֵדָֽעִי׃", "transliteral": "ṯê-ḏā-ʿî", "traducao_palavra": "conhecerás." }
      ]
    },
    "12": {
      "traducao_completa": "Detém-te agora com os teus encantamentos e com a multidão das tuas feitiçarias, em que trabalhaste desde a tua mocidade; a ver se podes tirar proveito, ou se porventura te fortalecerás.",
