    "20": {
      "traducao_completa": "Congregai-vos, e vinde; chegai-vos juntos, vós que escapastes das nações; nada sabem os que conduzem em procissão as suas imagens de escultura, feitas de madeira, e rogam a um deus que não pode salvar.",
      "palavras": [
        { "hebraico": "הִקָּבְצ֥וּ", "transliteral": "hiq-qā-ḇə-ṣū", "traducao_palavra": "Congregai-vos" },
