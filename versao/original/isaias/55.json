        { "hebraico": "יְהוָֽה׃", "transliteral": "YHWH", "traducao_palavra": "YHWH." }
      ]
    },
    "9": {
      "traducao_completa": "Porque assim como os céus são mais altos do que a terra, assim são os meus caminhos mais altos do que os vossos caminhos, e os meus pensamentos mais do que os vossos pensamentos.",
      "palavras": [
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "Porque" },
        { "hebraico": "גָבְה֥וּ", "transliteral": "ḡā-ḇə-hū", "traducao_palavra": "[como] são altos" },
        { "hebraico": "שָׁמַ֖יִם", "transliteral": "šā-ma-yim", "traducao_palavra": "[os] céus" },
