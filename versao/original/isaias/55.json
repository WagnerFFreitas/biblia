        { "hebraico": "מַחְשְׁבֹותַי֙", "transliteral": "maḥ-šə-ḇō-w-ṯay", "traducao_palavra": "meus pensamentos" },
        { "hebraico": "מַחְשְׁבֹותֵיכֶ֔ם", "transliteral": "maḥ-šə-ḇō-w-ṯê-ḵem", "traducao_palavra": "[são] vossos pensamentos" },
