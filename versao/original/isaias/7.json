        { "hebraico": "רְצִ֨ין", "transliteral": "rə-ṣîn", "traducao_palavra": "Rezim" },
        { "hebraico": "מֶֽלֶךְ־אֲרָ֜ם", "transliteral": "me-leḵ-ʾă-rām", "traducao_palavra": "rei da Síria" },
        { "hebraico": "וּפֶ֨קַח", "transliteral": "ū-p̄e-qaḥ", "traducao_palavra": "e Peca" },
        { "hebraico": "בֶּן־רְמַלְיָ֜הוּ", "transliteral": "ben-rə-mal-yā-hû", "traducao_palavra": "filho de Remalias" },
        { "hebraico": "מֶֽלֶךְ־יִשְׂרָאֵ֤ל", "transliteral": "me-leḵ-yiś-rā-ʾēl", "traducao_palavra": "rei de Israel" },
