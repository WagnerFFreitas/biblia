    "2": {
      "traducao_completa": "E deram aviso à casa de Davi, dizendo: A Síria se confederou com Efraim. Então se moveu o seu coração, e o coração do seu povo, como se movem as árvores do bosque com o vento.",
      "palavras": [
        { "hebraico": "וַיֻּגַּ֗ד", "transliteral": "way-yug-gaḏ", "traducao_palavra": "E foi anunciado" },
        { "hebraico": "לְבֵ֣ית", "transliteral": "lə-ḇêṯ", "traducao_palavra": "à casa de" },
