        { "hebraico": "אֵ֖ת", "transliteral": "ʾêṯ", "traducao_palavra": "[objeto]" },
        { "hebraico": "בֶּן־טָֽבְאַל׃", "transliteral": "ben-ṭā-ḇə-ʾal", "traducao_palavra": "o filho de Tabeel" }
