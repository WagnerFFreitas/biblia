        { "hebraico": "רֹ֤אשׁ", "transliteral": "rōš", "traducao_palavra": "[a] cabeça de" },
        { "hebraico": "אֲרָם֙", "transliteral": "ʾă-rām", "traducao_palavra": "Síria" },
        { "hebraico": "דַּמֶּ֔שֶׂק", "transliteral": "dam-me-śeq", "traducao_palavra": "[é] Damasco" },
        { "hebraico": "וְרֹ֥אשׁ", "transliteral": "wə-rōš", "traducao_palavra": "e a cabeça de" },
        { "hebraico": "דַּמֶּ֖שֶׁק", "transliteral": "dam-me-śeq", "traducao_palavra": "Damasco" },
        { "hebraico": "רְצִ֑ין", "transliteral": "rə-ṣîn", "traducao_palavra": "[é] Rezim" },
        { "hebraico": "וּבְעֹ֗וד", "transliteral": "ū-ḇə-ʿôḏ", "traducao_palavra": "e dentro de" },
        { "hebraico": "שִׁשִּׁ֤ים", "transliteral": "šiš-šîm", "traducao_palavra": "sessenta" },
        { "hebraico": "וְחָמֵשׁ֙", "transliteral": "wə-ḥā-mêš", "traducao_palavra": "e cinco" },
        { "hebraico": "שָׁנָ֔ה", "transliteral": "šā-nā", "traducao_palavra": "anos" },
        { "hebraico": "יֵחַ֥ת", "transliteral": "yê-ḥaṯ", "traducao_palavra": "será quebrantado" },
        { "hebraico": "אֶפְרַ֖יִם", "transliteral": "ʾep̄-ra-yim", "traducao_palavra": "Efraim" },
