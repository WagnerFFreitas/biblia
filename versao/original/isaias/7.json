        { "hebraico": "אֵלֵ֑ינוּ", "transliteral": "ʾê-lê-nû", "traducao_palavra": "para nós" },
        { "hebraico": "וְנַמְלִ֥יךְ", "transliteral": "wə-nam-lîḵ", "traducao_palavra": "e façamos reinar" },
