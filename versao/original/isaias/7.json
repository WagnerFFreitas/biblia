        { "hebraico": "וּבֶן־רְמַלְיָ֖הוּ", "transliteral": "ū-ḇen-rə-mal-yā-hû", "traducao_palavra": "e o filho de Remalias" },
        { "hebraico": "לֵאמֹֽר׃", "transliteral": "lê-mōr", "traducao_palavra": "dizendo" }
      ]
    },
    "6": {
      "traducao_completa": "Subamos contra Judá e o molestemos, e repartamo-lo entre nós, e ponhamos no meio dele um rei, a saber, o filho de Tabeel.",
      "palavras": [
        { "hebraico": "נַעֲלֶ֨ה", "transliteral": "na-ʿă-leh", "traducao_palavra": "Subamos" },
