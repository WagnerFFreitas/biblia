        { "hebraico": "עָלֶ֛יךָ", "transliteral": "ʿā-le-ḵā", "traducao_palavra": "contra ti" },
        { "hebraico": "אֲרָ֖ם", "transliteral": "ʾă-rām", "traducao_palavra": "Síria" },
