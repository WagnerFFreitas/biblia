        { "hebraico": "יָשׁ֖וּב", "transliteral": "yā-šûḇ", "traducao_palavra": "Jasube [teu filho]" },
        { "hebraico": "בְּנֶ֑ךָ", "transliteral": "bə-ne-ḵā", "traducao_palavra": "teu filho" },
        { "hebraico": "אֶל־קְצֵ֗ה", "transliteral": "ʾel-qə-ṣê", "traducao_palavra": "ao fim de" },
        { "hebraico": "תְּעָלַת֙", "transliteral": "tə-ʿā-laṯ", "traducao_palavra": "[o] aqueduto de" },
        { "hebraico": "הַבְּרֵכָ֣ה", "transliteral": "hab-bə-rê-ḵā", "traducao_palavra": "a piscina/tanque" },
