        { "hebraico": "אֶל־מְסִלַּ֖ת", "transliteral": "ʾel-mə-sil-laṯ", "traducao_palavra": "no caminho/estrada de" },
        { "hebraico": "שְׂדֵ֥ה", "transliteral": "śə-ḏê", "traducao_palavra": "campo de" },
