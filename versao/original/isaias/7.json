        { "hebraico": "יְהוָה֮", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "אֶל־יְשַׁעְיָהוּ֒", "transliteral": "ʾel-yə-šaʿ-yā-hû", "traducao_palavra": "a Isaías" },
        { "hebraico": "צֵא־נָא֙", "transliteral": "ṣê-nā", "traducao_palavra": "sai agora" },
        { "hebraico": "לִקְרַ֣את", "transliteral": "liq-raṯ", "traducao_palavra": "ao encontro de" },
