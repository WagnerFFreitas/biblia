      ]
    },
    "4": {
      "traducao_completa": "E dize-lhe: Acautela-te e sossega; não temas, nem se desanime o teu coração por causa destes dois pedaços de tições fumegantes, por causa do furor da ira de Rezim e da Síria, e do filho de Remalias.",
      "palavras": [
        { "hebraico": "וְאָמַרְתָּ֣", "transliteral": "wə-ʾā-mar-tā", "traducao_palavra": "E dirás" },
        { "hebraico": "אֵ֠לָיו", "transliteral": "ʾê-lāyw", "traducao_palavra": "a ele" },
        { "hebraico": "הִשָּׁמֵ֨ר", "transliteral": "hiš-šā-mêr", "traducao_palavra": "acautela-te/guarda-te" },
        { "hebraico": "וְהַשְׁקֵ֜ט", "transliteral": "wə-haš-qēṭ", "traducao_palavra": "e aquieta-te" },
        { "hebraico": "אַל־תִּירָ֗א", "transliteral": "ʾal-tî-rā", "traducao_palavra": "não temas" },
        { "hebraico": "וּלְבָבְךָ֙", "transliteral": "ū-lə-ḇā-ḇə-ḵā", "traducao_palavra": "e teu coração" },
        { "hebraico": "אַל־יֵרַ֔ךְ", "transliteral": "ʾal-yê-raḵ", "traducao_palavra": "não se amoleça/desanime" },
        { "hebraico": "מִשְּׁנֵ֨י", "transliteral": "miš-šə-nê", "traducao_palavra": "por causa de dois" },
        { "hebraico": "זַנְבֹ֧ות", "transliteral": "zan-ḇôṯ", "traducao_palavra": "pontas/caudas de" },
        { "hebraico": "הָאוּדִ֛ים", "transliteral": "hā-ʾû-ḏîm", "traducao_palavra": "os tições" },
        { "hebraico": "הָעֲשֵׁנִ֖ים", "transliteral": "hā-ʿă-šê-nîm", "traducao_palavra": "fumegantes" },
        { "hebraico": "הָאֵ֑לֶּה", "transliteral": "hā-ʾēl-leh", "traducao_palavra": "estes" },
        { "hebraico": "בָּחֳרִי־אַף֙", "transliteral": "bo-ḥo-rî-ʾap̄", "traducao_palavra": "no ardor da ira de" },
        { "hebraico": "רְצִ֣ין", "transliteral": "rə-ṣîn", "traducao_palavra": "Rezim" },
        { "hebraico": "וַאֲרָ֔ם", "transliteral": "wa-ʾă-rām", "traducao_palavra": "e Síria" },
