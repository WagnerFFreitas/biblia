        { "hebraico": "כְּנֹ֥ועַ", "transliteral": "kə-nô-aʿ", "traducao_palavra": "como o mover de" },
        { "hebraico": "עֲצֵי־יַ֖עַר", "transliteral": "ʿă-ṣê-ya-ʿar", "traducao_palavra": "árvores do bosque" },
