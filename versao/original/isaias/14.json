        { "hebraico": "וְלִשְׁפָחֹ֔ות", "transliteral": "wə-liš-p̄ā-ḥôṯ", "traducao_palavra": "e por servas" },
        { "hebraico": "וְהָי֨וּ", "transliteral": "wə-hā-yû", "traducao_palavra": "e serão" },
