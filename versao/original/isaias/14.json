        { "hebraico": "לֵאמֹ֑ר", "transliteral": "lê-mōr", "traducao_palavra": "dizendo" },
        { "hebraico": "אִם־", "transliteral": "ʾim-", "traducao_palavra": "Certamente/se" },
        { "hebraico": "לֹ֤א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "כַּאֲשֶׁ֤ר", "transliteral": "ka-ʾă-šer", "traducao_palavra": "conforme" },
        { "hebraico": "דִּמִּ֨יתִי֙", "transliteral": "dim-mî-ṯî", "traducao_palavra": "pensei/planejei" },
        { "hebraico": "כֵּ֣ן", "transliteral": "kên", "traducao_palavra": "assim" },
        { "hebraico": "הָיָ֔תָה", "transliteral": "hā-yā-ṯā", "traducao_palavra": "aconteceu/sucederá" },
        { "hebraico": "וְכַאֲשֶׁ֥ר", "transliteral": "wə-ḵa-ʾă-šer", "traducao_palavra": "e conforme" },
        { "hebraico": "יָעַ֖צְתִּי", "transliteral": "yā-ʿaṣ-tî", "traducao_palavra": "aconselhei/determinei" },
