        { "hebraico": "בְּיֹ֣ום", "transliteral": "bə-yôm", "traducao_palavra": "no dia" },
        { "hebraico": "הָנִ֣יחַ", "transliteral": "hā-nî-aḥ", "traducao_palavra": "do dar descanso" },
        { "hebraico": "יְהוָה֮", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "לְךָ֒", "transliteral": "lə-ḵā", "traducao_palavra": "a ti" },
        { "hebraico": "מֵעָצְבְּךָ֙", "transliteral": "mē-ʿā-ṣə-bə-ḵā", "traducao_palavra": "da tua dor/sofrimento" },
        { "hebraico": "וּמֵרָגְזֶ֔ךָ", "transliteral": "ū-mē-rā-ḡə-ze-ḵā", "traducao_palavra": "e do teu pavor/ira" },
        { "hebraico": "וּמִן־הָעֲבֹדָ֥ה", "transliteral": "ū-min-hā-ʿă-ḇō-ḏā", "traducao_palavra": "e da servidão" },
        { "hebraico": "הַקָּשָׁ֖ה", "transliteral": "haq-qā-šā", "traducao_palavra": "dura" },
        { "hebraico": "אֲשֶׁ֥ר", "transliteral": "ʾă-šer", "traducao_palavra": "que" },
        { "hebraico": "עֻבַּד־בָּֽךְ׃", "transliteral": "ʿub-baḏ-bāḵ", "traducao_palavra": "fizeram servir em ti" }
      ]
    },
    "4": {
      "traducao_completa": "então proferirás este provérbio contra o rei da Babilônia, e dirás: Como cessou o opressor! Como cessou a fúria do ouro!",
      "palavras": [
        { "hebraico": "וְנָשָׂ֜אתָ", "transliteral": "wə-nā-śā-ṯā", "traducao_palavra": "E levantarás/proferirás" },
        { "hebraico": "הַמָּשָׁ֧ל", "transliteral": "ham-mā-šāl", "traducao_palavra": "o provérbio/parábola" },
        { "hebraico": "הַזֶּ֛ה", "transliteral": "haz-zeh", "traducao_palavra": "este" },
        { "hebraico": "עַל־מֶ֥לֶךְ", "transliteral": "ʿal-me-leḵ", "traducao_palavra": "contra o rei de" },
