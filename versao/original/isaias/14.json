        { "hebraico": "וְנִלְוָ֤ה", "transliteral": "wə-nil-wā", "traducao_palavra": "e se unirá" },
        { "hebraico": "הַגֵּר֙", "transliteral": "hag-gêr", "traducao_palavra": "o estrangeiro" },
        { "hebraico": "עֲלֵיהֶ֔ם", "transliteral": "ʿă-lê-hem", "traducao_palavra": "com eles" },
        { "hebraico": "וְנִסְפְּח֖וּ", "transliteral": "wə-nis-pə-ḥû", "traducao_palavra": "e se achegarão/ajuntarão" },
        { "hebraico": "עַל־בֵּ֥ית", "transliteral": "ʿal-bêṯ", "traducao_palavra": "à casa de" },
