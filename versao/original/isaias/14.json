      ]
    },
    "5": {
      "traducao_completa": "YHWH quebrou o bordão dos ímpios e o cetro dos dominadores.",
      "palavras": [
        { "hebraico": "שָׁבַ֥ר", "transliteral": "šā-ḇar", "traducao_palavra": "Quebrou" },
        { "hebraico": "יְהוָ֖ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "מַטֵּ֣ה", "transliteral": "maṭ-ṭēh", "traducao_palavra": "[o] cajado/bordão de" },
        { "hebraico": "רְשָׁעִ֑ים", "transliteral": "rə-šā-ʿîm", "traducao_palavra": "ímpios" },
