    "25": {
      "traducao_completa": "Quebrantarei a Assíria na minha terra e, nos meus montes, a pisarei; para que o seu jugo se afaste deles e a sua carga se desvie dos seus ombros.",
      "palavras": [
        { "hebraico": "לִשְׁבֹּ֤ר", "transliteral": "liš-bōr", "traducao_palavra": "Para quebrar" },
        { "hebraico": "אַשּׁוּר֙", "transliteral": "ʾaš-šûr", "traducao_palavra": "Assíria" },
        { "hebraico": "בְּאַרְצִ֔י", "transliteral": "bə-ʾar-ṣî", "traducao_palavra": "na minha terra" },
        { "hebraico": "וְעַל־הָרַ֖י", "transliteral": "wə-ʿal-hā-ray", "traducao_palavra": "e sobre meus montes" },
        { "hebraico": "אֲבוּסֶ֑נּוּ", "transliteral": "ʾă-ḇû-śen-nû", "traducao_palavra": "a pisarei" },
        { "hebraico": "וְסָ֤ר", "transliteral": "wə-śār", "traducao_palavra": "e se retirará" },
        { "hebraico": "מֵֽעֲלֵיהֶם֙", "transliteral": "mê-ʿă-lê-hem", "traducao_palavra": "de sobre eles" },
        { "hebraico": "עֻלֹּ֔ו", "transliteral": "ʿul-lô", "traducao_palavra": "seu jugo" },
        { "hebraico": "וְסֻבֳּלֹו֙", "transliteral": "wə-śub-bo-lô", "traducao_palavra": "e sua carga" },
        { "hebraico": "מֵעַ֥ל", "transliteral": "mê-ʿal", "traducao_palavra": "de sobre" },
        { "hebraico": "שִׁכְמֹ֖ו", "transliteral": "šiḵ-mô", "traducao_palavra": "seu ombro" },
        { "hebraico": "יָסֽוּר׃", "transliteral": "yā-śûr", "traducao_palavra": "se retirará" }
      ]
    },
    "26": {
      "traducao_completa": "Este é o conselho que foi determinado sobre toda a terra; e esta é a mão que está estendida sobre todas as nações.",
      "palavras": [
        { "hebraico": "זֹ֤את", "transliteral": "zōṯ", "traducao_palavra": "Este [é]" },
        { "hebraico": "הָֽעֵצָה֙", "transliteral": "hā-ʿê-ṣā", "traducao_palavra": "o conselho" },
        { "hebraico": "הַיְּעוּצָ֖ה", "transliteral": "hay-yə-ʿû-ṣā", "traducao_palavra": "determinado/aconselhado" },
        { "hebraico": "עַל־כָּל־", "transliteral": "ʿal-kāl-", "traducao_palavra": "sobre toda" },
        { "hebraico": "הָאָ֑רֶץ", "transliteral": "hā-ʾā-reṣ", "traducao_palavra": "a terra" },
        { "hebraico": "וְזֹ֥את", "transliteral": "wə-zōṯ", "traducao_palavra": "e esta [é]" },
        { "hebraico": "הַיָּ֥ד", "transliteral": "hay-yāḏ", "traducao_palavra": "a mão" },
        { "hebraico": "הַנְּטוּיָ֖ה", "transliteral": "han-nə-ṭû-yā", "traducao_palavra": "estendida" },
        { "hebraico": "עַל־כָּל־", "transliteral": "ʿal-kāl-", "traducao_palavra": "sobre todas" },
        { "hebraico": "הַגֹּויִֽם׃", "transliteral": "hag-gô-yim", "traducao_palavra": "as nações" }
      ]
    },
    "27": {
      "traducao_completa": "Porque YHWH dos Exércitos o determinou; quem pois o invalidará? E a sua mão está estendida; quem pois a tornará atrás?",
      "palavras": [
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "Porque" },
        { "hebraico": "יְהוָ֧ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "צְבָאֹ֛ות", "transliteral": "ṣə-ḇā-ʾôṯ", "traducao_palavra": "Exércitos" },
        { "hebraico": "יָעָ֖ץ", "transliteral": "yā-ʿāṣ", "traducao_palavra": "determinou" },
        { "hebraico": "וּמִ֣י", "transliteral": "ū-mî", "traducao_palavra": "e quem" },
        { "hebraico": "יָפֵ֑ר", "transliteral": "yā-p̄êr", "traducao_palavra": "anulará/invalidará?" },
        { "hebraico": "וְיָדֹ֥ו", "transliteral": "wə-yā-ḏô", "traducao_palavra": "e sua mão" },
        { "hebraico": "הַנְּטוּיָ֖ה", "transliteral": "han-nə-ṭû-yā", "traducao_palavra": "estendida" },
        { "hebraico": "וּמִ֥י", "transliteral": "ū-mî", "traducao_palavra": "e quem" },
        { "hebraico": "יְשִׁיבֶֽנָּה׃", "transliteral": "yə-šî-ḇen-nā", "traducao_palavra": "a fará voltar?" }
      ]
    },
    "28": {
      "traducao_completa": "No ano em que morreu o rei Acaz, foi este oráculo:",
      "palavras": [
        { "hebraico": "בִּשְׁנַת־מֹ֖ות", "transliteral": "biš-naṯ-môṯ", "traducao_palavra": "No ano da morte de" },
        { "hebraico": "הַמֶּ֣לֶךְ", "transliteral": "ham-me-leḵ", "traducao_palavra": "o rei" },
        { "hebraico": "אָחָ֑ז", "transliteral": "ʾā-ḥāz", "traducao_palavra": "Acaz" },
        { "hebraico": "הָיָ֖ה", "transliteral": "hā-yā", "traducao_palavra": "foi/veio" },
        { "hebraico": "הַמַּשָּׂ֥א", "transliteral": "ham-maś-śā", "traducao_palavra": "o oráculo/profecia" },
        { "hebraico": "הַזֶּֽה׃", "transliteral": "haz-zeh", "traducao_palavra": "este" }
      ]
    },
    "29": {
      "traducao_completa": "Não te alegres, tu, toda a Filístia, por se ter quebrado a vara que te feria; porque da raiz da cobra sairá um basilisco, e o seu fruto será uma serpente ardente voadora.",
      "palavras": [
        { "hebraico": "אַל־תִּשְׂמְחִ֤י", "transliteral": "ʾal-tiś-mə-ḥî", "traducao_palavra": "Não te alegres" },
        { "hebraico": "פְלֶ֨שֶׁת֙", "transliteral": "p̄ə-le-šeṯ", "traducao_palavra": "[ó] Filístia" },
        { "hebraico": "כֻּלֵּ֔ךְ", "transliteral": "kul-lêḵ", "traducao_palavra": "toda tu" },
        { "hebraico": "כִּ֥י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "נִשְׁבַּ֖ר", "transliteral": "niš-bar", "traducao_palavra": "quebrou-se" },
        { "hebraico": "שֵׁ֣בֶט", "transliteral": "šē-ḇeṭ", "traducao_palavra": "[a] vara de" },
        { "hebraico": "מַכֵּ֑ךְ", "transliteral": "mak-kêḵ", "traducao_palavra": "quem te feria" },
        { "hebraico": "כִּֽי־מִשֹּׁ֤רֶשׁ", "transliteral": "kî-miš-šō-reš", "traducao_palavra": "pois da raiz de" },
        { "hebraico": "נָחָשׁ֙", "transliteral": "nā-ḥāš", "traducao_palavra": "cobra" },
        { "hebraico": "יֵ֣צֵא", "transliteral": "yê-ṣê", "traducao_palavra": "sairá" },
        { "hebraico": "צֶ֔פַע", "transliteral": "ṣe-p̄aʿ", "traducao_palavra": "víbora/basilisco" },
        { "hebraico": "וּפִרְיֹ֖ו", "transliteral": "ū-p̄ir-yô", "traducao_palavra": "e o seu fruto" },
        { "hebraico": "שָׂרָ֥ף", "transliteral": "śā-rāp̄", "traducao_palavra": "[será] serpente ardente" },
        { "hebraico": "מְעֹופֵֽף׃", "transliteral": "mə-ʿô-p̄êp̄", "traducao_palavra": "voadora" }
      ]
    },
    "30": {
      "traducao_completa": "E os primogênitos dos pobres pastarão, e os necessitados se deitarão seguros; mas farei morrer de fome a tua raiz, e ela matará o teu remanescente.",
      "palavras": [
        { "hebraico": "וְרָע֭וּ", "transliteral": "wə-rā-ʿû", "traducao_palavra": "E pastarão" },
        { "hebraico": "בְּכֹורֵ֣י", "transliteral": "bə-ḵô-rê", "traducao_palavra": "[os] primogênitos de" },
        { "hebraico": "דַלִּ֑ים", "transliteral": "dal-lîm", "traducao_palavra": "pobres" },
        { "hebraico": "וְאֶבְיֹונִ֖ים", "transliteral": "wə-ʾeḇ-yô-nîm", "traducao_palavra": "e necessitados" },
        { "hebraico": "לָבֶ֣טַח", "transliteral": "lā-ḇe-ṭaḥ", "traducao_palavra": "em segurança" },
        { "hebraico": "יִרְבָּ֑צוּ", "transliteral": "yir-bā-ṣû", "traducao_palavra": "se deitarão" },
        { "hebraico": "וְהֵמַתִּ֤י", "transliteral": "wə-hê-mat-tî", "traducao_palavra": "e farei morrer" },
        { "hebraico": "בָרָעָב֙", "transliteral": "ḇā-rā-ʿāḇ", "traducao_palavra": "pela fome" },
        { "hebraico": "שָׁרְשֵׁ֔ךְ", "transliteral": "šār-šêḵ", "traducao_palavra": "tua raiz" },
        { "hebraico": "וּשְׁאֵרִיתֵ֖ךְ", "transliteral": "ū-šə-ʾê-rî-ṯêḵ", "traducao_palavra": "e teu resto" },
        { "hebraico": "יַהֲרֹֽג׃", "transliteral": "ya-hă-rōḡ", "traducao_palavra": "ele matará" }
      ]
