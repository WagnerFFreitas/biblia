        { "hebraico": "מַלְכֵ֥י", "transliteral": "mal-ḵê", "traducao_palavra": "reis de" },
        { "hebraico": "גֹויִֽם׃", "transliteral": "gô-yim", "traducao_palavra": "nações" }
      ]
    },
    "10": {
      "traducao_completa": "Todos eles responderão, e te dirão: Tu também adoeceste como nós, e foste feito semelhante a nós?",
      "palavras": [
        { "hebraico": "כֻּלָּם֙", "transliteral": "kul-lām", "traducao_palavra": "Todos eles" },
        { "hebraico": "יַעֲנ֔וּ", "transliteral": "ya-ʿă-nû", "traducao_palavra": "responderão" },
        { "hebraico": "וְיֹאמְר֖וּ", "transliteral": "wə-yō-mə-rû", "traducao_palavra": "e dirão" },
        { "hebraico": "אֵלֶ֑יךָ", "transliteral": "ʾê-le-ḵā", "traducao_palavra": "a ti" },
        { "hebraico": "גַּם־אַתָּ֛ה", "transliteral": "gam-ʾat-tā", "traducao_palavra": "também tu" },
        { "hebraico": "חֻלֵּ֥יתָ", "transliteral": "ḥul-lê-ṯā", "traducao_palavra": "foste enfraquecido" },
        { "hebraico": "כָמֹ֖ונוּ", "transliteral": "ḵā-mô-nû", "traducao_palavra": "como nós" },
        { "hebraico": "אֵלֵ֥ינוּ", "transliteral": "ʾê-lê-nû", "traducao_palavra": "a nós" },
        { "hebraico": "נִמְשָֽׁלְתָּ׃", "transliteral": "nim-šāl-tā", "traducao_palavra": "te tornaste semelhante" }
      ]
    },
    "11": {
      "traducao_completa": "Derrubada foi ao Seol a tua soberba, e o som das tuas liras; os bichinhos debaixo de ti se estenderão, e os vermes te cobrirão.",
      "palavras": [
        { "hebraico": "הוּרַ֥ד", "transliteral": "hū-raḏ", "traducao_palavra": "Foi baixada/derrubada" },
        { "hebraico": "שְׁאֹ֛ול", "transliteral": "šə-ʾôl", "traducao_palavra": "[ao] Seol" },
        { "hebraico": "גְּאֹונֶ֕ךָ", "transliteral": "gə-ʾô-ne-ḵā", "traducao_palavra": "tua soberba" },
        { "hebraico": "הֶמְיַ֖ת", "transliteral": "hem-yaṯ", "traducao_palavra": "[o] som/estrondo de" },
        { "hebraico": "נְבָלֶ֑יךָ", "transliteral": "nə-ḇā-le-ḵā", "traducao_palavra": "tuas liras" },
        { "hebraico": "תַּחְתֶּ֨יךָ֙", "transliteral": "taḥ-te-y-ḵā", "traducao_palavra": "debaixo de ti" },
        { "hebraico": "יֻצַּ֣ע", "transliteral": "yuṣ-ṣaʿ", "traducao_palavra": "será estendida" },
        { "hebraico": "רִמָּ֔ה", "transliteral": "rim-mā", "traducao_palavra": "[a] podridão/bichos" },
        { "hebraico": "וּמְכַסֶּ֖ךָ", "transliteral": "ū-mə-ḵas-se-ḵā", "traducao_palavra": "e tua cobertura" },
        { "hebraico": "תֹּולֵעָֽה׃", "transliteral": "tô-lê-ʿā", "traducao_palavra": "[serão] vermes" }
      ]
    },
    "12": {
      "traducao_completa": "Como caíste do céu, ó estrela da manhã, filha da alva! Como foste cortado por terra, tu que debilitavas as nações!",
      "palavras": [
        { "hebraico": "אֵ֣יךְ", "transliteral": "ʾêḵ", "traducao_palavra": "Como" },
        { "hebraico": "נָפַ֣לְתָּ", "transliteral": "nā-p̄al-tā", "traducao_palavra": "caíste" },
