        { "hebraico": "יְרַחֵ֤ם", "transliteral": "yə-ra-ḥêm", "traducao_palavra": "se compadecerá" },
        { "hebraico": "יְהוָה֙", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
