    "31": {
      "traducao_completa": "Uiva, ó porta; grita, ó cidade; tu, ó Filístia toda, estás dissolvida; porque do norte vem uma fumaça, e ninguém haverá solitário nas suas fileiras.",
      "palavras": [
        { "hebraico": "הֵילִ֤ילִי", "transliteral": "hê-lî-lî", "traducao_palavra": "Uiva" },
        { "hebraico": "שַׁ֨עַר֙", "transliteral": "ša-ʿar", "traducao_palavra": "ó porta" },
        { "hebraico": "זַֽעֲקִי־", "transliteral": "za-ʿă-qî-", "traducao_palavra": "grita" },
        { "hebraico": "עִ֔יר", "transliteral": "ʿîr", "traducao_palavra": "ó cidade" },
        { "hebraico": "נָמֹ֖וג", "transliteral": "nā-môḡ", "traducao_palavra": "derretida/dissolvida [estás]" },
        { "hebraico": "פְּלֶ֣שֶׁת", "transliteral": "p̄ə-le-šeṯ", "traducao_palavra": "[ó] Filístia" },
        { "hebraico": "כֻּלֵּ֑ךְ", "transliteral": "kul-lêḵ", "traducao_palavra": "toda tu" },
        { "hebraico": "כִּ֤י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "מִצָּפֹון֙", "transliteral": "miṣ-ṣā-p̄ôn", "traducao_palavra": "do norte" },
        { "hebraico": "עָשָׁ֣ן", "transliteral": "ʿā-šān", "traducao_palavra": "fumaça" },
        { "hebraico": "בָּ֔א", "transliteral": "bā", "traducao_palavra": "vem" },
        { "hebraico": "וְאֵ֥ין", "transliteral": "wə-ʾên", "traducao_palavra": "e não [há]" },
        { "hebraico": "בֹּודֵ֖ד", "transliteral": "bô-ḏêḏ", "traducao_palavra": "solitário/retardatário" },
        { "hebraico": "בְּמֹועָדָֽיו׃", "transliteral": "bə-mô-ʿā-ḏāyw", "traducao_palavra": "em suas fileiras/tempos fixados" }
