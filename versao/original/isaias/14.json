    "6": {
      "traducao_completa": "Aquele que feria os povos com furor, com ferida incessante, que dominava as nações com ira, é perseguido sem que ninguém o possa deter.",
      "palavras": [
        { "hebraico": "מַכֶּ֤ה", "transliteral": "mak-keh", "traducao_palavra": "[Aquele que] feria" },
        { "hebraico": "עַמִּים֙", "transliteral": "ʿam-mîm", "traducao_palavra": "povos" },
