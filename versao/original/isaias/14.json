        { "hebraico": "בְּנֹגְשֵׂיהֶֽם׃", "transliteral": "bə-nō-ḡə-śê-hem", "traducao_palavra": "os seus opressores" }
      ]
    },
    "3": {
      "traducao_completa": "E acontecerá que, no dia em que YHWH te der descanso do teu sofrimento, e do teu pavor, e da dura servidão com que te fizeram servir,",
