      ]
    },
    "2": {
      "traducao_completa": "E os povos os tomarão, e os levarão aos seus lugares, e a casa de Israel os possuirá por servos e por servas, na terra de YHWH; e cativarão aqueles que os cativaram, e dominarão os seus opressores.",
      "palavras": [
        { "hebraico": "וּלְקָח֨וּם", "transliteral": "ū-lə-qā-ḥûm", "traducao_palavra": "E os tomarão" },
        { "hebraico": "עַמִּים֙", "transliteral": "ʿam-mîm", "traducao_palavra": "povos" },
        { "hebraico": "וֶהֱבִיא֨וּם֮", "transliteral": "we-hĕ-ḇî-ʾûm", "traducao_palavra": "e os levarão" },
        { "hebraico": "אֶל־מְקֹומָם֒", "transliteral": "ʾel-mə-qô-mām", "traducao_palavra": "ao seu lugar" },
