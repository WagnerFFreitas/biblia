        { "hebraico": "גֹ֑וי", "transliteral": "gôy", "traducao_palavra": "nação?" },
        { "hebraico": "כִּ֤י", "transliteral": "kî", "traducao_palavra": "que" },
        { "hebraico": "יְהוָה֙", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "יִסַּ֣ד", "transliteral": "yiś-śaḏ", "traducao_palavra": "fundou" },
