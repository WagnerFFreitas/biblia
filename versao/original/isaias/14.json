    "7": {
      "traducao_completa": "Já descansa, já está sossegada toda a terra; rompem em cânticos.",
      "palavras": [
        { "hebraico": "נָחָ֥ה", "transliteral": "nā-ḥā", "traducao_palavra": "Descansou" },
        { "hebraico": "שָׁקְטָ֖ה", "transliteral": "šā-qə-ṭā", "traducao_palavra": "aquietou-se" },
        { "hebraico": "כָּל־הָאָ֑רֶץ", "transliteral": "kāl-hā-ʾā-reṣ", "traducao_palavra": "toda a terra" },
        { "hebraico": "פָּצְח֖וּ", "transliteral": "pā-ṣə-ḥû", "traducao_palavra": "romperam em" },
        { "hebraico": "רִנָּֽה׃", "transliteral": "rin-nā", "traducao_palavra": "júbilo/cântico" }
      ]
    },
    "8": {
      "traducao_completa": "Até os ciprestes se alegram sobre ti, e os cedros do Líbano, dizendo: Desde que tu caíste, ninguém sobe contra nós para nos cortar.",
      "palavras": [
        { "hebraico": "גַּם־בְּרֹושִׁ֛ים", "transliteral": "gam-bə-rô-šîm", "traducao_palavra": "Também [os] ciprestes" },
        { "hebraico": "שָׂמְח֥וּ", "transliteral": "śā-mə-ḥû", "traducao_palavra": "alegraram-se" },
        { "hebraico": "לְךָ֖", "transliteral": "lə-ḵā", "traducao_palavra": "sobre ti" },
        { "hebraico": "אַרְזֵ֣י", "transliteral": "ʾar-zê", "traducao_palavra": "[os] cedros de" },
        { "hebraico": "לְבָנֹ֑ון", "transliteral": "lə-ḇā-nôn", "traducao_palavra": "Líbano" },
        { "hebraico": "מֵאָ֣ז", "transliteral": "mê-ʾāz", "traducao_palavra": "desde que" },
        { "hebraico": "שָׁכַ֔בְתָּ", "transliteral": "šā-ḵaḇ-tā", "traducao_palavra": "tu te deitaste/caíste" },
        { "hebraico": "לֹֽא־יַעֲלֶ֥ה", "transliteral": "lō-ya-ʿă-leh", "traducao_palavra": "não subirá" },
        { "hebraico": "הַכֹּרֵ֖ת", "transliteral": "hak-kō-rêṯ", "traducao_palavra": "o cortador/lenhador" },
        { "hebraico": "עָלֵֽינוּ׃", "transliteral": "ʿā-lê-nû", "traducao_palavra": "contra nós" }
      ]
    },
    "9": {
      "traducao_completa": "O Seol, desde o profundo, se turbou por ti, para te sair ao encontro na tua vinda; despertou por ti os mortos, todos os príncipes da terra, e fez levantar dos seus tronos todos os reis das nações.",
      "palavras": [
        { "hebraico": "שְׁאֹ֗ול", "transliteral": "šə-ʾôl", "traducao_palavra": "[O] Seol" },
        { "hebraico": "מִתַּ֛חַת", "transliteral": "mit-ta-ḥaṯ", "traducao_palavra": "debaixo" },
        { "hebraico": "רָגְזָ֥ה", "transliteral": "rā-ḡə-zā", "traducao_palavra": "se perturbou/agitou" },
        { "hebraico": "לְךָ֖", "transliteral": "lə-ḵā", "traducao_palavra": "por ti" },
        { "hebraico": "לִקְרַ֣את", "transliteral": "liq-raṯ", "traducao_palavra": "para o encontro de" },
        { "hebraico": "בֹּואֶ֑ךָ", "transliteral": "bô-ʾe-ḵā", "traducao_palavra": "tua vinda" },
        { "hebraico": "עֹורֵ֨ר", "transliteral": "ʿô-rēr", "traducao_palavra": "despertou" },
        { "hebraico": "לְךָ֤", "transliteral": "lə-ḵā", "traducao_palavra": "por ti" },
        { "hebraico": "רְפָאִים֙", "transliteral": "rə-p̄ā-ʾîm", "traducao_palavra": "[os] espíritos/mortos" },
        { "hebraico": "כָּל־עַתּוּדֵ֣י", "transliteral": "kāl-ʿat-tû-ḏê", "traducao_palavra": "todos os bodes/líderes de" },
        { "hebraico": "אָ֔רֶץ", "transliteral": "ʾā-reṣ", "traducao_palavra": "terra" },
        { "hebraico": "הֵקִים֙", "transliteral": "hê-qîm", "traducao_palavra": "fez levantar" },
        { "hebraico": "מִכִּסְאֹותָ֔ם", "transliteral": "mik-kis-ʾô-ṯām", "traducao_palavra": "de seus tronos" },
