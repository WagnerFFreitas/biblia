      ]
    },
    "13": {
      "traducao_completa": "E nos seus palácios crescerão espinhos, urtigas e cardos nas suas fortalezas; e será uma habitação de chacais, e um pátio para as avestruzes.",
      "palavras": [
        { "hebraico": "וְעָלְתָ֤ה", "transliteral": "wə-ʿā-lə-ṯā", "traducao_palavra": "E subirão/crescerão" },
        { "hebraico": "אַרְמְנֹתֶ֨יהָ֙", "transliteral": "ʾar-mə-nō-ṯe-y-hā", "traducao_palavra": "[nos] seus palácios" },
        { "hebraico": "סִירִ֔ים", "transliteral": "śî-rîm", "traducao_palavra": "espinhos" },
        { "hebraico": "קִמֹּ֥ושׂ", "transliteral": "qim-môś", "traducao_palavra": "urtiga" },
        { "hebraico": "וָחֹ֖וחַ", "transliteral": "wā-ḥô-aḥ", "traducao_palavra": "e cardo" },
        { "hebraico": "בְּמִבְצָרֶ֑יהָ", "transliteral": "bə-miḇ-ṣā-re-y-hā", "traducao_palavra": "nas suas fortalezas" },
        { "hebraico": "וְהָיְתָה֙", "transliteral": "wə-hā-yə-ṯā", "traducao_palavra": "e ela será" },
        { "hebraico": "נְוֵ֣ה", "transliteral": "nə-wēh", "traducao_palavra": "habitação de" },
        { "hebraico": "תַנִּ֔ים", "transliteral": "tan-nîm", "traducao_palavra": "chacais" },
        { "hebraico": "חָצִ֖יר", "transliteral": "ḥā-ṣîr", "traducao_palavra": "[e] pátio/erva para" },
        { "hebraico": "לִבְנֹ֥ות", "transliteral": "liḇ-nôṯ", "traducao_palavra": "filhas de" },
        { "hebraico": "יַעֲנָֽה׃", "transliteral": "ya-ʿă-nā", "traducao_palavra": "avestruz" }
