      ]
    },
    "10": {
      "traducao_completa": "Nem de noite nem de dia se apagará; para sempre a sua fumaça subirá; de geração em geração será assolada; de eternidade em eternidade ninguém passará por ela.",
      "palavras": [
        { "hebraico": "לַ֤יְלָה", "transliteral": "lay-lā", "traducao_palavra": "De noite" },
        { "hebraico": "וְיֹומָם֙", "transliteral": "wə-yô-mām", "traducao_palavra": "e de dia" },
