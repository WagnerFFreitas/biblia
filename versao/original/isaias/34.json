        { "hebraico": "וְקִפֹּ֔וד", "transliteral": "wə-qip-pôḏ", "traducao_palavra": "e o ouriço/bittern" },
        { "hebraico": "וְיַנְשֹׁ֥וף", "transliteral": "wə-yan-šôp̄", "traducao_palavra": "e o mocho/bufo" },
