    "17": {
      "traducao_completa": "E ele mesmo lançou as sortes por eles, e a sua mão lhes repartiu a terra com a corda; para sempre a possuirão, de geração em geração habitarão nela.",
      "palavras": [
        { "hebraico": "וְהֽוּא־הִפִּ֧יל", "transliteral": "wə-hû-hip-pîl", "traducao_palavra": "E ele lançou" },
        { "hebraico": "לָהֶ֛ן", "transliteral": "lā-hen", "traducao_palavra": "para elas" },
        { "hebraico": "גֹורָ֖ל", "transliteral": "ḡô-rāl", "traducao_palavra": "[a] sorte" },
        { "hebraico": "וְיָדֹ֛ו", "transliteral": "wə-yā-ḏô", "traducao_palavra": "e sua mão" },
