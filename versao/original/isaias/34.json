        { "hebraico": "בֹֽהוּ׃", "transliteral": "ḇō-hû", "traducao_palavra": "vazio/vacuidade" }
      ]
    },
    "12": {
      "traducao_completa": "Eles chamarão os seus nobres para o reino, mas nenhum haverá ali; e todos os seus príncipes não serão nada.",
      "palavras": [
        { "hebraico": "חֹרֶיהָ", "transliteral": "ḥō-re-y-hā", "traducao_palavra": "Seus nobres" },
        { "hebraico": "וְאֵין־שָׁ֖ם", "transliteral": "wə-ʾên-šām", "traducao_palavra": "e não há ali" },
        { "hebraico": "מְלוּכָ֣ה", "transliteral": "mə-lû-ḵā", "traducao_palavra": "reino [para]" },
        { "hebraico": "יִקְרָ֑אוּ", "transliteral": "yiq-rā-ʾû", "traducao_palavra": "[que] chamem" },
        { "hebraico": "וְכָל־שָׂרֶ֖יהָ", "transliteral": "wə-ḵāl-śā-re-y-hā", "traducao_palavra": "e todos os seus príncipes" },
