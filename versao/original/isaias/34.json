        { "hebraico": "קִפֹּוז֙", "transliteral": "qip-pôz", "traducao_palavra": "[a] serpente veloz" },
        { "hebraico": "וַתְּמַלֵּ֔ט", "transliteral": "wat-tə-mal-lêṭ", "traducao_palavra": "e porá/escapará" },
        { "hebraico": "וּבָקְעָ֖ה", "transliteral": "ū-ḇā-qə-ʿā", "traducao_palavra": "e chocará/rachará ovos" },
        { "hebraico": "וְדָגְרָ֣ה", "transliteral": "wə-ḏā-ḡə-rā", "traducao_palavra": "e reunirá" },
        { "hebraico": "בְצִלָּ֑הּ", "transliteral": "ḇə-ṣil-lāh", "traducao_palavra": "na sua sombra" },
        { "hebraico": "אַךְ־שָׁם֙", "transliteral": "ʾaḵ-šām", "traducao_palavra": "ali certamente" },
        { "hebraico": "נִקְבְּצ֣וּ", "transliteral": "niq-bə-ṣû", "traducao_palavra": "se ajuntarão" },
        { "hebraico": "דַיֹּ֔ות", "transliteral": "day-yôṯ", "traducao_palavra": "[os] milhafres/abutres" },
        { "hebraico": "אִשָּׁ֥ה", "transliteral": "ʾiš-šā", "traducao_palavra": "cada uma" },
        { "hebraico": "אֶל־רְעוּתָֽהּ׃", "transliteral": "ʾel-rə-ʿû-ṯāh", "traducao_palavra": "com a sua companheira" }
