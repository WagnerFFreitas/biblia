    "14": {
      "traducao_completa": "E as feras do deserto se encontrarão com as hienas, e o sátiro clamará ao seu companheiro; e a Lilite ali repousará, e achará para si lugar de descanso.",
      "palavras": [
        { "hebraico": "וּפָגְשׁ֤וּ", "transliteral": "ū-p̄ā-ḡə-šû", "traducao_palavra": "E se encontrarão" },
        { "hebraico": "צִיִּים֙", "transliteral": "ṣi-yîm", "traducao_palavra": "feras do deserto" },
        { "hebraico": "אֶת־אִיִּ֔ים", "transliteral": "ʾeṯ-ʾiy-yîm", "traducao_palavra": "com hienas/feras" },
        { "hebraico": "וְשָׂעִ֖יר", "transliteral": "wə-śā-ʿîr", "traducao_palavra": "e o sátiro/bode selvagem" },
        { "hebraico": "עַל־רֵעֵ֣הוּ", "transliteral": "ʿal-rê-ʿê-hû", "traducao_palavra": "ao seu companheiro" },
        { "hebraico": "יִקְרָ֑א", "transliteral": "yiq-rā", "traducao_palavra": "clamará" },
        { "hebraico": "אַךְ־שָׁם֙", "transliteral": "ʾaḵ-šām", "traducao_palavra": "ali certamente" },
        { "hebraico": "הִרְגִּ֣יעָה", "transliteral": "hir-gî-ʿā", "traducao_palavra": "repousará" },
        { "hebraico": "לִּילִ֔ית", "transliteral": "lî-lîṯ", "traducao_palavra": "a Lilite/criatura noturna" },
        { "hebraico": "וּמָצְאָ֥ה", "transliteral": "ū-mā-ṣə-ʾā", "traducao_palavra": "e achará" },
        { "hebraico": "לָ֖הּ", "transliteral": "lāh", "traducao_palavra": "para si" },
        { "hebraico": "מָנֹֽוחַ׃", "transliteral": "mā-nô-aḥ", "traducao_palavra": "[um] lugar de repouso" }
