        { "hebraico": "קֶ֤צֶף", "transliteral": "qe-ṣep̄", "traducao_palavra": "[a] indignação/ira" },
        { "hebraico": "לַיהוָה֙", "transliteral": "la-YHWH", "traducao_palavra": "de YHWH [está]" },
        { "hebraico": "עַל־כָּל־", "transliteral": "ʿal-kāl-", "traducao_palavra": "sobre todas" },
        { "hebraico": "הַגֹּויִ֔ם", "transliteral": "hag-gô-yim", "traducao_palavra": "as nações" },
        { "hebraico": "וְחֵמָ֖ה", "transliteral": "wə-ḥê-mā", "traducao_palavra": "e [o] furor" },
        { "hebraico": "עַל־כָּל־", "transliteral": "ʿal-kāl-", "traducao_palavra": "sobre todo" },
        { "hebraico": "צְבָאָ֑ם", "transliteral": "ṣə-ḇā-ʾām", "traducao_palavra": "exército delas" },
