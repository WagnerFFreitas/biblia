    "5": {
      "traducao_completa": "Porque a minha espada se embriagou no céu; eis que sobre Edom descerá, e sobre o povo do meu anátema, para exercer juízo.",
      "palavras": [
        { "hebraico": "כִּֽי־רִוְּתָ֥ה", "transliteral": "kî-riw-wə-ṯā", "traducao_palavra": "Pois se embriagou" },
