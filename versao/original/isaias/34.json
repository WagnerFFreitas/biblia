        { "hebraico": "וְכָל־", "transliteral": "wə-ḵāl-", "traducao_palavra": "e tudo" },
        { "hebraico": "צֶאֱצָאֶֽיהָ׃", "transliteral": "ṣe-ʾĕ-ṣā-ʾe-hā", "traducao_palavra": "[o que] brota dela" }
      ]
    },
    "2": {
      "traducao_completa": "Porque a indignação de YHWH está sobre todas as nações, e o seu furor sobre todo o exército delas; ele as destinou à destruição, entregou-as à matança.",
