    "4": {
      "traducao_completa": "E todo o exército dos céus se dissolverá, e os céus se enrolarão como um livro; e todo o seu exército cairá, como cai a folha da vide e como cai o figo da figueira.",
      "palavras": [
        { "hebraico": "וְנָמַ֨קּוּ֙", "transliteral": "wə-nā-maq-qû", "traducao_palavra": "E se dissolverão/apodrecerão" },
