        { "hebraico": "מֵֽעַל־סֵ֤פֶר", "transliteral": "mê-ʿal-śê-p̄er", "traducao_palavra": "no livro de" },
        { "hebraico": "יְהוָה֙", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "וּֽקְרָ֔אוּ", "transliteral": "ū-qə-rā-ʾû", "traducao_palavra": "e lede" },
        { "hebraico": "אַחַ֥ת", "transliteral": "ʾa-ḥaṯ", "traducao_palavra": "nenhuma" },
        { "hebraico": "מֵהֵ֖נָּה", "transliteral": "mê-hên-nā", "traducao_palavra": "destas" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "נֶעְדָּ֑רָה", "transliteral": "ne-ʿə-dā-rā", "traducao_palavra": "faltará" },
        { "hebraico": "אִשָּׁ֤ה", "transliteral": "ʾiš-šā", "traducao_palavra": "cada uma" },
        { "hebraico": "רְעוּתָהּ֙", "transliteral": "rə-ʿû-ṯāh", "traducao_palavra": "[com] sua companheira" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "פָקָ֔דוּ", "transliteral": "p̄ā-qā-ḏû", "traducao_palavra": "sentirá falta" },
        { "hebraico": "כִּי־פִי֙", "transliteral": "kî-p̄î", "traducao_palavra": "porque minha boca" },
