        { "hebraico": "הֵילִ֕ילוּ", "transliteral": "hê-lî-lû", "traducao_palavra": "uivai" },
        { "hebraico": "יֹ֥שְׁבֵי", "transliteral": "yō-šə-ḇê", "traducao_palavra": "moradores de" },
        { "hebraico": "אִֽי׃", "transliteral": "ʾî", "traducao_palavra": "ilha/costa" }
      ]
    },
    "7": {
      "traducao_completa": "É esta a vossa cidade alegre, cuja origem é dos dias antigos? Os seus próprios pés a levarão para longe a peregrinar.",
