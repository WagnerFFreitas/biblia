  "versiculos": {
    "1": {
      "traducao_completa": "Oráculo contra Tiro: Uivai, navios de Társis, porque ela está assolada, a ponto de não haver nela casa nem entrada; desde a terra de Quitim lhes foi isto revelado.",
      "palavras": [
