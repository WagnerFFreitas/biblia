        { "hebraico": "לָכֶ֖ם", "transliteral": "lā-ḵem", "traducao_palavra": "para vós/vossa" },
        { "hebraico": "עַלִּיזָ֑ה", "transliteral": "ʿal-lî-zā", "traducao_palavra": "[cidade] alegre" },
        { "hebraico": "מִימֵי־קֶ֣דֶם", "transliteral": "mî-mê-qe-ḏem", "traducao_palavra": "desde os dias de outrora" },
