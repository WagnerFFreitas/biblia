        { "hebraico": "צֹ֑ר", "transliteral": "ṣōr", "traducao_palavra": "Tiro" },
        { "hebraico": "הֵילִ֣ילוּ ׀", "transliteral": "hê-lî-lû", "traducao_palavra": "uivai" },
        { "hebraico": "אֳנִיֹּ֣ות", "transliteral": "ʾo-nî-yôṯ", "traducao_palavra": "navios de" },
        { "hebraico": "תַּרְשִׁ֗ישׁ", "transliteral": "tar-šîš", "traducao_palavra": "Társis" },
        { "hebraico": "כִּֽי־שֻׁדַּ֤ד", "transliteral": "kî-šud-daḏ", "traducao_palavra": "porque foi assolada" },
