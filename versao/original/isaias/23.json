        { "hebraico": "מָעֻזְנֶֽיהָ׃", "transliteral": "mā-ʿuz-ne-y-hā", "traducao_palavra": "fortalezas dela" }
      ]
    },
    "12": {
      "traducao_completa": "E disse: Nunca mais exultarás, ó oprimida virgem, filha de Sidom; levanta-te, passa a Quitim, e ainda ali não terás descanso.",
      "palavras": [
        { "hebraico": "וַיֹּ֕אמֶר", "transliteral": "way-yō-mer", "traducao_palavra": "E disse" },
        { "hebraico": "לֹֽא־תֹוסִ֥יפִי", "transliteral": "lō-ṯô-śî-p̄î", "traducao_palavra": "não tornarás a" },
        { "hebraico": "עֹ֖וד", "transliteral": "ʿôḏ", "traducao_palavra": "mais" },
        { "hebraico": "לַעְלֹ֑וז", "transliteral": "la-ʿă-lôz", "traducao_palavra": "exultar" },
