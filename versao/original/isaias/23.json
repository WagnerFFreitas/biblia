        { "hebraico": "בְּתוּלַ֣ת", "transliteral": "bə-ṯû-laṯ", "traducao_palavra": "virgem" },
        { "hebraico": "בַּת־צִידֹ֔ון", "transliteral": "baṯ-ṣî-ḏôn", "traducao_palavra": "filha de Sidom" },
        { "hebraico": "כִּתִּ֥ים", "transliteral": "kit-tîm", "traducao_palavra": "Quitim [Chipre]" },
        { "hebraico": "קוּמִ֣י", "transliteral": "qû-mî", "traducao_palavra": "levanta-te" },
        { "hebraico": "עִבְרִ֔י", "transliteral": "ʿiḇ-rî", "traducao_palavra": "passa/cruza" },
        { "hebraico": "גַּם־שָׁ֖ם", "transliteral": "gam-šām", "traducao_palavra": "também lá" },
        { "hebraico": "לֹא־יָנ֥וּחַ", "transliteral": "lō-yā-nû-aḥ", "traducao_palavra": "não descansará" },
