        { "hebraico": "יְסָדָ֣הּ", "transliteral": "yə-śā-ḏāh", "traducao_palavra": "fundou-a" },
        { "hebraico": "לְצִיִּ֑ים", "transliteral": "lə-ṣi-yîm", "traducao_palavra": "para habitantes do deserto" },
        { "hebraico": "הֵקִ֤ימוּ", "transliteral": "hê-qî-mû", "traducao_palavra": "levantaram" },
        { "hebraico": "בחוניו", "transliteral": "ḇa-ḥû-nāyw", "traducao_palavra": "as suas torres de vigia" },
