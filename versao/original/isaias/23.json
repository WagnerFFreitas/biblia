        { "hebraico": "זֶ֤רַע", "transliteral": "ze-raʿ", "traducao_palavra": "[vinha a] semente de" },
        { "hebraico": "שִׁחֹר֙", "transliteral": "ši-ḥôr", "traducao_palavra": "Sior [braço do Nilo]" },
