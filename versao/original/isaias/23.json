        { "hebraico": "סְחַ֥ר", "transliteral": "śə-ḥar", "traducao_palavra": "[o] mercado/feira de" },
        { "hebraico": "גֹּויִֽם׃", "transliteral": "gô-yim", "traducao_palavra": "nações" }
      ]
    },
    "4": {
      "traducao_completa": "Envergonha-te, ó Sidom, porque o mar, a fortaleza do mar, fala, dizendo: Eu não tive dores de parto, nem dei à luz, nem criei jovens, nem eduquei virgens.",
      "palavras": [
        { "hebraico": "בֹּ֣ושִׁי", "transliteral": "bô-šî", "traducao_palavra": "Envergonha-te" },
        { "hebraico": "צִידֹ֗ון", "transliteral": "ṣî-ḏôn", "traducao_palavra": "ó Sidom" },
        { "hebraico": "כִּֽי־אָמַ֣ר", "transliteral": "kî-ʾā-mar", "traducao_palavra": "porque disse" },
        { "hebraico": "יָם֮", "transliteral": "yām", "traducao_palavra": "[o] mar" },
        { "hebraico": "מָעֹ֣oz", "transliteral": "mā-ʿôz", "traducao_palavra": "[a] fortaleza de" },
        { "hebraico": "הַיָּם֮", "transliteral": "hay-yām", "traducao_palavra": "o mar" },
        { "hebraico": "לֵאמֹר֒", "transliteral": "lê-mōr", "traducao_palavra": "dizendo" },
        { "hebraico": "לֹא־חַ֣לְתִּי", "transliteral": "lō-ḥal-tî", "traducao_palavra": "não tive dores de parto" },
        { "hebraico": "וְלֹא־יָלַ֔דְתִּי", "transliteral": "wə-lō-yā-laḏ-tî", "traducao_palavra": "e não dei à luz" },
        { "hebraico": "וְלֹ֥א", "transliteral": "wə-lō", "traducao_palavra": "nem" },
        { "hebraico": "גִדַּ֥לְתִּי", "transliteral": "ḡid-dal-tî", "traducao_palavra": "criei" },
        { "hebraico": "בַחוּרִ֖ים", "transliteral": "ba-ḥû-rîm", "traducao_palavra": "jovens" },
        { "hebraico": "רֹומַ֥מְתִּי", "transliteral": "rô-mam-tî", "traducao_palavra": "[nem] exaltei/eduquei" },
        { "hebraico": "בְתוּלֹֽות׃", "transliteral": "ḇə-ṯû-lôṯ", "traducao_palavra": "virgens" }
      ]
    },
    "5": {
      "traducao_completa": "Como quando se ouviram as novas do Egito, assim haverá dores quando se ouvirem as de Tiro.",
      "palavras": [
        { "hebraico": "כַּאֲשֶׁר־שֵׁ֖מַע", "transliteral": "ka-ʾă-šer-šê-maʿ", "traducao_palavra": "Como ao [ouvir] a notícia de" },
        { "hebraico": "לְמִצְרָ֑יִם", "transliteral": "lə-miṣ-rā-yim", "traducao_palavra": "Egito" },
        { "hebraico": "יָחִ֕ילוּ", "transliteral": "yā-ḥî-lû", "traducao_palavra": "sentirão dores/contorcer-se-ão" },
        { "hebraico": "כְּשֵׁ֖מַע", "transliteral": "kə-šê-maʿ", "traducao_palavra": "como na notícia de" },
