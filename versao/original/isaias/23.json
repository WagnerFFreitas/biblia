        { "hebraico": "מִבֹּ֔וא", "transliteral": "mib-bô", "traducao_palavra": "sem entrada" },
        { "hebraico": "מֵאֶ֥רֶץ", "transliteral": "mê-ʾe-reṣ", "traducao_palavra": "da terra de" },
        { "hebraico": "כִּתִּ֖ים", "transliteral": "kit-tîm", "traducao_palavra": "Quitim [Chipre]" },
        { "hebraico": "נִגְלָה־לָֽמֹו׃", "transliteral": "nig-lā-lā-mô", "traducao_palavra": "foi revelado a eles" }
      ]
    },
    "2": {
      "traducao_completa": "Calai-vos, moradores da costa, vós a quem os mercadores de Sidom, navegando pelo mar, enchiam.",
      "palavras": [
        { "hebraico": "דֹּ֕מּוּ", "transliteral": "dōm-mû", "traducao_palavra": "Calai-vos/emudecerei" },
        { "hebraico": "יֹ֥שְׁבֵי", "transliteral": "yō-šə-ḇê", "traducao_palavra": "moradores de" },
        { "hebraico": "אִ֑י", "transliteral": "ʾî", "traducao_palavra": "ilha/costa" },
        { "hebraico": "סֹחֵ֥ר", "transliteral": "sō-ḥêr", "traducao_palavra": "[os] mercadores de" },
        { "hebraico": "צִידֹ֛ון", "transliteral": "ṣî-ḏôn", "traducao_palavra": "Sidom" },
        { "hebraico": "עֹבֵ֥ר", "transliteral": "ʿō-ḇêr", "traducao_palavra": "atravessando" },
        { "hebraico": "יָ֖ם", "transliteral": "yām", "traducao_palavra": "[o] mar" },
        { "hebraico": "מִלְאֽוּךְ׃", "transliteral": "mil-ʾû-ḵ", "traducao_palavra": "encheram a ti" }
      ]
    },
    "3": {
      "traducao_completa": "E a sua renda vinha sobre as grandes águas, com a semente de Sior e a ceifa do Nilo, e ela era a feira das nações.",
