        { "hebraico": "נָטָ֣ה", "transliteral": "nā-ṭā", "traducao_palavra": "estendeu" },
        { "hebraico": "עַל־הַיָּ֗ם", "transliteral": "ʿal-hay-yām", "traducao_palavra": "sobre o mar" },
        { "hebraico": "הִרְגִּ֥יז", "transliteral": "hir-gîz", "traducao_palavra": "fez tremer" },
        { "hebraico": "מַמְלָכֹ֑ות", "transliteral": "mam-lā-ḵôṯ", "traducao_palavra": "reinos" },
