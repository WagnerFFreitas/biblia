        { "hebraico": "לְהָקֵ֖ל", "transliteral": "lə-hā-qêl", "traducao_palavra": "para envilecer/tratar levemente" },
        { "hebraico": "כָּל־נִכְבַּדֵּי־אָֽרֶץ׃", "transliteral": "kāl-niḵ-bad-dê-ʾā-reṣ", "traducao_palavra": "todos os nobres da terra" }
      ]
    },
    "10": {
      "traducao_completa": "Passa pela tua terra, como o Nilo, ó filha de Társis; já não há cinto que te cinja.",
      "palavras": [
        { "hebraico": "עִבְרִ֥י", "transliteral": "ʿiḇ-rî", "traducao_palavra": "Passa" },
