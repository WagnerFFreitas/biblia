        { "hebraico": "צִוָּ֣ה", "transliteral": "ṣiw-wā", "traducao_palavra": "ordenou" },
        { "hebraico": "אֶל־כְּנַ֔עַן", "transliteral": "ʾel-kə-na-ʿan", "traducao_palavra": "contra Canaã/Fenícia" },
