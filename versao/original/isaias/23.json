      ]
    },
    "8": {
      "traducao_completa": "Quem determinou isto contra Tiro, a cidade coroada, cujos mercadores são príncipes e cujos negociantes são os mais nobres da terra?",
      "palavras": [
        { "hebraico": "מִ֚י", "transliteral": "mî", "traducao_palavra": "Quem" },
        { "hebraico": "יָעַ֣ץ", "transliteral": "yā-ʿaṣ", "traducao_palavra": "aconselhou/determinou" },
        { "hebraico": "זֹ֔את", "transliteral": "zōṯ", "traducao_palavra": "isto" },
        { "hebraico": "עַל־צֹ֖ר", "transliteral": "ʿal-ṣōr", "traducao_palavra": "contra Tiro" },
        { "hebraico": "הַמַּעֲטִירָ֑ה", "transliteral": "ha-ma-ʿă-ṭî-rā", "traducao_palavra": "a que distribui coroas" },
        { "hebraico": "אֲשֶׁ֤ר", "transliteral": "ʾă-šer", "traducao_palavra": "cujos" },
        { "hebraico": "סֹחֲרֶ֨יהָ֙", "transliteral": "śō-ḥă-re-hā", "traducao_palavra": "mercadores dela" },
