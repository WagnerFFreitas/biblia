      ]
    },
    "9": {
      "traducao_completa": "YHWH dos Exércitos o determinou, para abater a soberba de toda a glória, e para envilecer os mais nobres da terra.",
      "palavras": [
        { "hebraico": "יְהוָ֥ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "צְבָאֹ֖ות", "transliteral": "ṣə-ḇā-ʾôṯ", "traducao_palavra": "[dos] Exércitos" },
        { "hebraico": "יְעָצָ֑הּ", "transliteral": "yə-ʿā-ṣāh", "traducao_palavra": "aconselhou/determinou" },
