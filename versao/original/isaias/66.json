        { "hebraico": "עֲבָדָ֖יו", "transliteral": "ʿă-ḇā-ḏāy-w", "traducao_palavra": "seus servos" },
        { "hebraico": "וְזָעַ֥ם", "transliteral": "wə-zā-ʿam", "traducao_palavra": "e ele se indignará" },
