      ]
    },
    "18": {
      "traducao_completa": "Porque eu conheço as suas obras e os seus pensamentos; vem o tempo em que ajuntarei todas as nações e línguas; e virão e verão a minha glória.",
      "palavras": [
        { "hebraico": "וְאָנֹכִ֗י", "transliteral": "wə-ʾā-nō-ḵî", "traducao_palavra": "E eu" },
        { "hebraico": "מַעֲשֵׂיהֶם֙", "transliteral": "ma-ʿă-śê-hem", "traducao_palavra": "[conheço] as obras deles" },
