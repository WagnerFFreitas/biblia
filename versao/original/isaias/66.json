        { "hebraico": "כָּל־", "transliteral": "kāl-", "traducao_palavra": "todos" },
        { "hebraico": "הַמִּֽתְאַבְּלִ֖ים", "transliteral": "ham-miṯ-ʾab-bə-lîm", "traducao_palavra": "[os que] pranteiam" },
