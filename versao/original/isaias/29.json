        { "hebraico": "לַסְתִּ֣ר", "transliteral": "las-tir", "traducao_palavra": "para esconder" },
        { "hebraico": "עֵצָ֑ה", "transliteral": "ʿê-ṣā", "traducao_palavra": "[o] conselho" },
        { "hebraico": "וְהָיָ֤ה", "transliteral": "wə-hā-yā", "traducao_palavra": "e são" },
        { "hebraico": "בְמַחְשָׁךְ֙", "transliteral": "ḇə-maḥ-šāk", "traducao_palavra": "na escuridão" },
