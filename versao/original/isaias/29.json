        { "hebraico": "חָת֖וּם", "transliteral": "ḥā-ṯûm", "traducao_palavra": "selado" },
        { "hebraico": "הֽוּא׃", "transliteral": "hû", "traducao_palavra": "[está] ele" }
      ]
    },
    "12": {
