        { "hebraico": "לְפֶ֥תַע", "transliteral": "lə-p̄e-ṯaʿ", "traducao_palavra": "de repente" },
        { "hebraico": "פִּתְאֹֽם׃", "transliteral": "piṯ-ʾōm", "traducao_palavra": "num instante" }
