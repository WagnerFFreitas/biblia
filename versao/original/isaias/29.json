{
  "livro": "Isaías - יְשַׁעְיָהוּ - Yeshayahu",
  "capítulo": 29,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Ai de Ariel, de Ariel, a cidade onde Davi acampou! Acrescentai ano a ano; deixai que as festas completem o seu ciclo.",
      "palavras": [
        { "hebraico": "הֹ֥וי", "transliteral": "hôy", "traducao_palavra": "Ai" },
        { "hebraico": "אֲרִיאֵ֧ל", "transliteral": "ʾă-rî-ʾēl", "traducao_palavra": "Ariel" },
        { "hebraico": "אֲרִיאֵ֛ל", "transliteral": "ʾă-rî-ʾēl", "traducao_palavra": "Ariel" },
        { "hebraico": "קִרְיַ֖ת", "transliteral": "qir-yaṯ", "traducao_palavra": "cidade [onde]" },
        { "hebraico": "חָנָ֣ה", "transliteral": "ḥā-nā", "traducao_palavra": "acampou" },
        { "hebraico": "דָוִ֑ד", "transliteral": "dā-wiḏ", "traducao_palavra": "Davi" },
        { "hebraico": "סְפ֥וּ", "transliteral": "śə-p̄û", "traducao_palavra": "acrescentai" },
        { "hebraico": "שָׁנָ֖ה", "transliteral": "šā-nā", "traducao_palavra": "ano" },
        { "hebraico": "עַל־שָׁנָ֥ה", "transliteral": "ʿal-šā-nā", "traducao_palavra": "sobre ano" },
        { "hebraico": "חַגִּ֖ים", "transliteral": "ḥag-gîm", "traducao_palavra": "[as] festas" },
        { "hebraico": "יִנְקֹֽפוּ׃", "transliteral": "yin-qō-p̄û", "traducao_palavra": "completem o ciclo/rodem" }
      ]
    },
    "2": {
      "traducao_completa": "Contudo porei Ariel em aperto, e haverá pranto e tristeza; e ela será para mim como Ariel.",
      "palavras": [
        { "hebraico": "וַהֲצִיקֹותִי֙", "transliteral": "wa-hă-ṣî-qô-ṯî", "traducao_palavra": "E porei em aperto/angustiarei" },
        { "hebraico": "לַאֲרִיאֵ֔ל", "transliteral": "la-ʾă-rî-ʾēl", "traducao_palavra": "a Ariel" },
        { "hebraico": "וְהָיְתָ֥ה", "transliteral": "wə-hā-yə-ṯā", "traducao_palavra": "e haverá" },
        { "hebraico": "תַאֲנִיָּ֖ה", "transliteral": "ṯa-ʾă-nî-yā", "traducao_palavra": "lamento/pranto" },
        { "hebraico": "וַאֲנִיָּ֑ה", "transliteral": "wa-ʾă-nî-yā", "traducao_palavra": "e tristeza" },
        { "hebraico": "וְהָ֥יְתָה", "transliteral": "wə-hā-yə-ṯā", "traducao_palavra": "e ela será" },
        { "hebraico": "לִּ֖י", "transliteral": "lî", "traducao_palavra": "para mim" },
        { "hebraico": "כַּאֲרִיאֵֽל׃", "transliteral": "ka-ʾă-rî-ʾēl", "traducao_palavra": "como Ariel [altar/leão de Deus]" }
      ]
    },
    "3": {
      "traducao_completa": "E acamparei contra ti em redor, e te cercarei com baluartes, e levantarei trincheiras contra ti.",
      "palavras": [
        { "hebraico": "וְחָנִ֥יתִי", "transliteral": "wə-ḥā-nî-ṯî", "traducao_palavra": "E acamparei" },
        { "hebraico": "כַדּ֖וּר", "transliteral": "ḵad-dûr", "traducao_palavra": "como um círculo/em redor" },
        { "hebraico": "עָלָ֑יִךְ", "transliteral": "ʿā-lā-yiḵ", "traducao_palavra": "contra ti" },
        { "hebraico": "וְצַרְתִּ֥י", "transliteral": "wə-ṣar-tî", "traducao_palavra": "e cercarei" },
        { "hebraico": "עָלַ֖יִךְ", "transliteral": "ʿā-la-yiḵ", "traducao_palavra": "contra ti" },
        { "hebraico": "מֻצָּ֑ב", "transliteral": "muṣ-ṣāḇ", "traducao_palavra": "[com] baluartes/postos" },
        { "hebraico": "וַהֲקִימֹתִ֥י", "transliteral": "wa-hă-qî-mō-ṯî", "traducao_palavra": "e levantarei" },
        { "hebraico": "עָלַ֖יִךְ", "transliteral": "ʿā-la-yiḵ", "traducao_palavra": "contra ti" },
        { "hebraico": "מִצְרֹֽת׃", "transliteral": "mi-ṣə-rōṯ", "traducao_palavra": "trincheiras/obras de cerco" }
      ]
    },
    "4": {
      "traducao_completa": "Então serás abatida, falarás debaixo da terra, e a tua fala sairá humildemente do pó; e será a tua voz debaixo da terra, como a de um necromante, e a tua fala sussurrará desde o pó.",
      "palavras": [
        { "hebraico": "וְשָׁפַ֣לְתְּ", "transliteral": "wə-šā-p̄alt", "traducao_palavra": "E serás abatida" },
        { "hebraico": "מֵאֶ֣רֶץ", "transliteral": "mê-ʾe-reṣ", "traducao_palavra": "da terra" },
        { "hebraico": "תְּדַבֵּ֔רִי", "transliteral": "tə-ḏab-bê-rî", "traducao_palavra": "falarás" },
        { "hebraico": "וּמֵעָפָ֖ר", "transliteral": "ū-mê-ʿā-p̄ār", "traducao_palavra": "e do pó" },
        { "hebraico": "תִּשַּׁ֣ח", "transliteral": "tiš-šaḥ", "traducao_palavra": "será baixa/humilde" },
        { "hebraico": "אִמְרָתֵ֑ךְ", "transliteral": "ʾim-rā-ṯêḵ", "traducao_palavra": "tua fala" },
        { "hebraico": "וְהָיָ֤ה", "transliteral": "wə-hā-yā", "traducao_palavra": "e será" },
        { "hebraico": "כְּאֹוב֙", "transliteral": "kə-ʾôḇ", "traducao_palavra": "como um necromante" },
        { "hebraico": "מֵאֶ֣רֶץ", "transliteral": "mê-ʾe-reṣ", "traducao_palavra": "da terra" },
        { "hebraico": "קֹולֵ֔ךְ", "transliteral": "qô-lêḵ", "traducao_palavra": "tua voz" },
        { "hebraico": "וּמֵֽעָפָ֖ר", "transliteral": "ū-mê-ʿā-p̄ār", "traducao_palavra": "e do pó" },
        { "hebraico": "אִמְרָתֵ֥ךְ", "transliteral": "ʾim-rā-ṯêḵ", "traducao_palavra": "tua fala" },
        { "hebraico": "תְּצַפְצֵֽף׃", "transliteral": "tə-ṣap̄-ṣêp̄", "traducao_palavra": "chilreará/sussurrará" }
      ]
    },
    "5": {
      "traducao_completa": "E a multidão dos teus inimigos será como o pó miúdo, e a multidão dos tiranos como a moinha que voa; e isso acontecerá num momento, de repente.",
      "palavras": [
        { "hebraico": "וְהָיָה֙", "transliteral": "wə-hā-yā", "traducao_palavra": "E será" },
        { "hebraico": "כְּאָבָ֣ק", "transliteral": "kə-ʾā-ḇāq", "traducao_palavra": "como pó" },
        { "hebraico": "דַּ֔ק", "transliteral": "daq", "traducao_palavra": "miúdo/fino" },
        { "hebraico": "הֲמֹ֣ון", "transliteral": "hă-môn", "traducao_palavra": "[a] multidão de" },
        { "hebraico": "זָרָ֑יִךְ", "transliteral": "zā-ra-yiḵ", "traducao_palavra": "teus estrangeiros/inimigos" },
        { "hebraico": "וּכְמֹ֥ץ", "transliteral": "ū-ḵə-mōṣ", "traducao_palavra": "e como palha" },
        { "hebraico": "עֹבֵ֖ר", "transliteral": "ʿō-ḇêr", "traducao_palavra": "que passa" },
        { "hebraico": "הֲמֹ֣ון", "transliteral": "hă-môn", "traducao_palavra": "[a] multidão de" },
        { "hebraico": "עָרִיצִ֑ים", "transliteral": "ʿā-rî-ṣîm", "traducao_palavra": "tiranos/violentos" },
