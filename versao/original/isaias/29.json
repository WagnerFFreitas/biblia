    },
    "16": {
      "traducao_completa": "Vossa perversidade! Acaso o oleiro será considerado como o barro, de sorte que a obra diga do seu artífice: Não me fez; e o vaso diga do seu oleiro: Não tem entendimento?",
      "palavras": [
        { "hebraico": "הַפְכְּכֶ֕ם", "transliteral": "hap̄-kə-ḵem", "traducao_palavra": "Vossa perversão/transtorno" },
        { "hebraico": "אִם־כְּחֹ֥מֶר", "transliteral": "ʾim-kə-ḥō-mer", "traducao_palavra": "acaso como barro" },
        { "hebraico": "הַיֹּצֵ֖ר", "transliteral": "hay-yō-ṣêr", "traducao_palavra": "o oleiro" },
        { "hebraico": "יֵחָשֵׁ֑ב", "transliteral": "yê-ḥā-šêḇ", "traducao_palavra": "será considerado?" },
