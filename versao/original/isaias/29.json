        { "hebraico": "וַיֹּ֣אמְר֔וּ", "transliteral": "way-yō-mərû", "traducao_palavra": "e dizem" },
        { "hebraico": "מִ֥י", "transliteral": "mî", "traducao_palavra": "quem" },
        { "hebraico": "רֹאֵ֖נוּ", "transliteral": "rō-ʾê-nû", "traducao_palavra": "vê a nós?" },
        { "hebraico": "וּמִ֥י", "transliteral": "ū-mî", "traducao_palavra": "e quem" },
        { "hebraico": "יֹודְעֵֽנוּ׃", "transliteral": "yô-ḏə-ʿê-nû", "traducao_palavra": "conhece a nós?" }
