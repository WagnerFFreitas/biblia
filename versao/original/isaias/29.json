    "9": {
      "traducao_completa": "Pasmai e maravilhai-vos, cegai-vos e ficai cegos; ébrios estão, mas não de vinho; cambaleiam, mas não de bebida forte.",
      "palavras": [
        { "hebraico": "הִתְמַהְמְה֥וּ", "transliteral": "hiṯ-mah-mə-hû", "traducao_palavra": "Pasmai/atrasai-vos" },
        { "hebraico": "וּתְמָ֖הוּ", "transliteral": "ū-ṯə-mā-hû", "traducao_palavra": "e maravilhai-vos" },
        { "hebraico": "הִשְׁתַּֽעַשְׁע֖וּ", "transliteral": "hiš-ta-ʿaš-ʿû", "traducao_palavra": "cegai-vos/deleitem-vos" },
        { "hebraico": "וָשֹׁ֑עוּ", "transliteral": "wā-šō-ʿû", "traducao_palavra": "e ficai cegos" },
        { "hebraico": "שָׁכְר֥וּ", "transliteral": "šā-ḵə-rû", "traducao_palavra": "embriagaram-se" },
        { "hebraico": "וְלֹא־יַ֔יִן", "transliteral": "wə-lō-ya-yin", "traducao_palavra": "mas não de vinho" },
        { "hebraico": "נָע֭וּ", "transliteral": "nā-ʿû", "traducao_palavra": "cambalearam" },
