    "10": {
      "traducao_completa": "Porque YHWH derramou sobre vós um espírito de profundo sono, e fechou os vossos olhos, os profetas; e vendou as vossas cabeças, os videntes.",
      "palavras": [
        { "hebraico": "כִּֽי־נָסַ֨ךְ", "transliteral": "kî-nā-saḵ", "traducao_palavra": "Porque derramou" },
        { "hebraico": "עֲלֵיכֶ֤ם", "transliteral": "ʿă-lê-ḵem", "traducao_palavra": "sobre vós" },
        { "hebraico": "יְהוָה֙", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "ר֣וּחַ", "transliteral": "rû-aḥ", "traducao_palavra": "espírito de" },
        { "hebraico": "תַּרְדֵּמָ֔ה", "transliteral": "tar-dê-mā", "traducao_palavra": "profundo sono" },
        { "hebraico": "וַיְעַצֵּ֖ם", "transliteral": "way-ʿaṣ-ṣêm", "traducao_palavra": "e fechou" },
        { "hebraico": "אֶת־עֵינֵיכֶ֑ם", "transliteral": "ʾeṯ-ʿê-nê-ḵem", "traducao_palavra": "[objeto] os vossos olhos" },
        { "hebraico": "אֶת־הַנְּבִיאִים֙", "transliteral": "ʾeṯ-han-nə-ḇî-ʾîm", "traducao_palavra": "[que são] os profetas" },
        { "hebraico": "וְאֶת־רָאשֵׁיכֶ֥ם", "transliteral": "wə-ʾeṯ-rā-šê-ḵem", "traducao_palavra": "e as vossas cabeças" },
        { "hebraico": "הַחֹזִ֖ים", "transliteral": "ha-ḥō-zîm", "traducao_palavra": "[que são] os videntes" },
