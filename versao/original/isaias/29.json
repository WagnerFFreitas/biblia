        { "hebraico": "חֲכָמָ֔יו", "transliteral": "ḥă-ḵā-māyw", "traducao_palavra": "seus sábios" },
        { "hebraico": "וּבִינַ֥ת", "transliteral": "ū-ḇî-naṯ", "traducao_palavra": "e o entendimento de" },
