    "7": {
      "traducao_completa": "E será como o sonho de uma visão noturna a multidão de todas as nações que pelejarem contra Ariel, sim, todos os que pelejarem contra ela e contra as suas fortalezas, e a puserem em aperto.",
      "palavras": [
        { "hebraico": "וְהָיָ֗ה", "transliteral": "wə-hā-yā", "traducao_palavra": "E será" },
        { "hebraico": "כַּחֲלֹום֙", "transliteral": "ka-ḥă-lôm", "traducao_palavra": "como um sonho" },
        { "hebraico": "חֲזֹ֣ון", "transliteral": "ḥă-zôn", "traducao_palavra": "[de uma] visão" },
        { "hebraico": "לַ֔יְלָה", "transliteral": "lay-lā", "traducao_palavra": "noturna" },
        { "hebraico": "הֲמֹון֙", "transliteral": "hă-môn", "traducao_palavra": "[a] multidão de" },
        { "hebraico": "כָּל־הַגֹּויִ֔ם", "transliteral": "kāl-hag-gô-yim", "traducao_palavra": "todas as nações" },
        { "hebraico": "הַצֹּבְאִ֖ים", "transliteral": "haṣ-ṣō-ḇə-ʾîm", "traducao_palavra": "que guerreiam" },
        { "hebraico": "עַל־אֲרִיאֵ֑ל", "transliteral": "ʿal-ʾă-rî-ʾēl", "traducao_palavra": "contra Ariel" },
        { "hebraico": "וְכָל־צֹבֶ֨יהָ֙", "transliteral": "wə-ḵāl-ṣō-ḇe-y-hā", "traducao_palavra": "e todos os seus guerreiros" },
        { "hebraico": "וּמְצֹדָתָ֔הּ", "transliteral": "ū-mə-ṣō-ḏā-ṯāh", "traducao_palavra": "e sua fortaleza" },
        { "hebraico": "וְהַמְּצִיקִ֖ים", "transliteral": "wə-ham-mə-ṣî-qîm", "traducao_palavra": "e os que a angustiam" },
