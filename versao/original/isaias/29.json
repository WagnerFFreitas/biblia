        { "hebraico": "מַעֲשֶׂ֤ה", "transliteral": "ma-ʿă-śeh", "traducao_palavra": "a obra" },
        { "hebraico": "לְעֹשֵׂ֨הוּ֙", "transliteral": "lə-ʿō-śê-hû", "traducao_palavra": "ao seu fazedor" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "עָשָׂ֔נִי", "transliteral": "ʿā-śā-nî", "traducao_palavra": "fez-me" },
        { "hebraico": "וְיֵ֥צֶר", "transliteral": "wə-yê-ṣer", "traducao_palavra": "e o formado" },
        { "hebraico": "אָמַ֛ר", "transliteral": "ʾā-mar", "traducao_palavra": "dirá" },
        { "hebraico": "לְיֹוצְרֹ֖ו", "transliteral": "lə-yô-ṣə-rô", "traducao_palavra": "ao seu formador" },
        { "hebraico": "לֹ֥א", "transliteral": "lō", "traducao_palavra": "não" },
