        { "hebraico": "הָעָ֣ם", "transliteral": "hā-ʿām", "traducao_palavra": "o povo" },
        { "hebraico": "הַזֶּ֔ה", "transliteral": "haz-zeh", "traducao_palavra": "este" },
        { "hebraico": "בְּפִיו֙", "transliteral": "bə-p̄îw", "traducao_palavra": "com sua boca" },
        { "hebraico": "וּבִשְׂפָתָ֣יו", "transliteral": "ū-ḇiś-p̄ā-ṯāyw", "traducao_palavra": "e com seus lábios" },
        { "hebraico": "כִּבְּד֔וּנִי", "transliteral": "kib-bə-ḏû-nî", "traducao_palavra": "honram-me" },
        { "hebraico": "וְלִבֹּ֖ו", "transliteral": "wə-lib-bô", "traducao_palavra": "mas o seu coração" },
        { "hebraico": "רִחַ֣ק", "transliteral": "ri-ḥaq", "traducao_palavra": "afastou-se" },
        { "hebraico": "מִמֶּ֑נִּי", "transliteral": "mim-men-nî", "traducao_palavra": "de mim" },
        { "hebraico": "וַתְּהִ֤י", "transliteral": "wat-tə-hî", "traducao_palavra": "e tem sido" },
        { "hebraico": "יִרְאָתָם֙", "transliteral": "yir-ʾā-ṯām", "traducao_palavra": "o temor deles" },
        { "hebraico": "אֹתִ֔י", "transliteral": "ʾō-ṯî", "traducao_palavra": "por mim" },
        { "hebraico": "מִצְוַ֥ת", "transliteral": "miṣ-waṯ", "traducao_palavra": "[um] mandamento de" },
        { "hebraico": "אֲנָשִׁ֖ים", "transliteral": "ʾă-nā-šîm", "traducao_palavra": "homens" },
        { "hebraico": "מְלֻמָּדָֽה׃", "transliteral": "mə-lum-mā-ḏā", "traducao_palavra": "aprendido/instruído" }
      ]
    },
    "14": {
      "traducao_completa": "portanto eis que continuarei a fazer uma obra maravilhosa no meio deste povo, uma obra maravilhosa e um prodígio; de sorte que a sabedoria dos seus sábios perecerá, e o entendimento dos seus entendidos se esconderá.",
      "palavras": [
        { "hebraico": "לָכֵ֗ן", "transliteral": "lā-ḵên", "traducao_palavra": "Portanto" },
        { "hebraico": "הִנְנִ֥י", "transliteral": "hin-nə-nî", "traducao_palavra": "eis que eu" },
        { "hebraico": "יֹוסִ֛ף", "transliteral": "yô-sip̄", "traducao_palavra": "continuarei" },
