      ]
    },
    "17": {
      "traducao_completa": "Porventura não falta ainda muito pouco para que o Líbano se converta em campo fértil, e o campo fértil se repute por um bosque?",
      "palavras": [
        { "hebraico": "הֲלֹוא־עֹ֥וד", "transliteral": "hă-lô-ʿôḏ", "traducao_palavra": "Acaso não ainda" },
        { "hebraico": "מְעַ֖ט", "transliteral": "mə-ʿaṭ", "traducao_palavra": "um pouco" },
        { "hebraico": "מִזְעָ֑ר", "transliteral": "miz-ʿār", "traducao_palavra": "muito breve" },
        { "hebraico": "וְשָׁ֤ב", "transliteral": "wə-šāḇ", "traducao_palavra": "e se tornará" },
        { "hebraico": "לְבָנֹון֙", "transliteral": "lə-ḇā-nôn", "traducao_palavra": "o Líbano" },
        { "hebraico": "לַכַּרְמֶ֔ל", "transliteral": "lak-kar-mel", "traducao_palavra": "em campo fértil/pomar" },
        { "hebraico": "וְהַכַּרְמֶ֖ל", "transliteral": "wə-hak-kar-mel", "traducao_palavra": "e o campo fértil" },
        { "hebraico": "לַיַּ֥עַר", "transliteral": "lay-ya-ʿar", "traducao_palavra": "por um bosque" },
        { "hebraico": "יֵחָשֵֽׁב׃", "transliteral": "yê-ḥā-šêḇ", "traducao_palavra": "será considerado" }
      ]
    },
    "18": {
      "traducao_completa": "E naquele dia os surdos ouvirão as palavras do livro, e os olhos dos cegos verão por entre a escuridão e as trevas.",
      "palavras": [
        { "hebraico": "וְשָׁמְע֧וּ", "transliteral": "wə-šā-mə-ʿû", "traducao_palavra": "E ouvirão" },
        { "hebraico": "בַיֹּום־הַה֛וּא", "transliteral": "ḇay-yôm-ha-hû", "traducao_palavra": "naquele dia" },
        { "hebraico": "הַחֵרְשִׁ֖ים", "transliteral": "ha-ḥê-rə-šîm", "traducao_palavra": "os surdos" },
        { "hebraico": "דִּבְרֵי־סֵ֑פֶר", "transliteral": "diḇ-rê-śê-p̄er", "traducao_palavra": "[as] palavras do livro" },
        { "hebraico": "וּמֵאֹ֣פֶל", "transliteral": "ū-mê-ʾō-p̄el", "traducao_palavra": "e da escuridão" },
        { "hebraico": "וּמֵחֹ֔שֶׁךְ", "transliteral": "ū-mē-ḥō-šeḵ", "traducao_palavra": "e das trevas" },
        { "hebraico": "עֵינֵ֥י", "transliteral": "ʿê-nê", "traducao_palavra": "[os] olhos de" },
        { "hebraico": "עִוְרִ֖ים", "transliteral": "ʿiw-rîm", "traducao_palavra": "cegos" },
        { "hebraico": "תִּרְאֶֽינָה׃", "transliteral": "tir-ʾe-nā", "traducao_palavra": "verão" }
      ]
    },
    "19": {
      "traducao_completa": "E os mansos terão cada vez mais alegria em YHWH; e os pobres entre os homens exultarão no Santo de Israel.",
      "palavras": [
        { "hebraico": "וְיָסְפ֧וּ", "transliteral": "wə-yā-śə-p̄û", "traducao_palavra": "E aumentarão" },
        { "hebraico": "עֲנָוִ֛ים", "transliteral": "ʿă-nā-wîm", "traducao_palavra": "os mansos" },
        { "hebraico": "בַּיהוָ֖ה", "transliteral": "bay-YHWH", "traducao_palavra": "em YHWH" },
        { "hebraico": "שִׂמְחָ֑ה", "transliteral": "śim-ḥā", "traducao_palavra": "alegria" },
        { "hebraico": "וְאֶבְיֹונֵ֣י", "transliteral": "wə-ʾeḇ-yô-nê", "traducao_palavra": "e os pobres de" },
        { "hebraico": "אָדָ֔ם", "transliteral": "ʾā-ḏām", "traducao_palavra": "homens" },
        { "hebraico": "בִּקְדֹ֥ושׁ", "transliteral": "bi-qə-ḏôš", "traducao_palavra": "no Santo de" },
        { "hebraico": "יִשְׂרָאֵ֖ל", "transliteral": "yiś-rā-ʾēl", "traducao_palavra": "Israel" },
        { "hebraico": "יָגִֽילוּ׃", "transliteral": "yā-ḡî-lû", "traducao_palavra": "exultarão" }
      ]
    },
    "20": {
      "traducao_completa": "Porque o tirano é reduzido a nada, e o escarnecedor se consome, e todos os que vigiam para praticar a iniquidade são extirpados;",
      "palavras": [
        { "hebraico": "כִּֽי־אָפֵ֥ס", "transliteral": "kî-ʾā-p̄êś", "traducao_palavra": "Porque cessou" },
        { "hebraico": "עָרִ֖יץ", "transliteral": "ʿā-rîṣ", "traducao_palavra": "[o] tirano" },
        { "hebraico": "וְכָ֣לָה", "transliteral": "wə-ḵā-lā", "traducao_palavra": "e findou" },
        { "hebraico": "לֵ֑ץ", "transliteral": "lêṣ", "traducao_palavra": "[o] escarnecedor" },
        { "hebraico": "וְנִכְרְת֖וּ", "transliteral": "wə-niḵ-rə-ṯû", "traducao_palavra": "e foram extirpados" },
        { "hebraico": "כָּל־שֹׁ֥קְדֵי", "transliteral": "kāl-šō-qə-ḏê", "traducao_palavra": "todos os que vigiam" },
        { "hebraico": "אָֽוֶן׃", "transliteral": "ʾā-wen", "traducao_palavra": "[para a] iniquidade" }
      ]
