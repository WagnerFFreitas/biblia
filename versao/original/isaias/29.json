        { "hebraico": "הֶחָת֔וּם", "transliteral": "he-ḥā-ṯûm", "traducao_palavra": "o selado" },
        { "hebraico": "אֲשֶֽׁר־יִתְּנ֣וּ", "transliteral": "ʾă-šer-yit-tə-nû", "traducao_palavra": "que dão" },
