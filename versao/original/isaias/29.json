    "6": {
      "traducao_completa": "De YHWH dos Exércitos serás visitada com trovões, e com terremotos, e grande ruído, com redemoinho, e tempestade, e labareda de fogo consumidor.",
      "palavras": [
        { "hebraico": "מֵעִ֨ם", "transliteral": "mê-ʿim", "traducao_palavra": "Da parte de" },
        { "hebraico": "יְהוָ֤ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "צְבָאֹות֙", "transliteral": "ṣə-ḇā-ʾôṯ", "traducao_palavra": "Exércitos" },
        { "hebraico": "תִּפָּקֵ֔ד", "transliteral": "tip-pā-qêḏ", "traducao_palavra": "serás visitada/punida" },
        { "hebraico": "בְּרַ֥עַם", "transliteral": "bə-ra-ʿam", "traducao_palavra": "com trovão" },
        { "hebraico": "וּבְרַ֖עַשׁ", "transliteral": "ū-ḇə-ra-ʿaš", "traducao_palavra": "e com terremoto" },
        { "hebraico": "וְקֹ֣ול", "transliteral": "wə-qôl", "traducao_palavra": "e ruído" },
        { "hebraico": "גָּדֹ֑ול", "transliteral": "gā-ḏôl", "traducao_palavra": "grande" },
        { "hebraico": "סוּפָה֙", "transliteral": "sû-p̄ā", "traducao_palavra": "tempestade" },
        { "hebraico": "וּשְׂעָרָ֔ה", "transliteral": "ū-śə-ʿā-rā", "traducao_palavra": "e redemoinho" },
        { "hebraico": "וְלַ֖הַב", "transliteral": "wə-la-haḇ", "traducao_palavra": "e labareda de" },
        { "hebraico": "אֵ֥שׁ", "transliteral": "ʾêš", "traducao_palavra": "fogo" },
        { "hebraico": "אֹוכֵלָֽה׃", "transliteral": "ʾô-ḵê-lā", "traducao_palavra": "consumidora" }
