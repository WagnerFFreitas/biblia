        { "hebraico": "וַיַּ֣עַשׂ", "transliteral": "way-ya-ʿaś", "traducao_palavra": "e fez" },
        { "hebraico": "כֵּ֔ן", "transliteral": "kên", "traducao_palavra": "assim" },
        { "hebraico": "הָלֹ֖ךְ", "transliteral": "hā-lōḵ", "traducao_palavra": "andando" },
        { "hebraico": "עָרֹ֥ום", "transliteral": "ʿā-rôm", "traducao_palavra": "nu" },
