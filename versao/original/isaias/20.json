        { "hebraico": "עֶרְוַ֥ת", "transliteral": "ʿer-waṯ", "traducao_palavra": "[para] a vergonha de" },
        { "hebraico": "מִצְרָֽיִם׃", "transliteral": "miṣ-rā-yim", "traducao_palavra": "Egito" }
      ]
