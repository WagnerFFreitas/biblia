    "5": {
      "traducao_completa": "E assombrar-se-ão e envergonhar-se-ão, por causa da Etiópia, sua esperança, e do Egito, sua glória.",
      "palavras": [
        { "hebraico": "וְחַתּ֖וּ", "transliteral": "wə-ḥat-tû", "traducao_palavra": "E assombrar-se-ão/desfalecerão" },
        { "hebraico": "וָבֹ֑שׁוּ", "transliteral": "wā-ḇō-šû", "traducao_palavra": "e envergonhar-se-ão" },
        { "hebraico": "מִכּוּשׁ֙", "transliteral": "mik-kûš", "traducao_palavra": "da Etiópia" },
        { "hebraico": "מַבָּטָ֔ם", "transliteral": "mab-bā-ṭām", "traducao_palavra": "[que era] a esperança deles" },
        { "hebraico": "וּמִן־מִצְרַ֖יִם", "transliteral": "ū-min-miṣ-ra-yim", "traducao_palavra": "e do Egito" },
        { "hebraico": "תִּפְאַרְתָּֽם׃", "transliteral": "tip̄-ʾar-tām", "traducao_palavra": "sua glória/esplendor" }
      ]
    },
    "6": {
      "traducao_completa": "E os moradores desta costa dirão naquele dia: Vede o que aconteceu à nossa esperança, à qual fugimos por socorro, para nos livrarmos da face do rei da Assíria! Como pois escaparemos nós?",
      "palavras": [
