{
  "livro": "Isaías - יְשַׁעְיָהוּ - Yeshayahu",
  "capítulo": 20,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "No ano em que Tartã veio a Asdode, enviado por Sargão, rei da Assíria, e pelejou contra Asdode, e a tomou,",
      "palavras": [
        { "hebraico": "בִּשְׁנַ֨ת", "transliteral": "biš-naṯ", "traducao_palavra": "No ano de" },
        { "hebraico": "בֹּ֤וא", "transliteral": "bô", "traducao_palavra": "vir/da vinda de" },
        { "hebraico": "תַרְתָּן֙", "transliteral": "ṯar-tān", "traducao_palavra": "Tartã [comandante]" },
        { "hebraico": "אַשְׁדֹּ֔ודָה", "transliteral": "ʾaš-dô-ḏā", "traducao_palavra": "a Asdode" },
        { "hebraico": "בִּשְׁלֹ֣חַ", "transliteral": "biš-lō-aḥ", "traducao_palavra": "quando enviou" },
        { "hebraico": "אֹתֹ֔ו", "transliteral": "ʾō-ṯô", "traducao_palavra": "a ele" },
        { "hebraico": "סַרְגֹ֖ון", "transliteral": "śar-gôn", "traducao_palavra": "Sargão" },
        { "hebraico": "מֶ֣לֶךְ", "transliteral": "me-leḵ", "traducao_palavra": "rei de" },
        { "hebraico": "אַשּׁ֑וּר", "transliteral": "ʾaš-šûr", "traducao_palavra": "Assíria" },
        { "hebraico": "וַיִּלָּ֥חֶם", "transliteral": "way-yil-lā-ḥem", "traducao_palavra": "e pelejou" },
        { "hebraico": "בְּאַשְׁדֹּ֖וד", "transliteral": "bə-ʾaš-dôḏ", "traducao_palavra": "em Asdode" },
        { "hebraico": "וַֽיִּלְכָּדָֽהּ׃", "transliteral": "way-yil-kā-ḏāh", "traducao_palavra": "e a tomou/capturou" }
      ]
    },
    "2": {
      "traducao_completa": "falou YHWH, naquele mesmo tempo, por intermédio de Isaías, filho de Amoz, dizendo: Vai, descinge o cilício de teus lombos, e tira as sandálias dos teus pés. E ele assim o fez, andando nu e descalço.",
      "palavras": [
        { "hebraico": "בָּעֵ֣ת", "transliteral": "bā-ʿêṯ", "traducao_palavra": "No tempo" },
        { "hebraico": "הַהִ֗יא", "transliteral": "ha-hî", "traducao_palavra": "aquele" },
        { "hebraico": "דִּבֶּ֨ר", "transliteral": "dib-bêr", "traducao_palavra": "falou" },
        { "hebraico": "יְהוָה֮", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "בְּיַ֣ד", "transliteral": "bə-yaḏ", "traducao_palavra": "pela mão de" },
        { "hebraico": "יְשַׁעְיָ֣הוּ", "transliteral": "yə-šaʿ-yā-hû", "traducao_palavra": "Isaías" },
        { "hebraico": "בֶﻦ־אָמֹוץ֮", "transliteral": "ben-ʾā-môṣ", "traducao_palavra": "filho de Amoz" },
        { "hebraico": "לֵאמֹר֒", "transliteral": "lê-mōr", "traducao_palavra": "dizendo" },
        { "hebraico": "לֵ֗ךְ", "transliteral": "lêḵ", "traducao_palavra": "vai" },
        { "hebraico": "וּפִתַּחְתָּ֤", "transliteral": "ū-p̄it-taḥ-tā", "traducao_palavra": "e desata/solta" },
        { "hebraico": "הַשַּׂק֙", "transliteral": "haś-śaq", "traducao_palavra": "o saco/cilício" },
        { "hebraico": "מֵעַ֣ל", "transliteral": "mê-ʿal", "traducao_palavra": "de sobre" },
        { "hebraico": "מָ֠תְנֶיךָ", "transliteral": "mā-ṯə-ne-ḵā", "traducao_palavra": "teus lombos" },
        { "hebraico": "וְנַעַלְךָ֥", "transliteral": "wə-na-ʿal-ḵā", "traducao_palavra": "e tua sandália" },
