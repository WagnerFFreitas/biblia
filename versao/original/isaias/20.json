        { "hebraico": "וְיָחֵ֑ף", "transliteral": "wə-yā-ḥêp̄", "traducao_palavra": "e descalço" },
        { "hebraico": "וַחֲשׂוּפַ֥י", "transliteral": "wa-ḥă-śû-p̄ay", "traducao_palavra": "e [com] exposição de" },
