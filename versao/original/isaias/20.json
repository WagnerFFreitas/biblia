        { "hebraico": "יְהוָ֔ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "כַּאֲשֶׁ֨ר", "transliteral": "ka-ʾă-šer", "traducao_palavra": "conforme/como" },
        { "hebraico": "הָלַ֧ךְ", "transliteral": "hā-laḵ", "traducao_palavra": "andou" },
        { "hebraico": "עַבְדִּ֛י", "transliteral": "ʿaḇ-dî", "traducao_palavra": "meu servo" },
        { "hebraico": "יְשַׁעְיָ֖הוּ", "transliteral": "yə-šaʿ-yā-hû", "traducao_palavra": "Isaías" },
        { "hebraico": "עָרֹ֣ום", "transliteral": "ʿā-rôm", "traducao_palavra": "nu" },
        { "hebraico": "וְיָחֵ֑ף", "transliteral": "wə-yā-ḥêp̄", "traducao_palavra": "e descalço" },
        { "hebraico": "שָׁלֹ֤שׁ", "transliteral": "šā-lōš", "traducao_palavra": "três" },
        { "hebraico": "שָׁנִים֙", "transliteral": "šā-nîm", "traducao_palavra": "anos" },
        { "hebraico": "אֹ֣ות", "transliteral": "ʾôṯ", "traducao_palavra": "[como] sinal" },
        { "hebraico": "וּמֹופֵ֔ת", "transliteral": "ū-mô-p̄êṯ", "traducao_palavra": "e prodígio" },
        { "hebraico": "עַל־מִצְרַ֖יִם", "transliteral": "ʿal-miṣ-ra-yim", "traducao_palavra": "sobre o Egito" },
        { "hebraico": "וְעַל־כּֽוּשׁ׃", "transliteral": "wə-ʿal-kûš", "traducao_palavra": "e sobre a Etiópia/Cuxe" }
      ]
    },
    "4": {
      "traducao_completa": "assim o rei da Assíria levará os cativos do Egito e os exilados da Etiópia, tanto moços como velhos, nus e descalços, e com as nádegas descobertas, para vergonha do Egito.",
      "palavras": [
        { "hebraico": "כֵּ֣ן", "transliteral": "kên", "traducao_palavra": "Assim" },
        { "hebraico": "יִנְהַ֣ג", "transliteral": "yin-haḡ", "traducao_palavra": "conduzirá/levará" },
        { "hebraico": "מֶֽלֶךְ־אַשּׁוּר֩", "transliteral": "me-leḵ-ʾaš-šûr", "traducao_palavra": "o rei da Assíria" },
        { "hebraico": "אֶת־שְׁבִ֨י", "transliteral": "ʾeṯ-šə-ḇî", "traducao_palavra": "[objeto] os cativos de" },
        { "hebraico": "מִצְרַ֜יִם", "transliteral": "miṣ-ra-yim", "traducao_palavra": "Egito" },
        { "hebraico": "וְאֶת־גָּל֥וּת", "transliteral": "wə-ʾeṯ-gā-lûṯ", "traducao_palavra": "e o exílio de" },
        { "hebraico": "כּ֛וּשׁ", "transliteral": "kûš", "traducao_palavra": "Etiópia" },
        { "hebraico": "נְעָרִ֥ים", "transliteral": "nə-ʿā-rîm", "traducao_palavra": "jovens" },
        { "hebraico": "וּזְקֵנִ֖ים", "transliteral": "ū-zə-qê-nîm", "traducao_palavra": "e velhos" },
