        { "hebraico": "יֹשֵׁ֤ב", "transliteral": "yô-šêḇ", "traducao_palavra": "[o] habitante de" },
        { "hebraico": "הָאִ֣י", "transliteral": "hā-ʾî", "traducao_palavra": "esta ilha/costa" },
        { "hebraico": "הַזֶּה֙", "transliteral": "haz-zeh", "traducao_palavra": "[esta]" },
        { "hebraico": "בַּיֹּ֣ום", "transliteral": "bay-yôm", "traducao_palavra": "no dia" },
        { "hebraico": "הַהוּא֒", "transliteral": "ha-hû", "traducao_palavra": "aquele" },
        { "hebraico": "הִנֵּה־כֹ֣ה", "transliteral": "hin-nēh-ḵō", "traducao_palavra": "eis que assim [é]" },
        { "hebraico": "מַבָּטֵ֗נוּ", "transliteral": "mab-bā-ṭê-nû", "traducao_palavra": "nossa esperança" },
        { "hebraico": "אֲשֶׁר־נַ֤סְנוּ", "transliteral": "ʾă-šer-nas-nû", "traducao_palavra": "para onde fugimos" },
        { "hebraico": "שָׁם֙", "transliteral": "šām", "traducao_palavra": "ali" },
        { "hebraico": "לְעֶזְרָ֔ה", "transliteral": "lə-ʿez-rā", "traducao_palavra": "por socorro" },
        { "hebraico": "לְהִנָּצֵ֖ל", "transliteral": "lə-hin-nā-ṣêl", "traducao_palavra": "para ser livre/entregue" },
        { "hebraico": "מִפְּנֵי֙", "transliteral": "mip-pə-nê", "traducao_palavra": "de diante de" },
        { "hebraico": "מֶ֣לֶךְ", "transliteral": "me-leḵ", "traducao_palavra": "rei de" },
