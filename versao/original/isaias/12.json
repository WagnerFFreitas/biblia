{
  "livro": "Isaías - יְשַׁעְיָהוּ - Yeshayahu",
  "capítulo": 12,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "E dirás naquele dia: Graças te dou, ó YHWH, porque, ainda que te iraste contra mim, a tua ira se retirou, e tu me consolaste.",
      "palavras": [
        { "hebraico": "וְאָמַרְתָּ֮", "transliteral": "wə-ʾā-mar-tā", "traducao_palavra": "E dirás" },
        { "hebraico": "בַּיֹּ֣ום", "transliteral": "bay-yôm", "traducao_palavra": "no dia" },
        { "hebraico": "הַהוּא֒", "transliteral": "ha-hû", "traducao_palavra": "aquele" },
        { "hebraico": "אֹודְךָ֣", "transliteral": "ʾô-ḏə-ḵā", "traducao_palavra": "dar-te-ei graças" },
        { "hebraico": "יְהוָ֔ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "כִּ֥י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "אָנַ֖פְתָּ", "transliteral": "ʾā-nap̄-tā", "traducao_palavra": "iraste-te" },
        { "hebraico": "בִּ֑י", "transliteral": "bî", "traducao_palavra": "contra mim" },
        { "hebraico": "יָשָׁ֥ב", "transliteral": "yā-šāḇ", "traducao_palavra": "voltou [atrás]" },
        { "hebraico": "אַפְּךָ֖", "transliteral": "ʾap-pə-ḵā", "traducao_palavra": "tua ira" },
        { "hebraico": "וּתְנַחֲמֵֽנִי׃", "transliteral": "ū-ṯə-na-ḥă-mê-nî", "traducao_palavra": "e tu me consolas" }
      ]
    },
    "2": {
      "traducao_completa": "Eis que Deus é a minha salvação; nela confiarei, e não temerei; porque o Senhor DEUS é a minha força e o meu cântico, e se tornou a minha salvação.",
      "palavras": [
        { "hebraico": "הִנֵּ֨ה", "transliteral": "hin-nēh", "traducao_palavra": "Eis que" },
        { "hebraico": "אֵ֧ל", "transliteral": "ʾēl", "traducao_palavra": "Deus [é]" },
        { "hebraico": "יְשׁוּעָתִ֛י", "transliteral": "yə-šû-ʿā-ṯî", "traducao_palavra": "minha salvação" },
        { "hebraico": "אֶבְטַ֖ח", "transliteral": "ʾeḇ-ṭaḥ", "traducao_palavra": "confiarei" },
        { "hebraico": "וְלֹ֣א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "אֶפְחָ֑ד", "transliteral": "ʾep̄-ḥāḏ", "traducao_palavra": "temerei" },
        { "hebraico": "כִּֽי־עָזִּ֤י", "transliteral": "kî-ʿāz-zî", "traducao_palavra": "porque minha força" },
        { "hebraico": "וְזִמְרָת֙", "transliteral": "wə-zim-rāṯ", "traducao_palavra": "e [meu] cântico" },
        { "hebraico": "יָ֣הּ", "transliteral": "yāh", "traducao_palavra": "YAH" },
        { "hebraico": "יְהוָ֔ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "וַֽיְהִי־לִ֖י", "transliteral": "way-hî-lî", "traducao_palavra": "e ele se tornou para mim" },
        { "hebraico": "לִֽישׁוּעָה׃", "transliteral": "lî-šû-ʿā", "traducao_palavra": "em salvação" }
      ]
    },
    "3": {
      "traducao_completa": "Vós, pois, com alegria tirareis águas das fontes da salvação.",
      "palavras": [
        { "hebraico": "וּשְׁאַבְתֶּם־", "transliteral": "ū-šə-ʾaḇ-tem-", "traducao_palavra": "E tirareis/haurireis" },
        { "hebraico": "מַ֖יִם", "transliteral": "ma-yim", "traducao_palavra": "água" },
        { "hebraico": "בְּשָׂשֹׂ֑ון", "transliteral": "bə-śā-śôn", "traducao_palavra": "com alegria" },
        { "hebraico": "מִמַּעַיְנֵ֖י", "transliteral": "mim-ma-ʿay-nê", "traducao_palavra": "das fontes de" },
        { "hebraico": "הַיְשׁוּעָֽה׃", "transliteral": "hay-šû-ʿā", "traducao_palavra": "a salvação" }
      ]
    },
    "4": {
      "traducao_completa": "E direis naquele dia: Dai graças a YHWH, invocai o seu nome, tornai manifestos os seus feitos entre os povos, contai quão excelso é o seu nome.",
      "palavras": [
        { "hebraico": "וַאֲמַרְתֶּם֮", "transliteral": "wa-ʾă-mar-tem", "traducao_palavra": "E direis" },
        { "hebraico": "בַּיֹּ֣ום", "transliteral": "bay-yôm", "traducao_palavra": "no dia" },
        { "hebraico": "הַהוּא֒", "transliteral": "ha-hû", "traducao_palavra": "aquele" },
        { "hebraico": "הֹוד֤וּ", "transliteral": "hô-ḏû", "traducao_palavra": "dai graças" },
        { "hebraico": "לַֽיהוָה֙", "transliteral": "lay-YHWH", "traducao_palavra": "a YHWH" },
        { "hebraico": "קִרְא֣וּ", "transliteral": "qir-ʾû", "traducao_palavra": "invocai" },
        { "hebraico": "בִשְׁמֹ֔ו", "transliteral": "biš-mô", "traducao_palavra": "no seu nome" },
        { "hebraico": "הֹודִ֥יעוּ", "transliteral": "hô-ḏî-ʿû", "traducao_palavra": "fazei saber" },
        { "hebraico": "בָעַמִּ֖ים", "transliteral": "ḇā-ʿam-mîm", "traducao_palavra": "entre os povos" },
        { "hebraico": "עֲלִילֹתָ֑יו", "transliteral": "ʿă-lî-lō-ṯāyw", "traducao_palavra": "seus feitos" },
        { "hebraico": "הַזְכִּ֕ירוּ", "transliteral": "haz-kî-rû", "traducao_palavra": "fazei lembrar" },
        { "hebraico": "כִּ֥י", "transliteral": "kî", "traducao_palavra": "que" },
        { "hebraico": "נִשְׂגָּ֖ב", "transliteral": "niś-gāḇ", "traducao_palavra": "exaltado/excelso [é]" },
        { "hebraico": "שְׁמֹֽו׃", "transliteral": "šə-mô", "traducao_palavra": "seu nome" }
      ]
    },
    "5": {
      "traducao_completa": "Cantai a YHWH, porque fez coisas grandiosas; saiba-se isto em toda a terra.",
      "palavras": [
        { "hebraico": "זַמְּר֣וּ", "transliteral": "zam-mə-rû", "traducao_palavra": "Louvai/cantai" },
        { "hebraico": "יְהוָ֔ה", "transliteral": "YHWH", "traducao_palavra": "a YHWH" },
        { "hebraico": "כִּי", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "גֵא֖וּת", "transliteral": "ḡê-ʾût", "traducao_palavra": "coisas excelentes/majestade" },
        { "hebraico": "עָשָׂ֑ה", "transliteral": "ʿā-śā", "traducao_palavra": "ele fez" },
        { "hebraico": "מֳודַ֥עַת", "transliteral": "mô-ḏa-ʿaṯ", "traducao_palavra": "conhecida [seja]" },
        { "hebraico": "זֹ֖את", "transliteral": "zōṯ", "traducao_palavra": "isto" },
        { "hebraico": "בְּכָל־", "transliteral": "bə-ḵāl-", "traducao_palavra": "em toda" },
        { "hebraico": "הָאָֽרֶץ׃", "transliteral": "hā-ʾā-reṣ", "traducao_palavra": "a terra" }
      ]
    },
    "6": {
      "traducao_completa": "Grita de júbilo e exulta, ó habitante de Sião, porque grande é o Santo de Israel no meio de ti.",
      "palavras": [
        { "hebraico": "צַהֲלִ֥י", "transliteral": "ṣa-hă-lî", "traducao_palavra": "Grita/exulta" },
        { "hebraico": "וָרֹ֖נִּי", "transliteral": "wā-rōn-nî", "traducao_palavra": "e canta" },
        { "hebraico": "יֹושֶׁ֣בֶת", "transliteral": "yô-še-ḇeṯ", "traducao_palavra": "[ó] habitante de" },
        { "hebraico": "צִיֹּ֑ון", "transliteral": "ṣî-yôn", "traducao_palavra": "Sião" },
        { "hebraico": "כִּֽי־גָדֹ֥ול", "transliteral": "kî-ḡā-ḏôl", "traducao_palavra": "porque grande [é]" },
        { "hebraico": "בְּקִרְבֵּ֖ךְ", "transliteral": "bə-qir-bêḵ", "traducao_palavra": "no meio de ti" },
        { "hebraico": "קְדֹ֥ושׁ", "transliteral": "qə-ḏôš", "traducao_palavra": "o Santo de" },
        { "hebraico": "יִשְׂרָאֵֽל׃", "transliteral": "yiś-rā-ʾēl", "traducao_palavra": "Israel" }
      ]
    }
  }
}