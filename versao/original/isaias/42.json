        { "hebraico": "מִשְׁפָּֽט׃", "transliteral": "miš-pāṭ", "traducao_palavra": "juízo." }
      ]
    },
    "4": {
      "traducao_completa": "Não desfalecerá nem será esmagado, até que estabeleça na terra o juízo; e as ilhas aguardarão a sua lei.",
      "palavras": [
        { "hebraico": "לֹ֤א", "transliteral": "lō", "traducao_palavra": "Não" },
        { "hebraico": "יִכְהֶה֙", "transliteral": "yiḵ-heh", "traducao_palavra": "desfalecerá/escurecerá" },
        { "hebraico": "וְלֹ֣א", "transliteral": "wə-lō", "traducao_palavra": "nem" },
        { "hebraico": "יָר֔וּץ", "transliteral": "yā-rūṣ", "traducao_palavra": "será esmagado/quebrado" },
        { "hebraico": "עַד־", "transliteral": "ʿaḏ-", "traducao_palavra": "até que" },
        { "hebraico": "יָשִׂ֥ים", "transliteral": "yā-śîm", "traducao_palavra": "estabeleça/ponha" },
        { "hebraico": "בָּאָ֖רֶץ", "transliteral": "bā-ʾā-reṣ", "traducao_palavra": "na terra" },
        { "hebraico": "מִשְׁפָּ֑ט", "transliteral": "miš-pāṭ", "traducao_palavra": "juízo" },
        { "hebraico": "וּלְתֹורָתֹ֖ו", "transliteral": "ū-lə-ṯō-w-rā-ṯō-w", "traducao_palavra": "e por sua lei" },
        { "hebraico": "אִיִּ֥ים", "transliteral": "ʾiy-yîm", "traducao_palavra": "ilhas" },
        { "hebraico": "יְיַחֵֽילוּ׃", "transliteral": "yə-ya-ḥê-lū", "traducao_palavra": "esperarão." }
      ]
    },
    "5": {
      "traducao_completa": "Assim diz o Deus YHWH, que criou os céus e os estendeu, que formou a terra e tudo quanto dela sai, que dá fôlego ao povo que nela está, e espírito aos que nela andam:",
      "palavras": [
        { "hebraico": "כֹּה־", "transliteral": "kōh-", "traducao_palavra": "Assim" },
        { "hebraico": "אָמַ֞ר", "transliteral": "ʾā-mar", "traducao_palavra": "disse" },
        { "hebraico": "הָאֵ֣ל", "transliteral": "hā-ʾēl", "traducao_palavra": "o Deus" },
        { "hebraico": "יְהוָ֗ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "בֹּורֵ֤א", "transliteral": "bō-w-rē", "traducao_palavra": "Criador de" },
        { "hebraico": "הַשָּׁמַ֙יִם֙", "transliteral": "haš-šā-ma-yim", "traducao_palavra": "os céus" },
        { "hebraico": "וְנֹוטֵיהֶ֔ם", "transliteral": "wə-nō-w-ṭê-hem", "traducao_palavra": "e os estendendo" },
