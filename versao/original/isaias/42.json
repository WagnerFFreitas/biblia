        { "hebraico": "כֶּ֖לֶא", "transliteral": "ke-le", "traducao_palavra": "cárcere" },
        { "hebraico": "יֹ֥שְׁבֵי", "transliteral": "yō-šə-ḇê", "traducao_palavra": "habitantes de" },
        { "hebraico": "חֹֽשֶׁךְ׃", "transliteral": "ḥō-šeḵ", "traducao_palavra": "trevas." }
      ]
    },
    "8": {
      "traducao_completa": "Eu sou YHWH; este é o meu nome; a minha glória, pois, a outrem não darei, nem o meu louvor às imagens de escultura.",
      "palavras": [
        { "hebraico": "אֲנִ֥י", "transliteral": "ʾă-nî", "traducao_palavra": "Eu" },
        { "hebraico": "יְהוָ֖ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "ה֣וּא", "transliteral": "hū", "traducao_palavra": "ele [é]" },
        { "hebraico": "שְׁמִ֑י", "transliteral": "šə-mî", "traducao_palavra": "meu nome" },
        { "hebraico": "וּכְבֹודִִי֙", "transliteral": "ū-ḵə-ḇō-w-ḏî", "traducao_palavra": "e minha glória" },
        { "hebraico": "לְאַחֵ֣ר", "transliteral": "lə-ʾa-ḥēr", "traducao_palavra": "a outrem" },
        { "hebraico": "לֹֽא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "אֶתֵּ֔ן", "transliteral": "ʾet-tên", "traducao_palavra": "darei" },
        { "hebraico": "וּתְהִלָּתִ֖י", "transliteral": "ū-ṯə-hil-lā-ṯî", "traducao_palavra": "e meu louvor" },
        { "hebraico": "לַפְּסִילִֽים׃", "transliteral": "lap-pə-śî-lîm", "traducao_palavra": "às imagens esculpidas." }
      ]
    },
    "9": {
      "traducao_completa": "Eis que as primeiras coisas já se cumpriram, e novas coisas eu vos anuncio; antes que venham à luz, vo-las faço ouvir.",
      "palavras": [
        { "hebraico": "הָרִאשֹׁנֹ֖ות", "transliteral": "hā-ri-šō-nō-wṯ", "traducao_palavra": "As primeiras [coisas]" },
        { "hebraico": "הִנֵּה־", "transliteral": "hin-nēh-", "traducao_palavra": "eis que" },
        { "hebraico": "בָ֑אוּ", "transliteral": "ḇā-ʾū", "traducao_palavra": "vieram/se cumpriram" },
        { "hebraico": "וַחֲדָשֹׁות֙", "transliteral": "wa-ḥă-ḏā-šō-wṯ", "traducao_palavra": "e novas [coisas]" },
        { "hebraico": "אֲנִ֣י", "transliteral": "ʾă-nî", "traducao_palavra": "eu" },
        { "hebraico": "מַגִּ֔יד", "transliteral": "mag-gîḏ", "traducao_palavra": "anuncio/declaro" },
        { "hebraico": "בְּטֶ֥רֶם", "transliteral": "bə-ṭe-rem", "traducao_palavra": "antes que" },
        { "hebraico": "תִּצְמַ֖חְנָה", "transliteral": "tiṣ-maḥ-nāh", "traducao_palavra": "brotem/venham à luz" },
        { "hebraico": "אַשְׁמִ֥יעַ", "transliteral": "ʾaš-mî-aʿ", "traducao_palavra": "faço ouvir" },
        { "hebraico": "אֶתְכֶֽם׃", "transliteral": "ʾeṯ-ḵem", "traducao_palavra": "a vós." }
      ]
    },
    "10": {
      "traducao_completa": "Cantai a YHWH um cântico novo, e o seu louvor desde o fim da terra; vós que desceis ao mar, e tudo o que há nele; vós ilhas, e seus habitantes.",
      "palavras": [
        { "hebraico": "שִׁ֤ירוּ", "transliteral": "šî-rū", "traducao_palavra": "Cantai" },
        { "hebraico": "לַיהוָה֙", "transliteral": "la-YHWH", "traducao_palavra": "a YHWH" },
        { "hebraico": "שִׁ֣יר", "transliteral": "šîr", "traducao_palavra": "um cântico" },
        { "hebraico": "חָדָ֔שׁ", "transliteral": "ḥā-ḏāš", "traducao_palavra": "novo" },
        { "hebraico": "תְּהִלָּתֹ֖ו", "transliteral": "tə-hil-lā-ṯō-w", "traducao_palavra": "seu louvor" },
        { "hebraico": "מִקְצֵ֣ה", "transliteral": "miq-ṣēh", "traducao_palavra": "desde a extremidade de" },
        { "hebraico": "הָאָ֑רֶץ", "transliteral": "hā-ʾā-reṣ", "traducao_palavra": "a terra" },
        { "hebraico": "יֹורְדֵ֤י", "transliteral": "yō-w-rə-ḏê", "traducao_palavra": "descendentes de/que descem ao" },
