{
  "livro": "Isaías - יְשַֽׁעְיָהוּ - Yəšayāhū",
  "capítulo": 42,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Eis o meu servo, a quem sustenho; o meu escolhido, em quem a minha alma se agrada; pus o meu espírito sobre ele; ele levará o juízo às nações.",
      "palavras": [
        { "hebraico": "הֵ֤ן", "transliteral": "hên", "traducao_palavra": "Eis" },
        { "hebraico": "עַבְדִּ֨י", "transliteral": "ʿaḇ-dî", "traducao_palavra": "meu servo" },
        { "hebraico": "אֶתְמָךְ־", "transliteral": "ʾeṯ-māḵ-", "traducao_palavra": "segurarei/sustentarei" },
        { "hebraico": "בֹּ֔ו", "transliteral": "bō-w", "traducao_palavra": "nele" },
        { "hebraico": "בְּחִירִ֖י", "transliteral": "ḇə-ḥî-rî", "traducao_palavra": "meu escolhido" },
        { "hebraico": "רָצְתָ֣ה", "transliteral": "rā-ṣə-ṯāh", "traducao_palavra": "agradou-se" },
        { "hebraico": "נַפְשִׁ֑י", "transliteral": "nap̄-šî", "traducao_palavra": "minha alma" },
        { "hebraico": "נָתַ֤תִּי", "transliteral": "nā-ṯat-tî", "traducao_palavra": "pus/dei" },
        { "hebraico": "רוּחִי֙", "transliteral": "rū-ḥî", "traducao_palavra": "meu espírito" },
        { "hebraico": "עָלָ֔יו", "transliteral": "ʿā-lāy-w", "traducao_palavra": "sobre ele" },
        { "hebraico": "מִשְׁפָּ֖ט", "transliteral": "miš-pāṭ", "traducao_palavra": "juízo" },
        { "hebraico": "לַגֹּויִ֥ם", "transliteral": "lag-gō-w-yim", "traducao_palavra": "para as nações" },
        { "hebraico": "יֹוצִֽיא׃", "transliteral": "yō-w-ṣî", "traducao_palavra": "ele fará sair." }
      ]
    },
    "2": {
      "traducao_completa": "Não clamará, nem levantará a voz, nem fará ouvir a sua voz na rua.",
      "palavras": [
        { "hebraico": "לֹ֥א", "transliteral": "lō", "traducao_palavra": "Não" },
        { "hebraico": "יִצְעַ֖ק", "transliteral": "yiṣ-ʿaq", "traducao_palavra": "clamará" },
        { "hebraico": "וְלֹ֣א", "transliteral": "wə-lō", "traducao_palavra": "nem" },
        { "hebraico": "יִשָּׂ֑א", "transliteral": "yiś-śā", "traducao_palavra": "levantará [a voz]" },
        { "hebraico": "וְלֹֽא־", "transliteral": "wə-lō-", "traducao_palavra": "nem" },
        { "hebraico": "יַשְׁמִ֥יעַ", "transliteral": "yaš-mî-aʿ", "traducao_palavra": "fará ouvir" },
        { "hebraico": "בַּח֖וּץ", "transliteral": "ba-ḥūṣ", "traducao_palavra": "na rua/fora" },
        { "hebraico": "קֹולֹֽו׃", "transliteral": "qō-w-lō", "traducao_palavra": "sua voz." }
      ]
    },
    "3": {
      "traducao_completa": "A cana quebrada não esmagará, nem apagará o pavio que fumega; com fidelidade levará o juízo à vitória.",
      "palavras": [
        { "hebraico": "קָנֶ֤ה", "transliteral": "qā-neh", "traducao_palavra": "Cana" },
        { "hebraico": "רָצוּץ֙", "transliteral": "rā-ṣūṣ", "traducao_palavra": "quebrada/esmagada" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "יִשְׁבֹּ֔ור", "transliteral": "yiš-bō-wr", "traducao_palavra": "esmagará/quebrará" },
        { "hebraico": "וּפִשְׁתָּ֥ה", "transliteral": "ū-p̄iš-tāh", "traducao_palavra": "e o pavio/linho" },
        { "hebraico": "כֵהָ֖ה", "transliteral": "ḵē-hāh", "traducao_palavra": "fumegante/fraco" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "יְכַבֶּ֑נָּה", "transliteral": "yə-ḵab-ben-nāh", "traducao_palavra": "o apagará" },
