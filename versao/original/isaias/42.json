        { "hebraico": "בָּֽהּ׃", "transliteral": "bāh", "traducao_palavra": "nela." }
      ]
    },
    "6": {
      "traducao_completa": "Eu, YHWH, te chamei em justiça, e te tomarei pela mão, e te guardarei, e te porei por pacto do povo e para luz das nações.",
      "palavras": [
        { "hebraico": "אֲנִ֧י", "transliteral": "ʾă-nî", "traducao_palavra": "Eu" },
        { "hebraico": "יְהוָ֛ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "קְרָאתִ֥יךָ", "transliteral": "qə-rā-ṯî-ḵā", "traducao_palavra": "te chamei" },
        { "hebraico": "בְצֶ֖דֶק", "transliteral": "ḇə-ṣe-ḏeq", "traducao_palavra": "em justiça" },
        { "hebraico": "וְאַחְזֵ֣ק", "transliteral": "wə-ʾaḥ-zēq", "traducao_palavra": "e te tomarei/fortalecerei" },
        { "hebraico": "בְּיָדֶ֑ךָ", "transliteral": "bə-yā-ḏe-ḵā", "traducao_palavra": "pela tua mão" },
        { "hebraico": "וְאֶצָּרְךָ֗", "transliteral": "wə-ʾeṣ-ṣār-ḵā", "traducao_palavra": "e te guardarei" },
        { "hebraico": "וְאֶתֶּנְךָ֛", "transliteral": "wə-ʾet-ten-ḵā", "traducao_palavra": "e te porei" },
        { "hebraico": "לִבְרִ֥ית", "transliteral": "li-ḇə-rîṯ", "traducao_palavra": "por pacto/aliança de" },
        { "hebraico": "עָ֖ם", "transliteral": "ʿām", "traducao_palavra": "povo" },
        { "hebraico": "לְאֹ֥ור", "transliteral": "lə-ʾō-wr", "traducao_palavra": "para luz de" },
        { "hebraico": "גֹּויִֽם׃", "transliteral": "gō-w-yim", "traducao_palavra": "nações." }
      ]
    },
    "7": {
      "traducao_completa": "Para abrir os olhos dos cegos, para tirar da prisão os presos e do cárcere os que habitam em trevas.",
      "palavras": [
        { "hebraico": "לִפְקֹ֖חַ", "transliteral": "lip̄-qō-aḥ", "traducao_palavra": "Para abrir" },
        { "hebraico": "עֵינַ֣יִם", "transliteral": "ʿê-na-yim", "traducao_palavra": "olhos" },
        { "hebraico": "עִוְרֹ֑ות", "transliteral": "ʿiw-rō-wṯ", "traducao_palavra": "cegos" },
        { "hebraico": "לְהֹוצִ֤יא", "transliteral": "lə-hō-w-ṣî", "traducao_palavra": "para fazer sair" },
