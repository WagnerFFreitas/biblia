        { "hebraico": "וְצֶאֱצָאֶ֑יהָ", "transliteral": "wə-ṣe-ʾĕ-ṣā-ʾe-hā", "traducao_palavra": "e o que dela sai" },
        { "hebraico": "נֹתֵ֤ן", "transliteral": "nō-ṯên", "traducao_palavra": "dando" },
        { "hebraico": "נְשָׁמָה֙", "transliteral": "nə-šā-māh", "traducao_palavra": "fôlego" },
        { "hebraico": "לָעָ֣ם", "transliteral": "lā-ʿām", "traducao_palavra": "ao povo" },
        { "hebraico": "עָלֶ֔יהָ", "transliteral": "ʿā-le-hā", "traducao_palavra": "sobre ela" },
