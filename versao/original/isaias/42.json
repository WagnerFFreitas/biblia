        { "hebraico": "וְעָרָ֔יו", "transliteral": "wə-ʿā-rāy-w", "traducao_palavra": "e suas cidades" },
        { "hebraico": "חֲצֵרִ֖ים", "transliteral": "ḥă-ṣē-rîm", "traducao_palavra": "[com as] aldeias" },
        { "hebraico": "תֵּשֵׁ֣ב", "transliteral": "tê-šēḇ", "traducao_palavra": "[onde] habita" },
        { "hebraico": "קֵדָ֑ר", "transliteral": "qē-ḏār", "traducao_palavra": "Quedar" },
        { "hebraico": "יָרֹ֙נּוּ֙", "transliteral": "yā-rōn-nū", "traducao_palavra": "cantem/exultem" },
        { "hebraico": "יֹ֣שְׁבֵי", "transliteral": "yō-šə-ḇê", "traducao_palavra": "habitantes de" },
        { "hebraico": "סֶ֔לַע", "transliteral": "se-laʿ", "traducao_palavra": "rocha" },
        { "hebraico": "מֵרֹ֥אשׁ", "transliteral": "mē-rōš", "traducao_palavra": "do cume de" },
        { "hebraico": "הָרִ֖ים", "transliteral": "hā-rîm", "traducao_palavra": "montes" },
        { "hebraico": "יִצְוָֽחוּ׃", "transliteral": "yiṣ-wā-ḥū", "traducao_palavra": "clamem/gritem." }
      ]
    },
    "12": {
      "traducao_completa": "Deem glória a YHWH, e anunciem o seu louvor nas ilhas.",
      "palavras": [
        { "hebraico": "יָשִׂ֥ימוּ", "transliteral": "yā-śî-mū", "traducao_palavra": "Deem/atribuam" },
        { "hebraico": "לַיהוָ֖ה", "transliteral": "la-YHWH", "traducao_palavra": "a YHWH" },
        { "hebraico": "כָּבֹ֑וד", "transliteral": "kā-ḇō-wḏ", "traducao_palavra": "glória" },
        { "hebraico": "וּתְהִלָּתֹ֖ו", "transliteral": "ū-ṯə-hil-lā-ṯō-w", "traducao_palavra": "e seu louvor" },
        { "hebraico": "בָּאִיִּ֥ים", "transliteral": "bā-ʾiy-yîm", "traducao_palavra": "nas ilhas" },
        { "hebraico": "יַגִּֽידוּ׃", "transliteral": "yag-gî-ḏū", "traducao_palavra": "anunciem." }
      ]
    },
    "13": {
      "traducao_completa": "YHWH como um herói sairá, como um homem de guerra despertará o zelo; clamará, e fará grande ruído, e prevalecerá contra os seus inimigos.",
      "palavras": [
        { "hebraico": "יְהוָה֙", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "כַּגִּבֹּ֣ור", "transliteral": "kag-gib-bō-wr", "traducao_palavra": "como um herói" },
        { "hebraico": "יֵצֵ֔א", "transliteral": "yê-ṣē", "traducao_palavra": "sairá" },
        { "hebraico": "כְּאִ֥ישׁ", "transliteral": "kə-ʾîš", "traducao_palavra": "como homem de" },
        { "hebraico": "מִלְחָמֹ֖ות", "transliteral": "mil-ḥā-mō-wṯ", "traducao_palavra": "guerras" },
        { "hebraico": "יָעִ֣יר", "transliteral": "yā-ʿîr", "traducao_palavra": "despertará" },
        { "hebraico": "קִנְאָ֑ה", "transliteral": "qin-ʾāh", "traducao_palavra": "zelo/ciúme" },
        { "hebraico": "יָרִ֙יעַ֙", "transliteral": "yā-rî-aʿ", "traducao_palavra": "gritará" },
        { "hebraico": "אַף־", "transliteral": "ʾap̄-", "traducao_palavra": "também" },
        { "hebraico": "יַצְרִ֔יחַ", "transliteral": "yaṣ-rî-aḥ", "traducao_palavra": "bradejará/rugirá" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre" },
        { "hebraico": "אֹיְבָ֖יו", "transliteral": "ʾō-yə-ḇāy-w", "traducao_palavra": "seus inimigos" },
        { "hebraico": "יִתְגַּבָּֽר׃", "transliteral": "yiṯ-gab-bār", "traducao_palavra": "prevalecerá." }
      ]
    },
    "14": {
      "traducao_completa": "Por muito tempo me curei, estive em silêncio e me contive; agora, como a que está em parto, clamarei; ao mesmo tempo devastarei e devorarei.",
      "palavras": [
        { "hebraico": "הֶחֱשֵׁ֙יתִי֙", "transliteral": "he-ḥĕ-šê-ṯî", "traducao_palavra": "Eu me calei/estive em silêncio" },
        { "hebraico": "מֵעֹולָ֔ם", "transliteral": "mē-ʿō-w-lām", "traducao_palavra": "desde a eternidade/por muito tempo" },
        { "hebraico": "אַחֲרִ֖ישׁ", "transliteral": "ʾa-ḥă-rîš", "traducao_palavra": "ficarei em silêncio" },
        { "hebraico": "אֶתְאַפָּ֑ק", "transliteral": "ʾeṯ-ʾap-pāq", "traducao_palavra": "me conterei" },
        { "hebraico": "כַּיֹּולֵדָ֣ה", "transliteral": "kay-yō-w-lê-ḏāh", "traducao_palavra": "como a que dá à luz" },
        { "hebraico": "אֶפְעֶ֔ה", "transliteral": "ʾep̄-ʿeh", "traducao_palavra": "gemerei/clamarei" },
        { "hebraico": "אֶשֹּׁ֥ם", "transliteral": "ʾeš-šōm", "traducao_palavra": "devastarei" },
        { "hebraico": "וְאֶשְׁאַ֖ף", "transliteral": "wə-ʾeš-ʾap̄", "traducao_palavra": "e devorarei/ofegarei" },
        { "hebraico": "יָחַֽד׃", "transliteral": "yā-ḥaḏ", "traducao_palavra": "juntamente." }
      ]
    },
    "15": {
      "traducao_completa": "Assolarei montes e outeiros, e secarei toda a sua erva; tornarei os rios em ilhas e secarei os lagos.",
      "palavras": [
        { "hebraico": "אַחֲרִ֤יב", "transliteral": "ʾa-ḥă-rîḇ", "traducao_palavra": "Assolarei/farei deserto" },
        { "hebraico": "הָרִ֣ים", "transliteral": "hā-rîm", "traducao_palavra": "montes" },
        { "hebraico": "וּגְבָעֹ֔ות", "transliteral": "ū-ḡə-ḇā-ʿō-wṯ", "traducao_palavra": "e outeiros" },
        { "hebraico": "וְכָל־", "transliteral": "wə-ḵāl-", "traducao_palavra": "e toda" },
        { "hebraico": "עֶשְׂבָּ֖ם", "transliteral": "ʿeś-bām", "traducao_palavra": "erva deles" },
        { "hebraico": "אֹובִ֑ישׁ", "transliteral": "ʾō-w-ḇîš", "traducao_palavra": "secarei" },
        { "hebraico": "וְשַׂמְתִּ֤י", "transliteral": "wə-śam-tî", "traducao_palavra": "e porei" },
        { "hebraico": "נְהָרֹות֙", "transliteral": "nə-hā-rō-wṯ", "traducao_palavra": "rios" },
        { "hebraico": "לָאִיִּ֔ים", "transliteral": "lā-ʾiy-yîm", "traducao_palavra": "em ilhas" },
        { "hebraico": "וַאֲגַמִּ֖ים", "transliteral": "wa-ʾă-ḡam-mîm", "traducao_palavra": "e lagos/pântanos" },
        { "hebraico": "אֹובִֽישׁ׃", "transliteral": "ʾō-w-ḇîš", "traducao_palavra": "secarei." }
      ]
    },
    "16": {
      "traducao_completa": "E guiarei os cegos por um caminho que não conheciam, por veredas que não conheciam os farei andar; tornarei as trevas em luz diante deles, e o que é torto em retidão. Estas coisas lhes farei, e não os desampararei.",
      "palavras": [
        { "hebraico": "וְהֹולַכְתִּ֣י", "transliteral": "wə-hō-w-laḵ-tî", "traducao_palavra": "E guiarei" },
        { "hebraico": "עִוְרִ֗ים", "transliteral": "ʿiw-rîm", "traducao_palavra": "[os] cegos" },
        { "hebraico": "בְּדֶ֙רֶךְ֙", "transliteral": "bə-ḏe-reḵ", "traducao_palavra": "por caminho" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "[que] não" },
        { "hebraico": "יָדָ֔עוּ", "transliteral": "yā-ḏā-ʿū", "traducao_palavra": "conheciam" },
        { "hebraico": "בִּנְתִיבֹ֥ות", "transliteral": "bin-ṯî-ḇō-wṯ", "traducao_palavra": "por veredas" },
        { "hebraico": "לֹֽא־", "transliteral": "lō-", "traducao_palavra": "[que] não" },
        { "hebraico": "יָדְע֖וּ", "transliteral": "yā-ḏə-ʿū", "traducao_palavra": "conheciam" },
        { "hebraico": "אַדְרִיכֵ֑ם", "transliteral": "ʾaḏ-rî-ḵêm", "traducao_palavra": "os farei andar" },
        { "hebraico": "אָשִׂים֩", "transliteral": "ʾā-śîm", "traducao_palavra": "porei" },
        { "hebraico": "מַחְשָׁ֨ךְ", "transliteral": "maḥ-šāḵ", "traducao_palavra": "trevas" },
        { "hebraico": "לִפְנֵיהֶ֜ם", "transliteral": "lip̄-nê-hem", "traducao_palavra": "diante deles" },
        { "hebraico": "לָאֹ֗ור", "transliteral": "lā-ʾō-wr", "traducao_palavra": "em luz" },
        { "hebraico": "וּמַעֲקַשִּׁים֙", "transliteral": "ū-ma-ʿă-qaš-šîm", "traducao_palavra": "e o que é tortuoso" },
        { "hebraico": "לְמִישֹׁ֔ור", "transliteral": "lə-mî-šō-wr", "traducao_palavra": "em retidão/planície" },
        { "hebraico": "אֵ֤לֶּה", "transliteral": "ʾēl-leh", "traducao_palavra": "estas [são]" },
        { "hebraico": "הַדְּבָרִים֙", "transliteral": "had-də-ḇā-rîm", "traducao_palavra": "as coisas" },
        { "hebraico": "עֲשִׂיתִ֔ם", "transliteral": "ʿă-śî-ṯim", "traducao_palavra": "[que] lhes farei" },
        { "hebraico": "וְלֹ֥א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "עֲזַבְתִּֽים׃", "transliteral": "ʿă-zaḇ-tîm", "traducao_palavra": "os desampararei." }
      ]
    },
    "17": {
      "traducao_completa": "Tornar-se-ão atrás e confundir-se-ão de vergonha os que confiam em imagens de escultura, que dizem às imagens de fundição: Vós sois nossos deuses.",
      "palavras": [
        { "hebraico": "נָסֹ֨גוּ", "transliteral": "nā-śō-ḡū", "traducao_palavra": "Tornaram-se" },
        { "hebraico": "אָחֹ֜ור", "transliteral": "ʾā-ḥō-wr", "traducao_palavra": "atrás" },
        { "hebraico": "יֵבֹ֣שׁוּ", "transliteral": "yē-ḇō-šū", "traducao_palavra": "envergonhar-se-ão" },
        { "hebraico": "בֹ֗שֶׁת", "transliteral": "ḇō-šeṯ", "traducao_palavra": "[com] vergonha" },
        { "hebraico": "הַבֹּטְחִים֙", "transliteral": "hab-bō-ṭə-ḥîm", "traducao_palavra": "os que confiam" },
        { "hebraico": "בַּפָּ֔סֶל", "transliteral": "bap-pā-sel", "traducao_palavra": "na imagem de escultura" },
        { "hebraico": "הָאֹמְרִ֥ים", "transliteral": "hā-ʾō-mə-rîm", "traducao_palavra": "os que dizem" },
        { "hebraico": "לְמַסֵּכָ֖ה", "transliteral": "lə-mas-sē-ḵāh", "traducao_palavra": "à imagem de fundição" },
        { "hebraico": "אַתֶּ֥ם", "transliteral": "ʾat-tem", "traducao_palavra": "vós [sois]" },
        { "hebraico": "אֱלֹהֵֽינוּ׃", "transliteral": "ʾĕ-lō-hê-nū", "traducao_palavra": "nossos deuses." }
      ]
    },
    "18": {
      "traducao_completa": "Surdos, ouvi; e vós, cegos, olhai para que vejais.",
      "palavras": [
        { "hebraico": "הַחֵרְשִׁ֖ים", "transliteral": "ha-ḥê-rə-šîm", "traducao_palavra": "Surdos" },
        { "hebraico": "שְׁמָ֑עוּ", "transliteral": "šə-mā-ʿū", "traducao_palavra": "ouvi" },
        { "hebraico": "וְהַעִוְרִ֖ים", "transliteral": "wə-ha-ʿiw-rîm", "traducao_palavra": "e os cegos" },
        { "hebraico": "הַבִּ֥יטוּ", "transliteral": "hab-bî-ṭū", "traducao_palavra": "olhai" },
        { "hebraico": "לִרְאֹֽות׃", "transliteral": "lir-ʾō-wṯ", "traducao_palavra": "para ver." }
      ]
    },
    "19": {
      "traducao_completa": "Quem é cego, senão o meu servo? Ou surdo, como o meu mensageiro que envio? Quem é cego como o que é perfeito, e cego como o servo de YHWH?",
      "palavras": [
        { "hebraico": "מִ֤י", "transliteral": "mî", "traducao_palavra": "Quem" },
        { "hebraico": "עִוֵּר֙", "transliteral": "ʿiw-wēr", "traducao_palavra": "[é] cego" },
        { "hebraico": "כִּ֣י", "transliteral": "kî", "traducao_palavra": "senão" },
        { "hebraico": "אִם־", "transliteral": "ʾim-", "traducao_palavra": "se" },
        { "hebraico": "עַבְדִּ֔י", "transliteral": "ʿaḇ-dî", "traducao_palavra": "meu servo?" },
        { "hebraico": "וְחֵרֵ֖שׁ", "transliteral": "wə-ḥê-rêš", "traducao_palavra": "e surdo" },
        { "hebraico": "כְּמַלְאָכִ֣י", "transliteral": "kə-mal-ʾā-ḵî", "traducao_palavra": "como meu mensageiro" },
        { "hebraico": "אֶשְׁלָ֑ח", "transliteral": "ʾeš-lāḥ", "traducao_palavra": "[que] envio?" },
        { "hebraico": "מִ֤י", "transliteral": "mî", "traducao_palavra": "Quem" },
        { "hebraico": "עִוֵּר֙", "transliteral": "ʿiw-wēr", "traducao_palavra": "[é] cego" },
        { "hebraico": "כִּמְשֻׁלָּ֔ם", "transliteral": "kim-šul-lām", "traducao_palavra": "como o dedicado/perfeito" },
        { "hebraico": "וְעִוֵּ֖ר", "transliteral": "wə-ʿiw-wēr", "traducao_palavra": "e cego" },
        { "hebraico": "כְּעֶ֥בֶד", "transliteral": "kə-ʿe-ḇeḏ", "traducao_palavra": "como o servo de" },
        { "hebraico": "יְהוָֽה׃", "transliteral": "YHWH", "traducao_palavra": "YHWH." }
      ]
    },
    "20": {
      "traducao_completa": "Vês muitas coisas, mas não as observas; abrindo os ouvidos, mas ele não ouve.",
      "palavras": [
        { "hebraico": "רָאֹ֥יתָ", "transliteral": "rā-ʾō-w-ṯā", "traducao_palavra": "Tu viste" },
        { "hebraico": "רַבֹּ֖ות", "transliteral": "rab-bō-wṯ", "traducao_palavra": "muitas coisas" },
        { "hebraico": "וְלֹ֣א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "תִשְׁמֹ֑ר", "transliteral": "tiš-mōr", "traducao_palavra": "observaste" },
        { "hebraico": "פָּקֹ֥וחַ", "transliteral": "pā-qō-w-aḥ", "traducao_palavra": "abrir" },
        { "hebraico": "אָזְנַ֖יִם", "transliteral": "ʾā-zə-na-yim", "traducao_palavra": "ouvidos" },
        { "hebraico": "וְלֹ֥א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "יִשְׁמָֽע׃", "transliteral": "yiš-mā-ʿ", "traducao_palavra": "ele ouve." }
      ]
    },
    "21": {
      "traducao_completa": "YHWH se agradou, por causa da sua justiça, em engrandecer a lei e torná-la gloriosa.",
      "palavras": [
        { "hebraico": "יְהוָ֥ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "חָפֵ֖ץ", "transliteral": "ḥā-p̄ēṣ", "traducao_palavra": "agradou-se/quis" },
        { "hebraico": "לְמַ֣עַן", "transliteral": "lə-ma-ʿan", "traducao_palavra": "por causa de" },
        { "hebraico": "צִדְקֹ֑ו", "transliteral": "ṣiḏ-qō-w", "traducao_palavra": "sua justiça" },
        { "hebraico": "יַגְדִּ֥יל", "transliteral": "yaḡ-dîl", "traducao_palavra": "engrandecerá" },
        { "hebraico": "תֹּורָ֖ה", "transliteral": "tō-w-rāh", "traducao_palavra": "a lei" },
        { "hebraico": "וְיַאְדִּֽיר׃", "transliteral": "wə-ya-ʾdîr", "traducao_palavra": "e tornará gloriosa." }
      ]
    },
    "22": {
      "traducao_completa": "Mas este é um povo roubado e saqueado; todos eles estão enlaçados em covas, e escondidos em cárceres; foram postos por presa, e não há quem os livre; por despojo, e não há quem diga: Restitui.",
      "palavras": [
        { "hebraico": "וְה֤וּא", "transliteral": "wə-hū", "traducao_palavra": "Mas ele" },
        { "hebraico": "עַם־", "transliteral": "ʿam-", "traducao_palavra": "[é] um povo" },
        { "hebraico": "בָּזוּז֙", "transliteral": "bā-zūz", "traducao_palavra": "roubado" },
        { "hebraico": "וְשָׁס֔וּי", "transliteral": "wə-šā-śū-y", "traducao_palavra": "e saqueado" },
        { "hebraico": "הָפֵ֤חַ", "transliteral": "hā-p̄ê-aḥ", "traducao_palavra": "estão enlaçados" },
        { "hebraico": "בַּחוּרִים֙", "transliteral": "ba-ḥū-rîm", "traducao_palavra": "em buracos/covas" },
        { "hebraico": "כֻּלָּ֔ם", "transliteral": "kul-lām", "traducao_palavra": "todos eles" },
        { "hebraico": "וּבְבָתֵּ֥י", "transliteral": "ū-ḇə-ḇāt-tê", "traducao_palavra": "e em casas de" },
        { "hebraico": "כְלָאִ֖ים", "transliteral": "ḵə-lā-ʾîm", "traducao_palavra": "cárceres" },
        { "hebraico": "הָחְבָּ֑אוּ", "transliteral": "hā-ḥə-bā-ʾū", "traducao_palavra": "foram escondidos" },
        { "hebraico": "הָי֤וּ", "transliteral": "hā-yū", "traducao_palavra": "foram" },
        { "hebraico": "לָבַז֙", "transliteral": "lā-ḇaz", "traducao_palavra": "por presa" },
        { "hebraico": "וְאֵ֣ין", "transliteral": "wə-ʾên", "traducao_palavra": "e não há" },
        { "hebraico": "מַצִּ֔יל", "transliteral": "maṣ-ṣîl", "traducao_palavra": "salvador/livrador" },
        { "hebraico": "מְשִׁסָּ֖ה", "transliteral": "mə-šis-sāh", "traducao_palavra": "por despojo" },
        { "hebraico": "וְאֵין־", "transliteral": "wə-ʾên-", "traducao_palavra": "e não há" },
        { "hebraico": "אֹמֵ֥ר", "transliteral": "ʾō-mēr", "traducao_palavra": "quem diga" },
        { "hebraico": "הָשַֽׁב׃", "transliteral": "hā-šaḇ", "traducao_palavra": "restitui." }
      ]
    },
    "23": {
      "traducao_completa": "Quem entre vós dará ouvidos a isto? Quem atenderá e ouvirá o que há de vir?",
      "palavras": [
        { "hebraico": "מִ֥י", "transliteral": "mî", "traducao_palavra": "Quem" },
        { "hebraico": "בָכֶ֖ם", "transliteral": "ḇā-ḵem", "traducao_palavra": "entre vós" },
        { "hebraico": "יַאֲזִ֣ין", "transliteral": "ya-ʾă-zîn", "traducao_palavra": "dará ouvidos a" },
        { "hebraico": "זֹ֑את", "transliteral": "zōṯ", "traducao_palavra": "isto?" },
        { "hebraico": "יַקְשִׁ֥ב", "transliteral": "yaq-šiḇ", "traducao_palavra": "atenderá" },
        { "hebraico": "וְיִשְׁמַ֖ע", "transliteral": "wə-yiš-ma-ʿ", "traducao_palavra": "e ouvirá" },
        { "hebraico": "לְאָחֹֽור׃", "transliteral": "lə-ʾā-ḥō-wr", "traducao_palavra": "para o futuro/atrás." }
      ]
    },
    "24": {
      "traducao_completa": "Quem entregou Jacó por despojo, e Israel aos roubadores? Porventura não foi YHWH, aquele contra quem pecamos? Pois não quiseram andar nos seus caminhos, nem deram ouvidos à sua lei.",
      "palavras": [
