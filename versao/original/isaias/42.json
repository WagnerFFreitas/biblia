        { "hebraico": "וּמְלֹאֹ֔ו", "transliteral": "ū-mə-lō-ʾō-w", "traducao_palavra": "e sua plenitude/tudo nele" },
        { "hebraico": "אִיִּ֖ים", "transliteral": "ʾiy-yîm", "traducao_palavra": "ilhas" },
        { "hebraico": "וְיֹשְׁבֵיהֶֽם׃", "transliteral": "wə-yō-šə-ḇê-hem", "traducao_palavra": "e seus habitantes." }
      ]
    },
    "11": {
      "traducao_completa": "Alcem a voz o deserto e as suas cidades, com as aldeias que Quedar habita; exultem os que habitam nas rochas, e clamem do cume dos montes.",
      "palavras": [
        { "hebraico": "יִשְׂא֤וּ", "transliteral": "yiś-ʾū", "traducao_palavra": "Alcem [a voz]" },
