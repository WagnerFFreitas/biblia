        { "hebraico": "עָלֶ֙יךָ֙", "transliteral": "ʿā-le-ḵā", "traducao_palavra": "sobre ti" },
        { "hebraico": "רַבִּ֔ים", "transliteral": "rab-bîm", "traducao_palavra": "muitos" },
