    "4": {
      "traducao_completa": "O meu coração vacila, o horror me apavora; a noite do meu prazer se me tornou em espanto.",
      "palavras": [
        { "hebraico": "תָּ֘עָ֤ה", "transliteral": "tā-ʿā", "traducao_palavra": "Vacilou/errou" },
