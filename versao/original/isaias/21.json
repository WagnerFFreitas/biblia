      ]
    },
    "8": {
      "traducao_completa": "Então gritou como um leão: Senhor, sobre a torre de vigia estou em pé continuamente de dia, e no meu posto me ponho noites inteiras.",
      "palavras": [
        { "hebraico": "וַיִּקְרָ֖א", "transliteral": "way-yiq-rā", "traducao_palavra": "E gritou" },
        { "hebraico": "אַרְיֵ֑ה", "transliteral": "ʾar-yê", "traducao_palavra": "[como um] leão" },
        { "hebraico": "עַל־מִצְפֶּ֨ה", "transliteral": "ʿal-miṣ-peh", "traducao_palavra": "Sobre [a] torre de vigia" },
