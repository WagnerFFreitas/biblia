        { "hebraico": "מַשָּׂ֖א", "transliteral": "maś-śāʾ", "traducao_palavra": "Oráculo/peso" },
        { "hebraico": "דּוּמָ֑ה", "transliteral": "dû-mā", "traducao_palavra": "Dumá [Edom]" },
        { "hebraico": "אֵלַי֙", "transliteral": "ʾê-lay", "traducao_palavra": "a mim" },
        { "hebraico": "קֹרֵ֣א", "transliteral": "qō-rē", "traducao_palavra": "clama" },
        { "hebraico": "מִשֵּׂעִ֔יר", "transliteral": "miś-śê-ʿîr", "traducao_palavra": "de Seir" },
        { "hebraico": "שֹׁמֵר֙", "transliteral": "šō-mêr", "traducao_palavra": "guarda" },
        { "hebraico": "מַה־", "transliteral": "mah-", "traducao_palavra": "o que [há]" },
        { "hebraico": "מִלַּ֔יְלָה", "transliteral": "mil-lay-lā", "traducao_palavra": "da noite?" },
        { "hebraico": "שֹׁמֵ֖ר", "transliteral": "šō-mêr", "traducao_palavra": "guarda" },
        { "hebraico": "מַה־", "transliteral": "mah-", "traducao_palavra": "o que [há]" },
        { "hebraico": "מִלֵּֽיל׃", "transliteral": "mil-lêl", "traducao_palavra": "da noite?" }
      ]
    },
    "12": {
      "traducao_completa": "Respondeu o guarda: Vem a manhã, e também a noite; se quereis perguntar, perguntai; voltai, vinde.",
      "palavras": [
        { "hebraico": "אָמַ֣ר", "transliteral": "ʾā-mar", "traducao_palavra": "Disse" },
        { "hebraico": "שֹׁמֵ֔ר", "transliteral": "šō-mêr", "traducao_palavra": "[o] guarda" },
