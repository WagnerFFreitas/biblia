        { "hebraico": "עָרֹ֧ךְ", "transliteral": "ʿā-rōḵ", "traducao_palavra": "Preparar" },
        { "hebraico": "הַשֻּׁלְחָ֛ן", "transliteral": "haš-šul-ḥān", "traducao_palavra": "a mesa" },
        { "hebraico": "צָפֹ֥ה", "transliteral": "ṣā-p̄ō", "traducao_palavra": "vigiar/pôr" },
        { "hebraico": "הַצָּפִ֖ית", "transliteral": "haṣ-ṣā-p̄îṯ", "traducao_palavra": "a sentinela" },
