        { "hebraico": "גָּמָ֑ל", "transliteral": "gā-māl", "traducao_palavra": "camelo" },
        { "hebraico": "וְהִקְשִׁ֥יב", "transliteral": "wə-hiq-šîḇ", "traducao_palavra": "e escute" },
        { "hebraico": "קֶ֖שֶׁב", "transliteral": "qe-šeḇ", "traducao_palavra": "[com] atenção" },
