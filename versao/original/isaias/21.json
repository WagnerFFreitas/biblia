        { "hebraico": "אֲשֶׁ֥ר", "transliteral": "ʾă-šer", "traducao_palavra": "o que" },
        { "hebraico": "יִרְאֶ֖ה", "transliteral": "yir-ʾeh", "traducao_palavra": "vir" },
        { "hebraico": "יַגִּֽיד׃", "transliteral": "yag-gîḏ", "traducao_palavra": "que anuncie" }
      ]
    },
    "7": {
      "traducao_completa": "E quando vir uma carruagem com um par de cavaleiros, uma carruagem com jumentos, ou uma carruagem com camelos, que escute com muita atenção.",
      "palavras": [
        { "hebraico": "וְרָאָ֣ה", "transliteral": "wə-rā-ʾā", "traducao_palavra": "E quando vir" },
        { "hebraico": "רֶ֗כֶב", "transliteral": "re-ḵeḇ", "traducao_palavra": "[uma] carruagem" },
        { "hebraico": "צֶ֚מֶד", "transliteral": "ṣe-meḏ", "traducao_palavra": "par de" },
        { "hebraico": "פָּרָשִׁ֔ים", "transliteral": "pā-rā-šîm", "traducao_palavra": "cavaleiros" },
