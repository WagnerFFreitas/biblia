        { "hebraico": "לָכֶֽם׃", "transliteral": "lā-ḵem", "traducao_palavra": "a vós" }
      ]
    },
    "11": {
      "traducao_completa": "Oráculo contra Dumá: Clama-me alguém de Seir: Guarda, que há da noite? Guarda, que há da noite?",
