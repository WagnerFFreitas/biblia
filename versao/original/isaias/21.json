        { "hebraico": "עֹמֵ֤ד", "transliteral": "ʿō-mêḏ", "traducao_palavra": "estou de pé" },
        { "hebraico": "תָּמִיד֙", "transliteral": "tā-mîḏ", "traducao_palavra": "sempre" },
        { "hebraico": "יֹומָ֔ם", "transliteral": "yô-mām", "traducao_palavra": "de dia" },
        { "hebraico": "וְעַל־מִשְׁמַרְתִּ֛י", "transliteral": "wə-ʿal-miš-mar-tî", "traducao_palavra": "e no meu posto/guarda" },
