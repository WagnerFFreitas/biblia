        { "hebraico": "בָּבֶ֑ל", "transliteral": "bā-ḇel", "traducao_palavra": "Babilônia" },
        { "hebraico": "וְכָל־פְּסִילֵ֥י", "transliteral": "wə-ḵāl-pə-śî-lê", "traducao_palavra": "e todos os ídolos de" },
        { "hebraico": "אֱלֹהֶ֖יהָ", "transliteral": "ʾĕ-lō-he-hā", "traducao_palavra": "seus deuses" },
