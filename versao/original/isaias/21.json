        { "hebraico": "מָגֵֽן׃", "transliteral": "mā-ḡên", "traducao_palavra": "[o] escudo" }
      ]
    },
    "6": {
      "traducao_completa": "Porque assim me disse o Senhor: Vai, põe uma sentinela; o que ela vir, que o anuncie.",
      "palavras": [
        { "hebraico": "כִּ֣י", "transliteral": "kî", "traducao_palavra": "Porque" },
        { "hebraico": "כֹה֙", "transliteral": "ḵō", "traducao_palavra": "assim" },
        { "hebraico": "אָמַ֤ר", "transliteral": "ʾā-mar", "traducao_palavra": "disse" },
        { "hebraico": "אֵלַי֙", "transliteral": "ʾê-lay", "traducao_palavra": "a mim" },
        { "hebraico": "אֲדֹנָ֔י", "transliteral": "ʾă-ḏō-nāy", "traducao_palavra": "o Senhor" },
        { "hebraico": "לֵ֖ךְ", "transliteral": "lêḵ", "traducao_palavra": "vai" },
