    "9": {
      "traducao_completa": "E eis que agora vem uma carruagem de homens com um par de cavaleiros. Então respondeu ele e disse: Caiu, caiu a Babilônia; e todas as imagens de escultura dos seus deuses ele despedaçou contra a terra.",
      "palavras": [
        { "hebraico": "וְהִנֵּה־זֶ֥ה", "transliteral": "wə-hin-nē-zeh", "traducao_palavra": "E eis que este" },
        { "hebraico": "בָ֣א", "transliteral": "ḇā", "traducao_palavra": "vem" },
        { "hebraico": "רֶ֤כֶב", "transliteral": "re-ḵeḇ", "traducao_palavra": "[em] carruagem [de]" },
        { "hebraico": "אִשׁ֙", "transliteral": "ʾîš", "traducao_palavra": "homens" },
        { "hebraico": "צֶ֣מֶד", "transliteral": "ṣe-meḏ", "traducao_palavra": "par de" },
        { "hebraico": "פָּרָשִׁ֔ים", "transliteral": "pā-rā-šîm", "traducao_palavra": "cavaleiros" },
        { "hebraico": "וַיַּ֥עַן", "transliteral": "way-ya-ʿan", "traducao_palavra": "e ele respondeu" },
