        { "hebraico": "הַבֹּוגֵ֤ד ׀", "transliteral": "hab-bô-ḡēḏ", "traducao_palavra": "o traidor" },
        { "hebraico": "בֹּוגֵד֙", "transliteral": "bô-ḡêḏ", "traducao_palavra": "trai/age perfidamente" },
        { "hebraico": "וְהַשֹּׁודֵ֣ד", "transliteral": "wə-haš-šô-ḏêḏ", "traducao_palavra": "e o destruidor" },
        { "hebraico": "שֹׁודֵ֔ד", "transliteral": "šô-ḏêḏ", "traducao_palavra": "destrói" },
