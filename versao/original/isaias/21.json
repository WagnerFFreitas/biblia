        { "hebraico": "לָאָֽרֶץ׃", "transliteral": "lā-ʾā-reṣ", "traducao_palavra": "por terra" }
      ]
    },
    "10": {
      "traducao_completa": "Ó debulha minha e fruto da minha eira! O que ouvi de YHWH dos Exércitos, Deus de Israel, isso vos anunciei.",
      "palavras": [
        { "hebraico": "מְדֻשָׁתִ֖י", "transliteral": "mə-ḏu-šā-ṯî", "traducao_palavra": "Ó debulha minha" },
        { "hebraico": "וּבֶן־גָּרְנִ֑י", "transliteral": "ū-ḇen-gā-rə-nî", "traducao_palavra": "e filho da minha eira" },
