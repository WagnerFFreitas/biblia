    "3": {
      "traducao_completa": "O lagar eu o pisei sozinho, e dos povos ninguém estava comigo; e os pisei na minha ira, e os esmaguei no meu furor; e o seu sangue salpicou as minhas vestes, e manchei toda a minha vestidura.",
      "palavras": [
        { "hebraico": "פּוּרָה֙", "transliteral": "pū-rāh", "traducao_palavra": "[O] lagar" },
        { "hebraico": "דָּרַ֣כְתִּי", "transliteral": "dā-raḵ-tî", "traducao_palavra": "pisei" },
        { "hebraico": "לְבַדִּ֔י", "transliteral": "lə-ḇad-dî", "traducao_palavra": "sozinho" },
        { "hebraico": "וּמֵֽעַמִּ֖ים", "transliteral": "ū-mē-ʿam-mîm", "traducao_palavra": "e dos povos" },
        { "hebraico": "אֵֽין־", "transliteral": "ʾên-", "traducao_palavra": "não havia" },
        { "hebraico": "אִ֣ישׁ", "transliteral": "ʾîš", "traducao_palavra": "homem/ninguém" },
        { "hebraico": "אִתִּ֑י", "transliteral": "ʾit-tî", "traducao_palavra": "comigo" },
        { "hebraico": "וְאֶדְרְכֵ֣ם", "transliteral": "wə-ʾeḏ-rə-ḵêm", "traducao_palavra": "e os pisei" },
        { "hebraico": "בְּאַפִּ֗י", "transliteral": "bə-ʾap-pî", "traducao_palavra": "na minha ira" },
        { "hebraico": "וְאֶרְמְסֵ֥ם", "transliteral": "wə-ʾer-mə-śêm", "traducao_palavra": "e os esmaguei" },
        { "hebraico": "בַּחֲמָתִ֑י", "transliteral": "ba-ḥă-mā-ṯî", "traducao_palavra": "no meu furor" },
        { "hebraico": "וְיֵ֨ז", "transliteral": "wə-yêz", "traducao_palavra": "e espirrou/salpicou" },
        { "hebraico": "נִצְחָם֙", "transliteral": "niṣ-ḥām", "traducao_palavra": "o suco/sangue deles" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre" },
        { "hebraico": "בְּגָדַ֔י", "transliteral": "bə-ḡā-ḏay", "traducao_palavra": "minhas vestes" },
        { "hebraico": "וְכָל־", "transliteral": "wə-ḵāl-", "traducao_palavra": "e toda" },
        { "hebraico": "מַלְבּוּשַׁ֖י", "transliteral": "mal-bū-šay", "traducao_palavra": "minha vestidura" },
        { "hebraico": "אֶגְאָֽלְתִּי׃", "transliteral": "ʾeḡ-ʾā-lə-tî", "traducao_palavra": "manchei/contaminei." }
      ]
    },
    "4": {
      "traducao_completa": "Porque o dia da vingança estava no meu coração; e o ano dos meus redimidos é chegado.",
      "palavras": [
        { "hebraico": "כִּ֛י", "transliteral": "kî", "traducao_palavra": "Porque" },
        { "hebraico": "יֹ֥ום", "transliteral": "yō-wm", "traducao_palavra": "[o] dia de" },
        { "hebraico": "נָקָ֖ם", "transliteral": "nā-qām", "traducao_palavra": "vingança" },
        { "hebraico": "בְּלִבִּ֑י", "transliteral": "bə-lib-bî", "traducao_palavra": "em meu coração" },
        { "hebraico": "וּשְׁנַ֥ת", "transliteral": "ū-šə-naṯ", "traducao_palavra": "e o ano de" },
        { "hebraico": "גְּאוּלַ֖י", "transliteral": "gə-ʾū-lay", "traducao_palavra": "meus remidos" },
        { "hebraico": "בָּאָֽה׃", "transliteral": "bā-ʾāh", "traducao_palavra": "chegou." }
      ]
    },
    "5": {
      "traducao_completa": "E olhei, e não havia quem me ajudasse; e espantei-me de não haver quem me sustivesse; pelo que o meu próprio braço me trouxe a salvação, e o meu furor me susteve.",
      "palavras": [
        { "hebraico": "וְאַבִּ֥יט", "transliteral": "wə-ʾab-bîṭ", "traducao_palavra": "E olhei" },
        { "hebraico": "וְאֵ֣ין", "transliteral": "wə-ʾên", "traducao_palavra": "e não havia" },
        { "hebraico": "עֹזֵ֔ר", "transliteral": "ʿō-zēr", "traducao_palavra": "ajudador" },
        { "hebraico": "וָאֶשְׁתֹּומֵ֖ם", "transliteral": "wā-ʾeš-tō-w-mêm", "traducao_palavra": "e espantei-me" },
        { "hebraico": "וְאֵ֣ין", "transliteral": "wə-ʾên", "traducao_palavra": "visto que não havia" },
        { "hebraico": "סֹומֵ֑ךְ", "transliteral": "śō-w-mêḵ", "traducao_palavra": "quem sustivesse" },
        { "hebraico": "וַתֹּ֤ושַׁע", "transliteral": "wat-tō-w-ša-ʿ", "traducao_palavra": "e trouxe salvação" },
        { "hebraico": "לִי֙", "transliteral": "lî", "traducao_palavra": "para mim" },
        { "hebraico": "זְרֹעִ֔י", "transliteral": "zə-rō-ʿî", "traducao_palavra": "meu braço" },
        { "hebraico": "וַחֲמָתִ֖י", "transliteral": "wa-ḥă-mā-ṯî", "traducao_palavra": "e meu furor" },
        { "hebraico": "הִ֥יא", "transliteral": "hî", "traducao_palavra": "ele" },
        { "hebraico": "סְמָכָֽתְנִי׃", "transliteral": "śə-mā-ḵā-ṯə-nî", "traducao_palavra": "sustentou-me." }
      ]
    },
    "6": {
      "traducao_completa": "E pisei os povos na minha ira, e os embriaguei no meu furor; e derramei o seu sangue por terra.",
      "palavras": [
        { "hebraico": "וְאָב֥וּס", "transliteral": "wə-ʾā-ḇūś", "traducao_palavra": "E pisei" },
        { "hebraico": "עַמִּ֛ים", "transliteral": "ʿam-mîm", "traducao_palavra": "povos" },
        { "hebraico": "בְּאַפִּ֖י", "transliteral": "bə-ʾap-pî", "traducao_palavra": "na minha ira" },
        { "hebraico": "וַאֲשַׁכְּרֵ֣ם", "transliteral": "wa-ʾă-šak-kə-rêm", "traducao_palavra": "e os embriaguei" },
        { "hebraico": "בַּחֲמָתִ֑י", "transliteral": "ba-ḥă-mā-ṯî", "traducao_palavra": "no meu furor" },
        { "hebraico": "וְאֹורִ֥יד", "transliteral": "wə-ʾō-w-rîḏ", "traducao_palavra": "e fiz descer" },
        { "hebraico": "לָאָ֖רֶץ", "transliteral": "lā-ʾā-reṣ", "traducao_palavra": "para a terra" },
        { "hebraico": "נִצְחָֽם׃", "transliteral": "niṣ-ḥām", "traducao_palavra": "o sangue/suco deles." }
      ]
    },
    "7": {
      "traducao_completa": "As benignidades de YHWH mencionarei, e os louvores de YHWH, conforme tudo quanto YHWH nos concedeu; e a grande bondade para com a casa de Israel, que lhes concedeu segundo as suas misericórdias e segundo a multidão das suas benignidades.",
      "palavras": [
        { "hebraico": "חַסְדֵ֨י", "transliteral": "ḥas-ḏê", "traducao_palavra": "[As] misericórdias de" },
        { "hebraico": "יְהוָ֜ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "אַזְכִּ֗יר", "transliteral": "ʾaz-kîr", "traducao_palavra": "mencionarei/lembrarei" },
        { "hebraico": "תְּהִלֹּ֣ת", "transliteral": "tə-hil-lōṯ", "traducao_palavra": "louvores de" },
        { "hebraico": "יְהוָה֮", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "כְּעַ֣ל", "transliteral": "kə-ʿal", "traducao_palavra": "conforme" },
        { "hebraico": "כֹּל־", "transliteral": "kōl-", "traducao_palavra": "tudo" },
        { "hebraico": "אֲשֶׁר־", "transliteral": "ʾă-šer-", "traducao_palavra": "que" },
        { "hebraico": "גְּמָלָ֣נוּ", "transliteral": "ḡə-mā-lā-nū", "traducao_palavra": "concedeu a nós" },
        { "hebraico": "יְהוָה֒", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "וְרַב־", "transliteral": "wə-rab-", "traducao_palavra": "e grande [é]" },
        { "hebraico": "טוּב֙", "transliteral": "ṭūḇ", "traducao_palavra": "[a] bondade" },
        { "hebraico": "לְבֵ֣ית", "transliteral": "lə-ḇêṯ", "traducao_palavra": "para a casa de" },
        { "hebraico": "יִשְׂרָאֵ֔ל", "transliteral": "yiś-rā-ʾēl", "traducao_palavra": "Israel" },
        { "hebraico": "אֲשֶׁר־", "transliteral": "ʾă-šer-", "traducao_palavra": "que" },
        { "hebraico": "גְּמָלָ֥ם", "transliteral": "ḡə-mā-lām", "traducao_palavra": "concedeu a eles" },
        { "hebraico": "כְּרַחֲמָ֖יו", "transliteral": "kə-ra-ḥă-māy-w", "traducao_palavra": "segundo suas misericórdias" },
        { "hebraico": "וּכְרֹ֥ב", "transliteral": "ū-ḵə-rōḇ", "traducao_palavra": "e segundo a multidão de" },
