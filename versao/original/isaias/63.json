      ]
    },
    "8": {
      "traducao_completa": "Porque ele disse: Certamente eles são o meu povo, filhos que não mentirão; e ele se lhes tornou o seu Salvador.",
      "palavras": [
        { "hebraico": "וַיֹּ֤אמֶר", "transliteral": "way-yō-mer", "traducao_palavra": "E disse" },
        { "hebraico": "אַךְ־", "transliteral": "ʾaḵ-", "traducao_palavra": "Certamente" },
        { "hebraico": "עַמִּ֣י", "transliteral": "ʿam-mî", "traducao_palavra": "povo meu [são]" },
        { "hebraico": "הֵ֔מָּה", "transliteral": "hêm-māh", "traducao_palavra": "eles" },
        { "hebraico": "בָּנִ֖ים", "transliteral": "bā-nîm", "traducao_palavra": "filhos" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "[que] não" },
        { "hebraico": "יְשַׁקֵּ֑רוּ", "transliteral": "yə-šaq-qê-rū", "traducao_palavra": "mentirão/serão falsos" },
        { "hebraico": "וַיְהִ֥י", "transliteral": "way-hî", "traducao_palavra": "e foi/tornou-se" },
        { "hebraico": "לָהֶ֖ם", "transliteral": "lā-hem", "traducao_palavra": "para eles" },
        { "hebraico": "לְמֹושִֽׁיעַ׃", "transliteral": "lə-mō-w-šî-aʿ", "traducao_palavra": "por Salvador." }
      ]
    },
    "9": {
      "traducao_completa": "Em toda a angústia deles foi ele angustiado, e o anjo da sua presença os salvou; pelo seu amor, e pela sua compaixão ele os remiu; e os tomou, e os carregou todos os dias da antiguidade.",
      "palavras": [
        { "hebraico": "בְּכָל־", "transliteral": "bə-ḵāl-", "traducao_palavra": "Em toda" },
        { "hebraico": "צָרָתָ֣ם ׀", "transliteral": "ṣā-rā-ṯām", "traducao_palavra": "angústia deles" },
        { "hebraico": "לו", "transliteral": "lō", "traducao_palavra": "[Qere: lōw - para ele / Ketiv: lōʾ - não]" },
        { "hebraico": "צָ֗ר", "transliteral": "ṣār", "traducao_palavra": "[foi] angustiado/estreito" },
        { "hebraico": "וּמַלְאַ֧ךְ", "transliteral": "ū-mal-ʾaḵ", "traducao_palavra": "e o anjo de" },
        { "hebraico": "פָּנָ֛יו", "transliteral": "pā-nāy-w", "traducao_palavra": "sua face/presença" },
        { "hebraico": "הֹושִׁיעָ֑ם", "transliteral": "hō-w-šî-ʿām", "traducao_palavra": "salvou eles" },
        { "hebraico": "בְּאַהֲבָתֹ֥ו", "transliteral": "bə-ʾa-hă-ḇā-ṯō-w", "traducao_palavra": "no seu amor" },
        { "hebraico": "וּבְחֶמְלָתֹ֖ו", "transliteral": "ū-ḇə-ḥem-lā-ṯō-w", "traducao_palavra": "e na sua compaixão" },
        { "hebraico": "ה֣וּא", "transliteral": "hū", "traducao_palavra": "ele" },
        { "hebraico": "גְאָלָ֑ם", "transliteral": "ḡə-ʾā-lām", "traducao_palavra": "remiu eles" },
        { "hebraico": "וַֽיְנַטְּלֵ֥ם", "transliteral": "way-naṭ-ṭə-lêm", "traducao_palavra": "e os levantou" },
        { "hebraico": "וַֽיְנַשְּׂאֵ֖ם", "transliteral": "way-naś-śə-ʾêm", "traducao_palavra": "e os carregou" },
        { "hebraico": "כָּל־", "transliteral": "kāl-", "traducao_palavra": "todos" },
        { "hebraico": "יְמֵ֥י", "transliteral": "yə-mê", "traducao_palavra": "[os] dias de" },
        { "hebraico": "עֹולָֽם׃", "transliteral": "ʿō-w-lām", "traducao_palavra": "antiguidade." }
      ]
    },
    "10": {
      "traducao_completa": "Mas eles foram rebeldes e contristaram o seu Espírito Santo; pelo que se lhes tornou em inimigo, e ele mesmo pelejou contra eles.",
      "palavras": [
        { "hebraico": "וְהֵ֨מָּה", "transliteral": "wə-hêm-māh", "traducao_palavra": "Mas eles" },
        { "hebraico": "מָר֧וּ", "transliteral": "mā-rū", "traducao_palavra": "foram rebeldes" },
        { "hebraico": "וְעִצְּב֛וּ", "transliteral": "wə-ʿiṣ-ṣə-ḇū", "traducao_palavra": "e contristaram/afligiram" },
        { "hebraico": "אֶת־", "transliteral": "ʾeṯ-", "traducao_palavra": "[partícula acusativa]" },
        { "hebraico": "ר֥וּחַ", "transliteral": "rū-aḥ", "traducao_palavra": "[o] Espírito de" },
        { "hebraico": "קָדְשֹׁ֖ו", "transliteral": "qāḏ-šō-w", "traducao_palavra": "sua santidade" },
        { "hebraico": "וַיֵּהָפֵ֥ךְ", "transliteral": "way-yê-hā-p̄êḵ", "traducao_palavra": "e ele se tornou/mudou" },
        { "hebraico": "לָהֶ֛ם", "transliteral": "lā-hem", "traducao_palavra": "para eles" },
        { "hebraico": "לְאֹויֵ֖ב", "transliteral": "lə-ʾō-w-yēḇ", "traducao_palavra": "em inimigo" },
        { "hebraico": "ה֥וּא", "transliteral": "hū", "traducao_palavra": "ele [mesmo]" },
        { "hebraico": "נִלְחַם־", "transliteral": "nil-ḥam-", "traducao_palavra": "pelejou/lutou" },
        { "hebraico": "בָּֽם׃", "transliteral": "bām", "traducao_palavra": "contra eles." }
      ]
    },
    "11": {
      "traducao_completa": "Então se lembrou dos dias da antiguidade, de Moisés e do seu povo, dizendo: Onde está aquele que os fez subir do mar com os pastores do seu rebanho? Onde está o que pôs no meio deles o seu Espírito Santo?",
      "palavras": [
        { "hebraico": "וַיִּזְכֹּ֥ר", "transliteral": "way-yiz-kōr", "traducao_palavra": "Então lembrou-se" },
