        { "hebraico": "מִבָּצְרָ֔ה", "transliteral": "mib-bā-ṣə-rāh", "traducao_palavra": "de Bozra" },
        { "hebraico": "זֶ֚ה", "transliteral": "zeh", "traducao_palavra": "este" },
        { "hebraico": "הָד֣וּר", "transliteral": "hā-ḏūr", "traducao_palavra": "glorioso/esplêndido" },
        { "hebraico": "בִּלְבוּשֹׁ֔ו", "transliteral": "bil-ḇū-šō-w", "traducao_palavra": "em sua vestidura" },
        { "hebraico": "צֹעֶ֖ה", "transliteral": "ṣō-ʿeh", "traducao_palavra": "marchando/inclinando-se" },
        { "hebraico": "בְּרֹ֣ב", "transliteral": "bə-rōḇ", "traducao_palavra": "na multidão de" },
        { "hebraico": "כֹּחֹ֑ו", "transliteral": "kō-ḥō-w", "traducao_palavra": "sua força" },
        { "hebraico": "אֲנִ֛י", "transliteral": "ʾă-nî", "traducao_palavra": "Eu" },
        { "hebraico": "מְדַבֵּ֥ר", "transliteral": "mə-ḏab-bēr", "traducao_palavra": "[que] falo" },
        { "hebraico": "בְּצִדְקָ֖ה", "transliteral": "bə-ṣiḏ-qāh", "traducao_palavra": "em justiça" },
        { "hebraico": "רַ֥ב", "transliteral": "rab", "traducao_palavra": "[sou] mui/poderoso" },
        { "hebraico": "לְהֹושִֽׁיעַ׃", "transliteral": "lə-hō-w-šî-aʿ", "traducao_palavra": "para salvar." }
      ]
    },
    "2": {
      "traducao_completa": "Por que está vermelha a tua vestidura, e as tuas vestes como as daquele que pisa no lagar?",
      "palavras": [
        { "hebraico": "מַדּ֥וּעַ", "transliteral": "mad-dū-aʿ", "traducao_palavra": "Por que" },
        { "hebraico": "אָדֹ֖ם", "transliteral": "ʾā-ḏōm", "traducao_palavra": "[está] vermelho" },
        { "hebraico": "לִלְבוּשֶׁ֑ךָ", "transliteral": "lil-ḇū-še-ḵā", "traducao_palavra": "em tua vestidura" },
        { "hebraico": "וּבְגָדֶ֖יךָ", "transliteral": "ū-ḇə-ḡā-ḏe-y-ḵā", "traducao_palavra": "e tuas vestes" },
        { "hebraico": "כְּדֹרֵ֥ךְ", "transliteral": "kə-ḏō-rēḵ", "traducao_palavra": "como [as do] pisador de" },
        { "hebraico": "בְּגַֽת׃", "transliteral": "bə-ḡaṯ", "traducao_palavra": "lagar." }
      ]
