{
  "livro": "Isaías - יְשַֽׁעְיָהוּ - Yəšayāhū",
  "capítulo": 63,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Quem é este que vem de Edom, de Bozra com vestes tingidas? Este que é glorioso em sua vestidura, que marcha na plenitude da sua força? Sou eu, que falo em justiça, poderoso para salvar.",
      "palavras": [
        { "hebraico": "מִֽי־", "transliteral": "mî-", "traducao_palavra": "Quem" },
        { "hebraico": "זֶ֣ה ׀", "transliteral": "zeh", "traducao_palavra": "[é] este" },
        { "hebraico": "בָּ֣א", "transliteral": "bā", "traducao_palavra": "[que] vem" },
        { "hebraico": "מֵאֱדֹ֗ום", "transliteral": "mê-ʾĕ-ḏō-wm", "traducao_palavra": "de Edom" },
        { "hebraico": "חֲמ֤וּץ", "transliteral": "ḥă-mūṣ", "traducao_palavra": "[com] tingidas/vermelhas" },
