        { "hebraico": "בַּתְּהֹמֹ֑ות", "transliteral": "bat-tə-hō-mō-wṯ", "traducao_palavra": "nos abismos/profundezas" },
        { "hebraico": "כַּסּ֥וּס", "transliteral": "kas-śūś", "traducao_palavra": "como o cavalo" },
