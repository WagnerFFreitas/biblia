        { "hebraico": "וִיסַדְתִּ֖יךְ", "transliteral": "wî-śaḏ-tîḵ", "traducao_palavra": "e te fundarei" },
        { "hebraico": "בַּסַּפִּירִֽים׃", "transliteral": "bas-śap-pî-rîm", "traducao_palavra": "com safiras." }
