        { "hebraico": "תִּכֹּונָ֑נִי", "transliteral": "tik-kō-w-nā-nî", "traducao_palavra": "serás estabelecida" },
        { "hebraico": "רַחֲקִ֣י", "transliteral": "ra-ḥă-qî", "traducao_palavra": "afasta-te/estarás longe" },
