        { "hebraico": "מִשְׁפָּטֶ֛יךָ", "transliteral": "miš-pā-ṭe-ḵā", "traducao_palavra": "teus juízos" },
        { "hebraico": "יְהוָ֖ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
