      "traducao_completa": "Tragam-nas e declarem-nos as coisas que hão de acontecer; dizei-nos as coisas passadas, o que são, para que as consideremos e saibamos o fim delas; ou fazei-nos ouvir as coisas vindouras.",
      "palavras": [
        { "hebraico": "יַגִּ֙ישׁוּ֙", "transliteral": "yag-gî-šū", "traducao_palavra": "Tragam" },
        { "hebraico": "וְיַגִּ֣ידוּ", "transliteral": "wə-yag-gî-ḏū", "traducao_palavra": "e declarem" },
        { "hebraico": "לָ֔נוּ", "transliteral": "lā-nū", "traducao_palavra": "a nós" },
        { "hebraico": "אֵ֥ת", "transliteral": "ʾēṯ", "traducao_palavra": "[partícula acusativa]" },
        { "hebraico": "אֲשֶׁ֖ר", "transliteral": "ʾă-šer", "traducao_palavra": "o que" },
        { "hebraico": "תִּקְרֶ֑ינָה", "transliteral": "tiq-re-nāh", "traducao_palavra": "há de acontecer" },
        { "hebraico": "הָרִאשֹׁנֹ֣ות", "transliteral": "hā-ri-šō-nō-wṯ", "traducao_palavra": "as coisas primeiras" },
        { "hebraico": "מָ֣ה", "transliteral": "māh", "traducao_palavra": "o que" },
        { "hebraico": "הֵ֗נָּה", "transliteral": "hên-nāh", "traducao_palavra": "[são] elas" },
        { "hebraico": "הַגִּ֤ידוּ", "transliteral": "hag-gî-ḏū", "traducao_palavra": "declarai" },
        { "hebraico": "וְנָשִׂ֙ימָה֙", "transliteral": "wə-nā-śî-māh", "traducao_palavra": "e consideremos" },
        { "hebraico": "לִבֵּ֔נוּ", "transliteral": "lib-bē-nū", "traducao_palavra": "[em] nosso coração" },
        { "hebraico": "וְנֵדְעָ֖ה", "transliteral": "wə-nê-ḏə-ʿāh", "traducao_palavra": "e saibamos" },
        { "hebraico": "אַחֲרִיתָ֑ן", "transliteral": "ʾa-ḥă-rî-ṯān", "traducao_palavra": "o fim delas" },
        { "hebraico": "אֹ֥ו", "transliteral": "ʾō-w", "traducao_palavra": "ou" },
        { "hebraico": "הַבָּאֹ֖ות", "transliteral": "hab-bā-ʾō-wṯ", "traducao_palavra": "as coisas vindouras" },
        { "hebraico": "הַשְׁמִיעֻֽנוּ׃", "transliteral": "haš-mî-ʿu-nū", "traducao_palavra": "fazei-nos ouvir." }
      ]
    },
    "23": {
      "traducao_completa": "Declarai as coisas que hão de vir depois, para que saibamos que sois deuses; fazei bem ou fazei mal, para que nos assombremos e as vejamos juntamente.",
      "palavras": [
        { "hebraico": "הַגִּ֙ידוּ֙", "transliteral": "hag-gî-ḏū", "traducao_palavra": "Declarai" },
        { "hebraico": "הָאֹתִיֹּ֣ות", "transliteral": "hā-ʾō-ṯiy-yō-wṯ", "traducao_palavra": "as coisas vindo" },
        { "hebraico": "לְאָחֹ֔ור", "transliteral": "lə-ʾā-ḥō-wr", "traducao_palavra": "depois/atrás" },
        { "hebraico": "וְנֵדְעָ֖ה", "transliteral": "wə-nê-ḏə-ʿāh", "traducao_palavra": "e saibamos" },
        { "hebraico": "כִּ֣י", "transliteral": "kî", "traducao_palavra": "que" },
        { "hebraico": "אֱלֹהִ֣ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "deuses" },
        { "hebraico": "אַתֶּ֑ם", "transliteral": "ʾat-tem", "traducao_palavra": "vós [sois]" },
        { "hebraico": "אַף־", "transliteral": "ʾap̄-", "traducao_palavra": "também" },
        { "hebraico": "תֵּיטִ֣יבוּ", "transliteral": "tê-ṭî-ḇū", "traducao_palavra": "fazei o bem" },
        { "hebraico": "וְתָרֵ֔עוּ", "transliteral": "wə-ṯā-rē-ʿū", "traducao_palavra": "ou fazei o mal" },
        { "hebraico": "וְנִשְׁתָּ֖עָה", "transliteral": "wə-niš-tā-ʿāh", "traducao_palavra": "e nos assombremos" },
        { "hebraico": "וְנִרְאֶ֥ה", "transliteral": "wə-nir-ʾeh", "traducao_palavra": "e vejamos" },
        { "hebraico": "יַחְדָּֽו׃", "transliteral": "yaḥ-dāw", "traducao_palavra": "juntamente." }
      ]
    },
    "24": {
      "traducao_completa": "Eis que vós sois de nada, e a vossa obra é de vácuo; abominação é quem vos escolhe.",
      "palavras": [
        { "hebraico": "הֵן־", "transliteral": "hên-", "traducao_palavra": "Eis que" },
        { "hebraico": "אַתֶּ֣ם", "transliteral": "ʾat-tem", "traducao_palavra": "vós [sois]" },
        { "hebraico": "מֵאַ֔יִן", "transliteral": "mē-ʾa-yin", "traducao_palavra": "de nada" },
        { "hebraico": "וּפָעָלְכֶ֖ם", "transliteral": "ū-p̄ā-ʿāl-ḵem", "traducao_palavra": "e vossa obra" },
        { "hebraico": "מֵאָ֑פַע", "transliteral": "mē-ʾā-p̄a-ʿ", "traducao_palavra": "de vácuo/futilidade" },
        { "hebraico": "תֹּועֵבָ֖ה", "transliteral": "tō-w-ʿē-ḇāh", "traducao_palavra": "abominação [é]" },
        { "hebraico": "יִבְחַ֥ר", "transliteral": "yiḇ-ḥar", "traducao_palavra": "[quem] escolhe" },
        { "hebraico": "בָּכֶֽם׃", "transliteral": "bā-ḵem", "traducao_palavra": "a vós." }
      ]
    },
    "25": {
      "traducao_completa": "Despertei do norte um, e ele veio; desde o nascente do sol ele invocará o meu nome; e virá sobre os príncipes como sobre o barro, e como o oleiro pisa o lodo.",
      "palavras": [
        { "hebraico": "הַעִירֹ֤ותִי", "transliteral": "ha-ʿî-rō-w-ṯî", "traducao_palavra": "Despertei" },
        { "hebraico": "מִצָּפֹון֙", "transliteral": "miṣ-ṣā-p̄ō-wn", "traducao_palavra": "do norte" },
        { "hebraico": "וַיַּ֔את", "transliteral": "way-ya-ʾṯ", "traducao_palavra": "e ele veio" },
        { "hebraico": "מִמִּזְרַח־", "transliteral": "mim-miz-raḥ-", "traducao_palavra": "do nascente de" },
        { "hebraico": "שֶׁ֖מֶשׁ", "transliteral": "še-meš", "traducao_palavra": "o sol" },
        { "hebraico": "יִקְרָ֣א", "transliteral": "yiq-rā", "traducao_palavra": "invocará" },
        { "hebraico": "בִשְׁמִ֑י", "transliteral": "biš-mî", "traducao_palavra": "o meu nome" },
        { "hebraico": "וְיָבֹ֤א", "transliteral": "wə-yā-ḇō", "traducao_palavra": "e virá sobre" },
        { "hebraico": "סְגָנִים֙", "transliteral": "śə-ḡā-nîm", "traducao_palavra": "príncipes/governadores" },
        { "hebraico": "כְּמֹו־", "transliteral": "kə-mō-", "traducao_palavra": "como" },
        { "hebraico": "חֹ֔מֶר", "transliteral": "ḥō-mer", "traducao_palavra": "barro" },
        { "hebraico": "וּכְמֹ֥ו", "transliteral": "ū-ḵə-mō", "traducao_palavra": "e como" },
        { "hebraico": "יֹוצֵ֖ר", "transliteral": "yō-w-ṣēr", "traducao_palavra": "oleiro" },
        { "hebraico": "יִרְמָס־", "transliteral": "yir-mās-", "traducao_palavra": "pisa" },
        { "hebraico": "טִֽיט׃", "transliteral": "ṭîṭ", "traducao_palavra": "o lodo." }
      ]
    },
    "26": {
      "traducao_completa": "Quem declarou isto desde o princípio, para que o saibamos? Ou dantes, para que digamos: Ele é justo? Mas não há quem anuncie, nem há quem o faça ouvir, nem há quem ouça as vossas palavras.",
      "palavras": [
        { "hebraico": "מִֽי־", "transliteral": "mî-", "traducao_palavra": "Quem" },
        { "hebraico": "הִגִּ֤יד", "transliteral": "hig-gîḏ", "traducao_palavra": "declarou" },
        { "hebraico": "מֵרֹאשׁ֙", "transliteral": "mē-rōš", "traducao_palavra": "desde o princípio" },
        { "hebraico": "וְנֵדָ֔עָה", "transliteral": "wə-nê-ḏā-ʿāh", "traducao_palavra": "para que saibamos" },
        { "hebraico": "וּמִלְּפָנִ֖ים", "transliteral": "ū-mil-lə-p̄ā-nîm", "traducao_palavra": "e de antes" },
        { "hebraico": "וְנֹאמַ֣ר", "transliteral": "wə-nō-mar", "traducao_palavra": "para que digamos" },
        { "hebraico": "צַדִּ֑יק", "transliteral": "ṣad-dîq", "traducao_palavra": "[ele é] justo" },
        { "hebraico": "אַף־", "transliteral": "ʾap̄-", "traducao_palavra": "também" },
        { "hebraico": "אֵין־", "transliteral": "ʾên-", "traducao_palavra": "não há" },
        { "hebraico": "מַגִּּיד֙", "transliteral": "mag-gîḏ", "traducao_palavra": "quem declare" },
        { "hebraico": "אַף־", "transliteral": "ʾap̄-", "traducao_palavra": "também" },
        { "hebraico": "אֵ֣ין", "transliteral": "ʾên", "traducao_palavra": "não há" },
        { "hebraico": "מַשְׁמִ֔יעַ", "transliteral": "maš-mî-aʿ", "traducao_palavra": "quem faça ouvir" },
        { "hebraico": "אַף־", "transliteral": "ʾap̄-", "traducao_palavra": "também" },
        { "hebraico": "אֵ֥ין", "transliteral": "ʾên", "traducao_palavra": "não há" },
        { "hebraico": "שֹׁמֵ֖עַ", "transliteral": "šō-mē-aʿ", "traducao_palavra": "quem ouça" },
        { "hebraico": "אִמְרֵיכֶֽם׃", "transliteral": "ʾim-rê-ḵem", "traducao_palavra": "vossas palavras." }
      ]
    },
    "27": {
      "traducao_completa": "Eu sou o primeiro que disse a Sião: Eis, ei-los aqui; e a Jerusalém dou um anunciador de boas novas.",
      "palavras": [
        { "hebraico": "רִאשֹׁ֥ון", "transliteral": "ri-šō-wn", "traducao_palavra": "O primeiro [disse]" },
        { "hebraico": "לְצִיֹּ֖ון", "transliteral": "lə-ṣiy-yō-wn", "traducao_palavra": "para Sião" },
        { "hebraico": "הִנֵּ֣ה", "transliteral": "hin-nēh", "traducao_palavra": "Eis" },
        { "hebraico": "הִנָּ֑ם", "transliteral": "hin-nām", "traducao_palavra": "ei-los aqui" },
        { "hebraico": "וּלְיְרוּשָׁלִַ֖ם", "transliteral": "ū-lə-yə-rū-šā-la-im", "traducao_palavra": "e para Jerusalém" },
        { "hebraico": "מְבַשֵּׂ֥ר", "transliteral": "mə-ḇaś-śēr", "traducao_palavra": "um anunciador de boas novas" },
        { "hebraico": "אֶתֵּֽן׃", "transliteral": "ʾet-tên", "traducao_palavra": "eu darei." }
      ]
    },
    "28": {
      "traducao_completa": "Pois olhei, e não havia ninguém; e dentre estes não havia nenhum conselheiro, para que, perguntando-lhes eu, respondessem palavra.",
      "palavras": [
        { "hebraico": "וְאֵ֙רֶא֙", "transliteral": "wə-ʾê-re", "traducao_palavra": "E olhei" },
        { "hebraico": "וְאֵ֣ין", "transliteral": "wə-ʾên", "traducao_palavra": "e não havia" },
        { "hebraico": "אִ֔ישׁ", "transliteral": "ʾîš", "traducao_palavra": "homem" },
        { "hebraico": "וּמֵאֵ֖לֶּה", "transliteral": "ū-mê-ʾēl-leh", "traducao_palavra": "e dentre estes" },
        { "hebraico": "וְאֵ֣ין", "transliteral": "wə-ʾên", "traducao_palavra": "e não havia" },
        { "hebraico": "יֹועֵ֑ץ", "transliteral": "yō-w-ʿēṣ", "traducao_palavra": "conselheiro" },
        { "hebraico": "וְאֶשְׁאָלֵ֖ם", "transliteral": "wə-ʾeš-ʾā-lêm", "traducao_palavra": "e perguntei a eles" },
        { "hebraico": "וְיָשִׁ֥יבוּ", "transliteral": "wə-yā-šî-ḇū", "traducao_palavra": "e respondessem" },
        { "hebraico": "דָבָֽר׃", "transliteral": "ḏā-ḇār", "traducao_palavra": "palavra." }
      ]
    },
    "29": {
      "traducao_completa": "Eis que todos eles são vaidade; as suas obras não são nada; as suas imagens de fundição são vento e vácuo.",
      "palavras": [
        { "hebraico": "הֵ֣ן", "transliteral": "hên", "traducao_palavra": "Eis que" },
        { "hebraico": "כֻּלָּ֔ם", "transliteral": "kul-lām", "traducao_palavra": "todos eles" },
        { "hebraico": "אָ֥וֶן", "transliteral": "ʾā-wen", "traducao_palavra": "vaidade/iniquidade" },
        { "hebraico": "אֶ֖פֶס", "transliteral": "ʾe-p̄es", "traducao_palavra": "nada/vazio" },
        { "hebraico": "מַעֲשֵׂיהֶ֑ם", "transliteral": "ma-ʿă-śê-hem", "traducao_palavra": "as suas obras" },
        { "hebraico": "ר֥וּחַ", "transliteral": "rū-aḥ", "traducao_palavra": "vento" },
        { "hebraico": "וָתֹ֖הוּ", "transliteral": "wā-ṯō-hū", "traducao_palavra": "e vácuo/caos" },
        { "hebraico": "נִסְכֵּיהֶֽם׃", "transliteral": "nis-kê-hem", "traducao_palavra": "as suas imagens de fundição." }
      ]
    }
  }
