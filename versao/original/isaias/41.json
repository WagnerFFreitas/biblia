{
  "livro": "Isaías - יְשַֽׁעְיָהוּ - Yəšayāhū",
  "capítulo": 41,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Calai-vos diante de mim, ó ilhas, e os povos renovem as forças; cheguem-se, e então falem; cheguemo-nos juntos a juízo.",
      "palavras": [
        { "hebraico": "הַחֲרִ֨ישׁוּ", "transliteral": "ha-ḥă-rî-šū", "traducao_palavra": "Calai-vos/guardai silêncio" },
        { "hebraico": "אֵלַ֤י", "transliteral": "ʾē-lay", "traducao_palavra": "para mim/diante de mim" },
        { "hebraico": "אִיִּים֙", "transliteral": "ʾiy-yîm", "traducao_palavra": "ilhas" },
        { "hebraico": "וּלְאֻמִּ֖ים", "transliteral": "ū-lə-ʾum-mîm", "traducao_palavra": "e os povos" },
        { "hebraico": "יַחֲלִ֣יפוּ", "transliteral": "ya-ḥă-lî-p̄ū", "traducao_palavra": "renovem" },
        { "hebraico": "כֹ֑חַ", "transliteral": "ḵō-aḥ", "traducao_palavra": "força" },
        { "hebraico": "יִגְּשׁ֥וּ", "transliteral": "yig-gə-šū", "traducao_palavra": "cheguem-se" },
        { "hebraico": "אָז֙", "transliteral": "ʾāz", "traducao_palavra": "então" },
        { "hebraico": "יְדַבֵּ֔רוּ", "transliteral": "yə-ḏab-bē-rū", "traducao_palavra": "falem" },
        { "hebraico": "יַחְדָּ֥ו", "transliteral": "yaḥ-dāw", "traducao_palavra": "juntamente" },
        { "hebraico": "לַמִּשְׁפָּ֖ט", "transliteral": "lam-miš-pāṭ", "traducao_palavra": "para o juízo" },
        { "hebraico": "נִקְרָֽבָה׃", "transliteral": "niq-rā-ḇāh", "traducao_palavra": "aproximemo-nos." }
      ]
    },
    "2": {
      "traducao_completa": "Quem despertou do oriente aquele cujos passos a justiça chama? Entregou as nações diante dele e o fez dominar sobre reis; ele os entregou à sua espada como o pó, e ao seu arco como restolho arrebatado pelo vento.",
      "palavras": [
        { "hebraico": "מִ֤י", "transliteral": "mî", "traducao_palavra": "Quem" },
        { "hebraico": "הֵעִיר֙", "transliteral": "hē-ʿîr", "traducao_palavra": "despertou" },
        { "hebraico": "מִמִּזְרָ֔ח", "transliteral": "mim-miz-rāḥ", "traducao_palavra": "do oriente" },
        { "hebraico": "צֶ֖דֶק", "transliteral": "ṣe-ḏeq", "traducao_palavra": "[aquele que a] justiça" },
        { "hebraico": "יִקְרָאֵ֣הוּ", "transliteral": "yiq-rā-ʾē-hū", "traducao_palavra": "o chama" },
        { "hebraico": "לְרַגְלֹ֑ו", "transliteral": "lə-raḡ-lō-w", "traducao_palavra": "ao seu pé/passo" },
        { "hebraico": "יִתֵּ֨ן", "transliteral": "yit-tên", "traducao_palavra": "entregou" },
        { "hebraico": "לְפָנָ֤יו", "transliteral": "lə-p̄ā-nāy-w", "traducao_palavra": "diante dele" },
        { "hebraico": "גֹּויִם֙", "transliteral": "gō-w-yim", "traducao_palavra": "nações" },
        { "hebraico": "וּמְלָכִ֣ים", "transliteral": "ū-mə-lā-ḵîm", "traducao_palavra": "e reis" },
        { "hebraico": "יַ֔רְדְּ", "transliteral": "yard", "traducao_palavra": "fez dominar" },
        { "hebraico": "יִתֵּ֤ן", "transliteral": "yit-tên", "traducao_palavra": "entregou/pôs" },
        { "hebraico": "כֶּעָפָר֙", "transliteral": "ke-ʿā-p̄ār", "traducao_palavra": "como o pó" },
        { "hebraico": "חַרְבֹּ֔ו", "transliteral": "ḥar-bō-w", "traducao_palavra": "à sua espada" },
        { "hebraico": "כְּקַ֥שׁ", "transliteral": "kə-qaš", "traducao_palavra": "como restolho" },
        { "hebraico": "נִדָּ֖ף", "transliteral": "nid-dāp̄", "traducao_palavra": "arrebatado/soprado" },
        { "hebraico": "קַשְׁתֹּֽו׃", "transliteral": "qaš-tō-w", "traducao_palavra": "seu arco." }
      ]
    },
    "3": {
      "traducao_completa": "Perseguiu-os e passou em paz por um caminho por onde seus pés nunca tinham trilhado.",
      "palavras": [
        { "hebraico": "יִרְדְּפֵ֖ם", "transliteral": "yir-də-p̄êm", "traducao_palavra": "Perseguiu-os" },
        { "hebraico": "יַעֲבֹ֣ור", "transliteral": "ya-ʿă-ḇō-wr", "traducao_palavra": "passou" },
        { "hebraico": "שָׁלֹ֑ום", "transliteral": "šā-lō-wm", "traducao_palavra": "em paz" },
        { "hebraico": "אֹ֕רַח", "transliteral": "ʾō-raḥ", "traducao_palavra": "[por] caminho" },
        { "hebraico": "בְּרַגְלָ֖יו", "transliteral": "bə-raḡ-lāy-w", "traducao_palavra": "com seus pés" },
        { "hebraico": "לֹ֥א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "יָבֹֽוא׃", "transliteral": "yā-ḇō-w", "traducao_palavra": "tinha vindo/trilhado." }
      ]
    },
    "4": {
      "traducao_completa": "Quem operou e fez isso, chamando as gerações desde o princípio? Eu, YHWH, o primeiro, e com os últimos eu mesmo.",
      "palavras": [
        { "hebraico": "מִֽי־", "transliteral": "mî-", "traducao_palavra": "Quem" },
        { "hebraico": "פָעַ֣ל", "transliteral": "p̄ā-ʿal", "traducao_palavra": "operou" },
        { "hebraico": "וְעָשָׂ֔ה", "transliteral": "wə-ʿā-śāh", "traducao_palavra": "e fez" },
        { "hebraico": "קֹרֵ֥א", "transliteral": "qō-rē", "traducao_palavra": "chamando" },
        { "hebraico": "הַדֹּרֹ֖ות", "transliteral": "had-dō-rō-wṯ", "traducao_palavra": "as gerações" },
        { "hebraico": "מֵרֹ֑אשׁ", "transliteral": "mē-rōš", "traducao_palavra": "desde o princípio" },
        { "hebraico": "אֲנִ֤י", "transliteral": "ʾă-nî", "traducao_palavra": "Eu" },
        { "hebraico": "יְהוָה֙", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "רִאשֹׁ֔ון", "transliteral": "ri-šō-wn", "traducao_palavra": "[o] primeiro" },
        { "hebraico": "וְאֶת־", "transliteral": "wə-ʾeṯ-", "traducao_palavra": "e com" },
        { "hebraico": "אַחֲרֹנִ֖ים", "transliteral": "ʾa-ḥă-rō-nîm", "traducao_palavra": "[os] últimos" },
        { "hebraico": "אֲנִי־", "transliteral": "ʾă-nî-", "traducao_palavra": "eu" },
        { "hebraico": "הֽוּא׃", "transliteral": "hū", "traducao_palavra": "mesmo/ele." }
      ]
    },
    "5": {
      "traducao_completa": "As ilhas viram-no e temeram; os confins da terra tremeram; aproximaram-se e vieram.",
      "palavras": [
        { "hebraico": "רָא֤וּ", "transliteral": "rā-ʾū", "traducao_palavra": "Viram" },
        { "hebraico": "אִיִּים֙", "transliteral": "ʾiy-yîm", "traducao_palavra": "as ilhas" },
        { "hebraico": "וְיִירָ֔אוּ", "transliteral": "wə-yî-rā-ʾū", "traducao_palavra": "e temeram" },
        { "hebraico": "קְצֹ֥ות", "transliteral": "qə-ṣō-wṯ", "traducao_palavra": "os confins de" },
        { "hebraico": "הָאָ֖רֶץ", "transliteral": "hā-ʾā-reṣ", "traducao_palavra": "a terra" },
        { "hebraico": "יֶחֱרָ֑דוּ", "transliteral": "ye-ḥĕ-rā-ḏū", "traducao_palavra": "tremeram" },
        { "hebraico": "קָרְב֥וּ", "transliteral": "qā-rə-ḇū", "traducao_palavra": "aproximaram-se" },
        { "hebraico": "וַיֶּאֱתָיֽוּן׃", "transliteral": "way-ye-ʾĕ-ṯā-yūn", "traducao_palavra": "e vieram." }
      ]
    },
    "6": {
      "traducao_completa": "Um ao outro ajudou, e ao seu próximo disse: Esforça-te.",
      "palavras": [
        { "hebraico": "אִ֥ישׁ", "transliteral": "ʾîš", "traducao_palavra": "Um" },
        { "hebraico": "אֶת־", "transliteral": "ʾeṯ-", "traducao_palavra": "[partícula acusativa]" },
        { "hebraico": "רֵעֵ֖הוּ", "transliteral": "rē-ʿē-hū", "traducao_palavra": "ao seu próximo" },
        { "hebraico": "יַעְזֹ֑רוּ", "transliteral": "ya-ʿzō-rū", "traducao_palavra": "ajudou" },
        { "hebraico": "וּלְאָחִ֖יו", "transliteral": "ū-lə-ʾā-ḥîw", "traducao_palavra": "e ao seu irmão" },
        { "hebraico": "יֹאמַ֥ר", "transliteral": "yō-mar", "traducao_palavra": "disse" },
        { "hebraico": "חֲזָֽק׃", "transliteral": "ḥă-zāq", "traducao_palavra": "Esforça-te." }
      ]
    },
    "7": {
      "traducao_completa": "E o artífice animou ao ourives, e o que aplaina com o martelo ao que bate na bigorna, dizendo da soldadura: Boa é. Então o firmou com pregos, para que não se movesse.",
      "palavras": [
        { "hebraico": "וַיְחַזֵּ֨ק", "transliteral": "way-ḥaz-zēq", "traducao_palavra": "E animou/fortaleceu" },
        { "hebraico": "חָרָ֜שׁ", "transliteral": "ḥā-rāš", "traducao_palavra": "o artífice" },
        { "hebraico": "אֶת־", "transliteral": "ʾeṯ-", "traducao_palavra": "[partícula acusativa]" },
        { "hebraico": "צֹרֵ֗ף", "transliteral": "ṣō-rēp̄", "traducao_palavra": "ao ourives" },
        { "hebraico": "מַחֲלִ֤יק", "transliteral": "ma-ḥă-lîq", "traducao_palavra": "o que aplaina" },
        { "hebraico": "פַּ֙טִּישׁ֙", "transliteral": "paṭ-ṭîš", "traducao_palavra": "[com] martelo" },
        { "hebraico": "אֶת־", "transliteral": "ʾeṯ-", "traducao_palavra": "[partícula acusativa]" },
        { "hebraico": "הֹולֵ֣ם", "transliteral": "hō-wlēm", "traducao_palavra": "ao que bate em" },
        { "hebraico": "פָּ֔עַם", "transliteral": "pā-ʿam", "traducao_palavra": "bigorna/ritmo" },
        { "hebraico": "אֹמֵ֥ר", "transliteral": "ʾō-mēr", "traducao_palavra": "dizendo" },
        { "hebraico": "לַדֶּ֖בֶק", "transliteral": "lad-de-ḇeq", "traducao_palavra": "da soldadura" },
        { "hebraico": "טֹ֣וב", "transliteral": "ṭō-wḇ", "traducao_palavra": "boa [é]" },
        { "hebraico": "ה֑וּא", "transliteral": "hū", "traducao_palavra": "ela" },
        { "hebraico": "וַיְחַזְּקֵ֥הוּ", "transliteral": "way-ḥaz-zə-qē-hū", "traducao_palavra": "e o firmou" },
        { "hebraico": "בְמַסְמְרִ֖ים", "transliteral": "ḇə-mas-mə-rîm", "traducao_palavra": "com pregos" },
        { "hebraico": "לֹ֥א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "יִמֹּֽוט׃", "transliteral": "yim-mō-wṭ", "traducao_palavra": "se mova/abale." }
      ]
    },
    "8": {
      "traducao_completa": "Mas tu, ó Israel, servo meu, tu, Jacó, a quem escolhi, descendência de Abraão, meu amigo;",
      "palavras": [
        { "hebraico": "וְאַתָּה֙", "transliteral": "wə-ʾat-tāh", "traducao_palavra": "Mas tu" },
        { "hebraico": "יִשְׂרָאֵ֣ל", "transliteral": "yiś-rā-ʾēl", "traducao_palavra": "Israel" },
        { "hebraico": "עַבְדִּ֔י", "transliteral": "ʿaḇ-dî", "traducao_palavra": "servo meu" },
        { "hebraico": "יַעֲקֹ֖ב", "transliteral": "ya-ʿă-qōḇ", "traducao_palavra": "Jacó" },
        { "hebraico": "אֲשֶׁ֣ר", "transliteral": "ʾă-šer", "traducao_palavra": "a quem" },
        { "hebraico": "בְּחַרְתִּ֑יךָ", "transliteral": "bə-ḥar-tî-ḵā", "traducao_palavra": "escolhi" },
        { "hebraico": "זֶ֖רַע", "transliteral": "ze-raʿ", "traducao_palavra": "descendência de" },
        { "hebraico": "אַבְרָהָ֥ם", "transliteral": "ʾaḇ-rā-hām", "traducao_palavra": "Abraão" },
        { "hebraico": "אֹהֲבִֽי׃", "transliteral": "ʾō-hă-ḇî", "traducao_palavra": "meu amigo/o que me ama." }
      ]
    },
    "9": {
      "traducao_completa": "Tu a quem tomei desde os confins da terra, e te chamei dos seus cantos, e te disse: Tu és o meu servo, eu te escolhi e não te rejeitei.",
      "palavras": [
        { "hebraico": "אֲשֶׁ֤ר", "transliteral": "ʾă-šer", "traducao_palavra": "Tu a quem" },
        { "hebraico": "הֶחֱזַקְתִּ֙יךָ֙", "transliteral": "he-ḥĕ-zaq-tî-ḵā", "traducao_palavra": "tomei/segurei" },
        { "hebraico": "מִקְצֹ֣ות", "transliteral": "miq-ṣō-wṯ", "traducao_palavra": "dos confins de" },
        { "hebraico": "הָאָ֔רֶץ", "transliteral": "hā-ʾā-reṣ", "traducao_palavra": "a terra" },
        { "hebraico": "וּמֵאֲצִילֶ֖יהָ", "transliteral": "ū-mê-ʾă-ṣî-le-hā", "traducao_palavra": "e de seus cantos/extremidades" },
        { "hebraico": "קְרָאתִ֑יךָ", "transliteral": "qə-rā-ṯî-ḵā", "traducao_palavra": "te chamei" },
        { "hebraico": "וָאֹמַ֤ר", "transliteral": "wā-ʾō-mar", "traducao_palavra": "e te disse" },
        { "hebraico": "לְךָ֙", "transliteral": "lə-ḵā", "traducao_palavra": "a ti" },
        { "hebraico": "עַבְדִּי־", "transliteral": "ʿaḇ-dî-", "traducao_palavra": "meu servo [és]" },
        { "hebraico": "אַתָּה", "transliteral": "ʾat-tāh", "traducao_palavra": "tu" },
        { "hebraico": "בְּחַרְתִּ֖יךָ", "transliteral": "bə-ḥar-tî-ḵā", "traducao_palavra": "te escolhi" },
        { "hebraico": "וְלֹ֥א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "מְאַסְתִּֽיךָ׃", "transliteral": "mə-ʾas-tî-ḵā", "traducao_palavra": "te rejeitei." }
      ]
    },
    "10": {
      "traducao_completa": "Não temas, porque eu sou contigo; não te assombres, porque eu sou teu Deus; eu te esforço, e te ajudo, e te sustento com a destra da minha justiça.",
      "palavras": [
        { "hebraico": "אַל־", "transliteral": "ʾal-", "traducao_palavra": "Não" },
        { "hebraico": "תִּירָא֙", "transliteral": "tî-rā", "traducao_palavra": "temas" },
        { "hebraico": "כִּ֣י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "עִמְּךָ־", "transliteral": "ʿim-mə-ḵā-", "traducao_palavra": "contigo [sou]" },
        { "hebraico": "אָ֔נִי", "transliteral": "ʾā-nî", "traducao_palavra": "eu" },
        { "hebraico": "אַל־", "transliteral": "ʾal-", "traducao_palavra": "não" },
        { "hebraico": "תִּשְׁתָּ֖ע", "transliteral": "tiš-tāʿ", "traducao_palavra": "te assombres/olhes ansioso" },
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "porque" },
        { "hebraico": "אֲנִ֣י", "transliteral": "ʾă-nî", "traducao_palavra": "eu [sou]" },
        { "hebraico": "אֱלֹהֶ֑יךָ", "transliteral": "ʾĕ-lō-he-ḵā", "traducao_palavra": "teu Deus" },
        { "hebraico": "אִמַּצְתִּ֙יךָ֙", "transliteral": "ʾim-maṣ-tî-ḵā", "traducao_palavra": "eu te esforço" },
        { "hebraico": "אַף־", "transliteral": "ʾap̄-", "traducao_palavra": "também" },
        { "hebraico": "עֲזַרְתִּ֔יךָ", "transliteral": "ʿă-zar-tî-ḵā", "traducao_palavra": "te ajudo" },
        { "hebraico": "אַף־", "transliteral": "ʾap̄-", "traducao_palavra": "também" },
        { "hebraico": "תְּמַכְתִּ֖יךָ", "transliteral": "tə-maḵ-tî-ḵā", "traducao_palavra": "te sustento" },
        { "hebraico": "בִּימִ֥ין", "transliteral": "bî-mîn", "traducao_palavra": "com a destra de" },
        { "hebraico": "צִדְקִֽי׃", "transliteral": "ṣiḏ-qî", "traducao_palavra": "minha justiça." }
      ]
    },
    "11": {
      "traducao_completa": "Eis que todos os que se indignarem contra ti serão envergonhados e confundidos; tornar-se-ão em nada, e os que contenderem contigo perecerão.",
      "palavras": [
        { "hebraico": "הֵ֤ן", "transliteral": "hên", "traducao_palavra": "Eis que" },
        { "hebraico": "יֵבֹ֙שׁוּ֙", "transliteral": "yē-ḇō-šū", "traducao_palavra": "serão envergonhados" },
        { "hebraico": "וְיִכָּלְמ֔וּ", "transliteral": "wə-yik-kā-lə-mū", "traducao_palavra": "e confundidos" },
        { "hebraico": "כֹּ֖ל", "transliteral": "kōl", "traducao_palavra": "todos" },
        { "hebraico": "הַנֶּחֱרִ֣ים", "transliteral": "han-ne-ḥĕ-rîm", "traducao_palavra": "os que se inflamam/indignam" },
        { "hebraico": "בָּ֑ךְ", "transliteral": "bāḵ", "traducao_palavra": "contra ti" },
        { "hebraico": "יִֽהְי֥וּ", "transliteral": "yih-yū", "traducao_palavra": "serão" },
        { "hebraico": "כְאַ֛יִן", "transliteral": "ḵə-ʾa-yin", "traducao_palavra": "como nada" },
        { "hebraico": "וְיֹאבְד֖וּ", "transliteral": "wə-yō-ḇə-ḏū", "traducao_palavra": "e perecerão" },
        { "hebraico": "אַנְשֵׁ֥י", "transliteral": "ʾan-šê", "traducao_palavra": "os homens de" },
