        { "hebraico": "וְעֵינָ֣יו", "transliteral": "wə-ʿê-nāyw", "traducao_palavra": "e os olhos dele" },
        { "hebraico": "הָשַׁ֑ע", "transliteral": "hā-šaʿ", "traducao_palavra": "fecha/cega" },
        { "hebraico": "פֶּן־יִרְאֶ֨ה", "transliteral": "pen-yir-ʾeh", "traducao_palavra": "para que não veja" },
        { "hebraico": "בְעֵינָ֜יו", "transliteral": "ḇə-ʿê-nāyw", "traducao_palavra": "com seus olhos" },
        { "hebraico": "וּבְאָזְנָ֣יו", "transliteral": "ū-ḇə-ʾāz-nāyw", "traducao_palavra": "e com seus ouvidos" },
        { "hebraico": "יִשְׁמָ֗ע", "transliteral": "yiš-māʿ", "traducao_palavra": "ouça" },
        { "hebraico": "וּלְבָבֹ֥ו", "transliteral": "ū-lə-ḇā-ḇô", "traducao_palavra": "e [com] seu coração" },
