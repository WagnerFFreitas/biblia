        { "hebraico": "זֶ֤ה", "transliteral": "zeh", "traducao_palavra": "este" },
        { "hebraico": "אֶל־זֶה֙", "transliteral": "ʾel-zeh", "traducao_palavra": "para este" },
        { "hebraico": "וְאָמַ֔ר", "transliteral": "wə-ʾā-mar", "traducao_palavra": "e dizia" },
        { "hebraico": "קָדֹ֧ושׁ ׀", "transliteral": "qā-ḏôš", "traducao_palavra": "Santo" },
