      ]
    },
    "7": {
      "traducao_completa": "e com ela tocou a minha boca, e disse: Eis que isto tocou os teus lábios; e a tua iniquidade foi tirada, e purificado o teu pecado.",
      "palavras": [
        { "hebraico": "וַיַּגַּ֣ע", "transliteral": "way-yag-gaʿ", "traducao_palavra": "E tocou" },
        { "hebraico": "עַל־פִּ֔י", "transliteral": "ʿal-pî", "traducao_palavra": "na minha boca" },
        { "hebraico": "וַיֹּ֕אמֶר", "transliteral": "way-yō-mer", "traducao_palavra": "e disse" },
        { "hebraico": "הִנֵּ֛ה", "transliteral": "hin-nēh", "traducao_palavra": "eis" },
        { "hebraico": "נָגַ֥ע", "transliteral": "nā-ḡaʿ", "traducao_palavra": "tocou" },
        { "hebraico": "זֶ֖ה", "transliteral": "zeh", "traducao_palavra": "isto" },
        { "hebraico": "עַל־שְׂפָתֶ֑יךָ", "transliteral": "ʿal-śə-p̄ā-ṯê-ḵā", "traducao_palavra": "nos teus lábios" },
