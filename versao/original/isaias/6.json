        { "hebraico": "שְׂפָתַ֖יִם", "transliteral": "śə-p̄ā-ṯa-yim", "traducao_palavra": "lábios" },
        { "hebraico": "אָנֹכִ֣י", "transliteral": "ʾā-nō-ḵî", "traducao_palavra": "eu" },
        { "hebraico": "יֹושֵׁ֑ב", "transliteral": "yô-šēḇ", "traducao_palavra": "habito" },
