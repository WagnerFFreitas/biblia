        { "hebraico": "אֶת־הַמֶּ֛לֶךְ", "transliteral": "ʾeṯ-ham-me-leḵ", "traducao_palavra": "[objeto] o rei" },
        { "hebraico": "יְהוָ֥ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
