        { "hebraico": "קָדֹ֖ושׁ", "transliteral": "qā-ḏôš", "traducao_palavra": "santo" },
        { "hebraico": "יְהוָ֣ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "צְבָאֹ֑ות", "transliteral": "ṣə-ḇā-ʾôṯ", "traducao_palavra": "[dos] Exércitos" },
        { "hebraico": "מְלֹ֥א", "transliteral": "mə-lō", "traducao_palavra": "[é a] plenitude de" },
        { "hebraico": "כָל־הָאָ֖רֶץ", "transliteral": "ḵāl-hā-ʾā-reṣ", "traducao_palavra": "toda a terra" },
        { "hebraico": "כְּḇֹודֹֽו׃", "transliteral": "kə-ḇô-ḏô", "traducao_palavra": "[da] sua glória" }
      ]
    },
    "4": {
      "traducao_completa": "E as ombreiras das portas se moveram à voz do que clamava, e a casa se encheu de fumaça.",
      "palavras": [
        { "hebraico": "וַיָּנֻ֨עוּ֙", "transliteral": "way-yā-nu-ʿû", "traducao_palavra": "E moveram-se" },
        { "hebraico": "אַמֹּ֣ות", "transliteral": "ʾam-môṯ", "traducao_palavra": "[as] bases/ombreiras de" },
        { "hebraico": "הַסִּפִּ֔ים", "transliteral": "ha-śip-pîm", "traducao_palavra": "os limiares/portas" },
        { "hebraico": "מִקֹּ֖ול", "transliteral": "miq-qôl", "traducao_palavra": "pela voz" },
        { "hebraico": "הַקֹּורֵ֑א", "transliteral": "haq-qô-rē", "traducao_palavra": "do que clamava" },
        { "hebraico": "וְהַבַּ֖יִת", "transliteral": "wə-hab-ba-yiṯ", "traducao_palavra": "e a casa" },
        { "hebraico": "יִמָּלֵ֥א", "transliteral": "yim-mā-lê", "traducao_palavra": "enchia-se" },
        { "hebraico": "עָשָֽׁן׃", "transliteral": "ʿā-šān", "traducao_palavra": "[de] fumaça" }
      ]
    },
    "5": {
      "traducao_completa": "Então disse eu: Ai de mim! Pois estou perdido; porque sou homem de lábios impuros, e habito no meio de um povo de impuros lábios; e os meus olhos viram o Rei, YHWH dos Exércitos!",
      "palavras": [
        { "hebraico": "וָאֹמַ֨ר", "transliteral": "wā-ʾō-mar", "traducao_palavra": "Então disse" },
        { "hebraico": "אֹֽוי־לִ֣י", "transliteral": "ʾôy-lî", "traducao_palavra": "Ai de mim" },
        { "hebraico": "כִֽי־נִדְמֵ֗יתִי", "transliteral": "ḵî-niḏ-mê-ṯî", "traducao_palavra": "pois estou desfeito/perdido" },
        { "hebraico": "כִּ֣י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "אִ֤ישׁ", "transliteral": "ʾîš", "traducao_palavra": "homem" },
        { "hebraico": "טְמֵֽא־שְׂפָתַ֨יִם֙", "transliteral": "ṭə-mê-śə-p̄ā-ṯa-yim", "traducao_palavra": "impuro de lábios" },
        { "hebraico": "אָנֹ֔כִי", "transliteral": "ʾā-nō-ḵî", "traducao_palavra": "[sou] eu" },
        { "hebraico": "וּבְתֹ֥וךְ", "transliteral": "ū-ḇə-ṯôḵ", "traducao_palavra": "e no meio de" },
        { "hebraico": "עַם־", "transliteral": "ʿam-", "traducao_palavra": "um povo" },
