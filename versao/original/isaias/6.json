        { "hebraico": "הַשְׁמֵן֙", "transliteral": "haš-mên", "traducao_palavra": "torna insensível/engorda" },
        { "hebraico": "לֵב־", "transliteral": "lêḇ-", "traducao_palavra": "[o] coração de" },
        { "hebraico": "הָעָ֣ם", "transliteral": "hā-ʿām", "traducao_palavra": "este povo" },
        { "hebraico": "הַזֶּ֔ה", "transliteral": "haz-zeh", "traducao_palavra": "[este]" },
        { "hebraico": "וְאָזְנָ֥יו", "transliteral": "wə-ʾāz-nāyw", "traducao_palavra": "e os ouvidos dele" },
