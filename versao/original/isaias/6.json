        { "hebraico": "רָא֥וּ", "transliteral": "rā-ʾû", "traducao_palavra": "viram" },
        { "hebraico": "עֵינָֽי׃", "transliteral": "ʿê-nāy", "traducao_palavra": "meus olhos" }
      ]
    },
    "6": {
      "traducao_completa": "Mas um dos serafins voou para mim, trazendo na sua mão uma brasa viva, que tirara do altar com uma tenaz;",
      "palavras": [
        { "hebraico": "וַיָּ֣עָף", "transliteral": "way-yā-ʿāp̄", "traducao_palavra": "E voou" },
        { "hebraico": "אֵלַ֗י", "transliteral": "ʾê-lay", "traducao_palavra": "para mim" },
        { "hebraico": "אֶחָד֙", "transliteral": "ʾe-ḥāḏ", "traducao_palavra": "um" },
        { "hebraico": "מִן־הַשְּׂרָפִ֔ים", "transliteral": "min-haś-śə-rā-p̄îm", "traducao_palavra": "dos serafins" },
        { "hebraico": "וּבְיָדֹ֖ו", "transliteral": "ū-ḇə-yā-ḏô", "traducao_palavra": "e em sua mão" },
