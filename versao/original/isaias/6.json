{
  "livro": "Isaías - יְשַׁעְיָהוּ - Yeshayahu",
  "capítulo": 6,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "No ano em que morreu o rei Uzias, eu vi o Senhor assentado sobre um trono alto e elevado; e o séquito da sua veste enchia o templo.",
      "palavras": [
        { "hebraico": "בִּשְׁנַת־מֹ֣ות", "transliteral": "biš-naṯ-môṯ", "traducao_palavra": "No ano da morte de" },
        { "hebraico": "הַמֶּ֣לֶךְ", "transliteral": "ham-me-leḵ", "traducao_palavra": "o rei" },
        { "hebraico": "עֻזִּיָּ֗הוּ", "transliteral": "ʿuz-zî-yā-hû", "traducao_palavra": "Uzias" },
        { "hebraico": "וָאֶרְאֶ֧ה", "transliteral": "wā-ʾer-ʾeh", "traducao_palavra": "e eu vi" },
        { "hebraico": "אֶת־אֲדֹנָ֛י", "transliteral": "ʾeṯ-ʾă-ḏō-nāy", "traducao_palavra": "o Senhor" },
        { "hebraico": "יֹשֵׁ֥ב", "transliteral": "yō-šēḇ", "traducao_palavra": "assentado" },
        { "hebraico": "עַל־כִּסֵּ֖א", "transliteral": "ʿal-kis-śê", "traducao_palavra": "sobre um trono" },
        { "hebraico": "רָ֣ם", "transliteral": "rām", "traducao_palavra": "alto" },
        { "hebraico": "וְנִשָּׂ֑א", "transliteral": "wə-niś-śā", "traducao_palavra": "e elevado" },
        { "hebraico": "וְשׁוּלָ֖יו", "transliteral": "wə-šû-lāyw", "traducao_palavra": "e as abas/séquito dele" },
        { "hebraico": "מְלֵאִ֥ים", "transliteral": "mə-lê-ʾîm", "traducao_palavra": "enchiam" },
        { "hebraico": "אֶת־הַהֵיכָֽל׃", "transliteral": "ʾeṯ-ha-hê-ḵāl", "traducao_palavra": "o templo" }
      ]
    },
    "2": {
      "traducao_completa": "Serafins estavam por cima dele; cada um tinha seis asas; com duas cobriam o rosto, e com duas cobriam os pés, e com duas voavam.",
      "palavras": [
        { "hebraico": "שְׂרָפִ֨ים", "transliteral": "śə-rā-p̄îm", "traducao_palavra": "Serafins" },
        { "hebraico": "עֹמְדִ֤ים", "transliteral": "ʿō-mə-ḏîm", "traducao_palavra": "estavam de pé" },
        { "hebraico": "מִמַּ֨עַל֙", "transliteral": "mim-ma-ʿal", "traducao_palavra": "por cima" },
        { "hebraico": "לֹ֔ו", "transliteral": "lô", "traducao_palavra": "dele" },
        { "hebraico": "שֵׁ֧שׁ", "transliteral": "šêš", "traducao_palavra": "seis" },
        { "hebraico": "כְּנָפַ֛יִם", "transliteral": "kə-nā-p̄a-yim", "traducao_palavra": "asas" },
        { "hebraico": "שֵׁ֧שׁ", "transliteral": "šêš", "traducao_palavra": "seis" },
        { "hebraico": "כְּנָפַ֖יִם", "transliteral": "kə-nā-p̄a-yim", "traducao_palavra": "asas" },
        { "hebraico": "לְאֶחָ֑ד", "transliteral": "lə-ʾe-ḥāḏ", "traducao_palavra": "para cada um" },
        { "hebraico": "בִּשְׁתַּ֨יִם֙", "transliteral": "biš-ta-yim", "traducao_palavra": "com duas" },
        { "hebraico": "יְכַסֶּ֣ה", "transliteral": "yə-ḵas-seh", "traducao_palavra": "cobria" },
        { "hebraico": "פָנָ֔יו", "transliteral": "p̄ā-nāyw", "traducao_palavra": "seu rosto" },
        { "hebraico": "וּבִשְׁתַַּ֨יִם֙", "transliteral": "ū-biš-ta-yim", "traducao_palavra": "e com duas" },
        { "hebraico": "יְכַסֶּ֣ה", "transliteral": "yə-ḵas-seh", "traducao_palavra": "cobria" },
        { "hebraico": "רַגְלָ֔יו", "transliteral": "raḡ-lāyw", "traducao_palavra": "seus pés" },
        { "hebraico": "וּבִשְׁתַּ֖יִם", "transliteral": "ū-biš-ta-yim", "traducao_palavra": "e com duas" },
        { "hebraico": "יְעֹופֵֽף׃", "transliteral": "yə-ʿô-p̄êp̄", "traducao_palavra": "voava" }
      ]
    },
    "3": {
      "traducao_completa": "E clamavam uns para os outros, dizendo: Santo, santo, santo é YHWH dos Exércitos; toda a terra está cheia da sua glória.",
      "palavras": [
