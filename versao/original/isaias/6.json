        { "hebraico": "יֹושֵׁ֗ב", "transliteral": "yô-šēḇ", "traducao_palavra": "habitante" },
        { "hebraico": "וּבָתִּים֙", "transliteral": "ū-ḇāt-tîm", "traducao_palavra": "e as casas" },
        { "hebraico": "מֵאֵ֣ין", "transliteral": "mê-ʾên", "traducao_palavra": "em falta de" },
        { "hebraico": "אָדָ֔ם", "transliteral": "ʾā-ḏām", "traducao_palavra": "homem" },
        { "hebraico": "וְהָאֲדָמָ֖ה", "transliteral": "wə-hā-ʾă-ḏā-mā", "traducao_palavra": "e a terra" },
