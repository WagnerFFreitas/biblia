        { "hebraico": "לָקַ֖ח", "transliteral": "lā-qaḥ", "traducao_palavra": "tirou" },
        { "hebraico": "מֵעַ֥ל", "transliteral": "mē-ʿal", "traducao_palavra": "de sobre" },
