      ]
    },
    "8": {
      "traducao_completa": "Depois disto ouvi a voz do Senhor, que dizia: A quem enviarei, e quem há de ir por nós? Então disse eu: Eis-me aqui, envia-me a mim.",
      "palavras": [
        { "hebraico": "וָאֶשְׁמַ֞ע", "transliteral": "wā-ʾeš-maʿ", "traducao_palavra": "E ouvi" },
        { "hebraico": "אֶת־קֹ֤ול", "transliteral": "ʾeṯ-qôl", "traducao_palavra": "[objeto] a voz de" },
        { "hebraico": "אֲדֹנָי֙", "transliteral": "ʾă-ḏō-nāy", "traducao_palavra": "o Senhor" },
        { "hebraico": "אֹמֵ֔ר", "transliteral": "ʾō-mêr", "traducao_palavra": "[que] dizia" },
        { "hebraico": "אֶת־מִ֥י", "transliteral": "ʾeṯ-mî", "traducao_palavra": "a quem" },
        { "hebraico": "אֶשְׁלַ֖ח", "transliteral": "ʾeš-laḥ", "traducao_palavra": "enviarei" },
        { "hebraico": "וּמִ֥י", "transliteral": "ū-mî", "traducao_palavra": "e quem" },
        { "hebraico": "יֵֽלֶךְ־לָ֑נוּ", "transliteral": "yê-leḵ-lā-nû", "traducao_palavra": "irá por nós?" },
        { "hebraico": "וָאֹמַ֖ר", "transliteral": "wā-ʾō-mar", "traducao_palavra": "e eu disse" },
        { "hebraico": "הִנְנִ֥י", "transliteral": "hin-nə-nî", "traducao_palavra": "eis-me aqui" },
        { "hebraico": "שְׁלָחֵֽנִי׃", "transliteral": "šə-lā-ḥê-nî", "traducao_palavra": "envia-me" }
      ]
    },
    "9": {
      "traducao_completa": "Então disse ele: Vai, e dize a este povo: Ouvi, deveras, e não entendais, e vede, deveras, mas não percebais.",
      "palavras": [
        { "hebraico": "וַיֹּ֕אמֶר", "transliteral": "way-yō-mer", "traducao_palavra": "E disse ele" },
        { "hebraico": "לֵ֥ךְ", "transliteral": "lêḵ", "traducao_palavra": "vai" },
        { "hebraico": "וְאָמַרְתָּ֖", "transliteral": "wə-ʾā-mar-tā", "traducao_palavra": "e dirás" },
        { "hebraico": "לָעָ֣ם", "transliteral": "lā-ʿām", "traducao_palavra": "ao povo" },
        { "hebraico": "הַזֶּ֑ה", "transliteral": "haz-zeh", "traducao_palavra": "este" },
        { "hebraico": "שִׁמְע֤וּ", "transliteral": "šim-ʿû", "traducao_palavra": "ouvi" },
        { "hebraico": "שָׁמֹ֨ועַ֙", "transliteral": "šā-mô-aʿ", "traducao_palavra": "deveras" },
        { "hebraico": "וְאַל־תָּבִ֔ינוּ", "transliteral": "wə-ʾal-tā-ḇî-nû", "traducao_palavra": "e não entendais" },
        { "hebraico": "וּרְא֥וּ", "transliteral": "ū-rə-ʾû", "traducao_palavra": "e vede" },
        { "hebraico": "רָאֹ֖ו", "transliteral": "rā-ʾô", "traducao_palavra": "deveras" },
        { "hebraico": "וְאַל־תֵּדָֽעוּ׃", "transliteral": "wə-ʾal-tê-ḏā-ʿû", "traducao_palavra": "e não percebais/conheçais" }
      ]
    },
    "10": {
      "traducao_completa": "Engorda o coração deste povo, e endurece-lhe os ouvidos, e fecha-lhe os olhos; para que ele não veja com os seus olhos, e não ouça com os seus ouvidos, nem entenda com o seu coração, nem se converta e seja sarado.",
