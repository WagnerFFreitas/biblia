  "versiculos": {
    "1": {
      "traducao_completa": "Ai da terra do zumbido de asas, que está além dos rios da Etiópia!",
      "palavras": [
        { "hebraico": "הֹ֖וי", "transliteral": "hôy", "traducao_palavra": "Ai" },
        { "hebraico": "אֶ֥רֶץ", "transliteral": "ʾe-reṣ", "traducao_palavra": "da terra [do]" },
        { "hebraico": "צִלְצַ֖ל", "transliteral": "ṣil-ṣal", "traducao_palavra": "zumbido/tinido de" },
        { "hebraico": "כְּנָפָ֑יִם", "transliteral": "kə-nā-p̄ā-yim", "traducao_palavra": "asas" },
        { "hebraico": "אֲשֶׁ֥ר", "transliteral": "ʾă-šer", "traducao_palavra": "que [está]" },
        { "hebraico": "מֵעֵ֖בֶר", "transliteral": "mê-ʿê-ḇer", "traducao_palavra": "além de" },
        { "hebraico": "לְנַהֲרֵי־כֽוּשׁ׃", "transliteral": "lə-na-hă-rê-ḵûš", "traducao_palavra": "rios da Etiópia/Cuxe" }
      ]
    },
    "2": {
      "traducao_completa": "Que envia embaixadores pelo mar em navios de papiro sobre as águas, dizendo: Ide, mensageiros velozes, a uma nação de gente alta e polida, a um povo terrível desde o seu princípio; nação de medidas e de pisar a pés, cuja terra os rios dividem.",
      "palavras": [
        { "hebraico": "הַשֹּׁלֵ֨חַ", "transliteral": "haš-šō-lê-aḥ", "traducao_palavra": "O que envia" },
        { "hebraico": "בַיָּ֜ם", "transliteral": "ḇay-yām", "traducao_palavra": "pelo mar" },
        { "hebraico": "צִירִ֗ים", "transliteral": "ṣî-rîm", "traducao_palavra": "embaixadores" },
        { "hebraico": "וּבִכְלֵי־", "transliteral": "ū-ḇiḵ-lê-", "traducao_palavra": "e em vasos/navios de" },
        { "hebraico": "גֹמֶא֮", "transliteral": "ḡō-me", "traducao_palavra": "papiro/junco" },
        { "hebraico": "עַל־פְּנֵי־", "transliteral": "ʿal-pə-nê-", "traducao_palavra": "sobre a face de" },
        { "hebraico": "מַיִם֒", "transliteral": "ma-yim", "traducao_palavra": "águas" },
        { "hebraico": "לְכ֣וּ ׀", "transliteral": "lə-ḵû", "traducao_palavra": "ide" },
        { "hebraico": "מַלְאָכִ֣ים", "transliteral": "mal-ʾā-ḵîm", "traducao_palavra": "mensageiros" },
        { "hebraico": "קַלִּ֗ים", "transliteral": "qal-lîm", "traducao_palavra": "velozes" },
        { "hebraico": "אֶל־גֹּ֤וי", "transliteral": "ʾel-gôy", "traducao_palavra": "a uma nação" },
        { "hebraico": "מְמֻשָּׁךְ֙", "transliteral": "mə-muš-šāk", "traducao_palavra": "espichada/alta" },
        { "hebraico": "וּמֹורָ֔ט", "transliteral": "ū-mô-rāṭ", "traducao_palavra": "e polida/bronzeada" },
        { "hebraico": "אֶל־עַ֥ם", "transliteral": "ʾel-ʿam", "traducao_palavra": "a um povo" },
        { "hebraico": "נֹורָ֖א", "transliteral": "nô-rā", "traducao_palavra": "terrível" },
        { "hebraico": "מִן־ה֥וּא", "transliteral": "min-hû", "traducao_palavra": "desde ele [seu princípio]" },
        { "hebraico": "וָהָ֑לְאָה", "transliteral": "wā-hāl-ʾā", "traducao_palavra": "e adiante" },
        { "hebraico": "גֹּ֚וי", "transliteral": "gôy", "traducao_palavra": "nação [de]" },
