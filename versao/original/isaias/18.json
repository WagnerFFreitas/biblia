        { "hebraico": "כְּעָ֥ב", "transliteral": "kə-ʿāḇ", "traducao_palavra": "como nuvem de" },
        { "hebraico": "טַ֖ל", "transliteral": "ṭal", "traducao_palavra": "orvalho" },
        { "hebraico": "בְּחֹ֥ם", "transliteral": "bə-ḥōm", "traducao_palavra": "no calor de" },
        { "hebraico": "קָצִֽיר׃", "transliteral": "qā-ṣîr", "traducao_palavra": "colheita" }
