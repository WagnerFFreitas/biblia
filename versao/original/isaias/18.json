        { "hebraico": "וְכָרַ֨ת", "transliteral": "wə-ḵā-raṯ", "traducao_palavra": "e cortará" },
        { "hebraico": "אֶת־הַזַּלְזַלִּים֙", "transliteral": "ʾeṯ-haz-zal-zal-lîm", "traducao_palavra": "[objeto] os sarmentos" },
        { "hebraico": "בַּמַּזְמֵרֹ֔ות", "transliteral": "bam-maz-mê-rôṯ", "traducao_palavra": "com as foices" },
        { "hebraico": "וְאֶת־הַנְּטִישֹׁ֖ות", "transliteral": "wə-ʾeṯ-han-nə-ṭî-šôṯ", "traducao_palavra": "e as ramagens" },
