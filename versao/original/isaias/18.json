    "3": {
      "traducao_completa": "Vós, todos os habitantes do mundo, e vós, os moradores da terra, quando se arvorar a bandeira nos montes, olhai; e quando se tocar a trombeta, ouvi.",
      "palavras": [
        { "hebraico": "כָּל־יֹשְׁבֵ֥י", "transliteral": "kāl-yō-šə-ḇê", "traducao_palavra": "Todos os habitantes de" },
        { "hebraico": "תֵבֵ֖ל", "transliteral": "ṯê-ḇêl", "traducao_palavra": "mundo" },
        { "hebraico": "וְשֹׁ֣כְנֵי", "transliteral": "wə-šō-ḵə-nê", "traducao_palavra": "e moradores de" },
        { "hebraico": "אָ֑רֶץ", "transliteral": "ʾā-reṣ", "traducao_palavra": "terra" },
        { "hebraico": "כִּנְשֹׂא־נֵס֙", "transliteral": "kin-śō-nêś", "traducao_palavra": "quando se levantar bandeira" },
        { "hebraico": "הָרִ֣ים", "transliteral": "he-hā-rîm", "traducao_palavra": "[nos] montes" },
        { "hebraico": "תִּרְא֔וּ", "transliteral": "tir-ʾû", "traducao_palavra": "vereis/olhai" },
        { "hebraico": "וִכְתְקֹ֥עַ", "transliteral": "wiḵ-ṯə-qō-aʿ", "traducao_palavra": "e como ao tocar de" },
        { "hebraico": "שֹׁופָ֖ר", "transliteral": "šô-p̄ār", "traducao_palavra": "trombeta" },
        { "hebraico": "תִּשְׁמָֽעוּ׃", "transliteral": "tiš-mā-ʿû", "traducao_palavra": "ouvireis/ouvi" }
      ]
    },
    "4": {
      "traducao_completa": "Porque assim me disse YHWH: Estarei quieto, olhando do meu lugar de morada, como o calor ardente do sol, como a nuvem do orvalho no calor da sega.",
