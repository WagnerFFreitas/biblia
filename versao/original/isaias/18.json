    "5": {
      "traducao_completa": "Pois antes da sega, quando a flor cair e a uva azeda se tornar em bago que amadurece, ele cortará os sarmentos com foices, e tirará os ramos, e os lançará fora.",
      "palavras": [
        { "hebraico": "כִּֽי־לִפְנֵ֤י", "transliteral": "kî-lip̄-nê", "traducao_palavra": "Porque antes de" },
        { "hebraico": "קָצִיר֙", "transliteral": "qā-ṣîr", "traducao_palavra": "[a] colheita" },
        { "hebraico": "כְּתָם־", "transliteral": "kə-ṯām-", "traducao_palavra": "como ao findar de" },
