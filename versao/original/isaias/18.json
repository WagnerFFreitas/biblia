        { "hebraico": "כֹה֙", "transliteral": "ḵō", "traducao_palavra": "assim" },
        { "hebraico": "אָמַ֨ר", "transliteral": "ʾā-mar", "traducao_palavra": "disse" },
        { "hebraico": "יְהוָ֣ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "אֵלַ֔י", "transliteral": "ʾê-lay", "traducao_palavra": "para mim" },
        { "hebraico": "אֶשְׁקֳטָה", "transliteral": "ʾeš-qo-ṭā", "traducao_palavra": "descansarei/estarei quieto" },
        { "hebraico": "וְאַבִּ֖יטָה", "transliteral": "wə-ʾab-bî-ṭā", "traducao_palavra": "e olharei" },
        { "hebraico": "בִמְכֹונִ֑י", "transliteral": "ḇim-ḵô-nî", "traducao_palavra": "da minha morada" },
        { "hebraico": "כְּחֹ֥ם", "transliteral": "kə-ḥōm", "traducao_palavra": "como o calor" },
        { "hebraico": "צַח֙", "transliteral": "ṣaḥ", "traducao_palavra": "limpo/ardente" },
