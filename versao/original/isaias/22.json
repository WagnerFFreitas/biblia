    "16": {
      "traducao_completa": "Que tens tu aqui, ou a quem tens tu aqui, para que cavasses aqui uma sepultura, lavrando em lugar alto a tua sepultura, e cinzelando na rocha uma morada para ti mesmo?",
      "palavras": [
        { "hebraico": "מַה־", "transliteral": "mah-", "traducao_palavra": "O que" },
        { "hebraico": "לְּךָ֥", "transliteral": "lə-ḵā", "traducao_palavra": "[há] contigo" },
        { "hebraico": "פֹה֙", "transliteral": "p̄ōh", "traducao_palavra": "aqui" },
        { "hebraico": "וּמִ֣י", "transliteral": "ū-mî", "traducao_palavra": "e quem" },
        { "hebraico": "לְךָ֣", "transliteral": "lə-ḵā", "traducao_palavra": "[há] contigo" },
        { "hebraico": "פֹ֔ה", "transliteral": "p̄ōh", "traducao_palavra": "aqui" },
        { "hebraico": "כִּֽי־חָצַ֥בְתָּ", "transliteral": "kî-ḥā-ṣaḇ-tā", "traducao_palavra": "que cavaste" },
        { "hebraico": "לְּךָ֥", "transliteral": "lə-ḵā", "traducao_palavra": "para ti" },
        { "hebraico": "פֹּ֖ה", "transliteral": "pōh", "traducao_palavra": "aqui" },
        { "hebraico": "קָ֑בֶר", "transliteral": "qā-ḇer", "traducao_palavra": "[uma] sepultura" },
        { "hebraico": "חֹצְבִ֤י", "transliteral": "ḥō-ṣə-ḇî", "traducao_palavra": "lavrando/cavando" },
        { "hebraico": "מָרֹום֙", "transliteral": "mā-rôm", "traducao_palavra": "[em] lugar alto" },
        { "hebraico": "קִבְרֹ֔ו", "transliteral": "qiḇ-rô", "traducao_palavra": "sua sepultura" },
        { "hebraico": "חֹקְקִ֥י", "transliteral": "ḥō-qə-qî", "traducao_palavra": "cinzelando/esculpindo" },
        { "hebraico": "בַסֶּ֖לַע", "transliteral": "baś-śe-laʿ", "traducao_palavra": "na rocha" },
