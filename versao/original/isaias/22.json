        { "hebraico": "לֹֽו׃", "transliteral": "lô", "traducao_palavra": "para si" }
      ]
    },
    "17": {
      "traducao_completa": "Eis que YHWH te lançará fora com grande força, ó homem vigoroso, e te envolverá inteiramente.",
      "palavras": [
        { "hebraico": "הִנֵּ֤ה", "transliteral": "hin-nêh", "traducao_palavra": "Eis que" },
        { "hebraico": "יְהוָה֙", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "מְטַלְטֶלְךָ֔", "transliteral": "mə-ṭal-ṭel-ḵā", "traducao_palavra": "lançará a ti" },
        { "hebraico": "טַלְטֵלָ֖ה", "transliteral": "ṭal-ṭê-lā", "traducao_palavra": "[com] lançamento" },
        { "hebraico": "גָּ֑בֶר", "transliteral": "gā-ḇer", "traducao_palavra": "[ó] homem forte" },
        { "hebraico": "וְעֹטְךָ֖", "transliteral": "wə-ʿō-ṭə-ḵā", "traducao_palavra": "e envolverá a ti" },
        { "hebraico": "עָטֹֽה׃", "transliteral": "ʿā-ṭōh", "traducao_palavra": "firmemente/inteiramente" }
      ]
    },
    "18": {
      "traducao_completa": "Certamente te enrolará como uma bola e te lançará para uma terra larga e espaçosa; ali morrerás, e ali os carros da tua glória serão o opróbrio da casa do teu senhor.",
      "palavras": [
        { "hebraico": "צָנֹ֤וף", "transliteral": "ṣā-nôp̄", "traducao_palavra": "Enrolando" },
        { "hebraico": "יִצְנָפְךָ֙", "transliteral": "yiṣ-nā-p̄ə-ḵā", "traducao_palavra": "enrolará a ti" },
        { "hebraico": "צְנֵפָ֔ה", "transliteral": "ṣə-nê-p̄ā", "traducao_palavra": "[como] um rolo" },
        { "hebraico": "כַּדּ֕וּר", "transliteral": "kad-dûr", "traducao_palavra": "como bola" },
        { "hebraico": "אֶל־אֶ֖רֶץ", "transliteral": "ʾel-ʾe-reṣ", "traducao_palavra": "para terra" },
        { "hebraico": "רַחֲבַ֣ת", "transliteral": "ra-ḥă-ḇaṯ", "traducao_palavra": "larga" },
        { "hebraico": "יָדָ֑יִם", "transliteral": "yā-ḏā-yim", "traducao_palavra": "de mãos/espaçosa" },
        { "hebraico": "שָׁ֣מָּה", "transliteral": "šām-mā", "traducao_palavra": "ali" },
        { "hebraico": "תָמ֔וּת", "transliteral": "ṯā-mûṯ", "traducao_palavra": "morrerás" },
        { "hebraico": "וְשָׁ֖מָּה", "transliteral": "wə-šām-mā", "traducao_palavra": "e ali" },
        { "hebraico": "מַרְכְּבֹ֣ות", "transliteral": "mar-kə-ḇôṯ", "traducao_palavra": "os carros de" },
        { "hebraico": "כְּבֹודֶ֑ךָ", "transliteral": "kə-ḇô-ḏe-ḵā", "traducao_palavra": "tua glória [serão]" },
        { "hebraico": "קְלֹ֖ון", "transliteral": "qə-lôn", "traducao_palavra": "[o] opróbrio de" },
        { "hebraico": "בֵּ֥ית", "transliteral": "bêṯ", "traducao_palavra": "casa de" },
        { "hebraico": "אֲדֹנֶֽיךָ׃", "transliteral": "ʾă-ḏō-ne-y-ḵā", "traducao_palavra": "teu senhor" }
      ]
