        { "hebraico": "בְאָזְנָ֖י", "transliteral": "ḇə-ʾāz-nāy", "traducao_palavra": "em meus ouvidos" },
        { "hebraico": "יְהוָ֣ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "צְבָאֹ֑ות", "transliteral": "ṣə-ḇā-ʾôṯ", "traducao_palavra": "Exércitos" },
        { "hebraico": "אִם־יְ֠כֻפַּר", "transliteral": "ʾim-yə-ḵup-par", "traducao_palavra": "se será expiada/perdoada" },
        { "hebraico": "הֶעָוֹ֨ן", "transliteral": "he-ʿā-wōn", "traducao_palavra": "esta iniquidade" },
        { "hebraico": "הַזֶּ֤ה", "transliteral": "haz-zeh", "traducao_palavra": "esta" },
        { "hebraico": "לָכֶם֙", "transliteral": "lā-ḵem", "traducao_palavra": "a vós" },
        { "hebraico": "עַד־תְּמֻת֔וּן", "transliteral": "ʿaḏ-tə-mu-ṯûn", "traducao_palavra": "até que morrais" },
        { "hebraico": "אָמַ֧ר", "transliteral": "ʾā-mar", "traducao_palavra": "disse" },
        { "hebraico": "אֲדֹנָ֛י", "transliteral": "ʾă-ḏō-nāy", "traducao_palavra": "o Senhor" },
        { "hebraico": "יְהוִ֖ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "צְבָאֹֽות׃", "transliteral": "ṣə-ḇā-ʾôṯ", "traducao_palavra": "Exércitos" }
      ]
    },
    "15": {
      "traducao_completa": "Assim diz o Senhor YHWH dos Exércitos: Vai, entra a este administrador, a Sebna, o mordomo,",
      "palavras": [
        { "hebraico": "כֹּ֥ה", "transliteral": "kōh", "traducao_palavra": "Assim" },
        { "hebraico": "אָמַ֛ר", "transliteral": "ʾā-mar", "traducao_palavra": "disse" },
        { "hebraico": "אֲדֹנָ֥י", "transliteral": "ʾă-ḏō-nāy", "traducao_palavra": "o Senhor" },
        { "hebraico": "יְהוִ֖ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "צְבָאֹ֑ות", "transliteral": "ṣə-ḇā-ʾôṯ", "traducao_palavra": "Exércitos" },
        { "hebraico": "לֶךְ־", "transliteral": "leḵ-", "traducao_palavra": "Vai" },
        { "hebraico": "בֹּ֣א", "transliteral": "bō", "traducao_palavra": "entra" },
        { "hebraico": "אֶל־", "transliteral": "ʾel-", "traducao_palavra": "a" },
        { "hebraico": "הַסֹּכֵ֣ן", "transliteral": "haś-śō-ḵên", "traducao_palavra": "o administrador/mordomo" },
        { "hebraico": "הַזֶּ֔ה", "transliteral": "haz-zeh", "traducao_palavra": "este" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre/contra" },
        { "hebraico": "שֶׁבְנָ֖א", "transliteral": "šeḇ-nā", "traducao_palavra": "Sebna" },
        { "hebraico": "אֲשֶׁ֥ר", "transliteral": "ʾă-šer", "traducao_palavra": "que [está]" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre" },
        { "hebraico": "הַבָּֽיִת׃", "transliteral": "hab-bā-yiṯ", "traducao_palavra": "a casa" }
