{
  "livro": "Isaías - יְשַׁעְיָהוּ - Yeshayahu",
  "capítulo": 22,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Oráculo contra o vale da visão: Que tens agora, que todos subistes aos telhados?",
      "palavras": [
        { "hebraico": "מַשָּׂ֖א", "transliteral": "maś-śāʾ", "traducao_palavra": "Oráculo/peso" },
        { "hebraico": "גֵּ֣יא", "transliteral": "gê", "traducao_palavra": "[do] vale de" },
        { "hebraico": "חִזָּיֹ֑ון", "transliteral": "ḥiz-zā-yôn", "traducao_palavra": "visão" },
        { "hebraico": "מַה־לָּ֣ךְ", "transliteral": "mah-llāḵ", "traducao_palavra": "O que [há] contigo" },
        { "hebraico": "אֵפֹ֔וא", "transliteral": "ʾê-p̄ô", "traducao_palavra": "agora" },
        { "hebraico": "כִּֽי־עָלִ֥ית", "transliteral": "kî-ʿā-lîṯ", "traducao_palavra": "que subiste" },
        { "hebraico": "כֻּלֵּ֖ךְ", "transliteral": "kul-lêḵ", "traducao_palavra": "toda tu" },
        { "hebraico": "לַגַּגֹּֽות׃", "transliteral": "lag-gag-gôṯ", "traducao_palavra": "aos telhados?" }
      ]
    },
    "2": {
      "traducao_completa": "Tu, cheia de clamor, cidade ruidosa, cidade alegre! Os teus mortos não foram mortos à espada, nem morreram na peleja.",
      "palavras": [
        { "hebraico": "תְּשֻׁאֹ֨ות", "transliteral": "tə-šu-ʾôṯ", "traducao_palavra": "[Cheia de] clamores" },
        { "hebraico": "מְלֵאָ֜ה", "transliteral": "mə-lê-ʾā", "traducao_palavra": "repleta" },
        { "hebraico": "עִ֣יר", "transliteral": "ʿîr", "traducao_palavra": "cidade" },
        { "hebraico": "הֹומִיָּ֗ה", "transliteral": "hô-mî-yā", "traducao_palavra": "ruidosa" },
        { "hebraico": "קִרְיָה֙", "transliteral": "qir-yā", "traducao_palavra": "cidade" },
        { "hebraico": "עַלִּיזָ֔ה", "transliteral": "ʿal-lî-zā", "traducao_palavra": "alegre/exultante" },
        { "hebraico": "חֲלָלַ֖יִךְ", "transliteral": "ḥă-lā-la-yiḵ", "traducao_palavra": "teus mortos" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não [foram]" },
        { "hebraico": "חַלְלֵי־", "transliteral": "ḥal-lê-", "traducao_palavra": "mortos de" },
        { "hebraico": "חֶ֔רֶב", "transliteral": "ḥe-reḇ", "traducao_palavra": "espada" },
        { "hebraico": "וְלֹ֖א", "transliteral": "wə-lō", "traducao_palavra": "nem" },
        { "hebraico": "מֵתֵ֥י", "transliteral": "mê-ṯê", "traducao_palavra": "mortos de" },
        { "hebraico": "מִלְחָמָֽה׃", "transliteral": "mil-ḥā-mā", "traducao_palavra": "guerra" }
      ]
    },
    "3": {
      "traducao_completa": "Todos os teus príncipes fugiram juntos, e foram presos pelos arqueiros; todos os que em ti se acharam foram presos juntos, embora tivessem fugido para longe.",
      "palavras": [
        { "hebraico": "כָּל־קְצִינַ֥יִךְ", "transliteral": "kāl-qə-ṣî-na-yiḵ", "traducao_palavra": "Todos os teus governantes" },
        { "hebraico": "נָֽדְדוּ־", "transliteral": "nā-ḏə-ḏû-", "traducao_palavra": "fugiram" },
        { "hebraico": "יַ֗חַד", "transliteral": "ya-ḥaḏ", "traducao_palavra": "juntamente" },
        { "hebraico": "מִקֶּ֥שֶׁת", "transliteral": "miq-qe-šeṯ", "traducao_palavra": "pelo arco" },
        { "hebraico": "אֻסָּ֑רוּ", "transliteral": "ʾuś-śā-rû", "traducao_palavra": "foram presos" },
        { "hebraico": "כָּל־נִמְצָאַ֨יִךְ֙", "transliteral": "kāl-nim-ṣā-ʾa-yiḵ", "traducao_palavra": "todos os teus achados" },
        { "hebraico": "אֻסְּר֣וּ", "transliteral": "ʾuś-śə-rû", "traducao_palavra": "foram presos" },
        { "hebraico": "יַחְדָּ֔ו", "transliteral": "yaḥ-dāw", "traducao_palavra": "juntamente" },
        { "hebraico": "מֵרָחֹ֖וק", "transliteral": "mê-rā-ḥôq", "traducao_palavra": "de longe" },
        { "hebraico": "בָּרָֽחוּ׃", "transliteral": "bā-rā-ḥû", "traducao_palavra": "fugiram" }
      ]
    },
    "4": {
      "traducao_completa": "Portanto disse eu: Desviai de mim o olhar, e chorarei amargamente; não vos canseis por me consolardes pela destruição da filha do meu povo.",
      "palavras": [
        { "hebraico": "עַל־כֵּ֥ן", "transliteral": "ʿal-kên", "traducao_palavra": "Por isso" },
        { "hebraico": "אָמַ֕רְתִּי", "transliteral": "ʾā-mar-tî", "traducao_palavra": "disse eu" },
        { "hebraico": "שְׁע֥וּ", "transliteral": "šə-ʿû", "traducao_palavra": "desviai-vos" },
        { "hebraico": "מִמֶּ֛נִּי", "transliteral": "mim-men-nî", "traducao_palavra": "de mim" },
        { "hebraico": "אֲמָרֵ֥ר", "transliteral": "ʾă-mā-rêr", "traducao_palavra": "chorarei amargamente" },
        { "hebraico": "בַּבֶּ֑כִי", "transliteral": "bab-be-ḵî", "traducao_palavra": "no choro" },
        { "hebraico": "אַל־תָּאִ֣יצוּ", "transliteral": "ʾal-tā-ʾî-ṣû", "traducao_palavra": "não vos apresseis" },
        { "hebraico": "לְנַחֲמֵ֔נִי", "transliteral": "lə-na-ḥă-mê-nî", "traducao_palavra": "em consolar-me" },
        { "hebraico": "עַל־שֹׁ֖ד", "transliteral": "ʿal-šōḏ", "traducao_palavra": "pela destruição de" },
        { "hebraico": "בַּת־עַמִּֽי׃", "transliteral": "baṯ-ʿam-mî", "traducao_palavra": "a filha do meu povo" }
      ]
    },
    "5": {
      "traducao_completa": "Porque dia de alvoroço, e de atropelamento, e de confusão é este, da parte do Senhor YHWH dos Exércitos, no vale da visão; um derrubar de muros, e um clamor que vai até os montes.",
      "palavras": [
        { "hebraico": "כִּ֣י", "transliteral": "kî", "traducao_palavra": "Porque" },
        { "hebraico": "יֹ֤ום", "transliteral": "yôm", "traducao_palavra": "[há um] dia de" },
        { "hebraico": "מְהוּמָה֙", "transliteral": "mə-hû-mā", "traducao_palavra": "alvoroço" },
        { "hebraico": "וּמְבוּסָ֣ה", "transliteral": "ū-mə-ḇû-śā", "traducao_palavra": "e pisoteio/atropelamento" },
        { "hebraico": "וּמְבוּכָ֔ה", "transliteral": "ū-mə-ḇû-ḵā", "traducao_palavra": "e confusão" },
        { "hebraico": "לַאדֹנָ֧י", "transliteral": "la-ʾă-ḏō-nāy", "traducao_palavra": "para o Senhor" },
        { "hebraico": "יְהוִ֛ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "צְבָאֹ֖ות", "transliteral": "ṣə-ḇā-ʾôṯ", "traducao_palavra": "[dos] Exércitos" },
        { "hebraico": "בְּגֵ֣יא", "transliteral": "bə-ḡê", "traducao_palavra": "no vale de" },
        { "hebraico": "חִזָּיֹ֑ון", "transliteral": "ḥiz-zā-yôn", "traducao_palavra": "visão" },
        { "hebraico": "מְקַרְקַ֥ר", "transliteral": "mə-qar-qar", "traducao_palavra": "destruindo/derrubando" },
        { "hebraico": "קִ֝יר", "transliteral": "qîr", "traducao_palavra": "muro" },
        { "hebraico": "וְשֹׁ֥ועַ", "transliteral": "wə-šô-aʿ", "traducao_palavra": "e um clamor" },
        { "hebraico": "אֶל־הָהָֽר׃", "transliteral": "ʾel-he-hār", "traducao_palavra": "para o monte" }
      ]
    },
    "6": {
      "traducao_completa": "E Elão levou a aljava, com carros de homens e cavaleiros; e Quire descobriu o escudo.",
      "palavras": [
        { "hebraico": "וְעֵילָם֙", "transliteral": "wə-ʿê-lām", "traducao_palavra": "E Elão" },
        { "hebraico": "נָשָׂ֣א", "transliteral": "nā-śā", "traducao_palavra": "levou" },
        { "hebraico": "אַשְׁפָּ֔ה", "transliteral": "ʾaš-pā", "traducao_palavra": "[a] aljava" },
        { "hebraico": "בְּרֶ֥כֶב", "transliteral": "bə-re-ḵeḇ", "traducao_palavra": "com carros de" },
        { "hebraico": "אָדָ֖ם", "transliteral": "ʾā-ḏām", "traducao_palavra": "homens" },
        { "hebraico": "פָּֽרָשִׁ֑ים", "transliteral": "pā-rā-šîm", "traducao_palavra": "[e] cavaleiros" },
        { "hebraico": "וְקִ֥יר", "transliteral": "wə-qîr", "traducao_palavra": "e Quire" },
        { "hebraico": "עֵרָ֖ה", "transliteral": "ʿê-rā", "traducao_palavra": "descobriu/desnudou" },
        { "hebraico": "מָגֵֽן׃", "transliteral": "mā-ḡên", "traducao_palavra": "[o] escudo" }
      ]
    },
    "7": {
      "traducao_completa": "E aconteceu que os teus vales mais formosos se encheram de carros, e os cavaleiros se puseram em ordem às portas.",
      "palavras": [
        { "hebraico": "וַיְהִ֥י", "transliteral": "way-hî", "traducao_palavra": "E aconteceu [que]" },
        { "hebraico": "מִבְחַר־", "transliteral": "miḇ-ḥar-", "traducao_palavra": "o melhor de" },
        { "hebraico": "עֲמָקַ֖יִךְ", "transliteral": "ʿă-mā-qa-yiḵ", "traducao_palavra": "teus vales" },
        { "hebraico": "מָ֣לְאוּ", "transliteral": "mā-lə-ʾû", "traducao_palavra": "encheram-se de" },
        { "hebraico": "רָ֑כֶב", "transliteral": "rā-ḵeḇ", "traducao_palavra": "carros" },
        { "hebraico": "וְהַפָּ֣רָשִׁ֔ים", "transliteral": "wə-hap-pā-rā-šîm", "traducao_palavra": "e os cavaleiros" },
        { "hebraico": "שֹׁ֖ת", "transliteral": "šōṯ", "traducao_palavra": "puseram-se" },
        { "hebraico": "שָׁ֥תוּ", "transliteral": "šā-ṯû", "traducao_palavra": "em ordem" },
        { "hebraico": "הַשָּֽׁעְרָה׃", "transliteral": "haš-šā-ʿərā", "traducao_palavra": "no portão" }
      ]
    },
    "8": {
      "traducao_completa": "E ele tirou a cobertura de Judá; e naquele dia olhaste para as armas da casa do bosque.",
      "palavras": [
        { "hebraico": "וַיְגַ֕ל", "transliteral": "way-ḡal", "traducao_palavra": "E ele tirou/descobriu" },
        { "hebraico": "אֵ֖ת", "transliteral": "ʾêṯ", "traducao_palavra": "[objeto]" },
        { "hebraico": "מָסַ֣ךְ", "transliteral": "mā-saḵ", "traducao_palavra": "a cobertura de" },
        { "hebraico": "יְהוּדָ֑ה", "transliteral": "yə-hû-ḏā", "traducao_palavra": "Judá" },
        { "hebraico": "וַתַּבֵּט֙", "transliteral": "wat-tab-bêṭ", "traducao_palavra": "e olhaste" },
        { "hebraico": "בַּיֹּ֣ום", "transliteral": "bay-yôm", "traducao_palavra": "no dia" },
        { "hebraico": "הַה֔וּא", "transliteral": "ha-hû", "traducao_palavra": "aquele" },
        { "hebraico": "אֶל־נֶ֖שֶׁק", "transliteral": "ʾel-ne-šeq", "traducao_palavra": "para o armamento de" },
        { "hebraico": "בֵּ֥ית", "transliteral": "bêṯ", "traducao_palavra": "a casa de" },
        { "hebraico": "הַיָּֽעַר׃", "transliteral": "hay-yā-ʿar", "traducao_palavra": "o Bosque" }
      ]
    },
    "9": {
      "traducao_completa": "E vistes as brechas da cidade de Davi, por serem muitas, e ajuntastes as águas do tanque inferior.",
      "palavras": [
        { "hebraico": "וְאֵ֨ת", "transliteral": "wə-ʾêṯ", "traducao_palavra": "E [objeto]" },
        { "hebraico": "בְּקִיעֵ֧י", "transliteral": "bə-qî-ʿê", "traducao_palavra": "[as] brechas de" },
        { "hebraico": "עִיר־דָּוִ֛ד", "transliteral": "ʿîr-dā-wiḏ", "traducao_palavra": "a cidade de Davi" },
        { "hebraico": "רְאִיתֶ֖ם", "transliteral": "rə-ʾî-ṯem", "traducao_palavra": "vistes" },
        { "hebraico": "כִּֽי־רָ֑בּוּ", "transliteral": "kî-rāb-bû", "traducao_palavra": "porque foram muitas" },
