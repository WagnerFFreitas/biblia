        { "hebraico": "בֶּן־חִלְקִיָּֽהוּ׃", "transliteral": "ben-ḥil-qî-yā-hû", "traducao_palavra": "filho de Hilquias" }
      ]
    },
    "21": {
      "traducao_completa": "e vesti-lo-ei com a tua túnica, e cingi-lo-ei com o teu cinto, e entregarei nas suas mãos o teu domínio; e será como pai para os moradores de Jerusalém e para a casa de Judá.",
      "palavras": [
        { "hebraico": "וְהִלְבַּשְׁתִּ֣יו", "transliteral": "wə-hil-baš-tîw", "traducao_palavra": "E vesti-lo-ei [com]" },
        { "hebraico": "כֻתָּנְתֶּ֗ךָ", "transliteral": "ḵut-tā-ne-ṯe-ḵā", "traducao_palavra": "tua túnica" },
        { "hebraico": "וְאַבְנֵטְךָ֙", "transliteral": "wə-ʾaḇ-nê-ṭə-ḵā", "traducao_palavra": "e teu cinto" },
        { "hebraico": "אֲחַזְּקֶ֔נּוּ", "transliteral": "ʾă-ḥaz-zə-qen-nû", "traducao_palavra": "fortalecerei a ele" },
        { "hebraico": "וּמֶֽמְשַׁלְתְּךָ֖", "transliteral": "ū-mem-šal-tə-ḵā", "traducao_palavra": "e teu domínio" },
        { "hebraico": "אֶתֵּ֣ן", "transliteral": "ʾet-tên", "traducao_palavra": "darei" },
        { "hebraico": "בְּיָדֹ֑ו", "transliteral": "bə-yā-ḏô", "traducao_palavra": "na mão dele" },
        { "hebraico": "וְהָיָ֥ה", "transliteral": "wə-hā-yā", "traducao_palavra": "e ele será" },
        { "hebraico": "לְאָב֙", "transliteral": "lə-ʾāḇ", "traducao_palavra": "por pai" },
        { "hebraico": "לְיֹושֵׁ֣ב", "transliteral": "lə-yô-šêḇ", "traducao_palavra": "para o habitante de" },
        { "hebraico": "יְרוּשָׁלִַ֨ם֙", "transliteral": "yə-rû-šā-la-yim", "traducao_palavra": "Jerusalém" },
        { "hebraico": "וּלְבֵ֥ית", "transliteral": "ū-lə-ḇêṯ", "traducao_palavra": "e para a casa de" },
        { "hebraico": "יְהוּדָֽה׃", "transliteral": "yə-hû-ḏā", "traducao_palavra": "Judá" }
      ]
    },
    "22": {
      "traducao_completa": "E porei a chave da casa de Davi sobre o seu ombro; e abrirá, e ninguém fechará; e fechará, e ninguém abrirá.",
      "palavras": [
        { "hebraico": "וְנָתַתִּ֛י", "transliteral": "wə-nā-ṯat-tî", "traducao_palavra": "E porei" },
        { "hebraico": "מַפְתֵּ֥חַ", "transliteral": "map̄-tê-aḥ", "traducao_palavra": "[a] chave de" },
        { "hebraico": "בֵּית־דָּוִ֖ד", "transliteral": "bêṯ-dā-wiḏ", "traducao_palavra": "casa de Davi" },
        { "hebraico": "עַל־שִׁכְמֹ֑ו", "transliteral": "ʿal-šiḵ-mô", "traducao_palavra": "sobre seu ombro" },
        { "hebraico": "וּפָתַח֙", "transliteral": "ū-p̄ā-ṯaḥ", "traducao_palavra": "e abrirá" },
        { "hebraico": "וְאֵ֣ין", "transliteral": "wə-ʾên", "traducao_palavra": "e não [haverá]" },
        { "hebraico": "סֹגֵ֔ר", "transliteral": "śō-ḡêr", "traducao_palavra": "[quem] feche" },
        { "hebraico": "וְסָגַ֖ר", "transliteral": "wə-śā-ḡar", "traducao_palavra": "e fechará" },
        { "hebraico": "וְאֵ֥ין", "transliteral": "wə-ʾên", "traducao_palavra": "e não [haverá]" },
        { "hebraico": "פֹּתֵֽחַ׃", "transliteral": "pō-ṯê-aḥ", "traducao_palavra": "[quem] abra" }
      ]
    },
    "23": {
      "traducao_completa": "E fincá-lo-ei como um prego num lugar firme; e será como um trono de glória para a casa de seu pai.",
      "palavras": [
        { "hebraico": "וּתְקַעְתִּ֥יו", "transliteral": "ū-ṯə-qaʿ-tîw", "traducao_palavra": "E fincá-lo-ei" },
        { "hebraico": "יָתֵ֖ד", "transliteral": "yā-ṯêḏ", "traducao_palavra": "[como] prego/estaca" },
        { "hebraico": "בְּמָקֹ֣ום", "transliteral": "bə-mā-qôm", "traducao_palavra": "em lugar" },
        { "hebraico": "נֶאֱמָ֑ן", "transliteral": "ne-ʾĕ-mān", "traducao_palavra": "firme/seguro" },
        { "hebraico": "וְהָיָה֙", "transliteral": "wə-hā-yā", "traducao_palavra": "e será" },
        { "hebraico": "לְכִסֵּ֣א", "transliteral": "lə-ḵis-śê", "traducao_palavra": "por trono de" },
        { "hebraico": "כָבֹ֔וד", "transliteral": "ḵā-ḇôḏ", "traducao_palavra": "glória" },
        { "hebraico": "לְבֵ֥ית", "transliteral": "lə-ḇêṯ", "traducao_palavra": "para a casa de" },
        { "hebraico": "אָבִֽיו׃", "transliteral": "ʾā-ḇîw", "traducao_palavra": "seu pai" }
      ]
    },
    "24": {
      "traducao_completa": "E sobre ele pendurarão toda a glória da casa de seu pai, a prole e a posteridade, todos os utensílios menores, desde as taças até todos os frascos.",
      "palavras": [
