    "19": {
      "traducao_completa": "E lançar-te-ei fora do teu posto, e ele te derrubará do teu lugar.",
      "palavras": [
        { "hebraico": "וַהֲדַפְתִּ֖יךָ", "transliteral": "wa-hă-ḏap̄-tî-ḵā", "traducao_palavra": "E empurrar-te-ei/lançarei" },
        { "hebraico": "מִמַּצָּבֶ֑ךָ", "transliteral": "mim-maṣ-ṣā-ḇe-ḵā", "traducao_palavra": "do teu posto" },
        { "hebraico": "וּמִמַּעֲמָֽדְךָ֖", "transliteral": "ū-mim-ma-ʿă-mā-ḏə-ḵā", "traducao_palavra": "e do teu estado/lugar" },
        { "hebraico": "יֶהֶרְסֶֽךָ׃", "transliteral": "ye-her-se-ḵā", "traducao_palavra": "ele te derrubará" }
      ]
    },
    "20": {
      "traducao_completa": "E acontecerá naquele dia que chamarei a meu servo Eliaquim, filho de Hilquias;",
      "palavras": [
        { "hebraico": "וְהָיָ֖ה", "transliteral": "wə-hā-yā", "traducao_palavra": "E acontecerá" },
        { "hebraico": "בַּיֹּ֣ום", "transliteral": "bay-yôm", "traducao_palavra": "no dia" },
        { "hebraico": "הַה֑וּא", "transliteral": "ha-hû", "traducao_palavra": "aquele" },
        { "hebraico": "וְקָרָ֥אתִי", "transliteral": "wə-qā-rā-ṯî", "traducao_palavra": "que chamarei" },
        { "hebraico": "לְעַבְדִּ֖י", "transliteral": "lə-ʿaḇ-dî", "traducao_palavra": "a meu servo" },
