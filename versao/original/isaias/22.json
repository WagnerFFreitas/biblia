        { "hebraico": "אֶת־מֵ֥י", "transliteral": "ʾeṯ-mê", "traducao_palavra": "[objeto] as águas de" },
        { "hebraico": "הַבְּרֵכָ֖ה", "transliteral": "hab-bə-rê-ḵā", "traducao_palavra": "a piscina/tanque" },
        { "hebraico": "הַתַּחְתֹּונָֽה׃", "transliteral": "hat-taḥ-tô-nā", "traducao_palavra": "inferior" }
      ]
    },
    "10": {
      "traducao_completa": "E contastes as casas de Jerusalém, e derrubastes as casas para fortificar o muro.",
      "palavras": [
        { "hebraico": "וְאֶת־בָּתֵּ֥י", "transliteral": "wə-ʾeṯ-bāt-tê", "traducao_palavra": "E as casas de" },
        { "hebraico": "יְרוּשָׁלִַ֖ם", "transliteral": "yə-rû-šā-la-yim", "traducao_palavra": "Jerusalém" },
        { "hebraico": "סְפַרְתֶּ֑ם", "transliteral": "śə-p̄ar-tem", "traducao_palavra": "contastes" },
        { "hebraico": "וַתִּתְצוּ֙", "transliteral": "wat-tiṯ-ṣû", "traducao_palavra": "e derrubastes" },
        { "hebraico": "הַבָּתִּ֔ים", "transliteral": "hab-bā-tîm", "traducao_palavra": "as casas" },
        { "hebraico": "לְבַצֵּ֖ר", "transliteral": "lə-ḇaṣ-ṣêr", "traducao_palavra": "para fortalecer" },
        { "hebraico": "הַחֹומָֽה׃", "transliteral": "ha-ḥô-mā", "traducao_palavra": "o muro" }
      ]
    },
    "11": {
      "traducao_completa": "Fizestes também um reservatório entre os dois muros para as águas do tanque velho; porém não olhastes para aquele que isto fez, nem considerastes o que o formou desde antigamente.",
      "palavras": [
        { "hebraico": "וּמִקְוָ֨ה", "transliteral": "ū-miq-wā", "traducao_palavra": "E um reservatório" },
        { "hebraico": "עֲשִׂיתֶ֜ם", "transliteral": "ʿă-śî-ṯem", "traducao_palavra": "fizestes" },
        { "hebraico": "בֵּ֣ין", "transliteral": "bên", "traducao_palavra": "entre" },
        { "hebraico": "הַחֹמֹתַ֗יִם", "transliteral": "ha-ḥō-mō-ṯa-yim", "traducao_palavra": "os dois muros" },
        { "hebraico": "לְמֵי֙", "transliteral": "lə-mê", "traducao_palavra": "para as águas de" },
        { "hebraico": "הַבְּרֵכָ֣ה", "transliteral": "hab-bə-rê-ḵā", "traducao_palavra": "o tanque" },
        { "hebraico": "הַיְשָׁנָ֔ה", "transliteral": "hay-šā-nā", "traducao_palavra": "antigo" },
        { "hebraico": "וְלֹ֥א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "הִבַּטְתֶּ֖ם", "transliteral": "hib-baṭ-tem", "traducao_palavra": "olhastes" },
        { "hebraico": "אֶל־עֹשֶׂ֑יהָ", "transliteral": "ʾel-ʿō-śe-y-hā", "traducao_palavra": "para o seu fazedor" },
        { "hebraico": "וְיֹצְרָ֥הּ", "transliteral": "wə-yō-ṣə-rāh", "traducao_palavra": "e o seu formador" },
        { "hebraico": "מֵרָחֹ֖וק", "transliteral": "mê-rā-ḥôq", "traducao_palavra": "desde longe/antigamente" },
        { "hebraico": "לֹ֥א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "רְאִיתֶֽם׃", "transliteral": "rə-ʾî-ṯem", "traducao_palavra": "vistes/considerastes" }
      ]
    },
    "12": {
      "traducao_completa": "E o Senhor YHWH dos Exércitos chamou naquele dia ao choro, e ao pranto, e à calvície, e ao cingir de cilício.",
      "palavras": [
        { "hebraico": "וַיִּקְרָ֞א", "transliteral": "way-yiq-rā", "traducao_palavra": "E chamou" },
        { "hebraico": "אֲדֹנָ֧י", "transliteral": "ʾă-ḏō-nāy", "traducao_palavra": "o Senhor" },
        { "hebraico": "יְהוִ֛ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "צְבָאֹ֖ות", "transliteral": "ṣə-ḇā-ʾôṯ", "traducao_palavra": "Exércitos" },
        { "hebraico": "בַּיֹּ֣ום", "transliteral": "bay-yôm", "traducao_palavra": "no dia" },
        { "hebraico": "הַה֑וּא", "transliteral": "ha-hû", "traducao_palavra": "aquele" },
        { "hebraico": "לִבְכִ֣י", "transliteral": "liḇ-ḵî", "traducao_palavra": "para o choro" },
        { "hebraico": "וּלְמִסְפֵּ֔ד", "transliteral": "ū-lə-mis-pêḏ", "traducao_palavra": "e para o pranto" },
        { "hebraico": "וּלְקָרְחָה֙", "transliteral": "ū-lə-qār-ḥā", "traducao_palavra": "e para a calvície" },
        { "hebraico": "וּלְחֲגֹ֥ר", "transliteral": "ū-lə-ḥă-ḡōr", "traducao_palavra": "e para o cingir de" },
        { "hebraico": "שָֽׂק׃", "transliteral": "śāq", "traducao_palavra": "saco/cilício" }
      ]
    },
    "13": {
      "traducao_completa": "Porém eis aqui gozo e alegria, matam-se bois e degolam-se ovelhas, come-se carne e bebe-se vinho, dizendo: Comamos e bebamos, porque amanhã morreremos.",
      "palavras": [
        { "hebraico": "וְהִנֵּ֣ה ׀", "transliteral": "wə-hin-nēh", "traducao_palavra": "E eis que [há]" },
        { "hebraico": "שָׂשֹׂ֣ון", "transliteral": "śā-śôn", "traducao_palavra": "gozo" },
        { "hebraico": "וְשִׂמְחָ֗ה", "transliteral": "wə-śim-ḥā", "traducao_palavra": "e alegria" },
        { "hebraico": "הָרֹ֣ג", "transliteral": "hā-rōḡ", "traducao_palavra": "matar" },
        { "hebraico": "בָּקָר֮", "transliteral": "bā-qār", "traducao_palavra": "gado" },
        { "hebraico": "וְשָׁחֹ֣ט", "transliteral": "wə-šā-ḥōṭ", "traducao_palavra": "e degolar" },
        { "hebraico": "צֹאן֒", "transliteral": "ṣōn", "traducao_palavra": "ovelhas" },
        { "hebraico": "אָכֹ֥ל", "transliteral": "ʾā-ḵōl", "traducao_palavra": "comer" },
        { "hebraico": "בָּשָׂ֖ר", "transliteral": "bā-śār", "traducao_palavra": "carne" },
        { "hebraico": "וְשָׁתֹ֣ות", "transliteral": "wə-šā-ṯôṯ", "traducao_palavra": "e beber" },
        { "hebraico": "יָ֑יִן", "transliteral": "yā-yin", "traducao_palavra": "vinho" },
        { "hebraico": "אָכֹ֥ול", "transliteral": "ʾā-ḵôl", "traducao_palavra": "comamos" },
        { "hebraico": "וְשָׁתֹ֖ו", "transliteral": "wə-šā-ṯô", "traducao_palavra": "e bebamos" },
        { "hebraico": "כִּ֥י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "מָחָ֥ר", "transliteral": "mā-ḥār", "traducao_palavra": "amanhã" },
        { "hebraico": "נָמֽוּת׃", "transliteral": "nā-mûṯ", "traducao_palavra": "morreremos" }
      ]
    },
    "14": {
      "traducao_completa": "Mas YHWH dos Exércitos revelou-se aos meus ouvidos, dizendo: Certamente esta iniquidade não vos será perdoada até que morrais, diz o Senhor YHWH dos Exércitos.",
      "palavras": [
