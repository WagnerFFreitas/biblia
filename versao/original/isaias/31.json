        { "hebraico": "כֹ֣ה", "transliteral": "ḵō", "traducao_palavra": "assim" },
        { "hebraico": "אָֽמַר־יְהוָ֣ה ׀ אֵלַ֡י", "transliteral": "ʾā-mar-YHWH ʾê-lay", "traducao_palavra": "disse YHWH a mim" },
