    "3": {
      "traducao_completa": "Pois os egípcios são homens, e não Deus; e os seus cavalos carne, e não espírito; e quando YHWH estender a sua mão, tropeçará o que dá ajuda, e cairá o ajudado, e todos juntamente perecerão.",
      "palavras": [
        { "hebraico": "וּמִצְרַיִם֩", "transliteral": "ū-miṣ-ra-yim", "traducao_palavra": "E [os] egípcios" },
