        { "hebraico": "הִגַּ֔דְתִּי", "transliteral": "hig-gaḏ-tî", "traducao_palavra": "anunciei" },
        { "hebraico": "וּמִפִּ֥י", "transliteral": "ū-mip-pî", "traducao_palavra": "e da minha boca" },
        { "hebraico": "יָצְא֖וּ", "transliteral": "yā-ṣə-ʾū", "traducao_palavra": "saíram" },
        { "hebraico": "וְאַשְׁמִיעֵ֑ם", "transliteral": "wə-ʾaš-mî-ʿēm", "traducao_palavra": "e as fiz ouvir" },
