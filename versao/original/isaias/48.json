        { "hebraico": "יִכָּרֵ֧ת", "transliteral": "yik-kā-rēṯ", "traducao_palavra": "seria cortado" },
        { "hebraico": "וְלֹֽא־", "transliteral": "wə-lō-", "traducao_palavra": "e não" },
