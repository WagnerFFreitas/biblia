        { "hebraico": "וְלֹ֥א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "יְדַעְתָּֽם׃", "transliteral": "yə-ḏa-ʿ-tām", "traducao_palavra": "conhecias elas." }
