        { "hebraico": "וַתָּבֹֽאנָה׃", "transliteral": "wat-tā-ḇō-ne-nāh", "traducao_palavra": "e elas vieram/aconteceram." }
      ]
    },
    "4": {
      "traducao_completa": "Porque eu sabia que eras obstinado, e que a tua cerviz é um tendão de ferro, e a tua testa de bronze.",
      "palavras": [
        { "hebraico": "מִדַּעְתִּ֕י", "transliteral": "mid-da-ʿ-tî", "traducao_palavra": "Por eu saber" },
        { "hebraico": "כִּ֥י", "transliteral": "kî", "traducao_palavra": "que" },
        { "hebraico": "קָשֶׁ֖ה", "transliteral": "qā-šeh", "traducao_palavra": "duro/obstinado" },
        { "hebraico": "אָ֑תָּה", "transliteral": "ʾāt-tā", "traducao_palavra": "[és] tu" },
        { "hebraico": "וְגִיד־", "transliteral": "wə-ḡîḏ-", "traducao_palavra": "e tendão de" },
        { "hebraico": "בַּרְזֶ֥ל", "transliteral": "bar-zel", "traducao_palavra": "ferro" },
        { "hebraico": "עָרְפֶּ֖ךָ", "transliteral": "ʿār-pe-ḵā", "traducao_palavra": "[é] o teu pescoço" },
        { "hebraico": "וּמִצְחֲךָ֥", "transliteral": "ū-miṣ-ḥă-ḵā", "traducao_palavra": "e a tua testa" },
