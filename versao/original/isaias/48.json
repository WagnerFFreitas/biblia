    "3": {
      "traducao_completa": "As primeiras coisas desde a antiguidade as anunciei; da minha boca saíram, e eu as fiz ouvir; de repente as fiz, e elas aconteceram.",
      "palavras": [
        { "hebraico": "הָרִאשֹׁנֹות֙", "transliteral": "hā-ri-šō-nō-wṯ", "traducao_palavra": "As primeiras [coisas]" },
