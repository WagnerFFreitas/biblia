        { "hebraico": "בָהֶ֖ם", "transliteral": "ḇā-hem", "traducao_palavra": "entre eles" },
        { "hebraico": "הִגִּ֣יד", "transliteral": "hig-gîḏ", "traducao_palavra": "anunciou" },
        { "hebraico": "אֶת־", "transliteral": "ʾeṯ-", "traducao_palavra": "[partícula acusativa]" },
