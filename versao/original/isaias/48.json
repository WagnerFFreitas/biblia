        { "hebraico": "דִּבַּ֑רְתִּי", "transliteral": "dib-bar-tî", "traducao_palavra": "falei" },
        { "hebraico": "אַף־", "transliteral": "ʾap̄-", "traducao_palavra": "também" },
        { "hebraico": "קְרָאתִ֛יו", "transliteral": "qə-rā-ṯîw", "traducao_palavra": "chamei-o" },
        { "hebraico": "הֲבִיאֹתִ֖יו", "transliteral": "hă-ḇî-ʾō-ṯîw", "traducao_palavra": "trouxe-o" },
