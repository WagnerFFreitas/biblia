        { "hebraico": "אֶעֱשֶׂ֖ה", "transliteral": "ʾe-ʿĕ-śeh", "traducao_palavra": "farei" },
        { "hebraico": "כִּ֣י", "transliteral": "kî", "traducao_palavra": "pois" },
