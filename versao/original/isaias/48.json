        { "hebraico": "הִקְשַׁ֣בְתָּ", "transliteral": "hiq-šaḇ-tā", "traducao_palavra": "atendesses/ouvisses" },
        { "hebraico": "לְמִצְוֹתָ֑י", "transliteral": "lə-miṣ-wō-ṯāy", "traducao_palavra": "aos meus mandamentos" },
