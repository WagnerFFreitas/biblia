        { "hebraico": "מֵאָ֔ז", "transliteral": "mē-ʾāz", "traducao_palavra": "desde então" },
        { "hebraico": "בְּטֶ֥רֶם", "transliteral": "bə-ṭe-rem", "traducao_palavra": "antes" },
