    "6": {
      "traducao_completa": "Já ouviste; olha para tudo isto; e vós, não o anunciareis? Desde agora te faço ouvir coisas novas e escondidas, que não conhecias.",
      "palavras": [
        { "hebraico": "שָׁמַ֤עְתָּ", "transliteral": "šā-ma-ʿtā", "traducao_palavra": "Ouviste" },
