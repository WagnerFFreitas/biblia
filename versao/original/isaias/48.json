        { "hebraico": "עֹֽנִי׃", "transliteral": "ʿō-nî", "traducao_palavra": "aflição/pobreza." }
      ]
    },
    "11": {
      "traducao_completa": "Por amor de mim, por amor de mim o farei, porque como seria profanado o meu nome? E a minha glória não a darei a outrem.",
