        { "hebraico": "שְׁמַעְתָּ֑ם", "transliteral": "šə-ma-ʿ-tām", "traducao_palavra": "ouviste elas" },
        { "hebraico": "פֶּן־", "transliteral": "pen-", "traducao_palavra": "para que não" },
