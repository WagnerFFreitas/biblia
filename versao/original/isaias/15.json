        { "hebraico": "כִּֽי־הִקִּ֥יפָה", "transliteral": "kî-hiq-qî-p̄ā", "traducao_palavra": "Pois rodeou" },
        { "hebraico": "הַזְּעָקָ֖ה", "transliteral": "haz-zə-ʿā-qā", "traducao_palavra": "o clamor" },
