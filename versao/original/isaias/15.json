  "versiculos": {
    "1": {
      "traducao_completa": "Oráculo contra Moabe: Porque numa noite foi destruída Ar de Moabe e ela pereceu; porque numa noite foi destruída Quir de Moabe e ela pereceu.",
      "palavras": [
        { "hebraico": "מַשָּׂ֖א", "transliteral": "maś-śā", "traducao_palavra": "Oráculo/peso" },
        { "hebraico": "מֹואָ֑ב", "transliteral": "mô-ʾāḇ", "traducao_palavra": "Moabe" },
        { "hebraico": "כִּ֠י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "בְּלֵ֣יל", "transliteral": "bə-lêl", "traducao_palavra": "em noite" },
        { "hebraico": "שֻׁדַּ֧ד", "transliteral": "šud-daḏ", "traducao_palavra": "foi devastada" },
        { "hebraico": "עָ֣ר", "transliteral": "ʿār", "traducao_palavra": "Ar" },
        { "hebraico": "מֹואָב֮", "transliteral": "mô-ʾāḇ", "traducao_palavra": "Moabe" },
        { "hebraico": "נִדְמָה֒", "transliteral": "niḏ-mā", "traducao_palavra": "pereceu/foi destruída" },
        { "hebraico": "כִּ֠י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "בְּלֵ֣יל", "transliteral": "bə-lêl", "traducao_palavra": "em noite" },
        { "hebraico": "שֻׁדַּ֧ד", "transliteral": "šud-daḏ", "traducao_palavra": "foi devastada" },
        { "hebraico": "קִיר־מֹואָב֮", "transliteral": "qîr-mô-ʾāḇ", "traducao_palavra": "Quir de Moabe" },
        { "hebraico": "נִדְמָֽה׃", "transliteral": "niḏ-mā", "traducao_palavra": "pereceu" }
      ]
    },
    "2": {
      "traducao_completa": "Subiu Bajite e Dibom aos altos para chorar; Moabe uiva sobre Nebo e sobre Medeba; em todas as suas cabeças haverá calvície, e toda a barba será cortada.",
      "palavras": [
