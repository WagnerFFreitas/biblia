        { "hebraico": "עַד־יַ֥הַץ", "transliteral": "ʿaḏ-ya-haṣ", "traducao_palavra": "até Jaza" },
        { "hebraico": "נִשְׁמַ֖ע", "transliteral": "niš-maʿ", "traducao_palavra": "ouviu-se" },
        { "hebraico": "קֹולָ֑ם", "transliteral": "qô-lām", "traducao_palavra": "[a] voz deles" },
        { "hebraico": "עַל־כֵּ֗ן", "transliteral": "ʿal-kên", "traducao_palavra": "por isso" },
        { "hebraico": "חֲלֻצֵ֤י", "transliteral": "ḥă-lu-ṣê", "traducao_palavra": "[os] armados de" },
        { "hebraico": "מֹואָב֙", "transliteral": "mô-ʾāḇ", "traducao_palavra": "Moabe" },
        { "hebraico": "יָרִ֔יעוּ", "transliteral": "yā-rî-ʿû", "traducao_palavra": "gritam/uivam" },
        { "hebraico": "נַפְשֹׁ֖ו", "transliteral": "nap̄-šô", "traducao_palavra": "sua alma" },
        { "hebraico": "יָֽרְעָה־לֹּֽו׃", "transliteral": "yā-rə-ʿā-lô", "traducao_palavra": "treme/sofre dentro dele" }
      ]
    },
    "5": {
      "traducao_completa": "O meu coração clama por Moabe; os seus fugitivos vão até Zoar, como uma bezerra de três anos; porque sobem a ladeira de Luíte chorando, e no caminho de Horonaim levantam um grito de destruição.",
      "palavras": [
        { "hebraico": "לִבִּי֙", "transliteral": "lib-bî", "traducao_palavra": "Meu coração" },
        { "hebraico": "לְמֹואָ֣ב", "transliteral": "lə-mô-ʾāḇ", "traducao_palavra": "por Moabe" },
        { "hebraico": "יִזְעָ֔ק", "transliteral": "yiz-ʿāq", "traducao_palavra": "clama" },
        { "hebraico": "בְּרִיחֶ֕הָ", "transliteral": "bə-rî-ḥe-hā", "traducao_palavra": "[os] fugitivos dela" },
        { "hebraico": "עַד־צֹ֖עַר", "transliteral": "ʿaḏ-ṣō-ʿar", "traducao_palavra": "até Zoar" },
        { "hebraico": "עֶגְלַ֣ת", "transliteral": "ʿeḡ-laṯ", "traducao_palavra": "[como] novilha de" },
        { "hebraico": "שְׁלִשִׁיָּ֑ה", "transliteral": "šə-li-šî-yā", "traducao_palavra": "três anos" },
        { "hebraico": "כִּ֣י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "מַעֲלֵ֣ה", "transliteral": "ma-ʿă-lê", "traducao_palavra": "[pela] subida de" },
        { "hebraico": "הַלּוּחִ֗ית", "transliteral": "hal-lû-ḥîṯ", "traducao_palavra": "Luíte" },
        { "hebraico": "בִּבְכִי֙", "transliteral": "biḇ-ḵî", "traducao_palavra": "com choro" },
        { "hebraico": "יַֽעֲלֶה־בֹּ֔ו", "transliteral": "ya-ʿă-leh-bô", "traducao_palavra": "subirão por ela" },
        { "hebraico": "כִּ֚י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "דֶּ֣רֶךְ", "transliteral": "de-reḵ", "traducao_palavra": "[no] caminho de" },
        { "hebraico": "חֹורֹנַ֔יִם", "transliteral": "ḥô-rō-na-yim", "traducao_palavra": "Horonaim" },
        { "hebraico": "זַעֲקַת־שֶׁ֖בֶר", "transliteral": "za-ʿă-qaṯ-še-ḇer", "traducao_palavra": "[um] clamor de destruição" },
        { "hebraico": "יְעֹעֵֽרוּ׃", "transliteral": "yə-ʿō-ʿê-rû", "traducao_palavra": "levantarão/despertarão" }
      ]
    },
    "6": {
      "traducao_completa": "Porque as águas de Ninrim secarão; secou-se o feno, murchou a erva, e não há verdura alguma.",
      "palavras": [
        { "hebraico": "כִּֽי־מֵ֥י", "transliteral": "kî-mê", "traducao_palavra": "Pois as águas de" },
        { "hebraico": "נִמְרִ֖ים", "transliteral": "nim-rîm", "traducao_palavra": "Ninrim" },
        { "hebraico": "מְשַׁמֹּ֣ות", "transliteral": "mə-šam-môṯ", "traducao_palavra": "assoladas/secas" },
        { "hebraico": "יִהְי֑וּ", "transliteral": "yih-yû", "traducao_palavra": "serão" },
