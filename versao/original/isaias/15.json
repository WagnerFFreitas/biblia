        { "hebraico": "לֹ֥א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "הָיָֽה׃", "transliteral": "hā-yā", "traducao_palavra": "houve" }
      ]
    },
    "7": {
      "traducao_completa": "Por isso o que ajuntaram e o que guardaram, eles o levarão para o ribeiro dos salgueiros.",
      "palavras": [
        { "hebraico": "עַל־כֵּ֖ן", "transliteral": "ʿal-kên", "traducao_palavra": "Por isso" },
        { "hebraico": "יִתְרָ֣ה", "transliteral": "yiṯ-rā", "traducao_palavra": "[a] abundância/excesso [que]" },
        { "hebraico": "עָשָׂ֑ה", "transliteral": "ā-śā", "traducao_palavra": "fez/ajuntou" },
        { "hebraico": "וּפְקֻדָּתָ֔ם", "transliteral": "ū-p̄ə-qud-dā-ṯām", "traducao_palavra": "e o que guardaram" },
        { "hebraico": "עַ֛ל", "transliteral": "ʿal", "traducao_palavra": "para/sobre" },
        { "hebraico": "נַ֥חַל", "transliteral": "na-ḥal", "traducao_palavra": "ribeiro de" },
        { "hebraico": "הָעֲרָבִ֖ים", "transliteral": "hā-ʿă-rā-ḇîm", "traducao_palavra": "os salgueiros" },
        { "hebraico": "יִשָּׂאֽוּם׃", "transliteral": "yiś-śā-ʾûm", "traducao_palavra": "carregarão eles" }
      ]
    },
    "8": {
      "traducao_completa": "Porque o clamor rodeou os limites de Moabe; até Eglaim chegou o seu uivo, e até Beer-Elim o seu lamento.",
