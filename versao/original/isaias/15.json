      ]
    },
    "9": {
      "traducao_completa": "Porque as águas de Dimom estão cheias de sangue; porque ainda acrescentarei mais a Dimom, leões contra os que escaparem de Moabe e contra o remanescente da terra.",
      "palavras": [
        { "hebraico": "כִּ֣י", "transliteral": "kî", "traducao_palavra": "Porque" },
        { "hebraico": "מֵ֤י דִימֹון֙", "transliteral": "mê ḏî-môn", "traducao_palavra": "as águas de Dimom" },
        { "hebraico": "מָ֣לְאוּ", "transliteral": "mā-lə-ʾû", "traducao_palavra": "encheram-se de" },
        { "hebraico": "דָ֔ם", "transliteral": "ḏām", "traducao_palavra": "sangue" },
