        { "hebraico": "הַבַּ֧יִת", "transliteral": "hab-ba-yiṯ", "traducao_palavra": "ao Templo/Bajite" },
        { "hebraico": "וְדִיבֹ֛ן", "transliteral": "wə-ḏî-ḇōn", "traducao_palavra": "e Dibom" },
        { "hebraico": "הַבָּמֹ֖ות", "transliteral": "hab-bā-môṯ", "traducao_palavra": "[aos] altos" },
        { "hebraico": "לְבֶ֑כִי", "transliteral": "lə-ḇe-ḵî", "traducao_palavra": "para chorar" },
        { "hebraico": "עַל־נְבֹ֞ו", "transliteral": "ʿal-nə-ḇô", "traducao_palavra": "sobre Nebo" },
        { "hebraico": "וְעַל־מֵֽידְבָ֤א", "transliteral": "wə-ʿal-mê-ḏə-ḇā", "traducao_palavra": "e sobre Medeba" },
        { "hebraico": "מֹואָב֙", "transliteral": "mô-ʾāḇ", "traducao_palavra": "Moabe" },
        { "hebraico": "יְיֵלִ֔יל", "transliteral": "yə-yê-lîl", "traducao_palavra": "uivará" },
        { "hebraico": "בְּכָל־רֹאשָׁ֣יו", "transliteral": "bə-ḵāl-rō-šāyw", "traducao_palavra": "em todas suas cabeças" },
        { "hebraico": "קָרְחָ֔ה", "transliteral": "qār-ḥā", "traducao_palavra": "[haverá] calvície" },
        { "hebraico": "כָּל־זָקָ֖ן", "transliteral": "kāl-zā-qān", "traducao_palavra": "toda barba" },
        { "hebraico": "גְּרוּעָֽה׃", "transliteral": "gə-rû-ʿā", "traducao_palavra": "[será] raspada/cortada" }
      ]
    },
    "3": {
      "traducao_completa": "Nas suas ruas cingem-se de sacos; nos seus terraços e nas suas praças todos uivam, chorando abundantemente.",
      "palavras": [
        { "hebraico": "בְּחוּצֹתָ֖יו", "transliteral": "bə-ḥû-ṣō-ṯāyw", "traducao_palavra": "Nas suas ruas" },
        { "hebraico": "חָ֣גְרוּ", "transliteral": "ḥā-ḡə-rû", "traducao_palavra": "cingiram" },
        { "hebraico": "שָׂ֑ק", "transliteral": "śāq", "traducao_palavra": "pano de saco" },
        { "hebraico": "עַ֣ל", "transliteral": "ʿal", "traducao_palavra": "sobre" },
        { "hebraico": "גַּגֹּותֶ֧יהָ", "transliteral": "gag-gô-ṯe-hā", "traducao_palavra": "os seus terraços" },
        { "hebraico": "וּבִרְחֹבֹתֶ֛יהָ", "transliteral": "ū-ḇir-ḥō-ḇō-ṯe-hā", "traducao_palavra": "e nas suas praças" },
        { "hebraico": "כֻּלֹּ֥ו", "transliteral": "kul-lô", "traducao_palavra": "todo ele" },
        { "hebraico": "יְיֵלִ֖יל", "transliteral": "yə-yê-lîl", "traducao_palavra": "uivará" },
        { "hebraico": "יֹרֵ֥ד", "transliteral": "yō-rêḏ", "traducao_palavra": "descendo" },
        { "hebraico": "בַּבֶּֽכִי׃", "transliteral": "bab-be-ḵî", "traducao_palavra": "em choro" }
      ]
    },
    "4": {
      "traducao_completa": "Hesbom e Eleale clamam; até Jaza se ouve a sua voz; por isso os armados de Moabe clamam; a sua alma treme dentro dele.",
      "palavras": [
