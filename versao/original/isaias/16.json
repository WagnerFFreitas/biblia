        { "hebraico": "כַ֥ר", "transliteral": "ḵar", "traducao_palavra": "[o] cordeiro" },
        { "hebraico": "מֹֽשֵׁל־", "transliteral": "mō-šêl-", "traducao_palavra": "[ao] dominador de" },
        { "hebraico": "אֶ֖רֶץ", "transliteral": "ʾe-reṣ", "traducao_palavra": "[a] terra" },
        { "hebraico": "מִסֶּ֨לַע", "transliteral": "miś-se-laʿ", "traducao_palavra": "desde Sela" },
