        { "hebraico": "שִׂבְמָ֗ה", "transliteral": "śiḇ-mā", "traducao_palavra": "Sibma" },
        { "hebraico": "בַּעֲלֵ֤י", "transliteral": "ba-ʿă-lê", "traducao_palavra": "[os] senhores de" },
        { "hebraico": "גֹויִם֙", "transliteral": "gô-yim", "traducao_palavra": "nações" },
        { "hebraico": "הָלְמ֣וּ", "transliteral": "hā-lə-mû", "traducao_palavra": "quebraram/golpearam" },
        { "hebraico": "שְׁרוּקֶּ֔יהָ", "transliteral": "šə-rûq-qe-hā", "traducao_palavra": "suas vides escolhidas" },
        { "hebraico": "עַד־יַעְזֵ֥ר", "transliteral": "ʿaḏ-yaʿ-zêr", "traducao_palavra": "até Jazer" },
        { "hebraico": "נָגָ֖עוּ", "transliteral": "nā-ḡā-ʿû", "traducao_palavra": "chegaram" },
        { "hebraico": "תָּע֣וּ", "transliteral": "tā-ʿû", "traducao_palavra": "erraram/vaguearam" },
