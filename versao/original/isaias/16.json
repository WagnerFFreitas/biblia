      ]
    },
    "7": {
      "traducao_completa": "Portanto Moabe uivará por Moabe, todos uivarão; pelos fundamentos de Quir-Haresete gemereis, certamente abatidos.",
      "palavras": [
        { "hebraico": "לָכֵ֗ן", "transliteral": "lā-ḵên", "traducao_palavra": "Portanto" },
        { "hebraico": "יְיֵלִ֧יל", "transliteral": "yə-yê-lîl", "traducao_palavra": "uivará" },
        { "hebraico": "מֹואָ֛ב", "transliteral": "mô-ʾāḇ", "traducao_palavra": "Moabe" },
        { "hebraico": "לְמֹואָ֖ב", "transliteral": "lə-mô-ʾāḇ", "traducao_palavra": "por Moabe" },
        { "hebraico": "כֻּלֹּ֣ה", "transliteral": "kul-lō", "traducao_palavra": "todo ele" },
        { "hebraico": "יְיֵלִ֑יל", "transliteral": "yə-yê-lîl", "traducao_palavra": "uivará" },
        { "hebraico": "לַאֲשִׁישֵׁ֧י", "transliteral": "la-ʾă-šî-šê", "traducao_palavra": "pelos fundamentos/bolos de" },
        { "hebraico": "קִיר־חֲרֶ֛שֶׂת", "transliteral": "qîr-ḥă-re-śeṯ", "traducao_palavra": "Quir-Haresete" },
        { "hebraico": "תֶּהְגּ֖וּ", "transliteral": "te-hə-ḡû", "traducao_palavra": "gemereis/murmurareis" },
        { "hebraico": "אַךְ־נְכָאִֽים׃", "transliteral": "ʾaḵ-nə-ḵā-ʾîm", "traducao_palavra": "certamente abatidos" }
      ]
    },
    "8": {
      "traducao_completa": "Porque os campos de Hesbom esmoreceram, e a vinha de Sibma; os senhores das nações quebraram as suas melhores vides, que chegavam até Jazer e se estendiam pelo deserto; os seus ramos se espalhavam e passavam o mar.",
      "palavras": [
        { "hebraico": "כִּ֣י", "transliteral": "kî", "traducao_palavra": "Porque" },
        { "hebraico": "שַׁדְמֹות", "transliteral": "šaḏ-môṯ", "traducao_palavra": "[os] campos de" },
        { "hebraico": "חֶשְׁבֹּון֮", "transliteral": "ḥeš-bôn", "traducao_palavra": "Hesbom" },
        { "hebraico": "אֻמְלָל֒", "transliteral": "ʾum-lāl", "traducao_palavra": "esmoreceram" },
