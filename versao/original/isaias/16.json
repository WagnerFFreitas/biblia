        { "hebraico": "בַּחֶ֨סֶד֙", "transliteral": "ba-ḥe-seḏ", "traducao_palavra": "em misericórdia" },
        { "hebraico": "כִּסֵּ֔א", "transliteral": "kiś-śê", "traducao_palavra": "[um] trono" },
        { "hebraico": "וְיָשַׁ֥ב", "transliteral": "wə-yā-šaḇ", "traducao_palavra": "e se assentará" },
        { "hebraico": "עָלָ֛יו", "transliteral": "ʿā-lāyw", "traducao_palavra": "sobre ele" },
