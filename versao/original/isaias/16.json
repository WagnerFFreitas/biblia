        { "hebraico": "כְעֹ֣וף", "transliteral": "ḵə-ʿôp̄", "traducao_palavra": "como ave" },
        { "hebraico": "נֹודֵ֔ד", "transliteral": "nô-ḏêḏ", "traducao_palavra": "vagueante/espantada" },
        { "hebraico": "קֵ֖ן", "transliteral": "qên", "traducao_palavra": "[como] ninho" },
        { "hebraico": "מְשֻׁלָּ֑ח", "transliteral": "mə-šul-lāḥ", "traducao_palavra": "lançado fora" },
        { "hebraico": "תִּֽהְיֶ֨ינָה֙", "transliteral": "tih-ye-nā", "traducao_palavra": "serão" },
        { "hebraico": "בְּנֹ֣ות", "transliteral": "bə-nôṯ", "traducao_palavra": "[as] filhas de" },
        { "hebraico": "מֹואָ֔ב", "transliteral": "mô-ʾāḇ", "traducao_palavra": "Moabe" },
        { "hebraico": "מַעְבָּרֹ֖ת", "transliteral": "ma-ʿă-bā-rōṯ", "traducao_palavra": "[nos] vaus/passagens de" },
        { "hebraico": "לְאַרְנֹֽון׃", "transliteral": "lə-ʾar-nôn", "traducao_palavra": "Arnom" }
      ]
    },
    "3": {
      "traducao_completa": "Dá conselho, executa o juízo; põe a tua sombra no pino do meio-dia como a noite; esconde os desterrados, e não descubras o que anda fugindo.",
