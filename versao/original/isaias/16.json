        { "hebraico": "שְׁלֻחֹותֶ֥יהָ", "transliteral": "šə-lu-ḥô-ṯe-hā", "traducao_palavra": "seus ramos" },
        { "hebraico": "נִטְּשׁ֖וּ", "transliteral": "niṭ-ṭə-šû", "traducao_palavra": "espalharam-se/foram deixados" },
        { "hebraico": "עָ֥בְרוּ", "transliteral": "ʿā-ḇə-rû", "traducao_palavra": "atravessaram" },
        { "hebraico": "יָֽם׃", "transliteral": "yām", "traducao_palavra": "[o] mar" }
      ]
    },
    "9": {
      "traducao_completa": "Pelo que chorarei, com o choro de Jazer, a vinha de Sibma; regar-te-ei com as minhas lágrimas, ó Hesbom e Eleale; porque sobre os teus frutos de verão e sobre a tua sega caiu o grito de guerra.",
      "palavras": [
        { "hebraico": "עַל־כֵּ֠ן", "transliteral": "ʿal-kên", "traducao_palavra": "Portanto" },
        { "hebraico": "אֶבְכֶּ֞ה", "transliteral": "ʾeḇ-keh", "traducao_palavra": "chorarei" },
        { "hebraico": "בִּבְכִ֤י", "transliteral": "biḇ-ḵî", "traducao_palavra": "com o choro de" },
        { "hebraico": "יַעְזֵר֙", "transliteral": "yaʿ-zêr", "traducao_palavra": "Jazer" },
        { "hebraico": "גֶּ֣פֶן", "transliteral": "ge-p̄en", "traducao_palavra": "[pela] vinha de" },
        { "hebraico": "שִׂבְמָ֔ה", "transliteral": "śiḇ-mā", "traducao_palavra": "Sibma" },
        { "hebraico": "אֲרַיָּ֨וֶךְ֙", "transliteral": "ʾă-ray-yā-weḵ", "traducao_palavra": "regar-te-ei" },
        { "hebraico": "דִּמְעָתִ֔י", "transliteral": "dim-ʿā-ṯî", "traducao_palavra": "[com] minha lágrima" },
        { "hebraico": "חֶשְׁבֹּ֖ון", "transliteral": "ḥeš-bôn", "traducao_palavra": "Hesbom" },
        { "hebraico": "וְאֶלְעָלֵ֑ה", "transliteral": "wə-ʾel-ʿā-lēh", "traducao_palavra": "e Eleale" },
        { "hebraico": "כִּ֧י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "עַל־קֵיצֵ֥ךְ", "transliteral": "ʿal-qê-ṣêḵ", "traducao_palavra": "sobre teu fruto de verão" },
        { "hebraico": "וְעַל־קְצִירֵ֖ךְ", "transliteral": "wə-ʿal-qə-ṣî-rêḵ", "traducao_palavra": "e sobre tua colheita" },
        { "hebraico": "הֵידָ֥ד", "transliteral": "hê-ḏāḏ", "traducao_palavra": "[o] grito/uivo" },
        { "hebraico": "נָפָֽל׃", "transliteral": "nā-p̄āl", "traducao_palavra": "caiu" }
      ]
    },
    "10": {
      "traducao_completa": "E tirada é a alegria e o júbilo do campo fértil, e nas vinhas não se cantará, nem haverá júbilo algum; o pisador não pisará o vinho nos lagares; eu fiz cessar o grito de alegria.",
      "palavras": [
        { "hebraico": "וְנֶאֱסַ֨ף", "transliteral": "wə-ne-ʾĕ-śap̄", "traducao_palavra": "E foi tirada" },
        { "hebraico": "שִׂמְחָ֤ה", "transliteral": "śim-ḥā", "traducao_palavra": "[a] alegria" },
        { "hebraico": "וָגִ֙יל֙", "transliteral": "wā-ḡîl", "traducao_palavra": "e o júbilo" },
        { "hebraico": "מִן־", "transliteral": "min-", "traducao_palavra": "do" },
        { "hebraico": "הַכַּרְמֶ֔ל", "transliteral": "hak-kar-mel", "traducao_palavra": "campo fértil/pomar" },
        { "hebraico": "וּבַכְּרָמִ֥ים", "transliteral": "ū-ḇak-kə-rā-mîm", "traducao_palavra": "e nas vinhas" },
        { "hebraico": "לֹא־יְרֻנָּ֖ן", "transliteral": "lō-yə-run-nān", "traducao_palavra": "não se cantará" },
        { "hebraico": "וְלֹ֣א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "יְרֹעָ֑ע", "transliteral": "yə-rō-ʿāʿ", "traducao_palavra": "se gritará de júbilo" },
        { "hebraico": "יַ֕יִן", "transliteral": "ya-yin", "traducao_palavra": "vinho" },
        { "hebraico": "בַּיְקָבִ֛ים", "transliteral": "bay-qā-ḇîm", "traducao_palavra": "nos lagares" },
