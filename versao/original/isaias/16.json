        { "hebraico": "לָ֕מֹו", "transliteral": "lā-mô", "traducao_palavra": "para eles" },
        { "hebraico": "מִפְּנֵ֖י", "transliteral": "mip-pə-nê", "traducao_palavra": "diante de" },
        { "hebraico": "שֹׁודֵ֑ד", "transliteral": "šô-ḏêḏ", "traducao_palavra": "[o] destruidor" },
