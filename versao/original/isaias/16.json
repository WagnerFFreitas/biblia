    "6": {
      "traducao_completa": "Ouvimos da soberba de Moabe, que é mui soberbo; da sua altivez, e da sua soberba, e do seu furor; mas as suas mentiras não serão assim.",
      "palavras": [
        { "hebraico": "שָׁמַ֥עְנוּ", "transliteral": "šā-ma-ʿənû", "traducao_palavra": "Ouvimos" },
        { "hebraico": "גְאֹון־", "transliteral": "ḡə-ʾôn-", "traducao_palavra": "[da] soberba de" },
        { "hebraico": "מֹואָ֖ב", "transliteral": "mô-ʾāḇ", "traducao_palavra": "Moabe" },
        { "hebraico": "גֵּ֣א", "transliteral": "gê", "traducao_palavra": "soberbo" },
        { "hebraico": "מְאֹ֑ד", "transliteral": "mə-ʾōḏ", "traducao_palavra": "muito" },
        { "hebraico": "גַּאֲוָתֹ֧ו", "transliteral": "ga-ʾă-wā-ṯô", "traducao_palavra": "sua altivez" },
