        { "hebraico": "וְכִֽי־תֹאמַ֣ר", "transliteral": "wə-ḵî-ṯō-mar", "traducao_palavra": "E se disseres" },
        { "hebraico": "אֵלַ֔י", "transliteral": "ʾê-lay", "traducao_palavra": "a mim" },
        { "hebraico": "אֶל־יְהוָ֥ה", "transliteral": "ʾel-YHWH", "traducao_palavra": "em YHWH" },
        { "hebraico": "אֱלֹהֵ֖ינוּ", "transliteral": "ʾĕ-lō-hê-nû", "traducao_palavra": "nosso Deus" },
