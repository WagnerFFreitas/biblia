        { "hebraico": "הֲלֹוא־ה֗וּא", "transliteral": "hă-lô-hû", "traducao_palavra": "acaso não [é] ele" },
        { "hebraico": "אֲשֶׁ֨ר", "transliteral": "ʾă-šer", "traducao_palavra": "que" },
        { "hebraico": "הֵסִ֤יר", "transliteral": "hê-śîr", "traducao_palavra": "removeu/tirou" },
        { "hebraico": "חִזְקִיָּ֨הוּ֙", "transliteral": "ḥiz-qî-yā-hû", "traducao_palavra": "Ezequias" },
        { "hebraico": "אֶת־בָּמֹתָ֣יו", "transliteral": "ʾeṯ-bā-mō-ṯāyw", "traducao_palavra": "[objeto] os seus altos" },
        { "hebraico": "וְאֶת־מִזְבְּחֹתָ֔יו", "transliteral": "wə-ʾeṯ-miz-bə-ḥō-ṯāyw", "traducao_palavra": "e os seus altares" },
        { "hebraico": "וַיֹּ֤אמֶר", "transliteral": "way-yō-mer", "traducao_palavra": "e disse" },
        { "hebraico": "לִֽיהוּדָה֙", "transliteral": "lî-hû-ḏā", "traducao_palavra": "a Judá" },
        { "hebraico": "וּלְיִרֽוּשָׁלִַ֔ם", "transliteral": "ū-lə-yî-rû-šā-la-yim", "traducao_palavra": "e a Jerusalém" },
