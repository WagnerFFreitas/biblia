        { "hebraico": "הַמִּזְבֵּ֥חַ", "transliteral": "ham-miz-bē-aḥ", "traducao_palavra": "o altar" },
        { "hebraico": "הַזֶּ֖ה", "transliteral": "haz-zeh", "traducao_palavra": "este" },
        { "hebraico": "תִּֽשְׁתַּחֲוֽוּ׃", "transliteral": "tiš-ta-ḥă-wû", "traducao_palavra": "vos prostrareis" }
      ]
    },
    "8": {
      "traducao_completa": "Ora, pois, dá penhores ao meu senhor, o rei da Assíria, e dar-te-ei dois mil cavalos, se tu puderes dar cavaleiros para eles.",
