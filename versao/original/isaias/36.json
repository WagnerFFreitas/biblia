        { "hebraico": "הִתְעָרֶ֣ב", "transliteral": "hiṯ-ʿā-reḇ", "traducao_palavra": "faz um acordo/dá penhores" },
        { "hebraico": "נָ֔א", "transliteral": "nā", "traducao_palavra": "peço-te/pois" },
        { "hebraico": "אֶת־אֲדֹנִ֖י", "transliteral": "ʾeṯ-ʾă-ḏō-nî", "traducao_palavra": "com meu senhor" },
        { "hebraico": "מֶ֣לֶךְ", "transliteral": "me-leḵ", "traducao_palavra": "o rei de" },
        { "hebraico": "אַשּׁ֑וּר", "transliteral": "ʾaš-šûr", "traducao_palavra": "Assíria" },
        { "hebraico": "וְאֶתְּנָ֤ה", "transliteral": "wə-ʾet-tə-nā", "traducao_palavra": "e darei" },
