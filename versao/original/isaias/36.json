        { "hebraico": "הָרָצ֤וּץ", "transliteral": "ha-rā-ṣûṣ", "traducao_palavra": "esmagada/quebrada" },
        { "hebraico": "הַזֶּה֙", "transliteral": "haz-zeh", "traducao_palavra": "este" },
        { "hebraico": "עַל־מִצְרַ֔יִם", "transliteral": "ʿal-miṣ-ra-yim", "traducao_palavra": "no Egito" },
