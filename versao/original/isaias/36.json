        { "hebraico": "וְשֶׁבְנָא֙", "transliteral": "wə-šeb-nā", "traducao_palavra": "e Sebna" },
        { "hebraico": "הַסֹּופֵ֔ר", "transliteral": "haś-śô-p̄êr", "traducao_palavra": "o escrivão/secretário" },
        { "hebraico": "וְיֹואָ֥ח", "transliteral": "wə-yô-ʾāḥ", "traducao_palavra": "e Joá" },
