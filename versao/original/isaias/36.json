        { "hebraico": "בָטַ֣חְתָּ", "transliteral": "bā-ṭaḥ-tā", "traducao_palavra": "confiaste" },
        { "hebraico": "עַל־מִשְׁעֶנֶת֩", "transliteral": "ʿal-miš-ʿe-neṯ", "traducao_palavra": "sobre o suporte/bordão de" },
