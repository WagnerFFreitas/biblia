      ]
    },
    "6": {
      "traducao_completa": "Eis que confias no Egito, aquele bordão de cana quebrada, o qual, se alguém se estribar nele, lhe entrará pela mão e a furará; assim é Faraó, rei do Egito, para com todos os que nele confiam.",
      "palavras": [
