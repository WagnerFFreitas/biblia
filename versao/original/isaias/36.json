        { "hebraico": "עָלָ֛יו", "transliteral": "ʿā-lāyw", "traducao_palavra": "nele" },
        { "hebraico": "וּבָ֥א", "transliteral": "ū-ḇā", "traducao_palavra": "e entrará" },
