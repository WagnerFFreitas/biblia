        { "hebraico": "מִפֶּ֥שַׁע", "transliteral": "mip-pe-ša-ʿ", "traducao_palavra": "pela transgressão de" },
        { "hebraico": "עַמִּ֖י", "transliteral": "ʿam-mî", "traducao_palavra": "meu povo" },
        { "hebraico": "נֶ֥גַע", "transliteral": "ne-ḡa-ʿ", "traducao_palavra": "[houve] ferimento" },
        { "hebraico": "לָֽמֹו׃", "transliteral": "lā-mōw", "traducao_palavra": "para ele." }
      ]
    },
    "9": {
      "traducao_completa": "E puseram a sua sepultura com os ímpios, e com o rico na sua morte; ainda que nunca cometera injustiça, nem houvesse engano na sua boca.",
      "palavras": [
        { "hebraico": "וַיִּתֵּ֤ן", "transliteral": "way-yit-tên", "traducao_palavra": "E puseram/deu" },
