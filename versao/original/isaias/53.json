        { "hebraico": "ה֣וּא", "transliteral": "hū", "traducao_palavra": "ele" },
        { "hebraico": "נָשָׂ֔א", "transliteral": "nā-śā", "traducao_palavra": "carregou" },
        { "hebraico": "וּמַכְאֹבֵ֖ינוּ", "transliteral": "ū-maḵ-ʾō-ḇê-nū", "traducao_palavra": "e nossas dores" },
        { "hebraico": "סְבָלָ֑ם", "transliteral": "śə-ḇā-lām", "traducao_palavra": "levou-as" },
