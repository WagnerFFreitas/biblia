        { "hebraico": "לִפְנֵ֥י", "transliteral": "lip̄-nê", "traducao_palavra": "diante de" },
        { "hebraico": "גֹזְזֶ֖יהָ", "transliteral": "ḡō-zə-ze-hā", "traducao_palavra": "seus tosquiadores" },
