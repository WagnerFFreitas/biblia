        { "hebraico": "חָפֵ֤ץ", "transliteral": "ḥā-p̄ēṣ", "traducao_palavra": "desejou/agradou-se de" },
        { "hebraico": "דַּכְּאֹו֙", "transliteral": "dak-kə-ʾō-w", "traducao_palavra": "esmagá-lo" },
        { "hebraico": "הֶֽחֱלִ֔י", "transliteral": "he-ḥĕ-lî", "traducao_palavra": "fê-lo enfermar" },
