        { "hebraico": "הֶאֱמִ֖ין", "transliteral": "he-ʾĕ-mîn", "traducao_palavra": "creu" },
        { "hebraico": "לִשְׁמֻעָתֵ֑נוּ", "transliteral": "liš-mu-ʿā-ṯê-nū", "traducao_palavra": "em nossa pregação/mensagem" },
        { "hebraico": "וּזְרֹ֥ועַ", "transliteral": "ū-zə-rō-wa-ʿ", "traducao_palavra": "e o braço de" },
