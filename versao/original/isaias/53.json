        { "hebraico": "מִפְּשָׁעֵ֔נוּ", "transliteral": "mip-pə-šā-ʿê-nū", "traducao_palavra": "pelas nossas transgressões" },
        { "hebraico": "מְדֻכָּ֖א", "transliteral": "mə-ḏuk-kā", "traducao_palavra": "esmagado/moído" },
