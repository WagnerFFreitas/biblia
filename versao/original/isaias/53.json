    "8": {
      "traducao_completa": "Da opressão e do juízo foi tirado; e quem contará o tempo da sua vida? Porquanto foi cortado da terra dos viventes; pela transgressão do meu povo foi ele ferido.",
      "palavras": [
        { "hebraico": "מֵעֹ֤צֶר", "transliteral": "mê-ʿō-ṣer", "traducao_palavra": "Da opressão/prisão" },
        { "hebraico": "וּמִמִּשְׁפָּט֙", "transliteral": "ū-mim-miš-pāṭ", "traducao_palavra": "e do juízo" },
        { "hebraico": "לֻקָּ֔ח", "transliteral": "luq-qāḥ", "traducao_palavra": "foi tirado" },
        { "hebraico": "וְאֶת־", "transliteral": "wə-ʾeṯ-", "traducao_palavra": "e [quanto à]" },
        { "hebraico": "דֹּורֹ֖ו", "transliteral": "dō-w-rō-w", "traducao_palavra": "sua geração/descendência" },
        { "hebraico": "מִ֣י", "transliteral": "mî", "traducao_palavra": "quem" },
        { "hebraico": "יְשֹׂוחֵ֑חַ", "transliteral": "yə-śō-w-ḥē-aḥ", "traducao_palavra": "considerará/declarará?" },
