        { "hebraico": "רְשָׁעִים֙", "transliteral": "rə-šā-ʿîm", "traducao_palavra": "[com os] ímpios" },
        { "hebraico": "קִבְרֹ֔ו", "transliteral": "qiḇ-rō-w", "traducao_palavra": "sua sepultura" },
