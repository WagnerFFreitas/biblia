        { "hebraico": "נִשְׁפֶּה֙", "transliteral": "niš-peh", "traducao_palavra": "elevado/calvo" },
        { "hebraico": "שְׂאוּ־נֵ֔ס", "transliteral": "śə-ʾû-nêś", "traducao_palavra": "alçai bandeira" },
        { "hebraico": "הָרִ֥ימוּ", "transliteral": "hā-rî-mû", "traducao_palavra": "levantai" },
        { "hebraico": "קֹ֖ול", "transliteral": "qôl", "traducao_palavra": "[a] voz" },
        { "hebraico": "לָהֶ֑ם", "transliteral": "lā-hem", "traducao_palavra": "para eles" },
        { "hebraico": "הָנִ֥יפוּ", "transliteral": "hā-nî-p̄û", "traducao_palavra": "acenai/balançai" },
        { "hebraico": "יָ֖ד", "transliteral": "yāḏ", "traducao_palavra": "[a] mão" },
