      ]
    },
    "6": {
      "traducao_completa": "Uivai, porque o dia de YHWH está perto; virá como uma assolação do Todo-Poderoso.",
      "palavras": [
        { "hebraico": "הֵילִ֕ילוּ", "transliteral": "hê-lî-lû", "traducao_palavra": "Uivai/uivem" },
        { "hebraico": "כִּ֥י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "קָרֹ֖וב", "transliteral": "qā-rôḇ", "traducao_palavra": "perto [está]" },
        { "hebraico": "יֹ֣ום", "transliteral": "yôm", "traducao_palavra": "[o] dia de" },
        { "hebraico": "יְהוָ֑ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "כְּשֹׁ֖ד", "transliteral": "kə-šōḏ", "traducao_palavra": "como destruição" },
        { "hebraico": "מִשַּׁדַּ֥י", "transliteral": "miš-šad-day", "traducao_palavra": "do Todo-Poderoso [Shaddai]" },
        { "hebraico": "יָבֹֽוא׃", "transliteral": "yā-ḇô", "traducao_palavra": "virá" }
      ]
    },
    "7": {
      "traducao_completa": "Pelo que todas as mãos se debilitarão, e o coração de todo o homem se derreterá.",
      "palavras": [
        { "hebraico": "עַל־כֵּ֖ן", "transliteral": "ʿal-kên", "traducao_palavra": "Por isso" },
        { "hebraico": "כָּל־יָדַ֣יִם", "transliteral": "kāl-yā-ḏa-yim", "traducao_palavra": "todas as mãos" },
        { "hebraico": "תִּרְפֶּ֑ינָה", "transliteral": "tir-pê-nā", "traducao_palavra": "enfraquecerão/afrouxarão" },
        { "hebraico": "וְכָל־לֵבַ֥ב", "transliteral": "wə-ḵāl-lê-ḇaḇ", "traducao_palavra": "e todo coração de" },
        { "hebraico": "אֱנֹ֖ושׁ", "transliteral": "ʾĕ-nôš", "traducao_palavra": "homem" },
        { "hebraico": "יִמָּֽס׃", "transliteral": "yim-māś", "traducao_palavra": "derreterá" }
      ]
    },
    "8": {
      "traducao_completa": "E ficarão assombrados, e apoderar-se-ão deles dores e ais; e se angustiarão, como a mulher que está de parto; cada um olhará espantado para o seu próximo; os seus rostos serão rostos flamejantes.",
      "palavras": [
        { "hebraico": "וְֽנִבְהָ֕לוּ", "transliteral": "wə-niḇ-hā-lû", "traducao_palavra": "E ficarão aterrorizados" },
        { "hebraico": "צִירִ֤ים", "transliteral": "ṣî-rîm", "traducao_palavra": "angústias/dores" },
        { "hebraico": "וַֽחֲבָלִים֙", "transliteral": "wa-ḥă-ḇā-lîm", "traducao_palavra": "e ais/dores de parto" },
        { "hebraico": "יֹֽאחֵז֔וּן", "transliteral": "yō-ḥê-zûn", "traducao_palavra": "se apoderarão" },
        { "hebraico": "כַּיֹּולֵדָ֖ה", "transliteral": "kay-yô-lê-ḏā", "traducao_palavra": "como a que dá à luz" },
        { "hebraico": "יְחִיל֑וּן", "transliteral": "yə-ḥî-lûn", "traducao_palavra": "se contorcerão" },
        { "hebraico": "אִ֤ישׁ", "transliteral": "ʾîš", "traducao_palavra": "cada um" },
        { "hebraico": "אֶל־רֵעֵ֨הוּ֙", "transliteral": "ʾel-rē-ʿê-hû", "traducao_palavra": "para seu próximo" },
        { "hebraico": "יִתְמָ֔הוּ", "transliteral": "yiṯ-mā-hû", "traducao_palavra": "olhará espantado" },
        { "hebraico": "פְּנֵ֥י", "transliteral": "p̄ə-nê", "traducao_palavra": "faces de" },
        { "hebraico": "לְהָבִ֖ים", "transliteral": "lə-hā-ḇîm", "traducao_palavra": "chamas/fogo" },
        { "hebraico": "פְּנֵיהֶֽם׃", "transliteral": "pə-nê-hem", "traducao_palavra": "[são] as faces deles" }
      ]
    },
    "9": {
      "traducao_completa": "Eis que vem o dia de YHWH, cruel, com furor e ira ardente, para pôr a terra em assolação e para destruir os pecadores dela.",
      "palavras": [
        { "hebraico": "הִנֵּ֤ה", "transliteral": "hin-nêh", "traducao_palavra": "Eis" },
        { "hebraico": "יֹום־יְהוָה֙", "transliteral": "yôm-YHWH", "traducao_palavra": "[o] dia de YHWH" },
        { "hebraico": "בָּ֔א", "transliteral": "bā", "traducao_palavra": "vem" },
        { "hebraico": "אַכְזָרִ֥י", "transliteral": "ʾaḵ-zā-rî", "traducao_palavra": "cruel" },
        { "hebraico": "וְעֶבְרָ֖ה", "transliteral": "wə-ʿeḇ-rā", "traducao_palavra": "com furor" },
        { "hebraico": "וַחֲרֹ֣ון", "transliteral": "wa-ḥă-rôn", "traducao_palavra": "e ardor de" },
        { "hebraico": "אָ֑ף", "transliteral": "ʾāp̄", "traducao_palavra": "ira" },
        { "hebraico": "לָשׂ֤וּם", "transliteral": "lā-śûm", "traducao_palavra": "para pôr" },
        { "hebraico": "אֶ֨רֶץ֙", "transliteral": "ʾe-reṣ", "traducao_palavra": "[a] terra" },
        { "hebraico": "לְשַׁמָּ֔ה", "transliteral": "lə-šam-mā", "traducao_palavra": "em desolação" },
        { "hebraico": "וְחַטָּאֶ֖יהָ", "transliteral": "wə-ḥaṭ-ṭā-ʾê-hā", "traducao_palavra": "e os pecadores dela" },
        { "hebraico": "יַשְׁמִ֥יד", "transliteral": "yaš-mîḏ", "traducao_palavra": "destruirá" },
        { "hebraico": "מִמֶּֽנָּה׃", "transliteral": "mim-men-nā", "traducao_palavra": "do meio dela" }
      ]
    },
    "10": {
      "traducao_completa": "Porque as estrelas dos céus e as suas constelações não deixarão brilhar a sua luz; o sol se escurecerá ao nascer, e a lua não fará resplandecer a sua luz.",
      "palavras": [
        { "hebraico": "כִּֽי־כֹוכְבֵ֤י", "transliteral": "kî-ḵô-ḵə-ḇê", "traducao_palavra": "Pois as estrelas de" },
        { "hebraico": "הַשָּׁמַ֨יִם֙", "transliteral": "haš-šā-ma-yim", "traducao_palavra": "os céus" },
        { "hebraico": "וּכְסִ֣ילֵיהֶ֔ם", "transliteral": "ū-ḵə-śî-lê-hem", "traducao_palavra": "e suas constelações/Orions" },
        { "hebraico": "לֹ֥א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "יָהֵ֖לּוּ", "transliteral": "yā-hêl-lû", "traducao_palavra": "farão brilhar" },
        { "hebraico": "אֹורָ֑ם", "transliteral": "ʾô-rām", "traducao_palavra": "a sua luz" },
        { "hebraico": "חָשַׁ֤ךְ", "transliteral": "ḥā-šaḵ", "traducao_palavra": "escurecerá" },
        { "hebraico": "הַשֶּׁ֨מֶשׁ֙", "transliteral": "haš-še-meš", "traducao_palavra": "o sol" },
        { "hebraico": "בְּצֵאתֹ֔ו", "transliteral": "bə-ṣê-ṯô", "traducao_palavra": "no seu sair/nascer" },
        { "hebraico": "וְיָרֵ֖חַ", "transliteral": "wə-yā-rê-aḥ", "traducao_palavra": "e a lua" },
        { "hebraico": "לֹא־יַגִּ֥יהַּ", "transliteral": "lō-yag-gî-ah", "traducao_palavra": "não fará resplandecer" },
        { "hebraico": "אֹורֹֽו׃", "transliteral": "ʾô-rô", "traducao_palavra": "sua luz" }
      ]
    },
    "11": {
      "traducao_completa": "E visitarei sobre o mundo a maldade, e sobre os ímpios a sua iniquidade; e farei cessar a arrogância dos atrevidos, e abaterei a soberba dos tiranos.",
      "palavras": [
        { "hebraico": "וּפָקַדְתִּ֤י", "transliteral": "ū-p̄ā-qaḏ-tî", "traducao_palavra": "E visitarei/punirei" },
        { "hebraico": "עַל־תֵּבֵל֙", "transliteral": "ʿal-tê-ḇēl", "traducao_palavra": "sobre o mundo" },
        { "hebraico": "רָעָ֔ה", "transliteral": "rā-ʿā", "traducao_palavra": "a maldade" },
        { "hebraico": "וְעַל־רְשָׁעִ֖ים", "transliteral": "wə-ʿal-rə-šā-ʿîm", "traducao_palavra": "e sobre os ímpios" },
        { "hebraico": "עֲוֹנָ֑ם", "transliteral": "ʿă-wō-nām", "traducao_palavra": "sua iniquidade" },
        { "hebraico": "וְהִשְׁבַּתִּי֙", "transliteral": "wə-hiš-bat-tî", "traducao_palavra": "e farei cessar" },
        { "hebraico": "גְּאֹ֣ון", "transliteral": "gə-ʾôn", "traducao_palavra": "[o] orgulho de" },
        { "hebraico": "זֵדִ֔ים", "transliteral": "zê-ḏîm", "traducao_palavra": "atrevidos/arrogantes" },
        { "hebraico": "וְגַאֲוַ֥ת", "transliteral": "wə-ḡa-ʾă-waṯ", "traducao_palavra": "e a soberba de" },
        { "hebraico": "עָרִיצִ֖ים", "transliteral": "ʿā-rî-ṣîm", "traducao_palavra": "tiranos/violentos" },
        { "hebraico": "אַשְׁפִּֽיל׃", "transliteral": "ʾaš-pîl", "traducao_palavra": "abaterei" }
      ]
    },
    "12": {
      "traducao_completa": "Farei que um homem seja mais precioso do que o ouro puro, e o homem mais do que o ouro fino de Ofir.",
      "palavras": [
        { "hebraico": "אֹוקִ֥יר", "transliteral": "ʾô-qîr", "traducao_palavra": "Farei precioso" },
        { "hebraico": "אֱנֹ֖ושׁ", "transliteral": "ʾĕ-nôš", "traducao_palavra": "homem/mortal" },
        { "hebraico": "מִפָּ֑ז", "transliteral": "mip-pāz", "traducao_palavra": "mais que o ouro puro" },
        { "hebraico": "וְאָדָ֖ם", "transliteral": "wə-ʾā-ḏām", "traducao_palavra": "e o homem" },
        { "hebraico": "מִכֶּ֥תֶם", "transliteral": "mik-ke-ṯem", "traducao_palavra": "mais que o ouro fino de" },
        { "hebraico": "אֹופִֽיר׃", "transliteral": "ʾô-p̄îr", "traducao_palavra": "Ofir" }
      ]
    },
    "13": {
      "traducao_completa": "Pelo que farei estremecer os céus; e a terra se moverá do seu lugar, por causa do furor de YHWH dos Exércitos, e por causa do dia da sua ardente ira.",
      "palavras": [
        { "hebraico": "עַל־כֵּן֙", "transliteral": "ʿal-kên", "traducao_palavra": "Por isso" },
        { "hebraico": "שָׁמַ֣יִם", "transliteral": "šā-ma-yim", "traducao_palavra": "[os] céus" },
        { "hebraico": "אַרְגִּ֔יז", "transliteral": "ʾar-gîz", "traducao_palavra": "farei estremecer" },
        { "hebraico": "וְתִרְעַ֥שׁ", "transliteral": "wə-ṯir-ʿaš", "traducao_palavra": "e tremerá/mover-se-á" },
        { "hebraico": "הָאָ֖רֶץ", "transliteral": "hā-ʾā-reṣ", "traducao_palavra": "a terra" },
        { "hebraico": "מִמְּקֹומָ֑הּ", "transliteral": "mim-mə-qô-māh", "traducao_palavra": "do seu lugar" },
        { "hebraico": "בְּעֶבְרַת֙", "transliteral": "bə-ʿeḇ-raṯ", "traducao_palavra": "pelo furor de" },
        { "hebraico": "יְהוָ֣ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "צְבָאֹ֔ות", "transliteral": "ṣə-ḇā-ʾôṯ", "traducao_palavra": "Exércitos" },
        { "hebraico": "וּבְיֹ֖ום", "transliteral": "ū-ḇə-yôm", "traducao_palavra": "e no dia de" },
        { "hebraico": "חֲרֹ֥ון", "transliteral": "ḥă-rôn", "traducao_palavra": "ardor de" },
        { "hebraico": "אַפֹּֽו׃", "transliteral": "ap-pô", "traducao_palavra": "sua ira" }
      ]
    },
    "14": {
      "traducao_completa": "E será cada um como a gazela que foge, e como a ovelha que ninguém recolhe; cada um voltará para o seu povo, e cada um fugirá para a sua terra.",
      "palavras": [
        { "hebraico": "וְהָיָה֙", "transliteral": "wə-hā-yā", "traducao_palavra": "E será" },
        { "hebraico": "כִּצְבִ֣י", "transliteral": "ki-ṣə-ḇî", "traducao_palavra": "como gazela" },
        { "hebraico": "מֻדָּ֔ח", "transliteral": "mud-dāḥ", "traducao_palavra": "afugentada" },
        { "hebraico": "וּכְצֹ֖אן", "transliteral": "ū-ḵə-ṣōn", "traducao_palavra": "e como rebanho" },
        { "hebraico": "וְאֵ֣ין", "transliteral": "wə-ʾên", "traducao_palavra": "[em que] não há" },
        { "hebraico": "מְקַבֵּ֑ץ", "transliteral": "mə-qab-bêṣ", "traducao_palavra": "quem recolha" },
        { "hebraico": "אִ֤ישׁ", "transliteral": "ʾîš", "traducao_palavra": "cada um" },
        { "hebraico": "אֶל־עַמֹּו֙", "transliteral": "ʾel-ʿam-mô", "traducao_palavra": "para o seu povo" },
        { "hebraico": "יִפְנ֔וּ", "transliteral": "yip̄-nû", "traducao_palavra": "se voltará" },
        { "hebraico": "וְאִ֥ישׁ", "transliteral": "wə-ʾîš", "traducao_palavra": "e cada um" },
        { "hebraico": "אֶל־אַרְצֹ֖ו", "transliteral": "ʾel-ʾar-ṣô", "traducao_palavra": "para sua terra" },
        { "hebraico": "יָנֽוּסוּ׃", "transliteral": "yā-nû-śû", "traducao_palavra": "fugirá" }
      ]
    },
    "15": {
      "traducao_completa": "Todo o que for achado será traspassado; e todo o que for apanhado cairá à espada.",
      "palavras": [
        { "hebraico": "כָּל־", "transliteral": "kāl-", "traducao_palavra": "Todo" },
        { "hebraico": "הַנִּמְצָ֖א", "transliteral": "han-nim-ṣā", "traducao_palavra": "o achado" },
        { "hebraico": "יִדָּקֵ֑ר", "transliteral": "yid-dā-qēr", "traducao_palavra": "será traspassado" },
        { "hebraico": "וְכָל־", "transliteral": "wə-ḵāl-", "traducao_palavra": "e todo" },
        { "hebraico": "הַנִּסְפֶּ֖ה", "transliteral": "han-nis-peh", "traducao_palavra": "o apanhado/arrastado" },
        { "hebraico": "יִפֹּ֥ול", "transliteral": "yip-pôl", "traducao_palavra": "cairá" },
        { "hebraico": "בֶּחָֽרֶב׃", "transliteral": "be-ḥā-reḇ", "traducao_palavra": "pela espada" }
      ]
    },
    "16": {
      "traducao_completa": "E seus filhos serão despedaçados perante os seus olhos; as suas casas serão saqueadas, e as suas mulheres, violentadas.",
      "palavras": [
        { "hebraico": "וְעֹלְלֵיהֶ֥ם", "transliteral": "wə-ʿō-lə-lê-hem", "traducao_palavra": "E as suas crianças" },
        { "hebraico": "יְרֻטְּשׁ֖וּ", "transliteral": "yə-ruṭ-ṭə-šû", "traducao_palavra": "serão despedaçadas" },
        { "hebraico": "לְעֵינֵיהֶ֑ם", "transliteral": "lə-ʿê-nê-hem", "traducao_palavra": "perante os olhos deles" },
        { "hebraico": "יִשַּׁסּוּ֙", "transliteral": "yiš-śas-sû", "traducao_palavra": "serão saqueadas" },
        { "hebraico": "בָּתֵּיהֶ֔ם", "transliteral": "bāt-tê-hem", "traducao_palavra": "as casas deles" },
        { "hebraico": "וּנְשֵׁיהֶ֖ם", "transliteral": "ū-nə-šê-hem", "traducao_palavra": "e as mulheres deles" },
        { "hebraico": "תִּשָּׁגַ֥לְנָה", "transliteral": "tiš-šā-ḡal-nā", "traducao_palavra": "serão violentadas" }
      ]
    },
    "17": {
      "traducao_completa": "Eis que eu despertarei contra eles os medos, que não farão caso da prata, nem desejarão o ouro.",
      "palavras": [
        { "hebraico": "הִנְנִ֛י", "transliteral": "hin-nə-nî", "traducao_palavra": "Eis que eu" },
        { "hebraico": "מֵעִ֥יר", "transliteral": "mê-ʿîr", "traducao_palavra": "despertarei" },
        { "hebraico": "עֲלֵיהֶ֖ם", "transliteral": "ʿă-lê-hem", "traducao_palavra": "contra eles" },
        { "hebraico": "אֶת־מָדָ֑י", "transliteral": "ʾeṯ-mā-ḏāy", "traducao_palavra": "[objeto] os medos" },
        { "hebraico": "אֲשֶׁ֤ר", "transliteral": "ʾă-šer", "traducao_palavra": "que" },
        { "hebraico": "כֶּ֨סֶף֙", "transliteral": "ke-sep̄", "traducao_palavra": "[a] prata" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "יַחְשֹׁ֔בוּ", "transliteral": "yaḥ-šō-ḇû", "traducao_palavra": "estimarão/farão caso" },
        { "hebraico": "וְזָהָ֖ב", "transliteral": "wə-zā-hāḇ", "traducao_palavra": "e ouro" },
        { "hebraico": "לֹ֥א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "יַחְפְּצוּ־בֹֽו", "transliteral": "yaḥ-pə-ṣû-ḇô", "traducao_palavra": "desejarão nela" }
      ]
    },
    "18": {
      "traducao_completa": "E os seus arcos despedaçarão os jovens, e não se compadecerão do fruto do ventre; o seu olho não poupará os filhos.",
      "palavras": [
        { "hebraico": "וּקְשָׁתֹ֖ות", "transliteral": "ū-qə-šā-ṯôṯ", "traducao_palavra": "E [os] arcos" },
        { "hebraico": "נְעָרִ֣ים", "transliteral": "nə-ʿā-rîm", "traducao_palavra": "[os] jovens" },
        { "hebraico": "תְּרַטַּ֑שְׁנָה", "transliteral": "tə-raṭ-ṭaš-nā", "traducao_palavra": "despedaçarão" },
        { "hebraico": "וּפְרִי־בֶ֨טֶן֙", "transliteral": "ū-p̄ə-rî-ḇe-ṭen", "traducao_palavra": "e [do] fruto do ventre" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "יְרַחֵ֔מוּ", "transliteral": "yə-ra-ḥê-mû", "traducao_palavra": "se compadecerão" },
        { "hebraico": "עַל־בָּנִ֖ים", "transliteral": "ʿal-bā-nîm", "traducao_palavra": "sobre filhos" },
        { "hebraico": "לֹֽא־תָח֥וּס", "transliteral": "lō-ṯā-ḥûs", "traducao_palavra": "não poupará" },
        { "hebraico": "עֵינָֽם׃", "transliteral": "ʿê-nām", "traducao_palavra": "o olho deles" }
      ]
    },
    "19": {
      "traducao_completa": "E Babilônia, a glória dos reinos, o esplendor da soberba dos caldeus, será como Sodoma e Gomorra, quando Deus as subverteu.",
      "palavras": [
        { "hebraico": "וְהָיְתָ֤ה", "transliteral": "wə-hā-yə-ṯā", "traducao_palavra": "E será" },
        { "hebraico": "בָבֶל֙", "transliteral": "bā-ḇel", "traducao_palavra": "Babilônia" },
        { "hebraico": "צְבִ֣י", "transliteral": "ṣə-ḇî", "traducao_palavra": "[a] glória/joia de" },
        { "hebraico": "מַמְלָכֹ֔ות", "transliteral": "mam-lā-ḵôṯ", "traducao_palavra": "reinos" },
        { "hebraico": "תִּפְאֶ֖רֶת", "transliteral": "tip̄-ʾe-reṯ", "traducao_palavra": "[o] esplendor de" },
        { "hebraico": "גְּאֹ֣ון", "transliteral": "gə-ʾôn", "traducao_palavra": "soberba de" },
        { "hebraico": "כַּשְׂדִּ֑ים", "transliteral": "kaś-dîm", "traducao_palavra": "caldeus" },
        { "hebraico": "כְּמַהְפֵּכַ֣ת", "transliteral": "kə-mah-pê-ḵaṯ", "traducao_palavra": "como a subversão de" },
        { "hebraico": "אֱלֹהִ֔ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "Deus" },
        { "hebraico": "אֶת־סְדֹ֖ם", "transliteral": "ʾeṯ-śə-ḏōm", "traducao_palavra": "[objeto] Sodoma" },
        { "hebraico": "וְאֶת־עֲמֹרָֽה׃", "transliteral": "wə-ʾeṯ-ʿă-mō-rā", "traducao_palavra": "e Gomorra" }
      ]
    },
    "20": {
      "traducao_completa": "Nunca mais será habitada, nem nela se morará de geração em geração; nem o árabe armará ali a sua tenda, nem os pastores farão ali repousar os seus rebanhos.",
      "palavras": [
        { "hebraico": "לֹא־תֵשֵׁ֣ב", "transliteral": "lō-ṯê-šêḇ", "traducao_palavra": "Não será habitada" },
        { "hebraico": "לָנֶ֔צַח", "transliteral": "lā-ne-ṣaḥ", "traducao_palavra": "para sempre" },
        { "hebraico": "וְלֹ֥א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "תִשְׁכֹּ֖ן", "transliteral": "tiš-kōn", "traducao_palavra": "se morará/estabelecerá" },
        { "hebraico": "עַד־דֹּ֣ור", "transliteral": "ʿaḏ-dôr", "traducao_palavra": "até geração" },
        { "hebraico": "וָדֹ֑ור", "transliteral": "wā-ḏôr", "traducao_palavra": "e geração" },
        { "hebraico": "וְלֹא־יַהֵ֧ל", "transliteral": "wə-lō-ya-hêl", "traducao_palavra": "e não armará tenda" },
        { "hebraico": "שָׁ֣ם", "transliteral": "šām", "traducao_palavra": "ali" },
        { "hebraico": "עֲרָבִ֗י", "transliteral": "ʿă-rā-ḇî", "traducao_palavra": "[o] árabe" },
        { "hebraico": "וְרֹעִ֛ים", "transliteral": "wə-rō-ʿîm", "traducao_palavra": "e pastores" },
        { "hebraico": "לֹא־יַרְבִּ֥צוּ", "transliteral": "lō-yar-bî-ṣû", "traducao_palavra": "não farão repousar" },
        { "hebraico": "שָֽׁם׃", "transliteral": "šām", "traducao_palavra": "ali" }
      ]
    },
    "21": {
      "traducao_completa": "Mas as feras do deserto repousarão ali, e as suas casas se encherão de hienas; e ali habitarão as avestruzes, e os sátiros pularão ali.",
      "palavras": [
        { "hebraico": "וְרָבְצוּ־שָׁ֣ם", "transliteral": "wə-rā-ḇə-ṣû-šām", "traducao_palavra": "E repousarão ali" },
        { "hebraico": "צִיִּ֔ים", "transliteral": "ṣi-yîm", "traducao_palavra": "feras do deserto" },
        { "hebraico": "וּמָלְא֥וּ", "transliteral": "ū-mā-lə-ʾû", "traducao_palavra": "e encherão" },
        { "hebraico": "בָתֵּיהֶ֖ם", "transliteral": "bāt-tê-hem", "traducao_palavra": "as casas deles" },
        { "hebraico": "אֹחִ֑ים", "transliteral": "ʾō-ḥîm", "traducao_palavra": "criaturas uivantes/hienas" },
        { "hebraico": "וְשָׁ֤כְנוּ", "transliteral": "wə-šā-ḵə-nû", "traducao_palavra": "e habitarão" },
        { "hebraico": "שָׁם֙", "transliteral": "šām", "traducao_palavra": "ali" },
        { "hebraico": "בְּנֹ֣ות", "transliteral": "bə-nôṯ", "traducao_palavra": "filhas de" },
        { "hebraico": "יַֽעֲנָ֔ה", "transliteral": "ya-ʿă-nā", "traducao_palavra": "avestruz" },
        { "hebraico": "וּשְׂעִירִ֖ים", "transliteral": "ū-śə-ʿî-rîm", "traducao_palavra": "e bodes selvagens/sátiros" },
        { "hebraico": "יְרַקְּדוּ־שָֽׁם׃", "transliteral": "yə-raq-qə-ḏû-šām", "traducao_palavra": "pularão ali" }
      ]
    },
    "22": {
      "traducao_completa": "E as hienas uivarão nos seus palácios, e os chacais nos seus templos de deleite; e perto está de vir o seu tempo, e os seus dias não se prolongarão.",
      "palavras": [
        { "hebraico": "וְעָנָ֤ה", "transliteral": "wə-ʿā-nā", "traducao_palavra": "E uivarão/responderão" },
        { "hebraico": "אִיִּים֙", "transliteral": "ʾiy-yîm", "traducao_palavra": "chacais/feras" },
        { "hebraico": "בְּאַלְמְנֹותָ֔יו", "transliteral": "bə-ʾal-mə-nô-ṯāyw", "traducao_palavra": "nos seus palácios desolados" },
        { "hebraico": "וְתַנִּ֖ים", "transliteral": "wə-ṯan-nîm", "traducao_palavra": "e chacais/monstros marinhos" },
        { "hebraico": "בְּהֵיכְלֵ֣י", "transliteral": "bə-hê-ḵəlê", "traducao_palavra": "nos palácios de" },
        { "hebraico": "עֹ֑נֶג", "transliteral": "ʿō-neḡ", "traducao_palavra": "deleite" },
        { "hebraico": "וְקָרֹ֤וב", "transliteral": "wə-qā-rôḇ", "traducao_palavra": "e perto [está]" },
        { "hebraico": "לָבֹוא֙", "transliteral": "lā-ḇô", "traducao_palavra": "de vir" },
        { "hebraico": "עִתָּ֔הּ", "transliteral": "ʿit-tāh", "traducao_palavra": "o seu tempo" },
        { "hebraico": "וְיָמֶ֖יהָ", "transliteral": "wə-yā-me-y-hā", "traducao_palavra": "e os seus dias" },
        { "hebraico": "לֹ֥א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "יִמָּשֵֽׁכוּ׃", "transliteral": "yim-mā-šê-ḵû", "traducao_palavra": "serão prolongados" }
      ]
    }
