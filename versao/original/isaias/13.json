        { "hebraico": "קֹול֮", "transliteral": "qôl", "traducao_palavra": "voz de" },
        { "hebraico": "שְׁאֹ֣ון", "transliteral": "šə-ʾôn", "traducao_palavra": "tumulto de" },
        { "hebraico": "מַמְלְכֹ֣ות", "transliteral": "mam-lə-ḵôṯ", "traducao_palavra": "reinos" },
        { "hebraico": "גֹּויִ֣ם", "transliteral": "gô-yim", "traducao_palavra": "[de] nações" },
        { "hebraico": "נֶאֱסָפִים֒", "transliteral": "ne-ʾĕ-śā-p̄îm", "traducao_palavra": "reunidas" },
