        { "hebraico": "פִּתְחֵ֥י", "transliteral": "piṯ-ḥê", "traducao_palavra": "portais de" },
        { "hebraico": "נְדִיבִֽים׃", "transliteral": "nə-ḏî-ḇîm", "traducao_palavra": "nobres" }
      ]
    },
    "3": {
      "traducao_completa": "Eu dei ordens aos meus consagrados; também já chamei os meus valentes para a minha ira, os que exultam com a minha majestade.",
      "palavras": [
        { "hebraico": "אֲנִ֥י", "transliteral": "ʾă-nî", "traducao_palavra": "Eu" },
        { "hebraico": "צִוֵּ֖יתִי", "transliteral": "ṣiw-wê-ṯî", "traducao_palavra": "ordenei" },
        { "hebraico": "לִמְקֻדָּשָׁ֑י", "transliteral": "lim-qud-dā-šāy", "traducao_palavra": "aos meus consagrados" },
        { "hebraico": "גַּ֣ם", "transliteral": "gam", "traducao_palavra": "também" },
        { "hebraico": "קָרָ֤אתִי", "transliteral": "qā-rā-ṯî", "traducao_palavra": "chamei" },
        { "hebraico": "גִבֹּורַי֙", "transliteral": "gib-bô-ray", "traducao_palavra": "meus valentes" },
        { "hebraico": "לְאַפִּ֔י", "transliteral": "lə-ʾap-pî", "traducao_palavra": "para minha ira" },
        { "hebraico": "עַלִּיזֵ֖י", "transliteral": "ʿal-lî-zê", "traducao_palavra": "[os que] exultam em" },
