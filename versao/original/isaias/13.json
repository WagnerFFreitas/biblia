  "versiculos": {
    "1": {
      "traducao_completa": "Oráculo contra a Babilônia, que Isaías, filho de Amoz, recebeu em visão.",
      "palavras": [
        { "hebraico": "מַשָּׂ֖א", "transliteral": "maś-śā", "traducao_palavra": "Oráculo/peso/sentença" },
        { "hebraico": "בָּבֶ֑ל", "transliteral": "bā-ḇel", "traducao_palavra": "Babilônia" },
        { "hebraico": "אֲשֶׁ֣ר", "transliteral": "ʾă-šer", "traducao_palavra": "que" },
        { "hebraico": "חָזָ֔ה", "transliteral": "ḥā-zā", "traducao_palavra": "viu/contemplou" },
        { "hebraico": "יְשַׁעְיָ֖הוּ", "transliteral": "yə-šaʿ-yā-hû", "traducao_palavra": "Isaías" },
