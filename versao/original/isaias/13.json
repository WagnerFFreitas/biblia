      ]
    },
    "4": {
      "traducao_completa": "Já se ouve um estrondo sobre os montes, como o de muito povo; o som do tumulto de reinos de nações congregadas. YHWH dos Exércitos passa revista ao exército de guerra.",
      "palavras": [
        { "hebraico": "קֹ֥ול", "transliteral": "qôl", "traducao_palavra": "Voz/ruído" },
        { "hebraico": "הָמֹ֛ון", "transliteral": "hā-môn", "traducao_palavra": "de multidão" },
        { "hebraico": "בֶּֽהָרִ֖ים", "transliteral": "be-hā-rîm", "traducao_palavra": "nos montes" },
        { "hebraico": "דְּמ֣וּת", "transliteral": "də-mûṯ", "traducao_palavra": "semelhança de" },
