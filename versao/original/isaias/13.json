        { "hebraico": "צְבָאֹ֔ות", "transliteral": "ṣə-ḇā-ʾôṯ", "traducao_palavra": "[dos] Exércitos" },
        { "hebraico": "מְפַקֵּ֖ד", "transliteral": "mə-p̄aq-qêḏ", "traducao_palavra": "inspeciona/passa revista" },
        { "hebraico": "צְבָ֥א", "transliteral": "ṣə-ḇā", "traducao_palavra": "[ao] exército de" },
        { "hebraico": "מִלְחָמָה׃", "transliteral": "mil-ḥā-mā", "traducao_palavra": "guerra" }
      ]
    },
    "5": {
      "traducao_completa": "Vêm de uma terra remota, desde a extremidade do céu, YHWH e as armas da sua indignação, para destruir toda a terra.",
      "palavras": [
        { "hebraico": "בָּאִ֛ים", "transliteral": "bā-ʾîm", "traducao_palavra": "Vêm" },
        { "hebraico": "מֵאֶ֥רֶץ", "transliteral": "mê-ʾe-reṣ", "traducao_palavra": "de terra" },
        { "hebraico": "מֶרְחָ֖ק", "transliteral": "mer-ḥāq", "traducao_palavra": "distante" },
        { "hebraico": "מִקְצֵ֣ה", "transliteral": "miq-ṣē", "traducao_palavra": "da extremidade de" },
        { "hebraico": "הַשָּׁמָ֑יִם", "transliteral": "haš-šā-ma-yim", "traducao_palavra": "os céus" },
        { "hebraico": "יְהוָה֙", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "וּכְלֵ֣י", "transliteral": "ū-ḵəlê", "traducao_palavra": "e instrumentos/armas de" },
        { "hebraico": "זַעְמֹ֔ו", "transliteral": "za-ʿəmô", "traducao_palavra": "sua indignação" },
        { "hebraico": "לְחַבֵּ֖ל", "transliteral": "lə-ḥab-bêl", "traducao_palavra": "para destruir" },
