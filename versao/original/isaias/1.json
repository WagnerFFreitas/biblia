        { "hebraico": "מִנֶּ֖גֶד", "transliteral": "min-ne-ḡeḏ", "traducao_palavra": "de diante de" },
        { "hebraico": "עֵינָ֑י", "transliteral": "ʿê-nāy", "traducao_palavra": "meus olhos" },
        { "hebraico": "חִדְל֖וּ", "transliteral": "ḥiḏ-lû", "traducao_palavra": "cessai" },
        { "hebraico": "הָרֵֽעַ׃", "transliteral": "hā-rê-aʿ", "traducao_palavra": "[de] fazer o mal" }
      ]
    },
    "17": {
      "traducao_completa": "Aprendei a fazer o bem; buscai o juízo, acabai com a opressão, fazei justiça ao órfão, defendei a causa da viúva.",
      "palavras": [
        { "hebraico": "לִמְד֥וּ", "transliteral": "lim-ḏû", "traducao_palavra": "aprender" },
        { "hebraico": "הֵיטֵ֛ב", "transliteral": "hê-ṭêḇ", "traducao_palavra": "[a] fazer o bem" },
        { "hebraico": "דִּרְשׁ֥וּ", "transliteral": "dir-šû", "traducao_palavra": "buscai" },
        { "hebraico": "מִשְׁפָּ֖ט", "transliteral": "miš-pāṭ", "traducao_palavra": "[o] juízo" },
        { "hebraico": "אַשְּׁר֣וּ", "transliteral": "ʾaš-šə-rû", "traducao_palavra": "endireitai/ajudai" },
        { "hebraico": "חָמֹ֑וץ", "transliteral": "ḥā-môṣ", "traducao_palavra": "[o] oprimido" },
        { "hebraico": "שִׁפְט֣וּ", "transliteral": "šip̄-ṭû", "traducao_palavra": "julgai/fazei justiça" },
        { "hebraico": "יָתֹ֔ום", "transliteral": "yā-ṯôm", "traducao_palavra": "[ao] órfão" },
        { "hebraico": "רִ֖יבוּ", "transliteral": "rî-ḇû", "traducao_palavra": "defendei/pleiteai" },
        { "hebraico": "אַלְמָנָֽה׃", "transliteral": "ʾal-mā-nā", "traducao_palavra": "[a] viúva" }
      ]
    },
    "18": {
      "traducao_completa": "Vinde agora, e arguamo-nos, diz YHWH: ainda que os vossos pecados sejam como a escarlata, eles se tornarão brancos como a neve; ainda que sejam vermelhos como o carmesim, tornar-se-ão como a lã.",
      "palavras": [
        { "hebraico": "לְכוּ־נָ֛א", "transliteral": "lə-ḵû-nā", "traducao_palavra": "vinde agora" },
        { "hebraico": "וְנִוָּֽכְחָ֖ה", "transliteral": "wə-niw-wā-ḵə-ḥā", "traducao_palavra": "e arrazoemos/arguamo-nos" },
        { "hebraico": "יֹאמַ֣ר", "transliteral": "yō-mar", "traducao_palavra": "diz" },
        { "hebraico": "יְהוָ֑ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "אִם־יִֽהְי֨וּ", "transliteral": "ʾim-yih-yû", "traducao_palavra": "se forem" },
        { "hebraico": "חֲטָאֵיכֶ֤ם", "transliteral": "ḥă-ṭā-ʾê-ḵem", "traducao_palavra": "vossos pecados" },
        { "hebraico": "כַּשָּׁנִים֙", "transliteral": "kaš-šā-nîm", "traducao_palavra": "como escarlata" },
        { "hebraico": "כַּשֶּׁ֣לֶג", "transliteral": "kaš-še-leḡ", "traducao_palavra": "como a neve" },
        { "hebraico": "יַלְבִּ֔ינוּ", "transliteral": "yal-bî-nû", "traducao_palavra": "se tornarão brancos" },
        { "hebraico": "אִם־יַאְדִּ֥ימוּ", "transliteral": "ʾim-ya-ʾə-ḏî-mû", "traducao_palavra": "se forem vermelhos" },
        { "hebraico": "כַתֹּולָ֖ע", "transliteral": "ḵat-tô-lāʿ", "traducao_palavra": "como carmesim" },
        { "hebraico": "כַּצֶּ֥מֶר", "transliteral": "kaṣ-ṣe-mer", "traducao_palavra": "como a lã" },
        { "hebraico": "יִהְיֽוּ׃", "transliteral": "yih-yû", "traducao_palavra": "serão" }
      ]
    },
    "19": {
      "traducao_completa": "Se quiserdes, e ouvirdes, comereis o bem desta terra.",
      "palavras": [
        { "hebraico": "אִם־תֹּאב֖וּ", "transliteral": "ʾim-tō-ḇû", "traducao_palavra": "se quiserdes" },
        { "hebraico": "וּשְׁמַעְתֶּ֑ם", "transliteral": "ū-šə-ma-ʿə-tem", "traducao_palavra": "e ouvirdes" },
        { "hebraico": "טוּב", "transliteral": "ṭûḇ", "traducao_palavra": "[o] melhor/bem de" },
        { "hebraico": "הָאָ֖רֶץ", "transliteral": "hā-ʾā-reṣ", "traducao_palavra": "a terra" },
        { "hebraico": "תֹּאכֵֽלוּ׃", "transliteral": "tō-ḵê-lû", "traducao_palavra": "comereis" }
      ]
    },
    "20": {
      "traducao_completa": "Mas se recusardes, e fordes rebeldes, sereis devorados pela espada; porque a boca de YHWH o disse.",
      "palavras": [
        { "hebraico": "וְאִם־תְּמָאֲנ֖וּ", "transliteral": "wə-ʾim-tə-mā-ʾă-nû", "traducao_palavra": "mas se recusardes" },
        { "hebraico": "וּמְרִיתֶ֑ם", "transliteral": "ū-mə-rî-ṯem", "traducao_palavra": "e fordes rebeldes" },
        { "hebraico": "חֶ֚רֶב", "transliteral": "ḥe-reḇ", "traducao_palavra": "[pela] espada" },
        { "hebraico": "תֻּאכְּל֔וּ", "transliteral": "tuk-kə-lû", "traducao_palavra": "sereis devorados" },
        { "hebraico": "כִּ֛י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "פִּ֥י", "transliteral": "pî", "traducao_palavra": "[a] boca de" },
        { "hebraico": "יְהוָ֖ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "דִּבֵּֽר׃", "transliteral": "dib-bêr", "traducao_palavra": "falou" }
      ]
    },
    "21": {
      "traducao_completa": "Como se tornou prostituta a cidade fiel! Ela que estava cheia de justiça! A retidão habitava nela, mas agora assassinos.",
      "palavras": [
        { "hebraico": "אֵיכָה֙", "transliteral": "ʾê-ḵā", "traducao_palavra": "Como" },
        { "hebraico": "הָיְתָ֣ה", "transliteral": "hā-yə-ṯā", "traducao_palavra": "tornou-se" },
        { "hebraico": "לְזֹונָ֔ה", "transliteral": "lə-zô-nā", "traducao_palavra": "prostituta" },
        { "hebraico": "קִרְיָ֖ה", "transliteral": "qir-yā", "traducao_palavra": "[a] cidade" },
        { "hebraico": "נֶאֱמָנָ֑ה", "transliteral": "ne-ʾĕ-mā-nā", "traducao_palavra": "fiel" },
        { "hebraico": "מְלֵאֲתִ֣י", "transliteral": "mə-lê-ʾă-ṯî", "traducao_palavra": "[estava] cheia de" },
        { "hebraico": "מִשְׁפָּ֗ט", "transliteral": "miš-pāṭ", "traducao_palavra": "juízo" },
        { "hebraico": "צֶ֧דֶק", "transliteral": "ṣe-ḏeq", "traducao_palavra": "justiça" },
        { "hebraico": "יָלִ֥ין", "transliteral": "yā-lîn", "traducao_palavra": "habitava" },
        { "hebraico": "בָּ֖הּ", "transliteral": "bāh", "traducao_palavra": "nela" },
        { "hebraico": "וְעַתָּ֥ה", "transliteral": "wə-ʿat-tā", "traducao_palavra": "mas agora" },
        { "hebraico": "מְרַצְּחִֽים׃", "transliteral": "mə-raṣ-ṣə-ḥîm", "traducao_palavra": "assassinos" }
      ]
    },
    "22": {
      "traducao_completa": "A tua prata tornou-se em escórias, o teu vinho misturou-se com água.",
      "palavras": [
        { "hebraico": "כַּסְפֵּ֖ךְ", "transliteral": "kas-pêḵ", "traducao_palavra": "Tua prata" },
        { "hebraico": "הָיָ֣ה", "transliteral": "hā-yā", "traducao_palavra": "tornou-se" },
        { "hebraico": "לְסִיגִ֑ים", "transliteral": "lə-śî-ḡîm", "traducao_palavra": "em escórias" },
        { "hebraico": "סָבְאֵ֖ךְ", "transliteral": "śā-ḇə-ʾêḵ", "traducao_palavra": "teu vinho" },
        { "hebraico": "מָה֥וּל", "transliteral": "mā-hûl", "traducao_palavra": "diluído/misturado" },
