        { "hebraico": "נְשֹֽׂא׃", "transliteral": "nə-śō", "traducao_palavra": "de carregar/sofrer" }
      ]
    },
    "15": {
      "traducao_completa": "E quando estenderdes as vossas mãos, esconderei de vós os meus olhos; e ainda que multipliqueis as vossas orações, não as ouvirei; as vossas mãos estão cheias de sangue.",
      "palavras": [
        { "hebraico": "וּבְפָרִשְׂכֶ֣ם", "transliteral": "ū-ḇə-p̄ā-riś-ḵem", "traducao_palavra": "E ao estenderdes" },
        { "hebraico": "כַּפֵּיכֶ֗ם", "transliteral": "kap-pê-ḵem", "traducao_palavra": "vossas mãos" },
        { "hebraico": "אַעְלִ֤ים", "transliteral": "ʾaʿ-lîm", "traducao_palavra": "esconderei" },
        { "hebraico": "עֵינַי֙", "transliteral": "ʿê-nay", "traducao_palavra": "meus olhos" },
        { "hebraico": "מִכֶּ֔ם", "transliteral": "mik-kem", "traducao_palavra": "de vós" },
        { "hebraico": "גַּ֛ם", "transliteral": "gam", "traducao_palavra": "também" },
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "quando" },
        { "hebraico": "תַרְבּ֥וּ", "transliteral": "ṯar-bû", "traducao_palavra": "multiplicardes" },
        { "hebraico": "תְפִלָּ֖ה", "transliteral": "ṯə-p̄il-lā", "traducao_palavra": "[a] oração" },
        { "hebraico": "אֵינֶ֣נִּי", "transliteral": "ʾê-nen-nî", "traducao_palavra": "não [estou]" },
        { "hebraico": "שֹׁמֵ֑עַ", "transliteral": "šō-mê-aʿ", "traducao_palavra": "ouvindo" },
        { "hebraico": "יְדֵיכֶ֖ם", "transliteral": "yə-ḏê-ḵem", "traducao_palavra": "vossas mãos" },
        { "hebraico": "דָּמִ֥ים", "transliteral": "dā-mîm", "traducao_palavra": "[de] sangues" },
        { "hebraico": "מָלֵֽאוּ׃", "transliteral": "mā-lê-ʾû", "traducao_palavra": "estão cheias" }
      ]
    },
    "16": {
      "traducao_completa": "Lavai-vos, purificai-vos, tirai a maldade de vossos atos de diante dos meus olhos; cessai de fazer o mal.",
      "palavras": [
        { "hebraico": "רַחֲצ֕וּ", "transliteral": "ra-ḥă-ṣû", "traducao_palavra": "lavai-vos" },
        { "hebraico": "הִזַּכּ֑וּ", "transliteral": "hiz-zak-kû", "traducao_palavra": "purificai-vos" },
        { "hebraico": "הָסִ֨ירוּ֙", "transliteral": "hā-śî-rû", "traducao_palavra": "tirai/removei" },
        { "hebraico": "רֹ֣עַ", "transliteral": "rō-aʿ", "traducao_palavra": "[a] maldade de" },
