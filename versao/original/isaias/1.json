      ]
    },
    "14": {
      "traducao_completa": "As vossas luas novas, e as vossas solenidades, a minha alma as odeia; já me são pesadas; já estou cansado de as sofrer.",
      "palavras": [
        { "hebraico": "חָדְשֵׁיכֶ֣ם", "transliteral": "ḥāḏ-šê-ḵem", "traducao_palavra": "Vossas luas novas" },
        { "hebraico": "וּמֹועֲדֵיכֶם֙", "transliteral": "ū-mô-ʿă-ḏê-ḵem", "traducao_palavra": "e vossas festas fixas" },
        { "hebraico": "שָׂנְאָ֣ה", "transliteral": "śā-nə-ʾā", "traducao_palavra": "odiou" },
        { "hebraico": "נַפְשִׁ֔י", "transliteral": "nap̄-šî", "traducao_palavra": "minha alma" },
        { "hebraico": "הָי֥וּ", "transliteral": "hā-yû", "traducao_palavra": "elas foram" },
        { "hebraico": "עָלַ֖י", "transliteral": "ʿā-lay", "traducao_palavra": "sobre mim" },
        { "hebraico": "לָטֹ֑רַח", "transliteral": "lā-ṭō-raḥ", "traducao_palavra": "para carga/fardo" },
