      ]
    },
    "12": {
      "traducao_completa": "Quando vindes para comparecer perante mim, quem requereu isto de vossas mãos, que pisásseis os meus átrios?",
      "palavras": [
        { "hebraico": "כִּ֣י", "transliteral": "kî", "traducao_palavra": "Quando" },
        { "hebraico": "תָבֹ֔אוּ", "transliteral": "ṯā-ḇō-ʾû", "traducao_palavra": "vindes" },
        { "hebraico": "לֵרָאֹ֖ות", "transliteral": "lê-rā-ʾôṯ", "traducao_palavra": "para ser visto/comparecer" },
