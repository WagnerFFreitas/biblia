        { "hebraico": "חֲצֵרָֽי׃", "transliteral": "ḥă-ṣê-rāy", "traducao_palavra": "meus átrios" }
      ]
    },
    "13": {
      "traducao_completa": "Não tragais mais ofertas vãs; o incenso é para mim abominação, e também as luas novas, e os sábados, e a convocação das assembleias; não posso suportar a iniquidade ajuntada ao ajuntamento solene.",
      "palavras": [
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "Não" },
        { "hebraico": "תֹוסִ֨יפוּ֙", "transliteral": "ṯô-śî-p̄û", "traducao_palavra": "torneis a/acrescenteis" },
        { "hebraico": "הָבִ֣יא", "transliteral": "hā-ḇî", "traducao_palavra": "trazer" },
        { "hebraico": "מִנְחַת־שָׁ֔וְא", "transliteral": "min-ḥaṯ-šāw", "traducao_palavra": "oferta vã/falsa" },
        { "hebraico": "קְטֹ֧רֶת", "transliteral": "qə-ṭō-reṯ", "traducao_palavra": "incenso" },
        { "hebraico": "תֹּועֵבָ֥ה", "transliteral": "tô-ʿê-ḇā", "traducao_palavra": "[é] abominação" },
        { "hebraico": "הִ֖יא", "transliteral": "hî", "traducao_palavra": "ele [é]" },
        { "hebraico": "לִ֑י", "transliteral": "lî", "traducao_palavra": "para mim" },
        { "hebraico": "חֹ֤דֶשׁ", "transliteral": "ḥō-ḏeš", "traducao_palavra": "Lua nova" },
        { "hebraico": "וְשַׁבָּת֙", "transliteral": "wə-šab-bāṯ", "traducao_palavra": "e sábado" },
        { "hebraico": "קְרֹ֣א", "transliteral": "qə-rō", "traducao_palavra": "convocação de" },
        { "hebraico": "מִקְרָ֔א", "transliteral": "miq-rā", "traducao_palavra": "assembleia" },
        { "hebraico": "לֹא־אוּכַ֥ל", "transliteral": "lō-ʾû-ḵal", "traducao_palavra": "não posso [suportar]" },
        { "hebraico": "אָ֖וֶן", "transliteral": "ʾā-wen", "traducao_palavra": "iniquidade" },
