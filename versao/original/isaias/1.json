{
  "livro": "Isaías - יְשַׁעְיָהוּ - Yeshayahu",
  "capítulo": 1,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Visão de Isaías, filho de Amoz, que ele teve a respeito de Judá e Jerusalém, nos dias de Uzias, Jotão, Acaz e Ezequias, reis de Judá.",
      "palavras": [
        { "hebraico": "חֲזֹון֙", "transliteral": "ḥă-zôn", "traducao_palavra": "Visão de" },
        { "hebraico": "יְשַׁעְיָ֣הוּ", "transliteral": "yə-šaʿ-yā-hû", "traducao_palavra": "Isaías" },
        { "hebraico": "בֶן־אָמֹ֔וץ", "transliteral": "ben-ʾā-môṣ", "traducao_palavra": "filho de Amoz" },
        { "hebraico": "אֲשֶׁ֣ר", "transliteral": "ʾă-šer", "traducao_palavra": "que" },
        { "hebraico": "חָזָ֔ה", "transliteral": "ḥā-zā", "traducao_palavra": "ele viu/contemplou" },
        { "hebraico": "עַל־יְהוּדָ֖ה", "transliteral": "ʿal-yə-hû-ḏā", "traducao_palavra": "sobre Judá" },
        { "hebraico": "וִירוּשָׁלִָ֑ם", "transliteral": "wî-rû-šā-la-yim", "traducao_palavra": "e Jerusalém" },
        { "hebraico": "בִּימֵ֨י", "transliteral": "bî-mê", "traducao_palavra": "nos dias de" },
        { "hebraico": "עֻזִּיָּ֧הוּ", "transliteral": "ʿuz-zî-yā-hû", "traducao_palavra": "Uzias" },
        { "hebraico": "יֹותָ֛ם", "transliteral": "yô-ṯām", "traducao_palavra": "Jotão" },
        { "hebraico": "אָחָ֥ז", "transliteral": "ʾā-ḥāz", "traducao_palavra": "Acaz" },
        { "hebraico": "יְחִזְקִיָּ֖הוּ", "transliteral": "yə-ḥiz-qî-yā-hû", "traducao_palavra": "Ezequias" },
        { "hebraico": "מַלְכֵ֥י", "transliteral": "mal-ḵê", "traducao_palavra": "reis de" },
        { "hebraico": "יְהוּדָֽה׃", "transliteral": "yə-hû-ḏā", "traducao_palavra": "Judá" }
      ]
    },
    "2": {
      "traducao_completa": "Ouvi, ó céus, e dá ouvidos, ó terra, porque falou YHWH: Criei filhos, e engrandeci-os, mas eles se rebelaram contra mim.",
      "palavras": [
        { "hebraico": "שִׁמְע֤וּ", "transliteral": "šim-ʿû", "traducao_palavra": "Ouvi" },
        { "hebraico": "שָׁמַ֨יִם֙", "transliteral": "šā-ma-yim", "traducao_palavra": "céus" },
        { "hebraico": "וְהַאֲזִ֣ינִי", "transliteral": "wə-ha-ʾă-zî-nî", "traducao_palavra": "e dá ouvidos" },
        { "hebraico": "אֶ֔רֶץ", "transliteral": "ʾe-reṣ", "traducao_palavra": "terra" },
        { "hebraico": "כִּ֥י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "יְהוָ֖ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "דִּבֵּ֑ר", "transliteral": "dib-bêr", "traducao_palavra": "falou" },
        { "hebraico": "בָּנִים֙", "transliteral": "bā-nîm", "traducao_palavra": "filhos" },
        { "hebraico": "גִּדַּ֣לְתִּי", "transliteral": "gid-dal-tî", "traducao_palavra": "criei/engrandeci" },
        { "hebraico": "וְרֹומַ֔מְתִּי", "transliteral": "wə-rô-mam-tî", "traducao_palavra": "e exaltei" },
        { "hebraico": "וְהֵ֖ם", "transliteral": "wə-hêm", "traducao_palavra": "mas eles" },
        { "hebraico": "פָּ֥שְׁעוּ", "transliteral": "pā-šə-ʿû", "traducao_palavra": "se rebelaram" },
        { "hebraico": "בִֽי׃", "transliteral": "ḇî", "traducao_palavra": "contra mim" }
      ]
    },
    "3": {
      "traducao_completa": "O boi conhece o seu possuidor, e o jumento a manjedoura do seu dono; mas Israel não tem conhecimento, o meu povo não entende.",
      "palavras": [
        { "hebraico": "יָדַ֥ע", "transliteral": "yā-ḏaʿ", "traducao_palavra": "Conhece" },
        { "hebraico": "שֹׁור֙", "transliteral": "šôr", "traducao_palavra": "[o] boi" },
        { "hebraico": "קֹנֵ֔הוּ", "transliteral": "qō-nê-hû", "traducao_palavra": "seu comprador/possuidor" },
        { "hebraico": "וַחֲמֹ֖ור", "transliteral": "wa-ḥă-môr", "traducao_palavra": "e [o] jumento" },
        { "hebraico": "אֵב֣וּס", "transliteral": "ʾê-ḇûs", "traducao_palavra": "[a] manjedoura de" },
        { "hebraico": "בְּעָלָ֑יו", "transliteral": "bə-ʿā-lāyw", "traducao_palavra": "seu dono" },
        { "hebraico": "יִשְׂרָאֵל֙", "transliteral": "yiś-rā-ʾēl", "traducao_palavra": "Israel" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "יָדַ֔ע", "transliteral": "yā-ḏaʿ", "traducao_palavra": "conheceu/sabe" },
        { "hebraico": "עַמִּ֖י", "transliteral": "ʿam-mî", "traducao_palavra": "meu povo" },
        { "hebraico": "לֹ֥א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "הִתְבֹּונָֽן׃", "transliteral": "hiṯ-bô-nān", "traducao_palavra": "entendeu/considerou" }
      ]
    },
    "4": {
      "traducao_completa": "Ai da nação pecadora, do povo carregado de iniquidade, da semente de malfeitores, dos filhos corruptores! Deixaram a YHWH, blasfemaram do Santo de Israel, voltaram para trás.",
      "palavras": [
        { "hebraico": "הֹ֣וי ׀", "transliteral": "hôy", "traducao_palavra": "Ai" },
        { "hebraico": "גֹּ֣וי", "transliteral": "gôy", "traducao_palavra": "[da] nação" },
        { "hebraico": "חֹטֵ֗א", "transliteral": "ḥō-ṭê", "traducao_palavra": "pecadora" },
        { "hebraico": "עַ֚ם", "transliteral": "ʿam", "traducao_palavra": "povo" },
        { "hebraico": "כֶּ֣בֶד", "transliteral": "ke-ḇeḏ", "traducao_palavra": "pesado/carregado de" },
        { "hebraico": "עָוֹ֔ן", "transliteral": "ʿā-wōn", "traducao_palavra": "iniquidade" },
        { "hebraico": "זֶ֣רַע", "transliteral": "ze-raʿ", "traducao_palavra": "descendência de" },
        { "hebraico": "מְרֵעִ֔ים", "transliteral": "mə-rê-ʿîm", "traducao_palavra": "malfeitores" },
        { "hebraico": "בָּנִ֖ים", "transliteral": "bā-nîm", "traducao_palavra": "filhos" },
        { "hebraico": "מַשְׁחִיתִ֑ים", "transliteral": "maš-ḥî-ṯîm", "traducao_palavra": "corruptores" },
        { "hebraico": "עָזְב֣וּ", "transliteral": "ʿā-zə-ḇû", "traducao_palavra": "abandonaram" },
        { "hebraico": "אֶת־יְהוָ֗ה", "transliteral": "ʾeṯ-YHWH", "traducao_palavra": "a YHWH" },
        { "hebraico": "נִֽאֲצ֛וּ", "transliteral": "ni-ʾă-ṣû", "traducao_palavra": "desprezaram/blasfemaram" },
        { "hebraico": "אֶת־קְדֹ֥ושׁ", "transliteral": "ʾeṯ-qə-ḏôš", "traducao_palavra": "o Santo de" },
        { "hebraico": "יִשְׂרָאֵ֖ל", "transliteral": "yiś-rā-ʾēl", "traducao_palavra": "Israel" },
        { "hebraico": "נָזֹ֥רוּ", "transliteral": "nā-zō-rû", "traducao_palavra": "estranharam-se/afastaram-se" },
        { "hebraico": "אָחֹֽור׃", "transliteral": "ʾā-ḥôr", "traducao_palavra": "para trás" }
      ]
    },
    "5": {
      "traducao_completa": "Por que seríeis ainda feridos, visto que mais vos rebelais? Toda a cabeça está enferma e todo o coração desfalecido.",
      "palavras": [
        { "hebraico": "עַ֣ל", "transliteral": "ʿal", "traducao_palavra": "Sobre/Por" },
        { "hebraico": "מֶ֥ה", "transliteral": "meh", "traducao_palavra": "que" },
        { "hebraico": "תֻכּ֨וּ", "transliteral": "ṯuk-kû", "traducao_palavra": "seríeis feridos" },
        { "hebraico": "עֹ֔וד", "transliteral": "ʿôḏ", "traducao_palavra": "ainda" },
        { "hebraico": "תֹּוסִ֖יפוּ", "transliteral": "tô-śî-p̄û", "traducao_palavra": "continuais/acrescentais" },
        { "hebraico": "סָרָ֑ה", "transliteral": "śā-rā", "traducao_palavra": "rebeldia" },
        { "hebraico": "כָּל־רֹ֣אשׁ", "transliteral": "kāl-rōš", "traducao_palavra": "toda cabeça" },
        { "hebraico": "לָחֳלִ֔י", "transliteral": "lā-ḥo-lî", "traducao_palavra": "[está para] doença" },
        { "hebraico": "וְכָל־לֵבָ֖ב", "transliteral": "wə-ḵāl-lê-ḇāḇ", "traducao_palavra": "e todo coração" },
        { "hebraico": "דַּוָּֽי׃", "transliteral": "daw-wāy", "traducao_palavra": "enfermo/desfalecido" }
      ]
    },
    "6": {
      "traducao_completa": "Desde a planta do pé até à cabeça não há nele coisa sã, senão feridas, e inchaços, e chagas vivas; não foram espremidas, nem atadas, nem amolecidas com óleo.",
      "palavras": [
        { "hebraico": "מִכַּף־רֶ֤גֶל", "transliteral": "mik-kap̄-re-ḡel", "traducao_palavra": "Desde a planta do pé" },
        { "hebraico": "וְעַד־רֹ֨אשׁ֙", "transliteral": "wə-ʿaḏ-rōš", "traducao_palavra": "até a cabeça" },
        { "hebraico": "אֵֽין־בֹּ֣ו", "transliteral": "ʾên-bô", "traducao_palavra": "não há nele" },
        { "hebraico": "מְתֹ֔ם", "transliteral": "mə-ṯōm", "traducao_palavra": "saúde/integridade" },
        { "hebraico": "פֶּ֥צַע", "transliteral": "pe-ṣaʿ", "traducao_palavra": "ferida" },
        { "hebraico": "וְחַבּוּרָ֖ה", "transliteral": "wə-ḥab-bû-rā", "traducao_palavra": "e inchaço/contusão" },
        { "hebraico": "וּמַכָּ֣ה", "transliteral": "ū-mak-kā", "traducao_palavra": "e chaga" },
        { "hebraico": "טְרִיָּ֑ה", "transliteral": "ṭə-rî-yā", "traducao_palavra": "fresca/viva" },
        { "hebraico": "לֹא־זֹ֨רוּ֙", "transliteral": "lō-zō-rû", "traducao_palavra": "não foram limpas/espremidas" },
        { "hebraico": "וְלֹ֣א", "transliteral": "wə-lō", "traducao_palavra": "nem" },
        { "hebraico": "חֻבָּ֔שׁוּ", "transliteral": "ḥub-bā-šû", "traducao_palavra": "atadas/enfaixadas" },
        { "hebraico": "וְלֹ֥א", "transliteral": "wə-lō", "traducao_palavra": "nem" },
        { "hebraico": "רֻכְּכָ֖ה", "transliteral": "ruk-kə-ḵā", "traducao_palavra": "suavizadas" },
        { "hebraico": "בַּשָּֽׁמֶן׃", "transliteral": "baš-šā-men", "traducao_palavra": "com o óleo" }
      ]
    },
    "7": {
      "traducao_completa": "A vossa terra está assolada, as vossas cidades consumidas pelo fogo; a vossa região os estrangeiros a devoram em vossa presença; e está assolada, como por uma subversão de estrangeiros.",
      "palavras": [
        { "hebraico": "אַרְצְכֶ֣ם", "transliteral": "ʾar-ṣə-ḵem", "traducao_palavra": "Vossa terra" },
        { "hebraico": "שְׁמָמָ֔ה", "transliteral": "šə-mā-mā", "traducao_palavra": "[está] desolada" },
        { "hebraico": "עָרֵיכֶ֖ם", "transliteral": "ʿā-rê-ḵem", "traducao_palavra": "vossas cidades" },
        { "hebraico": "שְׂרֻפֹ֣ות", "transliteral": "śə-ru-p̄ôṯ", "traducao_palavra": "queimadas" },
        { "hebraico": "אֵ֑שׁ", "transliteral": "ʾêš", "traducao_palavra": "[com] fogo" },
        { "hebraico": "אַדְמַתְכֶ֗ם", "transliteral": "ʾaḏ-maṯ-ḵem", "traducao_palavra": "vossa solo/terra" },
        { "hebraico": "לְנֶגְדְּכֶם֙", "transliteral": "lə-neḡ-də-ḵem", "traducao_palavra": "diante de vós" },
        { "hebraico": "זָרִים֙", "transliteral": "zā-rîm", "traducao_palavra": "estrangeiros" },
        { "hebraico": "אֹכְלִ֣ים", "transliteral": "ʾō-ḵə-lîm", "traducao_palavra": "comem/devoram" },
        { "hebraico": "אֹתָ֔הּ", "transliteral": "ʾō-ṯāh", "traducao_palavra": "a ela" },
        { "hebraico": "וּשְׁמָמָ֖ה", "transliteral": "ū-šə-mā-mā", "traducao_palavra": "e desolação" },
        { "hebraico": "כְּמַהְפֵּכַ֥ת", "transliteral": "kə-mah-pê-ḵaṯ", "traducao_palavra": "como subversão de" },
        { "hebraico": "זָרִֽים׃", "transliteral": "zā-rîm", "traducao_palavra": "estrangeiros" }
      ]
    },
    "8": {
      "traducao_completa": "E a filha de Sião é deixada como a cabana na vinha, como a choça no pepinal, como cidade cercada.",
      "palavras": [
        { "hebraico": "וְנֹותְרָ֥ה", "transliteral": "wə-nô-ṯə-rā", "traducao_palavra": "E é deixada" },
        { "hebraico": "בַת־צִיֹּ֖ון", "transliteral": "ḇaṯ-ṣî-yôn", "traducao_palavra": "[a] filha de Sião" },
        { "hebraico": "כְּסֻכָּ֣ה", "transliteral": "kə-suk-kā", "traducao_palavra": "como cabana" },
        { "hebraico": "בְכָ֑רֶם", "transliteral": "ḇə-ḵā-rem", "traducao_palavra": "na vinha" },
        { "hebraico": "כִּמְלוּנָ֥ה", "transliteral": "kim-lû-nā", "traducao_palavra": "como choça/abrigo" },
        { "hebraico": "בְמִקְשָׁ֖ה", "transliteral": "ḇə-miq-šā", "traducao_palavra": "no pepinal" },
        { "hebraico": "כְּעִ֥יר", "transliteral": "kə-ʿîr", "traducao_palavra": "como cidade" },
        { "hebraico": "נְצוּרָֽה׃", "transliteral": "nə-ṣû-rā", "traducao_palavra": "guardada/sitiada" }
      ]
    },
    "9": {
      "traducao_completa": "Se YHWH dos Exércitos não nos deixara algum remanescente, já como Sodoma seríamos e semelhantes a Gomorra.",
      "palavras": [
        { "hebraico": "לוּלֵי֙", "transliteral": "lû-lê", "traducao_palavra": "Se não" },
        { "hebraico": "יְהוָ֣ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "צְבָאֹ֔ות", "transliteral": "ṣə-ḇā-ʾôṯ", "traducao_palavra": "[dos] Exércitos" },
        { "hebraico": "הֹותִ֥יר", "transliteral": "hô-ṯîr", "traducao_palavra": "[nos] deixasse" },
        { "hebraico": "לָ֛נוּ", "transliteral": "lā-nû", "traducao_palavra": "para nós" },
        { "hebraico": "שָׂרִ֖יד", "transliteral": "śā-rîḏ", "traducao_palavra": "remanescente" },
        { "hebraico": "כִּמְעָ֑ט", "transliteral": "kim-ʿāṭ", "traducao_palavra": "quase" },
        { "hebraico": "כִּסְדֹ֣ם", "transliteral": "ki-śə-ḏōm", "traducao_palavra": "como Sodoma" },
        { "hebraico": "הָיִ֔ינוּ", "transliteral": "hā-yî-nû", "traducao_palavra": "seríamos" },
        { "hebraico": "לַעֲמֹרָ֖ה", "transliteral": "la-ʿă-mō-rā", "traducao_palavra": "a Gomorra" },
        { "hebraico": "דָּמִֽינוּ׃", "transliteral": "dā-mî-nû", "traducao_palavra": "se assemelharíamos" }
      ]
    },
    "10": {
      "traducao_completa": "Ouvi a palavra de YHWH, vós, governantes de Sodoma; dá ouvidos à lei do nosso Deus, vós, povo de Gomorra.",
      "palavras": [
        { "hebraico": "שִׁמְע֥וּ", "transliteral": "šim-ʿû", "traducao_palavra": "Ouvi" },
        { "hebraico": "דְבַר־יְהוָ֖ה", "transliteral": "də-ḇar-YHWH", "traducao_palavra": "[a] palavra de YHWH" },
        { "hebraico": "קְצִינֵ֣י", "transliteral": "qə-ṣî-nê", "traducao_palavra": "governantes de" },
        { "hebraico": "סְדֹ֑ם", "transliteral": "śə-ḏōm", "traducao_palavra": "Sodoma" },
        { "hebraico": "הַאֲזִ֨ינוּ֙", "transliteral": "ha-ʾă-zî-nû", "traducao_palavra": "dai ouvidos" },
        { "hebraico": "תֹּורַ֣ת", "transliteral": "tô-raṯ", "traducao_palavra": "[à] lei de" },
        { "hebraico": "אֱלֹהֵ֔ינוּ", "transliteral": "ʾĕ-lō-hê-nû", "traducao_palavra": "nosso Deus" },
        { "hebraico": "עַ֖ם", "transliteral": "ʿam", "traducao_palavra": "povo de" },
        { "hebraico": "עֲמֹרָֽה׃", "transliteral": "ʿă-mō-rā", "traducao_palavra": "Gomorra" }
      ]
    },
    "11": {
      "traducao_completa": "De que me serve a mim a multidão de vossos sacrifícios, diz YHWH? Já estou farto dos holocaustos de carneiros e da gordura de animais cevados; e não me agrado do sangue de bezerros, nem de cordeiros, nem de bodes.",
      "palavras": [
        { "hebraico": "לָמָּה־לִּ֨י", "transliteral": "lām-mā-lî", "traducao_palavra": "Para que me [serve]" },
        { "hebraico": "רֹב־זִבְחֵיכֶ֜ם", "transliteral": "rōḇ-ziḇ-ḥê-ḵem", "traducao_palavra": "[a] multidão de vossos sacrifícios" },
        { "hebraico": "יֹאמַ֣ר", "transliteral": "yō-mar", "traducao_palavra": "diz" },
        { "hebraico": "יְהוָ֗ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "שָׂבַ֨עְתִּי֙", "transliteral": "śā-ḇa-ʿatî", "traducao_palavra": "estou farto [de]" },
        { "hebraico": "עֹלֹ֣ות", "transliteral": "ʿō-lôṯ", "traducao_palavra": "holocaustos de" },
