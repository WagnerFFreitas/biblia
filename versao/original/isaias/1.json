        { "hebraico": "יָדִי֙", "transliteral": "yā-ḏî", "traducao_palavra": "minha mão" },
        { "hebraico": "עָלַ֔יִךְ", "transliteral": "ʿā-la-yiḵ", "traducao_palavra": "contra ti" },
        { "hebraico": "וְאֶצְרֹ֥ף", "transliteral": "wə-ʾeṣ-rōp̄", "traducao_palavra": "e purificarei/refinarei" },
        { "hebraico": "כַּבֹּ֖ר", "transliteral": "kab-bōr", "traducao_palavra": "como com soda/puramente" },
        { "hebraico": "סִיגָ֑יִךְ", "transliteral": "śî-ḡā-yiḵ", "traducao_palavra": "tuas escórias" },
        { "hebraico": "וְאָסִ֖יר", "transliteral": "wə-ʾā-śîr", "traducao_palavra": "e tirarei" },
        { "hebraico": "כָּל־", "transliteral": "kāl-", "traducao_palavra": "todo" },
        { "hebraico": "בְּדִילָֽיִךְ׃", "transliteral": "bə-ḏî-lā-yiḵ", "traducao_palavra": "teu estanho/chumbo" }
      ]
    },
    "26": {
      "traducao_completa": "E te restituirei os teus juízes, como foram dantes; e os teus conselheiros, como no princípio; e depois te chamarão cidade de justiça, cidade fiel.",
      "palavras": [
        { "hebraico": "וְאָשִׁ֤יבָה", "transliteral": "wə-ʾā-šî-ḇā", "traducao_palavra": "E restituirei" },
        { "hebraico": "שֹׁפְטַ֨יִךְ֙", "transliteral": "šō-p̄ə-ṭa-yiḵ", "traducao_palavra": "teus juízes" },
        { "hebraico": "כְּבָרִאשֹׁנָ֔ה", "transliteral": "kə-ḇā-ri-šō-nā", "traducao_palavra": "como no princípio" },
        { "hebraico": "וְיֹעֲצַ֖יִךְ", "transliteral": "wə-yō-ʿă-ṣa-yiḵ", "traducao_palavra": "e teus conselheiros" },
        { "hebraico": "כְּבַתְּחִלָּ֑ה", "transliteral": "kə-ḇat-tə-ḥil-lā", "traducao_palavra": "como no começo" },
        { "hebraico": "אַחֲרֵי־כֵ֗ן", "transliteral": "ʾa-ḥă-rê-ḵên", "traducao_palavra": "depois disso" },
        { "hebraico": "יִקָּ֤רֵא", "transliteral": "yiq-qā-rê", "traducao_palavra": "será chamada" },
        { "hebraico": "לָךְ֙", "transliteral": "lāḵ", "traducao_palavra": "a ti" },
        { "hebraico": "עִ֣יר", "transliteral": "ʿîr", "traducao_palavra": "cidade de" },
        { "hebraico": "הַצֶּ֔דֶק", "transliteral": "haṣ-ṣe-ḏeq", "traducao_palavra": "justiça" },
        { "hebraico": "קִרְיָ֖ה", "transliteral": "qir-yā", "traducao_palavra": "cidade" },
        { "hebraico": "נֶאֱמָנָֽה׃", "transliteral": "ne-ʾĕ-mā-nā", "traducao_palavra": "fiel" }
