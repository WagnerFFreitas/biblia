      ]
    },
    "23": {
      "traducao_completa": "Os teus príncipes são rebeldes, e companheiros de ladrões; cada um deles ama o suborno, e corre após recompensas; não fazem justiça ao órfão, e não chega perante eles a causa da viúva.",
      "palavras": [
        { "hebraico": "שָׂרַ֣יִךְ", "transliteral": "śā-ra-yiḵ", "traducao_palavra": "Teus príncipes" },
        { "hebraico": "סֹורְרִ֗ים", "transliteral": "śô-rə-rîm", "traducao_palavra": "[são] rebeldes" },
        { "hebraico": "וְחַבְרֵי֙", "transliteral": "wə-ḥaḇ-rê", "traducao_palavra": "e companheiros de" },
        { "hebraico": "גַּנָּבִ֔ים", "transliteral": "gan-nā-ḇîm", "traducao_palavra": "ladrões" },
        { "hebraico": "כֻּלֹּו֙", "transliteral": "kul-lô", "traducao_palavra": "cada um deles" },
