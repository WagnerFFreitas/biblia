        { "hebraico": "נְאֻ֧ם", "transliteral": "nə-ʾum", "traducao_palavra": "declaração de" },
        { "hebraico": "הָאָדֹ֛ון", "transliteral": "hā-ʾā-ḏôn", "traducao_palavra": "o Senhor" },
        { "hebraico": "יְהוָ֥ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "צְבָאֹ֖ות", "transliteral": "ṣə-ḇā-ʾôṯ", "traducao_palavra": "[dos] Exércitos" },
        { "hebraico": "אֲבִ֣יר", "transliteral": "ʾă-ḇîr", "traducao_palavra": "o Poderoso de" },
        { "hebraico": "יִשְׂרָאֵ֑ל", "transliteral": "yiś-rā-ʾēl", "traducao_palavra": "Israel" },
        { "hebraico": "הֹ֚וי", "transliteral": "hôy", "traducao_palavra": "Ah!" },
        { "hebraico": "אֶנָּחֵ֣ם", "transliteral": "ʾen-nā-ḥêm", "traducao_palavra": "consolar-me-ei/desforrar-me-ei" },
        { "hebraico": "מִצָּרַ֔י", "transliteral": "miṣ-ṣā-ray", "traducao_palavra": "dos meus adversários" },
        { "hebraico": "וְאִנָּקְמָ֖ה", "transliteral": "wə-ʾin-nā-qə-mā", "traducao_palavra": "e vingar-me-ei" },
        { "hebraico": "מֵאֹויְבָֽי׃", "transliteral": "mê-ʾô-yə-ḇāy", "traducao_palavra": "dos meus inimigos" }
