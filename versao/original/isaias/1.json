        { "hebraico": "תִֽהְי֔וּ", "transliteral": "ṯih-yû", "traducao_palavra": "sereis" },
        { "hebraico": "כְּאֵלָ֖ה", "transliteral": "kə-ʾê-lā", "traducao_palavra": "como carvalho/terebinto" },
