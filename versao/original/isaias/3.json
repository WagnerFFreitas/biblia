    "8": {
      "traducao_completa": "Porque Jerusalém tropeçou e Judá caiu; porquanto a sua língua e as suas obras são contra YHWH, para provocarem os olhos da sua glória.",
      "palavras": [
        { "hebraico": "כִּ֣י", "transliteral": "kî", "traducao_palavra": "Porque" },
