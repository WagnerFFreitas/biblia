        { "hebraico": "וִיהוּדָ֥ה", "transliteral": "wî-hû-ḏā", "traducao_palavra": "e Judá" },
        { "hebraico": "נָפָ֑ל", "transliteral": "nā-p̄āl", "traducao_palavra": "caiu" },
        { "hebraico": "כִּֽי־לְשֹׁונָ֤ם", "transliteral": "kî-lə-šô-nām", "traducao_palavra": "porque a língua deles" },
        { "hebraico": "וּמַֽעַלְלֵיהֶם֙", "transliteral": "ū-ma-ʿal-lê-hem", "traducao_palavra": "e os seus atos" },
