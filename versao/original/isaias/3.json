    "7": {
      "traducao_completa": "Naquele dia levantará ele a sua voz, dizendo: Não posso ser médico, pois em minha casa não há pão nem roupa; não me ponhais por governador do povo.",
      "palavras": [
        { "hebraico": "יִשָּׂא֩", "transliteral": "yiś-śā", "traducao_palavra": "Levantará" },
