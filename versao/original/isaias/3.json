        { "hebraico": "אִ֤ישׁ", "transliteral": "ʾîš", "traducao_palavra": "um homem" },
        { "hebraico": "בְּאָחִיו֙", "transliteral": "bə-ʾā-ḥîw", "traducao_palavra": "em seu irmão" },
