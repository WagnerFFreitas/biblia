    "9": {
      "traducao_completa": "O aspecto do seu rosto testifica contra eles; e publicam os seus pecados, como Sodoma; não os encobrem. Ai da sua alma! Porque fazem mal a si mesmos.",
      "palavras": [
        { "hebraico": "הַכָּרַ֤ת", "transliteral": "hak-kā-raṯ", "traducao_palavra": "O reconhecimento de/aspecto de" },
