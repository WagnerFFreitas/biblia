        { "hebraico": "הָעָ֔ם", "transliteral": "hā-ʿām", "traducao_palavra": "o povo" },
        { "hebraico": "אִ֥ישׁ", "transliteral": "ʾîš", "traducao_palavra": "homem" },
        { "hebraico": "בְּאִ֖ישׁ", "transliteral": "bə-ʾîš", "traducao_palavra": "por homem" },
        { "hebraico": "וְאִ֣ישׁ", "transliteral": "wə-ʾîš", "traducao_palavra": "e cada um" },
