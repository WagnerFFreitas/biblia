        { "hebraico": "עָ֣נְתָה", "transliteral": "ʿā-nə-ṯā", "traducao_palavra": "testifica" },
        { "hebraico": "בָּ֑ם", "transliteral": "bām", "traducao_palavra": "contra eles" },
        { "hebraico": "וְחַטָּאתָ֛ם", "transliteral": "wə-ḥaṭ-ṭā-ṯām", "traducao_palavra": "e o seu pecado" },
        { "hebraico": "כִּסְדֹ֥ם", "transliteral": "ki-śə-ḏōm", "traducao_palavra": "como Sodoma" },
        { "hebraico": "הִגִּ֖ידוּ", "transliteral": "hig-gî-ḏû", "traducao_palavra": "publicam/declaram" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "כִחֵ֑דוּ", "transliteral": "ḵi-ḥê-ḏû", "traducao_palavra": "escondem" },
        { "hebraico": "אֹ֣וי", "transliteral": "ʾôy", "traducao_palavra": "Ai" },
        { "hebraico": "לְנַפְשָׁ֔ם", "transliteral": "lə-nap̄-šām", "traducao_palavra": "da alma deles" },
        { "hebraico": "כִּֽי־גָמְל֥וּ", "transliteral": "kî-ḡā-mə-lû", "traducao_palavra": "porque retribuíram" },
        { "hebraico": "לָהֶ֖ם", "transliteral": "lā-hem", "traducao_palavra": "a eles mesmos" },
        { "hebraico": "רָעָֽה׃", "transliteral": "rā-ʿā", "traducao_palavra": "[com] mal" }
      ]
    },
    "10": {
      "traducao_completa": "Dizei ao justo que bem lhe irá; porque comerão do fruto das suas obras.",
      "palavras": [
        { "hebraico": "אִמְר֥וּ", "transliteral": "ʾim-rû", "traducao_palavra": "Dizei" },
        { "hebraico": "צַדִּ֖יק", "transliteral": "ṣad-dîq", "traducao_palavra": "[ao] justo" },
        { "hebraico": "כִּי־טֹ֑וב", "transliteral": "kî-ṭôḇ", "traducao_palavra": "que [será] bem" },
        { "hebraico": "כִּֽי־פְרִ֥י", "transliteral": "kî-p̄ə-rî", "traducao_palavra": "porque [o] fruto de" },
        { "hebraico": "מַעַלְלֵיהֶ֖ם", "transliteral": "ma-ʿal-lê-hem", "traducao_palavra": "seus atos" },
        { "hebraico": "יֹאכֵֽלוּ׃", "transliteral": "yō-ḵê-lû", "traducao_palavra": "comerão" }
      ]
    },
    "11": {
      "traducao_completa": "Ai do ímpio! Mal lhe irá; porque a recompensa das suas mãos se lhe dará.",
      "palavras": [
        { "hebraico": "אֹ֖וי", "transliteral": "ʾôy", "traducao_palavra": "Ai" },
        { "hebraico": "לְרָשָׁ֣ע", "transliteral": "lə-rā-šāʿ", "traducao_palavra": "do ímpio" },
        { "hebraico": "רָ֑ע", "transliteral": "rāʿ", "traducao_palavra": "mal [lhe irá]" },
        { "hebraico": "כִּֽי־גְמ֥וּל", "transliteral": "kî-ḡə-mûl", "traducao_palavra": "porque a recompensa de" },
        { "hebraico": "יָדָ֖יו", "transliteral": "yā-ḏāyw", "traducao_palavra": "suas mãos" },
        { "hebraico": "יֵעָ֥שֶׂה", "transliteral": "yê-ʿā-śeh", "traducao_palavra": "será feita" },
