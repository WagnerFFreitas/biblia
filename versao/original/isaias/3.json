        { "hebraico": "אֶהְיֶ֣ה", "transliteral": "ʾeh-yeh", "traducao_palavra": "serei" },
        { "hebraico": "חֹבֵ֔שׁ", "transliteral": "ḥō-ḇēš", "traducao_palavra": "atador [de feridas]/médico" },
        { "hebraico": "וּבְבֵיתִ֛י", "transliteral": "ū-ḇə-ḇê-ṯî", "traducao_palavra": "e em minha casa" },
