        { "hebraico": "נֹגְשָׂיו֙", "transliteral": "nō-ḡə-śāyw", "traducao_palavra": "seus opressores [são]" },
        { "hebraico": "מְעֹולֵ֔ל", "transliteral": "mə-ʿô-lêl", "traducao_palavra": "crianças/caprichosos" },
        { "hebraico": "וְנָשִׁ֖ים", "transliteral": "wə-nā-šîm", "traducao_palavra": "e mulheres" },
        { "hebraico": "מָ֣שְׁלוּ", "transliteral": "mā-šə-lû", "traducao_palavra": "dominarão" },
        { "hebraico": "בֹ֑ו", "transliteral": "ḇô", "traducao_palavra": "sobre ele" },
        { "hebraico": "עַמִּ֕י", "transliteral": "ʿam-mî", "traducao_palavra": "ó povo meu" },
