        { "hebraico": "אָמַ֨ר", "transliteral": "ʾā-mar", "traducao_palavra": "disse" },
        { "hebraico": "אֲדֹנַ֜יִךְ", "transliteral": "ʾă-ḏō-na-yiḵ", "traducao_palavra": "teu Senhor" },
        { "hebraico": "יְהוָ֗ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
