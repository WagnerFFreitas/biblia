        { "hebraico": "יָרִ֣יב", "transliteral": "yā-rîḇ", "traducao_palavra": "[que] pleiteará" },
        { "hebraico": "עַמֹּ֑ו", "transliteral": "ʿam-mō-w", "traducao_palavra": "[a causa do] seu povo" },
        { "hebraico": "הִנֵּ֥ה", "transliteral": "hin-nēh", "traducao_palavra": "Eis que" },
        { "hebraico": "לָקַ֛חְתִּי", "transliteral": "lā-qa-ḥə-tî", "traducao_palavra": "tomei" },
        { "hebraico": "מִיָּדֵ֖ךְ", "transliteral": "miy-yā-ḏêḵ", "traducao_palavra": "da tua mão" },
        { "hebraico": "אֶת־", "transliteral": "ʾeṯ-", "traducao_palavra": "[partícula acusativa]" },
        { "hebraico": "כֹּ֣וס", "transliteral": "kō-ws", "traducao_palavra": "[o] cálice de" },
        { "hebraico": "הַתַּרְעֵלָ֑ה", "transliteral": "hat-tar-ʿê-lāh", "traducao_palavra": "a vertigem" },
        { "hebraico": "אֶת־", "transliteral": "ʾeṯ-", "traducao_palavra": "[partícula acusativa]" },
