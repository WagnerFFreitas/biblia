    },
    "23": {
      "traducao_completa": "Mas pô-lo-ei na mão dos que te atribularam, que disseram à tua alma: Abaixa-te, para que passemos sobre ti; e tu puseste as tuas costas como chão e como rua para os que passavam.",
      "palavras": [
        { "hebraico": "וְשַׂמְתִּ֙יהָ֙", "transliteral": "wə-śam-tî-hā", "traducao_palavra": "E porei ele" },
        { "hebraico": "בְּיַד־", "transliteral": "bə-yaḏ-", "traducao_palavra": "na mão de" },
        { "hebraico": "מֹוגַ֔יִךְ", "transliteral": "mō-w-ḡa-yiḵ", "traducao_palavra": "teus opressores/atribuladores" },
        { "hebraico": "אֲשֶׁר־", "transliteral": "ʾă-šer-", "traducao_palavra": "que" },
        { "hebraico": "אָמְר֥וּ", "transliteral": "ʾā-mə-rū", "traducao_palavra": "disseram" },
        { "hebraico": "לְנַפְשֵׁ֖ךְ", "transliteral": "lə-nap̄-šēḵ", "traducao_palavra": "à tua alma" },
