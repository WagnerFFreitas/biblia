    "19": {
      "traducao_completa": "Estas duas coisas te aconteceram; quem terá compaixão de ti? A assolação e a destruição, a fome e a espada; por quem te consolarei?",
      "palavras": [
        { "hebraico": "שְׁתַּ֤יִם", "transliteral": "šə-ta-yim", "traducao_palavra": "Duas" },
        { "hebraico": "הֵ֙נָּה֙", "transliteral": "hên-nāh", "traducao_palavra": "[coisas] estas" },
        { "hebraico": "קֹרְאֹתַ֔יִךְ", "transliteral": "qō-rə-ʾō-ṯa-yiḵ", "traducao_palavra": "te aconteceram/chamaram" },
        { "hebraico": "מִ֖י", "transliteral": "mî", "traducao_palavra": "quem" },
        { "hebraico": "יָנ֣וּד", "transliteral": "yā-nūḏ", "traducao_palavra": "terá compaixão" },
        { "hebraico": "לָ֑ךְ", "transliteral": "lāḵ", "traducao_palavra": "de ti?" },
        { "hebraico": "הַשֹּׁ֧ד", "transliteral": "haš-šōḏ", "traducao_palavra": "A assolação" },
        { "hebraico": "וְהַשֶּׁ֛בֶר", "transliteral": "wə-haš-še-ḇer", "traducao_palavra": "e a destruição" },
        { "hebraico": "וְהָרָעָ֥ב", "transliteral": "wə-hā-rā-ʿāḇ", "traducao_palavra": "e a fome" },
        { "hebraico": "וְהַחֶ֖רֶב", "transliteral": "wə-ha-ḥe-reḇ", "traducao_palavra": "e a espada" },
        { "hebraico": "מִ֥י", "transliteral": "mî", "traducao_palavra": "por quem/como" },
        { "hebraico": "אֲנַחֲמֵֽךְ׃", "transliteral": "ʾă-na-ḥă-mêḵ", "traducao_palavra": "consolarei a ti?" }
      ]
    },
    "20": {
      "traducao_completa": "Os teus filhos desfaleceram, jazem em todos os cantos das ruas como o antílope na rede; cheios estão do furor de YHWH e da repreensão do teu Deus.",
      "palavras": [
