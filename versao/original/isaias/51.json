        { "hebraico": "זֹ֖את", "transliteral": "zōṯ", "traducao_palavra": "isto" },
        { "hebraico": "עֲנִיָּ֑ה", "transliteral": "ʿă-niy-yāh", "traducao_palavra": "ó aflita" },
        { "hebraico": "וּשְׁכֻרַ֖ת", "transliteral": "ū-šə-ḵu-raṯ", "traducao_palavra": "e embriagada" },
