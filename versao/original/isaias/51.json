        { "hebraico": "עֻלְּפ֔וּ", "transliteral": "ʿul-lə-p̄ū", "traducao_palavra": "desfaleceram" },
        { "hebraico": "שָׁכְב֛וּ", "transliteral": "šā-ḵə-ḇū", "traducao_palavra": "jazem/deitaram-se" },
        { "hebraico": "בְּרֹ֥אשׁ", "transliteral": "bə-rōš", "traducao_palavra": "na ponta/canto de" },
        { "hebraico": "כָּל־", "transliteral": "ḵāl-", "traducao_palavra": "todas [as]" },
        { "hebraico": "חוּצֹ֖ות", "transliteral": "ḥū-ṣō-wṯ", "traducao_palavra": "ruas" },
        { "hebraico": "כְּתֹ֣וא", "transliteral": "kə-ṯō-w", "traducao_palavra": "como antílope" },
        { "hebraico": "מִכְמָ֑ר", "transliteral": "miḵ-mār", "traducao_palavra": "[na] rede" },
        { "hebraico": "הַֽמְלֵאִ֥ים", "transliteral": "ham-lē-ʾîm", "traducao_palavra": "os cheios de" },
        { "hebraico": "חֲמַת־", "transliteral": "ḥă-maṯ-", "traducao_palavra": "furor de" },
        { "hebraico": "יְהוָ֖ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "גַּעֲרַ֥ת", "transliteral": "ga-ʿă-raṯ", "traducao_palavra": "[da] repreensão de" },
        { "hebraico": "אֱלֹהָֽיִךְ׃", "transliteral": "ʾĕ-lō-hā-yiḵ", "traducao_palavra": "teu Deus." }
