        { "hebraico": "כֻּלָּֽנוּ׃", "transliteral": "kul-lā-nū", "traducao_palavra": "todos nós." }
      ]
    },
    "9": {
      "traducao_completa": "Não te ires tanto, ó YHWH, nem para sempre te lembres da iniquidade; eis, olha, nós te pedimos, todos nós somos o teu povo.",
      "palavras": [
        { "hebraico": "אַל־", "transliteral": "ʾal-", "traducao_palavra": "Não" },
        { "hebraico": "תִּקְצֹ֤ף", "transliteral": "tiq-ṣōp̄", "traducao_palavra": "ires-te" },
        { "hebraico": "יְהוָה֙", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "עַד־", "transliteral": "ʿaḏ-", "traducao_palavra": "até" },
        { "hebraico": "מְאֹ֔ד", "transliteral": "mə-ʾōḏ", "traducao_palavra": "muito" },
        { "hebraico": "וְאַל־", "transliteral": "wə-ʾal-", "traducao_palavra": "e não" },
        { "hebraico": "לָעַ֖ד", "transliteral": "lā-ʿaḏ", "traducao_palavra": "para sempre" },
        { "hebraico": "תִּזְכֹּ֣ר", "transliteral": "tiz-kōr", "traducao_palavra": "lembres" },
        { "hebraico": "עָוֹ֑ן", "transliteral": "ʿā-wōn", "traducao_palavra": "[a] iniquidade" },
        { "hebraico": "הֵ֧ן", "transliteral": "hên", "traducao_palavra": "eis" },
        { "hebraico": "הַבֶּט־", "transliteral": "hab-beṭ-", "traducao_palavra": "olha" },
        { "hebraico": "נָ֛א", "transliteral": "nā", "traducao_palavra": "pois/rogamos" },
        { "hebraico": "עַמְּךָ֥", "transliteral": "ʿam-mə-ḵā", "traducao_palavra": "teu povo" },
        { "hebraico": "כֻלָּֽנוּ׃", "transliteral": "kul-lā-nū", "traducao_palavra": "todos nós [somos]." }
