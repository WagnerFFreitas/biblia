    },
    "10": {
      "traducao_completa": "As tuas santas cidades tornaram-se um deserto; Sião tornou-se um deserto, Jerusalém uma assolação.",
      "palavras": [
        { "hebraico": "עָרֵ֥י", "transliteral": "ʿā-rê", "traducao_palavra": "Cidades de" },
        { "hebraico": "קָדְשְׁךָ֖", "transliteral": "qāḏ-šə-ḵā", "traducao_palavra": "tua santidade" },
        { "hebraico": "הָי֣וּ", "transliteral": "hā-yū", "traducao_palavra": "foram/tornaram-se" },
        { "hebraico": "מִדְבָּ֑ר", "transliteral": "miḏ-bār", "traducao_palavra": "deserto" },
        { "hebraico": "צִיֹּון֙", "transliteral": "ṣiy-yō-wn", "traducao_palavra": "Sião" },
        { "hebraico": "מִדְבָּ֣ר", "transliteral": "miḏ-bār", "traducao_palavra": "deserto" },
        { "hebraico": "הָיָ֔תָה", "transliteral": "hā-yā-ṯāh", "traducao_palavra": "foi" },
        { "hebraico": "יְרוּשָׁלִַ֖ם", "transliteral": "yə-rū-šā-la-im", "traducao_palavra": "Jerusalém" },
        { "hebraico": "שְׁמָמָֽה׃", "transliteral": "šə-mā-māh", "traducao_palavra": "assolação." }
      ]
    },
    "11": {
      "traducao_completa": "A nossa santa e gloriosa casa, em que te louvavam nossos pais, foi queimada a fogo; e todas as nossas coisas preciosas se tornaram em ruínas.",
      "palavras": [
        { "hebraico": "בֵּ֧ית", "transliteral": "bêṯ", "traducao_palavra": "A casa de" },
        { "hebraico": "קָדְשֵׁ֣נוּ", "transliteral": "qāḏ-šê-nū", "traducao_palavra": "nossa santidade" },
        { "hebraico": "וְתִפְאַרְתֵּ֗נוּ", "transliteral": "wə-ṯip̄-ʾar-tê-nū", "traducao_palavra": "e nosso esplendor" },
        { "hebraico": "אֲשֶׁ֤ר", "transliteral": "ʾă-šer", "traducao_palavra": "na qual" },
        { "hebraico": "הִֽלְלוּךָ֙", "transliteral": "hil-lə-lū-ḵā", "traducao_palavra": "louvavam-te" },
        { "hebraico": "אֲבֹתֵ֔ינוּ", "transliteral": "ʾă-ḇō-ṯê-nū", "traducao_palavra": "nossos pais" },
        { "hebraico": "הָיָ֖ה", "transliteral": "hā-yāh", "traducao_palavra": "foi" },
        { "hebraico": "לִשְׂרֵ֣פַת", "transliteral": "liś-rê-p̄aṯ", "traducao_palavra": "para queima de" },
        { "hebraico": "אֵ֑שׁ", "transliteral": "ʾēš", "traducao_palavra": "fogo" },
        { "hebraico": "וְכָל־", "transliteral": "wə-ḵāl-", "traducao_palavra": "e tudo" },
