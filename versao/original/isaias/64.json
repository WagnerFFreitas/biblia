{
  "livro": "Isaías - יְשַֽׁעְיָהוּ - Yəšayāhū",
  "capítulo": 64,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Oxalá fendesses os céus e descesses! Diante da tua face os montes derreteriam.",
      "palavras": [
        { "hebraico": "לּ֥וּא־", "transliteral": "lū-", "traducao_palavra": "Oxalá/Oh se" },
        { "hebraico": "קָרַ֤עְתָּ", "transliteral": "qā-raʿ-tā", "traducao_palavra": "fendesses/rasgasses" },
        { "hebraico": "שָׁמַ֙יִם֙", "transliteral": "šā-ma-yim", "traducao_palavra": "[os] céus" },
        { "hebraico": "יָרַ֔דְתָּ", "transliteral": "yā-raḏ-tā", "traducao_palavra": "descesses" },
        { "hebraico": "מִפָּנֶ֖יךָ", "transliteral": "mip-pā-ne-ḵā", "traducao_palavra": "de diante de tua face" },
        { "hebraico": "הָרִ֥ים", "transliteral": "hā-rîm", "traducao_palavra": "montes" },
        { "hebraico": "נָזֹֽלּוּ׃", "transliteral": "nā-zōl-lū", "traducao_palavra": "derreteriam/tremeriam." }
      ]
    },
    "2": {
      "traducao_completa": "Como quando o fogo acende os gravetos, como o fogo faz ferver as águas, para fazeres notório o teu nome aos teus adversários, para que diante da tua face as nações tremam.",
      "palavras": [
        { "hebraico": "כִּקְדֹ֧חַ", "transliteral": "ki-qə-ḏō-aḥ", "traducao_palavra": "Como o arder de" },
        { "hebraico": "אֵ֣שׁ", "transliteral": "ʾēš", "traducao_palavra": "fogo" },
        { "hebraico": "הֲמָסִ֗ים", "transliteral": "hă-mā-śîm", "traducao_palavra": "[em] gravetos/estilhaços" },
        { "hebraico": "מַ֚יִם", "transliteral": "ma-yim", "traducao_palavra": "águas" },
        { "hebraico": "תִּבְעֶה־", "transliteral": "tiḇ-ʿeh-", "traducao_palavra": "faz ferver" },
        { "hebraico": "אֵ֔שׁ", "transliteral": "ʾēš", "traducao_palavra": "[o] fogo" },
        { "hebraico": "לְהֹודִ֤יעַ", "transliteral": "lə-hō-w-ḏî-aʿ", "traducao_palavra": "para dar a conhecer" },
        { "hebraico": "שִׁמְךָ֙", "transliteral": "šim-ḵā", "traducao_palavra": "teu nome" },
        { "hebraico": "לְצָרֶ֔יךָ", "transliteral": "lə-ṣā-re-ḵā", "traducao_palavra": "aos teus adversários" },
        { "hebraico": "מִפָּנֶ֖יךָ", "transliteral": "mip-pā-ne-ḵā", "traducao_palavra": "de diante de tua face" },
        { "hebraico": "גֹּויִ֥ם", "transliteral": "gō-w-yim", "traducao_palavra": "nações" },
        { "hebraico": "יִרְגָּֽזוּ׃", "transliteral": "yir-gā-zū", "traducao_palavra": "tremam." }
      ]
    },
    "3": {
      "traducao_completa": "Quando fazias coisas terríveis, que não esperávamos, desceste; diante da tua face os montes derreteriam.",
      "palavras": [
        { "hebraico": "בַּעֲשֹׂותְךָ֥", "transliteral": "ba-ʿă-śō-w-ṯə-ḵā", "traducao_palavra": "No fazeres tu" },
        { "hebraico": "נֹורָאֹ֖ות", "transliteral": "nō-w-rā-ʾō-wṯ", "traducao_palavra": "coisas terríveis" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "נְקַוֶּ֑ה", "transliteral": "nə-qaw-weh", "traducao_palavra": "esperávamos" },
        { "hebraico": "יָרַ֕דְתָּ", "transliteral": "yā-raḏ-tā", "traducao_palavra": "desceste" },
        { "hebraico": "מִפָּנֶ֖יךָ", "transliteral": "mip-pā-ne-ḵā", "traducao_palavra": "de diante de tua face" },
        { "hebraico": "הָרִ֥ים", "transliteral": "hā-rîm", "traducao_palavra": "montes" },
        { "hebraico": "נָזֹֽלּוּ׃", "transliteral": "nā-zōl-lū", "traducao_palavra": "derreteriam." }
      ]
    },
    "4": {
      "traducao_completa": "Desde a antiguidade não se ouviu, nem com ouvidos se percebeu, nem olho viu um Deus além de ti, que trabalhe para aquele que espera nele.",
      "palavras": [
        { "hebraico": "וּמֵעֹולָ֥ם", "transliteral": "ū-mē-ʿō-w-lām", "traducao_palavra": "E desde a antiguidade" },
        { "hebraico": "לֹֽא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "שָׁמְע֖וּ", "transliteral": "šā-mə-ʿū", "traducao_palavra": "ouviram" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "הֶאֱזִ֑ינוּ", "transliteral": "he-ʾĕ-zî-nū", "traducao_palavra": "perceberam com ouvidos" },
        { "hebraico": "עַ֣יִן", "transliteral": "ʿa-yin", "traducao_palavra": "olho" },
        { "hebraico": "לֹֽא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "רָאָתָה֩", "transliteral": "rā-ʾā-ṯāh", "traducao_palavra": "viu" },
        { "hebraico": "אֱלֹהִ֨ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "Deus" },
        { "hebraico": "זוּלָתְךָ֜", "transliteral": "zū-lā-ṯə-ḵā", "traducao_palavra": "além de ti" },
        { "hebraico": "יַעֲשֶׂ֥ה", "transliteral": "ya-ʿă-śeh", "traducao_palavra": "[que] faça/trabalhe" },
        { "hebraico": "לִמְחַכֵּה־", "transliteral": "lim-ḥak-kēh-", "traducao_palavra": "para o que espera" },
        { "hebraico": "לֹֽו׃", "transliteral": "lō-w", "traducao_palavra": "por ele." }
      ]
    },
    "5": {
      "traducao_completa": "Saíste ao encontro daquele que com alegria praticava justiça, daqueles que se lembram de ti nos teus caminhos; eis que tu te iraste, porque pecamos; neles estivemos por muito tempo; seremos salvos?",
      "palavras": [
        { "hebraico": "פָּגַ֤עְתָּ", "transliteral": "pā-ḡa-ʿatā", "traducao_palavra": "Encontraste/Saíste ao encontro" },
        { "hebraico": "אֶת־", "transliteral": "ʾeṯ-", "traducao_palavra": "[partícula acusativa]" },
        { "hebraico": "שָׂשׂ֙", "transliteral": "śāś", "traducao_palavra": "[daquele que se] alegra" },
        { "hebraico": "וְעֹ֣שֵׂה", "transliteral": "wə-ʿō-śēh", "traducao_palavra": "e pratica" },
        { "hebraico": "צֶ֔דֶק", "transliteral": "ṣe-ḏeq", "traducao_palavra": "justiça" },
        { "hebraico": "בִּדְרָכֶ֖יךָ", "transliteral": "biḏ-rā-ḵe-ḵā", "traducao_palavra": "nos teus caminhos" },
        { "hebraico": "יִזְכְּר֑וּךָ", "transliteral": "yiz-kə-rū-ḵā", "traducao_palavra": "lembram-se de ti" },
        { "hebraico": "הֵן־", "transliteral": "hên-", "traducao_palavra": "Eis que" },
        { "hebraico": "אַתָּ֤ה", "transliteral": "ʾat-tāh", "traducao_palavra": "tu" },
        { "hebraico": "קָצַ֙פְתָּ֙", "transliteral": "qā-ṣap̄-tā", "traducao_palavra": "te iraste" },
        { "hebraico": "וַֽנֶּחֱטָ֔א", "transliteral": "wan-ne-ḥĕ-ṭā", "traducao_palavra": "e pecamos" },
        { "hebraico": "בָּהֶ֥ם", "transliteral": "bā-hem", "traducao_palavra": "neles (pecados/caminhos)" },
        { "hebraico": "עֹולָ֖ם", "transliteral": "ʿō-w-lām", "traducao_palavra": "[por muito] tempo/eternidade" },
        { "hebraico": "וְנִוָּשֵֽׁעַ׃", "transliteral": "wə-niw-wā-šē-aʿ", "traducao_palavra": "e seremos salvos?" }
      ]
    },
    "6": {
      "traducao_completa": "Mas todos nós somos como o imundo, e todas as nossas justiças como trapo de imundícia; e todos nós caímos como a folha, e as nossas iniquidades, como o vento, nos arrebatam.",
      "palavras": [
        { "hebraico": "וַנְּהִ֤י", "transliteral": "wan-nə-hî", "traducao_palavra": "E fomos/tornamo-nos" },
        { "hebraico": "כַטָּמֵא֙", "transliteral": "ḵaṭ-ṭā-mē", "traducao_palavra": "como o imundo" },
        { "hebraico": "כֻּלָּ֕נוּ", "transliteral": "kul-lā-nū", "traducao_palavra": "todos nós" },
        { "hebraico": "וּכְבֶ֥גֶד", "transliteral": "ū-ḵə-ḇe-ḡeḏ", "traducao_palavra": "e como veste de" },
        { "hebraico": "עִדִּ֖ים", "transliteral": "ʿid-dîm", "traducao_palavra": "períodos/trapos de imundícia" },
        { "hebraico": "כָּל־", "transliteral": "kāl-", "traducao_palavra": "todas" },
        { "hebraico": "צִדְקֹתֵ֑ינוּ", "transliteral": "ṣiḏ-qō-ṯê-nū", "traducao_palavra": "nossas justiças" },
        { "hebraico": "וַנָּ֤בֶל", "transliteral": "wan-nā-ḇel", "traducao_palavra": "e murchamos/caímos" },
        { "hebraico": "כֶּֽעָלֶה֙", "transliteral": "ke-ʿā-leh", "traducao_palavra": "como a folha" },
        { "hebraico": "כֻּלָּ֔נוּ", "transliteral": "kul-lā-nū", "traducao_palavra": "todos nós" },
        { "hebraico": "וַעֲוֹנֵ֖נוּ", "transliteral": "wa-ʿă-wō-nê-nū", "traducao_palavra": "e nossas iniquidades" },
        { "hebraico": "כָּר֥וּחַ", "transliteral": "kā-rū-aḥ", "traducao_palavra": "como o vento" },
        { "hebraico": "יִשָּׂאֻֽנוּ׃", "transliteral": "yiś-śā-ʾu-nū", "traducao_palavra": "levam-nos/arrebatam-nos." }
      ]
    },
    "7": {
      "traducao_completa": "E ninguém há que invoque o teu nome, que se desperte para se deter em ti; porque escondeste de nós o teu rosto, e nos consumiste por causa das nossas iniquidades.",
      "palavras": [
        { "hebraico": "וְאֵין־", "transliteral": "wə-ʾên-", "traducao_palavra": "E não há" },
        { "hebraico": "קֹורֵ֣א", "transliteral": "qō-w-rē", "traducao_palavra": "[quem] chame/invoque" },
        { "hebraico": "בְשִׁמְךָ֔", "transliteral": "ḇə-šim-ḵā", "traducao_palavra": "no teu nome" },
        { "hebraico": "מִתְעֹורֵ֖ר", "transliteral": "miṯ-ʿō-w-rēr", "traducao_palavra": "despertando-se" },
        { "hebraico": "לְהַחֲזִ֣יק", "transliteral": "lə-ha-ḥă-zîq", "traducao_palavra": "para apegar-se/deter-se" },
        { "hebraico": "בָּ֑ךְ", "transliteral": "bāḵ", "traducao_palavra": "em ti" },
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "porque" },
        { "hebraico": "הִסְתַּ֤רְתָּ", "transliteral": "his-tar-tā", "traducao_palavra": "escondeste" },
        { "hebraico": "פָנֶ֙יךָ֙", "transliteral": "p̄ā-ne-ḵā", "traducao_palavra": "tua face" },
        { "hebraico": "מִמֶּ֔נּוּ", "transliteral": "mim-men-nū", "traducao_palavra": "de nós" },
        { "hebraico": "וַתְּמוּגֵ֖נוּ", "transliteral": "wat-tə-mū-ḡê-nū", "traducao_palavra": "e entregaste-nos/derreteste-nos" },
        { "hebraico": "בְּיַד־", "transliteral": "bə-yaḏ-", "traducao_palavra": "na mão de/por causa de" },
        { "hebraico": "עֲוֹנֵֽנוּ׃", "transliteral": "ʿă-wō-nê-nū", "traducao_palavra": "nossa iniquidade." }
      ]
    },
    "8": {
      "traducao_completa": "Mas agora, ó YHWH, tu és nosso Pai; nós somos o barro, e tu o nosso oleiro; e todos nós obra das tuas mãos.",
      "palavras": [
        { "hebraico": "וְעַתָּ֥ה", "transliteral": "wə-ʿat-tāh", "traducao_palavra": "E agora" },
        { "hebraico": "יְהוָ֖ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "אָבִ֣ינוּ", "transliteral": "ʾā-ḇî-nū", "traducao_palavra": "nosso Pai [és]" },
        { "hebraico": "אָ֑תָּה", "transliteral": "ʾāt-tāh", "traducao_palavra": "tu" },
        { "hebraico": "אֲנַ֤חְנוּ", "transliteral": "ʾă-naḥ-nū", "traducao_palavra": "nós [somos]" },
        { "hebraico": "הַחֹ֙מֶר֙", "transliteral": "ha-ḥō-mer", "traducao_palavra": "o barro" },
        { "hebraico": "וְאַתָּ֣ה", "transliteral": "wə-ʾat-tāh", "traducao_palavra": "e tu" },
        { "hebraico": "יֹצְרֵ֔נוּ", "transliteral": "yō-ṣə-rê-nū", "traducao_palavra": "nosso oleiro/formador" },
        { "hebraico": "וּמַעֲשֵׂ֥ה", "transliteral": "ū-ma-ʿă-śēh", "traducao_palavra": "e obra de" },
