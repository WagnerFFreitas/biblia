        { "hebraico": "לָֽמֹו׃", "transliteral": "lā-mōw", "traducao_palavra": "que lhes [pertencem]." }
      ]
    },
    "9": {
      "traducao_completa": "Todas as nações se ajuntem, e os povos se congreguem; quem entre eles anunciará isto e nos fará ouvir as coisas primeiras? Apresentem as suas testemunhas, para que se justifiquem; e ouçam-se, e diga-se: Verdade é.",
      "palavras": [
        { "hebraico": "כָּל־", "transliteral": "kāl-", "traducao_palavra": "Todas" },
        { "hebraico": "הַגֹּויִ֧ם", "transliteral": "hag-gō-w-yim", "traducao_palavra": "as nações" },
        { "hebraico": "נִקְבְּצ֣וּ", "transliteral": "niq-bə-ṣū", "traducao_palavra": "se ajuntem" },
        { "hebraico": "יַחְדָּ֗ו", "transliteral": "yaḥ-dāw", "traducao_palavra": "juntamente" },
        { "hebraico": "וְיֵאָסְפ֥וּ", "transliteral": "wə-yê-ʾā-śə-p̄ū", "traducao_palavra": "e se congreguem" },
        { "hebraico": "לְאֻמִּ֬ים", "transliteral": "lə-ʾum-mîm", "traducao_palavra": "[os] povos" },
