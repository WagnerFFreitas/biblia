        { "hebraico": "אָמַ֧ר", "transliteral": "ʾā-mar", "traducao_palavra": "disse" },
        { "hebraico": "יְהוָ֛ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "בֹּרַאֲךָ֣", "transliteral": "bō-ra-ʾă-ḵā", "traducao_palavra": "teu Criador" },
        { "hebraico": "יַעֲקֹ֔ב", "transliteral": "ya-ʿă-qōḇ", "traducao_palavra": "Jacó" },
        { "hebraico": "וְיֹצֶרְךָ֖", "transliteral": "wə-yō-ṣer-ḵā", "traducao_palavra": "e teu Formador" },
        { "hebraico": "יִשְׂרָאֵ֑ל", "transliteral": "yiś-rā-ʾēl", "traducao_palavra": "Israel" },
        { "hebraico": "אַל־", "transliteral": "ʾal-", "traducao_palavra": "não" },
        { "hebraico": "תִּירָא֙", "transliteral": "tî-rā", "traducao_palavra": "temas" },
        { "hebraico": "כִּ֣י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "גְאַלְתִּ֔יךָ", "transliteral": "ḡə-ʾal-tî-ḵā", "traducao_palavra": "eu te remi" },
        { "hebraico": "קָרָ֥אתִי", "transliteral": "qā-rā-ṯî", "traducao_palavra": "chamei" },
        { "hebraico": "בְשִׁמְךָ֖", "transliteral": "ḇə-šim-ḵā", "traducao_palavra": "pelo teu nome" },
        { "hebraico": "לִי־", "transliteral": "lî-", "traducao_palavra": "meu [és]" },
        { "hebraico": "אָֽתָּה׃", "transliteral": "ʾāt-tāh", "traducao_palavra": "tu." }
      ]
    },
    "2": {
      "traducao_completa": "Quando passares pelas águas, estarei contigo; e pelos rios, eles não te submergirão; quando andares pelo fogo, não te queimarás, nem a chama arderá em ti.",
      "palavras": [
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "Quando" },
        { "hebraico": "תַעֲבֹ֣ר", "transliteral": "ṯa-ʿă-ḇōr", "traducao_palavra": "passares" },
        { "hebraico": "בַּמַּיִם֮", "transliteral": "bam-ma-yim", "traducao_palavra": "pelas águas" },
        { "hebraico": "אִתְּךָ־", "transliteral": "ʾit-tə-ḵā-", "traducao_palavra": "contigo" },
        { "hebraico": "אָנִי֒", "transliteral": "ʾā-nî", "traducao_palavra": "eu [estarei]" },
        { "hebraico": "וּבַנְּהָרֹות֙", "transliteral": "ū-ḇan-nə-hā-rō-wṯ", "traducao_palavra": "e pelos rios" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "יִשְׁטְפ֑וּךָ", "transliteral": "yiš-ṭə-p̄ū-ḵā", "traducao_palavra": "te submergirão" },
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "quando" },
        { "hebraico": "תֵלֵ֤ךְ", "transliteral": "ṯē-lēḵ", "traducao_palavra": "andares" },
