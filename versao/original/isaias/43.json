        { "hebraico": "אֵשׁ֙", "transliteral": "ʾēš", "traducao_palavra": "fogo" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "תִכָּוֶ֔ה", "transliteral": "ṯik-kā-weh", "traducao_palavra": "te queimarás" },
        { "hebraico": "וְלֶהָבָ֖ה", "transliteral": "wə-le-hā-ḇāh", "traducao_palavra": "nem a chama" },
        { "hebraico": "לֹ֥א", "transliteral": "lō", "traducao_palavra": "não" },
