        { "hebraico": "לְמַ֣עַן", "transliteral": "lə-ma-ʿan", "traducao_palavra": "para que" },
        { "hebraico": "תֵּ֠דְעוּ", "transliteral": "tê-ḏə-ʿū", "traducao_palavra": "saibais" },
        { "hebraico": "וְתַאֲמִ֨ינוּ", "transliteral": "wə-ṯa-ʾă-mî-nū", "traducao_palavra": "e creiais" },
        { "hebraico": "לִ֜י", "transliteral": "lî", "traducao_palavra": "em mim" },
        { "hebraico": "וְתָבִ֗ינוּ", "transliteral": "wə-ṯā-ḇî-nū", "traducao_palavra": "e entendais" },
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "que" },
        { "hebraico": "אֲנִ֥י", "transliteral": "ʾă-nî", "traducao_palavra": "eu" },
