        { "hebraico": "בָּֽךְ׃", "transliteral": "bāḵ", "traducao_palavra": "em ti." }
      ]
    },
    "3": {
      "traducao_completa": "Porque eu sou YHWH teu Deus, o Santo de Israel, o teu Salvador; dei o Egito por teu resgate, a Etiópia e Sebá em teu lugar.",
      "palavras": [
        { "hebraico": "כִּ֧י", "transliteral": "kî", "traducao_palavra": "Porque" },
        { "hebraico": "אֲנִ֣י", "transliteral": "ʾă-nî", "traducao_palavra": "eu" },
        { "hebraico": "יְהוָ֣ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "אֱלֹהֶ֗יךָ", "transliteral": "ʾĕ-lō-he-ḵā", "traducao_palavra": "teu Deus" },
        { "hebraico": "קְדֹ֥ושׁ", "transliteral": "qə-ḏō-wš", "traducao_palavra": "[o] Santo de" },
