    },
    "4": {
      "traducao_completa": "Visto que foste precioso aos meus olhos, foste honrado, e eu te amei, darei homens por ti, e povos pela tua vida.",
      "palavras": [
        { "hebraico": "מֵאֲשֶׁ֨ר", "transliteral": "mē-ʾă-šer", "traducao_palavra": "Visto que" },
        { "hebraico": "יָקַ֧רְתָּ", "transliteral": "yā-qar-tā", "traducao_palavra": "foste precioso" },
        { "hebraico": "בְעֵינַ֛י", "transliteral": "ḇə-ʿê-nay", "traducao_palavra": "aos meus olhos" },
        { "hebraico": "נִכְבַּ֖דְתָּ", "transliteral": "niḵ-baḏ-tā", "traducao_palavra": "foste honrado" },
        { "hebraico": "וַאֲנִ֣י", "transliteral": "wa-ʾă-nî", "traducao_palavra": "e eu" },
        { "hebraico": "אֲהַבְתִּ֑יךָ", "transliteral": "ʾă-haḇ-tî-ḵā", "traducao_palavra": "te amei" },
        { "hebraico": "וְאֶתֵּ֤ן", "transliteral": "wə-ʾet-tên", "traducao_palavra": "e darei" },
        { "hebraico": "אָדָם֙", "transliteral": "ʾā-ḏām", "traducao_palavra": "homens" },
        { "hebraico": "תַּחְתֶּ֔יךָ", "transliteral": "taḥ-te-y-ḵā", "traducao_palavra": "em teu lugar" },
        { "hebraico": "וּלְאֻמִּ֖ים", "transliteral": "ū-lə-ʾum-mîm", "traducao_palavra": "e povos" },
        { "hebraico": "תַּ֥חַת", "transliteral": "ta-ḥaṯ", "traducao_palavra": "em lugar de" },
        { "hebraico": "נַפְשֶֽׁךָ׃", "transliteral": "nap̄-še-ḵā", "traducao_palavra": "tua alma/vida." }
      ]
    },
    "5": {
      "traducao_completa": "Não temas, pois, porque estou contigo; trarei a tua semente desde o oriente, e te ajuntarei desde o ocidente.",
      "palavras": [
        { "hebraico": "אַל־", "transliteral": "ʾal-", "traducao_palavra": "Não" },
        { "hebraico": "תִּירָ֖א", "transliteral": "tî-rā", "traducao_palavra": "temas" },
        { "hebraico": "כִּ֣י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "אִתְּךָ־", "transliteral": "ʾit-tə-ḵā-", "traducao_palavra": "contigo" },
        { "hebraico": "אָ֑נִי", "transliteral": "ʾā-nî", "traducao_palavra": "eu [estou]" },
        { "hebraico": "מִמִּזְרָח֙", "transliteral": "mim-miz-rāḥ", "traducao_palavra": "desde o oriente" },
        { "hebraico": "אָבִ֣יא", "transliteral": "ʾā-ḇî", "traducao_palavra": "trarei" },
        { "hebraico": "זַרְעֶ֔ךָ", "transliteral": "zar-ʿe-ḵā", "traducao_palavra": "tua semente" },
        { "hebraico": "וּמִֽמַּעֲרָ֖ב", "transliteral": "ū-mim-ma-ʿă-rāḇ", "traducao_palavra": "e desde o ocidente" },
        { "hebraico": "אֲקַבְּצֶֽךָּ׃", "transliteral": "ʾă-qab-bə-ṣe-kā", "traducao_palavra": "te ajuntarei." }
      ]
    },
    "6": {
      "traducao_completa": "Direi ao norte: Dá; e ao sul: Não retenhas; trazei meus filhos de longe e minhas filhas das extremidades da terra.",
      "palavras": [
        { "hebraico": "אֹמַ֤ר", "transliteral": "ʾō-mar", "traducao_palavra": "Direi" },
        { "hebraico": "לַצָּפֹון֙", "transliteral": "laṣ-ṣā-p̄ō-wn", "traducao_palavra": "ao norte" },
        { "hebraico": "תֵּ֔נִי", "transliteral": "tê-nî", "traducao_palavra": "Dá" },
        { "hebraico": "וּלְתֵימָ֖ן", "transliteral": "ū-lə-ṯê-mān", "traducao_palavra": "e ao sul" },
        { "hebraico": "אַל־", "transliteral": "ʾal-", "traducao_palavra": "não" },
        { "hebraico": "תִּכְלָ֑אִי", "transliteral": "tiḵ-lā-ʾî", "traducao_palavra": "retenhas" },
        { "hebraico": "הָבִ֤יאִי", "transliteral": "hā-ḇî-ʾî", "traducao_palavra": "trazei" },
        { "hebraico": "בָנַי֙", "transliteral": "ḇā-nay", "traducao_palavra": "meus filhos" },
        { "hebraico": "מֵרָחֹ֔וק", "transliteral": "mē-rā-ḥō-wq", "traducao_palavra": "de longe" },
        { "hebraico": "וּבְنֹותַ֖י", "transliteral": "ū-ḇə-nō-w-ṯay", "traducao_palavra": "e minhas filhas" },
        { "hebraico": "מִקְצֵ֥ה", "transliteral": "miq-ṣēh", "traducao_palavra": "desde a extremidade de" },
        { "hebraico": "הָאָֽרֶץ׃", "transliteral": "hā-ʾā-reṣ", "traducao_palavra": "a terra." }
      ]
    },
    "7": {
      "traducao_completa": "A todo aquele que é chamado pelo meu nome, e para minha glória o criei, o formei, e também o fiz.",
      "palavras": [
        { "hebraico": "כֹּל֙", "transliteral": "kōl", "traducao_palavra": "Todo aquele" },
        { "hebraico": "הַנִּקְרָ֣א", "transliteral": "han-niq-rā", "traducao_palavra": "que é chamado" },
        { "hebraico": "בִשְׁמִ֔י", "transliteral": "biš-mî", "traducao_palavra": "pelo meu nome" },
        { "hebraico": "וְלִכְבֹודִ֖י", "transliteral": "wə-liḵ-ḇō-w-ḏî", "traducao_palavra": "e para minha glória" },
        { "hebraico": "בְּרָאתִ֑יו", "transliteral": "bə-rā-ṯîw", "traducao_palavra": "o criei" },
        { "hebraico": "יְצַרְתִּ֖יו", "transliteral": "yə-ṣar-tîw", "traducao_palavra": "o formei" },
