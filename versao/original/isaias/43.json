        { "hebraico": "מֹושִׁיעֶ֑ךָ", "transliteral": "mō-w-šî-ʿe-ḵā", "traducao_palavra": "teu Salvador" },
        { "hebraico": "נָתַ֤תִּי", "transliteral": "nā-ṯat-tî", "traducao_palavra": "dei" },
        { "hebraico": "כָפְרְךָ֙", "transliteral": "ḵā-p̄ə-rə-ḵā", "traducao_palavra": "teu resgate" },
        { "hebraico": "מִצְרַ֔יִם", "transliteral": "miṣ-ra-yim", "traducao_palavra": "Egito" },
        { "hebraico": "כּ֥וּשׁ", "transliteral": "kūš", "traducao_palavra": "Etiópia" },
        { "hebraico": "וּסְבָ֖א", "transliteral": "ū-śə-ḇā", "traducao_palavra": "e Sebá" },
        { "hebraico": "תַּחְתֶּֽיךָ׃", "transliteral": "taḥ-te-y-ḵā", "traducao_palavra": "em teu lugar." }
