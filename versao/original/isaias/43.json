      ]
    },
    "8": {
      "traducao_completa": "Trazei o povo cego, que tem olhos, e os surdos, que têm ouvidos.",
      "palavras": [
        { "hebraico": "הֹוצִ֥יא", "transliteral": "hō-w-ṣî", "traducao_palavra": "Trazei/fazei sair" },
        { "hebraico": "עַם־", "transliteral": "ʿam-", "traducao_palavra": "o povo" },
        { "hebraico": "עִוֵּ֖ר", "transliteral": "ʿiw-wēr", "traducao_palavra": "cego" },
        { "hebraico": "וְעֵינַ֣יִם", "transliteral": "wə-ʿê-na-yim", "traducao_palavra": "e olhos" },
        { "hebraico": "יֵ֑שׁ", "transliteral": "yēš", "traducao_palavra": "[que] tem" },
