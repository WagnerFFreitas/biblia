        { "hebraico": "בָהֶם֙", "transliteral": "ḇā-hem", "traducao_palavra": "entre eles" },
        { "hebraico": "יַגִּ֣יד", "transliteral": "yag-gîḏ", "traducao_palavra": "anunciará" },
        { "hebraico": "זֹ֔את", "transliteral": "zōṯ", "traducao_palavra": "isto" },
        { "hebraico": "וְרִאשֹׁנֹ֖ות", "transliteral": "wə-ri-šō-nō-wṯ", "traducao_palavra": "e [as coisas] primeiras" },
        { "hebraico": "יַשְׁמִיעֻ֑נוּ", "transliteral": "yaš-mî-ʿu-nū", "traducao_palavra": "nos farão ouvir" },
        { "hebraico": "יִתְּנ֤וּ", "transliteral": "yit-tə-nū", "traducao_palavra": "apresentem" },
        { "hebraico": "עֵדֵיהֶם֙", "transliteral": "ʿê-ḏê-hem", "traducao_palavra": "as testemunhas deles" },
        { "hebraico": "וְיִצְדָּ֔קוּ", "transliteral": "wə-yiṣ-dā-qū", "traducao_palavra": "para que se justifiquem" },
        { "hebraico": "וְיִשְׁמְע֖וּ", "transliteral": "wə-yiš-mə-ʿū", "traducao_palavra": "e que ouçam" },
        { "hebraico": "וְיֹאמְר֥וּ", "transliteral": "wə-yō-mə-rū", "traducao_palavra": "e digam" },
        { "hebraico": "אֱמֶֽת׃", "transliteral": "ʾĕ-meṯ", "traducao_palavra": "verdade." }
      ]
    },
    "10": {
      "traducao_completa": "Vós sois as minhas testemunhas, diz YHWH, e o meu servo, a quem escolhi; para que saibais, e me creiais, e entendais que eu sou ele; antes de mim Deus nenhum se formou, e depois de mim nenhum haverá.",
      "palavras": [
        { "hebraico": "אַתֶּ֤ם", "transliteral": "ʾat-tem", "traducao_palavra": "Vós [sois]" },
        { "hebraico": "עֵדַי֙", "transliteral": "ʿê-ḏay", "traducao_palavra": "minhas testemunhas" },
        { "hebraico": "נְאֻם־", "transliteral": "nə-ʾum-", "traducao_palavra": "diz/oráculo de" },
        { "hebraico": "יְהוָ֔ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "וְעַבְדִּ֖י", "transliteral": "wə-ʿaḇ-dî", "traducao_palavra": "e meu servo" },
