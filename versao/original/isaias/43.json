{
  "livro": "Isaías - יְשַֽׁעְיָהוּ - Yəšayāhū",
  "capítulo": 43,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "E agora, assim disse YHWH, o teu Criador, ó Jacó, e aquele que te formou, ó Israel: Não temas, porque eu te remi; chamei-te pelo teu nome, tu és meu.",
      "palavras": [
