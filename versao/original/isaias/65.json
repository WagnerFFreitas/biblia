        { "hebraico": "בָּ֛הּ", "transliteral": "bāh", "traducao_palavra": "nela" },
        { "hebraico": "עֹ֥וד", "transliteral": "ʿō-wḏ", "traducao_palavra": "mais" },
        { "hebraico": "קֹ֥ול", "transliteral": "qō-wl", "traducao_palavra": "voz de" },
