        { "hebraico": "תַּשְׁחִיתֵ֑הוּ", "transliteral": "taš-ḥî-ṯê-hū", "traducao_palavra": "destruas ele" },
        { "hebraico": "כִּ֥י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "בְרָכָ֖ה", "transliteral": "ḇə-rā-ḵāh", "traducao_palavra": "[há] bênção" },
        { "hebraico": "בֹּ֑ו", "transliteral": "bō-w", "traducao_palavra": "nele" },
        { "hebraico": "כֵּ֤ן", "transliteral": "kên", "traducao_palavra": "assim" },
        { "hebraico": "אֶעֱשֶׂה֙", "transliteral": "ʾe-ʿĕ-śeh", "traducao_palavra": "farei" },
        { "hebraico": "לְמַ֣עַן", "transliteral": "lə-ma-ʿan", "traducao_palavra": "por causa de" },
        { "hebraico": "עֲבָדַ֔י", "transliteral": "ʿă-ḇā-ḏay", "traducao_palavra": "meus servos" },
        { "hebraico": "לְבִלְתִּ֖י", "transliteral": "lə-ḇil-tî", "traducao_palavra": "para não" },
        { "hebraico": "הַשְׁחִ֥ית", "transliteral": "haš-ḥîṯ", "traducao_palavra": "destruir" },
        { "hebraico": "הַכֹּֽל׃", "transliteral": "hak-kōl", "traducao_palavra": "tudo/todos." }
      ]
    },
    "9": {
      "traducao_completa": "E farei sair de Jacó uma descendência, e de Judá um herdeiro dos meus montes; e os meus escolhidos a herdarão e os meus servos habitarão ali.",
      "palavras": [
        { "hebraico": "וְהֹוצֵאתִ֤י", "transliteral": "wə-hō-w-ṣê-ṯî", "traducao_palavra": "E farei sair" },
        { "hebraico": "מִיַּעֲקֹב֙", "transliteral": "miy-ya-ʿă-qōḇ", "traducao_palavra": "de Jacó" },
        { "hebraico": "זֶ֔רַע", "transliteral": "ze-raʿ", "traducao_palavra": "uma descendência" },
        { "hebraico": "וּמִיהוּדָ֖ה", "transliteral": "ū-mî-hū-ḏāh", "traducao_palavra": "e de Judá" },
        { "hebraico": "יֹורֵ֣שׁ", "transliteral": "yō-w-rêš", "traducao_palavra": "um herdeiro de" },
        { "hebraico": "הָרָ֑י", "transliteral": "hā-rāy", "traducao_palavra": "meus montes" },
        { "hebraico": "וִירֵשׁ֥וּהָ", "transliteral": "wî-rê-šū-hā", "traducao_palavra": "e herdarão ela" },
        { "hebraico": "בְחִירַ֔י", "transliteral": "ḇə-ḥî-ray", "traducao_palavra": "meus escolhidos" },
        { "hebraico": "וַעֲבָדַ֖י", "transliteral": "wa-ʿă-ḇā-ḏay", "traducao_palavra": "e meus servos" },
        { "hebraico": "יִשְׁכְּנוּ־", "transliteral": "yiš-kə-nū-", "traducao_palavra": "habitarão" },
        { "hebraico": "שָֽׁמָּה׃", "transliteral": "šām-māh", "traducao_palavra": "ali." }
      ]
    },
    "10": {
      "traducao_completa": "E Sarom servirá de curral de ovelhas, e o vale de Acor de repouso de gado, para o meu povo que me buscou.",
      "palavras": [
        { "hebraico": "וְהָיָ֨ה", "transliteral": "wə-hā-yāh", "traducao_palavra": "E será" },
        { "hebraico": "הַשָּׁרֹ֤ון", "transliteral": "haš-šā-rō-wn", "traducao_palavra": "Sarom" },
        { "hebraico": "לִנְוֵה־", "transliteral": "lin-wê-", "traducao_palavra": "em pastagem/curral de" },
        { "hebraico": "צֹאן֙", "transliteral": "ṣō-wn", "traducao_palavra": "ovelhas" },
        { "hebraico": "וְעֵ֣מֶק", "transliteral": "wə-ʿē-meq", "traducao_palavra": "e o vale de" },
        { "hebraico": "עָכֹ֔ור", "transliteral": "ʿā-ḵō-wr", "traducao_palavra": "Acor" },
        { "hebraico": "לְרֵ֥בֶץ", "transliteral": "lə-rê-ḇeṣ", "traducao_palavra": "para repouso de" },
        { "hebraico": "בָּקָ֑ר", "transliteral": "bā-qār", "traducao_palavra": "gado" },
        { "hebraico": "לְעַמִּ֖י", "transliteral": "lə-ʿam-mî", "traducao_palavra": "para o meu povo" },
