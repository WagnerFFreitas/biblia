        { "hebraico": "יָמָ֑יו", "transliteral": "yā-māy-w", "traducao_palavra": "seus dias" },
        { "hebraico": "כִּ֣י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "הַנַּ֗עַר", "transliteral": "han-na-ʿar", "traducao_palavra": "o jovem" },
        { "hebraico": "בֶּן־", "transliteral": "ben-", "traducao_palavra": "filho de" },
