{
  "livro": "Isaías - יְשַֽׁעְיָהוּ - Yəšayāhū",
  "capítulo": 65,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Fui buscado pelos que não perguntavam por mim, fui achado pelos que não me buscavam; eu disse: Eis-me aqui, eis-me aqui, a uma nação que não se chamava pelo meu nome.",
      "palavras": [
        { "hebraico": "נִדְרַ֙שְׁתִּי֙", "transliteral": "nid-raš-tî", "traducao_palavra": "Fui buscado" },
        { "hebraico": "לְלֹ֣וא", "transliteral": "lə-lō-w", "traducao_palavra": "por aqueles que não" },
        { "hebraico": "שָׁאָ֔לוּ", "transliteral": "šā-ʾā-lū", "traducao_palavra": "perguntavam" },
        { "hebraico": "נִמְצֵאתִי֙", "transliteral": "nim-ṣê-ṯî", "traducao_palavra": "fui achado" },
        { "hebraico": "לְלֹ֣א", "transliteral": "lə-lō", "traducao_palavra": "por aqueles que não" },
        { "hebraico": "בִקְשֻׁ֑נִי", "transliteral": "ḇiq-šu-nî", "traducao_palavra": "me buscavam" },
        { "hebraico": "אָמַ֙רְתִּי֙", "transliteral": "ʾā-mar-tî", "traducao_palavra": "eu disse" },
        { "hebraico": "הִנֵּ֣נִי", "transliteral": "hin-nê-nî", "traducao_palavra": "Eis-me aqui" },
        { "hebraico": "הִנֵּ֔נִי", "transliteral": "hin-nê-nî", "traducao_palavra": "eis-me aqui" },
        { "hebraico": "אֶל־", "transliteral": "ʾel-", "traducao_palavra": "a" },
        { "hebraico": "גֹּ֖וי", "transliteral": "gō-wy", "traducao_palavra": "uma nação" },
        { "hebraico": "לֹֽא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "קֹרָ֥א", "transliteral": "qō-rā", "traducao_palavra": "chamada" },
        { "hebraico": "בִשְׁמִֽי׃", "transliteral": "biš-mî", "traducao_palavra": "pelo meu nome." }
      ]
    },
    "2": {
      "traducao_completa": "Estendi as minhas mãos todo o dia a um povo rebelde, que anda por caminho que não é bom, após os seus próprios pensamentos;",
      "palavras": [
        { "hebraico": "פֵּרַ֧שְׂתִּי", "transliteral": "pê-raś-tî", "traducao_palavra": "Estendi" },
        { "hebraico": "יָדַ֛י", "transliteral": "yā-ḏay", "traducao_palavra": "minhas mãos" },
        { "hebraico": "כָּל־", "transliteral": "kāl-", "traducao_palavra": "todo" },
        { "hebraico": "הַיֹּ֖ום", "transliteral": "hay-yō-wm", "traducao_palavra": "o dia" },
        { "hebraico": "אֶל־", "transliteral": "ʾel-", "traducao_palavra": "a" },
        { "hebraico": "עַ֣ם", "transliteral": "ʿam", "traducao_palavra": "um povo" },
        { "hebraico": "סֹורֵ֑ר", "transliteral": "śō-w-rēr", "traducao_palavra": "rebelde" },
        { "hebraico": "הַהֹלְכִים֙", "transliteral": "ha-hō-lə-ḵîm", "traducao_palavra": "os que andam" },
        { "hebraico": "הַדֶּ֙רֶךְ֙", "transliteral": "had-de-reḵ", "traducao_palavra": "[por] caminho" },
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "טֹ֔וב", "transliteral": "ṭō-wḇ", "traducao_palavra": "bom" },
        { "hebraico": "אַחַ֖ר", "transliteral": "ʾa-ḥar", "traducao_palavra": "após" },
        { "hebraico": "מַחְשְׁבֹתֵיהֶֽם׃", "transliteral": "maḥ-šə-ḇō-ṯê-hem", "traducao_palavra": "seus pensamentos." }
      ]
    },
    "3": {
      "traducao_completa": "Povo que de contínuo me irrita diante da minha face, sacrificando em jardins e queimando incenso sobre tijolos;",
      "palavras": [
        { "hebraico": "הָעָ֗ם", "transliteral": "hā-ʿām", "traducao_palavra": "O povo" },
        { "hebraico": "הַמַּכְעִיסִ֥ים", "transliteral": "ham-maḵ-ʿî-śîm", "traducao_palavra": "os que provocam ira" },
        { "hebraico": "אֹותִ֛י", "transliteral": "ʾō-w-ṯî", "traducao_palavra": "a mim" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre/perante" },
        { "hebraico": "פָּנַ֖י", "transliteral": "pā-nay", "traducao_palavra": "minha face" },
        { "hebraico": "תָּמִ֑יד", "transliteral": "tā-mîḏ", "traducao_palavra": "continuamente" },
        { "hebraico": "זֹֽבְחִים֙", "transliteral": "zō-ḇə-ḥîm", "traducao_palavra": "sacrificando" },
        { "hebraico": "בַּגַּנֹּ֔ות", "transliteral": "bag-gan-nō-wṯ", "traducao_palavra": "nos jardins" },
        { "hebraico": "וּֽמְקַטְּרִ֖ים", "transliteral": "ū-mə-qaṭ-ṭə-rîm", "traducao_palavra": "e queimando incenso" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre" },
        { "hebraico": "הַלְּבֵנִֽים׃", "transliteral": "hal-lə-ḇê-nîm", "traducao_palavra": "os tijolos." }
      ]
    },
    "4": {
      "traducao_completa": "Que se assentam nos sepulcros, e passam as noites em lugares escondidos; que comem carne de porco, e caldo de coisas abomináveis está nos seus vasos;",
      "palavras": [
        { "hebraico": "הַיֹּֽשְׁבִים֙", "transliteral": "hay-yō-šə-ḇîm", "traducao_palavra": "Os que se assentam" },
        { "hebraico": "בַּקְּבָרִ֔ים", "transliteral": "baq-qə-ḇā-rîm", "traducao_palavra": "nos sepulcros" },
        { "hebraico": "וּבַנְּצוּרִ֖ים", "transliteral": "ū-ḇan-nə-ṣū-rîm", "traducao_palavra": "e nos [lugares] vigiados/escondidos" },
        { "hebraico": "יָלִ֑ינוּ", "transliteral": "yā-lî-nū", "traducao_palavra": "passam a noite" },
        { "hebraico": "הָאֹֽכְלִים֙", "transliteral": "hā-ʾō-ḵə-lîm", "traducao_palavra": "os que comem" },
        { "hebraico": "בְּשַׂ֣ר", "transliteral": "bə-śar", "traducao_palavra": "carne de" },
        { "hebraico": "הַחֲזִ֔יר", "transliteral": "ha-ḥă-zîr", "traducao_palavra": "o porco" },
        { "hebraico": "ופרק", "transliteral": "ū-p̄ə-raq", "traducao_palavra": "e o caldo de [Qere: ū-mə-raq]" },
        { "hebraico": "פִּגֻּלִ֖ים", "transliteral": "pig-gu-lîm", "traducao_palavra": "coisas abomináveis" },
        { "hebraico": "כְּלֵיהֶֽם׃", "transliteral": "kə-lê-hem", "traducao_palavra": "[nos] vasos deles." }
      ]
    },
    "5": {
      "traducao_completa": "Que dizem: Fica onde estás, não te chegues a mim, porque sou mais santo do que tu. Estes são fumaça no meu nariz, um fogo que arde todo o dia.",
      "palavras": [
        { "hebraico": "הָאֹמְרִים֙", "transliteral": "hā-ʾō-mə-rîm", "traducao_palavra": "Os que dizem" },
        { "hebraico": "קְרַ֣ב", "transliteral": "qə-raḇ", "traducao_palavra": "Chega-te" },
        { "hebraico": "אֵלֶ֔יךָ", "transliteral": "ʾê-le-ḵā", "traducao_palavra": "a ti mesmo" },
        { "hebraico": "אַל־", "transliteral": "ʾal-", "traducao_palavra": "não" },
        { "hebraico": "תִּגַּשׁ־", "transliteral": "tig-gaš-", "traducao_palavra": "te aproximes" },
        { "hebraico": "בִּ֔י", "transliteral": "bî", "traducao_palavra": "de mim" },
        { "hebraico": "כִּ֥י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "קְדַשְׁתִּ֖יךָ", "transliteral": "qə-ḏaš-tî-ḵā", "traducao_palavra": "sou mais santo que tu" },
        { "hebraico": "אֵ֚לֶּה", "transliteral": "ʾēl-leh", "traducao_palavra": "estes [são]" },
        { "hebraico": "עָשָׁן֙", "transliteral": "ʿā-šān", "traducao_palavra": "fumaça" },
        { "hebraico": "בְּאַפִּ֔י", "transliteral": "bə-ʾap-pî", "traducao_palavra": "em meu nariz" },
        { "hebraico": "אֵ֥שׁ", "transliteral": "ʾēš", "traducao_palavra": "fogo" },
        { "hebraico": "יֹקֶ֖דֶת", "transliteral": "yō-qe-ḏeṯ", "traducao_palavra": "[que] arde" },
        { "hebraico": "כָּל־", "transliteral": "kāl-", "traducao_palavra": "todo" },
        { "hebraico": "הַיֹּֽום׃", "transliteral": "hay-yō-wm", "traducao_palavra": "o dia." }
      ]
    },
    "6": {
      "traducao_completa": "Eis que está escrito diante de mim: não me calarei; mas eu pagarei, sim, retribuirei no seu seio,",
      "palavras": [
        { "hebraico": "הִנֵּ֥ה", "transliteral": "hin-nēh", "traducao_palavra": "Eis que" },
        { "hebraico": "כְתוּבָ֖ה", "transliteral": "ḵə-ṯū-ḇāh", "traducao_palavra": "[está] escrito" },
        { "hebraico": "לְפָנָ֑י", "transliteral": "lə-p̄ā-nāy", "traducao_palavra": "diante de mim" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "אֶחֱשֶׁ֔ה", "transliteral": "ʾe-ḥĕ-šeh", "traducao_palavra": "me calarei" },
        { "hebraico": "כִּ֥י", "transliteral": "kî", "traducao_palavra": "mas" },
        { "hebraico": "אִם־", "transliteral": "ʾim-", "traducao_palavra": "senão [que]" },
        { "hebraico": "שִׁלַּ֕מְתִּי", "transliteral": "šil-lam-tî", "traducao_palavra": "pagarei" },
        { "hebraico": "וְשִׁלַּמְתִּ֖י", "transliteral": "wə-šil-lam-tî", "traducao_palavra": "e retribuirei" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre" },
        { "hebraico": "חֵיקָֽם׃", "transliteral": "ḥê-qām", "traducao_palavra": "o seio deles." }
      ]
    },
    "7": {
      "traducao_completa": "As vossas iniquidades e juntamente as iniquidades de vossos pais, diz YHWH, que queimaram incenso nos montes, e me afrontaram nos outeiros; por isso lhes tornarei a medir a sua obra antiga no seu seio.",
      "palavras": [
        { "hebraico": "עֲוֹֺנֹתֵיכֶ֧ם", "transliteral": "ʿă-wō-nō-ṯê-ḵem", "traducao_palavra": "As vossas iniquidades" },
        { "hebraico": "וַעֲוֹנֹ֥ת", "transliteral": "wa-ʿă-wō-nōṯ", "traducao_palavra": "e as iniquidades de" },
        { "hebraico": "אֲבֹתֵיכֶ֖ם", "transliteral": "ʾă-ḇō-ṯê-ḵem", "traducao_palavra": "vossos pais" },
        { "hebraico": "יַחְדָּ֑ו", "transliteral": "yaḥ-dāw", "traducao_palavra": "juntamente" },
        { "hebraico": "אָמַ֣ר", "transliteral": "ʾā-mar", "traducao_palavra": "disse" },
        { "hebraico": "יְהוָ֗ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "אֲשֶׁ֤ר", "transliteral": "ʾă-šer", "traducao_palavra": "que" },
        { "hebraico": "קִטְּרוּ֙", "transliteral": "qiṭ-ṭə-rū", "traducao_palavra": "queimaram incenso" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre" },
        { "hebraico": "הֶהָרִ֔ים", "transliteral": "he-hā-rîm", "traducao_palavra": "os montes" },
        { "hebraico": "וְעַל־", "transliteral": "wə-ʿal-", "traducao_palavra": "e sobre" },
        { "hebraico": "הַגְּבָעֹ֖ות", "transliteral": "hag-gə-ḇā-ʿō-wṯ", "traducao_palavra": "os outeiros" },
        { "hebraico": "חֵרְפ֑וּנִי", "transliteral": "ḥê-rə-p̄ū-nî", "traducao_palavra": "me afrontaram" },
        { "hebraico": "וּמַדֹּתִ֧י", "transliteral": "ū-mad-dō-w-ṯî", "traducao_palavra": "e medirei" },
        { "hebraico": "פְעֻלָּתָ֛ם", "transliteral": "p̄ə-ʿul-lā-ṯām", "traducao_palavra": "obra/salário deles" },
        { "hebraico": "רִאשֹׁנָ֖ה", "transliteral": "ri-šō-nāh", "traducao_palavra": "primeira" },
        { "hebraico": "אל־", "transliteral": "ʾel-", "traducao_palavra": "para" },
        { "hebraico": "חֵיקָֽם׃", "transliteral": "ḥê-qām", "traducao_palavra": "o seio deles." }
      ]
    },
    "8": {
      "traducao_completa": "Assim diz YHWH: Como quando se acha mosto num cacho de uvas, e se diz: Não o desperdices, pois há bênção nele, assim farei por amor de meus servos, para que eu não destrua a todos.",
      "palavras": [
        { "hebraico": "כֹּ֣ה ׀", "transliteral": "kōh", "traducao_palavra": "Assim" },
        { "hebraico": "אָמַ֣ר", "transliteral": "ʾā-mar", "traducao_palavra": "disse" },
        { "hebraico": "יְהוָ֗ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "כַּאֲשֶׁ֨ר", "transliteral": "ka-ʾă-šer", "traducao_palavra": "Como" },
        { "hebraico": "יִמָּצֵ֤א", "transliteral": "yim-mā-ṣê", "traducao_palavra": "se acha" },
        { "hebraico": "הַתִּירֹושׁ֙", "transliteral": "hat-tî-rō-wš", "traducao_palavra": "o mosto" },
        { "hebraico": "בָּֽאֶשְׁכֹּ֔ול", "transliteral": "bā-ʾeš-kō-wl", "traducao_palavra": "no cacho" },
        { "hebraico": "וְאָמַ֖ר", "transliteral": "wə-ʾā-mar", "traducao_palavra": "e se diz" },
