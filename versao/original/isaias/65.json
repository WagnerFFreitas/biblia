        { "hebraico": "יְמֵ֣י", "transliteral": "yə-mê", "traducao_palavra": "[serão os] dias de" },
        { "hebraico": "עַמִּ֔י", "transliteral": "ʿam-mî", "traducao_palavra": "meu povo" },
