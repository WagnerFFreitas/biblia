        { "hebraico": "יָמִים֙", "transliteral": "yā-mîm", "traducao_palavra": "dias" },
        { "hebraico": "וְזָקֵ֔ן", "transliteral": "wə-zā-qên", "traducao_palavra": "nem velho" },
        { "hebraico": "אֲשֶׁ֥ר", "transliteral": "ʾă-šer", "traducao_palavra": "que" },
        { "hebraico": "לֹֽא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "יְמַלֵּ֖א", "transliteral": "yə-mal-lē", "traducao_palavra": "cumpra/preencha" },
