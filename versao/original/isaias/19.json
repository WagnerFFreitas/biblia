        { "hebraico": "קַ֣ל", "transliteral": "qal", "traducao_palavra": "ligeira" },
        { "hebraico": "וּבָ֣א", "transliteral": "ū-ḇāʾ", "traducao_palavra": "e vem ao" },
        { "hebraico": "מִצְרַ֗יִם", "transliteral": "miṣ-ra-yim", "traducao_palavra": "Egito" },
        { "hebraico": "וְנָע֞וּ", "transliteral": "wə-nā-ʿû", "traducao_palavra": "e tremerão" },
        { "hebraico": "אֱלִילֵ֤י", "transliteral": "ʾĕ-lî-lê", "traducao_palavra": "os ídolos de" },
        { "hebraico": "מִצְרַ֨יִם֙", "transliteral": "miṣ-ra-yim", "traducao_palavra": "Egito" },
        { "hebraico": "מִפָּנָ֔יו", "transliteral": "mip-pā-nāyw", "traducao_palavra": "diante dele" },
        { "hebraico": "וּלְבַ֥ב", "transliteral": "ū-lə-ḇaḇ", "traducao_palavra": "e o coração de" },
        { "hebraico": "מִצְרַ֖יִם", "transliteral": "miṣ-ra-yim", "traducao_palavra": "Egito" },
