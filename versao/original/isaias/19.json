  "versiculos": {
    "1": {
      "traducao_completa": "Oráculo contra o Egito: Eis que YHWH, cavalgando sobre uma nuvem ligeira, vem ao Egito; e os ídolos do Egito tremerão diante dele, e o coração do Egito se derreterá no meio dele.",
      "palavras": [
        { "hebraico": "מַשָּׂ֖א", "transliteral": "maś-śāʾ", "traducao_palavra": "Oráculo/peso" },
        { "hebraico": "מִצְרָ֑יִם", "transliteral": "miṣ-ra-yim", "traducao_palavra": "Egito" },
        { "hebraico": "הִנֵּ֨ה", "transliteral": "hin-nēh", "traducao_palavra": "Eis que" },
        { "hebraico": "יְהוָ֜ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
