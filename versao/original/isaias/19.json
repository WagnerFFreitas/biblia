        { "hebraico": "בְּקִרְבֹּֽו׃", "transliteral": "bə-qir-bô", "traducao_palavra": "no seu interior" }
      ]
    },
    "2": {
      "traducao_completa": "E incitarei egípcios contra egípcios, e cada um pelejará contra o seu irmão, e cada um contra o seu próximo, cidade contra cidade, reino contra reino.",
      "palavras": [
        { "hebraico": "וְסִכְסַכְתִּ֤י", "transliteral": "wə-śiḵ-śaḵ-tî", "traducao_palavra": "E incitarei/armarei" },
        { "hebraico": "מִצְרַ֨יִם֙", "transliteral": "miṣ-ra-yim", "traducao_palavra": "egípcios" },
        { "hebraico": "בְּמִצְרַ֔יִם", "transliteral": "bə-miṣ-ra-yim", "traducao_palavra": "contra egípcios" },
        { "hebraico": "וְנִלְחֲמ֥וּ", "transliteral": "wə-nil-ḥă-mû", "traducao_palavra": "e pelejarão" },
        { "hebraico": "אִישׁ־בְּאָחִ֖יו", "transliteral": "ʾîš-bə-ʾā-ḥîw", "traducao_palavra": "cada um contra seu irmão" },
        { "hebraico": "וְאִ֣ישׁ", "transliteral": "wə-ʾîš", "traducao_palavra": "e cada um" },
        { "hebraico": "בְּרֵעֵ֑הוּ", "transliteral": "bə-rê-ʿê-hû", "traducao_palavra": "contra seu próximo" },
        { "hebraico": "עִ֣יר", "transliteral": "ʿîr", "traducao_palavra": "cidade" },
        { "hebraico": "בְּעִ֔יר", "transliteral": "bə-ʿîr", "traducao_palavra": "contra cidade" },
        { "hebraico": "מַמְלָכָ֖ה", "transliteral": "mam-lā-ḵā", "traducao_palavra": "reino" },
        { "hebraico": "בְּמַמְלָכָֽה׃", "transliteral": "bə-mam-lā-ḵā", "traducao_palavra": "contra reino" }
      ]
    },
    "3": {
      "traducao_completa": "E o espírito do Egito se esvairá no seu interior, e destruirei o seu conselho; e eles consultarão os ídolos, e os encantadores, e os necromantes, e os adivinhos.",
      "palavras": [
        { "hebraico": "וְנָבְקָ֥ה", "transliteral": "wə-nā-ḇə-qā", "traducao_palavra": "E se esvairá/ficará vazia" },
        { "hebraico": "רֽוּחַ־מִצְרַ֖יִם", "transliteral": "rû-aḥ-miṣ-ra-yim", "traducao_palavra": "o espírito do Egito" },
        { "hebraico": "בְּקִרְבֹּ֑ו", "transliteral": "bə-qir-bô", "traducao_palavra": "no seu interior" },
        { "hebraico": "וַעֲצָתֹ֖ו", "transliteral": "wa-ʿă-ṣā-ṯô", "traducao_palavra": "e o seu conselho" },
        { "hebraico": "אֲבַלֵּ֑עַ", "transliteral": "ʾă-ḇal-lē-aʿ", "traducao_palavra": "confundirei/engolirei" },
        { "hebraico": "וְדָרְשׁ֤וּ", "transliteral": "wə-ḏā-rə-šû", "traducao_palavra": "e consultarão" },
        { "hebraico": "אֶל־הָאֱלִילִים֙", "transliteral": "ʾel-hā-ʾĕ-lî-lîm", "traducao_palavra": "aos ídolos" },
        { "hebraico": "וְאֶל־הָאִטִּ֔ים", "transliteral": "wə-ʾel-hā-ʾiṭ-ṭîm", "traducao_palavra": "e aos feiticeiros/encantadores" },
        { "hebraico": "וְאֶל־הָאֹבֹ֖ות", "transliteral": "wə-ʾel-hā-ʾō-ḇôṯ", "traducao_palavra": "e aos necromantes" },
        { "hebraico": "וְאֶל־הַיִּדְּעֹנִֽים׃", "transliteral": "wə-ʾel-hay-yid-də-ʿō-nîm", "traducao_palavra": "e aos adivinhos" }
      ]
    },
    "4": {
      "traducao_completa": "E entregarei os egípcios nas mãos de um senhor duro, e um rei rigoroso dominará sobre eles, diz o Senhor, YHWH dos Exércitos.",
      "palavras": [
        { "hebraico": "וְסִכַּרְתִּ֥י", "transliteral": "wə-śik-kar-tî", "traducao_palavra": "E entregarei/fecharei" },
        { "hebraico": "אֶת־מִצְרַ֖יִם", "transliteral": "ʾeṯ-miṣ-ra-yim", "traducao_palavra": "[objeto] os egípcios" },
        { "hebraico": "בְּיַ֣ד", "transliteral": "bə-yaḏ", "traducao_palavra": "na mão de" },
        { "hebraico": "אֲדֹנִ֣ים", "transliteral": "ʾă-ḏō-nîm", "traducao_palavra": "senhores" },
        { "hebraico": "קָשֶׁ֑ה", "transliteral": "qā-šeh", "traducao_palavra": "duros" },
        { "hebraico": "וּמֶ֤לֶךְ", "transliteral": "ū-me-leḵ", "traducao_palavra": "e um rei" },
        { "hebraico": "עַז֙", "transliteral": "ʿaz", "traducao_palavra": "forte/feroz" },
        { "hebraico": "יִמְשָׁל־בָּ֔ם", "transliteral": "yim-šāl-bām", "traducao_palavra": "dominará sobre eles" },
        { "hebraico": "נְאֻ֥ם", "transliteral": "nə-ʾum", "traducao_palavra": "declaração de" },
        { "hebraico": "הָאָדֹ֖ון", "transliteral": "hā-ʾā-ḏôn", "traducao_palavra": "o Senhor" },
        { "hebraico": "יְהוָ֥ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "צְבָאֹֽות׃", "transliteral": "ṣə-ḇā-ʾôṯ", "traducao_palavra": "Exércitos" }
      ]
    },
    "5": {
      "traducao_completa": "E as águas do mar minguarão, e o rio se esgotará e se secará.",
      "palavras": [
        { "hebraico": "וְנִשְּׁתוּ־", "transliteral": "wə-niš-šə-ṯû-", "traducao_palavra": "E secarão/faltarão" },
        { "hebraico": "מַ֖יִם", "transliteral": "ma-yim", "traducao_palavra": "águas" },
        { "hebraico": "מֵהַיָּ֑ם", "transliteral": "mê-hay-yām", "traducao_palavra": "do mar" },
        { "hebraico": "וְנָהָ֖ר", "transliteral": "wə-nā-hār", "traducao_palavra": "e o rio [Nilo]" },
        { "hebraico": "יֶחֱרַ֥ב", "transliteral": "ye-ḥĕ-raḇ", "traducao_palavra": "será devastado" },
        { "hebraico": "וְיָבֵֽשׁ׃", "transliteral": "wə-yā-ḇêš", "traducao_palavra": "e secará" }
      ]
    },
    "6": {
      "traducao_completa": "E os rios exalarão mau cheiro; os canais do Egito se esvairão e se secarão; a cana e o junco murcharão.",
      "palavras": [
        { "hebraico": "וְהֶאֶזְנִ֣יחוּ", "transliteral": "wə-he-ʾez-nî-ḥû", "traducao_palavra": "E cheirarão mal" },
        { "hebraico": "נְהָרֹ֗ות", "transliteral": "nə-hā-rôṯ", "traducao_palavra": "rios" },
        { "hebraico": "דָּלֲל֧וּ", "transliteral": "dā-lă-lû", "traducao_palavra": "minguarão" },
        { "hebraico": "וְחָרְב֛וּ", "transliteral": "wə-ḥā-rə-ḇû", "traducao_palavra": "e secarão" },
        { "hebraico": "יְאֹרֵ֥י", "transliteral": "yə-ʾō-rê", "traducao_palavra": "os braços do rio de" },
        { "hebraico": "מָצֹ֑ור", "transliteral": "mā-ṣôr", "traducao_palavra": "Egito/aperto" },
        { "hebraico": "קָנֶ֥ה", "transliteral": "qā-neh", "traducao_palavra": "[a] cana" },
        { "hebraico": "וָס֖וּף", "transliteral": "wā-sûp̄", "traducao_palavra": "e o junco" },
        { "hebraico": "קָמֵֽלוּ׃", "transliteral": "qā-mê-lû", "traducao_palavra": "murcharão" }
      ]
    },
    "7": {
      "traducao_completa": "A relva junto ao rio, junto à margem do rio, e tudo o que foi semeado junto ao rio, se secará, será arrancado, e não existirá mais.",
      "palavras": [
        { "hebraico": "עָרֹות֙", "transliteral": "ʿā-rôṯ", "traducao_palavra": "Lugares descobertos/relva" },
        { "hebraico": "עַל־יְאֹ֔ר", "transliteral": "ʿal-yə-ʾôr", "traducao_palavra": "junto ao rio [Nilo]" },
        { "hebraico": "עַל־פִּ֖י", "transliteral": "ʿal-pî", "traducao_palavra": "à beira/margem de" },
        { "hebraico": "יְאֹ֑ר", "transliteral": "yə-ʾôr", "traducao_palavra": "rio" },
        { "hebraico": "וְכֹל֙", "transliteral": "wə-ḵōl", "traducao_palavra": "e tudo" },
        { "hebraico": "מִזְרַ֣ע", "transliteral": "miz-raʿ", "traducao_palavra": "[o] semeado de" },
        { "hebraico": "יְאֹ֔ר", "transliteral": "yə-ʾôr", "traducao_palavra": "rio" },
        { "hebraico": "יִיבַ֥שׁ", "transliteral": "yî-ḇaš", "traducao_palavra": "secará" },
        { "hebraico": "נִדַּ֖ף", "transliteral": "nid-dāp̄", "traducao_palavra": "será soprado/arrancado" },
        { "hebraico": "וְאֵינֶֽנּוּ׃", "transliteral": "wə-ʾê-nen-nû", "traducao_palavra": "e não [será] mais" }
      ]
    },
    "8": {
      "traducao_completa": "E os pescadores gemerão, e carpirão todos os que lançam anzol no rio, e os que estendem rede sobre as águas desfalecerão.",
      "palavras": [
        { "hebraico": "וְאָנ֨וּ", "transliteral": "wə-ʾā-nû", "traducao_palavra": "E gemerão" },
        { "hebraico": "הַדַּגָּיִ֔ם", "transliteral": "had-dag-gā-yîm", "traducao_palavra": "os pescadores" },
        { "hebraico": "וְאָבְל֕וּ", "transliteral": "wə-ʾā-ḇə-lû", "traducao_palavra": "e carpirão/lamentarão" },
        { "hebraico": "כָּל־מַשְׁלִיכֵ֥י", "transliteral": "kāl-maš-lî-ḵê", "traducao_palavra": "todos os que lançam" },
        { "hebraico": "בַיְאֹ֖ור", "transliteral": "ḇay-yə-ʾôr", "traducao_palavra": "no rio" },
        { "hebraico": "חַכָּ֑ה", "transliteral": "ḥak-kā", "traducao_palavra": "anzol" },
        { "hebraico": "וּפֹרְשֵׂ֥י", "transliteral": "ū-p̄ō-rə-śê", "traducao_palavra": "e os que estendem" },
        { "hebraico": "מִכְמֹ֛רֶת", "transliteral": "miḵ-mō-reṯ", "traducao_palavra": "rede" },
        { "hebraico": "עַל־פְּנֵי־מַ֖יִם", "transliteral": "ʿal-pə-nê-ma-yim", "traducao_palavra": "sobre a face das águas" },
        { "hebraico": "אֻמְלָֽלוּ׃", "transliteral": "ʾum-lā-lû", "traducao_palavra": "desfalecerão" }
      ]
    },
    "9": {
      "traducao_completa": "E os que trabalham em linho fino, e os que tecem redes, envergonhar-se-ão.",
      "palavras": [
        { "hebraico": "וּבֹ֖שׁוּ", "transliteral": "ū-ḇō-šû", "traducao_palavra": "E envergonhar-se-ão" },
        { "hebraico": "עֹבְדֵ֣י", "transliteral": "ʿō-ḇə-ḏê", "traducao_palavra": "trabalhadores de" },
        { "hebraico": "פִשְׁתִּ֣ים", "transliteral": "p̄iš-tîm", "traducao_palavra": "linhos" },
        { "hebraico": "שְׂרִיקֹ֑ות", "transliteral": "śə-rî-qôṯ", "traducao_palavra": "penteados/cardados" },
        { "hebraico": "וְאֹרְגִ֖ים", "transliteral": "wə-ʾō-rə-ḡîm", "traducao_palavra": "e tecelões de" },
        { "hebraico": "חֹורָֽי׃", "transliteral": "ḥô-rāy", "traducao_palavra": "pano branco/redes" }
      ]
    },
    "10": {
      "traducao_completa": "Porque os seus fundamentos serão despedaçados; e todos os que trabalham por salário ficarão de alma angustiada.",
      "palavras": [
        { "hebraico": "וְהָי֥וּ", "transliteral": "wə-hā-yû", "traducao_palavra": "E serão" },
        { "hebraico": "שָׁתֹתֶ֖יהָ", "transliteral": "šā-ṯō-ṯê-hā", "traducao_palavra": "seus pilares/fundamentos" },
        { "hebraico": "מְדֻכָּאִ֑ים", "transliteral": "mə-ḏuk-kā-ʾîm", "traducao_palavra": "esmagados/despedaçados" },
        { "hebraico": "כָּל־עֹ֥שֵׂי", "transliteral": "kāl-ʿō-śê", "traducao_palavra": "todos os que fazem" },
        { "hebraico": "שֶׂ֖כֶר", "transliteral": "śe-ḵer", "traducao_palavra": "salário" },
        { "hebraico": "אַגְמֵי־", "transliteral": "ʾaḡ-mê-", "traducao_palavra": "tristes de" },
        { "hebraico": "נָֽפֶשׁ׃", "transliteral": "nā-p̄eš", "traducao_palavra": "alma" }
      ]
    },
    "11": {
      "traducao_completa": "Na verdade são estultos os príncipes de Zoã; o conselho dos mais sábios conselheiros de Faraó se embruteceu; como direis a Faraó: Sou filho de sábios, filho de antigos reis?",
      "palavras": [
        { "hebraico": "אַךְ־אֱוִילִים֙", "transliteral": "ʾaḵ-ʾĕ-wî-lîm", "traducao_palavra": "Certamente estultos [são]" },
        { "hebraico": "שָׂ֣רֵי", "transliteral": "śā-rê", "traducao_palavra": "os príncipes de" },
        { "hebraico": "צֹ֔עַן", "transliteral": "ṣō-ʿan", "traducao_palavra": "Zoã" },
        { "hebraico": "חַכְמֵי֙", "transliteral": "ḥaḵ-mê", "traducao_palavra": "[o conselho dos] sábios" },
        { "hebraico": "יֹועֲצֵ֣י", "transliteral": "yô-ʿă-ṣê", "traducao_palavra": "conselheiros de" },
        { "hebraico": "פַרְעֹ֔ה", "transliteral": "p̄ar-ʿōh", "traducao_palavra": "Faraó" },
        { "hebraico": "עֵצָ֖ה", "transliteral": "ʿê-ṣā", "traducao_palavra": "conselho" },
        { "hebraico": "נִבְעָרָ֑ה", "transliteral": "niḇ-ʿā-rā", "traducao_palavra": "se embruteceu" },
        { "hebraico": "אֵ֚יךְ", "transliteral": "ʾêḵ", "traducao_palavra": "Como" },
        { "hebraico": "תֹּאמְר֣וּ", "transliteral": "ṯō-mə-rû", "traducao_palavra": "direis" },
        { "hebraico": "אֶל־פַּרְעֹ֔ה", "transliteral": "ʾel-p̄ar-ʿōh", "traducao_palavra": "a Faraó" },
        { "hebraico": "בֶּן־חֲכָמִ֣ים", "transliteral": "ben-ḥă-ḵā-mîm", "traducao_palavra": "Filho de sábios" },
        { "hebraico": "אֲנִ֔י", "transliteral": "ʾă-nî", "traducao_palavra": "[sou] eu" },
        { "hebraico": "בֶּן־מַלְכֵי־", "transliteral": "ben-mal-ḵê-", "traducao_palavra": "filho de reis" },
        { "hebraico": "קֶֽדֶם׃", "transliteral": "qe-ḏem", "traducao_palavra": "antigos" }
      ]
    },
    "12": {
      "traducao_completa": "Onde estão agora os teus sábios? Declarem-te agora, ou saibam o que YHWH dos Exércitos determinou contra o Egito.",
      "palavras": [
        { "hebraico": "אַיָּ֣ם", "transliteral": "ʾay-yām", "traducao_palavra": "Onde [estão]" },
        { "hebraico": "אֵפֹ֔וא", "transliteral": "ʾê-p̄ô", "traducao_palavra": "agora" },
        { "hebraico": "חֲכָמֶ֑יךָ", "transliteral": "ḥă-ḵā-me-ḵā", "traducao_palavra": "teus sábios?" },
        { "hebraico": "וְיַגִּ֤ידוּ", "transliteral": "wə-yag-gî-ḏû", "traducao_palavra": "que digam" },
        { "hebraico": "נָא֙", "transliteral": "nā", "traducao_palavra": "agora" },
