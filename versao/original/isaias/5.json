    "29": {
      "traducao_completa": "O seu rugido é como o do leão; rugirão como leõezinhos; rugirão e pegarão a presa, e a levarão, e não haverá quem a livre.",
      "palavras": [
        { "hebraico": "שְׁאָגָ֥ה", "transliteral": "šə-ʾā-ḡā", "traducao_palavra": "[O] rugido" },
        { "hebraico": "לֹ֖ו", "transliteral": "lô", "traducao_palavra": "dele [é]" },
        { "hebraico": "כַּלָּבִ֑יא", "transliteral": "kal-lā-ḇî", "traducao_palavra": "como o de leão" },
        { "hebraico": "וְשָׁאַ֨ג", "transliteral": "wə-šā-ʾaḡ", "traducao_palavra": "e rugirá" },
        { "hebraico": "כַּכְּפִירִ֤ים", "transliteral": "kak-kə-p̄î-rîm", "traducao_palavra": "como leõezinhos" },
        { "hebraico": "וְיִנְהֹם֙", "transliteral": "wə-yin-hōm", "traducao_palavra": "e bramará" },
        { "hebraico": "וְיֹאחֵ֣ז", "transliteral": "wə-yō-ḥēz", "traducao_palavra": "e pegará" },
        { "hebraico": "טֶ֔רֶף", "transliteral": "ṭe-rep̄", "traducao_palavra": "[a] presa" },
        { "hebraico": "וְיַפְלִ֖יט", "transliteral": "wə-yap̄-lîṭ", "traducao_palavra": "e a levará a salvo [para si]" },
        { "hebraico": "וְאֵ֥ין", "transliteral": "wə-ʾên", "traducao_palavra": "e não haverá" },
        { "hebraico": "מַצִּֽיל׃", "transliteral": "maṣ-ṣîl", "traducao_palavra": "quem a livre" }
      ]
    },
    "30": {
      "traducao_completa": "E bramarão contra eles naquele dia, como o bramido do mar; e, se alguém olhar para a terra, eis que haverá trevas e angústia, e a luz se escurecerá em suas nuvens.",
      "palavras": [
        { "hebraico": "וְיִנְהֹ֥ם", "transliteral": "wə-yin-hōm", "traducao_palavra": "E bramará" },
        { "hebraico": "עָלָ֛יו", "transliteral": "ʿā-lāyw", "traducao_palavra": "contra ele" },
        { "hebraico": "בַּיֹּ֥ום", "transliteral": "bay-yôm", "traducao_palavra": "no dia" },
        { "hebraico": "הַה֖וּא", "transliteral": "ha-hû", "traducao_palavra": "aquele" },
        { "hebraico": "כְּנַהֲמַת־יָ֑ם", "transliteral": "kə-na-hă-maṯ-yām", "traducao_palavra": "como o bramido do mar" },
        { "hebraico": "וְנִבַּ֤ט", "transliteral": "wə-nib-baṭ", "traducao_palavra": "e se olhar" },
        { "hebraico": "לָאָ֨רֶץ֙", "transliteral": "lā-ʾā-reṣ", "traducao_palavra": "para a terra" },
        { "hebraico": "וְהִנֵּה־חֹ֔שֶׁךְ", "transliteral": "wə-hin-nē-ḥō-šeḵ", "traducao_palavra": "eis que [haverá] trevas" },
        { "hebraico": "צַ֣ר", "transliteral": "ṣar", "traducao_palavra": "[e] angústia" },
        { "hebraico": "וָאֹ֔ור", "transliteral": "wā-ʾôr", "traducao_palavra": "e a luz" },
        { "hebraico": "חָשַׁ֖ךְ", "transliteral": "ḥā-šaḵ", "traducao_palavra": "se escurecerá" },
        { "hebraico": "בַּעֲרִיפֶֽיהָ׃", "transliteral": "ba-ʿă-rî-p̄e-hā", "traducao_palavra": "em suas nuvens/névoas" }
