        { "hebraico": "יָבֹֽוא׃", "transliteral": "yā-ḇô", "traducao_palavra": "virá" }
      ]
    },
    "27": {
      "traducao_completa": "Não haverá entre eles cansado, nem quem tropece; ninguém tosquenejará nem dormirá; não se lhe desatará o cinto dos seus lombos, nem se lhe quebrará a correia das suas sandálias.",
      "palavras": [
        { "hebraico": "אֵין־עָיֵ֤ף", "transliteral": "ʾên-ʿā-yêp̄", "traducao_palavra": "Não há cansado" },
        { "hebraico": "וְאֵין־כֹּושֵׁל֙", "transliteral": "wə-ʾên-kô-šêl", "traducao_palavra": "nem quem tropece" },
        { "hebraico": "בֹּ֔ו", "transliteral": "bô", "traducao_palavra": "nele" },
        { "hebraico": "לֹ֥א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "יָנ֖וּם", "transliteral": "yā-nûm", "traducao_palavra": "cochilara" },
        { "hebraico": "וְלֹ֣א", "transliteral": "wə-lō", "traducao_palavra": "nem" },
        { "hebraico": "יִישָׁ֑ן", "transliteral": "yî-šān", "traducao_palavra": "dormirá" },
        { "hebraico": "וְלֹֽא־פִתַּח֙", "transliteral": "wə-lō-p̄it-taḥ", "traducao_palavra": "não se abrirá" },
        { "hebraico": "אֵזֹ֣ור", "transliteral": "ʾê-zôr", "traducao_palavra": "[o] cinto de" },
        { "hebraico": "חֲלָצָ֔יו", "transliteral": "ḥă-lā-ṣāyw", "traducao_palavra": "seus lombos" },
        { "hebraico": "וְלֹ֥א", "transliteral": "wə-lō", "traducao_palavra": "nem" },
        { "hebraico": "נִתַּ֖ק", "transliteral": "nit-taq", "traducao_palavra": "se quebrará" },
        { "hebraico": "שְׂרֹ֥וךְ", "transliteral": "śə-rôḵ", "traducao_palavra": "correia de" },
        { "hebraico": "נְעָלָֽיו׃", "transliteral": "nə-ʿā-lāyw", "traducao_palavra": "suas sandálias" }
