    "26": {
      "traducao_completa": "E ele arvorará um estandarte para as nações de longe, e lhes assobiará desde a extremidade da terra; e eis que virão apressada e ligeiramente.",
      "palavras": [
        { "hebraico": "וְנָֽׂשָׂא־נֵ֣ס", "transliteral": "wə-nā-śā-nêś", "traducao_palavra": "E levantará estandarte" },
        { "hebraico": "לַגֹּויִ֣ם", "transliteral": "lag-gô-yim", "traducao_palavra": "para as nações" },
        { "hebraico": "מֵרָחֹ֔וק", "transliteral": "mê-rā-ḥôq", "traducao_palavra": "de longe" },
        { "hebraico": "וְשָׁ֥רַק", "transliteral": "wə-šā-raq", "traducao_palavra": "e assobiará" },
