        { "hebraico": "כַּרְמִֽי׃", "transliteral": "kar-mî", "traducao_palavra": "minha vinha" }
      ]
    },
    "4": {
      "traducao_completa": "Que mais se podia fazer à minha vinha, que eu lhe não tenha feito? Por que, esperando eu que desse uvas, veio a produzir uvas bravas?",
      "palavras": [
        { "hebraico": "מַה־לַּעֲשֹׂ֥ות", "transliteral": "mah-la-ʿă-śôṯ", "traducao_palavra": "O que fazer" },
        { "hebraico": "עֹ֖וד", "transliteral": "ʿôḏ", "traducao_palavra": "mais" },
        { "hebraico": "לְכַרְמִ֑י", "transliteral": "lə-ḵar-mî", "traducao_palavra": "pela minha vinha" },
        { "hebraico": "וְלֹ֥א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "עָשִׂ֖יתִי", "transliteral": "ʿā-śî-ṯî", "traducao_palavra": "[eu] fiz" },
        { "hebraico": "בֹּ֑ו", "transliteral": "bô", "traducao_palavra": "nela?" },
        { "hebraico": "מַדּ֧וּעַ", "transliteral": "mad-dû-aʿ", "traducao_palavra": "por que" },
        { "hebraico": "קִוֵּ֛יתִי", "transliteral": "qiw-wê-ṯî", "traducao_palavra": "esperei" },
        { "hebraico": "לַעֲשֹׂ֥ות", "transliteral": "la-ʿă-śôṯ", "traducao_palavra": "para produzir" },
        { "hebraico": "עֲנָבִ֖ים", "transliteral": "ʿă-nā-ḇîm", "traducao_palavra": "uvas" },
        { "hebraico": "וַיַּ֥עַשׂ", "transliteral": "way-ya-ʿaś", "traducao_palavra": "e produziu" },
        { "hebraico": "בְּאֻשִֽׁים׃", "transliteral": "bə-ʾu-šîm", "traducao_palavra": "uvas bravas?" }
      ]
    },
    "5": {
      "traducao_completa": "Agora, pois, vos farei saber o que eu hei de fazer à minha vinha: tirarei a sua sebe, para que sirva de pasto; derrubarei a sua parede, para que seja pisada;",
      "palavras": [
