        { "hebraico": "וְאִ֣ישׁ", "transliteral": "wə-ʾîš", "traducao_palavra": "e homem de" },
        { "hebraico": "יְהוּדָ֔ה", "transliteral": "yə-hû-ḏā", "traducao_palavra": "Judá" },
        { "hebraico": "שִׁפְטוּ־", "transliteral": "šip̄-ṭû-", "traducao_palavra": "julgai" },
