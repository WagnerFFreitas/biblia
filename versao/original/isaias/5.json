        { "hebraico": "יִֽהְיֶ֔ה", "transliteral": "yih-yeh", "traducao_palavra": "será" },
        { "hebraico": "וּפִרְחָ֖ם", "transliteral": "ū-p̄ir-ḥām", "traducao_palavra": "e a flor deles" },
