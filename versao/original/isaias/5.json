        { "hebraico": "נָּא", "transliteral": "nā", "traducao_palavra": "agora" },
        { "hebraico": "לִֽידִידִי", "transliteral": "lî-ḏî-ḏî", "traducao_palavra": "ao meu amado" },
        { "hebraico": "שִׁירַ֥ת", "transliteral": "šî-raṯ", "traducao_palavra": "[o] cântico de" },
        { "hebraico": "דֹּודִ֖י", "transliteral": "dô-ḏî", "traducao_palavra": "meu querido/amado" },
        { "hebraico": "לְכַרְמֹ֑ו", "transliteral": "lə-ḵar-mô", "traducao_palavra": "a respeito da sua vinha" },
        { "hebraico": "כֶּ֛רֶם", "transliteral": "ke-rem", "traducao_palavra": "[Uma] vinha" },
        { "hebraico": "הָיָ֥ה", "transliteral": "hā-yā", "traducao_palavra": "havia/teve" },
        { "hebraico": "לִֽידִידִ֖י", "transliteral": "lî-ḏî-ḏî", "traducao_palavra": "para o meu amado" },
        { "hebraico": "בְּקֶ֥רֶן", "transliteral": "bə-qe-ren", "traducao_palavra": "num cume/outeiro" },
        { "hebraico": "בֶּן־שָֽׁמֶן׃", "transliteral": "ben-šā-men", "traducao_palavra": "filho de óleo [fértil]" }
      ]
    },
    "2": {
      "traducao_completa": "E a cercou, e a limpou das pedras, e a plantou de excelentes vides; e edificou no meio dela uma torre, e também construiu nela um lagar; e esperava que desse uvas, mas deu uvas bravas.",
