    },
    "28": {
      "traducao_completa": "As suas flechas são agudas, e todos os seus arcos entesados; os cascos dos seus cavalos são reputados como pederneira, e as suas rodas como redemoinho.",
      "palavras": [
        { "hebraico": "אֲשֶׁ֤ר", "transliteral": "ʾă-šer", "traducao_palavra": "Cujas" },
        { "hebraico": "חִצָּיו֙", "transliteral": "ḥiṣ-ṣāyw", "traducao_palavra": "suas flechas" },
        { "hebraico": "שְׁנוּנִ֔ים", "transliteral": "šə-nû-nîm", "traducao_palavra": "[são] agudas" },
        { "hebraico": "וְכָל־קַשְּׁתֹתָ֖יו", "transliteral": "wə-ḵāl-qaš-šə-ṯō-ṯāyw", "traducao_palavra": "e todos os seus arcos" },
        { "hebraico": "דְּרֻכֹ֑ות", "transliteral": "də-ru-ḵôṯ", "traducao_palavra": "armados/entesados" },
        { "hebraico": "פַּרְסֹ֨ות", "transliteral": "par-śôṯ", "traducao_palavra": "os cascos de" },
        { "hebraico": "סוּסָ֜יו", "transliteral": "śû-śāyw", "traducao_palavra": "seus cavalos" },
        { "hebraico": "כַּצַּ֣ר", "transliteral": "kaṣ-ṣar", "traducao_palavra": "como pederneira/pedra" },
        { "hebraico": "נֶחְשָׁ֗ḇוּ", "transliteral": "neḥ-šā-ḇû", "traducao_palavra": "são considerados" },
        { "hebraico": "וְגַלְגִּלָּ֥יו", "transliteral": "wə-ḡal-gil-lāyw", "traducao_palavra": "e suas rodas" },
        { "hebraico": "כַּסּוּפָֽה׃", "transliteral": "kas-sû-p̄ā", "traducao_palavra": "como redemoinho" }
