        { "hebraico": "בְּעַמֹּ֗ו", "transliteral": "bə-ʿam-mô", "traducao_palavra": "contra seu povo" },
        { "hebraico": "וַיֵּ֨ט", "transliteral": "way-yêṭ", "traducao_palavra": "e estendeu" },
        { "hebraico": "יָדֹ֤ו", "transliteral": "yā-ḏô", "traducao_palavra": "sua mão" },
        { "hebraico": "עָלָיו֙", "transliteral": "ʿā-lāyw", "traducao_palavra": "sobre ele" },
        { "hebraico": "וַיַּכֵּ֔הוּ", "transliteral": "way-yak-kê-hû", "traducao_palavra": "e feriu-o" },
        { "hebraico": "וַֽיִּרְגְּז֖וּ", "transliteral": "way-yir-gə-zû", "traducao_palavra": "e tremeram" },
        { "hebraico": "הֶהָרִ֑ים", "transliteral": "he-hā-rîm", "traducao_palavra": "os montes" },
        { "hebraico": "וַתְּהִ֨י", "transliteral": "wat-tə-hî", "traducao_palavra": "e foram" },
        { "hebraico": "נִבְלָתָ֜ם", "transliteral": "niḇ-lā-ṯām", "traducao_palavra": "cadáveres deles" },
        { "hebraico": "כַּסּוּחָה֙", "transliteral": "kas-sû-ḥā", "traducao_palavra": "como lixo" },
        { "hebraico": "בְּקֶ֣רֶב", "transliteral": "bə-qe-reb", "traducao_palavra": "no meio de" },
        { "hebraico": "חוּצֹֹות֙", "transliteral": "ḥû-ṣôṯ", "traducao_palavra": "ruas" },
