    "7": {
      "traducao_completa": "Os seus pés correm para o mal, e se apressam para derramar o sangue inocente; os seus pensamentos são pensamentos de iniquidade; destruição e quebrantamento há nas suas estradas.",
      "palavras": [
        { "hebraico": "רַגְלֵיהֶם֙", "transliteral": "raḡ-lê-hem", "traducao_palavra": "Seus pés" },
        { "hebraico": "לָרַ֣ע", "transliteral": "lā-ra-ʿ", "traducao_palavra": "para o mal" },
        { "hebraico": "יָרֻ֔צוּ", "transliteral": "yā-ru-ṣū", "traducao_palavra": "correm" },
        { "hebraico": "וִֽימַהֲר֔וּ", "transliteral": "wî-ma-hă-rū", "traducao_palavra": "e se apressam" },
        { "hebraico": "לִשְׁפֹּ֖ךְ", "transliteral": "liš-pōḵ", "traducao_palavra": "para derramar" },
        { "hebraico": "דָּ֣ם", "transliteral": "dām", "traducao_palavra": "sangue" },
        { "hebraico": "נָקִ֑י", "transliteral": "nā-qî", "traducao_palavra": "inocente" },
        { "hebraico": "מַחְשְׁבֹֽותֵיהֶם֙", "transliteral": "maḥ-šə-ḇō-w-ṯê-hem", "traducao_palavra": "seus pensamentos" },
        { "hebraico": "מַחְשְׁבֹ֣ות", "transliteral": "maḥ-šə-ḇō-wṯ", "traducao_palavra": "pensamentos de" },
        { "hebraico": "אָ֔וֶן", "transliteral": "ʾā-wen", "traducao_palavra": "iniquidade" },
        { "hebraico": "שֹׁ֥ד", "transliteral": "šōḏ", "traducao_palavra": "destruição" },
        { "hebraico": "וָשֶׁ֖בֶר", "transliteral": "wā-še-ḇer", "traducao_palavra": "e quebrantamento" },
        { "hebraico": "בִּמְסִלֹּותָֽם׃", "transliteral": "bim-śil-lō-ṯām", "traducao_palavra": "nas suas estradas." }
      ]
