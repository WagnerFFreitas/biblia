    "8": {
      "traducao_completa": "Não conhecem o caminho da paz, nem há juízo nos seus passos; as suas veredas tortuosas as fizeram para si; todo aquele que anda por elas não conhece a paz.",
      "palavras": [
        { "hebraico": "דֶּ֤רֶךְ", "transliteral": "de-reḵ", "traducao_palavra": "O caminho de" },
        { "hebraico": "שָׁלֹום֙", "transliteral": "šā-lō-wm", "traducao_palavra": "paz" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "יָדָ֔עוּ", "transliteral": "yā-ḏā-ʿū", "traducao_palavra": "conheceram" },
        { "hebraico": "וְאֵ֥ין", "transliteral": "wə-ʾên", "traducao_palavra": "e não há" },
        { "hebraico": "מִשְׁפָּ֖ט", "transliteral": "miš-pāṭ", "traducao_palavra": "juízo" },
        { "hebraico": "בְּמַעְגְּלֹותָ֑ם", "transliteral": "bə-ma-ʿgə-lō-ṯām", "traducao_palavra": "nas suas trilhas/passos" },
        { "hebraico": "נְתִיבֹֽותֵיהֶם֙", "transliteral": "nə-ṯî-ḇō-w-ṯê-hem", "traducao_palavra": "suas veredas" },
        { "hebraico": "עִקְּשׁ֣וּ", "transliteral": "ʿiq-qə-šū", "traducao_palavra": "entortaram" },
        { "hebraico": "לָהֶ֔ם", "transliteral": "lā-hem", "traducao_palavra": "para eles" },
        { "hebraico": "כֹּ֚ל", "transliteral": "kōl", "traducao_palavra": "todo aquele que" },
        { "hebraico": "דֹּרֵ֣ךְ", "transliteral": "dō-rēḵ", "traducao_palavra": "pisar/andar" },
        { "hebraico": "בָּ֔הּ", "transliteral": "bāh", "traducao_palavra": "nelas" },
        { "hebraico": "לֹ֥א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "יָדַ֖ע", "transliteral": "yā-ḏa-ʿ", "traducao_palavra": "conhecerá" },
        { "hebraico": "שָׁלֹֽום׃", "transliteral": "šā-lō-wm", "traducao_palavra": "paz." }
      ]
    },
    "9": {
      "traducao_completa": "Pelo que o juízo está longe de nós, e a justiça não nos alcança; esperamos pela luz, e eis que há trevas; pelo resplendor, mas andamos em escuridão.",
      "palavras": [
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "Sobre" },
        { "hebraico": "כֵּ֗ן", "transliteral": "kên", "traducao_palavra": "isso/Portanto" },
        { "hebraico": "רָחַ֤ק", "transliteral": "rā-ḥaq", "traducao_palavra": "está longe" },
        { "hebraico": "מִשְׁפָּט֙", "transliteral": "miš-pāṭ", "traducao_palavra": "juízo" },
        { "hebraico": "מִמֶּ֔נּוּ", "transliteral": "mim-men-nū", "traducao_palavra": "de nós" },
        { "hebraico": "וְלֹ֥א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "תַשִּׂיגֵ֖נוּ", "transliteral": "ṯaś-śî-ḡê-nū", "traducao_palavra": "alcança-nos" },
        { "hebraico": "צְדָקָ֑ה", "transliteral": "ṣə-ḏā-qāh", "traducao_palavra": "justiça" },
        { "hebraico": "נְקַוֶּ֤ה", "transliteral": "nə-qaw-weh", "traducao_palavra": "esperamos" },
        { "hebraico": "לָאֹור֙", "transliteral": "lā-ʾō-wr", "traducao_palavra": "por luz" },
        { "hebraico": "וְהִנֵּה־", "transliteral": "wə-hin-nēh-", "traducao_palavra": "e eis que" },
        { "hebraico": "חֹ֔שֶׁךְ", "transliteral": "ḥō-šeḵ", "traducao_palavra": "trevas" },
        { "hebraico": "לִנְגֹהֹ֖ות", "transliteral": "lin-ḡō-hō-wṯ", "traducao_palavra": "por resplendor" },
        { "hebraico": "בָּאֲפֵלֹ֥ות", "transliteral": "bā-ʾă-p̄ê-lō-wṯ", "traducao_palavra": "em escuridões" },
        { "hebraico": "נְהַלֵּֽךְ׃", "transliteral": "nə-hal-lēḵ", "traducao_palavra": "andamos." }
      ]
    },
    "10": {
      "traducao_completa": "Apalpamos as paredes como cegos; sim, como os que não têm olhos apalpamos; tropeçamos ao meio-dia como ao crepúsculo, e nos lugares solitários somos como mortos.",
      "palavras": [
        { "hebraico": "נְגַשְׁשָׁ֤ה", "transliteral": "nə-ḡaš-šāh", "traducao_palavra": "Apalpamos" },
        { "hebraico": "כַֽעִוְרִים֙", "transliteral": "ḵa-ʿiw-rîm", "traducao_palavra": "como cegos" },
        { "hebraico": "קִ֔יר", "transliteral": "qîr", "traducao_palavra": "[a] parede" },
        { "hebraico": "וּכְאֵ֥ין", "transliteral": "ū-ḵə-ʾên", "traducao_palavra": "e como quem não tem" },
        { "hebraico": "עֵינַ֖יִם", "transliteral": "ʿê-na-yim", "traducao_palavra": "olhos" },
        { "hebraico": "נְגַשֵּׁ֑שָׁה", "transliteral": "nə-ḡaš-šê-šāh", "traducao_palavra": "apalparemos" },
        { "hebraico": "כָּשַׁ֤לְנוּ", "transliteral": "kā-šal-nū", "traducao_palavra": "tropeçamos" },
        { "hebraico": "בַֽצָּהֳרַ֙יִם֙", "transliteral": "baṣ-ṣā-ho-ra-yim", "traducao_palavra": "ao meio-dia" },
