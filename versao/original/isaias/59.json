        { "hebraico": "אֵין־", "transliteral": "ʾên-", "traducao_palavra": "Não há" },
        { "hebraico": "קֹרֵ֣א", "transliteral": "qō-rē", "traducao_palavra": "[quem] clame" },
        { "hebraico": "בְצֶ֔דֶק", "transliteral": "ḇə-ṣe-ḏeq", "traducao_palavra": "em justiça" },
        { "hebraico": "וְאֵ֥ין", "transliteral": "wə-ʾên", "traducao_palavra": "e não há" },
        { "hebraico": "נִשְׁפָּ֖ט", "transliteral": "niš-pāṭ", "traducao_palavra": "[quem] pleiteie/seja julgado" },
        { "hebraico": "בֶּאֱמוּנָ֑ה", "transliteral": "be-ʾĕ-mū-nāh", "traducao_palavra": "em verdade/fidelidade" },
        { "hebraico": "בָּטֹ֤וחַ", "transliteral": "bā-ṭō-w-aḥ", "traducao_palavra": "confiando" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "em" },
