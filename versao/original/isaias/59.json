      ]
    },
    "5": {
      "traducao_completa": "Chocam ovos de basilisco, e tecem teias de aranha; o que comer dos seus ovos morrerá; e o que é esmagado sai uma víbora.",
      "palavras": [
        { "hebraico": "בֵּיצֵ֤י", "transliteral": "bê-ṣê", "traducao_palavra": "Ovos de" },
        { "hebraico": "צִפְעֹונִי֙", "transliteral": "ṣip̄-ʿō-w-nî", "traducao_palavra": "basilisco/víbora" },
        { "hebraico": "בִּקֵּ֔עוּ", "transliteral": "biq-qê-ʿū", "traducao_palavra": "chocaram" },
        { "hebraico": "וְקּוּרֵ֥י", "transliteral": "wə-qū-rê", "traducao_palavra": "e teias de" },
        { "hebraico": "עַכָּבִ֖ישׁ", "transliteral": "ʿak-kā-ḇîš", "traducao_palavra": "aranha" },
        { "hebraico": "יֶאֱרֹ֑גוּ", "transliteral": "ye-ʾĕ-rō-ḡū", "traducao_palavra": "tecem" },
        { "hebraico": "הָאֹכֵ֤ל", "transliteral": "hā-ʾō-ḵēl", "traducao_palavra": "o que come" },
        { "hebraico": "מִבֵּיצֵיהֶם֙", "transliteral": "mib-bê-ṣê-hem", "traducao_palavra": "dos seus ovos" },
        { "hebraico": "יָמ֔וּת", "transliteral": "yā-mūṯ", "traducao_palavra": "morrerá" },
        { "hebraico": "וְהַזּוּרֶ֖ה", "transliteral": "wə-haz-zū-reh", "traducao_palavra": "e o [ovo] esmagado" },
        { "hebraico": "תִּבָּקַ֥ע", "transliteral": "tib-bā-qa-ʿ", "traducao_palavra": "romperá em" },
        { "hebraico": "אֶפְעֶֽה׃", "transliteral": "ʾep̄-ʿeh", "traducao_palavra": "víbora." }
      ]
    },
    "6": {
      "traducao_completa": "As suas teias não servem para vestes, nem se poderão cobrir com as suas obras; as suas obras são obras de iniquidade, e ato de violência há nas suas mãos.",
      "palavras": [
        { "hebraico": "קוּרֵיהֶם֙", "transliteral": "qū-rê-hem", "traducao_palavra": "Suas teias" },
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "יִהְי֣וּ", "transliteral": "yih-yū", "traducao_palavra": "serão" },
        { "hebraico": "לְבֶ֔גֶד", "transliteral": "lə-ḇe-ḡeḏ", "traducao_palavra": "para veste" },
        { "hebraico": "וְלֹ֥א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "יִתְכַּסּ֖וּ", "transliteral": "yiṯ-kas-śū", "traducao_palavra": "se cobrirão" },
        { "hebraico": "בְּמַעֲשֵׂיהֶ֑ם", "transliteral": "bə-ma-ʿă-śê-hem", "traducao_palavra": "com as suas obras" },
        { "hebraico": "מַֽעֲשֵׂיהֶם֙", "transliteral": "ma-ʿă-śê-hem", "traducao_palavra": "suas obras [são]" },
        { "hebraico": "מַעֲשֵׂי־", "transliteral": "ma-ʿă-śê-", "traducao_palavra": "obras de" },
        { "hebraico": "אָ֔וֶן", "transliteral": "ʾā-wen", "traducao_palavra": "iniquidade" },
        { "hebraico": "וּפֹ֥עַל", "transliteral": "ū-p̄ō-al", "traducao_palavra": "e ato de" },
        { "hebraico": "חָמָ֖ס", "transliteral": "ḥā-māś", "traducao_palavra": "violência" },
        { "hebraico": "בְּכַפֵּיהֶֽם׃", "transliteral": "bə-ḵap-pê-hem", "traducao_palavra": "em suas mãos." }
      ]
