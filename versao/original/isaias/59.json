        { "hebraico": "הָי֣וּ", "transliteral": "hā-yū", "traducao_palavra": "foram/são" },
        { "hebraico": "מַבְדִּלִ֔ים", "transliteral": "maḇ-di-lîm", "traducao_palavra": "fazendo separação" },
        { "hebraico": "בֵּינֵכֶ֕ם", "transliteral": "bê-nê-ḵem", "traducao_palavra": "entre vós" },
        { "hebraico": "לְבֵ֖ין", "transliteral": "lə-ḇên", "traducao_palavra": "e entre" },
        { "hebraico": "אֱלֹהֵיכֶ֑ם", "transliteral": "ʾĕ-lō-hê-ḵem", "traducao_palavra": "vosso Deus" },
        { "hebraico": "וְחַטֹּאותֵיכֶ֗ם", "transliteral": "wə-ḥaṭ-ṭō-w-ṯê-ḵem", "traducao_palavra": "e vossos pecados" },
        { "hebraico": "הִסְתִּ֧ירוּ", "transliteral": "his-tî-rū", "traducao_palavra": "encobriram/esconderam" },
        { "hebraico": "פָנִ֛ים", "transliteral": "p̄ā-nîm", "traducao_palavra": "[o] rosto" },
        { "hebraico": "מִכֶּ֖ם", "transliteral": "mik-kem", "traducao_palavra": "de vós" },
        { "hebraico": "מִשְּׁמֹֽועַ׃", "transliteral": "miš-šə-mō-w-aʿ", "traducao_palavra": "de ouvir." }
      ]
    },
    "3": {
      "traducao_completa": "Porque as vossas mãos estão contaminadas de sangue, e os vossos dedos de iniquidade; os vossos lábios falam mentiras, a vossa língua murmura perversidade.",
      "palavras": [
        { "hebraico": "כִּ֤י", "transliteral": "kî", "traducao_palavra": "Porque" },
        { "hebraico": "כַפֵּיכֶם֙", "transliteral": "ḵap-pê-ḵem", "traducao_palavra": "vossas mãos/palmas" },
        { "hebraico": "נְגֹאֲל֣וּ", "transliteral": "nə-ḡō-ʾă-lū", "traducao_palavra": "foram contaminadas" },
        { "hebraico": "בַדָּ֔ם", "transliteral": "ḇad-dām", "traducao_palavra": "com sangue" },
        { "hebraico": "וְאֶצְבְּעֹותֵיכֶ֖ם", "transliteral": "wə-ʾeṣ-bə-ʿō-w-ṯê-ḵem", "traducao_palavra": "e vossos dedos" },
        { "hebraico": "בֶּעָוֹ֑ן", "transliteral": "be-ʿā-wōn", "traducao_palavra": "com iniquidade" },
        { "hebraico": "שִׂפְתֹֽותֵיכֶם֙", "transliteral": "śip̄-ṯō-w-ṯê-ḵem", "traducao_palavra": "vossos lábios" },
