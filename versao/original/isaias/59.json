  "versiculos": {
    "1": {
      "traducao_completa": "Eis que a mão de YHWH não se encurtou, para que não possa salvar; nem se agravou o seu ouvido, para que não possa ouvir.",
      "palavras": [
        { "hebraico": "הֵן֩", "transliteral": "hēn", "traducao_palavra": "Eis que" },
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "קָצְרָ֨ה", "transliteral": "qā-ṣə-rāh", "traducao_palavra": "se encurtou" },
        { "hebraico": "יַד־", "transliteral": "yaḏ-", "traducao_palavra": "a mão de" },
        { "hebraico": "יְהוָ֥ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "מֵהֹושִׁ֖יעַ", "transliteral": "mē-hō-w-šî-aʿ", "traducao_palavra": "de salvar" },
        { "hebraico": "וְלֹא־", "transliteral": "wə-lō-", "traducao_palavra": "e não" },
        { "hebraico": "כָבְדָ֥ה", "transliteral": "ḵā-ḇə-ḏāh", "traducao_palavra": "se agravou/fez pesada" },
        { "hebraico": "אָזְנֹ֖ו", "transliteral": "ʾā-zə-nō-w", "traducao_palavra": "seu ouvido" },
        { "hebraico": "מִשְּׁמֹֽועַ׃", "transliteral": "miš-šə-mō-w-aʿ", "traducao_palavra": "de ouvir." }
      ]
    },
    "2": {
      "traducao_completa": "Mas as vossas iniquidades fazem separação entre vós e o vosso Deus; e os vossos pecados encobriram o seu rosto de vós, para que não vos ouça.",
      "palavras": [
        { "hebraico": "כִּ֤י", "transliteral": "kî", "traducao_palavra": "Mas" },
        { "hebraico": "אִם־", "transliteral": "ʾim-", "traducao_palavra": "certamente/se" },
