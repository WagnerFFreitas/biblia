        { "hebraico": "מִמְּקֹומָ֑הּ", "transliteral": "mim-mə-qō-w-māh", "traducao_palavra": "do seu lugar" },
        { "hebraico": "וְ֝עַמּוּדֶ֗יהָ", "transliteral": "wə-ʿam-mû-ḏey-hā", "traducao_palavra": "e as suas colunas" },
