        { "hebraico": "חֲכַ֣ם", "transliteral": "ḥă-ḵam", "traducao_palavra": "[Ele é] sábio de" },
        { "hebraico": "לֵ֭בָב", "transliteral": "lê-ḇāḇ", "traducao_palavra": "coração" },
        { "hebraico": "וְאַמִּ֣יץ", "transliteral": "wə-ʾam-mîṣ", "traducao_palavra": "e poderoso em" },
        { "hebraico": "כֹּ֑חַ", "transliteral": "kō-aḥ", "traducao_palavra": "força" },
