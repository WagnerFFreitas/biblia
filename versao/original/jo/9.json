    "19": {
      "traducao_completa": "Se falamos de força, eis que ele é o forte; e se de juízo, quem me citará?",
      "palavras": [
        { "hebraico": "אִם־", "transliteral": "ʾim-", "traducao_palavra": "Se" },
        { "hebraico": "לְכֹ֤חַ", "transliteral": "lə-ḵō-aḥ", "traducao_palavra": "quanto à força" },
        { "hebraico": "אַמִּ֧יץ", "transliteral": "ʾam-mîṣ", "traducao_palavra": "[Ele é] forte" },
        { "hebraico": "הִנֵּ֗ה", "transliteral": "hin-nê", "traducao_palavra": "eis" },
        { "hebraico": "וְאִם־", "transliteral": "wə-ʾim-", "traducao_palavra": "e se" },
        { "hebraico": "לְמִשְׁפָּ֥ט", "transliteral": "lə-miš-pāṭ", "traducao_palavra": "quanto ao juízo" },
        { "hebraico": "מִ֝י", "transliteral": "mî", "traducao_palavra": "quem" },
        { "hebraico": "יֹועִידֵֽנִי׃", "transliteral": "yô-w-ʿî-ḏê-nî", "traducao_palavra": "me citará/me convocará?" }
      ]
    },
    "20": {
      "traducao_completa": "Ainda que eu fosse justo, a minha própria boca me condenaria; se fosse íntegro, ela me declararia perverso.",
      "palavras": [
        { "hebraico": "אִם־", "transliteral": "ʾim-", "traducao_palavra": "Se" },
        { "hebraico": "אֶ֭צְדָּק", "transliteral": "ʾeṣ-dāq", "traducao_palavra": "eu fosse justo" },
        { "hebraico": "פִּ֣י", "transliteral": "pî", "traducao_palavra": "minha boca" },
        { "hebraico": "יַרְשִׁיעֵ֑נִי", "transliteral": "yar-šî-ʿê-nî", "traducao_palavra": "me condenaria" },
        { "hebraico": "תָּ֥ם", "transliteral": "tām", "traducao_palavra": "íntegro" },
        { "hebraico": "אָ֝נִי", "transliteral": "ʾā-nî", "traducao_palavra": "[fosse] eu" },
        { "hebraico": "וַיַּעְקְשֵֽׁנִי׃", "transliteral": "way-ya-ʿə-qə-šê-nî", "traducao_palavra": "então ela me declararia perverso" }
      ]
    },
    "21": {
      "traducao_completa": "Embora eu seja íntegro, não faço caso de mim mesmo; desprezo a minha vida.",
      "palavras": [
        { "hebraico": "תָּ֥ם", "transliteral": "tām", "traducao_palavra": "Íntegro" },
        { "hebraico": "אָ֝נִי", "transliteral": "ʾā-nî", "traducao_palavra": "sou eu" },
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "אֵדַ֥ע", "transliteral": "ʾê-ḏaʿ", "traducao_palavra": "conheceria/importaria" },
        { "hebraico": "נַפְשִׁ֗י", "transliteral": "nap̄-šî", "traducao_palavra": "minha alma" },
        { "hebraico": "אֶמְאַ֥ס", "transliteral": "ʾem-ʾas", "traducao_palavra": "desprezaria" },
        { "hebraico": "חַיָּֽי׃", "transliteral": "ḥay-yāy", "traducao_palavra": "minha vida" }
      ]
    },
    "22": {
      "traducao_completa": "Uma coisa há, por isso eu disse: ele consome tanto o íntegro como o ímpio.",
      "palavras": [
        { "hebraico": "אַחַ֭ת", "transliteral": "ʾa-ḥaṯ", "traducao_palavra": "Uma coisa" },
        { "hebraico": "הִ֑יא", "transliteral": "hî", "traducao_palavra": "é ela" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre" },
        { "hebraico": "כֵּ֥ן", "transliteral": "kên", "traducao_palavra": "isso/por isso" },
        { "hebraico": "אָ֝מַ֗רְתִּי", "transliteral": "ʾā-mar-tî", "traducao_palavra": "eu disse" },
        { "hebraico": "תָּ֣ם", "transliteral": "tām", "traducao_palavra": "[o] íntegro" },
        { "hebraico": "וְ֭רָשָׁע", "transliteral": "wə-rā-šāʿ", "traducao_palavra": "e o ímpio" },
        { "hebraico": "ה֥וּא", "transliteral": "hû", "traducao_palavra": "Ele" },
        { "hebraico": "מְכַלֶּֽה׃", "transliteral": "mə-ḵal-leh", "traducao_palavra": "consome" }
      ]
    },
    "23": {
      "traducao_completa": "Se o açoite mata de repente, ele ri da provação dos inocentes.",
      "palavras": [
        { "hebraico": "אִם־", "transliteral": "ʾim-", "traducao_palavra": "Se" },
        { "hebraico": "שֹׁ֭וט", "transliteral": "šô-wṭ", "traducao_palavra": "[o] açoite" },
        { "hebraico": "יָמִ֣ית", "transliteral": "yā-mîṯ", "traducao_palavra": "mata" },
        { "hebraico": "פִּתְאֹ֑ם", "transliteral": "piṯ-ʾōm", "traducao_palavra": "de repente" },
        { "hebraico": "לְמַסַּ֖ת", "transliteral": "lə-mas-śat", "traducao_palavra": "da provação de" },
        { "hebraico": "נְקִיִּ֣ם", "transliteral": "nə-qî-yim", "traducao_palavra": "inocentes" },
        { "hebraico": "יִלְעָֽג׃", "transliteral": "yil-ʿāḡ", "traducao_palavra": "Ele ri" }
      ]
    },
    "24": {
      "traducao_completa": "A terra é entregue nas mãos do ímpio; ele cobre o rosto dos seus juízes; se não é ele, quem é, pois?",
      "palavras": [
        { "hebraico": "אֶ֤רֶץ", "transliteral": "ʾe-reṣ", "traducao_palavra": "A terra" },
        { "hebraico": "נִתְּנָ֬ה", "transliteral": "nit-tə-nā", "traducao_palavra": "foi entregue" },
        { "hebraico": "בְּיַד־", "transliteral": "bə-yaḏ-", "traducao_palavra": "na mão do" },
        { "hebraico": "רָשָׁ֗ע", "transliteral": "rā-šāʿ", "traducao_palavra": "ímpio" },
        { "hebraico": "פְּנֵֽי־", "transliteral": "pə-nê-", "traducao_palavra": "a face de" },
        { "hebraico": "שֹׁפְטֶ֥יהָ", "transliteral": "šō-p̄ə-ṭey-hā", "traducao_palavra": "seus juízes" },
        { "hebraico": "יְכַסֶּ֑ה", "transliteral": "yə-ḵas-śeh", "traducao_palavra": "Ele cobre" },
        { "hebraico": "אִם־", "transliteral": "ʾim-", "traducao_palavra": "se" },
        { "hebraico": "לֹ֥א", "transliteral": "lō", "traducao_palavra": "não [é Ele]" },
        { "hebraico": "אֵ֝פֹ֗וא", "transliteral": "ʾê-p̄ô-w", "traducao_palavra": "então" },
        { "hebraico": "מִֽי־", "transliteral": "mî-", "traducao_palavra": "quem" },
        { "hebraico": "הֽוּא׃", "transliteral": "hû", "traducao_palavra": "é Ele?" }
      ]
    },
    "25": {
      "traducao_completa": "E os meus dias são mais velozes do que um correio; fogem, e não veem o bem.",
      "palavras": [
        { "hebraico": "וְיָמַ֣י", "transliteral": "wə-yā-may", "traducao_palavra": "E meus dias" },
        { "hebraico": "קַ֭לּוּ", "transliteral": "qal-lû", "traducao_palavra": "são mais rápidos" },
        { "hebraico": "מִנִּי־", "transliteral": "min-nî-", "traducao_palavra": "do que" },
        { "hebraico": "רָ֑ץ", "transliteral": "rāṣ", "traducao_palavra": "um corredor/correio" },
        { "hebraico": "בָּ֝רְח֗וּ", "transliteral": "bā-rə-ḥû", "traducao_palavra": "fogem" },
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "רָא֥וּ", "transliteral": "rā-ʾû", "traducao_palavra": "veem" },
        { "hebraico": "טֹובָֽה׃", "transliteral": "ṭô-ḇā", "traducao_palavra": "o bem" }
      ]
    },
    "26": {
      "traducao_completa": "Passam como navios de junco; como a águia que se lança sobre a comida.",
      "palavras": [
        { "hebraico": "חָ֭לְפוּ", "transliteral": "ḥā-lə-p̄û", "traducao_palavra": "Passam" },
        { "hebraico": "עִם־", "transliteral": "ʿim-", "traducao_palavra": "com/como" },
        { "hebraico": "אֳנִיֹּ֣ות", "transliteral": "ʾŏ-niy-yôṯ", "traducao_palavra": "navios de" },
        { "hebraico": "אֵבֶ֑ה", "transliteral": "ʾê-ḇeh", "traducao_palavra": "papiro/junco" },
        { "hebraico": "כְּ֝נֶ֗שֶׁר", "transliteral": "kə-ne-šer", "traducao_palavra": "como a águia" },
        { "hebraico": "יָט֥וּשׂ", "transliteral": "yā-ṭûś", "traducao_palavra": "[que] se lança" },
        { "hebraico": "עֲלֵi־", "transliteral": "ʿă-lê-", "traducao_palavra": "sobre" },
        { "hebraico": "אֹֽכֶל׃", "transliteral": "ʾō-ḵel", "traducao_palavra": "[a] comida" }
      ]
    },
    "27": {
      "traducao_completa": "Se eu disser: Eu me esquecerei da minha queixa, deixarei o meu triste semblante e tomarei alento,",
      "palavras": [
        { "hebraico": "אִם־", "transliteral": "ʾim-", "traducao_palavra": "Se" },
        { "hebraico": "אָ֭מְרִי", "transliteral": "ʾā-mə-rî", "traducao_palavra": "eu disser" },
        { "hebraico": "אֶשְׁכְּחָ֣ה", "transliteral": "ʾeš-kə-ḥā", "traducao_palavra": "esquecerei" },
        { "hebraico": "שִׂיחִ֑י", "transliteral": "śî-ḥî", "traducao_palavra": "minha queixa" },
        { "hebraico": "אֶעֶזְבָ֖ה", "transliteral": "ʾe-ʿez-ḇā", "traducao_palavra": "abandonarei" },
        { "hebraico": "פָנַ֣י", "transliteral": "p̄ā-nay", "traducao_palavra": "minha face [triste]" },
        { "hebraico": "וְאַבְלִֽיגָה׃", "transliteral": "wə-ʾaḇ-lî-ḡā", "traducao_palavra": "e tomarei alento" }
      ]
    },
    "28": {
      "traducao_completa": "Receio todas as minhas dores, porque bem sei que me não terás por inocente.",
      "palavras": [
        { "hebraico": "יָגֹ֣רְתִּי", "transliteral": "yā-ḡō-rə-tî", "traducao_palavra": "Receio/Temo" },
        { "hebraico": "ḵāl-", "transliteral": "ḵāl-", "traducao_palavra": "todas" },
        { "hebraico": "עַצְּבֹתָ֑י", "transliteral": "ʿaṣ-ṣə-ḇō-ṯāy", "traducao_palavra": "minhas dores" },
        { "hebraico": "יָ֝דַ֗עְתִּי", "transliteral": "yā-ḏaʿ-tî", "traducao_palavra": "sei" },
        { "hebraico": "כִּי־", "transliteral": "kî-", "traducao_palavra": "que" },
        { "hebraico": "לֹ֥א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "תְנַקֵּֽנִי׃", "transliteral": "ṯə-naq-qê-nî", "traducao_palavra": "me terás por inocente" }
      ]
    },
    "29": {
      "traducao_completa": "Sendo eu ímpio, por que trabalharei em vão?",
      "palavras": [
        { "hebraico": "אָנֹכִ֥י", "transliteral": "ʾā-nō-ḵî", "traducao_palavra": "Eu" },
        { "hebraico": "אֶרְשָׁ֑ע", "transliteral": "ʾer-šāʿ", "traducao_palavra": "sou ímpio/condenado" },
        { "hebraico": "לָמָּה־", "transliteral": "lām-mā-", "traducao_palavra": "Por que" },
        { "hebraico": "זֶּ֝ה", "transliteral": "zeh", "traducao_palavra": "então" },
        { "hebraico": "הֶ֣בֶל", "transliteral": "he-ḇel", "traducao_palavra": "em vão/vaidade" },
        { "hebraico": "אִיגָֽע׃", "transliteral": "ʾî-ḡāʿ", "traducao_palavra": "trabalharei?" }
      ]
    },
    "30": {
      "traducao_completa": "Ainda que me lave com água de neve, e purifique as minhas mãos com sabão,",
      "palavras": [
        { "hebraico": "אִם־", "transliteral": "ʾim-", "traducao_palavra": "Se" },
        { "hebraico": "הִתְרָחַ֥צְתִּי", "transliteral": "hiṯ-rā-ḥaṣ-tî", "traducao_palavra": "me lavasse" },
        { "hebraico": "בְמֹו־", "transliteral": "ḇə-mō-w-", "traducao_palavra": "em água de" },
        { "hebraico": "שָׁ֑לֶג", "transliteral": "šā-leḡ", "traducao_palavra": "neve" },
        { "hebraico": "וַ֝הֲזִכֹּ֗ותִי", "transliteral": "wa-hă-zik-kō-w-ṯî", "traducao_palavra": "e purificasse" },
        { "hebraico": "בְּבֹ֥ר", "transliteral": "bə-ḇōr", "traducao_palavra": "com sabão/alcali" },
        { "hebraico": "כַּפָּֽי׃", "transliteral": "kap-pāy", "traducao_palavra": "minhas mãos" }
      ]
    },
    "31": {
      "traducao_completa": "Ainda me submergirás no fosso, e as minhas próprias vestes me abominarão.",
      "palavras": [
        { "hebraico": "אָ֭ז", "transliteral": "ʾāz", "traducao_palavra": "Então" },
        { "hebraico": "בַּשַּׁ֣חַת", "transliteral": "baš-ša-ḥaṯ", "traducao_palavra": "na cova/fosso" },
        { "hebraico": "תִּטְבְּלֵ֑נִי", "transliteral": "tiṭ-bə-lê-nî", "traducao_palavra": "me submergirás" },
        { "hebraico": "וּ֝תְעֲב֗וּנִי", "transliteral": "ū-ṯə-ʿă-ḇû-nî", "traducao_palavra": "e me abominarão" },
        { "hebraico": "שַׂלְמֹותָֽי׃", "transliteral": "śal-mô-ṯāy", "traducao_palavra": "minhas vestes" }
      ]
    },
    "32": {
      "traducao_completa": "Porque ele não é homem, como eu, para eu lhe responder, para virmos juntamente a juízo.",
      "palavras": [
        { "hebraico": "כִּי־", "transliteral": "kî-", "traducao_palavra": "Porque" },
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "não [é]" },
        { "hebraico": "אִ֣ישׁ", "transliteral": "ʾîš", "traducao_palavra": "homem" },
        { "hebraico": "כָּ֭מֹונִי", "transliteral": "kā-mô-nî", "traducao_palavra": "como eu" },
        { "hebraico": "אֶעֱנֶ֑נּוּ", "transliteral": "ʾe-ʿĕ-nen-nū", "traducao_palavra": "[para que] eu responda a Ele" },
        { "hebraico": "נָבֹ֥וא", "transliteral": "nā-ḇô-w", "traducao_palavra": "venhamos" },
        { "hebraico": "יַ֝חְדָּ֗ו", "transliteral": "yaḥ-dāw", "traducao_palavra": "juntos" },
        { "hebraico": "בַּמִּשְׁפָּֽט׃", "transliteral": "bam-miš-pāṭ", "traducao_palavra": "a juízo" }
      ]
    },
    "33": {
      "traducao_completa": "Não há entre nós árbitro que ponha a sua mão sobre nós ambos.",
      "palavras": [
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "Não" },
        { "hebraico": "יֵשׁ־", "transliteral": "yêš-", "traducao_palavra": "há" },
        { "hebraico": "בֵּינֵ֣ינוּ", "transliteral": "bê-nê-nū", "traducao_palavra": "entre nós" },
        { "hebraico": "מֹוכִ֑יחַ", "transliteral": "mô-w-ḵî-aḥ", "traducao_palavra": "árbitro/repreendedor" },
        { "hebraico": "יָשֵׁ֖ת", "transliteral": "yā-šêṯ", "traducao_palavra": "[que] ponha" },
        { "hebraico": "יָדֹ֣ו", "transliteral": "yā-ḏô", "traducao_palavra": "sua mão" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre" },
        { "hebraico": "שְׁנֵֽינוּ׃", "transliteral": "šə-nê-nū", "traducao_palavra": "nós ambos" }
      ]
    },
    "34": {
      "traducao_completa": "Tire ele a sua vara de cima de mim, e não me amedronte o seu terror.",
      "palavras": [
        { "hebraico": "יָסֵ֣ר", "transliteral": "yā-sêr", "traducao_palavra": "Tire" },
        { "hebraico": "מֵעָלַ֣י", "transliteral": "mê-ʿā-lay", "traducao_palavra": "de sobre mim" },
        { "hebraico": "שִׁבְטֹ֑ו", "transliteral": "šiḇ-ṭô", "traducao_palavra": "Sua vara" },
        { "hebraico": "וְ֝אֵימָתֹ֗ו", "transliteral": "wə-ʾê-mā-ṯô", "traducao_palavra": "e o Seu terror" },
        { "hebraico": "אַֽל־", "transliteral": "ʾal-", "traducao_palavra": "não" },
        { "hebraico": "תְּבַעֲתַֽנִי׃", "transliteral": "tə-ḇa-ʿă-ṯā-nî", "traducao_palavra": "me amedronte" }
      ]
    },
    "35": {
      "traducao_completa": "Então falarei, e não o temerei; porque não sou assim em mim mesmo.",
      "palavras": [
        { "hebraico": "אֲֽדַבְּרָה֮", "transliteral": "ʾă-ḏab-bə-rā", "traducao_palavra": "Falarei" },
        { "hebraico": "וְלֹ֪א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "אִ֫ירָאֶ֥נּוּ", "transliteral": "ʾî-rā-ʾen-nū", "traducao_palavra": "temerei a Ele" },
        { "hebraico": "כִּי־", "transliteral": "kî-", "traducao_palavra": "porque" },
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "כֵ֥ן", "transliteral": "kên", "traducao_palavra": "assim [com medo]" },
        { "hebraico": "אָנֹכִ֗י", "transliteral": "ʾā-nō-ḵî", "traducao_palavra": "sou eu" },
        { "hebraico": "עִמָּדִֽי׃", "transliteral": "ʿim-mā-ḏî", "traducao_palavra": "em mim mesmo" }
      ]
    }
