    "15": {
      "traducao_completa": "Então um espírito passou por diante de mim; fez eriçar os cabelos da minha carne;",
      "palavras": [
        { "hebraico": "וְר֪וּחַ", "transliteral": "wə-rû-aḥ", "traducao_palavra": "E um espírito" },
