      ]
    },
    "10": {
      "traducao_completa": "O rugido do leão, e a voz do leão feroz, e os dentes dos leõezinhos se quebram.",
      "palavras": [
        { "hebraico": "שַׁאֲגַ֣ת", "transliteral": "ša-ʾă-ḡaṯ", "traducao_palavra": "O rugido de" },
        { "hebraico": "אַ֭רְיֵה", "transliteral": "ʾar-yêh", "traducao_palavra": "leão" },
        { "hebraico": "וְקֹ֣ול", "transliteral": "wə-qôl", "traducao_palavra": "e a voz de" },
        { "hebraico": "שָׁ֑חַל", "transliteral": "šā-ḥal", "traducao_palavra": "leão feroz" },
        { "hebraico": "וְשִׁנֵּ֖i", "transliteral": "wə-šin-nê", "traducao_palavra": "e os dentes de" },
        { "hebraico": "כְפִירִ֣ים", "transliteral": "ḵə-p̄î-rîm", "traducao_palavra": "leõezinhos" },
        { "hebraico": "נִתָּֽעוּ׃", "transliteral": "nit-tā-ʿû", "traducao_palavra": "foram quebrados" }
      ]
    },
    "11": {
      "traducao_completa": "Perece o leão velho, porque não há presa, e os filhos da leoa se espalham.",
      "palavras": [
        { "hebraico": "לַ֭יִשׁ", "transliteral": "la-yiš", "traducao_palavra": "[O] leão velho" },
        { "hebraico": "אֹבֵ֣ד", "transliteral": "ʾō-ḇêḏ", "traducao_palavra": "perece" },
        { "hebraico": "מִבְּלִי־", "transliteral": "mi-bə-lî-", "traducao_palavra": "por falta de" },
        { "hebraico": "טָ֑רֶף", "transliteral": "ṭā-rep̄", "traducao_palavra": "presa" },
        { "hebraico": "וּבְנֵ֥i", "transliteral": "ū-ḇə-nê", "traducao_palavra": "e os filhos de" },
        { "hebraico": "לָ֝בִ֗יא", "transliteral": "lā-ḇî", "traducao_palavra": "leoa" },
        { "hebraico": "יִתְפָּרָֽדוּ׃", "transliteral": "yiṯ-pā-rā-ḏû", "traducao_palavra": "se espalham" }
      ]
    },
    "12": {
      "traducao_completa": "Uma palavra se me disse em segredo; e os meus ouvidos perceberam um sussurro dela.",
      "palavras": [
        { "hebraico": "וְאֵלַי", "transliteral": "wə-ʾê-lay", "traducao_palavra": "E a mim" },
        { "hebraico": "דָּבָ֥ר", "transliteral": "ḏā-ḇār", "traducao_palavra": "uma palavra" },
        { "hebraico": "יְגֻנָּ֑ב", "transliteral": "yə-ḡun-nāḇ", "traducao_palavra": "foi trazida em segredo" },
        { "hebraico": "וַתִּקַּח", "transliteral": "wat-tiq-qaḥ", "traducao_palavra": "e percebeu" },
        { "hebraico": "אָזְנִי", "transliteral": "ʾāz-nî", "traducao_palavra": "meu ouvido" },
        { "hebraico": "שֵׁמֶץ", "transliteral": "šê-meṣ", "traducao_palavra": "um sussurro/fresta" },
        { "hebraico": "מֶנְהוּ׃", "transliteral": "men-hū", "traducao_palavra": "dela" }
      ]
    },
    "13": {
      "traducao_completa": "Entre pensamentos de visões da noite, quando cai sobre os homens o sono profundo,",
      "palavras": [
        { "hebraico": "בִּשְׂעִפִּים", "transliteral": "biś-ʿip-pîm", "traducao_palavra": "Em pensamentos" },
        { "hebraico": "מֵחֶזְיֹ֕נוּת", "transliteral": "mê-ḥez-yō-nō-wṯ", "traducao_palavra": "de visões de" },
        { "hebraico": "לָ֑יְלָה", "transliteral": "lā-yə-lā", "traducao_palavra": "noite" },
        { "hebraico": "בִּנְפֹ֥ל", "transliteral": "bin-p̄ōl", "traducao_palavra": "ao cair" },
        { "hebraico": "תַּ֝רְדֵּמָ֗ה", "transliteral": "tar-dê-mā", "traducao_palavra": "sono profundo" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre" },
        { "hebraico": "אֲנָשִֽׁים׃", "transliteral": "ʾă-nā-šîm", "traducao_palavra": "os homens" }
      ]
    },
    "14": {
      "traducao_completa": "Sobrevieram-me o espanto e o tremor, e todos os meus ossos estremeceram.",
      "palavras": [
        { "hebraico": "פַּ֣חַד", "transliteral": "pa-ḥaḏ", "traducao_palavra": "Terror/Espanto" },
        { "hebraico": "קְ֭רָאַנִי", "transliteral": "qə-rā-ʾa-nî", "traducao_palavra": "encontrou-me" },
        { "hebraico": "וּרְעָדָ֑ה", "transliteral": "ū-rə-ʿā-ḏā", "traducao_palavra": "e tremor" },
        { "hebraico": "וְרֹ֖ב", "transliteral": "wə-rōḇ", "traducao_palavra": "e a multidão de" },
