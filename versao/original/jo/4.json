{
  "livro": "Jó - אִיּוֹב - ʾIy-yōḇ",
  "capítulo": 4,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Então respondeu Elifaz, o temanita, e disse:",
      "palavras": [
        { "hebraico": "וַיַּ֥עַן", "transliteral": "way-ya-ʿan", "traducao_palavra": "Então respondeu" },
        { "hebraico": "אֱלִיפַ֖ז", "transliteral": "ʾĕ-lî-p̄az", "traducao_palavra": "Elifaz" },
        { "hebraico": "הַתֵּימָנִ֑י", "transliteral": "hat-tê-mā-nî", "traducao_palavra": "o temanita" },
        { "hebraico": "וַיֹּאמַֽר׃", "transliteral": "way-yō-mar", "traducao_palavra": "e disse" }
      ]
    },
    "2": {
      "traducao_completa": "Se tentarmos falar-te, enfadar-te-ás? Mas quem poderia conter as palavras?",
      "palavras": [
        { "hebraico": "הֲנִסָּ֧ה", "transliteral": "hă-nis-śā", "traducao_palavra": "Se tentarmos" },
        { "hebraico": "דָבָ֣ר", "transliteral": "ḏā-ḇār", "traducao_palavra": "uma palavra" },
        { "hebraico": "אֵלֶ֣יךָ", "transliteral": "ʾê-le-ḵā", "traducao_palavra": "a ti" },
        { "hebraico": "תִּלְאֶ֑ה", "transliteral": "til-ʾeh", "traducao_palavra": "enfadar-te-ás" },
        { "hebraico": "וַעְצֹ֥ר", "transliteral": "wa-ʿə-ṣōr", "traducao_palavra": "mas conter" },
        { "hebraico": "בְּ֝מִלִּ֗ין", "transliteral": "bə-mil-lîn", "traducao_palavra": "as palavras" },
        { "hebraico": "מִ֣י", "transliteral": "mî", "traducao_palavra": "quem" },
        { "hebraico": "יוּכָֽל׃", "transliteral": "yû-ḵāl", "traducao_palavra": "poderia" }
      ]
    },
    "3": {
      "traducao_completa": "Eis que ensinaste a muitos, e esforçaste as mãos fracas.",
      "palavras": [
        { "hebraico": "הִ֭נֵּה", "transliteral": "hin-nê", "traducao_palavra": "Eis que" },
        { "hebraico": "יִסַּ֣רְתָּ", "transliteral": "yis-sar-tā", "traducao_palavra": "ensinaste/corrigiste" },
        { "hebraico": "רַבִּ֑ים", "transliteral": "rab-bîm", "traducao_palavra": "a muitos" },
        { "hebraico": "וְיָדַ֖יִם", "transliteral": "wə-yā-ḏa-yim", "traducao_palavra": "e mãos" },
        { "hebraico": "רָפֹ֣ות", "transliteral": "rā-p̄ō-wṯ", "traducao_palavra": "fracas" },
        { "hebraico": "תְּחַזֵּֽק׃", "transliteral": "tə-ḥaz-zêq", "traducao_palavra": "fortaleceste" }
      ]
    },
    "4": {
      "traducao_completa": "As tuas palavras levantaram os que tropeçavam, e os joelhos vacilantes fortificaste.",
      "palavras": [
        { "hebraico": "כֹּ֭שֵׁל", "transliteral": "kō-šêl", "traducao_palavra": "[O que] tropeçava" },
        { "hebraico": "יְקִימ֣וּן", "transliteral": "yə-qî-mūn", "traducao_palavra": "levantavam" },
        { "hebraico": "מִלֶּ֑יךָ", "transliteral": "mil-ley-ḵā", "traducao_palavra": "tuas palavras" },
        { "hebraico": "וּבִרְכַּ֖יִם", "transliteral": "ū-ḇir-ka-yim", "traducao_palavra": "e joelhos" },
        { "hebraico": "כֹּרְעֹ֣ות", "transliteral": "kō-rə-ʿō-wṯ", "traducao_palavra": "vacilantes/dobrados" },
        { "hebraico": "תְּאַמֵּֽץ׃", "transliteral": "tə-ʾam-mêṣ", "traducao_palavra": "fortificaste" }
      ]
    },
    "5": {
      "traducao_completa": "Mas agora a ti te vem, e te enfadas; toca-te a ti, e te perturbas.",
      "palavras": [
        { "hebraico": "כִּ֤i", "transliteral": "kî", "traducao_palavra": "Porque" },
        { "hebraico": "עַתָּ֨ה ׀", "transliteral": "ʿat-tā", "traducao_palavra": "agora" },
        { "hebraico": "תָּבֹ֣וא", "transliteral": "tā-ḇô", "traducao_palavra": "[a provação] vem" },
        { "hebraico": "אֵלֶ֣יךָ", "transliteral": "ʾê-le-ḵā", "traducao_palavra": "a ti" },
        { "hebraico": "וַתִּלְאֶ֑ה", "transliteral": "wat-til-ʾeh", "traducao_palavra": "e te enfadas" },
        { "hebraico": "תִּגַּ֥ע", "transliteral": "tiḡ-gaʿ", "traducao_palavra": "[ela] toca" },
        { "hebraico": "עָ֝דֶיךָ", "transliteral": "ʿā-ḏey-ḵā", "traducao_palavra": "em ti" },
        { "hebraico": "וַתִּבָּהֵֽל׃", "transliteral": "wat-tib-bā-hêl", "traducao_palavra": "e te perturbas" }
      ]
    },
    "6": {
      "traducao_completa": "Porventura não era o teu temor de Deus a tua confiança, e a tua esperança a integridade dos teus caminhos?",
      "palavras": [
        { "hebraico": "הֲלֹ֣א", "transliteral": "hă-lō", "traducao_palavra": "Porventura não [era]" },
        { "hebraico": "יִ֭רְאָתְךָ", "transliteral": "yir-ʾā-ṯə-ḵā", "traducao_palavra": "o teu temor" },
        { "hebraico": "כִּסְלָתֶ֑ךָ", "transliteral": "kis-lā-ṯe-ḵā", "traducao_palavra": "tua confiança" },
        { "hebraico": "תִּ֝קְוָתְךָ֗", "transliteral": "tiq-wā-ṯə-ḵā", "traducao_palavra": "tua esperança" },
        { "hebraico": "וְתֹ֣ם", "transliteral": "wə-ṯōm", "traducao_palavra": "e a integridade de" },
        { "hebraico": "דְּרָכֶֽיךָ׃", "transliteral": "də-rā-ḵey-ḵā", "traducao_palavra": "teus caminhos" }
      ]
    },
    "7": {
      "traducao_completa": "Lembra-te agora disto: quem sendo inocente jamais pereceu? E onde foram os retos destruídos?",
      "palavras": [
        { "hebraico": "זְכָר־", "transliteral": "zə-ḵār-", "traducao_palavra": "Lembra-te" },
        { "hebraico": "נָ֕א", "transliteral": "nā", "traducao_palavra": "agora/rogo-te" },
        { "hebraico": "מִ֤י", "transliteral": "mî", "traducao_palavra": "quem" },
        { "hebraico": "ה֣וּא", "transliteral": "hû", "traducao_palavra": "ele" },
        { "hebraico": "נָקִ֣י", "transliteral": "nā-qî", "traducao_palavra": "inocente" },
        { "hebraico": "אָבָ֑ד", "transliteral": "ʾā-ḇāḏ", "traducao_palavra": "pereceu" },
        { "hebraico": "וְ֝אֵיפֹ֗ה", "transliteral": "wə-ʾê-p̄ōh", "traducao_palavra": "e onde" },
