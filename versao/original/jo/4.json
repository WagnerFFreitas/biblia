      ]
    },
    "8": {
      "traducao_completa": "Segundo eu tenho visto, os que lavram a iniquidade, e semeiam o mal, segam o mesmo.",
      "palavras": [
        { "hebraico": "כַּאֲשֶׁ֣ר", "transliteral": "ka-ʾă-šer", "traducao_palavra": "Como" },
        { "hebraico": "רָ֭אִיתִי", "transliteral": "rā-ʾî-ṯî", "traducao_palavra": "tenho visto" },
        { "hebraico": "חֹ֣רְשֵׁי", "transliteral": "ḥō-rə-šê", "traducao_palavra": "[aqueles que] lavram" },
        { "hebraico": "אָ֑וֶן", "transliteral": "ʾā-wen", "traducao_palavra": "iniquidade" },
        { "hebraico": "וְזֹרְעֵ֖i", "transliteral": "wə-zō-rə-ʿê", "traducao_palavra": "e semeadores de" },
        { "hebraico": "עָמָ֣ל", "transliteral": "ʿā-māl", "traducao_palavra": "mal/sofrimento" },
        { "hebraico": "יִקְצְרֻֽהוּ׃", "transliteral": "yiq-ṣə-ru-hū", "traducao_palavra": "colhem isso" }
      ]
    },
    "9": {
      "traducao_completa": "Pelo sopro de Deus perecem; e pelo vento da sua ira se consomem.",
      "palavras": [
        { "hebraico": "מִנִּשְׁמַ֣ת", "transliteral": "min-niš-maṯ", "traducao_palavra": "Pelo sopro de" },
        { "hebraico": "אֱלֹ֣והַּ", "transliteral": "ʾĕ-lō-hwah", "traducao_palavra": "Deus" },
        { "hebraico": "יֹ֭אבֵדוּ", "transliteral": "yō-ʾḇê-ḏû", "traducao_palavra": "perecem" },
        { "hebraico": "וּמֵר֨וּחַ", "transliteral": "ū-mê-rû-aḥ", "traducao_palavra": "e pelo vento de" },
        { "hebraico": "אַפֹּ֥ו", "transliteral": "ʾap-pô", "traducao_palavra": "Sua ira" },
