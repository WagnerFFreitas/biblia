    "20": {
      "traducao_completa": "Desde a manhã até à tarde são despedaçados; e perecem para sempre, sem que ninguém disso faça caso.",
      "palavras": [
        { "hebraico": "מִבֹּ֣קֶר", "transliteral": "mib-bō-qer", "traducao_palavra": "Desde a manhã" },
