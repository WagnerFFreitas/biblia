        { "hebraico": "פָּנַ֟י", "transliteral": "pā-nay", "traducao_palavra": "minha face" },
        { "hebraico": "יַחֲלֹ֑ף", "transliteral": "ya-ḥă-lōp̄", "traducao_palavra": "passou" },
        { "hebraico": "תְּ֝סַמֵּ֗ר", "transliteral": "tə-śam-mêr", "traducao_palavra": "fez eriçar" },
        { "hebraico": "שַׂעֲרַ֥ת", "transliteral": "śă-ʿă-raṯ", "traducao_palavra": "[o] cabelo de" },
        { "hebraico": "בְּשָׂרִֽי׃", "transliteral": "bə-śā-rî", "traducao_palavra": "minha carne" }
      ]
    },
    "16": {
      "traducao_completa": "Parou ele, porém não conheci a sua feição; um vulto estava diante dos meus olhos; houve silêncio, e ouvi uma voz que dizia:",
      "palavras": [
        { "hebraico": "יַעֲמֹ֤ד", "transliteral": "ya-ʿă-mōḏ", "traducao_palavra": "Parou" },
        { "hebraico": "וְלֹֽא־", "transliteral": "wə-lō-", "traducao_palavra": "e não" },
        { "hebraico": "אַכִּ֬יר", "transliteral": "ʾak-kîr", "traducao_palavra": "reconheci" },
        { "hebraico": "מַרְאֶ֗הוּ", "transliteral": "mar-ʾê-hū", "traducao_palavra": "a aparência dele" },
        { "hebraico": "תְּ֝מוּנָה", "transliteral": "tə-mû-nā", "traducao_palavra": "um vulto/forma" },
        { "hebraico": "לְנֶ֣גֶד", "transliteral": "lə-ne-ḡeḏ", "traducao_palavra": "diante de" },
        { "hebraico": "עֵינָ֑י", "transliteral": "ʿê-nāy", "traducao_palavra": "meus olhos" },
        { "hebraico": "דְּמָמָ֖ה", "transliteral": "də-mā-mā", "traducao_palavra": "silêncio" },
        { "hebraico": "וָקֹ֣ול", "transliteral": "wā-qôl", "traducao_palavra": "e uma voz" },
        { "hebraico": "אֶשְׁמָֽע׃", "transliteral": "ʾeš-māʿ", "traducao_palavra": "ouvi" }
      ]
    },
    "17": {
      "traducao_completa": "Seria, porventura, o homem mortal mais justo do que Deus? Seria o homem mais puro do que o seu Criador?",
      "palavras": [
        { "hebraico": "הַאֱנֹ֥ושׁ", "transliteral": "ha-ʾĕ-nō-wš", "traducao_palavra": "Acaso o mortal" },
        { "hebraico": "מֵאֱלֹ֗והַּ", "transliteral": "mê-ʾĕ-lō-hwah", "traducao_palavra": "diante de Deus" },
        { "hebraico": "יִצְדָּ֑ק", "transliteral": "yiṣ-dāq", "traducao_palavra": "seria justo" },
        { "hebraico": "אִ֥ם", "transliteral": "ʾim", "traducao_palavra": "ou" },
        { "hebraico": "מֵ֝עֹשֵׂ֗הוּ", "transliteral": "mê-ʿō-śê-hū", "traducao_palavra": "perante seu Criador" },
        { "hebraico": "יִטְהַר־", "transliteral": "yiṭ-har-", "traducao_palavra": "seria puro" },
        { "hebraico": "גָּֽבֶר׃", "transliteral": "gā-ḇer", "traducao_palavra": "o homem" }
      ]
    },
    "18": {
      "traducao_completa": "Eis que ele não confia nos seus servos, e aos seus anjos atribui loucura;",
      "palavras": [
        { "hebraico": "הֵ֣ן", "transliteral": "hên", "traducao_palavra": "Eis que" },
        { "hebraico": "בַּ֭עֲבָדָיו", "transliteral": "ba-ʿă-ḇā-ḏāyw", "traducao_palavra": "em Seus servos" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "יַאֲמִ֑ין", "transliteral": "ya-ʾă-mîn", "traducao_palavra": "confia" },
        { "hebraico": "וּבְמַלְאָכָ֗יו", "transliteral": "ū-ḇə-mal-ʾā-ḵāyw", "traducao_palavra": "e em Seus anjos" },
