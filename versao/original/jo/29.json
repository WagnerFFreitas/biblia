{
  "livro": "Jó - אִיּוֹב - ʾIy-yōḇ",
  "capítulo": 29,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "E prosseguiu Jó em seu discurso, e disse:",
      "palavras": [
        { "hebraico": "וַיֹּ֥וסֶף", "transliteral": "way-yô-w-sep̄", "traducao_palavra": "E continuou/prosseguiu" },
        { "hebraico": "אִיֹּ֗וב", "transliteral": "ʾiy-yō-wḇ", "traducao_palavra": "Jó" },
        { "hebraico": "שְׂאֵ֥ת", "transliteral": "śə-ʾêṯ", "traducao_palavra": "em levantar" },
        { "hebraico": "מְשָׁלֹ֑ו", "transliteral": "mə-šā-lô", "traducao_palavra": "seu discurso/parábola" },
        { "hebraico": "וַיֹּאמַֽר׃", "transliteral": "way-yō-mar", "traducao_palavra": "e disse" }
      ]
    },
    "2": {
      "traducao_completa": "Ah! quem me dera ser como nos meses passados, como nos dias em que Deus me guardava!",
      "palavras": [
        { "hebraico": "מִֽי־", "transliteral": "mî-", "traducao_palavra": "Quem" },
        { "hebraico": "יִתְּנֵ֥נִי", "transliteral": "yit-tə-nê-nî", "traducao_palavra": "me dera [Oxalá]" },
        { "hebraico": "ḵְיַרְחֵי־", "transliteral": "ḵə-yar-ḥê-", "traducao_palavra": "como os meses de" },
        { "hebraico": "קֶ֑דֶם", "transliteral": "qe-ḏem", "traducao_palavra": "outrora/passados" },
        { "hebraico": "כִּימֵ֖י", "transliteral": "kî-mê", "traducao_palavra": "como nos dias de" },
        { "hebraico": "אֱלֹ֣והַּ", "transliteral": "ʾĕ-lô-ah", "traducao_palavra": "Deus" },
        { "hebraico": "יִשְׁמְרֵֽנִי׃", "transliteral": "yiš-mə-rê-nî", "traducao_palavra": "[em que] Ele me guardava" }
      ]
    },
    "3": {
      "traducao_completa": "Quando resplandecia a sua lâmpada sobre a minha cabeça, e eu pela sua luz caminhava pelas trevas;",
      "palavras": [
        { "hebraico": "בְּהִלֹּ֧ו", "transliteral": "bə-hil-lô", "traducao_palavra": "Ao brilhar" },
        { "hebraico": "נֵרֹ֛ו", "transliteral": "nê-rô", "traducao_palavra": "a lâmpada d'Ele" },
        { "hebraico": "עֲלֵ֣i", "transliteral": "ʿă-lê", "traducao_palavra": "sobre" },
        { "hebraico": "רֹאשִׁ֑י", "transliteral": "rō-šî", "traducao_palavra": "minha cabeça" },
        { "hebraico": "לְ֝אֹורֹ֗ו", "transliteral": "lə-ʾô-rô", "traducao_palavra": "pela luz d'Ele" },
        { "hebraico": "אֵ֣לֶךְ", "transliteral": "ʾê-leḵ", "traducao_palavra": "[eu] caminhava" },
        { "hebraico": "חֹֽשֶׁךְ׃", "transliteral": "ḥō-šeḵ", "traducao_palavra": "[pelas] trevas" }
      ]
    },
    "4": {
      "traducao_completa": "Como era nos dias da minha juventude, quando o segredo de Deus estava sobre a minha tenda;",
      "palavras": [
        { "hebraico": "כַּאֲשֶׁ֣ר", "transliteral": "ka-ʾă-šer", "traducao_palavra": "Como" },
        { "hebraico": "הָ֭יִיתִי", "transliteral": "hā-yî-ṯî", "traducao_palavra": "eu era" },
        { "hebraico": "בִּימֵ֣i", "transliteral": "bî-mê", "traducao_palavra": "nos dias de" },
        { "hebraico": "חָרְפִּ֑י", "transliteral": "ḥār-pî", "traducao_palavra": "minha maturidade/outono" },
        { "hebraico": "בְּסֹ֖וד", "transliteral": "bə-śôḏ", "traducao_palavra": "no conselho/segredo de" },
        { "hebraico": "אֱלֹ֣והַּ", "transliteral": "ʾĕ-lô-ah", "traducao_palavra": "Deus" },
        { "hebraico": "עֲלֵי־", "transliteral": "ʿă-lê-", "traducao_palavra": "sobre" },
        { "hebraico": "אָהֳלִֽי׃", "transliteral": "ʾā-hŏ-lî", "traducao_palavra": "minha tenda" }
      ]
    },
    "5": {
      "traducao_completa": "Quando o Todo-Poderoso ainda estava comigo, e os meus moços ao redor de mim;",
      "palavras": [
        { "hebraico": "בְּעֹ֣וד", "transliteral": "bə-ʿôḏ", "traducao_palavra": "Enquanto" },
        { "hebraico": "שַׁדַּ֣י", "transliteral": "šad-day", "traducao_palavra": "[o] Todo-Poderoso" },
        { "hebraico": "עִמָּדִ֑י", "transliteral": "ʿim-mā-ḏî", "traducao_palavra": "[estava] comigo" },
        { "hebraico": "סְבִיבֹותַ֥י", "transliteral": "śə-ḇî-ḇō-ṯay", "traducao_palavra": "ao redor de mim" },
        { "hebraico": "נְעָרָֽי׃", "transliteral": "nə-ʿā-rāy", "traducao_palavra": "meus moços/filhos" }
      ]
    },
    "6": {
      "traducao_completa": "Quando lavava os meus passos em manteiga, e a rocha me vertia ribeiros de azeite;",
      "palavras": [
        { "hebraico": "בִּרְחֹ֥ץ", "transliteral": "bir-ḥōṣ", "traducao_palavra": "Ao lavar" },
        { "hebraico": "הֲלִיכַ֣י", "transliteral": "hă-lî-ḵay", "traducao_palavra": "meus passos" },
        { "hebraico": "בְּחֵמָ֑ה", "transliteral": "bə-ḥê-mā", "traducao_palavra": "em manteiga/creme" },
        { "hebraico": "וְ֝צ֗וּר", "transliteral": "wə-ṣûr", "traducao_palavra": "e a rocha" },
        { "hebraico": "יָצ֥וּק", "transliteral": "yā-ṣûq", "traducao_palavra": "derramava/fundia" },
        { "hebraico": "עִמָּדִ֗י", "transliteral": "ʿim-mā-ḏî", "traducao_palavra": "para mim" },
        { "hebraico": "פַּלְגֵי־", "transliteral": "pal-ḡê-", "traducao_palavra": "correntes de" },
        { "hebraico": "שָֽׁמֶן׃", "transliteral": "šā-men", "traducao_palavra": "azeite" }
      ]
    },
    "7": {
      "traducao_completa": "Quando eu saía para a porta da cidade, e na praça preparava a minha cadeira,",
      "palavras": [
        { "hebraico": "בְּצֵאתִ֣י", "transliteral": "bə-ṣê-ṯî", "traducao_palavra": "Ao sair eu" },
        { "hebraico": "שַׁ֭עַר", "traducao_palavra": "[para a] porta", "transliteral": "ša-ʿar" },
        { "hebraico": "עֲלֵי־", "transliteral": "ʿă-lê-", "traducao_palavra": "sobre/na" },
        { "hebraico": "קָ֑רֶת", "transliteral": "qā-reṯ", "traducao_palavra": "cidade" },
        { "hebraico": "בָּ֝רְחֹ֗וב", "transliteral": "bā-rə-ḥôḇ", "traducao_palavra": "na praça" },
        { "hebraico": "אָכִ֥ין", "transliteral": "ʾā-ḵîn", "traducao_palavra": "preparava" },
        { "hebraico": "מֹושָׁבִֽי׃", "transliteral": "mô-w-šā-ḇî", "traducao_palavra": "meu assento" }
      ]
    },
    "8": {
      "traducao_completa": "Os moços me viam, e se escondiam; e os idosos se levantavam e se ponham em pé;",
      "palavras": [
        { "hebraico": "רָא֣וּנִי", "transliteral": "rā-ʾû-nî", "traducao_palavra": "Viram-me" },
        { "hebraico": "נְעָרִ֣ים", "transliteral": "nə-ʿā-rîm", "traducao_palavra": "[os] moços" },
        { "hebraico": "וְנֶחְבָּ֑אוּ", "transliteral": "wə-neḥ-bā-ʾû", "traducao_palavra": "e esconderam-se" },
        { "hebraico": "וִ֝יְשִׁישִׁ֗ים", "transliteral": "wî-šî-šîm", "traducao_palavra": "e os idosos" },
        { "hebraico": "קָ֣מוּ", "transliteral": "qā-mû", "traducao_palavra": "levantaram-se" },
        { "hebraico": "עָמָֽדוּ׃", "transliteral": "ʿā-mā-ḏû", "traducao_palavra": "ficaram em pé" }
      ]
    },
    "9": {
      "traducao_completa": "Os príncipes continham as suas palavras, e punham a mão sobre a sua boca;",
      "palavras": [
        { "hebraico": "שָׂ֭רִים", "transliteral": "śā-rîm", "traducao_palavra": "Príncipes" },
        { "hebraico": "עָצְר֣וּ", "transliteral": "ʿā-ṣə-rû", "traducao_palavra": "retiveram/pararam" },
        { "hebraico": "בְמִלִּ֑ים", "transliteral": "ḇə-mil-lîm", "traducao_palavra": "[suas] palavras" },
        { "hebraico": "וְ֝כַ֗ף", "transliteral": "wə-ḵap̄", "traducao_palavra": "e a palma [mão]" },
        { "hebraico": "יָשִׂ֥ימוּ", "transliteral": "yā-śî-mû", "traducao_palavra": "puseram" },
        { "hebraico": "לְפִיהֶֽם׃", "transliteral": "lə-p̄î-hem", "traducao_palavra": "sobre a boca deles" }
      ]
    },
    "10": {
      "traducao_completa": "A voz dos nobres se calava, e a sua língua se pegava ao seu paladar.",
      "palavras": [
        { "hebraico": "קֹ֣ול", "transliteral": "qôl", "traducao_palavra": "[A] voz de" },
        { "hebraico": "נְגִידִ֣ים", "transliteral": "nə-ḡî-ḏîm", "traducao_palavra": "nobres/líderes" },
        { "hebraico": "נֶחְבָּ֑אוּ", "transliteral": "neḥ-bā-ʾû", "traducao_palavra": "foi escondida/calou-se" },
        { "hebraico": "וּ֝לְשֹׁונָ֗ם", "transliteral": "ū-lə-šô-w-nām", "traducao_palavra": "e a língua deles" },
        { "hebraico": "לְחִכָּ֥ם", "transliteral": "lə-ḥik-kām", "traducao_palavra": "ao seu paladar" },
        { "hebraico": "דָּבֵֽקָה׃", "transliteral": "dā-ḇê-qā", "traducao_palavra": "pegou-se" }
      ]
    },
    "11": {
      "traducao_completa": "Pois, ouvindo-me algum ouvido, me chamava bem-aventurado; e, vendo-me algum olho, dava testemunho de mim;",
      "palavras": [
        { "hebraico": "כִּ֤י", "transliteral": "kî", "traducao_palavra": "Pois" },
        { "hebraico": "אֹ֣זֶן", "transliteral": "ʾō-zen", "traducao_palavra": "[o] ouvido" },
        { "hebraico": "שָׁ֭מְעָה", "transliteral": "šā-mə-ʿā", "traducao_palavra": "[que] ouviu" },
        { "hebraico": "וַֽתְּאַשְּׁרֵ֑נִי", "transliteral": "wat-tə-ʾaš-šə-rê-nî", "traducao_palavra": "chamou-me bem-aventurado" },
        { "hebraico": "וְעַ֥יִן", "transliteral": "wə-ʿa-yin", "traducao_palavra": "e [o] olho" },
        { "hebraico": "רָ֝אָ֗תָה", "transliteral": "rā-ʾā-ṯā", "traducao_palavra": "[que] viu" },
        { "hebraico": "וַתְּעִידֵֽנִי׃", "transliteral": "wat-tə-ʿî-ḏê-nî", "traducao_palavra": "deu testemunho de mim" }
      ]
    },
    "12": {
      "traducao_completa": "Porque eu livrava o pobre que clamava, como também o órfão que não tinha quem o socorresse.",
      "palavras": [
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "Porque" },
        { "hebraico": "אֲמַלֵּ֥ט", "transliteral": "ʾă-mal-lêṭ", "traducao_palavra": "eu livrava" },
        { "hebraico": "עָנִ֣י", "transliteral": "ʿā-nî", "traducao_palavra": "[o] pobre" },
        { "hebraico": "מְשַׁוֵּ֑עַ", "transliteral": "mə-šaw-wê-aʿ", "traducao_palavra": "que clamava" },
        { "hebraico": "וְ֝יָתֹ֗ום", "transliteral": "wə-yā-ṯôm", "traducao_palavra": "e o órfão" },
        { "hebraico": "וְלֹא־", "transliteral": "wə-lō-", "traducao_palavra": "que não" },
        { "hebraico": "עֹזֵ֥r", "transliteral": "ʿō-zêr", "traducao_palavra": "[tinha] ajudador" },
        { "hebraico": "לֹֽו׃", "transliteral": "lô", "traducao_palavra": "para ele" }
      ]
    },
    "13": {
      "traducao_completa": "A bênção do que estava a perecer vinha sobre mim, e eu fazia que se alegrasse o coração da viúva.",
      "palavras": [
        { "hebraico": "בִּרְכַּ֣ת", "transliteral": "bir-kaṯ", "traducao_palavra": "A bênção de" },
        { "hebraico": "אֹ֭בֵד", "transliteral": "ʾō-ḇêḏ", "traducao_palavra": "[quem estava] perecendo" },
        { "hebraico": "עָלַ֣י", "transliteral": "ʿā-lay", "traducao_palavra": "sobre mim" },
        { "hebraico": "תָבֹ֑א", "transliteral": "ṯā-ḇō", "traducao_palavra": "vinha" },
        { "hebraico": "וְלֵ֖ב", "transliteral": "wə-lêḇ", "traducao_palavra": "e o coração de" },
        { "hebraico": "אַלְמָנָ֣ה", "transliteral": "ʾal-mā-nā", "traducao_palavra": "viúva" },
        { "hebraico": "אֳַרְנִֽן׃", "transliteral": "ʾar-nin", "traducao_palavra": "eu fazia cantar de alegria" }
      ]
    },
    "14": {
      "traducao_completa": "Vestia-me da justiça, e ela me servia de vestidura; como um manto e um diadema era o meu juízo.",
      "palavras": [
        { "hebraico": "צֶ֣דֶק", "transliteral": "ṣe-ḏeq", "traducao_palavra": "Justiça" },
        { "hebraico": "לָ֭בַשְׁתִּי", "transliteral": "lā-ḇaš-tî", "traducao_palavra": "vestia-me" },
        { "hebraico": "וַיִּלְבָּשֵׁ֑נִי", "transliteral": "way-yil-bā-šê-nî", "traducao_palavra": "e ela me vestia" },
        { "hebraico": "כִּמְעִ֨יל", "transliteral": "kim-ʿîl", "traducao_palavra": "como um manto" },
        { "hebraico": "וְ֝צָנִ֗יף", "transliteral": "wə-ṣā-nîp̄", "traducao_palavra": "e um turbante/diadema" },
        { "hebraico": "מִשְׁפָּטִֽי׃", "transliteral": "miš-pā-ṭî", "traducao_palavra": "[era] meu juízo" }
      ]
    },
    "15": {
      "traducao_completa": "Eu era os olhos do cego, e os pés do coxo eu era.",
      "palavras": [
        { "hebraico": "עֵינַ֥יִם", "transliteral": "ʿê-na-yim", "traducao_palavra": "Olhos" },
        { "hebraico": "הָ֭יִיתִי", "transliteral": "hā-yî-ṯî", "traducao_palavra": "eu era" },
        { "hebraico": "לַֽעִוֵּ֑ר", "transliteral": "la-ʿiw-wêr", "traducao_palavra": "para o cego" },
        { "hebraico": "וְרַגְלַ֥יִם", "transliteral": "wə-raḡ-la-yim", "traducao_palavra": "e pés" },
        { "hebraico": "לַפִּסֵּ֝חַ", "transliteral": "lap-pis-śê-aḥ", "traducao_palavra": "para o coxo" },
        { "hebraico": "אָֽנִי׃", "transliteral": "ʾā-nî", "traducao_palavra": "era eu" }
      ]
    },
    "16": {
      "traducao_completa": "Pai era eu dos necessitados, e a causa de que não tinha conhecimento eu esquadrinhava.",
      "palavras": [
        { "hebraico": "אָ֣ב", "transliteral": "ʾāḇ", "traducao_palavra": "Pai" },
        { "hebraico": "אָ֭נֹכִי", "transliteral": "ʾā-nō-ḵî", "traducao_palavra": "[era] eu" },
        { "hebraico": "לָאֶבְיֹונִ֑ים", "transliteral": "lā-ʾeḇ-yô-w-nîm", "traducao_palavra": "dos necessitados" },
        { "hebraico": "וְרִ֖ב", "transliteral": "wə-riḇ", "traducao_palavra": "e a causa [de]" },
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "יָדַ֣עְתִּי", "transliteral": "yā-ḏaʿ-tî", "traducao_palavra": "conhecia" },
        { "hebraico": "אֶחְקְרֵֽהוּ׃", "transliteral": "ʾeḥ-qə-rê-hū", "traducao_palavra": "eu a investigava" }
      ]
    },
    "17": {
      "traducao_completa": "E quebrava os queixos do perverso, e dos seus dentes arrancava a presa.",
      "palavras": [
        { "hebraico": "וָ֭אֲשַׁבְּרָה", "transliteral": "wā-ʾă-šab-bə-rā", "traducao_palavra": "E quebrava" },
        { "hebraico": "מְתַלְּעֹ֣ות", "transliteral": "mə-ṯal-lə-ʿôṯ", "traducao_palavra": "[os] queixos de" },
        { "hebraico": "עַוָּ֑ל", "transliteral": "ʿaw-wāl", "traducao_palavra": "perverso/injusto" },
        { "hebraico": "וּ֝מִשִּׁנָּ֗יו", "transliteral": "ū-miš-šin-nā-yw", "traducao_palavra": "e de seus dentes" },
        { "hebraico": "אַשְׁלִ֥יךְ", "transliteral": "ʾaš-lîḵ", "traducao_palavra": "fazia cair/arrancava" },
        { "hebraico": "טָֽרֶף׃", "transliteral": "ṭā-rep̄", "traducao_palavra": "[a] presa" }
      ]
    },
    "18": {
      "traducao_completa": "E dizia: No meu ninho morrerei, e multiplicarei os meus dias como a areia.",
      "palavras": [
        { "hebraico": "וָ֝אֹמַ֗ר", "transliteral": "wā-ʾō-mar", "traducao_palavra": "E dizia" },
        { "hebraico": "עִם־", "transliteral": "ʿim-", "traducao_palavra": "Com" },
        { "hebraico": "קִנִּ֥י", "transliteral": "qin-nî", "traducao_palavra": "meu ninho" },
        { "hebraico": "אֶגְוָ֑ע", "transliteral": "ʾeḡ-wāʿ", "traducao_palavra": "expirarei" },
        { "hebraico": "וְ֝כַחֹ֗ול", "transliteral": "wə-ḵa-ḥôl", "traducao_palavra": "e como a areia" },
        { "hebraico": "אַרְבֶּ֥ה", "transliteral": "ʾar-beh", "traducao_palavra": "multiplicarei" },
        { "hebraico": "יָמִֽים׃", "transliteral": "yā-mîm", "traducao_palavra": "dias" }
      ]
    },
    "19": {
      "traducao_completa": "A minha raiz se estendia junto às águas, e o orvalho permanecia sobre os meus ramos.",
      "palavras": [
        { "hebraico": "שָׁרְשִׁ֣י", "transliteral": "šār-šî", "traducao_palavra": "Minha raiz" },
        { "hebraico": "פָת֣וּחַ", "transliteral": "p̄ā-ṯû-aḥ", "traducao_palavra": "[estava] aberta" },
        { "hebraico": "אֱלֵי־", "transliteral": "ʾĕ-lê-", "traducao_palavra": "para" },
        { "hebraico": "מָ֑יִם", "transliteral": "mā-yim", "traducao_palavra": "[as] águas" },
        { "hebraico": "וְ֝טַ֗ל", "transliteral": "wə-ṭal", "traducao_palavra": "e o orvalho" },
        { "hebraico": "יָלִ֥ין", "transliteral": "yā-lîn", "traducao_palavra": "pousava/pernoitava" },
        { "hebraico": "בִּקְצִירִֽי׃", "transliteral": "biq-ṣî-rî", "traducao_palavra": "nos meus ramos" }
      ]
    },
    "20": {
      "traducao_completa": "A minha honra se renovava em mim, e o meu arco se reforçava na minha mão.",
      "palavras": [
        { "hebraico": "כְּבֹודִ֣י", "transliteral": "kə-ḇô-ḏî", "traducao_palavra": "Minha glória/honra" },
        { "hebraico": "חָדָ֣שׁ", "transliteral": "ḥā-ḏāš", "traducao_palavra": "[estava] nova" },
        { "hebraico": "עִמָּדִ֑י", "transliteral": "ʿim-mā-ḏî", "traducao_palavra": "comigo" },
        { "hebraico": "וְ֝קַשְׁתִּ֗י", "transliteral": "wə-qaš-tî", "traducao_palavra": "e meu arco" },
        { "hebraico": "בְּיָדִ֥י", "transliteral": "bə-yā-ḏî", "traducao_palavra": "na minha mão" },
        { "hebraico": "תַחֲלִֽיף׃", "transliteral": "ta-ḥă-lîp̄", "traducao_palavra": "se renovava" }
      ]
    },
    "21": {
      "traducao_completa": "Ouviam-me e esperavam, e em silêncio atendiam ao meu conselho.",
      "palavras": [
        { "hebraico": "לִֽי־", "transliteral": "lî-", "traducao_palavra": "A mim" },
        { "hebraico": "שָׁמְע֥וּ", "transliteral": "šā-mə-ʿû", "traducao_palavra": "ouviam" },
        { "hebraico": "וְיִחֵ֑לּוּ", "transliteral": "wə-yi-ḥêl-lû", "traducao_palavra": "e esperavam" },
        { "hebraico": "וְיִדְּמ֬וּ", "transliteral": "wə-yid-də-mû", "traducao_palavra": "e guardavam silêncio" },
        { "hebraico": "לְמֹ֣ו", "transliteral": "lə-mô", "traducao_palavra": "para" },
        { "hebraico": "עֲצָתִֽי׃", "transliteral": "ʿă-ṣā-ṯî", "traducao_palavra": "meu conselho" }
      ]
    },
    "22": {
      "traducao_completa": "Depois da minha palavra não replicavam, e a minha palavra destilava sobre eles.",
      "palavras": [
        { "hebraico": "אַחֲרֵ֣י", "transliteral": "ʾa-ḥă-rê", "traducao_palavra": "Depois de" },
        { "hebraico": "דְ֭בָרִי", "transliteral": "ḏə-ḇā-rî", "traducao_palavra": "minha palavra" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "יִשְׁנ֑וּ", "transliteral": "yiš-nû", "traducao_palavra": "repetiam/replicavam" },
        { "hebraico": "וְ֝עָלֵ֗ימֹו", "transliteral": "wə-ʿā-lê-mô", "traducao_palavra": "e sobre eles" },
        { "hebraico": "תִּטֹּ֥ף", "transliteral": "tiṭ-ṭōp̄", "traducao_palavra": "gotejava/destilava" },
        { "hebraico": "מִלָּתִֽי׃", "transliteral": "mil-lā-ṯî", "traducao_palavra": "minha fala" }
      ]
    },
    "23": {
      "traducao_completa": "E esperavam-me como pela chuva; e abriam a sua boca como pela chuva tardia.",
      "palavras": [
        { "hebraico": "וְיִחֲל֣וּ", "transliteral": "wə-yi-ḥă-lû", "traducao_palavra": "E esperavam" },
        { "hebraico": "כַמָּטָ֣ר", "transliteral": "ḵam-mā-ṭār", "traducao_palavra": "como pela chuva" },
        { "hebraico": "לִ֑י", "transliteral": "lî", "traducao_palavra": "a mim" },
        { "hebraico": "וּ֝פִיהֶ֗ם", "transliteral": "ū-p̄î-hem", "traducao_palavra": "e sua boca" },
        { "hebraico": "פָּעֲר֥וּ", "transliteral": "pā-ʿă-rû", "traducao_palavra": "escancaravam" },
        { "hebraico": "לְמַלְקֹֽושׁ׃", "transliteral": "lə-mal-qô-wš", "traducao_palavra": "pela chuva tardia" }
      ]
    },
    "24": {
      "traducao_completa": "Se eu ria para eles, não o criam; e a luz do meu rosto não desprezavam.",
      "palavras": [
        { "hebraico": "אֶשְׂחַ֣ק", "transliteral": "ʾeś-ḥaq", "traducao_palavra": "[Se] eu ria" },
        { "hebraico": "אֲ֭לֵיהֶם", "transliteral": "ʾă-lê-hem", "traducao_palavra": "para eles" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "יַאֲמִ֑ינוּ", "transliteral": "ya-ʾă-mî-nû", "traducao_palavra": "acreditavam" },
        { "hebraico": "וְאֹ֥ור", "transliteral": "wə-ʾô-wr", "traducao_palavra": "e a luz de" },
        { "hebraico": "פָּ֝נַ֗י", "transliteral": "pā-nay", "traducao_palavra": "minha face" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "יַפִּילֽוּן׃", "transliteral": "yap-pî-lūn", "traducao_palavra": "deixavam cair" }
      ]
    },
    "25": {
      "traducao_completa": "Eu escolhia o seu caminho, e assentava-me como chefe; e habitava como rei entre as suas tropas, como aquele que consola os enlutados.",
      "palavras": [
        { "hebraico": "אֶבְחַ֣ר", "transliteral": "ʾeḇ-ḥar", "traducao_palavra": "Eu escolhia" },
        { "hebraico": "דַּרְכָּם֮", "transliteral": "dar-kām", "traducao_palavra": "o caminho deles" },
        { "hebraico": "וְאֵשֵׁ֪ב", "transliteral": "wə-ʾê-šêḇ", "traducao_palavra": "e assentava-me" },
        { "hebraico": "רֹ֫א֥שׁ", "transliteral": "rōš", "traducao_palavra": "[como] chefe" },
