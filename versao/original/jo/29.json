        { "hebraico": "בַּגְּד֑וּד", "transliteral": "baḡ-ḏûḏ", "traducao_palavra": "entre as tropas" },
        { "hebraico": "כַּאֲשֶׁ֧ר", "transliteral": "ka-ʾă-šer", "traducao_palavra": "como" },
