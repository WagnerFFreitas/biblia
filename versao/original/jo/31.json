        { "hebraico": "מִנְּעוּרַ֣י", "transliteral": "min-nə-ʿû-ray", "traducao_palavra": "desde minha juventude" },
        { "hebraico": "גְּדֵלַ֣נִי", "transliteral": "gə-ḏê-la-nî", "traducao_palavra": "ele cresceu comigo" },
        { "hebraico": "כְאָ֗ב", "transliteral": "ḵə-ʾāḇ", "traducao_palavra": "como [com um] pai" },
        { "hebraico": "וּמִבֶּ֥טֶן", "transliteral": "ū-mib-be-ṭen", "traducao_palavra": "e desde o ventre de" },
        { "hebraico": "אִמִּ֥י", "transliteral": "ʾim-mî", "traducao_palavra": "minha mãe" },
        { "hebraico": "אַנְחֶֽנָּה׃", "transliteral": "ʾan-ḥen-nā", "traducao_palavra": "eu a [viúva] guiei" }
      ]
    },
    "19": {
      "traducao_completa": "Se vi alguém perecer por falta de roupa, e o necessitado sem cobertura;",
      "palavras": [
        { "hebraico": "אִם־", "transliteral": "ʾim-", "traducao_palavra": "Se" },
        { "hebraico": "אֶרְאֶ֣ה", "transliteral": "ʾer-ʾeh", "traducao_palavra": "vi" },
        { "hebraico": "אֹ֭ובֵד", "transliteral": "ʾô-w-ḇêḏ", "traducao_palavra": "[alguém] perecendo" },
        { "hebraico": "מִבְּלִ֣י", "transliteral": "mib-bə-lî", "traducao_palavra": "sem" },
        { "hebraico": "לְב֑וּשׁ", "transliteral": "lə-ḇûš", "traducao_palavra": "vestimenta" },
        { "hebraico": "וְאֵ֥ין", "transliteral": "wə-ʾên", "traducao_palavra": "e não [havia]" },
        { "hebraico": "כְּ֝ס֗וּת", "transliteral": "kə-śûṯ", "traducao_palavra": "cobertura" },
        { "hebraico": "לָאֶבְyֹֽון׃", "transliteral": "lā-ʾeḇ-yô-wn", "traducao_palavra": "para o necessitado" }
      ]
    },
    "20": {
      "traducao_completa": "Se os seus lombos não me abençoaram, e se ele não se aquentou com o velo dos meus cordeiros;",
      "palavras": [
        { "hebraico": "אִם־", "transliteral": "ʾim-", "traducao_palavra": "Se" },
        { "hebraico": "לֹא", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "בֵרֲכ֥וּנִי", "transliteral": "ḇê-ră-ḵû-nî", "traducao_palavra": "abençoaram-me" },
        { "hebraico": "חֲלָצָ֑יו", "transliteral": "ḥă-lā-ṣāyw", "traducao_palavra": "os lombos dele" },
        { "hebraico": "וּמִגֵּ֥ז", "transliteral": "ū-mig-gêz", "traducao_palavra": "e com a tosquia/lã de" },
        { "hebraico": "כְּבָשַׂ֝י", "transliteral": "kə-ḇā-śay", "traducao_palavra": "meus cordeiros" },
        { "hebraico": "יִתְחַמָּֽם׃", "transliteral": "yiṯ-ḥam-mām", "traducao_palavra": "ele se aquecia" }
      ]
    },
    "21": {
      "traducao_completa": "Se levantei a minha mão contra o órfão, porque via a minha ajuda na porta,",
      "palavras": [
        { "hebraico": "אִם־", "transliteral": "ʾim-", "traducao_palavra": "Se" },
        { "hebraico": "הֲנִיפֹותִי", "transliteral": "hă-nî-p̄ô-ṯî", "traducao_palavra": "levantei" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre/contra" },
        { "hebraico": "יָתֹום", "transliteral": "yā-ṯô-wm", "traducao_palavra": "[o] órfão" },
        { "hebraico": "יָדִי", "transliteral": "yā-ḏî", "traducao_palavra": "minha mão" },
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "porque" },
        { "hebraico": "אֶרְאֶה", "transliteral": "ʾer-ʾeh", "traducao_palavra": "via" },
        { "hebraico": "בַשַּׁעַר", "transliteral": "ḇaš-ša-ʿar", "traducao_palavra": "no portão/tribunal" },
        { "hebraico": "עֶזְרָתִי׃", "transliteral": "ʿez-rā-ṯî", "traducao_palavra": "minha ajuda" }
      ]
    },
    "22": {
      "traducao_completa": "Caia o meu ombro da sua omoplata, e quebre-se o meu braço do seu osso.",
      "palavras": [
        { "hebraico": "כְּתֵפִי", "transliteral": "kə-ṯê-p̄î", "traducao_palavra": "Meu ombro" },
        { "hebraico": "מִשִּׁכְמָה", "transliteral": "miš-šiḵ-mā", "traducao_palavra": "da sua omoplata" },
        { "hebraico": "תִפֹּול", "transliteral": "tip-pôl", "traducao_palavra": "caia" },
        { "hebraico": "וְאֶזְרֹעִי", "transliteral": "wə-ʾez-rō-ʿî", "traducao_palavra": "e meu braço" },
        { "hebraico": "מִקָּנָה", "transliteral": "miq-qā-nā", "traducao_palavra": "do osso/haste" },
        { "hebraico": "תִּשָּׁבֵר׃", "transliteral": "tiš-šā-ḇêr", "traducao_palavra": "seja quebrado" }
      ]
    },
    "23": {
      "traducao_completa": "Porque o castigo de Deus era para mim um pavor, e eu não podia suportar a sua majestade.",
      "palavras": [
        { "hebraico": "כִּי", "transliteral": "kî", "traducao_palavra": "Porque" },
        { "hebraico": "פַחַד", "transliteral": "p̄a-ḥaḏ", "traducao_palavra": "[um] pavor" },
        { "hebraico": "אֵלַי", "transliteral": "ʾê-lay", "traducao_palavra": "para mim" },
        { "hebraico": "אֵיד", "transliteral": "ʾêḏ", "traducao_palavra": "[era o] castigo de" },
        { "hebraico": "אֵל", "transliteral": "ʾêl", "traducao_palavra": "Deus" },
        { "hebraico": "וּמִשְּׂאֵתֹו", "transliteral": "ū-miś-śə-ʾê-ṯô", "traducao_palavra": "e por causa da majestade d'Ele" },
        { "hebraico": "לֹא", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "אוּכָל׃", "transliteral": "ʾû-ḵāl", "traducao_palavra": "podia [fazer nada]" }
      ]
    },
    "24": {
      "traducao_completa": "Se no ouro pus a minha esperança, ou disse ao ouro fino: Tu és a minha confiança;",
      "palavras": [
        { "hebraico": "אִם־", "transliteral": "ʾim-", "traducao_palavra": "Se" },
        { "hebraico": "שַׂמְתִּי", "transliteral": "śam-tî", "traducao_palavra": "pus" },
        { "hebraico": "זָהָב", "transliteral": "zā-hāḇ", "traducao_palavra": "[no] ouro" },
        { "hebraico": "כִּסְלִי", "transliteral": "kis-lî", "traducao_palavra": "minha esperança" },
        { "hebraico": "וְלַכֶּתֶם", "transliteral": "wə-lak-ke-ṯem", "traducao_palavra": "e ao ouro fino" },
        { "hebraico": "אָמַרְתִּי", "transliteral": "ʾā-mar-tî", "traducao_palavra": "disse" },
        { "hebraico": "מִבְטַחִי׃", "transliteral": "miḇ-ṭa-ḥî", "traducao_palavra": "minha confiança" }
      ]
    },
    "25": {
      "traducao_completa": "Se me alegrei de que era muita a minha riqueza, e de que a minha mão tinha alcançado muito;",
      "palavras": [
        { "hebraico": "אִם־", "transliteral": "ʾim-", "traducao_palavra": "Se" },
        { "hebraico": "אֶשְׂמַח", "transliteral": "ʾeś-maḥ", "traducao_palavra": "me alegrei" },
        { "hebraico": "כִּי־", "transliteral": "kî-", "traducao_palavra": "porque" },
        { "hebraico": "רַב", "transliteral": "raḇ", "traducao_palavra": "[era] muita" },
        { "hebraico": "חֵילִי", "transliteral": "ḥê-lî", "traducao_palavra": "minha riqueza" },
        { "hebraico": "וְכִי־", "transliteral": "wə-ḵî-", "traducao_palavra": "e porque" },
        { "hebraico": "כַבִּיר", "transliteral": "ḵab-bîr", "traducao_palavra": "muito/poderoso" },
        { "hebraico": "מָצְאָה", "transliteral": "mā-ṣə-ʾā", "traducao_palavra": "alcançou" },
        { "hebraico": "יָדִי׃", "transliteral": "yā-ḏî", "traducao_palavra": "minha mão" }
      ]
    },
    "26": {
      "traducao_completa": "Se olhei para o sol, quando resplandecia, ou para a lua, caminhando em esplendor,",
      "palavras": [
        { "hebraico": "אִם־", "transliteral": "ʾim-", "traducao_palavra": "Se" },
        { "hebraico": "אֶרְאֶה", "transliteral": "ʾer-ʾeh", "traducao_palavra": "vi/contemplei" },
        { "hebraico": "אֹור", "transliteral": "ʾôr", "traducao_palavra": "[o] sol/luz" },
        { "hebraico": "כִּי", "transliteral": "kî", "traducao_palavra": "quando" },
        { "hebraico": "יָהֵל", "transliteral": "yā-hêl", "traducao_palavra": "brilhava" },
        { "hebraico": "וְיָרֵחַ", "transliteral": "wə-yā-rê-aḥ", "traducao_palavra": "e a lua" },
        { "hebraico": "יָקָר", "transliteral": "yā-qār", "traducao_palavra": "preciosa" },
        { "hebraico": "הֹלֵךְ׃", "transliteral": "hō-lêḵ", "traducao_palavra": "caminhando" }
      ]
    },
    "27": {
      "traducao_completa": "E o meu coração se deixou seduzir em segredo, e a minha boca beijou a minha mão,",
      "palavras": [
        { "hebraico": "וַיִּפְתְּ", "transliteral": "way-yip̄t", "traducao_palavra": "E foi seduzido" },
        { "hebraico": "בַּסֵּתֶר", "transliteral": "bas-śê-ṯer", "traducao_palavra": "em segredo" },
        { "hebraico": "לִבִּי", "transliteral": "lib-bî", "traducao_palavra": "meu coração" },
        { "hebraico": "וַתִּשַּׁק", "transliteral": "wat-tiš-šaq", "traducao_palavra": "e beijou" },
        { "hebraico": "יָדִי", "transliteral": "yā-ḏî", "traducao_palavra": "minha mão" },
        { "hebraico": "לְפִי׃", "transliteral": "lə-p̄î", "traducao_palavra": "minha boca" }
      ]
    },
    "28": {
      "traducao_completa": "Também isto seria uma iniquidade a ser punida pelos juízes; pois assim negaria a Deus, que está lá no alto.",
      "palavras": [
        { "hebraico": "גַּם־", "transliteral": "gam-", "traducao_palavra": "Também" },
        { "hebraico": "הוּא", "transliteral": "hû", "traducao_palavra": "isso" },
        { "hebraico": "עָוֹן", "transliteral": "ʿā-wōn", "traducao_palavra": "[seria] iniquidade" },
        { "hebraico": "פְּלִילִי", "transliteral": "pə-lî-lî", "traducao_palavra": "punível por juízes" },
        { "hebraico": "כִּי־", "transliteral": "kî-", "traducao_palavra": "pois" },
        { "hebraico": "כִחַשְׁתִּי", "transliteral": "ḵi-ḥaš-tî", "traducao_palavra": "teria negado" },
        { "hebraico": "לָאֵל", "transliteral": "lā-ʾêl", "traducao_palavra": "a Deus" },
        { "hebraico": "מִמָּעַל׃", "transliteral": "mim-ma-ʿal", "traducao_palavra": "[que está] lá no alto" }
      ]
    },
    "29": {
      "traducao_completa": "Se me alegrei da desgraça do que me tem ódio, e se exultei quando o mal o atingiu,",
      "palavras": [
        { "hebraico": "אִם־", "transliteral": "ʾim-", "traducao_palavra": "Se" },
        { "hebraico": "אֶשְׂמַח", "transliteral": "ʾeś-maḥ", "traducao_palavra": "me alegrei" },
        { "hebraico": "בְּפִיד", "transliteral": "bə-p̄îḏ", "traducao_palavra": "na desgraça de" },
        { "hebraico": "מְשַׂנְאִי", "transliteral": "mə-śan-ʾî", "traducao_palavra": "quem me odeia" },
        { "hebraico": "וְהִתְעֹרַרְתִּי", "transliteral": "wə-hiṯ-ʿō-rar-tî", "traducao_palavra": "e exultei" },
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "quando" },
        { "hebraico": "מְצָאֹו", "transliteral": "mə-ṣā-ʾô", "traducao_palavra": "encontrou/atingiu ele" },
        { "hebraico": "רָע׃", "transliteral": "rāʿ", "traducao_palavra": "[o] mal" }
      ]
    },
    "30": {
      "traducao_completa": "(Mas não deixei pecar a minha boca, pedindo a sua morte com maldição);",
      "palavras": [
        { "hebraico": "וְלֹא־", "transliteral": "wə-lō-", "traducao_palavra": "E não" },
        { "hebraico": "נָתַתִּי", "transliteral": "nā-ṯat-tî", "traducao_palavra": "permiti" },
        { "hebraico": "לַחֲטֹא", "transliteral": "la-ḥă-ṭō", "traducao_palavra": "pecar" },
        { "hebraico": "חִכִּי", "transliteral": "ḥik-kî", "traducao_palavra": "meu paladar/boca" },
        { "hebraico": "לִשְׁאֹל", "transliteral": "liš-ʾōl", "traducao_palavra": "para pedir" },
        { "hebraico": "בְּאָלָה", "transliteral": "bə-ʾā-lā", "traducao_palavra": "com maldição" },
        { "hebraico": "נַפְשֹׁו׃", "transliteral": "nap̄-šô", "traducao_palavra": "a alma dele" }
      ]
    },
    "31": {
      "traducao_completa": "Se os homens da minha tenda não disseram: Ah! quem nos dará da sua carne? Não nos fartamos dela.",
      "palavras": [
        { "hebraico": "אִם־", "transliteral": "ʾim-", "traducao_palavra": "Se" },
        { "hebraico": "לֹא", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "אָמְרוּ", "transliteral": "ʾā-mə-rû", "traducao_palavra": "disseram" },
        { "hebraico": "מְתֵי", "transliteral": "mə-ṯê", "traducao_palavra": "[os] homens de" },
        { "hebraico": "אָהֳלִי", "transliteral": "ʾā-hŏ-lî", "traducao_palavra": "minha tenda" },
        { "hebraico": "מִֽי־", "transliteral": "mî-", "traducao_palavra": "Quem" },
        { "hebraico": "יִתֵּן", "transliteral": "yit-tên", "traducao_palavra": "dera" },
        { "hebraico": "מִבְּשָׂרֹו", "transliteral": "mib-bə-śā-rô", "traducao_palavra": "da carne dele" },
        { "hebraico": "לֹא", "transliteral": "lō", "traducao_palavra": "[que] não" },
        { "hebraico": "נִשְׂבָּע׃", "transliteral": "niś-bāʿ", "traducao_palavra": "nos fartamos" }
      ]
    },
    "32": {
      "traducao_completa": "O estrangeiro não pernoitava na rua; as minhas portas abria ao viandante.",
      "palavras": [
        { "hebraico": "בַּחוּץ", "transliteral": "ba-ḥūṣ", "traducao_palavra": "Na rua" },
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "יָלִין", "transliteral": "yā-lîn", "traducao_palavra": "pernoitava" },
        { "hebraico": "גֵּר", "transliteral": "gêr", "traducao_palavra": "[o] estrangeiro" },
        { "hebraico": "דְּלָתַי", "transliteral": "də-lā-ṯay", "traducao_palavra": "minhas portas" },
        { "hebraico": "לָאֹרַח", "transliteral": "lā-ʾō-raḥ", "traducao_palavra": "para o viajante" },
        { "hebraico": "אֶפְתָּח׃", "transliteral": "ʾep̄-tāḥ", "traducao_palavra": "abria" }
      ]
    },
    "33": {
      "traducao_completa": "Se encobri as minhas transgressões, como Adão, escondendo a minha iniquidade no meu seio,",
      "palavras": [
        { "hebraico": "אִם־", "transliteral": "ʾim-", "traducao_palavra": "Se" },
        { "hebraico": "כִּסִּיתִי", "transliteral": "kis-śî-ṯî", "traducao_palavra": "cobri" },
        { "hebraico": "כְאָדָם", "transliteral": "ḵə-ʾā-ḏām", "traducao_palavra": "como Adão/homem" },
        { "hebraico": "פְּשָׁעָי", "transliteral": "pə-šā-ʿāy", "traducao_palavra": "minhas transgressões" },
        { "hebraico": "לִטְמֹון", "transliteral": "liṭ-môn", "traducao_palavra": "para esconder" },
        { "hebraico": "בְּחֻבִּי", "transliteral": "bə-ḥub-bî", "traducao_palavra": "no meu seio" },
        { "hebraico": "עֲוֹנִי׃", "transliteral": "ʿă-wō-nî", "traducao_palavra": "minha iniquidade" }
      ]
    },
    "34": {
      "traducao_completa": "Porque temia a grande multidão, e o desprezo das famílias me aterrorizava, de modo que me calei e não saí da porta.",
      "palavras": [
        { "hebraico": "כִּי", "transliteral": "kî", "traducao_palavra": "Porque" },
        { "hebraico": "אֶעֱרֹוץ", "transliteral": "ʾe-ʿĕ-rô-wṣ", "traducao_palavra": "temia" },
        { "hebraico": "הָמֹון", "transliteral": "hā-mōn", "traducao_palavra": "[a] multidão" },
        { "hebraico": "רַבָּה", "transliteral": "rab-bā", "traducao_palavra": "grande" },
        { "hebraico": "וּבוּז־", "transliteral": "ū-ḇūz-", "traducao_palavra": "e o desprezo de" },
        { "hebraico": "מִשְׁפָּחֹות", "transliteral": "miš-pā-ḥô-wṯ", "traducao_palavra": "famílias" },
        { "hebraico": "יְחִתֵּנִי", "transliteral": "yə-ḥit-tê-nî", "traducao_palavra": "aterrorizava-me" },
        { "hebraico": "וָאֶדֹּם", "transliteral": "wā-ʾed-dōm", "traducao_palavra": "e calei-me" },
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "אֵצֵא", "transliteral": "ʾê-ṣê", "traducao_palavra": "saí" },
        { "hebraico": "פֶתַח׃", "transliteral": "p̄e-ṯaḥ", "traducao_palavra": "[pela] porta" }
      ]
    },
    "35": {
      "traducao_completa": "Ah! quem me dera um que me ouvisse! Eis que o meu sinal é que o Todo-Poderoso me responda; e que o meu adversário escreva um livro.",
      "palavras": [
        { "hebraico": "מִֽי־", "transliteral": "mî-", "traducao_palavra": "Quem" },
        { "hebraico": "יִתֶּן־", "transliteral": "yit-ten-", "traducao_palavra": "dera" },
        { "hebraico": "לִי", "transliteral": "lî", "traducao_palavra": "a mim" },
