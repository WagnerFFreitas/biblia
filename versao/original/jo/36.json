{
  "livro": "Jó - אִיּוֹב - ʾIy-yōḇ",
  "capítulo": 36,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Prosseguiu ainda Eliú, e disse:",
      "palavras": [
        { "hebraico": "וַיֹּ֥וסֶף", "transliteral": "way-yô-w-sep̄", "traducao_palavra": "E continuou/prosseguiu" },
        { "hebraico": "אֱלִיה֖וּ", "transliteral": "ʾĕ-lî-hû", "traducao_palavra": "Eliú" },
        { "hebraico": "וַיֹּאמַֽר׃", "transliteral": "way-yō-mar", "traducao_palavra": "e disse" }
      ]
    },
    "2": {
      "traducao_completa": "Espera-me um pouco, e mostrar-te-ei que ainda tenho razões a favor de Deus.",
      "palavras": [
        { "hebraico": "כַּתַּר־", "transliteral": "kat-tar-", "traducao_palavra": "Espera/Tenha paciência" },
        { "hebraico": "לִ֣י", "transliteral": "lî", "traducao_palavra": "por mim" },
        { "hebraico": "זְ֭עֵיר", "transliteral": "zə-ʿêr", "traducao_palavra": "um pouco" },
        { "hebraico": "וַאֲחַוֶּ֑ךָּ", "transliteral": "wa-ʾă-ḥaw-wek-kā", "traducao_palavra": "e mostrar-te-ei" },
        { "hebraico": "כִּ֤י", "transliteral": "kî", "traducao_palavra": "que" },
        { "hebraico": "עֹ֖וד", "transliteral": "ʿôḏ", "traducao_palavra": "ainda [há]" },
        { "hebraico": "לֶאֱלֹ֣והַּ", "transliteral": "le-ʾĕ-lô-ah", "traducao_palavra": "por/a favor de Deus" },
        { "hebraico": "מִלִּֽין׃", "transliteral": "mil-lîn", "traducao_palavra": "palavras/razões" }
      ]
    },
    "3": {
      "traducao_completa": "Trarei de longe o meu conhecimento; e ao meu Criador atribuirei a justiça.",
      "palavras": [
        { "hebraico": "אֶשָּׂ֣א", "transliteral": "ʾeś-śā", "traducao_palavra": "Levantarei/Trarei" },
        { "hebraico": "דֵעִ֣י", "transliteral": "ḏê-ʿî", "traducao_palavra": "meu conhecimento" },
        { "hebraico": "לְמֵרָחֹ֑וק", "transliteral": "lə-mê-rā-ḥô-wq", "traducao_palavra": "de longe" },
        { "hebraico": "וּ֝לְפֹעֲלִ֗י", "transliteral": "ū-lə-p̄ō-ʿă-lî", "traducao_palavra": "e ao meu Criador" },
        { "hebraico": "אֶתֵּֽן־", "transliteral": "ʾet-tên-", "traducao_palavra": "atribuirei" },
        { "hebraico": "צֶֽדֶק׃", "transliteral": "ṣe-ḏeq", "traducao_palavra": "justiça" }
      ]
    },
    "4": {
      "traducao_completa": "Porque, na verdade, as minhas palavras não serão falsas; contigo está um que é perfeito em conhecimento.",
      "palavras": [
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "Porque" },
        { "hebraico": "אָ֭מְנָם", "transliteral": "ʾām-nām", "traducao_palavra": "na verdade" },
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "שֶׁ֣קֶר", "transliteral": "še-qer", "traducao_palavra": "falsidade [são]" },
        { "hebraico": "מִלָּ֑י", "transliteral": "mil-lāy", "traducao_palavra": "minhas palavras" },
        { "hebraico": "תְּמִ֖ים", "transliteral": "tə-mîm", "traducao_palavra": "[um] perfeito em" },
        { "hebraico": "דֵּעֹ֣ות", "transliteral": "ḏê-ʿô-wṯ", "traducao_palavra": "conhecimentos" },
        { "hebraico": "עִמָּֽךְ׃", "transliteral": "ʿim-māḵ", "traducao_palavra": "[está] contigo" }
      ]
    },
    "5": {
      "traducao_completa": "Eis que Deus é mui poderoso, contudo a ninguém despreza; grande é na força do entendimento.",
      "palavras": [
        { "hebraico": "הֶן־", "transliteral": "hen-", "traducao_palavra": "Eis que" },
        { "hebraico": "אֵ֣ל", "transliteral": "ʾêl", "traducao_palavra": "Deus" },
        { "hebraico": "כַּ֭בִּיר", "transliteral": "kab-bîr", "traducao_palavra": "[é] poderoso/grande" },
        { "hebraico": "וְלֹ֣א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "יִמְאָ֑ס", "transliteral": "yim-ʾāś", "traducao_palavra": "despreza" },
        { "hebraico": "כַּ֝בִּ֗יר", "transliteral": "kab-bîr", "traducao_palavra": "grande [é]" },
        { "hebraico": "כֹּ֣חַ", "transliteral": "kō-aḥ", "traducao_palavra": "[na] força de" },
        { "hebraico": "לֵֽב׃", "transliteral": "lêḇ", "traducao_palavra": "coração/entendimento" }
      ]
    },
    "6": {
      "traducao_completa": "Não preserva a vida do ímpio, mas faz justiça aos aflitos.",
      "palavras": [
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "Não" },
        { "hebraico": "יְחַיֶּ֥ה", "transliteral": "yə-ḥay-yeh", "traducao_palavra": "preserva a vida de" },
        { "hebraico": "רָשָׁ֑ע", "transliteral": "rā-šāʿ", "traducao_palavra": "ímpio" },
        { "hebraico": "וּמִשְׁפַּ֖ט", "transliteral": "ū-miš-paṭ", "traducao_palavra": "e o direito de" },
        { "hebraico": "עֲנִיִּ֣ים", "transliteral": "ʿă-niy-yîm", "traducao_palavra": "aflitos" },
        { "hebraico": "יִתֵּֽן׃", "transliteral": "yit-tên", "traducao_palavra": "Ele dá" }
      ]
    },
    "7": {
      "traducao_completa": "Dos justos não aparta os seus olhos; antes estão com os reis no trono; ali os assenta para sempre, e são exaltados.",
      "palavras": [
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "Não" },
        { "hebraico": "יִגְרַ֤ע", "transliteral": "yiḡ-raʿ", "traducao_palavra": "aparta/retira" },
        { "hebraico": "מִצַּדִּ֨יק֙", "transliteral": "miṣ-ṣad-dîq", "traducao_palavra": "do justo" },
        { "hebraico": "עֵינָ֔יו", "transliteral": "ʿê-nāyw", "traducao_palavra": "Seus olhos" },
        { "hebraico": "וְאֶת־", "transliteral": "wə-ʾeṯ-", "traducao_palavra": "mas com" },
        { "hebraico": "מְלָכִים֮", "transliteral": "mə-lā-ḵîm", "traducao_palavra": "reis" },
        { "hebraico": "לַכִּסֵּא֒", "transliteral": "lak-kis-śê", "traducao_palavra": "no trono" },
        { "hebraico": "וַיֹּשִׁיבֵ֥ם", "transliteral": "way-yō-šî-ḇêm", "traducao_palavra": "assenta-os" },
        { "hebraico": "לָנֶ֖צַח", "transliteral": "lā-ne-ṣaḥ", "traducao_palavra": "para sempre" },
        { "hebraico": "וַיִּגְבָּֽהוּ׃", "transliteral": "way-yiḡ-bā-hû", "traducao_palavra": "e são exaltados" }
      ]
    },
    "8": {
      "traducao_completa": "E se estão presos em grilhões, e amarrados com cordas de aflição,",
      "palavras": [
        { "hebraico": "וְאִם־", "transliteral": "wə-ʾim-", "traducao_palavra": "E se" },
        { "hebraico": "אֲסוּרִ֥ים", "transliteral": "ʾă-śû-rîm", "traducao_palavra": "[estão] presos" },
        { "hebraico": "בַּזִּקִּ֑ים", "transliteral": "baz-ziq-qîm", "traducao_palavra": "em grilhões" },
        { "hebraico": "יִ֝לָּכְד֗וּן", "transliteral": "yil-lā-ḵə-ḏûn", "traducao_palavra": "estão amarrados" },
        { "hebraico": "בְּחַבְלֵי־", "transliteral": "bə-ḥaḇ-lê-", "traducao_palavra": "com cordas de" },
        { "hebraico": "עֹֽנִי׃", "transliteral": "ʿō-nî", "traducao_palavra": "aflição" }
      ]
    },
    "9": {
      "traducao_completa": "Então lhes faz saber a obra deles, e as suas transgressões, porquanto se engrandeceram.",
      "palavras": [
        { "hebraico": "וַיַּגֵּ֣ד", "transliteral": "way-yag-gêḏ", "traducao_palavra": "Então mostra/anuncia" },
        { "hebraico": "לָהֶ֣ם", "transliteral": "lā-hem", "traducao_palavra": "a eles" },
        { "hebraico": "פָּעֳלָ֑ם", "transliteral": "p̄ā-ʿŏ-lām", "traducao_palavra": "a obra deles" },
        { "hebraico": "וּ֝פִשְׁעֵיהֶ֗ם", "transliteral": "ū-p̄iš-ʿê-hem", "traducao_palavra": "e as suas transgressões" },
        { "hebraico": "כִּ֣י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "יִתְגַּבָּֽרוּ׃", "transliteral": "yiṯ-gab-bā-rû", "traducao_palavra": "se engrandeceram/foram soberbos" }
      ]
    },
    "10": {
      "traducao_completa": "E abre-lhes o ouvido para a disciplina, e ordena que se convertam da iniquidade.",
      "palavras": [
        { "hebraico": "וַיִּ֤גֶל", "transliteral": "way-yi-ḡel", "traducao_palavra": "E abre" },
        { "hebraico": "אָזְנָ֨ם", "transliteral": "ʾāz-nām", "traducao_palavra": "o ouvido deles" },
        { "hebraico": "לַמּוּסָ֑ר", "transliteral": "lam-mû-śār", "traducao_palavra": "para a disciplina/correção" },
        { "hebraico": "וַיֹּ֥אמֶר", "transliteral": "way-yō-mer", "traducao_palavra": "e ordena" },
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "que" },
        { "hebraico": "יְשֻׁב֥וּן", "transliteral": "yə-šu-ḇûn", "traducao_palavra": "voltem/convertam-se" },
        { "hebraico": "מֵאָֽוֶן׃", "transliteral": "mê-ʾā-wen", "traducao_palavra": "da iniquidade" }
      ]
    },
    "11": {
      "traducao_completa": "Se o ouvirem, e o servirem, acabarão seus dias em bem, e os seus anos em delícias.",
      "palavras": [
        { "hebraico": "אִם־", "transliteral": "ʾim-", "traducao_palavra": "Se" },
        { "hebraico": "יִשְׁמְע֥וּ", "transliteral": "yiš-mə-ʿû", "traducao_palavra": "ouvirem" },
        { "hebraico": "וְיַעֲבֹ֑דוּ", "transliteral": "wə-ya-ʿă-ḇō-ḏû", "traducao_palavra": "e servirem" },
        { "hebraico": "יְכַלּ֣וּ", "transliteral": "yə-ḵal-lû", "traducao_palavra": "consumirão/acabarão" },
        { "hebraico": "יְמֵיהֶ֣ם", "transliteral": "yə-mê-hem", "traducao_palavra": "seus dias" },
        { "hebraico": "בַּטֹּ֑וב", "transliteral": "baṭ-ṭôḇ", "traducao_palavra": "no bem" },
        { "hebraico": "וּ֝שְׁנֵיהֶ֗ם", "transliteral": "ū-šə-nê-hem", "traducao_palavra": "e seus anos" },
        { "hebraico": "בַּנְּעִימִֽים׃", "transliteral": "ban-nə-ʿî-mîm", "traducao_palavra": "em delícias/agradáveis" }
      ]
    },
    "12": {
      "traducao_completa": "Porém, se não o ouvirem, passarão pela espada, e expirarão sem conhecimento.",
      "palavras": [
        { "hebraico": "וְאִם־", "transliteral": "wə-ʾim-", "traducao_palavra": "Mas se" },
        { "hebraico": "לֹא", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "יִשְׁמְע֗וּ", "transliteral": "yiš-mə-ʿû", "traducao_palavra": "ouvirem" },
        { "hebraico": "בְּשֶׁ֣לַח", "transliteral": "bə-še-laḥ", "traducao_palavra": "pela arma/espada" },
        { "hebraico": "יַעֲבֹ֑רוּ", "transliteral": "ya-ʿă-ḇō-rû", "traducao_palavra": "passarão" },
        { "hebraico": "וְ֝יִגְוְעוּ", "transliteral": "wə-yiḡ-wə-ʿû", "traducao_palavra": "e expirarão" },
        { "hebraico": "בִּבְלִי־", "transliteral": "bi-ḇə-lî-", "traducao_palavra": "sem" },
        { "hebraico": "דָֽעַת׃", "transliteral": "ḏā-ʿaṯ", "traducao_palavra": "conhecimento" }
      ]
    },
    "13": {
      "traducao_completa": "E os hipócritas de coração amontoam a ira; e quando ele os amarra, não clamam por socorro.",
      "palavras": [
        { "hebraico": "וְחַנְפֵי־", "transliteral": "wə-ḥan-p̄ê-", "traducao_palavra": "E os hipócritas de" },
        { "hebraico": "לֵ֭ב", "transliteral": "lêḇ", "traducao_palavra": "coração" },
        { "hebraico": "יָשִׂ֣ימוּ", "transliteral": "yā-śî-mû", "traducao_palavra": "armazenam/põem" },
        { "hebraico": "אָ֑ף", "transliteral": "ʾāp̄", "traducao_palavra": "ira" },
        { "hebraico": "לֹ֥א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "יְ֝שַׁוְּע֗וּ", "transliteral": "yə-šaw-wə-ʿû", "traducao_palavra": "gritam por socorro" },
        { "hebraico": "כִּ֣י", "transliteral": "kî", "traducao_palavra": "quando" },
        { "hebraico": "אֲסָרָֽם׃", "transliteral": "ʾă-śā-rām", "traducao_palavra": "Ele os amarra" }
      ]
    },
    "14": {
      "traducao_completa": "A sua alma morre na mocidade, e a sua vida perece entre os sodomitas.",
      "palavras": [
        { "hebraico": "תָּמֹ֣ת", "transliteral": "tā-mōṯ", "traducao_palavra": "Morre" },
        { "hebraico": "בַּנֹּ֣עַר", "transliteral": "ban-nō-ʿar", "traducao_palavra": "na juventude" },
        { "hebraico": "נַפְשָׁ֑ם", "transliteral": "nap̄-šām", "traducao_palavra": "a alma deles" },
        { "hebraico": "וְ֝חַיָּתָ֗ם", "transliteral": "wə-ḥay-yā-ṯām", "traducao_palavra": "e a vida deles" },
        { "hebraico": "בַּקְּדֵשִֽׁים׃", "transliteral": "baq-qə-ḏê-šîm", "traducao_palavra": "entre os prostitutos cultuais/sodomitas" }
      ]
    },
    "15": {
      "traducao_completa": "Ao aflito livra da sua aflição, e na opressão abre o ouvido deles.",
      "palavras": [
        { "hebraico": "יְחַלֵּ֥ץ", "transliteral": "yə-ḥal-lêṣ", "traducao_palavra": "Livra" },
        { "hebraico": "עָנִ֗י", "transliteral": "ʿā-nî", "traducao_palavra": "[ao] aflito" },
        { "hebraico": "בְעֳָנְיֹ֑ו", "transliteral": "ḇə-ʿo-nyô", "traducao_palavra": "na sua aflição" },
        { "hebraico": "וְיִ֥גֶל", "transliteral": "wə-yi-ḡel", "traducao_palavra": "e abre" },
        { "hebraico": "בַּ֝לַּ֗חַץ", "transliteral": "bal-la-ḥaṣ", "traducao_palavra": "pela opressão" },
        { "hebraico": "אָזְנָֽם׃", "transliteral": "ʾāz-nām", "traducao_palavra": "o ouvido deles" }
      ]
    },
    "16": {
      "traducao_completa": "Assim também te desviaria da boca da angústia para um lugar largo, onde não há aperto, e o repouso da tua mesa seria cheio de gordura.",
      "palavras": [
        { "hebraico": "אַף", "transliteral": "ʾap̄", "traducao_palavra": "Também" },
        { "hebraico": "הֲסִיתְךָ֨", "transliteral": "hă-śî-ṯə-ḵā", "traducao_palavra": "Ele te desviaria" },
        { "hebraico": "מִפִּי־", "transliteral": "mip-pî-", "traducao_palavra": "da boca de" },
        { "hebraico": "צָ֗ר", "transliteral": "ṣār", "traducao_palavra": "angústia/aperto" },
        { "hebraico": "רַ֭חַב", "transliteral": "ra-ḥaḇ", "traducao_palavra": "[para um lugar] largo" },
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "não [onde]" },
        { "hebraico": "מּוּצָ֣ק", "transliteral": "mû-ṣāq", "traducao_palavra": "[há] aperto/restrição" },
        { "hebraico": "תַּחְתֶּ֑יהָ", "transliteral": "taḥ-tey-hā", "traducao_palavra": "abaixo dela" },
        { "hebraico": "וְנַ֥חַת", "transliteral": "wə-na-ḥaṯ", "traducao_palavra": "e o repouso de" },
        { "hebraico": "שֻׁ֝לְחָנְךָ֗", "transliteral": "šul-ḥā-nə-ḵā", "traducao_palavra": "tua mesa" },
        { "hebraico": "מָלֵ֥א", "transliteral": "mā-lê", "traducao_palavra": "cheio de" },
        { "hebraico": "דָֽשֶׁן׃", "transliteral": "ḏā-šen", "traducao_palavra": "gordura/fartura" }
      ]
    },
    "17": {
      "traducao_completa": "Mas tu estás cheio do juízo do ímpio; o juízo e a justiça se apoderam de ti.",
      "palavras": [
        { "hebraico": "וְדִין־", "transliteral": "wə-ḏîn-", "traducao_palavra": "Mas o juízo de" },
        { "hebraico": "רָשָׁ֥ע", "transliteral": "rā-šāʿ", "traducao_palavra": "ímpio" },
        { "hebraico": "מָלָ֑אתָ", "transliteral": "mā-lā-ṯā", "traducao_palavra": "encheste/estás cheio" },
        { "hebraico": "דִּ֖ין", "transliteral": "ḏîn", "traducao_palavra": "juízo" },
        { "hebraico": "וּמִשְׁפָּ֣ט", "transliteral": "ū-miš-pāṭ", "traducao_palavra": "e justiça" },
        { "hebraico": "יִתְמֹֽכוּ׃", "transliteral": "yiṯ-mō-ḵû", "traducao_palavra": "se apoderam/sustentam" }
      ]
    },
    "18": {
      "traducao_completa": "Porquanto há furor, guarda-te de que não te seduza por castigo, nem te desvie a grande soma do resgate.",
      "palavras": [
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "Porquanto [há]" },
