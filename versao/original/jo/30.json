    "29": {
      "traducao_completa": "Irmão me tornei dos chacais, e companheiro das avestruzes.",
      "palavras": [
        { "hebraico": "אָח", "transliteral": "ʾāḥ", "traducao_palavra": "Irmão" },
        { "hebraico": "הָ֭יִיתִי", "transliteral": "hā-yî-ṯî", "traducao_palavra": "eu me tornei" },
        { "hebraico": "לְתַנִּ֑ים", "transliteral": "lə-ṯan-nîm", "traducao_palavra": "dos chacais" },
        { "hebraico": "וְ֝רֵ֗עַ", "transliteral": "wə-rê-aʿ", "traducao_palavra": "e companheiro" },
        { "hebraico": "לִבְנֹ֥ות", "transliteral": "liḇ-nô-wṯ", "traducao_palavra": "das filhas de" },
        { "hebraico": "יַעֲנָֽה׃", "transliteral": "ya-ʿă-nā", "traducao_palavra": "avestruz" }
      ]
    },
    "30": {
      "traducao_completa": "A minha pele está enegrecida sobre mim, e os meus ossos estão queimados pelo calor.",
      "palavras": [
        { "hebraico": "עֹ֭ורִי", "transliteral": "ʿô-rî", "traducao_palavra": "Minha pele" },
        { "hebraico": "שָׁחַ֣ר", "transliteral": "šā-ḥar", "traducao_palavra": "enegreceu" },
        { "hebraico": "מֵעָלָ֑י", "transliteral": "mê-ʿā-lāy", "traducao_palavra": "em mim" },
        { "hebraico": "וְעַצְמִי־", "transliteral": "wə-ʿaṣ-mî-", "traducao_palavra": "e meus ossos" },
        { "hebraico": "חָ֥רָה", "transliteral": "ḥā-rā", "traducao_palavra": "queimaram" },
        { "hebraico": "מִנִּי־", "transliteral": "min-nî-", "traducao_palavra": "por causa de/pelo" },
        { "hebraico": "חֹֽרֶב׃", "transliteral": "ḥō-reḇ", "traducao_palavra": "calor" }
