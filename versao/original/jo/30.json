    "18": {
      "traducao_completa": "Pela grande força do meu mal se deformou a minha veste; ele me cinge como a gola da minha túnica.",
      "palavras": [
        { "hebraico": "בְּרָב־", "transliteral": "bə-rāḇ-", "traducao_palavra": "Pela grandeza de" },
        { "hebraico": "כֹּ֭חַ", "transliteral": "kō-aḥ", "traducao_palavra": "força [da doença]" },
        { "hebraico": "יִתְחַפֵּ֣שׂ", "transliteral": "yiṯ-ḥap-pêś", "traducao_palavra": "desfigura-se/muda" },
        { "hebraico": "לְבוּשִׁ֑י", "transliteral": "lə-ḇû-šî", "traducao_palavra": "minha veste" },
        { "hebraico": "כְּפִ֥י", "transliteral": "kə-p̄î", "traducao_palavra": "como a gola de" },
        { "hebraico": "כֻתָּנְתִּ֥י", "transliteral": "ḵut-tān-tî", "traducao_palavra": "minha túnica" },
        { "hebraico": "יַאַזְרֵֽנִי׃", "transliteral": "ya-ʾaz-rê-nî", "traducao_palavra": "me aperta/cinge" }
      ]
    },
    "19": {
      "traducao_completa": "Lançou-me no lodo, e fiquei semelhante ao pó e à cinza.",
      "palavras": [
        { "hebraico": "הֹרָ֥נִי", "transliteral": "hō-w-rā-nî", "traducao_palavra": "Lançou-me" },
        { "hebraico": "לַחֹ֑מֶר", "transliteral": "la-ḥō-mer", "traducao_palavra": "no lodo/barro" },
        { "hebraico": "וָ֝אֶתְמַשֵּׁ֗ל", "transliteral": "wā-ʾeṯ-maš-šêl", "traducao_palavra": "e tornei-me semelhante" },
        { "hebraico": "כֶּעָפָ֥ר", "transliteral": "ke-ʿā-p̄ār", "traducao_palavra": "ao pó" },
        { "hebraico": "וָאֵֽפֶר׃", "transliteral": "wā-ʾê-p̄er", "traducao_palavra": "e à cinza" }
      ]
    },
    "20": {
      "traducao_completa": "Clamo a ti, e não me respondes; estou em pé, e não atentas para mim.",
      "palavras": [
        { "hebraico": "אֲשַׁוַּ֣ע", "transliteral": "ʾă-šaw-waʿ", "traducao_palavra": "Clamo" },
        { "hebraico": "אֵ֭לֶיךָ", "transliteral": "ʾê-ley-ḵā", "traducao_palavra": "a Ti" },
        { "hebraico": "וְלֹא־", "transliteral": "wə-lō-", "traducao_palavra": "e não" },
        { "hebraico": "תַעֲנֵ֑נִי", "transliteral": "ṯa-ʿă-nê-nî", "traducao_palavra": "me respondes" },
        { "hebraico": "עָ֝מַ֗דְתִּי", "transliteral": "ʿā-maḏ-tî", "traducao_palavra": "estou em pé" },
        { "hebraico": "וַתִּתְבֹּ֥נֶן", "transliteral": "wat-tiṯ-bō-nên", "traducao_palavra": "e olhas/atentas" },
        { "hebraico": "בִּֽי׃", "transliteral": "bî", "traducao_palavra": "para mim" }
      ]
    },
    "21": {
      "traducao_completa": "Tornaste-te cruel para comigo; com a força da tua mão me combates.",
      "palavras": [
        { "hebraico": "תֵּהָפֵ֣ךְ", "transliteral": "tê-hā-p̄êḵ", "traducao_palavra": "Tornaste-te" },
        { "hebraico": "לְאַכְזָ֣ר", "transliteral": "lə-ʾaḵ-zār", "traducao_palavra": "cruel" },
        { "hebraico": "לִ֑י", "transliteral": "lî", "traducao_palavra": "para comigo" },
        { "hebraico": "בְּעֹ֥צֶם", "transliteral": "bə-ʿō-ṣem", "traducao_palavra": "com a força de" },
        { "hebraico": "יָ֝דְךָ֗", "transliteral": "yā-ḏə-ḵā", "traducao_palavra": "Tua mão" },
        { "hebraico": "תִשְׂטְמֵֽנִי׃", "transliteral": "tiś-ṭə-mê-nî", "traducao_palavra": "me persegues/combates" }
      ]
    },
    "22": {
      "traducao_completa": "Levantas-me sobre o vento, fazes-me cavalgar sobre ele, e derretes a minha substância.",
      "palavras": [
        { "hebraico": "תִּשָּׂאֵ֣נִי", "transliteral": "tiś-śā-ʾê-nî", "traducao_palavra": "Levantas-me" },
        { "hebraico": "אֶל־", "transliteral": "ʾel-", "traducao_palavra": "para" },
        { "hebraico": "ר֭וּחַ", "transliteral": "rû-aḥ", "traducao_palavra": "[o] vento" },
        { "hebraico": "תַּרְכִּיבֵ֑נִי", "transliteral": "tar-kî-ḇê-nî", "traducao_palavra": "fazes-me cavalgar" },
        { "hebraico": "וּ֝תְמֹגְגֵ֗נִי", "transliteral": "ū-ṯə-mō-ḡə-ḡê-nî", "traducao_palavra": "e derretes-me/dissolves-me" },
        { "hebraico": "תּוּשִׁיָּֽה׃", "transliteral": "tû-šî-yā", "traducao_palavra": "[minha] substância/sucesso" }
      ]
    },
    "23": {
      "traducao_completa": "Porque eu sei que me levarás à morte e à casa do ajuntamento de todos os viventes.",
      "palavras": [
        { "hebraico": "כִּי־", "transliteral": "kî-", "traducao_palavra": "Porque" },
        { "hebraico": "יָ֭דַעְתִּי", "transliteral": "yā-ḏaʿ-tî", "traducao_palavra": "eu sei" },
        { "hebraico": "מָ֣וֶת", "transliteral": "mā-weṯ", "traducao_palavra": "[à] morte" },
        { "hebraico": "תְּשִׁיבֵ֑נִי", "transliteral": "tə-šî-ḇê-nî", "traducao_palavra": "me farás voltar/levarás" },
        { "hebraico": "וּבֵ֖ית", "transliteral": "ū-ḇêṯ", "traducao_palavra": "e à casa de" },
        { "hebraico": "מֹועֵ֣ד", "transliteral": "mō-w-ʿêḏ", "traducao_palavra": "ajuntamento/encontro" },
        { "hebraico": "לְכָל־", "transliteral": "lə-ḵāl-", "traducao_palavra": "para todo" },
        { "hebraico": "חָֽי׃", "transliteral": "ḥāy", "traducao_palavra": "vivente" }
      ]
    },
    "24": {
      "traducao_completa": "Mas não estenderá ele a mão para o túmulo, ainda que clamem na sua destruição.",
      "palavras": [
        { "hebraico": "אַ֣ךְ", "transliteral": "ʾaḵ", "traducao_palavra": "Contudo" },
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "בְ֭עִי", "transliteral": "ḇə-ʿî", "traducao_palavra": "em ruína/túmulo" },
        { "hebraico": "יִשְׁלַח־", "transliteral": "yiš-laḥ-", "traducao_palavra": "estenderá" },
        { "hebraico": "יָ֑ד", "transliteral": "yāḏ", "traducao_palavra": "[a] mão" },
        { "hebraico": "אִם־", "transliteral": "ʾim-", "traducao_palavra": "se" },
        { "hebraico": "בְּ֝פִידֹ֗ו", "transliteral": "bə-p̄î-ḏô", "traducao_palavra": "na destruição dele" },
        { "hebraico": "לָהֶ֥ן", "transliteral": "lā-hen", "traducao_palavra": "por causa disso" },
        { "hebraico": "שֽׁוּעַ׃", "transliteral": "šû-aʿ", "traducao_palavra": "[há] clamor" }
      ]
    },
    "25": {
      "traducao_completa": "Porventura não chorei sobre aquele que estava aflito? Ou não se angustiou a minha alma pelo necessitado?",
      "palavras": [
        { "hebraico": "אִם־", "transliteral": "ʾim-", "traducao_palavra": "Acaso" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "בָ֭כִיתִי", "transliteral": "ḇā-ḵî-ṯî", "traducao_palavra": "chorei" },
        { "hebraico": "לִקְשֵׁה־", "transliteral": "liq-šê-", "traducao_palavra": "para o aflito de" },
        { "hebraico": "יֹ֑ום", "transliteral": "yôm", "traducao_palavra": "dia [em tempos difíceis]" },
        { "hebraico": "עָגְמָ֥ה", "transliteral": "ʿāḡ-mā", "traducao_palavra": "[não] se angustiou" },
        { "hebraico": "נַ֝פְשִׁ֗י", "transliteral": "nap̄-šî", "traducao_palavra": "minha alma" },
        { "hebraico": "לָאֶבְיֹֽון׃", "transliteral": "lā-ʾeḇ-yô-wn", "traducao_palavra": "pelo necessitado?" }
      ]
    },
    "26": {
      "traducao_completa": "Aguardando eu o bem, veio-me o mal; e esperando eu a luz, veio a escuridão.",
