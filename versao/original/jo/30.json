        { "hebraico": "וְעַתָּ֭ה", "transliteral": "wə-ʿat-tā", "traducao_palavra": "E agora" },
        { "hebraico": "נְגִינָתָ֣ם", "transliteral": "nə-ḡî-nā-ṯām", "traducao_palavra": "a canção deles" },
        { "hebraico": "הָיִ֑יתִי", "transliteral": "hā-yî-ṯî", "traducao_palavra": "eu me tornei" },
        { "hebraico": "וָאֱהִ֖י", "transliteral": "wā-ʾĕ-hî", "traducao_palavra": "e sou" },
        { "hebraico": "לָהֶ֣ם", "transliteral": "lā-hem", "traducao_palavra": "para eles" },
        { "hebraico": "לְמִלָּֽה׃", "transliteral": "lə-mil-lā", "traducao_palavra": "por provérbio/palavra de escárnio" }
      ]
    },
    "10": {
      "traducao_completa": "Abominam-me, afastam-se de mim, e no meu rosto não se privam de cuspir.",
      "palavras": [
        { "hebraico": "תֳִּֽעֲב֥וּנִי", "transliteral": "ti-ʿă-ḇû-nî", "traducao_palavra": "Abominam-me" },
        { "hebraico": "רָחֲק֣וּ", "transliteral": "rā-ḥă-qû", "traducao_palavra": "afastam-se" },
        { "hebraico": "מִנִּ֑י", "transliteral": "min-nî", "traducao_palavra": "de mim" },
        { "hebraico": "וּ֝מִפָּנַ֗י", "transliteral": "ū-mip-pā-nay", "traducao_palavra": "e de minha face" },
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "חָשְׂכ֥וּ", "transliteral": "ḥā-śə-ḵû", "traducao_palavra": "reteram/privaram-se" },
        { "hebraico": "רֹֽק׃", "transliteral": "rōq", "traducao_palavra": "[de] cuspe" }
      ]
    },
    "11": {
      "traducao_completa": "Porque Deus desatou a minha corda, e me humilhou, pelo que sacudiram de si o freio perante o meu rosto.",
      "palavras": [
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "Porque" },
        { "hebraico": "יִתְרֹ֣ו", "transliteral": "yiṯ-rô", "traducao_palavra": "minha corda" },
        { "hebraico": "פִּתַּ֣ח", "transliteral": "pit-taḥ", "traducao_palavra": "Ele desatou/abriu" },
        { "hebraico": "וַיְעַנֵּ֑נִי", "transliteral": "way-ʿan-nê-nî", "traducao_palavra": "e me humilhou/afligiu" },
        { "hebraico": "וְ֝רֶ֗סֶן", "transliteral": "wə-re-sen", "traducao_palavra": "e o freio" },
        { "hebraico": "מִפָּנַ֥י", "transliteral": "mip-pā-nay", "traducao_palavra": "diante da minha face" },
        { "hebraico": "שִׁלֵּֽחוּ׃", "transliteral": "šil-lê-ḥû", "traducao_palavra": "sacudiram/soltaram" }
      ]
    },
    "12": {
      "traducao_completa": "À minha direita se levanta o bando; empurram os meus pés e preparam contra mim os seus caminhos de destruição.",
      "palavras": [
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "À" },
        { "hebraico": "יָמִין֙", "transliteral": "yā-mîn", "traducao_palavra": "direita" },
        { "hebraico": "פִּרְחַ֣ח", "transliteral": "pir-ḥaḥ", "traducao_palavra": "a turba/prole" },
        { "hebraico": "יָק֔וּמוּ", "transliteral": "yā-qû-mû", "traducao_palavra": "levanta-se" },
        { "hebraico": "רַגְלַ֥י", "transliteral": "raḡ-lay", "traducao_palavra": "meus pés" },
        { "hebraico": "שִׁלֵּ֑חוּ", "transliteral": "šil-lê-ḥû", "traducao_palavra": "empurraram" },
        { "hebraico": "וַיָּסֹּ֥לּוּ", "transliteral": "way-yā-śōl-lû", "traducao_palavra": "e prepararam/aterraram" },
        { "hebraico": "עָ֝לַ֗י", "transliteral": "ʿā-lay", "traducao_palavra": "contra mim" },
        { "hebraico": "אָרְחֹ֥ות", "transliteral": "ʾār-ḥō-wṯ", "traducao_palavra": "veredas de" },
        { "hebraico": "אֵידָֽם׃", "transliteral": "ʾê-ḏām", "traducao_palavra": "destruição deles" }
      ]
    },
    "13": {
      "traducao_completa": "Despedaçam o meu caminho; ajudam a minha ruína; não têm nenhum ajudador.",
      "palavras": [
        { "hebraico": "נָתְסוּ֙", "transliteral": "nā-ṯə-sû", "traducao_palavra": "Destruíram" },
        { "hebraico": "נְתִיבָתִ֔י", "transliteral": "nə-ṯî-ḇā-ṯî", "traducao_palavra": "minha vereda" },
        { "hebraico": "לְהַוָּתִ֖י", "transliteral": "lə-haw-wā-ṯî", "traducao_palavra": "para minha ruína/calamidade" },
        { "hebraico": "יֹועִ֑ילוּ", "transliteral": "yô-w-ʿî-lû", "traducao_palavra": "ajudam" },
        { "hebraico": "לֹ֖א", "transliteral": "lō", "traducao_palavra": "não [há]" },
        { "hebraico": "עֹזֵ֥r", "transliteral": "ʿō-zêr", "traducao_palavra": "ajudador" },
        { "hebraico": "לָֽמֹו׃", "transliteral": "lā-mô", "traducao_palavra": "para eles" }
      ]
    },
    "14": {
      "traducao_completa": "Vêm contra mim como por uma grande brecha, e revolvem-se sobre mim entre as ruínas.",
      "palavras": [
        { "hebraico": "כְּפֶ֤רֶץ", "transliteral": "kə-p̄e-reṣ", "traducao_palavra": "Como por brecha" },
        { "hebraico": "רָ֘חָ֤ב", "transliteral": "rā-ḥāḇ", "traducao_palavra": "larga" },
        { "hebraico": "יֶאֱתָ֑יו", "transliteral": "ye-ʾĕ-ṯā-yû", "traducao_palavra": "eles vêm" },
        { "hebraico": "תַּ֥חַת", "transliteral": "ta-ḥaṯ", "traducao_palavra": "sob" },
        { "hebraico": "שֹׁ֝אָ֗ה", "transliteral": "šō-w-ʾā", "traducao_palavra": "[a] ruína" },
        { "hebraico": "הִתְגַּלְגָּֽלוּ׃", "transliteral": "hiṯ-gal-gā-lû", "traducao_palavra": "revolveram-se" }
      ]
    },
    "15": {
      "traducao_completa": "Sobrevieram-me terrores; perseguiram a minha honra como o vento, e como a nuvem passou a minha salvação.",
      "palavras": [
        { "hebraico": "הָהְפַּ֤ךְ", "transliteral": "hoh-paḵ", "traducao_palavra": "Voltaram-se" },
        { "hebraico": "עָלַ֨י", "transliteral": "ʿā-lay", "traducao_palavra": "sobre mim" },
        { "hebraico": "בַּלָּהֹ֗ות", "transliteral": "bal-lā-hō-wṯ", "traducao_palavra": "terrores" },
        { "hebraico": "תִּרְדֹּ֣ף", "transliteral": "tir-dōp̄", "traducao_palavra": "perseguiram" },
        { "hebraico": "כָּ֭רוּחַ", "transliteral": "kā-rû-aḥ", "traducao_palavra": "como vento" },
        { "hebraico": "נְדִבָתִ֑י", "transliteral": "nə-ḏi-ḇā-ṯî", "traducao_palavra": "minha nobreza/honra" },
        { "hebraico": "וּ֝כְעָ֗ב", "transliteral": "ū-ḵə-ʿāḇ", "traducao_palavra": "e como nuvem" },
        { "hebraico": "עָבְרָ֥ה", "transliteral": "ʿā-ḇə-rā", "traducao_palavra": "passou" },
        { "hebraico": "יְשֻׁעָתִֽי׃", "transliteral": "yə-šu-ʿā-ṯî", "traducao_palavra": "minha salvação" }
      ]
    },
    "16": {
      "traducao_completa": "E agora a minha alma se derrama em mim; os dias da aflição se apoderaram de mim.",
      "palavras": [
        { "hebraico": "וְעַתָּ֥ה", "transliteral": "wə-ʿat-tā", "traducao_palavra": "E agora" },
        { "hebraico": "עָלַ֥י", "transliteral": "ʿā-lay", "traducao_palavra": "sobre mim" },
        { "hebraico": "תִּשְׁתַּפֵּ֪ךְ", "transliteral": "tiš-tap-pêḵ", "traducao_palavra": "derrama-se" },
        { "hebraico": "נַפְשִׁ֑י", "transliteral": "nap̄-šî", "traducao_palavra": "minha alma" },
        { "hebraico": "יֹֽאחֲז֥וּנִי", "transliteral": "yō-w-ḥă-zû-nî", "traducao_palavra": "apoderaram-se de mim" },
        { "hebraico": "יְמֵי־", "transliteral": "yə-mê-", "traducao_palavra": "os dias de" },
        { "hebraico": "עֹֽנִי׃", "transliteral": "ʿō-nî", "traducao_palavra": "aflição" }
      ]
    },
    "17": {
      "traducao_completa": "De noite se me traspassam os meus ossos, e os meus nervos não descansam.",
      "palavras": [
        { "hebraico": "לַ֗יְלָה", "transliteral": "lay-lā", "traducao_palavra": "[De] noite" },
        { "hebraico": "עֲ֭צָמַי", "transliteral": "ʿă-ṣā-may", "traducao_palavra": "meus ossos" },
        { "hebraico": "נִקַּ֣ר", "transliteral": "niq-qar", "traducao_palavra": "são traspassados/perfurados" },
        { "hebraico": "מֵעָלָ֑י", "transliteral": "mê-ʿā-lāy", "traducao_palavra": "em mim" },
        { "hebraico": "וְ֝עֹרְקַ֗י", "transliteral": "wə-ʿō-rə-qay", "traducao_palavra": "e meus [nervos/dores] que me corroem" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "יִשְׁכָּבֽוּן׃", "transliteral": "yiš-kā-ḇûn", "traducao_palavra": "descansam" }
      ]
