        { "hebraico": "לְ֭אֵבֶל", "transliteral": "lə-ʾê-ḇel", "traducao_palavra": "em luto" },
        { "hebraico": "כִּנֹּרִ֑י", "transliteral": "kin-nō-rî", "traducao_palavra": "minha harpa" },
        { "hebraico": "וְ֝עֻגָבִ֗י", "transliteral": "wə-ʿu-ḡā-ḇî", "traducao_palavra": "e minha flauta" },
