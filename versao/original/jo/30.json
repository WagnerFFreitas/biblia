        { "hebraico": "כִּ֤י", "transliteral": "kî", "traducao_palavra": "Pois" },
        { "hebraico": "טֹ֣וב", "transliteral": "ṭôḇ", "traducao_palavra": "[o] bem" },
        { "hebraico": "קִ֭וִּיתִי", "transliteral": "qiw-wî-ṯî", "traducao_palavra": "esperei" },
        { "hebraico": "וַיָּ֣בֹא", "transliteral": "way-yā-ḇō", "traducao_palavra": "e veio" },
        { "hebraico": "רָ֑ע", "transliteral": "rāʿ", "traducao_palavra": "[o] mal" },
        { "hebraico": "וַאֲיַחֲלָ֥ה", "transliteral": "wa-ʾă-ya-ḥă-lā", "traducao_palavra": "e aguardei" },
        { "hebraico": "לְ֝אֹ֗ור", "transliteral": "lə-ʾô-wr", "traducao_palavra": "pela luz" },
        { "hebraico": "וַיָּ֥בֹא", "transliteral": "way-yā-ḇō", "traducao_palavra": "e veio" },
        { "hebraico": "אֹֽפֶל׃", "transliteral": "ʾō-p̄el", "traducao_palavra": "[a] escuridão" }
      ]
    },
    "27": {
      "traducao_completa": "As minhas entranhas fervem e não descansam; os dias da aflição me sobrevieram.",
      "palavras": [
        { "hebraico": "מֵעַ֥י", "transliteral": "mê-ʿay", "traducao_palavra": "Minhas entranhas" },
        { "hebraico": "רֻתְּח֨וּ", "transliteral": "rut-tə-ḥû", "traducao_palavra": "ferveram" },
        { "hebraico": "וְלֹא־", "transliteral": "wə-lō-", "traducao_palavra": "e não" },
        { "hebraico": "דָמּ֑וּ", "transliteral": "ḏām-mû", "traducao_palavra": "descansaram/pararam" },
        { "hebraico": "קִדְּמֻ֥נִי", "transliteral": "qid-də-mu-nî", "traducao_palavra": "sobrevieram-me/enfrentaram-me" },
        { "hebraico": "יְמֵי־", "transliteral": "yə-mê-", "traducao_palavra": "dias de" },
        { "hebraico": "עֹֽנِي׃", "transliteral": "ʿō-nî", "traducao_palavra": "aflição" }
      ]
    },
    "28": {
      "traducao_completa": "Ando enegrecido, mas não pelo sol; levanto-me na congregação e clamo.",
      "palavras": [
        { "hebraico": "קֹדֵ֣ר", "transliteral": "qō-ḏêr", "traducao_palavra": "Sombrio/Enegrecido" },
        { "hebraico": "הִ֭לַּכְתִּי", "transliteral": "hil-laḵ-tî", "traducao_palavra": "andei" },
        { "hebraico": "בְּלֹ֣א", "transliteral": "bə-lō", "traducao_palavra": "sem" },
        { "hebraico": "חַמָּ֑ה", "transliteral": "ḥam-mā", "traducao_palavra": "[o calor do] sol" },
        { "hebraico": "קַ֝֗מְתִּי", "transliteral": "qam-tî", "traducao_palavra": "levantei-me" },
        { "hebraico": "בַקָּהָ֥ל", "transliteral": "baq-qā-hāl", "traducao_palavra": "na congregação" },
        { "hebraico": "אֲשַׁוֵּֽעַ׃", "transliteral": "ʾă-šaw-wê-aʿ", "traducao_palavra": "[e] clamo" }
      ]
