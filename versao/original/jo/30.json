{
  "livro": "Jó - אִיּוֹב - ʾIy-yōḇ",
  "capítulo": 30,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Mas agora se riem de mim os de menos idade do que eu, cujos pais eu teria desdenhado de pôr com os cães do meu rebanho.",
      "palavras": [
        { "hebraico": "וְעַתָּ֤ה ׀", "transliteral": "wə-ʿat-tā", "traducao_palavra": "Mas agora" },
        { "hebraico": "שָׂחֲק֨וּ", "transliteral": "śā-ḥă-qû", "traducao_palavra": "riem-se/zombam" },
        { "hebraico": "עָלַ֜י", "transliteral": "ʿā-lay", "traducao_palavra": "de mim" },
        { "hebraico": "צְעִירִ֣ים", "transliteral": "ṣə-ʿî-rîm", "traducao_palavra": "[aqueles] jovens/menores" },
        { "hebraico": "מִמֶּ֣נִּי", "transliteral": "mim-men-nî", "traducao_palavra": "do que eu" },
        { "hebraico": "לְיָמִ֗ים", "transliteral": "lə-yā-mîm", "traducao_palavra": "em dias/idade" },
        { "hebraico": "אֲשֶׁר־", "transliteral": "ʾă-šer-", "traducao_palavra": "cujos" },
        { "hebraico": "מָאַ֥סְתִּי", "transliteral": "mā-ʾas-tî", "traducao_palavra": "rejeitei/desdenhei" },
        { "hebraico": "אֲבֹותָ֑ם", "transliteral": "ʾă-ḇô-ṯām", "traducao_palavra": "os pais deles" },
        { "hebraico": "לָ֝שִׁ֗ית", "transliteral": "lā-šîṯ", "traducao_palavra": "de pôr" },
        { "hebraico": "עִם־", "transliteral": "ʿim-", "traducao_palavra": "com" },
        { "hebraico": "כַּלְבֵ֥i", "transliteral": "kal-ḇê", "traducao_palavra": "os cães de" },
        { "hebraico": "צֹאנִֽי׃", "transliteral": "ṣō-w-nî", "traducao_palavra": "meu rebanho" }
      ]
    },
    "2": {
      "traducao_completa": "E de que me serviria a força das suas mãos, se neles já tinha perecido o vigor?",
      "palavras": [
        { "hebraico": "גַּם־", "transliteral": "gam-", "traducao_palavra": "Também" },
        { "hebraico": "כֹּ֣חַ", "transliteral": "kō-aḥ", "traducao_palavra": "a força de" },
        { "hebraico": "יְדֵיהֶם֮", "transliteral": "yə-ḏê-hem", "traducao_palavra": "suas mãos" },
        { "hebraico": "לָ֤מָּה", "transliteral": "lām-mā", "traducao_palavra": "para que/de que" },
        { "hebraico": "לִּ֥י", "transliteral": "lî", "traducao_palavra": "[serviria] a mim?" },
        { "hebraico": "עָלֵ֗ימֹו", "transliteral": "ʿā-lê-mô", "traducao_palavra": "sobre eles" },
        { "hebraico": "אָבַ֥ד", "transliteral": "ʾā-ḇaḏ", "traducao_palavra": "tinha perecido" },
        { "hebraico": "כָּֽלַח׃", "transliteral": "kā-laḥ", "traducao_palavra": "[o] vigor/maturidade" }
      ]
    },
    "3": {
      "traducao_completa": "De míngua e fome se tornaram solitários; fugiam para o deserto, lugar de trevas, assolado e deserto.",
      "palavras": [
        { "hebraico": "בְּחֶ֥סֶר", "transliteral": "bə-ḥe-ser", "traducao_palavra": "Por falta/míngua" },
        { "hebraico": "וּבְכָפָ֖ן", "transliteral": "ū-ḇə-ḵā-p̄ān", "traducao_palavra": "e por fome" },
        { "hebraico": "גַּלְמ֑וּד", "transliteral": "gal-mûḏ", "traducao_palavra": "[eram] solitários/estéreis" },
        { "hebraico": "הַֽעֹרְקִ֥ים", "transliteral": "ha-ʿō-rə-qîm", "traducao_palavra": "[os que] fugiam para" },
        { "hebraico": "צִיָּ֑ה", "transliteral": "ṣiy-yā", "traducao_palavra": "[a] terra árida" },
        { "hebraico": "אֶ֥מֶשׁ", "transliteral": "ʾe-meš", "traducao_palavra": "ontem/recentemente" },
        { "hebraico": "שֹׁ֝ואָ֗ה", "transliteral": "šô-w-ʾā", "traducao_palavra": "[lugar de] assolação" },
        { "hebraico": "וּמְשֹׁאָֽה׃", "transliteral": "ū-mə-šō-w-ʾā", "traducao_palavra": "e desolação" }
      ]
    },
    "4": {
      "traducao_completa": "Colhiam malvas entre os arbustos, e o seu mantimento eram as raízes dos zimbros.",
      "palavras": [
        { "hebraico": "הַקֹּטְפִ֥ים", "transliteral": "haq-qō-ṭə-p̄îm", "traducao_palavra": "[Aqueles que] colhiam" },
        { "hebraico": "מַלּ֨וּחַ֙", "transliteral": "mal-lû-aḥ", "traducao_palavra": "malva/erva salgada" },
        { "hebraico": "עֲלֵי־", "transliteral": "ʿă-lê-", "traducao_palavra": "junto a/sobre" },
        { "hebraico": "שִׂ֔יחַ", "transliteral": "śî-aḥ", "traducao_palavra": "arbusto" },
        { "hebraico": "וְשֹׁ֥רֶשׁ", "transliteral": "wə-šō-reš", "traducao_palavra": "e a raiz de" },
        { "hebraico": "רְתָמִ֖ים", "transliteral": "rə-ṯā-mîm", "traducao_palavra": "zimbros" },
        { "hebraico": "לַחְמָֽם׃", "transliteral": "laḥ-mām", "traducao_palavra": "[era] o pão/alimento deles" }
      ]
    },
    "5": {
      "traducao_completa": "Do meio dos homens eram expulsos; gritava-se contra eles, como contra um ladrão.",
      "palavras": [
        { "hebraico": "מִן־", "transliteral": "min-", "traducao_palavra": "De" },
        { "hebraico": "גֵּ֥ו", "transliteral": "gêw", "traducao_palavra": "meio [dos homens]" },
        { "hebraico": "יְגֹרָ֑שׁוּ", "transliteral": "yə-ḡō-rā-šû", "traducao_palavra": "eram expulsos" },
        { "hebraico": "יָרִ֥יעוּ", "transliteral": "yā-rî-ʿû", "traducao_palavra": "gritavam" },
        { "hebraico": "עָ֝לֵ֗ימֹו", "transliteral": "ʿā-lê-mô", "traducao_palavra": "contra eles" },
        { "hebraico": "כַּגַּנָּֽב׃", "transliteral": "kaḡ-gan-nāḇ", "traducao_palavra": "como [contra] o ladrão" }
      ]
    },
    "6": {
      "traducao_completa": "Para habitarem nos desfiladeiros dos vales, em cavernas da terra e das rochas.",
      "palavras": [
        { "hebraico": "בַּעֲר֤וּץ", "transliteral": "ba-ʿă-rûṣ", "traducao_palavra": "Nos desfiladeiros de" },
        { "hebraico": "נְחָלִ֨ים ׀", "transliteral": "nə-ḥā-lîm", "traducao_palavra": "vales/ribeiros" },
        { "hebraico": "לִשְׁכֹּ֑ן", "transliteral": "liš-kōn", "traducao_palavra": "para habitar" },
        { "hebraico": "חֹ֘רֵ֤i", "transliteral": "ḥō-rê", "traducao_palavra": "[em] buracos de" },
        { "hebraico": "עָפָ֬ר", "transliteral": "ʿā-p̄ār", "traducao_palavra": "pó/terra" },
        { "hebraico": "וְכֵפִֽים׃", "transliteral": "wə-ḵê-p̄îm", "traducao_palavra": "e rochas" }
      ]
    },
    "7": {
      "traducao_completa": "Bramavam entre os arbustos, e ajuntavam-se debaixo dos espinheiros.",
      "palavras": [
        { "hebraico": "בֵּין־", "transliteral": "bên-", "traducao_palavra": "Entre" },
        { "hebraico": "שִׂיחִ֥ים", "transliteral": "śî-ḥîm", "traducao_palavra": "[os] arbustos" },
        { "hebraico": "יִנְהָ֑קוּ", "transliteral": "yin-hā-qû", "traducao_palavra": "bramavam/zurravam" },
        { "hebraico": "תַּ֖חַת", "transliteral": "ta-ḥaṯ", "traducao_palavra": "debaixo de" },
        { "hebraico": "חָר֥וּל", "transliteral": "ḥā-rûl", "traducao_palavra": "urtigas/espinheiros" },
        { "hebraico": "יְסֻפָּֽחוּ׃", "transliteral": "yə-sup-pā-ḥû", "traducao_palavra": "ajuntavam-se" }
      ]
    },
    "8": {
      "traducao_completa": "Eram filhos de doidos, e filhos de gente sem nome, e da terra foram expulsos.",
      "palavras": [
        { "hebraico": "בְּנֵי־", "transliteral": "bə-nê-", "traducao_palavra": "Filhos de" },
        { "hebraico": "נָבָל", "transliteral": "nā-ḇāl", "traducao_palavra": "insensatos/doidos" },
        { "hebraico": "גַּם־", "transliteral": "gam-", "traducao_palavra": "também" },
        { "hebraico": "בְּנֵ֥i", "transliteral": "bə-nê", "traducao_palavra": "filhos de" },
        { "hebraico": "בְלִי־", "transliteral": "ḇəlî-", "traducao_palavra": "sem" },
        { "hebraico": "שֵׁ֑ם", "transliteral": "šêm", "traducao_palavra": "nome" },
        { "hebraico": "נִכְּא֝וּ", "transliteral": "nik-ʾû", "traducao_palavra": "foram açoitados/expulsos" },
        { "hebraico": "מִן־", "transliteral": "min-", "traducao_palavra": "da" },
        { "hebraico": "הָאָֽרֶץ׃", "transliteral": "hā-ʾā-reṣ", "traducao_palavra": "terra" }
      ]
    },
    "9": {
      "traducao_completa": "Mas agora sou a sua canção, e lhes sirvo de provérbio.",
