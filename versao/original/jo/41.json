        { "hebraico": "אֵ֝֗שׁ", "transliteral": "ʾêš", "traducao_palavra": "fogo" },
        { "hebraico": "יִתְמַלָּֽטוּ׃", "transliteral": "yiṯ-mal-lā-ṭû", "traducao_palavra": "saltam/escapam" }
      ]
    },
    "20": {
      "traducao_completa": "Das suas narinas sai fumaça, como de uma panela fervente, ou de uma caldeira.",
      "palavras": [
        { "hebraico": "מִ֭נְּחִירָיו", "transliteral": "min-nə-ḥî-rāyw", "traducao_palavra": "Das suas narinas" },
        { "hebraico": "יֵצֵ֣א", "transliteral": "yê-ṣê", "traducao_palavra": "sai" },
        { "hebraico": "עָשָׁ֑ן", "transliteral": "ʿā-šān", "traducao_palavra": "fumaça" },
        { "hebraico": "כְּד֥וּד", "transliteral": "kə-ḏûḏ", "traducao_palavra": "como panela" },
        { "hebraico": "נָ֝פ֗וּחַ", "transliteral": "nā-p̄û-aḥ", "traducao_palavra": "fervente" },
        { "hebraico": "וְאַגְמֹֽון׃", "transliteral": "wə-ʾaḡ-mōn", "traducao_palavra": "e juncos [queimam]" }
      ]
    },
    "21": {
      "traducao_completa": "O seu hálito acende os carvões; e da sua boca sai chama.",
      "palavras": [
        { "hebraico": "נַ֭פְשֹׁו", "transliteral": "nap̄-šô", "traducao_palavra": "O seu fôlego/hálito" },
        { "hebraico": "גֶּחָלִ֣ים", "transliteral": "ge-ḥā-lîm", "traducao_palavra": "carvões" },
        { "hebraico": "תְּלַהֵ֑ט", "transliteral": "tə-la-hêṭ", "traducao_palavra": "acende" },
        { "hebraico": "וְ֝לַ֗הַב", "transliteral": "wə-la-haḇ", "traducao_palavra": "e uma chama" },
        { "hebraico": "מִפִּ֥יו", "transliteral": "mip-pîw", "traducao_palavra": "da sua boca" },
        { "hebraico": "יֵצֵֽא׃", "transliteral": "yê-ṣê", "traducao_palavra": "sai" }
      ]
    },
    "22": {
      "traducao_completa": "No seu pescoço reside a força; e diante dele a dor salta de alegria.",
      "palavras": [
        { "hebraico": "בְּ֭צַוָּארֹו", "transliteral": "bə-ṣaw-wā-rô", "traducao_palavra": "No seu pescoço" },
        { "hebraico": "יָ֘לִ֤ין", "transliteral": "yā-lîn", "traducao_palavra": "pousa/reside" },
        { "hebraico": "עֹ֑ז", "transliteral": "ʿōz", "traducao_palavra": "[a] força" },
        { "hebraico": "וּ֝לְפָנָ֗יו", "transliteral": "ū-lə-p̄ā-nāyw", "traducao_palavra": "e diante dele" },
        { "hebraico": "תָּד֥וּץ", "transliteral": "tā-ḏûṣ", "traducao_palavra": "salta/dança" },
        { "hebraico": "דְּאָבָֽה׃", "transliteral": "də-ʾā-ḇā", "traducao_palavra": "[a] angústia/dor" }
      ]
    },
    "23": {
      "traducao_completa": "As partes pendentes da sua carne estão pegadas entre si; são firmes sobre ele, não se movem.",
      "palavras": [
        { "hebraico": "מַפְּלֵ֣i", "transliteral": "map-pə-lê", "traducao_palavra": "As dobras/partes de" },
        { "hebraico": "בְשָׂרֹ֣ו", "transliteral": "ḇə-śā-rô", "traducao_palavra": "sua carne" },
        { "hebraico": "דָבֵ֑קוּ", "transliteral": "ḏā-ḇê-qû", "traducao_palavra": "estão unidas" },
        { "hebraico": "יָצ֥וּק", "transliteral": "yā-ṣûq", "traducao_palavra": "[são] fundidas/firmes" },
        { "hebraico": "עָ֝לָ֗יו", "transliteral": "ʿā-lāyw", "traducao_palavra": "sobre ele" },
        { "hebraico": "בַּל־", "transliteral": "bal-", "traducao_palavra": "não" },
        { "hebraico": "יִמֹּֽוט׃", "transliteral": "yim-mô-wṭ", "traducao_palavra": "se movem" }
      ]
    },
    "24": {
      "traducao_completa": "O seu coração é firme como uma pedra, e firme como a mó de baixo.",
      "palavras": [
        { "hebraico": "לִבֹּ֥ו", "transliteral": "lib-bô", "traducao_palavra": "Seu coração [é]" },
        { "hebraico": "יָצ֥וּק", "transliteral": "yā-ṣûq", "traducao_palavra": "firme/fundido" },
        { "hebraico": "כְּמֹו־", "transliteral": "kə-mô-", "traducao_palavra": "como" },
        { "hebraico": "אָ֑בֶן", "transliteral": "ʾā-ḇen", "traducao_palavra": "pedra" },
        { "hebraico": "יָ֝צ֗וּק", "transliteral": "yā-ṣûq", "traducao_palavra": "firme" },
        { "hebraico": "כְּפֶ֣לַח", "transliteral": "kə-p̄e-laḥ", "traducao_palavra": "como a mó" },
        { "hebraico": "תַּחְתִּֽית׃", "transliteral": "taḥ-tîṯ", "traducao_palavra": "de baixo" }
      ]
    },
    "25": {
      "traducao_completa": "Levantando-se ele, tremem os valentes; por causa do pavor ficam fora de si.",
      "palavras": [
        { "hebraico": "מִ֭שֵּׂתֹו", "transliteral": "miś-śê-ṯô", "traducao_palavra": "Do seu levantar" },
        { "hebraico": "יָג֣וּרוּ", "transliteral": "yā-ḡû-rû", "traducao_palavra": "temem" },
        { "hebraico": "אֵילִ֑ים", "transliteral": "ʾê-lîm", "traducao_palavra": "[os] poderosos" },
        { "hebraico": "מִשְּׁבָרִ֥ים", "transliteral": "miš-šə-ḇā-rîm", "traducao_palavra": "pelos quebrantamentos/pavor" },
        { "hebraico": "יִתְחַטָּֽאוּ׃", "transliteral": "yiṯ-ḥaṭ-ṭā-ʾû", "traducao_palavra": "ficam purificados/fora de si" }
      ]
    },
    "26": {
      "traducao_completa": "Se a espada o alcançar, não poderá subsistir; nem a lança, nem o dardo, nem a couraça.",
      "palavras": [
        { "hebraico": "מַשִּׂיגֵ֣הוּ", "transliteral": "maś-śî-ḡê-hū", "traducao_palavra": "[Se] a alcança" },
        { "hebraico": "חֶ֭רֶב", "transliteral": "ḥe-reḇ", "traducao_palavra": "[a] espada" },
        { "hebraico": "בְּלִ֣י", "transliteral": "bə-lî", "traducao_palavra": "sem" },
        { "hebraico": "תָק֑וּם", "transliteral": "ṯā-qûm", "traducao_palavra": "que subsista" },
        { "hebraico": "חֲנִ֖ית", "transliteral": "ḥă-nîṯ", "traducao_palavra": "[nem] lança" },
        { "hebraico": "מַסָּ֣ע", "transliteral": "mas-śāʿ", "traducao_palavra": "dardo" },
        { "hebraico": "וְשִׁרְיָֽה׃", "transliteral": "wə-šir-yā", "traducao_palavra": "e couraça" }
      ]
    },
    "27": {
      "traducao_completa": "Para ele o ferro é como palha, e o bronze como madeira podre.",
      "palavras": [
        { "hebraico": "יַחְשֹׁ֣ב", "transliteral": "yaḥ-šōḇ", "traducao_palavra": "Ele considera" },
        { "hebraico": "לְתֶ֣בֶן", "transliteral": "lə-ṯe-ḇen", "traducao_palavra": "como palha" },
        { "hebraico": "בַּרְזֶ֑ל", "transliteral": "bar-zel", "traducao_palavra": "[o] ferro" },
        { "hebraico": "לְעֵ֖ץ", "transliteral": "lə-ʿêṣ", "traducao_palavra": "como madeira" },
        { "hebraico": "רִקָּבֹ֣ון", "transliteral": "riq-qā-ḇôn", "traducao_palavra": "podre" },
        { "hebraico": "נְחוּשָֽׁה׃", "transliteral": "nə-ḥû-šā", "traducao_palavra": "[o] bronze" }
      ]
    },
    "28": {
      "traducao_completa": "A seta o não fará fugir; as pedras das fundas se lhe tornam em pragana.",
      "palavras": [
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "Não" },
        { "hebraico": "יַבְרִיחֶ֥נּוּ", "transliteral": "yaḇ-rî-ḥen-nū", "traducao_palavra": "fará ele fugir" },
        { "hebraico": "בֶן־", "transliteral": "ḇen-", "traducao_palavra": "o filho de" },
        { "hebraico": "קָ֑שֶׁת", "transliteral": "qā-šeṯ", "traducao_palavra": "arco [seta]" },
        { "hebraico": "לְקַ֥שׁ", "transliteral": "lə-qaš", "traducao_palavra": "em palha/pragana" },
        { "hebraico": "נֶהְפְּכוּ־", "transliteral": "neh-pə-ḵû-", "traducao_palavra": "tornam-se" },
        { "hebraico": "לֹ֝ו", "transliteral": "lô", "traducao_palavra": "para ele" },
        { "hebraico": "אַבְנֵי־", "transliteral": "ʾaḇ-nê-", "traducao_palavra": "as pedras de" },
        { "hebraico": "קָֽלַע׃", "transliteral": "qā-laʿ", "traducao_palavra": "funda" }
      ]
    },
    "29": {
      "traducao_completa": "Os dardos são para ele como palha, e ri-se do brandir da lança.",
      "palavras": [
        { "hebraico": "כְּקַ֭שׁ", "transliteral": "kə-qaš", "traducao_palavra": "Como palha" },
        { "hebraico": "נֶחְשְׁב֣וּ", "transliteral": "neḥ-šə-ḇû", "traducao_palavra": "são considerados" },
        { "hebraico": "תֹותָ֑ח", "transliteral": "tō-w-ṯāḥ", "traducao_palavra": "[os] dardos/clavas" },
        { "hebraico": "וְ֝יִשְׂחַ֗ק", "transliteral": "wə-yiś-ḥaq", "traducao_palavra": "e ele ri" },
        { "hebraico": "לְרַ֣עַשׁ", "transliteral": "lə-ra-ʿaš", "traducao_palavra": "do brandir de" },
        { "hebraico": "כִּידֹֽון׃", "transliteral": "kî-ḏôn", "traducao_palavra": "lança/dardo" }
      ]
    },
    "30": {
      "traducao_completa": "Debaixo dele há pontas agudas; estende-se sobre a lama como um trilho de ferro.",
      "palavras": [
        { "hebraico": "תַּ֭חְתָּיו", "transliteral": "taḥ-tāyw", "traducao_palavra": "Debaixo dele" },
