        { "hebraico": "חָ֑רֶשׂ", "transliteral": "ḥā-reś", "traducao_palavra": "cacos/pedras agudas" },
        { "hebraico": "יִרְפַּ֥ד", "transliteral": "yir-pad", "traducao_palavra": "ele estende/deita" },
        { "hebraico": "חָ֝ר֗וּץ", "transliteral": "ḥā-rûṣ", "traducao_palavra": "um instrumento de trilhar" },
        { "hebraico": "עֲלֵי־", "transliteral": "ʿă-lê-", "traducao_palavra": "sobre" },
        { "hebraico": "טִֽיט׃", "transliteral": "ṭîṭ", "traducao_palavra": "[o] lodo/lama" }
      ]
    },
    "31": {
      "traducao_completa": "Faz ferver as profundezas, como uma panela; torna o mar como um pote de unguento.",
      "palavras": [
        { "hebraico": "יַרְתִּ֣יחַ", "transliteral": "yar-tî-aḥ", "traducao_palavra": "Faz ferver" },
        { "hebraico": "כַּסִּ֣יר", "transliteral": "kas-sîr", "traducao_palavra": "como panela" },
        { "hebraico": "מְצוּלָ֑ה", "transliteral": "mə-ṣû-lā", "traducao_palavra": "[a] profundeza" },
        { "hebraico": "יָ֝֗ם", "transliteral": "yām", "traducao_palavra": "[o] mar" },
        { "hebraico": "יָשִׂ֥ים", "transliteral": "yā-śîm", "traducao_palavra": "ele torna" },
        { "hebraico": "כַּמֶּרְקָחָֽה׃", "transliteral": "kam-mer-qā-ḥā", "traducao_palavra": "como um pote de unguento" }
      ]
    },
    "32": {
      "traducao_completa": "Caminho brilha após ele; parece que o abismo tem cãs.",
      "palavras": [
        { "hebraico": "אַ֭חֲרָיו", "transliteral": "ʾa-ḥă-rāyw", "traducao_palavra": "Atrás dele" },
        { "hebraico": "יָאִ֣יר", "transliteral": "yā-ʾîr", "traducao_palavra": "brilha" },
        { "hebraico": "נָתִ֑יב", "transliteral": "nā-ṯîḇ", "traducao_palavra": "[o] caminho" },
        { "hebraico": "יַחְשֹׁ֖ב", "transliteral": "yaḥ-šōḇ", "traducao_palavra": "pensaria" },
        { "hebraico": "תְּהֹ֣ום", "transliteral": "tə-hôm", "traducao_palavra": "[que o] abismo" },
        { "hebraico": "לְשֵׂיבָֽה׃", "transliteral": "lə-śê-ḇā", "traducao_palavra": "[tem] cãs/está branco" }
      ]
    },
    "33": {
      "traducao_completa": "Na terra não há quem se lhe assemelhe, pois foi feito para não ter medo.",
      "palavras": [
        { "hebraico": "אֵין־", "transliteral": "ʾên-", "traducao_palavra": "Não há" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre" },
        { "hebraico": "עָפָ֥ר", "transliteral": "ʿā-p̄ār", "traducao_palavra": "[o] pó/terra" },
        { "hebraico": "מָשְׁלֹ֑ו", "transliteral": "mā-šəlô", "traducao_palavra": "quem o domine/seu igual" },
        { "hebraico": "הֶ֝עָשׂ֗וּ", "transliteral": "he-ʿā-śû", "traducao_palavra": "foi feito" },
        { "hebraico": "לִבְלִי־", "transliteral": "li-ḇə-lî-", "traducao_palavra": "para [ser] sem" },
        { "hebraico": "חָֽת׃", "transliteral": "ḥāṯ", "traducao_palavra": "medo" }
      ]
    },
    "34": {
      "traducao_completa": "Ele vê tudo o que é alto; é rei sobre todos os filhos da soberba.",
      "palavras": [
        { "hebraico": "אֵת־", "transliteral": "ʾeṯ-", "traducao_palavra": "[objeto]" },
        { "hebraico": "כָּל־", "transliteral": "kāl-", "traducao_palavra": "tudo" },
        { "hebraico": "גָּבֹ֥הַּ", "transliteral": "gā-ḇō-ah", "traducao_palavra": "[o que é] alto" },
        { "hebraico": "יִרְאֶ֑ה", "transliteral": "yir-ʾeh", "traducao_palavra": "ele vê" },
        { "hebraico": "ה֝וּא", "transliteral": "hû", "traducao_palavra": "ele" },
        { "hebraico": "מֶ֗לֶךְ", "transliteral": "me-leḵ", "traducao_palavra": "[é] rei" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre" },
        { "hebraico": "כָּל־", "transliteral": "kāl-", "traducao_palavra": "todos" },
        { "hebraico": "בְּנֵי־", "transliteral": "bə-nê-", "traducao_palavra": "os filhos de" },
        { "hebraico": "שָֽׁחַץ׃", "transliteral": "šā-ḥaṣ", "traducao_palavra": "orgulho/soberba" }
