      "palavras": [
        { "hebraico": "תַּֽחַת־", "transliteral": "ta-ḥaṯ-", "traducao_palavra": "Debaixo de" },
        { "hebraico": "כָּל־", "transliteral": "kāl-", "traducao_palavra": "todos" },
        { "hebraico": "הַשָּׁמַ֥יִם", "transliteral": "haš-šā-ma-yim", "traducao_palavra": "os céus" },
        { "hebraico": "יִשְׁרֵ֑הוּ", "transliteral": "yiš-rê-hū", "traducao_palavra": "Ele o envia/solta" },
        { "hebraico": "וְ֝אֹורֹ֗ו", "transliteral": "wə-ʾô-rô", "traducao_palavra": "e a Sua luz" },
