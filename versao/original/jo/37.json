        { "hebraico": "יִשְׁאַג־", "transliteral": "yiš-ʾaḡ-", "traducao_palavra": "ruge/brama" },
        { "hebraico": "קֹ֗ול", "transliteral": "qôl", "traducao_palavra": "uma voz" },
        { "hebraico": "יַ֭רְעֵם", "transliteral": "yar-ʿêm", "traducao_palavra": "Ele troveja" },
        { "hebraico": "בְּקֹ֣ול", "transliteral": "bə-qôl", "traducao_palavra": "com a voz de" },
        { "hebraico": "גְּאֹונֹ֑ו", "transliteral": "gə-ʾô-nô", "traducao_palavra": "Sua majestade" },
        { "hebraico": "וְלֹ֥א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
