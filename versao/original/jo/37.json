        { "hebraico": "שִׁמְע֤וּ", "transliteral": "šim-ʿû", "traducao_palavra": "Ouvi" },
        { "hebraico": "שָׁמֹ֙ועַ֙", "transliteral": "šā-mô-aʿ", "traducao_palavra": "atentamente" },
        { "hebraico": "בְּרֹ֣גֶז", "transliteral": "bə-rō-ḡez", "traducao_palavra": "o estrondo de" },
        { "hebraico": "קֹלֹ֑ו", "transliteral": "qō-lô", "traducao_palavra": "Sua voz" },
        { "hebraico": "וְ֝הֶ֗גֶה", "transliteral": "wə-he-ḡeh", "traducao_palavra": "e o rumor [que]" },
        { "hebraico": "מִפִּ֥יו", "transliteral": "mip-pîw", "traducao_palavra": "da Sua boca" },
        { "hebraico": "יֵצֵֽא׃", "transliteral": "yê-ṣê", "traducao_palavra": "sai" }
      ]
    },
    "3": {
