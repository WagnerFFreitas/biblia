{
  "livro": "Jó - אִיּוֹב - ʾIy-yōḇ",
  "capítulo": 37,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Sobre isto também treme o meu coração, e salta do seu lugar.",
