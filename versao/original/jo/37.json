        { "hebraico": "אַף־", "transliteral": "ʾap̄-", "traducao_palavra": "Também/Sobre" },
        { "hebraico": "לְזֹאת", "transliteral": "lə-zōṯ", "traducao_palavra": "isto" },
        { "hebraico": "יֶחֱרַד", "transliteral": "ye-ḥĕ-raḏ", "traducao_palavra": "treme" },
        { "hebraico": "לִבִּ֕י", "transliteral": "lib-bî", "traducao_palavra": "meu coração" },
        { "hebraico": "וְיִתַּ֖ר", "transliteral": "wə-yit-tar", "traducao_palavra": "e salta" },
        { "hebraico": "מִמְּקֹומֹֽו׃", "transliteral": "mim-mə-qô-mô", "traducao_palavra": "do seu lugar" }
