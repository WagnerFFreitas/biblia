        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "Pois" },
        { "hebraico": "עַ֭תָּה", "transliteral": "ʿat-tā", "traducao_palavra": "agora" },
        { "hebraico": "צְעָדַ֣י", "transliteral": "ṣə-ʿā-ḏay", "traducao_palavra": "meus passos" },
        { "hebraico": "תִּסְפֹּ֑ור", "transliteral": "tis-pōr", "traducao_palavra": "contas" },
        { "hebraico": "לֹֽא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "תִ֝שְׁמֹ֗ור", "transliteral": "tiš-mōr", "traducao_palavra": "vigias" },
