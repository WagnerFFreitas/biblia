    "10": {
      "traducao_completa": "Mas o homem morre, e fica prostrado; sim, expira o homem, e onde está ele?",
      "palavras": [
        { "hebraico": "וְגֶ֣בֶר", "transliteral": "wə-ḡe-ḇer", "traducao_palavra": "Mas o varão" },
        { "hebraico": "יָ֭מוּת", "transliteral": "yā-mûṯ", "traducao_palavra": "morre" },
        { "hebraico": "וַֽיֶּחֱלָ֑שׁ", "transliteral": "way-ye-ḥĕ-lāš", "traducao_palavra": "e fica prostrado" },
        { "hebraico": "וַיִּגְוַ֥ע", "transliteral": "way-yiḡ-waʿ", "traducao_palavra": "e expira" },
        { "hebraico": "אָ֝דָ֗ם", "transliteral": "ʾā-ḏām", "traducao_palavra": "o homem" },
        { "hebraico": "וְאַיֹּֽו׃", "transliteral": "wə-ʾay-yô", "traducao_palavra": "e onde [está] ele?" }
      ]
    },
    "11": {
      "traducao_completa": "Como as águas se retiram do mar, e o rio se esgota e seca,",
      "palavras": [
        { "hebraico": "אָֽזְלוּ־", "transliteral": "ʾā-zə-lû-", "traducao_palavra": "Retiram-se" },
        { "hebraico": "מַ֥יִם", "transliteral": "ma-yim", "traducao_palavra": "as águas" },
        { "hebraico": "מִנִּי־", "transliteral": "min-nî-", "traducao_palavra": "do" },
        { "hebraico": "יָ֑ם", "transliteral": "yām", "traducao_palavra": "mar" },
        { "hebraico": "וְ֝נָהָ֗ר", "transliteral": "wə-nā-hār", "traducao_palavra": "e o rio" },
