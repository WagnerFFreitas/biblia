      ]
    },
    "13": {
      "traducao_completa": "Oxalá me escondesses na sepultura, e me ocultasses até que a tua ira se desviasse; e me pusesses um limite, e te lembrasses de mim!",
      "palavras": [
        { "hebraico": "מִ֤י־", "transliteral": "mî-", "traducao_palavra": "Quem" },
        { "hebraico": "יִתֵּ֨ן", "transliteral": "yit-tên", "traducao_palavra": "dera [Oxalá]" },
        { "hebraico": "בִּשְׁאֹ֗ול", "transliteral": "biš-ʾô-wl", "traducao_palavra": "na sepultura/Seol" },
        { "hebraico": "תַּצְפִּ֫נֵ֥נִי", "transliteral": "taṣ-pi-nê-nî", "traducao_palavra": "me escondesses" },
        { "hebraico": "תַּ֭סְתִּירֵנִי", "transliteral": "tas-tî-rê-nî", "traducao_palavra": "me ocultasses" },
        { "hebraico": "עַד־", "transliteral": "ʿaḏ-", "traducao_palavra": "até" },
        { "hebraico": "שׁ֥וּב", "transliteral": "šûḇ", "traducao_palavra": "o desviar/voltar de" },
        { "hebraico": "אַפֶּ֑ךָ", "transliteral": "ʾap-pe-ḵā", "traducao_palavra": "Tua ira" },
        { "hebraico": "תָּ֧שִׁית", "transliteral": "tā-šîṯ", "traducao_palavra": "[me] estabelecesses" },
        { "hebraico": "לִ֦י", "transliteral": "lî", "traducao_palavra": "para mim" },
        { "hebraico": "חֹ֝ק", "transliteral": "ḥōq", "traducao_palavra": "um limite/tempo" },
        { "hebraico": "וְתִזְכְּרֵֽנִי׃", "transliteral": "wə-ṯiz-kə-rê-nî", "traducao_palavra": "e Te lembrasses de mim" }
      ]
    },
    "14": {
      "traducao_completa": "Morrendo o homem, porventura tornará a viver? Todos os dias do meu combate esperaria, até que viesse a minha mudança.",
      "palavras": [
        { "hebraico": "אִם־", "transliteral": "ʾim-", "traducao_palavra": "Se" },
        { "hebraico": "יָמ֥וּת", "transliteral": "yā-mûṯ", "traducao_palavra": "morrer" },
        { "hebraico": "גֶּ֗בֶר", "transliteral": "ge-ḇer", "traducao_palavra": "o homem/varão" },
        { "hebraico": "הֲיִ֫חְיֶ֥ה", "transliteral": "hă-yiḥ-yeh", "traducao_palavra": "viveria ele?" },
        { "hebraico": "כָּל־", "transliteral": "kāl-", "traducao_palavra": "Todos" },
        { "hebraico": "יְמֵ֣i", "transliteral": "yə-mê", "traducao_palavra": "os dias de" },
        { "hebraico": "צְבָאִ֣י", "transliteral": "ṣə-ḇā-ʾî", "traducao_palavra": "meu serviço/combate" },
        { "hebraico": "אֲיַחֵ֑ל", "transliteral": "ʾă-ya-ḥêl", "traducao_palavra": "esperaria" },
        { "hebraico": "עַד־", "transliteral": "ʿaḏ-", "traducao_palavra": "até" },
        { "hebraico": "בֹּ֝וא", "transliteral": "bô-w", "traducao_palavra": "que viesse" },
        { "hebraico": "חֲלִיפָתִֽי׃", "transliteral": "ḥă-lî-p̄ā-ṯî", "traducao_palavra": "minha mudança/renovação" }
      ]
    },
    "15": {
      "traducao_completa": "Chamar-me-ias, e eu te responderia; terias saudades da obra das tuas mãos.",
      "palavras": [
        { "hebraico": "תִּקְרָא֮", "transliteral": "tiq-rā", "traducao_palavra": "Chamarias" },
        { "hebraico": "וְאָנֹכִ֪י", "transliteral": "wə-ʾā-nō-ḵî", "traducao_palavra": "e eu" },
        { "hebraico": "אֶֽעֱנֶ֫ךָּ֥", "transliteral": "ʾe-ʿĕ-nek-kā", "traducao_palavra": "Te responderia" },
        { "hebraico": "לְמַעֲשֵׂ֖ה", "transliteral": "lə-ma-ʿă-śê", "traducao_palavra": "pela obra de" },
        { "hebraico": "יָדֶ֣יךָ", "transliteral": "yā-ḏey-ḵā", "traducao_palavra": "Tuas mãos" },
        { "hebraico": "תִכְסֹֽף׃", "transliteral": "tiḵ-sōp̄", "traducao_palavra": "terias anseio/saudades" }
      ]
    },
    "16": {
      "traducao_completa": "Mas agora contas os meus passos; não vigias tu sobre o meu pecado?",
