      ]
    },
    "12": {
      "traducao_completa": "Assim o homem se deita, e não se levanta; até que não haja mais céus, não acordará nem se erguerá de seu sono.",
      "palavras": [
        { "hebraico": "וְאִ֬ישׁ", "transliteral": "wə-ʾîš", "traducao_palavra": "Assim o homem" },
        { "hebraico": "שָׁכַ֨ב", "transliteral": "šā-ḵaḇ", "traducao_palavra": "deita-se" },
        { "hebraico": "וְלֹא־", "transliteral": "wə-lō-", "traducao_palavra": "e não" },
        { "hebraico": "יָק֑וּם", "transliteral": "yā-qûm", "traducao_palavra": "levanta-se" },
        { "hebraico": "עַד־", "transliteral": "ʿaḏ-", "traducao_palavra": "até" },
        { "hebraico": "בִּלְתִּ֪י", "transliteral": "bil-tî", "traducao_palavra": "não mais [haja]" },
        { "hebraico": "שָׁ֘מַ֤יִם", "transliteral": "šā-ma-yim", "traducao_palavra": "céus" },
        { "hebraico": "לֹ֪א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "יָקִ֟יצוּ", "transliteral": "yā-qî-ṣû", "traducao_palavra": "acordarão" },
        { "hebraico": "וְלֹא־", "transliteral": "wə-lō-", "traducao_palavra": "nem" },
        { "hebraico": "יֵ֝עֹ֗רוּ", "transliteral": "yê-ʿō-rû", "traducao_palavra": "despertarão" },
