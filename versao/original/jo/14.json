{
  "livro": "Jó - אִיּוֹב - ʾIy-yōḇ",
  "capítulo": 14,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "O homem, nascido de mulher, é de poucos dias e farto de inquietação.",
      "palavras": [
        { "hebraico": "אָדָ֞ם", "transliteral": "ʾā-ḏām", "traducao_palavra": "O homem" },
        { "hebraico": "יְל֣וּד", "transliteral": "yə-lûḏ", "traducao_palavra": "nascido de" },
        { "hebraico": "אִשָּׁ֑ה", "transliteral": "ʾiš-šā", "traducao_palavra": "mulher" },
        { "hebraico": "קְצַ֥ר", "transliteral": "qə-ṣar", "traducao_palavra": "[é] curto de" },
        { "hebraico": "יָ֝מִ֗ים", "transliteral": "yā-mîm", "traducao_palavra": "dias" },
        { "hebraico": "וּשְׂבַֽע־", "transliteral": "ū-śə-ḇaʿ-", "traducao_palavra": "e farto de" },
        { "hebraico": "רֹֽגֶז׃", "transliteral": "rō-ḡez", "traducao_palavra": "inquietação/ira" }
      ]
    },
    "2": {
      "traducao_completa": "Sai como a flor, e murcha; foge também como a sombra, e não permanece.",
      "palavras": [
        { "hebraico": "כְּצִ֤יץ ׀", "transliteral": "kə-ṣîṣ", "traducao_palavra": "Como flor" },
        { "hebraico": "יָ֭צָא", "transliteral": "yā-ṣā", "traducao_palavra": "sai" },
        { "hebraico": "וַיִּמָּ֑ל", "transliteral": "way-yim-māl", "traducao_palavra": "e murcha/é cortada" },
        { "hebraico": "וַיִּבְרַ֥ח", "transliteral": "way-yiḇ-raḥ", "traducao_palavra": "e foge" },
        { "hebraico": "כַּ֝צֵּ֗ל", "transliteral": "kaṣ-ṣêl", "traducao_palavra": "como a sombra" },
        { "hebraico": "וְלֹ֣א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "יַעֲמֹֽוד׃", "transliteral": "ya-ʿă-mō-wḏ", "traducao_palavra": "permanece" }
      ]
    },
    "3": {
      "traducao_completa": "E sobre este tal abres os teus olhos, e a mim me fazes vir a juízo contigo?",
      "palavras": [
        { "hebraico": "אַף־", "transliteral": "ʾap̄-", "traducao_palavra": "Acaso" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre" },
        { "hebraico": "זֶ֭ה", "transliteral": "zeh", "traducao_palavra": "este" },
        { "hebraico": "פָּקַ֣חְתָּ", "transliteral": "pā-qaḥ-tā", "traducao_palavra": "abres" },
        { "hebraico": "עֵינֶ֑ךָ", "transliteral": "ʿê-ne-ḵā", "traducao_palavra": "Teus olhos" },
        { "hebraico": "וְאֹ֘תִ֤י", "transliteral": "wə-ʾō-ṯî", "traducao_palavra": "e a mim" },
        { "hebraico": "תָבִ֖יא", "transliteral": "ṯā-ḇî", "traducao_palavra": "fazes vir" },
        { "hebraico": "בְמִשְׁפָּ֣ט", "transliteral": "ḇə-miš-pāṭ", "traducao_palavra": "em juízo" },
        { "hebraico": "עִמָּֽךְ׃", "transliteral": "ʿim-māḵ", "traducao_palavra": "contigo?" }
      ]
    },
    "4": {
      "traducao_completa": "Quem do imundo tirará o puro? Ninguém.",
      "palavras": [
        { "hebraico": "מִֽי־", "transliteral": "mî-", "traducao_palavra": "Quem" },
        { "hebraico": "יִתֵּ֥ן", "transliteral": "yit-tên", "traducao_palavra": "poderia dar" },
        { "hebraico": "טָהֹ֗ור", "transliteral": "ṭā-hō-wr", "traducao_palavra": "[coisa] pura" },
        { "hebraico": "מִטָּמֵ֥א", "transliteral": "miṭ-ṭā-mê", "traducao_palavra": "do imundo?" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "Não" },
        { "hebraico": "אֶחָֽד׃", "transliteral": "ʾe-ḥāḏ", "traducao_palavra": "um só/ninguém" }
      ]
    },
    "5": {
      "traducao_completa": "Visto que os seus dias estão determinados, contigo está o número dos seus meses; tu lhe puseste limites, que não passará.",
      "palavras": [
        { "hebraico": "אִ֥ם", "transliteral": "ʾim", "traducao_palavra": "Visto que" },
        { "hebraico": "חֲרוּצִ֪ים", "transliteral": "ḥă-rû-ṣîm", "traducao_palavra": "estão determinados" },
        { "hebraico": "יָ֫מָ֥יו", "transliteral": "yā-māyw", "traducao_palavra": "os dias dele" },
        { "hebraico": "מִסְפַּר־", "transliteral": "mis-par-", "traducao_palavra": "[está] o número de" },
        { "hebraico": "חֳדָשָׁ֥יו", "transliteral": "ḥŏ-ḏā-šāyw", "traducao_palavra": "seus meses" },
        { "hebraico": "אִתָּ֑ךְ", "transliteral": "ʾit-tāḵ", "traducao_palavra": "contigo" },
        { "hebraico": "חֻקָּ֥ו", "transliteral": "ḥuq-qāw", "traducao_palavra": "seus limites" },
        { "hebraico": "עָ֝שִׂ֗יתָ", "transliteral": "ʿā-śî-ṯā", "traducao_palavra": "fixaste" },
        { "hebraico": "וְלֹ֣א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "יַעֲבֹֽור׃", "transliteral": "ya-ʿă-ḇō-wr", "traducao_palavra": "passará" }
      ]
    },
    "6": {
      "traducao_completa": "Desvia o teu rosto dele, para que tenha repouso, até que, como o jornaleiro, tenha prazer no seu dia.",
      "palavras": [
        { "hebraico": "שְׁעֵ֥ה", "transliteral": "šə-ʿê", "traducao_palavra": "Desvia [o olhar]" },
        { "hebraico": "מֵעָלָ֗יו", "transliteral": "mê-ʿā-lāyw", "traducao_palavra": "de sobre ele" },
        { "hebraico": "וְיֶחְדָּ֑ל", "transliteral": "wə-yeḥ-dāl", "traducao_palavra": "e ele descanse" },
        { "hebraico": "עַד־", "transliteral": "ʿaḏ-", "traducao_palavra": "até que" },
        { "hebraico": "יִרְצֶ֥ה", "transliteral": "yir-ṣeh", "traducao_palavra": "deseje/tenha prazer" },
        { "hebraico": "כְּ֝שָׂכִ֗יר", "transliteral": "kə-śā-ḵîr", "traducao_palavra": "como jornaleiro" },
        { "hebraico": "יֹומֹֽו׃", "transliteral": "yō-wmô", "traducao_palavra": "[no] seu dia" }
      ]
    },
    "7": {
      "traducao_completa": "Porque há esperança para a árvore que, se for cortada, ainda se renovará, e não cessarão os seus renovos.",
      "palavras": [
        { "hebraico": "כִּ֤י", "transliteral": "kî", "traducao_palavra": "Pois" },
        { "hebraico": "יֵשׁ־", "transliteral": "yêš-", "traducao_palavra": "há" },
        { "hebraico": "לָעֵ֨ץ", "transliteral": "lā-ʿêṣ", "traducao_palavra": "para a árvore" },
        { "hebraico": "תִּקְוָ֑ה", "transliteral": "tiq-wā", "traducao_palavra": "esperança" },
        { "hebraico": "אִם־", "transliteral": "ʾim-", "traducao_palavra": "se" },
        { "hebraico": "יִ֝כָּרֵ֗ת", "transliteral": "yik-kā-rêṯ", "traducao_palavra": "for cortada" },
        { "hebraico": "עֹ֣וד", "transliteral": "ʿô-wḏ", "traducao_palavra": "ainda" },
        { "hebraico": "יַחֲלִ֔יף", "transliteral": "ya-ḥă-lîp̄", "traducao_palavra": "se renovará" },
        { "hebraico": "וְיֹונַקְתֹּ֖ו", "transliteral": "wə-yō-w-naq-tô", "traducao_palavra": "e o seu broto" },
        { "hebraico": "לֹ֥א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "תֶחְדָּֽל׃", "transliteral": "ṯeḥ-dāl", "traducao_palavra": "cessará" }
      ]
    },
    "8": {
      "traducao_completa": "Se envelhecer na terra a sua raiz, e morrer o seu tronco no pó,",
      "palavras": [
        { "hebraico": "אִם־", "transliteral": "ʾim-", "traducao_palavra": "Se" },
        { "hebraico": "יַזְקִ֣ין", "transliteral": "yaz-qîn", "traducao_palavra": "envelhecer" },
        { "hebraico": "בָּאָ֣רֶץ", "transliteral": "bā-ʾā-reṣ", "traducao_palavra": "na terra" },
        { "hebraico": "שָׁרְשֹׁ֑ו", "transliteral": "šār-šô", "traducao_palavra": "a sua raiz" },
        { "hebraico": "וּ֝בֶעָפָ֗ר", "transliteral": "ū-ḇe-ʿā-p̄ār", "traducao_palavra": "e no pó" },
        { "hebraico": "יָמ֥וּת", "transliteral": "yā-mûṯ", "traducao_palavra": "morrer" },
        { "hebraico": "גִּזְעֹֽו׃", "transliteral": "giz-ʿô", "traducao_palavra": "o seu tronco" }
      ]
    },
    "9": {
      "traducao_completa": "Ao cheiro das águas brotará, e dará ramos como uma planta nova.",
      "palavras": [
        { "hebraico": "מֵרֵ֣יחַ", "transliteral": "mê-rê-aḥ", "traducao_palavra": "Ao cheiro de" },
        { "hebraico": "מַ֣יִם", "transliteral": "ma-yim", "traducao_palavra": "água" },
        { "hebraico": "יַפְרִ֑יחַ", "transliteral": "yap̄-rî-aḥ", "traducao_palavra": "brotará" },
        { "hebraico": "וְעָשָׂ֖ה", "transliteral": "wə-ʿā-śā", "traducao_palavra": "e dará" },
        { "hebraico": "קָצִ֣יר", "transliteral": "qā-ṣîr", "traducao_palavra": "ramos/folhagem" },
        { "hebraico": "כְּמֹו־", "transliteral": "kə-mô-", "traducao_palavra": "como" },
        { "hebraico": "נָֽטַע׃", "transliteral": "nā-ṭaʿ", "traducao_palavra": "planta nova" }
      ]
