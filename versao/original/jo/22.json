  "versiculos": {
    "1": {
      "traducao_completa": "Então respondeu Elifaz, o temanita, e disse:",
      "palavras": [
        { "hebraico": "וַיַּ֥עַן", "transliteral": "way-ya-ʿan", "traducao_palavra": "Então respondeu" },
