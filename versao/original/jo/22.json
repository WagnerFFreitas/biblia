        { "hebraico": "דְּרָכֶֽיךָ׃", "transliteral": "də-rā-ḵey-ḵā", "traducao_palavra": "teus caminhos?" }
      ]
    },
    "4": {
      "traducao_completa": "Porventura te repreende pelo teu temor de Deus, ou entra contigo em juízo por causa dele?",
      "palavras": [
        { "hebraico": "הֲמִיִּרְאָֽתְךָ", "transliteral": "hă-miy-yir-ʾā-ṯə-ḵā", "traducao_palavra": "Acaso pelo teu temor" },
        { "hebraico": "יֹוכִיחֶ֑ךָ", "transliteral": "yō-w-ḵî-ḥe-ḵā", "traducao_palavra": "repreende-te" },
        { "hebraico": "יָבֹ֖וא", "transliteral": "yā-ḇô-w", "traducao_palavra": "[e] entra" },
