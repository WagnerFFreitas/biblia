        { "hebraico": "לְשַׁ֭דַּי", "transliteral": "lə-šad-day", "traducao_palavra": "[tem o] Todo-Poderoso" },
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "que" },
        { "hebraico": "תִצְדָּ֑ק", "transliteral": "tiṣ-dāq", "traducao_palavra": "sejas justo?" },
        { "hebraico": "וְאִם־", "transliteral": "wə-ʾim-", "traducao_palavra": "ou" },
        { "hebraico": "בֶּ֝֗צַע", "transliteral": "be-ṣaʿ", "traducao_palavra": "lucro" },
