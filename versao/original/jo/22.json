        { "hebraico": "וְאִ֣ישׁ", "transliteral": "wə-ʾîš", "traducao_palavra": "E o homem de" },
        { "hebraico": "זְ֭רֹועַ", "transliteral": "zə-rô-aʿ", "traducao_palavra": "braço [poderoso]" },
        { "hebraico": "לֹ֣ו", "transliteral": "lô", "traducao_palavra": "para ele [era]" },
        { "hebraico": "הָאָ֑רֶץ", "transliteral": "hā-ʾā-reṣ", "traducao_palavra": "a terra" },
        { "hebraico": "וּנְשׂ֥וּא", "transliteral": "ū-nə-śû", "traducao_palavra": "e o favorecido/respeitável" },
        { "hebraico": "פָ֝נִ֗ים", "transliteral": "pā-nîm", "traducao_palavra": "de face" },
        { "hebraico": "יֵ֣שֶׁב", "transliteral": "yê-šeḇ", "traducao_palavra": "habitava" },
        { "hebraico": "בָּֽהּ׃", "transliteral": "bāh", "traducao_palavra": "nela" }
      ]
    },
    "9": {
      "traducao_completa": "As viúvas despediste vazias, e os braços dos órfãos foram quebrados.",
      "palavras": [
        { "hebraico": "אַלְמָנֹ֥ות", "transliteral": "ʾal-mā-nō-wṯ", "traducao_palavra": "Viúvas" },
