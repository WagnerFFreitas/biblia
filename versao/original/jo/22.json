        { "hebraico": "בַּמִּשְׁפָּֽט׃", "transliteral": "bam-miš-pāṭ", "traducao_palavra": "em juízo?" }
      ]
    },
    "5": {
      "traducao_completa": "Porventura não é grande a tua maldade, e infinitas as tuas iniquidades?",
      "palavras": [
        { "hebraico": "הֲלֹ֨א", "transliteral": "hă-lō", "traducao_palavra": "Acaso não" },
        { "hebraico": "רָעָתְךָ֥", "transliteral": "rā-ʿā-ṯə-ḵā", "traducao_palavra": "tua maldade" },
        { "hebraico": "רַבָּ֑ה", "transliteral": "rab-bā", "traducao_palavra": "[é] grande?" },
        { "hebraico": "וְאֵֽין־", "transliteral": "wə-ʾên-", "traducao_palavra": "e não [têm]" },
        { "hebraico": "קֵ֝֗ץ", "transliteral": "qêṣ", "traducao_palavra": "fim" },
        { "hebraico": "לַעֲוֹנֹתֶֽיךָ׃", "transliteral": "la-ʿă-wō-nō-ṯey-ḵā", "traducao_palavra": "as tuas iniquidades" }
      ]
    },
    "6": {
      "traducao_completa": "Porque sem causa penhoraste a teus irmãos, e aos nus despojaste das suas vestes.",
      "palavras": [
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "Porque" },
        { "hebraico": "תַחְבֹּ֣ל", "transliteral": "taḥ-bōl", "traducao_palavra": "tomaste penhor de" },
        { "hebraico": "אַחֶ֣יךָ", "transliteral": "ʾa-ḥey-ḵā", "traducao_palavra": "teus irmãos" },
        { "hebraico": "חִנָּ֑ם", "transliteral": "ḥin-nām", "traducao_palavra": "sem causa" },
        { "hebraico": "וּבִגְדֵ֖י", "transliteral": "ū-ḇiḡ-ḏê", "traducao_palavra": "e as vestes de" },
        { "hebraico": "עֲרוּמִּ֣ים", "transliteral": "ʿă-rûm-mîm", "traducao_palavra": "[os] nus" },
        { "hebraico": "תַּפְשִֽׁיט׃", "transliteral": "tap̄-šîṭ", "traducao_palavra": "despojaste" }
      ]
    },
    "7": {
      "traducao_completa": "Não deste de beber água ao cansado, e ao faminto retiveste o pão.",
      "palavras": [
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "Não" },
        { "hebraico": "מַ֭יִם", "transliteral": "ma-yim", "traducao_palavra": "água" },
        { "hebraico": "עָיֵ֣f", "transliteral": "ʿā-yêp̄", "traducao_palavra": "ao cansado" },
        { "hebraico": "תַּשְׁקֶ֑ה", "transliteral": "taš-qeh", "traducao_palavra": "deste a beber" },
        { "hebraico": "וּ֝מֵרָעֵ֗ב", "transliteral": "ū-mê-rā-ʿêḇ", "traducao_palavra": "e do faminto" },
        { "hebraico": "תִּמְנַֽע־", "transliteral": "tim-naʿ-", "traducao_palavra": "retiveste" },
        { "hebraico": "לָֽחֶם׃", "transliteral": "lā-ḥem", "traducao_palavra": "pão" }
      ]
    },
    "8": {
      "traducao_completa": "Mas para o homem poderoso era a terra, e o homem respeitável habitava nela.",
