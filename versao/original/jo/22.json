        { "hebraico": "אֹו־", "transliteral": "ʾô-", "traducao_palavra": "Ou" },
        { "hebraico": "חֹ֥שֶׁךְ", "transliteral": "ḥō-šeḵ", "traducao_palavra": "trevas" },
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "[pelas quais] não" },
        { "hebraico": "תִרְאֶ֑ה", "transliteral": "ṯir-ʾeh", "traducao_palavra": "vês" },
        { "hebraico": "וְשִׁפְעַת־", "transliteral": "wə-šip̄-ʿaṯ-", "traducao_palavra": "e a inundação de" },
        { "hebraico": "מַ֥יִם", "transliteral": "ma-yim", "traducao_palavra": "águas" },
        { "hebraico": "תְּכַסֶּֽךָּ׃", "transliteral": "tə-ḵas-śek-kā", "traducao_palavra": "te cobre" }
      ]
    },
    "12": {
      "traducao_completa": "Porventura não está Deus na altura dos céus? E olha para o cume das estrelas, quão altas estão.",
      "palavras": [
        { "hebraico": "הֲלֹא־", "transliteral": "hă-lō-", "traducao_palavra": "Acaso não" },
        { "hebraico": "אֱ֭לֹוהַּ", "transliteral": "ʾĕ-lō-hwah", "traducao_palavra": "Deus" },
        { "hebraico": "גֹּ֣בַהּ", "transliteral": "gō-ḇah", "traducao_palavra": "[na] altura de" },
        { "hebraico": "שָׁמָ֑יִם", "transliteral": "šā-mā-yim", "traducao_palavra": "céus?" },
        { "hebraico": "וּרְאֵ֤ה", "transliteral": "ū-rə-ʾêh", "traducao_palavra": "E vê" },
        { "hebraico": "רֹ֨אשׁ", "transliteral": "rōš", "traducao_palavra": "o topo de" },
        { "hebraico": "כֹּ֝וכָבִ֗ים", "transliteral": "kō-w-ḵā-ḇîm", "traducao_palavra": "estrelas" },
        { "hebraico": "כִּי־", "transliteral": "kî-", "traducao_palavra": "que" },
        { "hebraico": "רָ֧מּוּ׃", "transliteral": "rām-mû", "traducao_palavra": "estão altas" }
      ]
    },
    "13": {
      "traducao_completa": "E dizes: Que sabe Deus? Porventura julgará ele através da escuridão?",
      "palavras": [
        { "hebraico": "וְאָ֭מַרְתָּ", "transliteral": "wə-ʾā-mar-tā", "traducao_palavra": "E dizes" },
        { "hebraico": "מַה־", "transliteral": "mah-", "traducao_palavra": "O que" },
        { "hebraico": "יָּ֣דַע", "transliteral": "yā-ḏaʿ", "traducao_palavra": "sabe" },
        { "hebraico": "אֵ֑ל", "transliteral": "ʾêl", "traducao_palavra": "Deus?" },
        { "hebraico": "הַבְעַ֖ד", "transliteral": "ha-ḇə-ʿaḏ", "traducao_palavra": "Acaso através de" },
        { "hebraico": "עֲרָפֶ֣ל", "transliteral": "ʿă-rā-p̄el", "traducao_palavra": "nuvem densa/escuridão" },
        { "hebraico": "יִשְׁפֹּֽוט׃", "transliteral": "yiš-pô-wṭ", "traducao_palavra": "julgará Ele?" }
