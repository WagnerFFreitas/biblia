        { "hebraico": "וְלֹ֣א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "יִרְאֶ֑ה", "transliteral": "yir-ʾeh", "traducao_palavra": "vê" },
        { "hebraico": "וְח֣וּג", "transliteral": "wə-ḥûḡ", "traducao_palavra": "e o circuito/abóbada de" },
        { "hebraico": "שָׁמַ֝יִם", "transliteral": "šā-ma-yim", "traducao_palavra": "céus" },
        { "hebraico": "יִתְהַלָּֽךְ׃", "transliteral": "yiṯ-hal-lāḵ", "traducao_palavra": "Ele percorre" }
      ]
    },
    "15": {
      "traducao_completa": "Porventura queres guardar a vereda antiga, que pisaram os homens iníquos?",
      "palavras": [
        { "hebraico": "הַאֳֹרַח־", "transliteral": "ha-ʾo-raḥ-", "traducao_palavra": "Acaso a vereda" },
        { "hebraico": "עֹולָ֥ם", "transliteral": "ʿô-w-lām", "traducao_palavra": "antiga/eterna" },
        { "hebraico": "תִּשְׁמֹ֑ר", "transliteral": "tiš-mōr", "traducao_palavra": "guardarás?" },
        { "hebraico": "אֲשֶׁ֖ר", "transliteral": "ʾă-šer", "traducao_palavra": "que" },
        { "hebraico": "דָּרְכ֥וּ", "transliteral": "ḏā-rə-ḵû", "traducao_palavra": "pisaram" },
        { "hebraico": "מְתֵי־", "transliteral": "mə-ṯê-", "traducao_palavra": "homens de" },
