        { "hebraico": "הַתֵּימָנִ֑i", "transliteral": "hat-tê-mā-nî", "traducao_palavra": "o temanita" },
        { "hebraico": "וַיֹּאמַֽר׃", "transliteral": "way-yō-mar", "traducao_palavra": "e disse" }
      ]
    },
    "2": {
      "traducao_completa": "Porventura pode o homem ser útil a Deus? Antes o sábio é útil a si mesmo.",
