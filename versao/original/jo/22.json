      ]
    },
    "16": {
      "traducao_completa": "Os quais foram arrebatados antes do tempo; o seu fundamento um rio o subverteu.",
      "palavras": [
        { "hebraico": "אֲשֶׁר־", "transliteral": "ʾă-šer-", "traducao_palavra": "Os quais" },
        { "hebraico": "קֻמְּטוּ", "transliteral": "qum-mə-ṭû", "traducao_palavra": "foram arrebatados" },
        { "hebraico": "וְלֹא־", "transliteral": "wə-lō-", "traducao_palavra": "e não [era]" },
        { "hebraico": "עֵת", "transliteral": "ʿêṯ", "traducao_palavra": "o tempo" },
        { "hebraico": "נָהָר", "transliteral": "nā-hār", "traducao_palavra": "[como] um rio" },
        { "hebraico": "יוּצַק", "transliteral": "yû-ṣaq", "traducao_palavra": "foi derramado/subvertido" },
        { "hebraico": "יְסֹודָם׃", "transliteral": "yə-śô-ḏām", "traducao_palavra": "o fundamento deles" }
      ]
    },
    "17": {
      "traducao_completa": "Diziam a Deus: Retira-te de nós. E: Que pode o Todo-Poderoso fazer por nós?",
      "palavras": [
        { "hebraico": "הָאֹמְרִ֣ים", "transliteral": "hā-ʾō-mə-rîm", "traducao_palavra": "[Aqueles que] diziam" },
        { "hebraico": "לָ֭אֵל", "transliteral": "lā-ʾêl", "traducao_palavra": "a Deus" },
        { "hebraico": "ס֣וּר", "transliteral": "śûr", "traducao_palavra": "Retira-te" },
        { "hebraico": "מִמֶּ֑נּוּ", "transliteral": "mim-men-nû", "traducao_palavra": "de nós" },
        { "hebraico": "וּמַה־", "transliteral": "ū-mah-", "traducao_palavra": "e o que" },
        { "hebraico": "יִּפְעַ֖ל", "transliteral": "yip̄-ʿal", "traducao_palavra": "faria" },
        { "hebraico": "שַׁדַּ֣י", "transliteral": "šad-day", "traducao_palavra": "[o] Todo-Poderoso" },
        { "hebraico": "לָֽמֹו׃", "transliteral": "lā-mô", "traducao_palavra": "por eles?" }
      ]
    },
    "18": {
      "traducao_completa": "Contudo ele encheu as suas casas de bens; mas longe de mim esteja o conselho dos ímpios.",
