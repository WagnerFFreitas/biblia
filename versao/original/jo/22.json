        { "hebraico": "רֵיקָ֑ם", "transliteral": "rê-qām", "traducao_palavra": "vazias" },
        { "hebraico": "וּזְרֹעֹ֖ות", "transliteral": "ū-zə-rō-ʿō-wṯ", "traducao_palavra": "e os braços de" },
        { "hebraico": "יְתֹמִ֣ים", "transliteral": "yə-ṯō-mîm", "traducao_palavra": "órfãos" },
        { "hebraico": "יְדֻכָּֽא׃", "transliteral": "yə-ḏuk-kā", "traducao_palavra": "foram esmagados/quebrados" }
      ]
    },
    "10": {
      "traducao_completa": "Por isso é que estás cercado de laços, e o pavor repentino te perturba,",
      "palavras": [
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "Por" },
        { "hebraico": "כֵּ֭ן", "transliteral": "kên", "traducao_palavra": "isso" },
        { "hebraico": "סְבִיבֹותֶ֣יךָ", "transliteral": "śə-ḇî-ḇō-w-ṯey-ḵā", "traducao_palavra": "ao teu redor" },
        { "hebraico": "פַחִ֑ים", "transliteral": "p̄a-ḥîm", "traducao_palavra": "[há] laços" },
        { "hebraico": "וִֽיבַהֶלְךָ֥", "transliteral": "wî-ḇa-hel-ḵā", "traducao_palavra": "e perturba-te" },
        { "hebraico": "פַּ֝֗חַד", "transliteral": "pa-ḥaḏ", "traducao_palavra": "[o] pavor" },
