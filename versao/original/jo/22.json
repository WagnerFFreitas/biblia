        { "hebraico": "יִסְכָּן־", "transliteral": "yis-kān-", "traducao_palavra": "seria útil" },
        { "hebraico": "גָּ֑בֶר", "transliteral": "gā-ḇer", "traducao_palavra": "um homem?" },
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "Pois" },
        { "hebraico": "יִסְכֹּ֖ן", "transliteral": "yis-kōn", "traducao_palavra": "é útil" },
        { "hebraico": "עָלֵ֣ימֹו", "transliteral": "ʿā-lê-mô", "traducao_palavra": "sobre si mesmo" },
        { "hebraico": "מַשְׂכִּֽיל׃", "transliteral": "maś-kîl", "traducao_palavra": "[o] sábio" }
      ]
    },
    "3": {
      "traducao_completa": "Tem o Todo-Poderoso prazer em que tu sejas justo, ou lucro em que faças perfeitos os teus caminhos?",
