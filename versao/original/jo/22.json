        { "hebraico": "וְה֤וּא", "transliteral": "wə-hû", "traducao_palavra": "Contudo Ele" },
        { "hebraico": "מִלֵּ֣א", "transliteral": "mil-lê", "traducao_palavra": "encheu" },
        { "hebraico": "בָתֵּיהֶ֣ם", "transliteral": "ḇāt-tê-hem", "traducao_palavra": "as casas deles de" },
        { "hebraico": "טֹ֑וב", "transliteral": "ṭôḇ", "traducao_palavra": "bem" },
        { "hebraico": "וַעֲצַ֥ת", "transliteral": "wa-ʿă-ṣaṯ", "traducao_palavra": "mas o conselho de" },
        { "hebraico": "רְ֝שָׁעִ֗ים", "transliteral": "rə-šā-ʿîm", "traducao_palavra": "ímpios" },
        { "hebraico": "רָ֣חֲקָה", "transliteral": "rā-ḥă-qā", "traducao_palavra": "está longe" },
        { "hebraico": "מֶֽנִּי׃", "transliteral": "men-nî", "traducao_palavra": "de mim" }
      ]
    },
    "19": {
      "traducao_completa": "Os justos o veem, e se alegram, e o inocente escarnece deles.",
      "palavras": [
        { "hebraico": "יִרְא֧וּ", "transliteral": "yir-ʾû", "traducao_palavra": "Veem" },
        { "hebraico": "צַדִּיקִ֣ים", "transliteral": "ṣad-dî-qîm", "traducao_palavra": "[os] justos" },
        { "hebraico": "וְיִשְׂמָ֑חוּ", "transliteral": "wə-yiś-mā-ḥû", "traducao_palavra": "e se alegram" },
        { "hebraico": "וְ֝נָקִ֗י", "transliteral": "wə-nā-qî", "traducao_palavra": "e o inocente" },
        { "hebraico": "יִלְעַג־", "transliteral": "yil-ʿaḡ-", "traducao_palavra": "zombará" },
        { "hebraico": "לָֽמֹו׃", "transliteral": "lā-mô", "traducao_palavra": "deles" }
      ]
    },
    "20": {
      "traducao_completa": "Porventura não foi cortado o que se levantou contra nós? E o fogo consumiu o que deles ficou.",
      "palavras": [
        { "hebraico": "אִם־", "transliteral": "ʾim-", "traducao_palavra": "Porventura" },
        { "hebraico": "לֹא", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "נִכְחַ֣ד", "transliteral": "niḵ-ḥaḏ", "traducao_palavra": "foi cortado/destruído" },
        { "hebraico": "קִימָ֑נוּ", "transliteral": "qî-mā-nû", "traducao_palavra": "o nosso adversário/o que se levantou" },
        { "hebraico": "וְ֝יִתְרָ֗ם", "transliteral": "wə-yiṯ-rām", "traducao_palavra": "e o resto deles" },
        { "hebraico": "אָכְלָ֥ה", "transliteral": "ʾā-ḵəlā", "traducao_palavra": "consumiu" },
        { "hebraico": "אֵֽשׁ׃", "transliteral": "ʾêš", "traducao_palavra": "[o] fogo" }
      ]
    },
    "21": {
      "traducao_completa": "Reconcilia-te, pois, com ele, e tem paz, e assim te sobrevirá o bem.",
      "palavras": [
        { "hebraico": "הַסְכֶּן־", "transliteral": "has-ken-", "traducao_palavra": "Reconcilia-te" },
        { "hebraico": "נָ֭א", "transliteral": "nā", "traducao_palavra": "agora/rogo-te" },
        { "hebraico": "עִמֹּ֣ו", "transliteral": "ʿim-mô", "traducao_palavra": "com Ele" },
        { "hebraico": "וּשְׁלָ֑ם", "transliteral": "ū-šəlām", "traducao_palavra": "e tem paz" },
        { "hebraico": "בָּ֝הֶ֗ם", "transliteral": "bā-hem", "traducao_palavra": "através disso" },
        { "hebraico": "תְּבֹואַתְךָ֥", "transliteral": "tə-ḇô-ʾaṯ-ḵā", "traducao_palavra": "virá a ti" },
        { "hebraico": "טֹובָֽה׃", "transliteral": "ṭô-ḇā", "traducao_palavra": "[o] bem" }
      ]
    },
    "22": {
      "traducao_completa": "Recebe, peço-te, a lei da sua boca, e põe as suas palavras no teu coração.",
      "palavras": [
        { "hebraico": "קַח־", "transliteral": "qaḥ-", "traducao_palavra": "Recebe" },
        { "hebraico": "נָ֣א", "transliteral": "nā", "traducao_palavra": "agora/rogo-te" },
        { "hebraico": "מִפִּ֣יו", "transliteral": "mip-pîw", "traducao_palavra": "da boca d'Ele" },
        { "hebraico": "תֹּורָ֑ה", "transliteral": "tō-rā", "traducao_palavra": "[a] lei" },
        { "hebraico": "וְשִׂ֥ים", "transliteral": "wə-śîm", "traducao_palavra": "e põe" },
        { "hebraico": "אֲ֝מָרָ֗יו", "transliteral": "ʾă-mā-rāyw", "traducao_palavra": "as palavras d'Ele" },
        { "hebraico": "בִּלְבָבֶֽךָ׃", "transliteral": "bil-ḇā-ḇe-ḵā", "traducao_palavra": "no teu coração" }
      ]
    },
    "23": {
      "traducao_completa": "Se te voltares ao Todo-Poderoso, serás edificado; afasta a iniquidade da tua tenda.",
      "palavras": [
        { "hebraico": "אִם־", "transliteral": "ʾim-", "traducao_palavra": "Se" },
        { "hebraico": "תָּשׁ֣וּב", "transliteral": "tā-šûḇ", "traducao_palavra": "voltares" },
        { "hebraico": "עַד־", "transliteral": "ʿaḏ-", "traducao_palavra": "até" },
        { "hebraico": "שַׁ֭דַּי", "transliteral": "šad-day", "traducao_palavra": "[o] Todo-Poderoso" },
        { "hebraico": "תִּבָּנֶ֑ה", "transliteral": "tib-bā-neh", "traducao_palavra": "serás edificado" },
        { "hebraico": "תַּרְחִ֥יק", "transliteral": "tar-ḥîq", "traducao_palavra": "[se] afastares" },
        { "hebraico": "עַ֝וְלָה", "transliteral": "ʿaw-lā", "traducao_palavra": "a iniquidade" },
        { "hebraico": "מֵאָהֳלֶֽךָ׃", "transliteral": "mê-ʾā-hŏ-le-ḵā", "traducao_palavra": "da tua tenda" }
      ]
    },
    "24": {
      "traducao_completa": "E lança o teu ouro no pó, e o ouro de Ofir entre as pedras dos ribeiros.",
      "palavras": [
        { "hebraico": "וְשִׁית־", "transliteral": "wə-šîṯ-", "traducao_palavra": "E lança" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre" },
        { "hebraico": "עָפָ֥ר", "transliteral": "ʿā-p̄ār", "traducao_palavra": "[o] pó" },
        { "hebraico": "בָּ֑צֶר", "transliteral": "bā-ṣer", "traducao_palavra": "[o teu] ouro/preciosidade" },
        { "hebraico": "וּבְצ֥וּר", "transliteral": "ū-ḇə-ṣûr", "traducao_palavra": "e entre a rocha de" },
        { "hebraico": "נְ֝חָלִ֗ים", "transliteral": "nə-ḥā-lîm", "traducao_palavra": "ribeiros" },
        { "hebraico": "אֹופִֽיר׃", "transliteral": "ʾô-p̄îr", "traducao_palavra": "[o ouro de] Ofir" }
      ]
    },
    "25": {
      "traducao_completa": "E o Todo-Poderoso será o teu ouro, e a tua prata preciosa.",
      "palavras": [
        { "hebraico": "וְהָיָה֮", "transliteral": "wə-hā-yā", "traducao_palavra": "E será" },
        { "hebraico": "שַׁדַּ֪י", "transliteral": "šad-day", "traducao_palavra": "o Todo-Poderoso" },
        { "hebraico": "בְּצָ֫רֶ֥יךָ", "transliteral": "bə-ṣā-rey-ḵā", "traducao_palavra": "teu ouro/defesa" },
        { "hebraico": "וְכֶ֖סֶף", "transliteral": "wə-ḵe-sep̄", "traducao_palavra": "e prata" },
        { "hebraico": "תֹּועָפֹ֥ות", "transliteral": "tô-w-ʿā-p̄ō-wṯ", "traducao_palavra": "de altas montanhas/preciosa" },
        { "hebraico": "לָֽךְ׃", "transliteral": "lāḵ", "traducao_palavra": "para ti" }
      ]
    },
    "26": {
      "traducao_completa": "Porque então te deleitarás no Todo-Poderoso, e levantarás o teu rosto para Deus.",
      "palavras": [
        { "hebraico": "כִּי־", "transliteral": "kî-", "traducao_palavra": "Porque" },
        { "hebraico": "אָ֭ז", "transliteral": "ʾāz", "traducao_palavra": "então" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "no" },
        { "hebraico": "שַׁדַּ֣י", "transliteral": "šad-day", "traducao_palavra": "Todo-Poderoso" },
        { "hebraico": "תִּתְעַנָּ֑ג", "transliteral": "tiṯ-ʿan-nāḡ", "traducao_palavra": "te deleitarás" },
        { "hebraico": "וְתִשָּׂ֖א", "transliteral": "wə-ṯiś-śā", "traducao_palavra": "e levantarás" },
        { "hebraico": "אֶל־", "transliteral": "ʾel-", "traducao_palavra": "para" },
        { "hebraico": "אֱלֹ֣והַּ", "transliteral": "ʾĕ-lō-ah", "traducao_palavra": "Deus" },
        { "hebraico": "פָּנֶֽיךָ׃", "transliteral": "pā-ney-ḵā", "traducao_palavra": "teu rosto" }
      ]
    },
    "27": {
      "traducao_completa": "Tu lhe suplicarás, e ele te ouvirá; e pagarás os teus votos.",
      "palavras": [
        { "hebraico": "תַּעְתִּ֣יר", "transliteral": "taʿ-tîr", "traducao_palavra": "Suplicarás" },
        { "hebraico": "אֵ֭לָיו", "transliteral": "ʾê-lāyw", "traducao_palavra": "a Ele" },
        { "hebraico": "וְיִשְׁמָעֶ֑ךָּ", "transliteral": "wə-yiš-mā-ʿek-kā", "traducao_palavra": "e Ele te ouvirá" },
        { "hebraico": "וּנְדָרֶ֥יךָ", "transliteral": "ū-nə-ḏā-rey-ḵā", "traducao_palavra": "e teus votos" },
        { "hebraico": "תְשַׁלֵּֽם׃", "transliteral": "ṯə-šal-lêm", "traducao_palavra": "pagarás" }
      ]
    },
    "28": {
      "traducao_completa": "Decretarás uma coisa, e ela te será estabelecida; e a luz resplandecerá em teus caminhos.",
      "palavras": [
        { "hebraico": "וְתִגְזַר־", "transliteral": "wə-ṯiḡ-zar-", "traducao_palavra": "E decretarás" },
        { "hebraico": "אֹ֭ומֶר", "transliteral": "ʾô-mer", "traducao_palavra": "uma palavra/coisa" },
        { "hebraico": "וְיָ֣קָם", "transliteral": "wə-yā-qām", "traducao_palavra": "e ela subsistirá/será firme" },
        { "hebraico": "לָ֑ךְ", "transliteral": "lāḵ", "traducao_palavra": "para ti" },
        { "hebraico": "וְעַל־", "transliteral": "wə-ʿal-", "traducao_palavra": "e sobre" },
        { "hebraico": "דְּ֝רָכֶ֗יךָ", "transliteral": "də-rā-ḵey-ḵā", "traducao_palavra": "teus caminhos" },
        { "hebraico": "נָ֣גַהּ", "transliteral": "nā-ḡah", "traducao_palavra": "resplandecerá" },
        { "hebraico": "אֹֽור׃", "transliteral": "ʾôr", "traducao_palavra": "[a] luz" }
      ]
    },
    "29": {
      "traducao_completa": "Quando te abaterem, dirás: Haja exaltação! E Deus salvará ao humilde.",
      "palavras": [
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "Pois [quando]" },
        { "hebraico": "הִ֭שְׁפִּילוּ", "transliteral": "hiš-pî-lû", "traducao_palavra": "forem abatidos" },
        { "hebraico": "וַתֹּ֣אמֶר", "transliteral": "wat-tō-mer", "traducao_palavra": "então dirás" },
        { "hebraico": "גֵּוָ֑ה", "transliteral": "ḡê-wā", "traducao_palavra": "exaltação/levantar" },
        { "hebraico": "וְשַׁ֥ח", "transliteral": "wə-šaḥ", "traducao_palavra": "e o humilde de" },
        { "hebraico": "עֵ֝ינַיִם", "transliteral": "ʿê-na-yim", "traducao_palavra": "olhos" },
        { "hebraico": "יֹושִֽׁעַ׃", "transliteral": "yô-šî-aʿ", "traducao_palavra": "Ele salvará" }
      ]
    },
    "30": {
      "traducao_completa": "Livrará até ao que não é inocente; sim, ele será libertado pela pureza de tuas mãos.",
      "palavras": [
        { "hebraico": "יְמַלֵּ֥ט", "transliteral": "yə-mal-lêṭ", "traducao_palavra": "Ele livrará" },
        { "hebraico": "אִֽי־", "transliteral": "ʾî-", "traducao_palavra": "[até] aquele que não [é]" },
        { "hebraico": "נָקִ֑י", "transliteral": "nā-qî", "traducao_palavra": "inocente" },
        { "hebraico": "וְ֝נִמְלַ֗ט", "transliteral": "wə-nim-laṭ", "traducao_palavra": "e será libertado" },
        { "hebraico": "בְּבֹ֣ר", "transliteral": "bə-ḇōr", "traducao_palavra": "pela pureza de" },
        { "hebraico": "כַּפֶּֽיךָ׃", "transliteral": "kap-pey-ḵā", "traducao_palavra": "tuas mãos" }
      ]
    }
  }
}