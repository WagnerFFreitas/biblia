        { "hebraico": "ה֑וּא", "transliteral": "hû", "traducao_palavra": "estão" },
        { "hebraico": "וְ֝עֶ֗בֶד", "transliteral": "wə-ʿe-ḇeḏ", "traducao_palavra": "e o servo" },
