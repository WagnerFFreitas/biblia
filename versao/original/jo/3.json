        { "hebraico": "אֹ֑ור", "transliteral": "ʾôr", "traducao_palavra": "luz" },
        { "hebraico": "וְ֝חַיִּ֗ים", "transliteral": "wə-ḥay-yîm", "traducao_palavra": "e vida" },
