        { "hebraico": "לְמֶ֤לֶךְ", "transliteral": "lə-me-leḵ", "traducao_palavra": "a um rei" },
        { "hebraico": "בְּלִיָּ֑עַל", "transliteral": "bə-lî-yā-ʿal", "traducao_palavra": "[tu és] vil/perverso?" },
        { "hebraico": "רָ֝שָׁ֗ע", "transliteral": "rā-šāʿ", "traducao_palavra": "ímpio" },
        { "hebraico": "אֶל־", "transliteral": "ʾel-", "traducao_palavra": "para" },
        { "hebraico": "נְדִיבִֽים׃", "transliteral": "nə-ḏî-ḇîm", "traducao_palavra": "nobres/príncipes?" }
      ]
    },
    "19": {
      "traducao_completa": "Quanto menos àquele, que não faz acepção das pessoas de príncipes, nem estima o rico mais do que o pobre; porque todos são obras de suas mãos.",
      "palavras": [
        { "hebraico": "אֲשֶׁ֤ר", "transliteral": "ʾă-šer", "traducao_palavra": "Aquele que" },
        { "hebraico": "לֹֽא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "נָשָׂ֨א", "transliteral": "nā-śā", "traducao_palavra": "faz" },
        { "hebraico": "פְּנֵ֣i", "transliteral": "pə-nê", "traducao_palavra": "acepção de" },
        { "hebraico": "שָׂרִים֮", "transliteral": "śā-rîm", "traducao_palavra": "príncipes" },
        { "hebraico": "וְלֹ֥א", "transliteral": "wə-lō", "traducao_palavra": "nem" },
        { "hebraico": "נִכַּר־", "transliteral": "nik-kar-", "traducao_palavra": "reconhece/favorece" },
        { "hebraico": "שֹׁ֗ועַ", "transliteral": "šô-w-aʿ", "traducao_palavra": "[o] rico" },
        { "hebraico": "לִפְנֵי־", "transliteral": "lip̄-nê-", "traducao_palavra": "diante do" },
        { "hebraico": "דָ֥ל", "transliteral": "ḏāl", "traducao_palavra": "pobre" },
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "pois" },
        { "hebraico": "מַעֲשֵׂ֥h", "transliteral": "ma-ʿă-śê", "traducao_palavra": "obra de" },
        { "hebraico": "יָדָ֝יו", "transliteral": "yā-ḏāyw", "traducao_palavra": "Suas mãos" },
        { "hebraico": "כֻּלָּֽם׃", "transliteral": "kul-lām", "traducao_palavra": "[são] todos eles" }
      ]
    },
    "20": {
      "traducao_completa": "Num momento morrem; e à meia-noite os povos perturbam-se, e passam, e os poderosos são levados não por mão humana.",
      "palavras": [
        { "hebraico": "רֶ֤גַע ׀", "transliteral": "re-ḡaʿ", "traducao_palavra": "Em um momento" },
        { "hebraico": "יָמֻ֗תוּ", "transliteral": "yā-mu-ṯû", "traducao_palavra": "morrem" },
        { "hebraico": "וַחֲצֹ֣ות", "transliteral": "wa-ḥă-ṣô-wṯ", "traducao_palavra": "e à meia-" },
        { "hebraico": "לַ֭יְלָה", "transliteral": "lay-lā", "traducao_palavra": "noite" },
        { "hebraico": "יְגֹעֲשׁ֣וּ", "transliteral": "yə-ḡō-ʿă-šû", "traducao_palavra": "perturbam-se" },
        { "hebraico": "עָ֣ם", "transliteral": "ʿām", "traducao_palavra": "[os] povos" },
        { "hebraico": "וְיַעֲבֹ֑רוּ", "transliteral": "wə-ya-ʿă-ḇō-rû", "traducao_palavra": "e passam" },
        { "hebraico": "וְיָסִ֥ירוּ", "transliteral": "wə-yā-śî-rû", "traducao_palavra": "e é removido" },
        { "hebraico": "אַ֝בִּ֗יר", "transliteral": "ab-bîr", "traducao_palavra": "[o] poderoso" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "בְיָֽד׃", "transliteral": "ḇə-yāḏ", "traducao_palavra": "por mão [humana]" }
      ]
    },
    "21": {
      "traducao_completa": "Porque os seus olhos estão sobre os caminhos de cada um, e ele vê todos os seus passos.",
      "palavras": [
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "Porque" },
        { "hebraico": "עֵ֭ינָיו", "transliteral": "ʿê-nāyw", "traducao_palavra": "os olhos d'Ele" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "[estão] sobre" },
        { "hebraico": "דַּרְכֵי־", "transliteral": "dar-ḵê-", "traducao_palavra": "os caminhos de" },
        { "hebraico": "אִ֑ישׁ", "transliteral": "ʾîš", "traducao_palavra": "um homem" },
        { "hebraico": "וְכָל־", "transliteral": "wə-ḵāl-", "traducao_palavra": "e todos" },
        { "hebraico": "צְעָדָ֥יו", "transliteral": "ṣə-ʿā-ḏāyw", "traducao_palavra": "os seus passos" },
        { "hebraico": "יִרְאֶֽה׃", "transliteral": "yir-ʾeh", "traducao_palavra": "Ele vê" }
      ]
    },
    "22": {
      "traducao_completa": "Não há trevas nem sombra de morte, onde se escondam os que praticam a iniquidade.",
      "palavras": [
        { "hebraico": "אֵֽין־", "transliteral": "ʾên-", "traducao_palavra": "Não há" },
        { "hebraico": "חֹ֭שֶׁךְ", "transliteral": "ḥō-šeḵ", "traducao_palavra": "trevas" },
        { "hebraico": "וְאֵ֣ין", "transliteral": "wə-ʾên", "traducao_palavra": "e não [há]" },
        { "hebraico": "צַלְמָ֑וֶת", "transliteral": "ṣal-mā-weṯ", "traducao_palavra": "sombra da morte" },
        { "hebraico": "לְסָתֶ֥ר", "transliteral": "lə-śā-ṯer", "traducao_palavra": "para esconder" },
        { "hebraico": "שָׁ֝ם", "transliteral": "šām", "traducao_palavra": "ali" },
        { "hebraico": "פֹּ֣עֲלֵי", "transliteral": "p̄ō-ʿă-lê", "traducao_palavra": "os praticantes de" },
        { "hebraico": "אָֽוֶן׃", "transliteral": "ʾā-wen", "traducao_palavra": "iniquidade" }
      ]
    },
    "23": {
      "traducao_completa": "Porque Deus não sobrecarrega o homem mais do que o justo, para ele ir a juízo contra Deus.",
      "palavras": [
        { "hebraico": "כִּ֤י", "transliteral": "kî", "traducao_palavra": "Pois" },
        { "hebraico": "לֹֽAdjust־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre" },
        { "hebraico": "אִ֭ישׁ", "transliteral": "ʾîš", "traducao_palavra": "um homem" },
        { "hebraico": "יָשִׂ֣ים", "transliteral": "yā-śîm", "traducao_palavra": "põe" },
        { "hebraico": "עֹ֑וד", "transliteral": "ʿô-wḏ", "traducao_palavra": "mais [do que o necessário]" },
        { "hebraico": "לַהֲלֹ֥ךְ", "transliteral": "la-hă-lōḵ", "traducao_palavra": "para ir" },
        { "hebraico": "אֶל־", "transliteral": "ʾel-", "traducao_palavra": "perante" },
        { "hebraico": "אֵ֝֗ל", "transliteral": "ʾêl", "traducao_palavra": "Deus" },
        { "hebraico": "בַּמִּשְׁפָּֽט׃", "transliteral": "bam-miš-pāṭ", "traducao_palavra": "em juízo" }
      ]
    },
    "24": {
      "traducao_completa": "Ele quebranta os fortes, sem que se possa inquirir, e põe outros em seu lugar.",
      "palavras": [
        { "hebraico": "יָרֹ֣עַ", "transliteral": "yā-rō-aʿ", "traducao_palavra": "Quebranta" },
        { "hebraico": "כַּבִּירִ֣ים", "transliteral": "kab-bî-rîm", "traducao_palavra": "[os] poderosos" },
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "sem" },
        { "hebraico": "חֵ֑קֶר", "transliteral": "ḥê-qer", "traducao_palavra": "sondagem/investigação" },
        { "hebraico": "וַיַּעֲמֵ֥ד", "transliteral": "way-ya-ʿă-mêḏ", "traducao_palavra": "e estabelece" },
        { "hebraico": "אֲחֵרִ֗ים", "transliteral": "ʾă-ḥê-rîm", "traducao_palavra": "outros" },
        { "hebraico": "תַּחְתָּֽם׃", "transliteral": "taḥ-tām", "traducao_palavra": "em lugar deles" }
      ]
    },
    "25": {
      "traducao_completa": "Portanto, ele conhece as suas obras; e de noite os transtorna, e ficam moídos.",
      "palavras": [
        { "hebraico": "לָכֵ֗ן", "transliteral": "lā-ḵên", "traducao_palavra": "Portanto" },
        { "hebraico": "יַ֭כִּיר", "transliteral": "yak-kîr", "traducao_palavra": "Ele conhece" },
        { "hebraico": "מַעְבָּדֵיהֶ֑ם", "transliteral": "ma-ʿă-ḇā-ḏê-hem", "traducao_palavra": "as obras deles" },
        { "hebraico": "וְהָ֥פַךְ", "transliteral": "wə-hā-p̄aḵ", "traducao_palavra": "e transtorna" },
        { "hebraico": "לַ֝֗יְלָה", "transliteral": "lay-lā", "traducao_palavra": "[de] noite" },
        { "hebraico": "וַיִּדַּכָּֽאוּ׃", "transliteral": "way-yid-dak-kā-ʾû", "traducao_palavra": "e são esmagados" }
      ]
    },
    "26": {
      "traducao_completa": "Ele os fere como a ímpios, no lugar onde todos os veem;",
      "palavras": [
        { "hebraico": "תַּֽחַת־", "transliteral": "ta-ḥaṯ-", "traducao_palavra": "Em lugar de/Como" },
        { "hebraico": "רְשָׁעִ֥ים", "transliteral": "rə-šā-ʿîm", "traducao_palavra": "ímpios" },
        { "hebraico": "סְפָקָ֑ם", "transliteral": "śə-p̄ā-qām", "traducao_palavra": "fere-os/bate neles" },
        { "hebraico": "בִּמְקֹ֥ום", "transliteral": "bim-qô-wm", "traducao_palavra": "no lugar de" },
        { "hebraico": "רֹאִֽים׃", "transliteral": "rō-ʾîm", "traducao_palavra": "espectadores/onde se vê" }
      ]
    },
    "27": {
      "traducao_completa": "Porquanto se desviaram dele, e não quiseram entender nenhum de seus caminhos,",
      "palavras": [
        { "hebraico": "אֲשֶׁ֤ר", "transliteral": "ʾă-šer", "traducao_palavra": "Porque" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "por" },
        { "hebraico": "כֵּ֥ן", "transliteral": "kên", "traducao_palavra": "isso" },
        { "hebraico": "סָ֟רוּ", "transliteral": "śā-rû", "traducao_palavra": "desviaram-se" },
        { "hebraico": "מֵאַחֲרָ֑יו", "transliteral": "mê-ʾa-ḥă-rāyw", "traducao_palavra": "de segui-Lo" },
        { "hebraico": "וְכָל־", "transliteral": "wə-ḵāl-", "traducao_palavra": "e em todos" },
        { "hebraico": "דְּ֝רָכָ֗יו", "transliteral": "də-rā-ḵāyw", "traducao_palavra": "os Seus caminhos" },
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "הִשְׂכִּֽילוּ׃", "transliteral": "hiś-kî-lû", "traducao_palavra": "atentaram/entenderam" }
      ]
    },
    "28": {
      "traducao_completa": "Para fazerem que o clamor do pobre chegasse até ele, e que ouvisse o clamor dos aflitos.",
      "palavras": [
        { "hebraico": "לְהָבִ֣יא", "transliteral": "lə-hā-ḇî", "traducao_palavra": "Para fazer chegar" },
        { "hebraico": "עָ֭לָיו", "transliteral": "ʿā-lāyw", "traducao_palavra": "até Ele" },
        { "hebraico": "צַעֲקַת־", "transliteral": "ṣa-ʿă-qaṯ-", "traducao_palavra": "[o] clamor do" },
        { "hebraico": "דָּ֑ל", "transliteral": "ḏāl", "traducao_palavra": "pobre" },
        { "hebraico": "וְצַעֲקַ֖ת", "transliteral": "wə-ṣa-ʿă-qaṯ", "traducao_palavra": "e o clamor de" },
        { "hebraico": "עֲנִיִּ֣ים", "transliteral": "ʿă-niy-yîm", "traducao_palavra": "aflitos" },
        { "hebraico": "יִשְׁמָֽע׃", "transliteral": "yiš-māʿ", "traducao_palavra": "Ele ouça" }
      ]
    },
    "29": {
      "traducao_completa": "Se ele dá quietude, quem então o condenará? Se encobre o rosto, quem então o poderá ver? Seja para com uma nação, seja para com um homem só,",
      "palavras": [
        { "hebraico": "וְה֤וּא", "transliteral": "wə-hû", "traducao_palavra": "Se Ele" },
        { "hebraico": "יַשְׁקִ֨ט ׀", "transliteral": "yaš-qiṭ", "traducao_palavra": "dá quietude" },
        { "hebraico": "וּמִ֣י", "transliteral": "ū-mî", "traducao_palavra": "quem" },
        { "hebraico": "יַרְשִׁ֑ע", "transliteral": "yar-ši-aʿ", "traducao_palavra": "[O] condenará?" },
        { "hebraico": "וְיַסְתֵּ֤ר", "transliteral": "wə-yas-têr", "traducao_palavra": "e [se] esconder" },
        { "hebraico": "פָּנִ֨ים֙", "transliteral": "pā-nîm", "traducao_palavra": "[Sua] face" },
        { "hebraico": "וּמִ֣י", "transliteral": "ū-mî", "traducao_palavra": "quem" },
        { "hebraico": "יְשׁוּרֶ֔נּוּ", "transliteral": "yə-šû-ren-nû", "traducao_palavra": "O verá?" },
        { "hebraico": "וְעַל־", "transliteral": "wə-ʿal-", "traducao_palavra": "quer sobre" },
        { "hebraico": "גֹּ֥וי", "transliteral": "gôy", "traducao_palavra": "nação" },
        { "hebraico": "וְעַל־", "transliteral": "wə-ʿal-", "traducao_palavra": "quer sobre" },
        { "hebraico": "אָדָ֖ם", "transliteral": "ʾā-ḏām", "traducao_palavra": "um homem" },
        { "hebraico": "יַ֥חַד׃", "transliteral": "ya-ḥaḏ", "traducao_palavra": "igualmente" }
      ]
    },
    "30": {
      "traducao_completa": "Para que o hipócrita não reine, e não haja laços para o povo.",
      "palavras": [
        { "hebraico": "מִ֝מְּלֹ֗ךְ", "transliteral": "mim-mə-lōḵ", "traducao_palavra": "Para que não reine" },
        { "hebraico": "אָדָ֥ם", "transliteral": "ʾā-ḏām", "traducao_palavra": "homem" },
        { "hebraico": "חָנֵ֑ף", "transliteral": "ḥā-nêp̄", "traducao_palavra": "hipócrita/ímpio" },
        { "hebraico": "מִמֹּקְשֵׁ֥i", "transliteral": "mim-mō-qə-šê", "traducao_palavra": "[para não haver] laços de" },
        { "hebraico": "עָֽם׃", "transliteral": "ʿām", "traducao_palavra": "povo" }
      ]
    },
    "31": {
      "traducao_completa": "Certamente se deve dizer a Deus: Sofri o castigo, não pecarei mais.",
      "palavras": [
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "Pois" },
        { "hebraico": "אֶל־", "transliteral": "ʾel-", "traducao_palavra": "a" },
        { "hebraico": "אֵ֭ל", "transliteral": "ʾêl", "traducao_palavra": "Deus" },
        { "hebraico": "הֶאָמַ֥ר", "transliteral": "he-ʾā-mar", "traducao_palavra": "se diria?" },
        { "hebraico": "נָשָׂ֗אתִי", "transliteral": "nā-śā-ṯî", "traducao_palavra": "suportei [o castigo]" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "אֶחְבֹּֽל׃", "transliteral": "ʾeḥ-bōl", "traducao_palavra": "ofenderei/pecarei mais" }
      ]
    },
    "32": {
      "traducao_completa": "O que não vejo, ensina-me tu; se fiz alguma injustiça, não a tornarei a fazer.",
      "palavras": [
        { "hebraico": "בִּלְעֲדֵ֣i", "transliteral": "bil-ʿă-ḏê", "traducao_palavra": "O que [está] além de" },
        { "hebraico": "אֶ֭חֱזֶה", "transliteral": "ʾe-ḥĕ-zeh", "traducao_palavra": "eu ver" },
        { "hebraico": "אַתָּ֣ה", "transliteral": "ʾat-tā", "traducao_palavra": "Tu" },
        { "hebraico": "הֹרֵ֑נִי", "transliteral": "hō-rê-nî", "traducao_palavra": "ensina-me" },
        { "hebraico": "אִם־", "transliteral": "ʾim-", "traducao_palavra": "Se" },
        { "hebraico": "עָ֥וֶל", "transliteral": "ʿā-wel", "traducao_palavra": "injustiça" },
        { "hebraico": "פָּ֝עַלְתִּי", "transliteral": "pā-ʿal-tî", "traducao_palavra": "fiz" },
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "אֹסִֽיף׃", "transliteral": "ʾō-śîp̄", "traducao_palavra": "prosseguirei/repetirei" }
      ]
    },
    "33": {
      "traducao_completa": "Acaso deve ele retribuir segundo o teu parecer, porque tu o rejeitaste? Tu deves escolher, e não eu; fala, pois, o que sabes.",
      "palavras": [
        { "hebraico": "הַֽמֵעִמְּךָ֥", "transliteral": "ha-mê-ʿim-mə-ḵā", "traducao_palavra": "Acaso segundo tua vontade" },
        { "hebraico": "יְשַׁלְּמֶ֪נָּה", "transliteral": "yə-šal-lə-men-nā", "traducao_palavra": "Ele retribuirá" },
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "pois" },
        { "hebraico": "מָאַ֓סְתָּ ׀", "transliteral": "mā-ʾas-tā", "traducao_palavra": "rejeitaste" },
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "que" },
        { "hebraico": "אַתָּ֣ה", "transliteral": "ʾat-tā", "traducao_palavra": "tu" },
        { "hebraico": "תִבְחַ֣ר", "transliteral": "tiḇ-ḥar", "traducao_palavra": "escolherias" },
        { "hebraico": "וְלֹא־", "transliteral": "wə-lō-", "traducao_palavra": "e não" },
        { "hebraico": "אָ֑נִי", "transliteral": "ʾā-nî", "traducao_palavra": "eu" },
        { "hebraico": "וּמַה־", "transliteral": "ū-mah-", "traducao_palavra": "e o que" },
        { "hebraico": "יָּדַ֥עְתָּ", "transliteral": "yā-ḏaʿ-tā", "traducao_palavra": "sabes" },
