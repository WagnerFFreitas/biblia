        { "hebraico": "נֵדְעָ֥ה", "transliteral": "nê-ḏə-ʿā", "traducao_palavra": "saibamos" },
        { "hebraico": "בֵינֵ֝ינוּ", "transliteral": "ḇê-nê-nû", "traducao_palavra": "entre nós" },
