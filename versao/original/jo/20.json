{
  "livro": "Jó - אִיּוֹב - ʾIy-yōḇ",
  "capítulo": 20,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Então respondeu Zofar, o naamatita, e disse:",
      "palavras": [
        { "hebraico": "וַיַּ֥עַן", "transliteral": "way-ya-ʿan", "traducao_palavra": "Então respondeu" },
        { "hebraico": "צֹופַ֥ר", "transliteral": "ṣō-wp̄ar", "traducao_palavra": "Zofar" },
        { "hebraico": "הַנַּעֲמָתִ֑י", "transliteral": "han-na-ʿă-mā-ṯî", "traducao_palavra": "o naamatita" },
        { "hebraico": "וַיֹּאמַֽר׃", "transliteral": "way-yō-mar", "traducao_palavra": "e disse" }
      ]
    },
    "2": {
      "traducao_completa": "Visto isto, os meus pensamentos me fazem responder, e por isso eu me apresso.",
      "palavras": [
        { "hebraico": "לָ֭כֵן", "transliteral": "lā-ḵên", "traducao_palavra": "Portanto" },
        { "hebraico": "שְׂעִפַּ֣י", "transliteral": "śə-ʿip-pay", "traducao_palavra": "meus pensamentos" },
        { "hebraico": "יְשִׁיב֑וּנִי", "transliteral": "yə-šî-ḇû-nî", "traducao_palavra": "fazem-me responder" },
        { "hebraico": "וּ֝בַעֲב֗וּר", "transliteral": "ū-ḇa-ʿă-ḇûr", "traducao_palavra": "e por causa de" },
        { "hebraico": "ח֣וּשִׁי", "transliteral": "ḥû-šî", "traducao_palavra": "minha pressa" },
        { "hebraico": "בִֽי׃", "transliteral": "ḇî", "traducao_palavra": "em mim" }
      ]
    },
    "3": {
      "traducao_completa": "Eu ouvi a repreensão que me envergonha, mas o espírito do meu entendimento me faz responder.",
      "palavras": [
        { "hebraico": "מוּסַ֬ר", "transliteral": "mû-śar", "traducao_palavra": "A correção/repreensão de" },
        { "hebraico": "כְּלִמָּתִ֗י", "transliteral": "kə-lim-mā-ṯî", "traducao_palavra": "minha vergonha" },
        { "hebraico": "אֶשְׁמָ֥ע", "transliteral": "ʾeš-māʿ", "traducao_palavra": "ouvi" },
        { "hebraico": "וְר֨וּחַ", "transliteral": "wə-rû-aḥ", "traducao_palavra": "e o espírito" },
        { "hebraico": "מִבִּֽינָתִ֬י", "transliteral": "mib-bî-nā-ṯî", "traducao_palavra": "do meu entendimento" },
        { "hebraico": "יַעֲנֵֽנִי׃", "transliteral": "ya-ʿă-nê-nî", "traducao_palavra": "me faz responder" }
      ]
    },
    "4": {
      "traducao_completa": "Porventura não sabes tu que desde a antiguidade, desde que o homem foi posto sobre a terra,",
      "palavras": [
        { "hebraico": "הֲזֹ֣את", "transliteral": "hă-zōṯ", "traducao_palavra": "Acaso isto" },
        { "hebraico": "יָ֭דַעְתָּ", "transliteral": "yā-ḏaʿ-tā", "traducao_palavra": "sabes tu" },
        { "hebraico": "מִנִּי־", "transliteral": "min-nî-", "traducao_palavra": "desde" },
        { "hebraico": "עַ֑ד", "transliteral": "ʿaḏ", "traducao_palavra": "sempre/antiguidade" },
        { "hebraico": "מִנִּ֨י", "transliteral": "min-nî", "traducao_palavra": "desde que" },
        { "hebraico": "שִׂ֧ים", "transliteral": "śîm", "traducao_palavra": "foi posto" },
        { "hebraico": "אָדָ֕ם", "transliteral": "ʾā-ḏām", "traducao_palavra": "[o] homem" },
        { "hebraico": "עֲלֵי־", "transliteral": "ʿă-lê-", "traducao_palavra": "sobre" },
        { "hebraico": "אָֽרֶץ׃", "transliteral": "ʾā-reṣ", "traducao_palavra": "a terra" }
      ]
    },
    "5": {
      "traducao_completa": "O júbilo dos ímpios é breve, e a alegria dos hipócritas apenas de um momento?",
      "palavras": [
        { "hebraico": "כִּ֤י", "transliteral": "kî", "traducao_palavra": "Que" },
        { "hebraico": "רִנְנַ֣ת", "transliteral": "rin-naṯ", "traducao_palavra": "o júbilo de" },
        { "hebraico": "רְ֭שָׁעִים", "transliteral": "rə-šā-ʿîm", "traducao_palavra": "ímpios" },
        { "hebraico": "מִקָּרֹ֑וב", "transliteral": "miq-qā-rôḇ", "traducao_palavra": "[é] de perto/breve" },
        { "hebraico": "וְשִׂמְחַ֖ת", "transliteral": "wə-śim-ḥaṯ", "traducao_palavra": "e a alegria de" },
        { "hebraico": "חָנֵ֣ף", "transliteral": "ḥā-nêp̄", "traducao_palavra": "[o] hipócrita" },
        { "hebraico": "עֲדֵי־", "transliteral": "ʿă-ḏê-", "traducao_palavra": "até" },
        { "hebraico": "רָֽגַע׃", "transliteral": "rā-ḡaʿ", "traducao_palavra": "[um] momento" }
      ]
    },
    "6": {
      "traducao_completa": "Ainda que a sua altura suba até ao céu, e a sua cabeça chegue até às nuvens,",
      "palavras": [
        { "hebraico": "אִם־", "transliteral": "ʾim-", "traducao_palavra": "Se" },
        { "hebraico": "יַעֲלֶ֣ה", "transliteral": "ya-ʿă-leh", "traducao_palavra": "subir" },
        { "hebraico": "לַשָּׁמַ֣יִם", "transliteral": "laš-šā-ma-yim", "traducao_palavra": "aos céus" },
        { "hebraico": "שִׂיאֹ֑ו", "transliteral": "śî-ʾô", "traducao_palavra": "sua altura/exaltação" },
        { "hebraico": "וְ֝רֹאשֹׁ֗ו", "transliteral": "wə-rō-šô", "traducao_palavra": "e a sua cabeça" },
        { "hebraico": "לָעָ֥ב", "transliteral": "lā-ʿāḇ", "traducao_palavra": "à nuvem" },
        { "hebraico": "יַגִּֽיעַ׃", "transliteral": "yag-gî-aʿ", "traducao_palavra": "chegar" }
      ]
    },
    "7": {
      "traducao_completa": "Como o seu próprio esterco perecerá para sempre; e os que o viam dirão: Onde está?",
      "palavras": [
        { "hebraico": "כְּגֶלְלֹ֥ו", "transliteral": "kə-ḡel-lô", "traducao_palavra": "Como o seu esterco" },
        { "hebraico": "לָנֶ֥צַח", "transliteral": "lā-ne-ṣaḥ", "traducao_palavra": "para sempre" },
        { "hebraico": "יֹאבֵ֑ד", "transliteral": "yō-ʾḇêḏ", "traducao_palavra": "perecerá" },
        { "hebraico": "רֹ֝אָ֗יו", "transliteral": "rō-ʾāyw", "traducao_palavra": "os que o viam" },
        { "hebraico": "יֹאמְר֥וּ", "transliteral": "yō-mərû", "traducao_palavra": "dirão" },
        { "hebraico": "אַיֹּֽו׃", "transliteral": "ʾay-yô", "traducao_palavra": "Onde [está] ele?" }
      ]
    },
    "8": {
      "traducao_completa": "Como um sonho voará, e não será achado; e será afugentado como uma visão da noite.",
      "palavras": [
        { "hebraico": "כַּחֲלֹ֣ום", "transliteral": "ka-ḥă-lôm", "traducao_palavra": "Como sonho" },
        { "hebraico": "יָ֭עוּף", "transliteral": "yā-ʿûp̄", "traducao_palavra": "voará" },
        { "hebraico": "וְלֹ֣א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "יִמְצָא֑וּהוּ", "transliteral": "yim-ṣā-ʾû-hū", "traducao_palavra": "o acharão" },
        { "hebraico": "וְ֝יֻדַּ֗ד", "transliteral": "wə-yud-daḏ", "traducao_palavra": "e será afugentado" },
        { "hebraico": "כְּחֶזְיֹ֥ון", "transliteral": "kə-ḥez-yôn", "traducao_palavra": "como visão de" },
        { "hebraico": "לָֽיְלָה׃", "transliteral": "lā-yə-lā", "traducao_palavra": "noite" }
      ]
    },
    "9": {
      "traducao_completa": "O olho que o viu jamais o verá; nem o seu lugar o contemplará mais.",
      "palavras": [
        { "hebraico": "עַ֭יִן", "transliteral": "ʿa-yin", "traducao_palavra": "[O] olho [que]" },
        { "hebraico": "שְׁזָפַ֣תּוּ", "transliteral": "šə-zā-p̄at-tû", "traducao_palavra": "o viu" },
        { "hebraico": "וְלֹא־", "transliteral": "wə-lō-", "traducao_palavra": "não" },
        { "hebraico": "תֹוסִ֑יף", "transliteral": "ṯō-w-śîp̄", "traducao_palavra": "tornará" },
        { "hebraico": "וְלֹא־", "transliteral": "wə-lō-", "traducao_palavra": "e não" },
        { "hebraico": "עֹ֝וד", "transliteral": "ʿô-wḏ", "traducao_palavra": "mais" },
        { "hebraico": "תְּשׁוּרֶ֥נּוּ", "transliteral": "tə-šû-ren-nû", "traducao_palavra": "o verá/contemplará" },
        { "hebraico": "מְקֹומֹֽו׃", "transliteral": "mə-qō-w-mô", "traducao_palavra": "o seu lugar" }
      ]
    },
    "10": {
      "traducao_completa": "Os seus filhos procurarão o favor dos pobres, e as suas mãos restituirão os seus bens.",
      "palavras": [
        { "hebraico": "בָּ֭נָיו", "transliteral": "bā-nāyw", "traducao_palavra": "Os filhos dele" },
        { "hebraico": "יְרַצּ֣וּ", "transliteral": "yə-raṣ-ṣû", "traducao_palavra": "buscarão favor de" },
        { "hebraico": "דַלִּ֑ים", "transliteral": "dal-lîm", "traducao_palavra": "pobres" },
        { "hebraico": "וְ֝יָדָ֗יו", "transliteral": "wə-yā-ḏāyw", "traducao_palavra": "e as mãos dele" },
        { "hebraico": "תָּשֵׁ֥בְנָה", "transliteral": "tā-šê-ḇə-nā", "traducao_palavra": "devolverão" },
        { "hebraico": "אֹונֹֽו׃", "transliteral": "ʾô-nô", "traducao_palavra": "suas riquezas/bens" }
      ]
    },
    "11": {
      "traducao_completa": "Os seus ossos estão cheios do vigor da sua juventude, mas este se deitará com ele no pó.",
      "palavras": [
        { "hebraico": "עַצְמֹותָ֥יו", "transliteral": "ʿaṣ-mō-w-ṯāyw", "traducao_palavra": "Seus ossos" },
        { "hebraico": "מָלְא֖וּ", "transliteral": "māl-ʾû", "traducao_palavra": "estão cheios de" },
        { "hebraico": "עֲלוּמָ֑יו", "transliteral": "ʿă-lû-māyw", "traducao_palavra": "sua juventude" },
        { "hebraico": "וְ֝עִמֹּ֗ו", "transliteral": "wə-ʿim-mô", "traducao_palavra": "e com ele" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "no" },
        { "hebraico": "עָפָ֥ר", "transliteral": "ʿā-p̄ār", "traducao_palavra": "pó" },
        { "hebraico": "תִּשְׁכָּֽב׃", "transliteral": "tiš-kāḇ", "traducao_palavra": "se deitará" }
      ]
    },
    "12": {
      "traducao_completa": "Ainda que o mal lhe seja doce na boca, e ele o esconda debaixo da sua língua,",
      "palavras": [
        { "hebraico": "אִם־", "transliteral": "ʾim-", "traducao_palavra": "Se" },
        { "hebraico": "תַּמְתִּ֣יק", "transliteral": "tam-tîq", "traducao_palavra": "for doce" },
        { "hebraico": "בְּפִ֣יו", "transliteral": "bə-p̄îw", "traducao_palavra": "na sua boca" },
        { "hebraico": "רָעָ֑ה", "transliteral": "rā-ʿā", "traducao_palavra": "[a] maldade" },
        { "hebraico": "יַ֝כְחִידֶ֗נָּה", "transliteral": "yaḵ-ḥî-ḏen-nā", "traducao_palavra": "[se] ele a esconde" },
        { "hebraico": "תַּ֣חַת", "transliteral": "ta-ḥaṯ", "traducao_palavra": "debaixo de" },
        { "hebraico": "לְשֹׁונֹֽו׃", "transliteral": "lə-šô-wnô", "traducao_palavra": "sua língua" }
      ]
    },
    "13": {
      "traducao_completa": "Ainda que o poupe, e o não deixe, antes o retenha no seu paladar,",
      "palavras": [
        { "hebraico": "יַחְמֹ֥ל", "transliteral": "yaḥ-mōl", "traducao_palavra": "[Se] a poupa" },
        { "hebraico": "עָ֝לֶ֗יהָ", "transliteral": "ʿā-ley-hā", "traducao_palavra": "[unidades]" },
        { "hebraico": "וְלֹ֣א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "יַֽעַזְבֶ֑נָּה", "transliteral": "ya-ʿaz-ḇen-nā", "traducao_palavra": "a deixa" },
        { "hebraico": "וְ֝יִמְנָעֶ֗נָּה", "transliteral": "wə-yim-nā-ʿen-nā", "traducao_palavra": "e a retém" },
        { "hebraico": "בְּתֹ֣וךְ", "transliteral": "bə-ṯō-wḵ", "traducao_palavra": "no meio de" },
        { "hebraico": "חִכֹּֽו׃", "transliteral": "ḥik-kô", "traducao_palavra": "seu paladar" }
      ]
    },
    "14": {
      "traducao_completa": "Contudo a sua comida se mudará nas suas entranhas; fel de áspides será no seu interior.",
      "palavras": [
        { "hebraico": "לַ֭חְמֹו", "transliteral": "laḥ-mô", "traducao_palavra": "Sua comida" },
        { "hebraico": "בְּמֵעָ֣יו", "transliteral": "bə-mê-ʿāyw", "traducao_palavra": "nas suas entranhas" },
        { "hebraico": "נֶהְפָּ֑ךְ", "transliteral": "neh-pak", "traducao_palavra": "converteu-se" },
        { "hebraico": "מְרֹורַ֖ת", "transliteral": "mə-rô-raṯ", "traducao_palavra": "veneno/fel de" },
        { "hebraico": "פְּתָנִ֣ים", "transliteral": "pə-ṯā-nîm", "traducao_palavra": "áspides" },
        { "hebraico": "בְּקִרְבֹּֽו׃", "transliteral": "bə-qir-bô", "traducao_palavra": "dentro dele" }
      ]
    },
    "15": {
      "traducao_completa": "Engoliu riquezas, mas vomitá-las-á; do seu ventre Deus as lançará fora.",
      "palavras": [
        { "hebraico": "חַ֣יִל", "transliteral": "ḥa-yil", "traducao_palavra": "Riquezas" },
        { "hebraico": "בָּ֭לַע", "transliteral": "bā-laʿ", "traducao_palavra": "engoliu" },
        { "hebraico": "וַיְקִאֶ֑נּוּ", "transliteral": "way-qi-ʾen-nū", "traducao_palavra": "mas vomitá-las-á" },
        { "hebraico": "מִ֝בִּטְנֹ֗ו", "transliteral": "mib-biṭ-nô", "traducao_palavra": "do seu ventre" },
        { "hebraico": "יֹורִשֶׁ֥נּוּ", "transliteral": "yô-w-ri-šen-nū", "traducao_palavra": "lançará elas fora" },
        { "hebraico": "אֵֽל׃", "transliteral": "ʾêl", "traducao_palavra": "Deus" }
      ]
    },
    "16": {
      "traducao_completa": "Sugará veneno de áspides; a língua da víbora o matará.",
      "palavras": [
        { "hebraico": "יִנַ֥ק", "transliteral": "yi-naq", "traducao_palavra": "Sugará" },
        { "hebraico": "רֹ֘אשׁ", "transliteral": "rōš", "traducao_palavra": "veneno de" },
        { "hebraico": "פְּתָנִ֑ים", "transliteral": "pə-ṯā-nîm", "traducao_palavra": "áspides" },
        { "hebraico": "תַּ֝הַרְגֵ֗הוּ", "transliteral": "ta-har-ḡê-hū", "traducao_palavra": "matará ele" },
        { "hebraico": "לְשֹׁ֣ון", "transliteral": "lə-šō-wn", "traducao_palavra": "[a] língua de" },
        { "hebraico": "אֶפְעֶֽה׃", "transliteral": "ʾep̄-ʿeh", "traducao_palavra": "víbora" }
      ]
    },
    "17": {
      "traducao_completa": "Não verá as correntes, os rios e os ribeiros de mel e manteiga.",
      "palavras": [
        { "hebraico": "אַל־", "transliteral": "ʾal-", "traducao_palavra": "Não" },
        { "hebraico": "יֵ֭רֶא", "transliteral": "yê-re", "traducao_palavra": "verá" },
        { "hebraico": "בִפְלַגֹּ֑ות", "transliteral": "bi-p̄ə-lag-gôṯ", "traducao_palavra": "nas divisões/correntes" },
        { "hebraico": "נַהֲרֵ֥י", "transliteral": "na-hă-rê", "traducao_palavra": "rios de" },
        { "hebraico": "נַ֝חֲלֵי", "transliteral": "na-ḥă-lê", "traducao_palavra": "ribeiros de" },
        { "hebraico": "דְּבַ֣שׁ", "transliteral": "də-ḇaš", "traducao_palavra": "mel" },
        { "hebraico": "וְחֶמְאָֽה׃", "transliteral": "wə-ḥem-ʾā", "traducao_palavra": "e manteiga" }
      ]
    },
    "18": {
      "traducao_completa": "Restituirá o seu trabalho, e não o engolirá; conforme a fazenda que adquiriu, será a sua restituição, e não se alegrará.",
      "palavras": [
        { "hebraico": "מֵשִׁ֣יב", "transliteral": "mê-šîḇ", "traducao_palavra": "Devolve" },
        { "hebraico": "עָ֭מָל", "transliteral": "ʿā-māl", "traducao_palavra": "[o fruto do] trabalho" },
        { "hebraico": "וְלֹ֣a", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "יִבְלָ֑ע", "transliteral": "yiḇ-lāʿ", "traducao_palavra": "engolirá" },
        { "hebraico": "כְּחֵ֥יל", "transliteral": "kə-ḥêl", "traducao_palavra": "conforme a riqueza de" },
        { "hebraico": "תְּ֝מוּרָתֹ֗ו", "transliteral": "tə-mû-rā-ṯô", "traducao_palavra": "sua permuta/restituição" },
        { "hebraico": "וְלֹ֣א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "יַעֲלֹֽס׃", "transliteral": "ya-ʿă-lōś", "traducao_palavra": "se alegrará" }
      ]
    },
    "19": {
      "traducao_completa": "Porquanto oprimiu e desamparou os pobres, e roubou a casa que não edificou.",
      "palavras": [
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "Porque" },
        { "hebraico": "רִ֭צַּץ", "transliteral": "riṣ-ṣaṣ", "traducao_palavra": "oprimiu" },
        { "hebraico": "עָזַ֣ב", "transliteral": "ʿā-zaḇ", "traducao_palavra": "desamparou" },
        { "hebraico": "דַּלִּ֑ים", "transliteral": "dal-lîm", "traducao_palavra": "pobres" },
        { "hebraico": "בַּ֝יִת", "transliteral": "ba-yit", "traducao_palavra": "casa" },
        { "hebraico": "גָּזַ֗ל", "transliteral": "ḡā-zal", "traducao_palavra": "roubou" },
        { "hebraico": "וְלֹ֣א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "יִבְנֵֽהוּ׃", "transliteral": "yiḇ-nê-hū", "traducao_palavra": "edificou-a" }
      ]
    },
    "20": {
      "traducao_completa": "Porquanto não sentiu sossego no seu ventre, nada salvará daquilo que desejou.",
      "palavras": [
        { "hebraico": "כִּ֤י", "transliteral": "kî", "traducao_palavra": "Porque" },
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "יָדַ֣ע", "transliteral": "yā-ḏaʿ", "traducao_palavra": "soube/conheceu" },
        { "hebraico": "שָׁ֭לֶו", "transliteral": "šā-lew", "traducao_palavra": "sossego/paz" },
        { "hebraico": "בְּבִטְנֹ֑ו", "transliteral": "bə-ḇiṭ-nô", "traducao_palavra": "no seu ventre" },
        { "hebraico": "בַּחֲמוּדֹ֥ו", "transliteral": "ba-ḥă-mû-ḏô", "traducao_palavra": "daquilo que desejou" },
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "יְמַלֵּֽט׃", "transliteral": "yə-mal-lêṭ", "traducao_palavra": "salvará" }
      ]
    },
    "21": {
      "traducao_completa": "Nada sobejou do que comeu; por isso a sua prosperidade não durará.",
      "palavras": [
        { "hebraico": "אֵין־", "transliteral": "ʾên-", "traducao_palavra": "Não [houve]" },
        { "hebraico": "שָׂרִ֥יד", "transliteral": "śā-rîḏ", "traducao_palavra": "sobrante" },
        { "hebraico": "לְאָכְלֹ֑ו", "transliteral": "lə-ʾā-ḵə-lô", "traducao_palavra": "para o seu comer" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "por" },
        { "hebraico": "כֵּ֝֗ן", "transliteral": "kên", "traducao_palavra": "isso [Portanto]" },
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "יָחִ֥יל", "transliteral": "yā-ḥîl", "traducao_palavra": "durará/subsistirá" },
        { "hebraico": "טוּבֹֽו׃", "transliteral": "ṭū-ḇô", "traducao_palavra": "o bem dele" }
      ]
    },
    "22": {
      "traducao_completa": "Na plenitude da sua abundância, estará em aperto; toda a mão dos miseráveis virá sobre ele.",
      "palavras": [
        { "hebraico": "בִּמְלֹ֣אות", "transliteral": "bim-lō-wṯ", "traducao_palavra": "Na plenitude de" },
        { "hebraico": "שִׂפְקֹ֣ו", "transliteral": "śip̄-qô", "traducao_palavra": "sua suficiência/fartura" },
        { "hebraico": "יֵ֣צֶר", "transliteral": "yê-ṣer", "traducao_palavra": "estará em aperto" },
        { "hebraico": "לֹ֑ו", "transliteral": "lô", "traducao_palavra": "[unidades]" },
        { "hebraico": "כָּל־", "transliteral": "kāl-", "traducao_palavra": "toda" },
        { "hebraico": "יַ֖ד", "transliteral": "yaḏ", "traducao_palavra": "mão de" },
        { "hebraico": "עָמָ֣ל", "transliteral": "ʿā-māl", "traducao_palavra": "miserável/sofredor" },
        { "hebraico": "תְּבֹואֶֽנּוּ׃", "transliteral": "tə-ḇô-ʾen-nū", "traducao_palavra": "virá sobre ele" }
      ]
    },
    "23": {
      "traducao_completa": "Quando ele estiver para encher o seu ventre, Deus enviará sobre ele o ardor da sua ira, e a fará chover sobre ele enquanto ele come.",
      "palavras": [
        { "hebraico": "יְהִ֤י", "transliteral": "yə-hî", "traducao_palavra": "Seja" },
        { "hebraico": "לְמַלֵּ֬א", "transliteral": "lə-mal-lê", "traducao_palavra": "para encher" },
        { "hebraico": "בִטְנֹ֗ו", "transliteral": "ḇiṭ-nô", "traducao_palavra": "seu ventre" },
        { "hebraico": "יְשַׁלַּח־", "transliteral": "yə-šal-laḥ-", "traducao_palavra": "Ele enviará" },
        { "hebraico": "בֹּ֭ו", "transliteral": "bô", "traducao_palavra": "nele" },
        { "hebraico": "חֲרֹ֣ון", "transliteral": "ḥă-rō-wn", "traducao_palavra": "[o] ardor de" },
        { "hebraico": "אַפֹּ֑ו", "transliteral": "ʾap-pô", "traducao_palavra": "Sua ira" },
        { "hebraico": "וְיַמְטֵ֥ר", "transliteral": "wə-yam-ṭêr", "traducao_palavra": "e fará chover" },
        { "hebraico": "עָ֝לֵ֗ימֹו", "transliteral": "ʿā-lê-mô", "traducao_palavra": "sobre eles/ele" },
        { "hebraico": "בִּלְחוּמֹֽו׃", "transliteral": "bil-ḥû-mô", "traducao_palavra": "enquanto come" }
      ]
    },
    "24": {
      "traducao_completa": "Ainda que fuja das armas de ferro, o arco de bronze o atravessará.",
      "palavras": [
        { "hebraico": "יִ֭בְרַח", "transliteral": "yiḇ-raḥ", "traducao_palavra": "Fugirá" },
        { "hebraico": "מִנֵּ֣שֶׁק", "transliteral": "min-nê-šeq", "traducao_palavra": "da arma de" },
        { "hebraico": "בַּרְזֶ֑ל", "transliteral": "bar-zel", "traducao_palavra": "ferro" },
        { "hebraico": "תַּ֝חְלְפֵ֗הוּ", "transliteral": "taḥ-lə-p̄ê-hū", "traducao_palavra": "atravessará ele" },
        { "hebraico": "קֶ֣שֶׁת", "transliteral": "qe-šeṯ", "traducao_palavra": "[o] arco de" },
        { "hebraico": "נְחוּשָֽׁה׃", "transliteral": "nə-ḥû-šā", "traducao_palavra": "bronze" }
      ]
    },
    "25": {
      "traducao_completa": "Ele arrancará a flecha, e ela sairá do seu corpo, e a ponta reluzente sairá do seu fel; e haverá sobre ele terrores.",
      "palavras": [
        { "hebraico": "שָׁלַ֤ף", "transliteral": "šā-lap̄", "traducao_palavra": "Arrancará" },
        { "hebraico": "וַיֵּצֵא֙", "transliteral": "way-yê-ṣê", "traducao_palavra": "e sairá" },
        { "hebraico": "מִגֵּוָה֮", "transliteral": "mig-gê-wā", "traducao_palavra": "do corpo" },
        { "hebraico": "וּ֭בָרָק", "transliteral": "ū-ḇā-rāq", "traducao_palavra": "e a [ponta] reluzente" },
        { "hebraico": "מִמְּרֹרָתֹ֥ו", "transliteral": "mim-mə-rō-rā-ṯô", "traducao_palavra": "do seu fel" },
        { "hebraico": "יַהֲלֹ֗ךְ", "transliteral": "ya-hă-lōḵ", "traducao_palavra": "seguirá/virá" },
        { "hebraico": "עָלָ֥יו", "transliteral": "ʿā-lāyw", "traducao_palavra": "sobre ele" },
        { "hebraico": "אֵימִֽים׃", "transliteral": "ʾê-mîm", "traducao_palavra": "terrores" }
      ]
    },
    "26": {
      "traducao_completa": "Toda a escuridão está reservada aos seus tesouros; um fogo não assoprado o consumirá; e o que sobrar na sua tenda será devorado.",
      "palavras": [
        { "hebraico": "כָּל־", "transliteral": "kāl-", "traducao_palavra": "Toda" },
        { "hebraico": "חֹ֥שֶׁךְ", "transliteral": "ḥō-šeḵ", "traducao_palavra": "[a] escuridão" },
        { "hebraico": "טָמ֪וּן", "transliteral": "ṭā-mûn", "traducao_palavra": "[está] guardada" },
        { "hebraico": "לִצְפּ֫וּנָ֥יו", "transliteral": "liṣ-pû-nāyw", "traducao_palavra": "para os seus tesouros" },
        { "hebraico": "תְּאָכְלֵ֥הוּ", "transliteral": "tə-ʾā-ḵə-lê-hū", "traducao_palavra": "consumirá ele" },
        { "hebraico": "אֵשׁ־", "transliteral": "ʾêš-", "traducao_palavra": "um fogo" },
        { "hebraico": "לֹֽא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "נֻפָּ֑ח", "transliteral": "nup-pāḥ", "traducao_palavra": "assoprado" },
        { "hebraico": "יֵ֖רַע", "transliteral": "yê-raʿ", "traducao_palavra": "será mal para" },
        { "hebraico": "שָׂרִ֣יד", "transliteral": "śā-rîḏ", "traducao_palavra": "[o] que sobrar" },
        { "hebraico": "בְּאָהֳלֹֽו׃", "transliteral": "bə-ʾā-hŏ-lô", "traducao_palavra": "na sua tenda" }
      ]
    },
    "27": {
      "traducao_completa": "Os céus manifestarão a sua iniquidade, e a terra se levantará contra ele.",
      "palavras": [
        { "hebraico": "יְגַלּ֤וּ", "transliteral": "yə-ḡal-lû", "traducao_palavra": "Revelarão" },
        { "hebraico": "שָׁמַ֨יִם֙", "transliteral": "šā-ma-yim", "traducao_palavra": "os céus" },
        { "hebraico": "עֲוֹנֹ֔ו", "transliteral": "ʿă-wō-nô", "traducao_palavra": "a iniquidade dele" },
        { "hebraico": "וְ֝אֶ֗רֶץ", "transliteral": "wə-ʾe-reṣ", "traducao_palavra": "e a terra" },
        { "hebraico": "מִתְקֹומָ֥מָה", "transliteral": "miṯ-qô-w-mā-mā", "traducao_palavra": "se levantará" },
        { "hebraico": "לֹֽו׃", "transliteral": "lô", "traducao_palavra": "contra ele" }
      ]
    },
    "28": {
      "traducao_completa": "As rendas de sua casa se irão; no dia da sua ira se derramarão.",
      "palavras": [
        { "hebraico": "יִ֭גֶל", "transliteral": "yi-ḡel", "traducao_palavra": "Será levada" },
        { "hebraico": "יְב֣וּל", "transliteral": "yə-ḇûl", "traducao_palavra": "[a] produção/renda de" },
        { "hebraico": "בֵּיתֹ֑ו", "transliteral": "bê-ṯô", "traducao_palavra": "sua casa" },
        { "hebraico": "נִ֝גָּרֹ֗ות", "transliteral": "nig-gā-rôṯ", "traducao_palavra": "escoarão" },
        { "hebraico": "בְּיֹום־", "transliteral": "bə-yôm-", "traducao_palavra": "no dia de" },
        { "hebraico": "אַפֹּֽו׃", "transliteral": "ʾap-pô", "traducao_palavra": "Sua ira" }
      ]
    },
    "29": {
      "traducao_completa": "Esta, da parte de Deus, é a porção do homem ímpio, e a herança que Deus lhe decretou.",
      "palavras": [
        { "hebraico": "זֶ֤ה ׀", "transliteral": "zeh", "traducao_palavra": "Esta [é]" },
        { "hebraico": "חֵֽלֶק־", "transliteral": "ḥê-leq-", "traducao_palavra": "a porção de" },
        { "hebraico": "אָדָ֣ם", "transliteral": "ʾā-ḏām", "traducao_palavra": "um homem" },
        { "hebraico": "רָ֭שָׁע", "transliteral": "rā-šāʿ", "traducao_palavra": "ímpio" },
        { "hebraico": "מֵאֱלֹהִ֑ים", "transliteral": "mê-ʾĕ-lō-hîm", "traducao_palavra": "da parte de Deus" },
        { "hebraico": "וְנַחֲלַ֖ת", "transliteral": "wə-na-ḥă-laṯ", "traducao_palavra": "e a herança" },
        { "hebraico": "אִמְרֹ֣ו", "transliteral": "ʾim-rô", "traducao_palavra": "[de] Seu decreto" },
        { "hebraico": "מֵאֵֽל׃", "transliteral": "mê-ʾêl", "traducao_palavra": "de Deus" }
