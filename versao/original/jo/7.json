{
  "livro": "Jó - אִיּוֹב - ʾIy-yōḇ",
  "capítulo": 7,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Não tem o homem um tempo de serviço sobre a terra? E não são os seus dias como os dias de um jornaleiro?",
      "palavras": [
        { "hebraico": "הֲלֹא־", "transliteral": "hă-lō-", "traducao_palavra": "Acaso não" },
        { "hebraico": "צָבָ֣א", "transliteral": "ṣā-ḇā", "traducao_palavra": "[há] tempo de serviço/luta" },
        { "hebraico": "לֶאֱנֹ֣ושׁ", "transliteral": "le-ʾĕ-nō-wš", "traducao_palavra": "para o homem" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre" },
        { "hebraico": "אָ֑רֶץ", "transliteral": "ʾā-reṣ", "traducao_palavra": "a terra" },
        { "hebraico": "וְכִימֵ֥י", "transliteral": "wə-ḵî-mê", "traducao_palavra": "e como os dias de" },
        { "hebraico": "שָׂ֝כִ֗יר", "transliteral": "śā-ḵîr", "traducao_palavra": "um jornaleiro/mercenário" },
        { "hebraico": "יָמָֽיו׃", "transliteral": "yā-māyw", "traducao_palavra": "os seus dias" }
      ]
    },
    "2": {
      "traducao_completa": "Como o escravo que suspira pela sombra, e como o jornaleiro que espera pelo seu salário,",
      "palavras": [
        { "hebraico": "כְּעֶ֥בֶד", "transliteral": "kə-ʿe-ḇeḏ", "traducao_palavra": "Como o escravo" },
        { "hebraico": "יִשְׁאַף־", "transliteral": "yiš-ʾap̄-", "traducao_palavra": "que anseia por" },
        { "hebraico": "צֵ֑ל", "transliteral": "ṣêl", "traducao_palavra": "sombra" },
        { "hebraico": "וּ֝כְשָׂכִ֗יר", "transliteral": "ū-ḵə-śā-ḵîr", "traducao_palavra": "e como o jornaleiro" },
        { "hebraico": "יְקַוֶּ֥ה", "transliteral": "yə-qaw-weh", "traducao_palavra": "que espera" },
        { "hebraico": "פָעֳלֹֽו׃", "transliteral": "p̄ā-ʿŏ-lô", "traducao_palavra": "seu salário/obra" }
      ]
    },
    "3": {
      "traducao_completa": "Assim me deram por herança meses de vaidade, e noites de fadiga me designaram.",
      "palavras": [
        { "hebraico": "כֵּ֤ן", "transliteral": "kên", "traducao_palavra": "Assim" },
        { "hebraico": "הָנְחַ֣לְתִּי", "transliteral": "hān-ḥal-tî", "traducao_palavra": "fui feito herdar" },
        { "hebraico": "לִ֭י", "transliteral": "lî", "traducao_palavra": "para mim" },
        { "hebraico": "יַרְחֵי־", "transliteral": "yar-ḥê-", "traducao_palavra": "meses de" },
        { "hebraico": "שָׁ֑וְא", "transliteral": "šā-wə", "traducao_palavra": "vaidade/vazio" },
        { "hebraico": "וְלֵילֹ֥ות", "transliteral": "wə-lê-lō-wṯ", "traducao_palavra": "e noites de" },
        { "hebraico": "עָ֝מָ֗ל", "transliteral": "ʿā-māl", "traducao_palavra": "sofrimento/fadiga" },
        { "hebraico": "מִנּוּ־", "transliteral": "min-nû-", "traducao_palavra": "designaram" },
        { "hebraico": "לִֽי׃", "transliteral": "lî", "traducao_palavra": "para mim" }
      ]
    },
    "4": {
      "traducao_completa": "Se me deito, digo: Quando me levantarei? Mas a noite se faz longa, e farto-me de me revolver na cama até à alva.",
      "palavras": [
        { "hebraico": "אִם־", "transliteral": "ʾim-", "traducao_palavra": "Se" },
        { "hebraico": "שָׁכַ֣בְתִּי", "transliteral": "šā-ḵaḇ-tî", "traducao_palavra": "me deito" },
        { "hebraico": "וְאָמַרְתִּי֮", "transliteral": "wə-ʾā-mar-tî", "traducao_palavra": "então digo" },
        { "hebraico": "מָתַ֪י", "transliteral": "mā-ṯay", "traducao_palavra": "quando" },
        { "hebraico": "אָ֫ק֥וּם", "transliteral": "ʾā-qûm", "traducao_palavra": "me levantarei?" },
        { "hebraico": "וּמִדַּד־", "transliteral": "ū-mid-daḏ-", "traducao_palavra": "e prolonga-se" },
        { "hebraico": "עָ֑רֶב", "transliteral": "ʿā-reḇ", "traducao_palavra": "a noite/entardecer" },
        { "hebraico": "וְשָׂבַ֥עְתִּי", "transliteral": "wə-śā-ḇaʿ-tî", "traducao_palavra": "e farto-me de" },
        { "hebraico": "נְ֝דֻדִ֗ים", "transliteral": "nə-ḏu-ḏîm", "traducao_palavra": "revolver-me/inquietações" },
        { "hebraico": "עֲדֵי־", "transliteral": "ʿă-ḏê-", "traducao_palavra": "até" },
        { "hebraico": "נָּֽשֶׁף׃", "transliteral": "nā-šep̄", "traducao_palavra": "o crepúsculo/alva" }
      ]
    },
    "5": {
      "traducao_completa": "A minha carne se tem vestido de vermes e de torrões de pó; a minha pele se fendeu, e se tornou abominável.",
      "palavras": [
        { "hebraico": "לָ֘בַ֤שׁ", "transliteral": "lā-ḇaš", "traducao_palavra": "Vestiu" },
        { "hebraico": "בְּשָׂרִ֣י", "transliteral": "bə-śā-rî", "traducao_palavra": "minha carne" },
        { "hebraico": "רִ֭מָּה", "transliteral": "rim-mā", "traducao_palavra": "vermes" },
        { "hebraico": "וְג֣וּשׁ", "transliteral": "wə-ḡûš", "traducao_palavra": "e torrões de" },
        { "hebraico": "עָפָ֑ר", "transliteral": "ʿā-p̄ār", "traducao_palavra": "pó" },
        { "hebraico": "עֹורִ֥י", "transliteral": "ʿô-wrî", "traducao_palavra": "minha pele" },
        { "hebraico": "רָ֝גַ֗ע", "transliteral": "rā-ḡaʿ", "traducao_palavra": "fendeu-se/endureceu" },
        { "hebraico": "וַיִּמָּאֵֽס׃", "transliteral": "way-yim-mā-ʾês", "traducao_palavra": "e tornou-se abominável/suprime" }
      ]
    },
    "6": {
      "traducao_completa": "Os meus dias são mais velozes do que a lançadeira do tecelão, e chegam ao fim sem esperança.",
      "palavras": [
        { "hebraico": "יָמַ֣י", "transliteral": "yā-may", "traducao_palavra": "Meus dias" },
        { "hebraico": "קַ֭לּוּ", "transliteral": "qal-lû", "traducao_palavra": "são mais velozes" },
        { "hebraico": "מִנִּי־", "transliteral": "min-nî-", "traducao_palavra": "do que" },
        { "hebraico": "אָ֑רֶג", "transliteral": "ʾā-reḡ", "traducao_palavra": "a lançadeira [de tecelão]" },
        { "hebraico": "וַ֝יִּכְל֗וּ", "transliteral": "way-yiḵ-lû", "traducao_palavra": "e terminam" },
        { "hebraico": "בְּאֶ֣פֶס", "transliteral": "bə-ʾe-p̄es", "traducao_palavra": "na falta de" },
        { "hebraico": "תִּקְוָֽה׃", "transliteral": "tiq-wā", "traducao_palavra": "esperança" }
      ]
    },
    "7": {
      "traducao_completa": "Lembra-te de que a minha vida é um sopro; os meus olhos não tornarão a ver o bem.",
      "palavras": [
        { "hebraico": "זְ֭כֹר", "transliteral": "zə-ḵōr", "traducao_palavra": "Lembra-te" },
        { "hebraico": "כִּי־", "transliteral": "kî-", "traducao_palavra": "que" },
        { "hebraico": "ר֣וּחַ", "transliteral": "rû-aḥ", "traducao_palavra": "[um] sopro/vento" },
        { "hebraico": "חַיָּ֑י", "transliteral": "ḥay-yāy", "traducao_palavra": "[é] minha vida" },
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "תָשׁ֥וּב", "transliteral": "ṯā-šûḇ", "traducao_palavra": "voltará" },
        { "hebraico": "עֵינִ֗י", "transliteral": "ʿê-nî", "traducao_palavra": "meu olho" },
        { "hebraico": "לִרְאֹ֥ות", "transliteral": "lir-ʾō-wṯ", "traducao_palavra": "para ver" },
        { "hebraico": "טֹֽוב׃", "transliteral": "ṭôḇ", "traducao_palavra": "o bem" }
      ]
    },
    "8": {
      "traducao_completa": "Os olhos dos que agora me veem não me verão mais; os teus olhos estarão sobre mim, mas eu não serei mais.",
      "palavras": [
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "Não" },
        { "hebraico": "תְ֭שׁוּרֵנִי", "transliteral": "ṯə-šû-rê-nî", "traducao_palavra": "me verá" },
        { "hebraico": "עֵ֣ין", "transliteral": "ʿên", "traducao_palavra": "o olho de" },
        { "hebraico": "רֹ֑אִי", "transliteral": "rō-ʾî", "traducao_palavra": "quem me vê" },
        { "hebraico": "עֵינֶ֖יךָ", "transliteral": "ʿê-ney-ḵā", "traducao_palavra": "teus olhos" },
        { "hebraico": "בִּ֣י", "transliteral": "bî", "traducao_palavra": "[estarão] em mim" },
        { "hebraico": "וְאֵינֶֽנִּי׃", "transliteral": "wə-ʾê-nen-nî", "traducao_palavra": "mas eu não [serei/estarei mais]" }
      ]
    },
    "9": {
      "traducao_completa": "Como a nuvem se desfaz e passa, assim aquele que desce à sepultura nunca mais subirá.",
      "palavras": [
        { "hebraico": "כָּלָ֣ה", "transliteral": "kā-lā", "traducao_palavra": "Desfaz-se" },
        { "hebraico": "עָ֭נָן", "transliteral": "ʿā-nān", "traducao_palavra": "a nuvem" },
        { "hebraico": "וַיֵּלַ֑ךְ", "transliteral": "way-yê-laḵ", "traducao_palavra": "e passa/vai-se" },
        { "hebraico": "כֵּ֥ן", "transliteral": "kên", "traducao_palavra": "assim" },
        { "hebraico": "יֹורֵ֥ד", "transliteral": "yô-rêḏ", "traducao_palavra": "[aquele que] desce" },
        { "hebraico": "שְׁ֝אֹ֗ול", "transliteral": "šə-ʾô-wl", "traducao_palavra": "[à] sepultura/Selo" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "יַעֲלֶֽה׃", "transliteral": "ya-ʿă-leh", "traducao_palavra": "subirá" }
      ]
    },
    "10": {
      "traducao_completa": "Nunca mais tornará à sua casa, nem o seu lugar o conhecerá mais.",
      "palavras": [
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "Não" },
        { "hebraico": "יָשׁ֣וּב", "transliteral": "yā-šûḇ", "traducao_palavra": "voltará" },
        { "hebraico": "עֹ֣וד", "transliteral": "ʿô-wḏ", "traducao_palavra": "mais" },
        { "hebraico": "לְבֵיתֹ֑ו", "transliteral": "lə-ḇê-ṯô", "traducao_palavra": "à sua casa" },
        { "hebraico": "וְלֹא־", "transliteral": "wə-lō-", "traducao_palavra": "e não" },
        { "hebraico": "יַכִּירֶ֥נּוּ", "transliteral": "yak-kî-ren-nû", "traducao_palavra": "conhecerá ele" },
        { "hebraico": "עֹ֗וד", "transliteral": "ʿô-wḏ", "traducao_palavra": "mais" },
        { "hebraico": "מְקֹומֹֽו׃", "transliteral": "mə-qō-w-mô", "traducao_palavra": "o seu lugar" }
      ]
    },
    "11": {
      "traducao_completa": "Portanto eu não pouparei a minha boca; falarei na angústia do meu espírito; queixar-me-ei na amargura da minha alma.",
      "palavras": [
        { "hebraico": "גַּם־", "transliteral": "gam-", "traducao_palavra": "Também" },
        { "hebraico": "אֲנִ֭י", "transliteral": "ʾă-nî", "traducao_palavra": "eu" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "אֶחֱשֳָׂךְ־", "transliteral": "ʾe-ḥĕ-śāḵ-", "traducao_palavra": "pouparei/reterei" },
        { "hebraico": "פִּ֑י", "transliteral": "p̄î", "traducao_palavra": "minha boca" },
        { "hebraico": "אֲֽדַבְּרָה֮", "transliteral": "ʾă-ḏab-bə-rā", "traducao_palavra": "falarei" },
        { "hebraico": "בְּצַ֪ר", "transliteral": "bə-ṣar", "traducao_palavra": "na angústia de" },
        { "hebraico": "רוּחִ֫י", "transliteral": "rû-ḥî", "traducao_palavra": "meu espírito" },
        { "hebraico": "אָשִׂ֥יחָה", "transliteral": "ʾā-śî-ḥā", "traducao_palavra": "reclamarei/queixar-me-ei" },
        { "hebraico": "בְּמַ֣ר", "transliteral": "bə-mar", "traducao_palavra": "na amargura de" },
        { "hebraico": "נַפְשִֽׁי׃", "transliteral": "nap̄-šî", "traducao_palavra": "minha alma" }
      ]
    },
    "12": {
      "traducao_completa": "Sou eu, porventura, o mar, ou monstro marinho, para que me ponhas uma guarda?",
      "palavras": [
        { "hebraico": "הֲיָם־", "transliteral": "hă-yām-", "traducao_palavra": "Acaso [sou] o mar" },
        { "hebraico": "אָ֥נִי", "transliteral": "ʾā-nî", "traducao_palavra": "eu" },
        { "hebraico": "אִם־", "transliteral": "ʾim-", "traducao_palavra": "ou" },
        { "hebraico": "תַּנִּ֑ין", "transliteral": "tan-nîn", "traducao_palavra": "monstro marinho" },
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "que" },
        { "hebraico": "תָשִׂ֖ים", "transliteral": "ṯā-śîm", "traducao_palavra": "ponhas" },
        { "hebraico": "עָלַ֣י", "transliteral": "ʿā-lay", "traducao_palavra": "sobre mim" },
        { "hebraico": "מִשְׁמָֽר׃", "transliteral": "miš-mār", "traducao_palavra": "guarda" }
      ]
    },
    "13": {
      "traducao_completa": "Dizendo eu: Consolar-me-á a minha cama; meu leito abrandará a minha queixa;",
      "palavras": [
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "Pois" },
        { "hebraico": "אָ֭מַרְתִּי", "transliteral": "ʾā-mar-tî", "traducao_palavra": "disse eu" },
        { "hebraico": "תְּנַחֲמֵ֣נִי", "transliteral": "tə-na-ḥă-mê-nî", "traducao_palavra": "consolar-me-á" },
        { "hebraico": "עַרְשִׂ֑י", "transliteral": "ʿar-śî", "traducao_palavra": "minha cama" },
        { "hebraico": "יִשָּׂ֥א", "transliteral": "yiś-śā", "traducao_palavra": "ajudará a suportar" },
        { "hebraico": "בְ֝שִׂיחִ֗י", "transliteral": "ḇə-śî-ḥî", "traducao_palavra": "na minha queixa" },
        { "hebraico": "מִשְׁכָּבִֽי׃", "transliteral": "miš-kā-ḇî", "traducao_palavra": "meu leito" }
      ]
    },
    "14": {
      "traducao_completa": "Então me espantas com sonhos, e com visões me aterrorizas;",
      "palavras": [
        { "hebraico": "וְחִתַּתַּ֥נִי", "transliteral": "wə-ḥit-tat-ta-nî", "traducao_palavra": "Então me espantas" },
        { "hebraico": "בַחֲלֹמֹ֑ות", "transliteral": "ḇa-ḥă-lō-mō-wṯ", "traducao_palavra": "com sonhos" },
        { "hebraico": "וּמֵחֶזְיֹנֹ֥ות", "transliteral": "ū-mê-ḥez-yō-nō-wṯ", "traducao_palavra": "e com visões" },
        { "hebraico": "תְּבַעֲתַֽנִּי׃", "transliteral": "tə-ḇa-ʿă-ṯan-nî", "traducao_palavra": "me aterrorizas" }
      ]
    },
    "15": {
      "traducao_completa": "Pelo que a minha alma escolheria antes a estrangulação, e a morte do que estes meus ossos.",
      "palavras": [
        { "hebraico": "וַתִּבְחַ֧ר", "transliteral": "wat-tiḇ-ḥar", "traducao_palavra": "Assim escolhe" },
        { "hebraico": "מַחֲנָ֣ק", "transliteral": "ma-ḥă-nāq", "traducao_palavra": "estrangulação" },
        { "hebraico": "נַפְשִׁ֑י", "transliteral": "nap̄-šî", "traducao_palavra": "minha alma" },
        { "hebraico": "מָ֝וֶת", "transliteral": "mā-weṯ", "traducao_palavra": "[a] morte" },
        { "hebraico": "מֵעַצְמֹותָֽי׃", "transliteral": "mê-ʿaṣ-mō-w-ṯāy", "traducao_palavra": "do que meus ossos" }
      ]
    },
    "16": {
      "traducao_completa": "A minha vida abomino, pois não quereria viver para sempre; retira-te de mim, pois os meus dias são vaidade.",
      "palavras": [
        { "hebraico": "מָ֭אַסְתִּי", "transliteral": "mā-ʾas-tî", "traducao_palavra": "Abomino" },
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "לְעֹלָ֣ם", "transliteral": "lə-ʿō-lām", "traducao_palavra": "para sempre" },
        { "hebraico": "אֶחְיֶ֑ה", "transliteral": "ʾeḥ-yeh", "traducao_palavra": "viveria" },
        { "hebraico": "חֲדַ֥ל", "transliteral": "ḥă-ḏal", "traducao_palavra": "Cessa/Retira-te" },
        { "hebraico": "מִ֝מֶּ֗נִּי", "transliteral": "mim-men-nî", "traducao_palavra": "de mim" },
        { "hebraico": "כִּי־", "transliteral": "kî-", "traducao_palavra": "pois" },
        { "hebraico": "הֶ֥בֶל", "transliteral": "he-ḇel", "traducao_palavra": "vaidade/sopro" },
        { "hebraico": "יָמָֽי׃", "transliteral": "yā-māy", "traducao_palavra": "[são] meus dias" }
      ]
    },
    "17": {
      "traducao_completa": "Que é o homem, para que tanto o engrandeças, e ponhas nele o teu coração,",
      "palavras": [
        { "hebraico": "מָֽה־", "transliteral": "mā-", "traducao_palavra": "Que" },
