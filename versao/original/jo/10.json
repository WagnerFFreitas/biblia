    "18": {
      "traducao_completa": "Por que, pois, me tiraste da madre? Ah! se eu morrera, e olho nenhum me vira!",
      "palavras": [
        { "hebraico": "וְלָ֣מָּה", "transliteral": "wə-lām-mā", "traducao_palavra": "E por que" },
        { "hebraico": "מֵ֭רֶחֶם", "transliteral": "mê-re-ḥem", "traducao_palavra": "da madre/útero" },
        { "hebraico": "הֹוצֵאתָ֑נִי", "transliteral": "hō-w-ṣê-ṯā-nî", "traducao_palavra": "me tiraste" },
        { "hebraico": "אֶ֝גְוַ֗ע", "transliteral": "ʾeḡ-waʿ", "traducao_palavra": "eu morresse/expirasse" },
        { "hebraico": "וְעַ֣יִן", "transliteral": "wə-ʿa-yin", "traducao_palavra": "e olho" },
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "תִרְאֵֽנִי׃", "transliteral": "ṯir-ʾê-nî", "traducao_palavra": "me visse" }
      ]
    },
    "19": {
      "traducao_completa": "Fora eu como se não fora; e da madre fora levado à sepultura!",
      "palavras": [
        { "hebraico": "כַּאֲשֶׁ֣ר", "transliteral": "ka-ʾă-šer", "traducao_palavra": "Como" },
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "הָיִ֣יתִי", "transliteral": "hā-yî-ṯî", "traducao_palavra": "tivesse existido" },
        { "hebraico": "אֶהְיֶ֑ה", "transliteral": "ʾeh-yeh", "traducao_palavra": "eu seria" },
        { "hebraico": "מִ֝בֶּ֗טֶן", "transliteral": "mib-be-ṭen", "traducao_palavra": "desde o ventre" },
        { "hebraico": "לַקֶּ֥בֶר", "transliteral": "laq-qe-ḇer", "traducao_palavra": "para a sepultura" },
        { "hebraico": "אוּבָֽל׃", "transliteral": "ʾû-ḇāl", "traducao_palavra": "levado" }
      ]
    },
    "20": {
      "traducao_completa": "Não são poucos os meus dias? Cessa, pois, e deixa-me, para que por um pouco eu tome alento.",
      "palavras": [
        { "hebraico": "הֲלֹא־", "transliteral": "hă-lō-", "traducao_palavra": "Acaso não" },
        { "hebraico": "מְעַ֣ט", "transliteral": "mə-ʿaṭ", "traducao_palavra": "[são] poucos" },
        { "hebraico": "יָמַ֣י", "transliteral": "yā-may", "traducao_palavra": "meus dias?" },
        { "hebraico": "וַחֲדָ֑ל", "transliteral": "wa-ḥă-ḏāl", "traducao_palavra": "cessa" },
        { "hebraico": "וְשִׁ֥ית", "transliteral": "wə-šîṯ", "traducao_palavra": "e desvia [teu olhar]" },
        { "hebraico": "מִ֝מֶּ֗נִּי", "transliteral": "mim-men-nî", "traducao_palavra": "de mim" },
        { "hebraico": "וְאַבְלִ֥יגָה", "transliteral": "wə-ʾaḇ-lî-ḡā", "traducao_palavra": "e tomarei alento" },
        { "hebraico": "מְּעָֽט׃", "transliteral": "mə-ʿāṭ", "traducao_palavra": "um pouco" }
      ]
    },
    "21": {
      "traducao_completa": "Antes que eu vá para o lugar de onde não voltarei, para a terra de trevas e de sombra de morte,",
      "palavras": [
        { "hebraico": "בְּטֶ֣רֶם", "transliteral": "bə-ṭe-rem", "traducao_palavra": "Antes que" },
        { "hebraico": "אֵ֭לֵךְ", "transliteral": "ʾê-lêḵ", "traducao_palavra": "eu vá" },
        { "hebraico": "וְלֹ֣א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "אָשׁ֑וּב", "transliteral": "ʾā-šūḇ", "traducao_palavra": "volte" },
        { "hebraico": "אֶל־", "transliteral": "ʾel-", "traducao_palavra": "para" },
        { "hebraico": "אֶ֥רֶץ", "transliteral": "ʾe-reṣ", "traducao_palavra": "a terra de" },
        { "hebraico": "חֹ֝שֶׁךְ", "transliteral": "ḥō-šeḵ", "traducao_palavra": "trevas" },
        { "hebraico": "וְצַלְמָֽוֶת׃", "transliteral": "wə-ṣal-mā-weṯ", "traducao_palavra": "e sombra da morte" }
      ]
    },
    "22": {
      "traducao_completa": "Terra de escuridão, como a própria escuridão profunda, terra da sombra da morte e sem ordem alguma, e onde a própria luz é como a escuridão.",
      "palavras": [
        { "hebraico": "אֶ֤רֶץ", "transliteral": "ʾe-reṣ", "traducao_palavra": "Terra de" },
        { "hebraico": "עֵפָ֨תָה", "transliteral": "ʿê-p̄ā-ṯā", "traducao_palavra": "escuridão profunda" },
        { "hebraico": "כְּמֹ֬ו", "transliteral": "kə-mô", "traducao_palavra": "como" },
        { "hebraico": "אֹ֨פֶל", "transliteral": "ʾō-p̄el", "traducao_palavra": "trevas" },
        { "hebraico": "צַלְמָ֨וֶת֙", "transliteral": "ṣal-mā-weṯ", "traducao_palavra": "sombra da morte" },
        { "hebraico": "וְלֹ֣א", "transliteral": "wə-lō", "traducao_palavra": "e sem" },
        { "hebraico": "סְדָרִ֔ים", "transliteral": "śə-ḏā-rîm", "traducao_palavra": "ordem" },
