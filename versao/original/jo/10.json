{
  "livro": "Jó - אִיּוֹב - ʾIy-yōḇ",
  "capítulo": 10,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "A minha alma tem tédio da minha vida; darei livre curso à minha queixa; falarei na amargura da minha alma.",
      "palavras": [
        { "hebraico": "נָקְטָ֥ה", "transliteral": "nā-qə-ṭā", "traducao_palavra": "Tem tédio/está cansada" },
        { "hebraico": "נַפְשִׁ֖י", "transliteral": "nap̄-šî", "traducao_palavra": "minha alma" },
        { "hebraico": "בְּחַיָּ֑י", "transliteral": "bə-ḥay-yāy", "traducao_palavra": "da minha vida" },
        { "hebraico": "אֶעֶזְבָ֤ה", "transliteral": "ʾe-ʿez-ḇā", "traducao_palavra": "deixarei/soltarei" },
        { "hebraico": "עָלַ֨י", "transliteral": "ʿā-lay", "traducao_palavra": "sobre mim" },
        { "hebraico": "שִׂיחִ֔י", "transliteral": "śî-ḥî", "traducao_palavra": "minha queixa" },
        { "hebraico": "אֲ֝דַבְּרָה", "transliteral": "ʾă-ḏab-bə-rā", "traducao_palavra": "falarei" },
        { "hebraico": "בְּמַ֥ר", "transliteral": "bə-mar", "traducao_palavra": "na amargura de" },
        { "hebraico": "נַפְשִֽׁי׃", "transliteral": "nap̄-šî", "traducao_palavra": "minha alma" }
      ]
    },
    "2": {
      "traducao_completa": "Direi a Deus: Não me condenes; faze-me saber por que contendes comigo.",
      "palavras": [
        { "hebraico": "אֹמַ֣ר", "transliteral": "ʾō-mar", "traducao_palavra": "Direi" },
        { "hebraico": "אֶל־", "transliteral": "ʾel-", "traducao_palavra": "a" },
        { "hebraico": "אֱ֭לֹוהַּ", "transliteral": "ʾĕ-lō-hwah", "traducao_palavra": "Deus" },
        { "hebraico": "אַל־", "transliteral": "ʾal-", "traducao_palavra": "Não" },
        { "hebraico": "תַּרְשִׁיעֵ֑נִי", "transliteral": "tar-šî-ʿê-nî", "traducao_palavra": "me condenes" },
        { "hebraico": "הֹודִיעֵ֝נִי", "transliteral": "hō-w-ḏî-ʿê-nî", "traducao_palavra": "faze-me saber" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre" },
        { "hebraico": "מַ֥ה", "transliteral": "mah", "traducao_palavra": "o quê" },
        { "hebraico": "תְּרִיבֵֽנִי׃", "transliteral": "tə-rî-ḇê-nî", "traducao_palavra": "contendes comigo" }
      ]
    },
    "3": {
      "traducao_completa": "Parece-te bem que me oprimas, que rejeites o trabalho das tuas mãos e resplandeças sobre o conselho dos ímpios?",
      "palavras": [
        { "hebraico": "הֲטֹ֤וב", "transliteral": "hă-ṭôḇ", "traducao_palavra": "Acaso [é] bom" },
        { "hebraico": "לְךָ֨ ׀", "transliteral": "lə-ḵā", "traducao_palavra": "para Ti" },
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "que" },
        { "hebraico": "תַעֲשֹׁ֗ק", "transliteral": "ṯa-ʿă-šōq", "traducao_palavra": "oprimas" },
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "que" },
        { "hebraico": "תִמְאַ֪ס", "transliteral": "ṯim-ʾāś", "traducao_palavra": "rejeites" },
        { "hebraico": "יְגִ֪יעַ", "transliteral": "yə-ḡî-aʿ", "traducao_palavra": "[o] trabalho de" },
        { "hebraico": "כַּפֶּ֫יךָ", "transliteral": "kap-pey-ḵā", "traducao_palavra": "Tuas mãos" },
        { "hebraico": "וְעַל־", "transliteral": "wə-ʿal-", "traducao_palavra": "e sobre" },
        { "hebraico": "עֲצַ֖ת", "transliteral": "ʿă-ṣaṯ", "traducao_palavra": "[o] conselho de" },
        { "hebraico": "רְשָׁעִ֣ים", "transliteral": "rə-šā-ʿîm", "traducao_palavra": "ímpios" },
        { "hebraico": "הֹופָֽעְתָּ׃", "transliteral": "hō-w-p̄ā-ʿə-tā", "traducao_palavra": "resplandeças" }
      ]
    },
    "4": {
      "traducao_completa": "Tens tu, porventura, olhos de carne? Vês tu como vê o homem?",
      "palavras": [
        { "hebraico": "הַעֵינֵ֣י", "transliteral": "ha-ʿê-nê", "traducao_palavra": "Acaso olhos de" },
        { "hebraico": "בָשָׂ֣ר", "transliteral": "ḇā-śār", "traducao_palavra": "carne" },
        { "hebraico": "לָ֑ךְ", "transliteral": "lāḵ", "traducao_palavra": "[tens] Tu?" },
        { "hebraico": "אִם־", "transliteral": "ʾim-", "traducao_palavra": "Ou" },
        { "hebraico": "כִּרְאֹ֖ות", "transliteral": "kir-ʾô-wṯ", "traducao_palavra": "como vê" },
        { "hebraico": "אֱנֹ֣ושׁ", "transliteral": "ʾĕ-nō-wš", "traducao_palavra": "[o] homem" },
        { "hebraico": "תִּרְאֶֽה׃", "transliteral": "tir-ʾeh", "traducao_palavra": "vês Tu?" }
      ]
    },
    "5": {
      "traducao_completa": "São os teus dias como os dias do homem? Ou são os teus anos como os anos de um homem,",
      "palavras": [
        { "hebraico": "הֲכִימֵ֣i", "transliteral": "hă-ḵî-mê", "traducao_palavra": "Acaso como os dias de" },
        { "hebraico": "אֱנֹ֣ושׁ", "transliteral": "ʾĕ-nō-wš", "traducao_palavra": "homem" },
        { "hebraico": "יָמֶ֑יךָ", "transliteral": "yā-mey-ḵā", "traducao_palavra": "[são] teus dias?" },
        { "hebraico": "אִם־", "transliteral": "ʾim-", "traducao_palavra": "Ou" },
        { "hebraico": "שְׁ֝נֹותֶ֗יךָ", "transliteral": "šə-nō-w-ṯey-ḵā", "traducao_palavra": "teus anos" },
        { "hebraico": "כִּימֵ֥i", "transliteral": "kî-mê", "traducao_palavra": "como os dias de" },
        { "hebraico": "גָֽבֶר׃", "transliteral": "ḡā-ḇer", "traducao_palavra": "um varão/homem" }
      ]
    },
    "6": {
      "traducao_completa": "Para te informares da minha iniquidade, e inquirires do meu pecado?",
      "palavras": [
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "Para que" },
        { "hebraico": "תְבַקֵּ֥שׁ", "transliteral": "ṯə-ḇaq-qêš", "traducao_palavra": "busques" },
        { "hebraico": "לַעֲוֹנִ֑י", "transliteral": "la-ʿă-wō-nî", "traducao_palavra": "pela minha iniquidade" },
        { "hebraico": "וּלְחַטָּאתִ֥י", "transliteral": "ū-lə-ḥaṭ-ṭā-ṯî", "traducao_palavra": "e pelo meu pecado" },
        { "hebraico": "תִדְרֹֽושׁ׃", "transliteral": "ṯiḏ-rôš", "traducao_palavra": "inquiras" }
      ]
    },
    "7": {
      "traducao_completa": "Bem sabes tu que eu não sou ímpio; todavia ninguém há que me livre da tua mão.",
      "palavras": [
        { "hebraico": "עַֽל־", "transliteral": "ʿal-", "traducao_palavra": "Apesar de" },
        { "hebraico": "דַּ֭עְתְּךָ", "transliteral": "daʿ-tə-ḵā", "traducao_palavra": "Tu saberes" },
        { "hebraico": "כִּי־", "transliteral": "kî-", "traducao_palavra": "que" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "אֶרְשָׁ֑ע", "transliteral": "ʾer-šāʿ", "traducao_palavra": "sou ímpio" },
        { "hebraico": "וְאֵ֖ין", "transliteral": "wə-ʾên", "traducao_palavra": "e não há" },
        { "hebraico": "מִיָּדְךָ֣", "transliteral": "miy-yā-ḏə-ḵā", "traducao_palavra": "da Tua mão" },
        { "hebraico": "מַצִּֽיל׃", "transliteral": "maṣ-ṣîl", "traducao_palavra": "quem livre" }
      ]
    },
    "8": {
      "traducao_completa": "As tuas mãos me fizeram e me formaram todo em redor; e todavia me consomes.",
      "palavras": [
        { "hebraico": "יָדֶ֥יךָ", "transliteral": "yā-ḏey-ḵā", "traducao_palavra": "Tuas mãos" },
        { "hebraico": "עִצְּב֦וּנִי", "transliteral": "ʿiṣ-ṣə-ḇû-nî", "traducao_palavra": "formaram-me" },
        { "hebraico": "וַֽיַּעֲשׂ֑וּנִי", "transliteral": "way-ya-ʿă-śû-nî", "traducao_palavra": "e fizeram-me" },
        { "hebraico": "יַ֧חַד", "transliteral": "ya-ḥaḏ", "traducao_palavra": "junto" },
        { "hebraico": "סָבִ֗יב", "transliteral": "śā-ḇîḇ", "traducao_palavra": "em redor" },
        { "hebraico": "וַֽתְּבַלְּעֵֽנִי׃", "transliteral": "wat-tə-ḇal-lə-ʿê-nî", "traducao_palavra": "e me consomes" }
      ]
    },
    "9": {
      "traducao_completa": "Lembra-te, rogo-te, de que como barro me formaste e me farias tornar ao pó?",
      "palavras": [
        { "hebraico": "זְכָר־", "transliteral": "zə-ḵār-", "traducao_palavra": "Lembra-te" },
        { "hebraico": "נָ֭א", "transliteral": "nā", "traducao_palavra": "rogo-te" },
        { "hebraico": "כִּי־", "transliteral": "kî-", "traducao_palavra": "que" },
        { "hebraico": "כַחֹ֣מֶר", "transliteral": "ḵa-ḥō-mer", "traducao_palavra": "como barro" },
        { "hebraico": "עֲשִׂיתָ֑נִי", "transliteral": "ʿă-śî-ṯā-nî", "traducao_palavra": "me fizeste" },
        { "hebraico": "וְאֶל־", "transliteral": "wə-ʾel-", "traducao_palavra": "e para" },
        { "hebraico": "עָפָ֥ר", "transliteral": "ʿā-p̄ār", "traducao_palavra": "[o] pó" },
        { "hebraico": "תְּשִׁיבֵֽנִי׃", "transliteral": "tə-šî-ḇê-nî", "traducao_palavra": "me farás voltar" }
      ]
    },
    "10": {
      "traducao_completa": "Porventura não me vazaste como leite, e não me coalhaste como queijo?",
      "palavras": [
        { "hebraico": "הֲלֹ֥א", "transliteral": "hă-lō", "traducao_palavra": "Acaso não" },
        { "hebraico": "כֶחָלָ֥ב", "transliteral": "ḵe-ḥā-lāḇ", "traducao_palavra": "como leite" },
        { "hebraico": "תַּתִּיכֵ֑נִי", "transliteral": "tat-tî-ḵê-nî", "traducao_palavra": "me vazaste" },
        { "hebraico": "וְ֝כַגְּבִנָּ֗ה", "transliteral": "wə-ḵaḡ-bin-nā", "traducao_palavra": "e como queijo" },
        { "hebraico": "תַּקְפִּיאֵֽנִי׃", "transliteral": "taq-pî-ʾê-nî", "traducao_palavra": "me coalhaste" }
      ]
    },
    "11": {
      "traducao_completa": "De pele e carne me vestiste, e de ossos e nervos me teceste.",
      "palavras": [
        { "hebraico": "עֹ֣ור", "transliteral": "ʿō-wr", "traducao_palavra": "Pele" },
        { "hebraico": "וּ֭בָשָׂר", "transliteral": "ū-ḇā-śār", "traducao_palavra": "e carne" },
        { "hebraico": "תַּלְבִּישֵׁ֑נִי", "transliteral": "tal-bî-šê-nî", "traducao_palavra": "me vestiste" },
        { "hebraico": "וּבַעֲצָמֹ֥ות", "transliteral": "ū-ḇa-ʿă-ṣā-mō-wṯ", "traducao_palavra": "e com ossos" },
        { "hebraico": "וְ֝גִידִ֗ים", "transliteral": "wə-ḡî-ḏîm", "traducao_palavra": "e nervos" },
        { "hebraico": "תְּשֹׂכְכֵֽנִי׃", "transliteral": "tə-śō-ḵə-ḵê-nî", "traducao_palavra": "me entreteceste" }
      ]
    },
    "12": {
      "traducao_completa": "Vida e misericórdia me concedeste; e a tua visitação guardou o meu espírito.",
      "palavras": [
        { "hebraico": "חַיִּ֣ים", "transliteral": "ḥay-yîm", "traducao_palavra": "Vida" },
        { "hebraico": "וָ֭חֶסֶד", "transliteral": "wā-ḥe-seḏ", "traducao_palavra": "e misericórdia" },
        { "hebraico": "עָשִׂ֣יתָ", "transliteral": "ʿā-śî-ṯā", "traducao_palavra": "fizeste" },
        { "hebraico": "עִמָּדִ֑י", "transliteral": "ʿim-mā-ḏî", "traducao_palavra": "comigo" },
        { "hebraico": "וּ֝פְקֻדָּתְךָ֗", "transliteral": "ū-p̄ə-qud-dā-ṯə-ḵā", "traducao_palavra": "e o teu cuidado/visitação" },
        { "hebraico": "שָֽׁמְרָ֥ה", "transliteral": "šā-mə-rā", "traducao_palavra": "guardou" },
        { "hebraico": "רוּחִֽי׃", "transliteral": "rû-ḥî", "traducao_palavra": "meu espírito" }
      ]
    },
    "13": {
      "traducao_completa": "Mas estas coisas ocultaste no teu coração; bem sei eu que isto esteve contigo:",
      "palavras": [
        { "hebraico": "וְאֵ֥לֶּה", "transliteral": "wə-ʾêl-leh", "traducao_palavra": "Mas estas coisas" },
        { "hebraico": "צָפַ֪נְתָּ", "transliteral": "ṣā-p̄an-tā", "traducao_palavra": "ocultaste" },
        { "hebraico": "בִלְבָבֶ֑ךָ", "transliteral": "ḇil-ḇā-ḇe-ḵā", "traducao_palavra": "no Teu coração" },
        { "hebraico": "יָ֝דַ֗עְתִּי", "transliteral": "yā-ḏaʿ-tî", "traducao_palavra": "sei eu" },
        { "hebraico": "כִּי־", "transliteral": "kî-", "traducao_palavra": "que" },
        { "hebraico": "זֹ֥at", "transliteral": "zōṯ", "traducao_palavra": "isto" },
        { "hebraico": "עִמָּֽךְ׃", "transliteral": "ʿim-māḵ", "traducao_palavra": "[estava] contigo" }
      ]
    },
    "14": {
      "traducao_completa": "Se eu pecar, tu me observas; e da minha iniquidade não me absolverás.",
      "palavras": [
        { "hebraico": "אִם־", "transliteral": "ʾim-", "traducao_palavra": "Se" },
        { "hebraico": "חָטָ֥אתִי", "transliteral": "ḥā-ṭā-ṯî", "traducao_palavra": "eu pecar" },
        { "hebraico": "וּשְׁמַרְתָּ֑נִי", "transliteral": "ū-šə-mar-tā-nî", "traducao_palavra": "então Tu me observas" },
        { "hebraico": "וּ֝מֵעֲוֹנִ֗י", "transliteral": "ū-mê-ʿă-wō-nî", "traducao_palavra": "e da minha iniquidade" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "תְנַקֵּֽנִי׃", "transliteral": "ṯə-naq-qê-nî", "traducao_palavra": "me absolverás" }
      ]
    },
    "15": {
      "traducao_completa": "Se for ímpio, ai de mim! E se for justo, não levantarei a minha cabeça; farto estou de ignomínia, e vejo a minha aflição.",
      "palavras": [
        { "hebraico": "אִם־", "transliteral": "ʾim-", "traducao_palavra": "Se" },
        { "hebraico": "רָשַׁ֡עְתִּי", "transliteral": "rā-šaʿ-tî", "traducao_palavra": "sou ímpio" },
        { "hebraico": "אַלְלַ֬י", "transliteral": "ʾal-lay", "traducao_palavra": "ai de" },
        { "hebraico": "לִ֗י", "transliteral": "lî", "traducao_palavra": "mim" },
        { "hebraico": "וְ֭צָדַקְתִּי", "transliteral": "wə-ṣā-ḏaq-tî", "traducao_palavra": "e se sou justo" },
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "אֶשָּׂ֣א", "transliteral": "ʾeś-śā", "traducao_palavra": "levantarei" },
        { "hebraico": "רֹאשִׁ֑י", "transliteral": "rō-šî", "traducao_palavra": "minha cabeça" },
        { "hebraico": "שְׂבַ֥ע", "transliteral": "śə-ḇaʿ", "traducao_palavra": "saciado de/farto de" },
        { "hebraico": "קָ֝לֹ֗ון", "transliteral": "qā-lô-wn", "traducao_palavra": "desonra/vergonha" },
        { "hebraico": "וּרְאֵ֥ה", "transliteral": "ū-rə-ʾēh", "traducao_palavra": "e vejo" },
        { "hebraico": "עָנְיִֽי׃", "transliteral": "ʿā-nyî", "traducao_palavra": "minha aflição" }
      ]
    },
    "16": {
      "traducao_completa": "Se a minha cabeça se levantar, tu me caças como a um leão feroz; e tornas a fazer maravilhas contra mim.",
      "palavras": [
        { "hebraico": "וְיִ֭גְאֶה", "transliteral": "wə-yiḡ-ʾeh", "traducao_palavra": "E se [ela] se exalta/levanta" },
        { "hebraico": "כַּשַּׁ֣חַל", "transliteral": "kaš-ša-ḥal", "traducao_palavra": "como um leão feroz" },
        { "hebraico": "תְּצוּדֵ֑נִי", "transliteral": "tə-ṣû-ḏê-nî", "traducao_palavra": "Tu me caças" },
        { "hebraico": "וְ֝תָשֹׁ֗ב", "transliteral": "wə-ṯā-šōḇ", "traducao_palavra": "e voltas" },
        { "hebraico": "תִּתְפַּלָּא־", "transliteral": "tiṯ-pal-lā-", "traducao_palavra": "a mostrar Teu poder/maravilhas" },
        { "hebraico": "בִֽי׃", "transliteral": "ḇî", "traducao_palavra": "contra mim" }
      ]
    },
    "17": {
      "traducao_completa": "Tu renovas contra mim as tuas testemunhas, e multiplicas contra mim a tua ira; sucessivas tropas estão comigo.",
      "palavras": [
        { "hebraico": "תְּחַדֵּ֬שׁ", "transliteral": "tə-ḥad-dêš", "traducao_palavra": "Renovas" },
        { "hebraico": "עֵדֶ֨יךָ", "transliteral": "ʿê-ḏey-ḵā", "traducao_palavra": "Tuas testemunhas" },
        { "hebraico": "נֶגְדִּ֗י", "transliteral": "neḡ-dî", "traducao_palavra": "defronte de mim" },
        { "hebraico": "וְתֶ֣רֶב", "transliteral": "wə-ṯe-reḇ", "traducao_palavra": "e aumentas/multiplicas" },
        { "hebraico": "כַּֽעַשְׂךָ֣", "transliteral": "ka-ʿaś-ḵā", "traducao_palavra": "Tua ira/indignação" },
        { "hebraico": "עִמָּדִ֑י", "transliteral": "ʿim-mā-ḏî", "traducao_palavra": "contra mim" },
        { "hebraico": "חֲלִיפֹ֖ות", "transliteral": "ḥă-lî-p̄ō-wṯ", "traducao_palavra": "sucessões/mudanças" },
        { "hebraico": "וְצָבָ֣א", "transliteral": "wə-ṣā-ḇā", "traducao_palavra": "e exército" },
        { "hebraico": "עִמִּֽי׃", "transliteral": "ʿim-mî", "traducao_palavra": "[estão] comigo" }
      ]
