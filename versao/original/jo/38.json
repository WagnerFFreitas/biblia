        { "hebraico": "חֲלָ֫צֶ֥יךָ", "transliteral": "ḥă-lā-ṣey-ḵā", "traducao_palavra": "teus lombos" },
        { "hebraico": "וְאֶשְׁאָלְךָ֭", "transliteral": "wə-ʾeš-ʾā-lə-ḵā", "traducao_palavra": "e perguntar-te-ei" },
        { "hebraico": "וְהֹודִיעֵֽנִי׃", "transliteral": "wə-hō-w-ḏî-ʿê-nî", "traducao_palavra": "e declara-me/instrui-me" }
      ]
    },
    "4": {
