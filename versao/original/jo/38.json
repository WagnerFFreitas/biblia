        { "hebraico": "אֶת־", "transliteral": "ʾeṯ-", "traducao_palavra": "[objeto]" },
        { "hebraico": "אִיֹּ֖וב", "transliteral": "ʾiy-yō-wḇ", "traducao_palavra": "Jó" },
        { "hebraico": "מִ֥ן", "transliteral": "min", "traducao_palavra": "desde/do meio de" },
