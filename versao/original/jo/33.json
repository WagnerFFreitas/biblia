        { "hebraico": "יַחְשֹׂ֣ךְ", "transliteral": "yaḥ-śōḵ", "traducao_palavra": "Para poupar/reter" },
        { "hebraico": "נַ֭פְשׁוֹ", "transliteral": "nap̄-šô", "traducao_palavra": "a sua alma" },
        { "hebraico": "מִנִּי־", "transliteral": "min-nî-", "traducao_palavra": "da" },
        { "hebraico": "שָׁ֑חַת", "transliteral": "šā-ḥaṯ", "traducao_palavra": "cova/fosso" },
        { "hebraico": "וְ֝חַיָּתֹ֗ו", "transliteral": "wə-ḥay-yā-ṯô", "traducao_palavra": "e a sua vida" },
        { "hebraico": "מֵעֲבֹ֥ר", "transliteral": "mê-ʿă-ḇōr", "traducao_palavra": "de passar" },
        { "hebraico": "בַּשָּֽׁלַח׃", "transliteral": "baš-šā-laḥ", "traducao_palavra": "pela arma/espada" }
      ]
    },
    "19": {
      "traducao_completa": "Também no seu leito é castigado com dores; e com incessante tremida nos seus ossos;",
      "palavras": [
        { "hebraico": "וְהוּכַ֣ח", "transliteral": "wə-hû-ḵaḥ", "traducao_palavra": "Também é castigado" },
        { "hebraico": "בְּ֭מַכְאֹוב", "transliteral": "bə-maḵ-ʾôḇ", "traducao_palavra": "com dor" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre" },
        { "hebraico": "מִשְׁכָּבֹ֑ו", "transliteral": "miš-kā-ḇô", "traducao_palavra": "seu leito" },
        { "hebraico": "וְרֹ֖יב", "transliteral": "wə-rîḇ", "traducao_palavra": "e a luta/multidão de" },
        { "hebraico": "עֲצָמָ֣יו", "transliteral": "ʿă-ṣā-māyw", "traducao_palavra": "seus ossos [é]" },
        { "hebraico": "אֵתָֽן׃", "transliteral": "ʾê-ṯān", "traducao_palavra": "incessante/forte" }
      ]
    },
    "20": {
      "traducao_completa": "De modo que a sua vida abomina o pão, e a sua alma a comida apetecível.",
      "palavras": [
        { "hebraico": "וְזִֽהֲמַ֣תּוּ", "transliteral": "wə-zi-hă-mat-tû", "traducao_palavra": "E faz abominar nele" },
        { "hebraico": "חַיָּתֹ֣ו", "transliteral": "ḥay-yā-ṯô", "traducao_palavra": "a sua vida" },
        { "hebraico": "לָ֑חֶם", "transliteral": "lā-ḥem", "traducao_palavra": "o pão" },
        { "hebraico": "וְ֝נַפְשֹׁ֗ו", "transliteral": "wə-nap̄-šô", "traducao_palavra": "e a sua alma" },
        { "hebraico": "מַאֲכַ֥ל", "transliteral": "ma-ʾă-ḵal", "traducao_palavra": "[a] comida" },
        { "hebraico": "תַּאֲוָֽה׃", "transliteral": "ta-ʾă-wā", "traducao_palavra": "desejável" }
      ]
    },
    "21": {
      "traducao_completa": "A sua carne desaparece a olhos vistos, e os seus ossos, que não se viam, aparecem.",
      "palavras": [
        { "hebraico": "יִִ֥כֶל", "transliteral": "yi-ḵel", "traducao_palavra": "Consome-se" },
        { "hebraico": "בְּשָׂרֹ֥ו", "transliteral": "bə-śā-rô", "traducao_palavra": "sua carne" },
        { "hebraico": "מֵרֹ֑אִי", "transliteral": "mê-rō-ʾî", "traducao_palavra": "de ser vista" },
        { "hebraico": "וְשֻׁפּוּ", "transliteral": "wə-šup-pû", "traducao_palavra": "e tornam-se proeminentes" },
        { "hebraico": "עַ֝צְמֹותָ֗יו", "transliteral": "ʿaṣ-mô-ṯāyw", "traducao_palavra": "seus ossos" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "[que] não" },
        { "hebraico": "רֻאּֽוּ׃", "transliteral": "ru-ʾû", "traducao_palavra": "se viam" }
      ]
    },
    "22": {
      "traducao_completa": "E a sua alma se chega à cova, e a sua vida aos que trazem a morte.",
      "palavras": [
        { "hebraico": "וַתִּקְרַ֥ב", "transliteral": "wat-tiq-raḇ", "traducao_palavra": "E chega-se" },
        { "hebraico": "לַשַּׁ֣חַת", "transliteral": "laš-ša-ḥaṯ", "traducao_palavra": "à cova" },
        { "hebraico": "נַפְשֹׁ֑ו", "transliteral": "nap̄-šô", "traducao_palavra": "a sua alma" },
        { "hebraico": "וְ֝חַיָּתֹ֗ו", "transliteral": "wə-ḥay-yā-ṯô", "traducao_palavra": "e a sua vida" },
        { "hebraico": "לַֽמְמִתִֽים׃", "transliteral": "lam-mi-ṯîm", "traducao_palavra": "aos matadores/que trazem a morte" }
      ]
    },
    "23": {
      "traducao_completa": "Se com ele houver um anjo, um intérprete, um entre mil, para declarar ao homem a sua retidão,",
      "palavras": [
        { "hebraico": "אִם־", "transliteral": "ʾim-", "traducao_palavra": "Se" },
        { "hebraico": "יֵ֤שׁ", "transliteral": "yêš", "traducao_palavra": "houver" },
        { "hebraico": "עָלָ֨יו", "transliteral": "ʿā-lāyw", "traducao_palavra": "sobre ele" },
        { "hebraico": "מַלְאָ֗ךְ", "transliteral": "mal-ʾāḵ", "traducao_palavra": "um anjo" },
        { "hebraico": "מֵלִ֗יץ", "transliteral": "mê-lîṣ", "traducao_palavra": "um intérprete/mediador" },
        { "hebraico": "אֶחָ֥ד", "transliteral": "ʾe-ḥāḏ", "traducao_palavra": "um" },
        { "hebraico": "מִנִּי־", "transliteral": "min-nî-", "traducao_palavra": "de entre" },
        { "hebraico": "אָ֑לֶף", "transliteral": "ʾā-lep̄", "traducao_palavra": "mil" },
        { "hebraico": "לְהַגִּ֖id", "transliteral": "lə-hag-gîḏ", "traducao_palavra": "para declarar" },
        { "hebraico": "לְאָדָ֣ם", "transliteral": "lə-ʾā-ḏām", "traducao_palavra": "ao homem" },
        { "hebraico": "יָשְׁרֹֽו׃", "transliteral": "yā-šə-rô", "traducao_palavra": "sua retidão" }
      ]
    },
    "24": {
      "traducao_completa": "Então terá misericórdia dele, e lhe dirá: Livra-o, para que não desça à cova; já achei resgate.",
      "palavras": [
        { "hebraico": "וַיְחֻנֶּ֗נּוּ", "transliteral": "way-ḥun-nen-nū", "traducao_palavra": "Então terá misericórdia dele" },
        { "hebraico": "וַיֹּ֥אמֶר", "transliteral": "way-yō-mar", "traducao_palavra": "e dirá" },
        { "hebraico": "פְּדָעֵ֗הוּ", "transliteral": "pə-ḏā-ʿê-hū", "traducao_palavra": "livra-o" },
        { "hebraico": "מֵרֶ֥דֶת", "transliteral": "mê-re-ḏeṯ", "traducao_palavra": "de descer" },
        { "hebraico": "שָׁ֑חַת", "transliteral": "šā-ḥaṯ", "traducao_palavra": "[à] cova" },
        { "hebraico": "מָ֝צָ֗אתִי", "transliteral": "mā-ṣā-ṯî", "traducao_palavra": "achei" },
        { "hebraico": "כֹֽפֶר׃", "transliteral": "ḵō-p̄er", "traducao_palavra": "resgate" }
      ]
    },
    "25": {
      "traducao_completa": "A sua carne se renovará mais do que na sua infância; e voltará aos dias da sua juventude.",
      "palavras": [
        { "hebraico": "רֻֽטֲפַ֣שׁ", "transliteral": "ru-ṭă-p̄aš", "traducao_palavra": "Tornar-se-á fresca/viçosa" },
        { "hebraico": "בְּשָׂרֹ֣ו", "transliteral": "bə-śā-rô", "traducao_palavra": "sua carne" },
        { "hebraico": "מִנֹּ֑עַר", "transliteral": "min-nō-ʿar", "traducao_palavra": "mais que na infância" },
        { "hebraico": "יָ֝שׁוּב", "transliteral": "yā-šûḇ", "traducao_palavra": "voltará" },
        { "hebraico": "לִימֵ֥i", "transliteral": "lî-mê", "traducao_palavra": "aos dias de" },
        { "hebraico": "עֲלוּמָֽיו׃", "transliteral": "ʿă-lū-māyw", "traducao_palavra": "sua juventude" }
      ]
    },
    "26": {
      "traducao_completa": "Deveras orará a Deus, que se agradará dele, e verá a sua face com júbilo, e restituirá ao homem a sua justiça.",
      "palavras": [
        { "hebraico": "יֶעְתַּ֤ר", "transliteral": "ye-ʿə-tar", "traducao_palavra": "Orará" },
        { "hebraico": "אֶל־", "transliteral": "ʾel-", "traducao_palavra": "a" },
        { "hebraico": "אֱלֹ֨והַּ", "transliteral": "ʾĕ-lō-hwah", "traducao_palavra": "Deus" },
        { "hebraico": "וַיִּרְצֵ֗הוּ", "transliteral": "way-yir-ṣê-hū", "traducao_palavra": "e Ele se agradará dele" },
        { "hebraico": "וַיַּ֣רְא", "transliteral": "way-yar", "traducao_palavra": "e verá" },
        { "hebraico": "פָּ֭נָיו", "transliteral": "pā-nāyw", "traducao_palavra": "a face d'Ele" },
        { "hebraico": "בִּתְרוּעָ֑ה", "transliteral": "biṯ-rû-ʿā", "traducao_palavra": "com júbilo/brado" },
        { "hebraico": "וַיָּ֥שֶׁב", "transliteral": "way-yā-šeb", "traducao_palavra": "e restituirá" },
        { "hebraico": "לֶ֝אֱנֹ֗ושׁ", "transliteral": "le-ʾĕ-nō-wš", "traducao_palavra": "ao homem" },
        { "hebraico": "צִדְקָתֹֽו׃", "transliteral": "ṣiḏ-qā-ṯô", "traducao_palavra": "sua justiça" }
      ]
    },
    "27": {
      "traducao_completa": "Olhará para os homens e dirá: Pequei, e perverti o direito, o que de nada me aproveitou.",
      "palavras": [
        { "hebraico": "יָשֹׁ֪ר", "transliteral": "yā-šōr", "traducao_palavra": "Cantará/Olhará" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "para" },
        { "hebraico": "אֲנָשִׁ֟ים", "transliteral": "ʾă-nā-šîm", "traducao_palavra": "homens" },
        { "hebraico": "וַיֹּ֗אמֶר", "transliteral": "way-yō-mar", "traducao_palavra": "e dirá" },
        { "hebraico": "חָ֭טָאתִי", "transliteral": "ḥā-ṭā-ṯî", "traducao_palavra": "Pequei" },
        { "hebraico": "וְיָשָׁ֥ר", "transliteral": "wə-yā-šār", "traducao_palavra": "e o que é reto" },
        { "hebraico": "הֶעֱוֵ֗יתִי", "transliteral": "he-ʿĕ-wê-ṯî", "traducao_palavra": "perverti" },
        { "hebraico": "וְלֹא־", "transliteral": "wə-lō-", "traducao_palavra": "e não" },
        { "hebraico": "שָׁ֥וָה", "transliteral": "šā-wāh", "traducao_palavra": "aproveitou/foi igual" },
        { "hebraico": "לִֽי׃", "transliteral": "lî", "traducao_palavra": "para mim" }
      ]
    },
    "28": {
      "traducao_completa": "Deus livrou a minha alma de ir para a cova, e a minha vida verá a luz.",
      "palavras": [
        { "hebraico": "פָּ֘דָ֤ה", "transliteral": "pā-ḏā", "traducao_palavra": "Resgatou" },
        { "hebraico": "נַפְשִׁ֗י", "transliteral": "nap̄-šî", "traducao_palavra": "minha alma" },
        { "hebraico": "מֵעֲבֹ֥ר", "transliteral": "mê-ʿă-ḇōr", "traducao_palavra": "de passar" },
        { "hebraico": "בַּשָּׁ֑חַת", "transliteral": "ba-šā-ḥaṯ", "traducao_palavra": "na cova" },
        { "hebraico": "וְ֝חַיָּתִ֗י", "transliteral": "wə-ḥay-yā-ṯî", "traducao_palavra": "e minha vida" },
        { "hebraico": "בָּאֹ֥ור", "transliteral": "bā-ʾô-wr", "traducao_palavra": "na luz" },
        { "hebraico": "תִּרְאֶֽה׃", "transliteral": "tir-ʾeh", "traducao_palavra": "verá" }
      ]
    },
    "29": {
      "traducao_completa": "Eis que tudo isto faz Deus duas e três vezes para com o homem,",
      "palavras": [
        { "hebraico": "הֶן־", "transliteral": "hen-", "traducao_palavra": "Eis que" },
        { "hebraico": "כָּל־", "transliteral": "kāl-", "traducao_palavra": "todas" },
        { "hebraico": "אֵ֭לֶּה", "transliteral": "ʾêl-leh", "traducao_palavra": "estas coisas" },
        { "hebraico": "יִפְעַל־", "transliteral": "yip̄-ʿal-", "traducao_palavra": "faz/opera" },
        { "hebraico": "אֵ֑ל", "transliteral": "ʾêl", "traducao_palavra": "Deus" },
        { "hebraico": "פַּעֲמַ֥יִם", "transliteral": "pa-ʿă-ma-yim", "traducao_palavra": "duas vezes" },
        { "hebraico": "שָׁלֹ֝ושׁ", "transliteral": "šā-lō-wš", "traducao_palavra": "[ou] três" },
        { "hebraico": "עִם־", "transliteral": "ʿim-", "traducao_palavra": "com" },
        { "hebraico": "גָּֽבֶר׃", "transliteral": "gā-ḇer", "traducao_palavra": "o homem" }
      ]
    },
    "30": {
      "traducao_completa": "Para desviar a sua alma da cova, e o iluminar com a luz dos viventes.",
      "palavras": [
        { "hebraico": "לְהָשִׁ֣יב", "transliteral": "lə-hā-šîḇ", "traducao_palavra": "Para trazer de volta" },
        { "hebraico": "נַ֭פְשׁוֹ", "transliteral": "nap̄-šô", "traducao_palavra": "sua alma" },
        { "hebraico": "מִנִּי־", "transliteral": "min-nî-", "traducao_palavra": "da" },
        { "hebraico": "שָׁ֑חַת", "transliteral": "šā-ḥaṯ", "traducao_palavra": "cova" },
        { "hebraico": "לֵ֝אֹור", "transliteral": "lê-ʾôr", "traducao_palavra": "para iluminar" },
        { "hebraico": "בְּאֹ֥ור", "transliteral": "bə-ʾôr", "traducao_palavra": "com a luz de" },
        { "hebraico": "הַֽחַיִּֽים׃", "transliteral": "ha-ḥay-yîm", "traducao_palavra": "os viventes" }
      ]
    },
    "31": {
      "traducao_completa": "Escuta, ó Jó, ouve-me; cala-te, e eu falarei.",
      "palavras": [
        { "hebraico": "הַקְשֵׁ֣ב", "transliteral": "haq-šêḇ", "traducao_palavra": "Atenta" },
        { "hebraico": "אִיֹּ֣וב", "transliteral": "ʾiy-yō-wḇ", "traducao_palavra": "Jó" },
        { "hebraico": "שְׁמַֽע־", "transliteral": "šə-maʿ-", "traducao_palavra": "ouve" },
        { "hebraico": "לִ֑י", "transliteral": "lî", "traducao_palavra": "a mim" },
        { "hebraico": "הַ֝חֲרֵ֗שׁ", "transliteral": "ha-ḥă-rêš", "traducao_palavra": "cala-te" },
        { "hebraico": "וְאָנֹכִ֥י", "transliteral": "wə-ʾā-nō-ḵî", "traducao_palavra": "e eu" },
        { "hebraico": "אֲדַבֵּֽר׃", "transliteral": "ʾă-ḏab-bêr", "traducao_palavra": "falarei" }
      ]
    },
    "32": {
      "traducao_completa": "Se tens que dizer alguma coisa, responde-me; fala, porque desejo justificar-te.",
      "palavras": [
        { "hebraico": "אִם־", "transliteral": "ʾim-", "traducao_palavra": "Se" },
        { "hebraico": "יֵשׁ־", "transliteral": "yêš-", "traducao_palavra": "há" },
        { "hebraico": "מִלִּ֥ין", "transliteral": "mil-lîn", "traducao_palavra": "palavras" },
        { "hebraico": "הֲשִׁיבֵ֑נִי", "transliteral": "hă-šî-ḇê-nî", "traducao_palavra": "responde-me" },
        { "hebraico": "דַּ֝בֵּ֗ר", "transliteral": "dab-bêr", "traducao_palavra": "fala" },
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "porque" },
        { "hebraico": "חָפַ֥צְתִּי", "transliteral": "ḥā-p̄aṣ-tî", "traducao_palavra": "desejo" },
        { "hebraico": "צַדְּקֶֽךָּ׃", "transliteral": "ṣad-də-qek-kā", "traducao_palavra": "justificar-te" }
      ]
    },
    "33": {
      "traducao_completa": "Se não, ouve-me tu; cala-te, e ensinar-te-ei a sabedoria.",
      "palavras": [
        { "hebraico": "אִם־", "transliteral": "ʾim-", "traducao_palavra": "Se" },
        { "hebraico": "אַ֭יִן", "transliteral": "ʾa-yin", "traducao_palavra": "não [há nada]" },
        { "hebraico": "אַתָּ֣ה", "transliteral": "ʾat-tā", "traducao_palavra": "tu" },
        { "hebraico": "שְׁמַֽע־", "transliteral": "šə-maʿ-", "traducao_palavra": "ouve" },
        { "hebraico": "לִ֑י", "transliteral": "lî", "traducao_palavra": "a mim" },
        { "hebraico": "הַ֝חֲרֵ֗שׁ", "transliteral": "ha-ḥă-rêš", "traducao_palavra": "cala-te" },
        { "hebraico": "וַאֲאַלֶּפְךָ֥", "transliteral": "wa-ʾă-ʾal-lep̄-ḵā", "traducao_palavra": "e ensinar-te-ei" },
        { "hebraico": "חָכְמָֽה׃", "transliteral": "ḥā-ḵə-mā", "traducao_palavra": "sabedoria" }
      ]
    }
  }
