    "14": {
      "traducao_completa": "Eis que isto são apenas as orlas dos seus caminhos; e quão pouco é o que temos ouvido dele! Quem, pois, entenderia o trovão do seu poder?",
      "palavras": [
        { "hebraico": "הֶן־", "transliteral": "hen-", "traducao_palavra": "Eis que" },
        { "hebraico": "אֵ֤לֶּה ׀", "transliteral": "ʾēl-leh", "traducao_palavra": "estes [são]" },
