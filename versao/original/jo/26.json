        { "hebraico": "וְאֵ֥ין", "transliteral": "wə-ʾên", "traducao_palavra": "e não há" },
        { "hebraico": "כְּ֝ס֗וּת", "transliteral": "kə-śûṯ", "traducao_palavra": "cobertura" },
        { "hebraico": "לָאֲבַדֹּֽון׃", "transliteral": "lā-ʾă-ḇad-dô-wn", "traducao_palavra": "para o Abadom/Destruição" }
      ]
    },
    "7": {
      "traducao_completa": "Ele estende o norte sobre o vazio; suspende a terra sobre o nada.",
      "palavras": [
        { "hebraico": "נֹטֶ֣ה", "transliteral": "nō-ṭeh", "traducao_palavra": "Estende" },
        { "hebraico": "צָפֹ֣ון", "transliteral": "ṣā-p̄ô-wn", "traducao_palavra": "o norte" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre" },
        { "hebraico": "תֹּ֑הוּ", "transliteral": "tō-hû", "traducao_palavra": "[o] vazio" },
        { "hebraico": "תֹּלֶ֥ה", "transliteral": "tō-leh", "traducao_palavra": "suspende" },
        { "hebraico": "אֶ֝֗רֶץ", "transliteral": "ʾe-reṣ", "traducao_palavra": "[a] terra" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre" },
        { "hebraico": "בְּלִי־", "transliteral": "bə-lî-", "traducao_palavra": "[o] sem" },
        { "hebraico": "מָֽה׃", "transliteral": "mā", "traducao_palavra": "nada" }
      ]
    },
    "8": {
      "traducao_completa": "Prende as águas em suas espessas nuvens, e a nuvem não se fende debaixo delas.",
      "palavras": [
        { "hebraico": "צֹרֵ֥ר", "transliteral": "ṣō-rêr", "traducao_palavra": "Prende/Ata" },
        { "hebraico": "מַיִם֮", "transliteral": "ma-yim", "traducao_palavra": "águas" },
        { "hebraico": "בְּעָבָ֪יו", "transliteral": "bə-ʿā-ḇāyw", "traducao_palavra": "em Suas nuvens espessas" },
        { "hebraico": "וְלֹא־", "transliteral": "wə-lō-", "traducao_palavra": "e não" },
        { "hebraico": "נִבְקַ֖ע", "transliteral": "niḇ-qaʿ", "traducao_palavra": "se fende" },
        { "hebraico": "עָנָ֣ן", "transliteral": "ʿā-nān", "traducao_palavra": "a nuvem" },
        { "hebraico": "תַּחְתָּֽם׃", "transliteral": "taḥ-tām", "traducao_palavra": "debaixo delas" }
      ]
    },
    "9": {
      "traducao_completa": "Encobre a face do seu trono, e sobre ele estende a sua nuvem.",
      "palavras": [
        { "hebraico": "מְאַחֵ֥ז", "transliteral": "mə-ʾa-ḥêz", "traducao_palavra": "Encobre" },
        { "hebraico": "פְּנֵי־", "transliteral": "pə-nê-", "traducao_palavra": "a face de" },
        { "hebraico": "כִסֵּ֑ה", "transliteral": "ḵis-śê", "traducao_palavra": "trono" },
        { "hebraico": "פַּרְשֵׁ֥ז", "transliteral": "par-šêz", "traducao_palavra": "estendendo" },
        { "hebraico": "עָ֝לָ֗יו", "transliteral": "ʿā-lāyw", "traducao_palavra": "sobre ele" },
        { "hebraico": "עֲנָנֹֽו׃", "transliteral": "ʿă-nā-nô", "traducao_palavra": "Sua nuvem" }
      ]
    },
    "10": {
      "traducao_completa": "Marcou um limite circular sobre a face das águas, até aos confins da luz e das trevas.",
      "palavras": [
        { "hebraico": "חֹק־", "transliteral": "ḥōq-", "traducao_palavra": "Um limite" },
        { "hebraico": "חָ֭ג", "transliteral": "ḥāḡ", "traducao_palavra": "traçou/circundou" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre" },
