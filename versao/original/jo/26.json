{
  "livro": "Jó - אִיּוֹב - ʾIy-yōḇ",
  "capítulo": 26,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Respondeu, porém, Jó, dizendo:",
      "palavras": [
        { "hebraico": "וַיַּ֥עַן", "transliteral": "way-ya-ʿan", "traducao_palavra": "E respondeu" },
        { "hebraico": "אִיֹּ֥וב", "transliteral": "ʾiy-yō-wḇ", "traducao_palavra": "Jó" },
        { "hebraico": "וַיֹּאמַֽר׃", "transliteral": "way-yō-mar", "traducao_palavra": "e disse" }
      ]
    },
    "2": {
      "traducao_completa": "Como ajudaste a quem não tinha força, e sustentaste o braço que não tinha vigor!",
      "palavras": [
        { "hebraico": "מֶה־", "transliteral": "meh-", "traducao_palavra": "Como" },
        { "hebraico": "עָזַ֥רְתָּ", "transliteral": "ʿā-zar-tā", "traducao_palavra": "ajudaste" },
        { "hebraico": "לְלֹא־", "transliteral": "lə-lō-", "traducao_palavra": "a quem não tem" },
        { "hebraico": "כֹ֑חַ", "transliteral": "ḵō-aḥ", "traducao_palavra": "força" },
        { "hebraico": "הֹושַׁ֥עְתָּ", "transliteral": "hō-w-šaʿ-tā", "traducao_palavra": "salvaste/sustentaste" },
        { "hebraico": "זְ֝רֹועַ", "transliteral": "zə-rô-aʿ", "traducao_palavra": "[o] braço" },
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "[que] não" },
        { "hebraico": "עֹֽז׃", "transliteral": "ʿōz", "traducao_palavra": "[tem] vigor/poder" }
      ]
    },
    "3": {
      "traducao_completa": "Como aconselhaste a quem não tem sabedoria, e plenamente mostraste o verdadeiro conhecimento!",
      "palavras": [
        { "hebraico": "מַה־", "transliteral": "mah-", "traducao_palavra": "Como" },
        { "hebraico": "יָּעַ֥צְתָּ", "transliteral": "yā-ʿaṣ-tā", "traducao_palavra": "aconselhaste" },
        { "hebraico": "לְלֹא־", "transliteral": "lə-lō-", "traducao_palavra": "a quem não tem" },
        { "hebraico": "חָכְמָ֑ה", "transliteral": "ḥāḵ-mā", "traducao_palavra": "sabedoria" },
        { "hebraico": "וְ֝תוּשִׁיָּ֗ה", "transliteral": "wə-ṯû-šî-yā", "traducao_palavra": "e conhecimento verdadeiro" },
        { "hebraico": "לָרֹ֥ב", "transliteral": "lā-rōḇ", "traducao_palavra": "em abundância" },
        { "hebraico": "הֹודָֽעְתָּ׃", "transliteral": "hō-w-ḏā-ʿə-tā", "traducao_palavra": "fizeste saber" }
      ]
    },
    "4": {
      "traducao_completa": "A quem proferiste palavras? E de quem é o espírito que saiu de ti?",
      "palavras": [
        { "hebraico": "אֶת־", "transliteral": "ʾeṯ-", "traducao_palavra": "[objeto]" },
        { "hebraico": "מִ֭י", "transliteral": "mî", "traducao_palavra": "quem" },
        { "hebraico": "הִגַּ֣דְתָּ", "transliteral": "hig-gaḏ-tā", "traducao_palavra": "proferiste/contaste" },
        { "hebraico": "מִלִּ֑ין", "transliteral": "mil-lîn", "traducao_palavra": "palavras?" },
        { "hebraico": "וְנִשְׁמַת־", "transliteral": "wə-niš-maṯ-", "traducao_palavra": "e o fôlego/espírito de" },
        { "hebraico": "מִ֝י", "transliteral": "mî", "traducao_palavra": "quem" },
        { "hebraico": "יָצְאָ֥ה", "transliteral": "yā-ṣə-ʾā", "traducao_palavra": "saiu" },
        { "hebraico": "מִמֶּֽךָּ׃", "transliteral": "mim-me-kā", "traducao_palavra": "de ti?" }
      ]
    },
    "5": {
      "traducao_completa": "As sombras dos mortos tremem debaixo das águas, com os seus moradores.",
      "palavras": [
        { "hebraico": "הָרְפָאִ֥ים", "transliteral": "hā-rə-p̄ā-ʾîm", "traducao_palavra": "As sombras/mortos" },
        { "hebraico": "יְחֹולָ֑לוּ", "transliteral": "yə-ḥô-w-lā-lû", "traducao_palavra": "tremem" },
        { "hebraico": "מִתַּ֥חַת", "transliteral": "mit-ta-ḥaṯ", "traducao_palavra": "debaixo de" },
        { "hebraico": "מַ֝֗יִם", "transliteral": "ma-yim", "traducao_palavra": "águas" },
        { "hebraico": "וְשֹׁכְנֵיהֶֽם׃", "transliteral": "wə-šō-ḵə-nê-hem", "traducao_palavra": "e os seus moradores" }
      ]
    },
    "6": {
      "traducao_completa": "O inferno está nu perante ele, e não há cobertura para a destruição.",
      "palavras": [
        { "hebraico": "עָרֹ֣ום", "transliteral": "ʿā-rō-wm", "traducao_palavra": "Nu" },
        { "hebraico": "שְׁאֹ֣ול", "transliteral": "šə-ʾô-wl", "traducao_palavra": "[está o] Seol/inferno" },
