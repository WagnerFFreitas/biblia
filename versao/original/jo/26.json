    "11": {
      "traducao_completa": "As colunas do céu tremem, e pasmam da sua repreensão.",
      "palavras": [
        { "hebraico": "עַמּוּדֵ֣i", "transliteral": "ʿam-mû-ḏê", "traducao_palavra": "As colunas de" },
        { "hebraico": "שָׁמַ֣יִם", "transliteral": "šā-ma-yim", "traducao_palavra": "céus" },
        { "hebraico": "יְרֹופָ֑פוּ", "transliteral": "yə-rô-w-p̄ā-p̄û", "traducao_palavra": "estremecem/vacilam" },
        { "hebraico": "וְ֝יִתְמְה֗וּ", "transliteral": "wə-yiṯ-mə-hû", "traducao_palavra": "e pasmam" },
        { "hebraico": "מִגַּעֲרָתֹֽו׃", "transliteral": "mi-ga-ʿă-rā-ṯô", "traducao_palavra": "da Sua repreensão" }
      ]
    },
    "12": {
      "traducao_completa": "Com a sua força fende o mar, e com o seu entendimento abate a soberba.",
      "palavras": [
        { "hebraico": "בְּ֭כֹחֹו", "transliteral": "bə-ḵō-ḥô", "traducao_palavra": "Com Sua força" },
