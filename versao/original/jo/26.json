        { "hebraico": "מָ֑יִם", "transliteral": "ma-yim", "traducao_palavra": "águas" },
        { "hebraico": "עַד־", "transliteral": "ʿaḏ-", "traducao_palavra": "até" },
        { "hebraico": "תַּכְלִ֥ית", "transliteral": "taḵ-lîṯ", "traducao_palavra": "o limite/confim de" },
        { "hebraico": "אֹ֝ור", "transliteral": "ʾôr", "traducao_palavra": "luz" },
        { "hebraico": "עִם־", "transliteral": "ʿim-", "traducao_palavra": "com" },
        { "hebraico": "חֹֽשֶׁךְ׃", "transliteral": "ḥō-šeḵ", "traducao_palavra": "trevas" }
      ]
