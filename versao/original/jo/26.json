        { "hebraico": "וּמַה־", "transliteral": "ū-mah-", "traducao_palavra": "e quão" },
        { "hebraico": "שֵּׁ֣מֶץ", "transliteral": "šê-meṣ", "traducao_palavra": "pequeno sussurro" },
        { "hebraico": "דָּ֭בָר", "transliteral": "dā-ḇār", "traducao_palavra": "de palavra" },
        { "hebraico": "נִשְׁמַע־", "transliteral": "niš-maʿ-", "traducao_palavra": "ouvimos" },
        { "hebraico": "בֹּ֑ו", "transliteral": "bô", "traducao_palavra": "d'Ele" },
        { "hebraico": "וְרַ֥עַם", "transliteral": "wə-ra-ʿam", "traducao_palavra": "e o trovão de" },
