      ]
    },
    "13": {
      "traducao_completa": "Pelo seu Espírito ornou os céus; a sua mão formou a serpente enrodilhada.",
      "palavras": [
        { "hebraico": "בְּ֭רוּחֹו", "transliteral": "bə-rû-ḥô", "traducao_palavra": "Pelo Seu sopro/Espírito" },
        { "hebraico": "שָׁמַ֣יִם", "transliteral": "šā-ma-yim", "traducao_palavra": "[os] céus" },
        { "hebraico": "שִׁפְרָ֑ה", "transliteral": "šip̄-rā", "traducao_palavra": "[Ele] ornou/limpou" },
        { "hebraico": "חֹלֲלָ֥ה", "transliteral": "ḥō-lă-lā", "traducao_palavra": "formou/perfurou" },
