    },
    "4": {
      "traducao_completa": "Eis que sou vil; que te responderia eu? Ponho a minha mão sobre a minha boca.",
      "palavras": [
        { "hebraico": "הֵן־", "transliteral": "hen-", "traducao_palavra": "Eis que" },
        { "hebraico": "קַ֭לֹּתִי", "transliteral": "qal-lō-ṯî", "traducao_palavra": "sou insignificante/vil" },
        { "hebraico": "מָ֣ה", "transliteral": "mā", "traducao_palavra": "o que" },
        { "hebraico": "אֲשִׁיבֶ֑ךָּ", "transliteral": "ʾă-šî-ḇek-kā", "traducao_palavra": "te responderia?" },
        { "hebraico": "יָ֝דִ֗י", "transliteral": "yā-ḏî", "traducao_palavra": "minha mão" },
        { "hebraico": "שַׂ֣מְתִּי", "transliteral": "śam-tî", "traducao_palavra": "pus" },
        { "hebraico": "לְמֹו־", "transliteral": "lə-mô-", "traducao_palavra": "sobre" },
        { "hebraico": "פִֽי׃", "transliteral": "p̄î", "traducao_palavra": "minha boca" }
