        { "hebraico": "וְלֹ֣א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "אֶעֱנֶ֑ה", "transliteral": "ʾe-ʿĕ-neh", "traducao_palavra": "responderei" },
        { "hebraico": "וּשְׁתַּ֥יִם", "transliteral": "ū-šə-ta-yim", "traducao_palavra": "e duas vezes" },
