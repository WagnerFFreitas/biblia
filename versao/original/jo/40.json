        { "hebraico": "הִנֵּה־", "transliteral": "hin-nê-", "traducao_palavra": "Eis" },
        { "hebraico": "נָ֣א", "transliteral": "nā", "traducao_palavra": "agora" },
        { "hebraico": "כֹ֭חֹו", "transliteral": "ḵō-ḥô", "traducao_palavra": "a força dele" },
        { "hebraico": "בִמְתָנָ֑יו", "transliteral": "ḇim-ṯā-nāyw", "traducao_palavra": "[está] nos seus lombos" },
