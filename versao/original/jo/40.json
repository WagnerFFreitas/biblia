    "15": {
      "traducao_completa": "Contempla agora o beemote, que eu fiz contigo, que come a erva como o boi.",
      "palavras": [
        { "hebraico": "הִנֵּה־", "transliteral": "hin-nê-", "traducao_palavra": "Eis" },
        { "hebraico": "נָ֭א", "transliteral": "nā", "traducao_palavra": "agora" },
