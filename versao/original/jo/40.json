        { "hebraico": "חַרְבֹּֽו׃", "transliteral": "ḥar-bô", "traducao_palavra": "Sua espada" }
      ]
    },
    "20": {
      "traducao_completa": "Em verdade os montes lhe produzem pasto, onde todos os animais do campo folgam.",
      "palavras": [
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "Pois" },
        { "hebraico": "ב֭וּל", "transliteral": "ḇûl", "traducao_palavra": "o alimento/pasto" },
        { "hebraico": "הָרִ֣ים", "transliteral": "hā-rîm", "traducao_palavra": "[dos] montes" },
        { "hebraico": "יִשְׂאוּ־", "transliteral": "yiś-ʾû-", "traducao_palavra": "produzem" },
        { "hebraico": "לֹ֑ו", "transliteral": "lô", "traducao_palavra": "para ele" },
        { "hebraico": "וְֽכָל־", "transliteral": "wə-ḵāl-", "traducao_palavra": "e todos" },
        { "hebraico": "חַיַּ֥ת", "transliteral": "ḥay-yaṯ", "traducao_palavra": "[os] animais de" },
        { "hebraico": "הַ֝שָּׂדֶה", "transliteral": "haś-śā-ḏeh", "traducao_palavra": "o campo" },
        { "hebraico": "יְשַׂחֲקוּ־", "transliteral": "yə-śa-ḥă-qû-", "traducao_palavra": "brincam/folgam" },
        { "hebraico": "שָֽׁם׃", "transliteral": "šām", "traducao_palavra": "ali" }
      ]
