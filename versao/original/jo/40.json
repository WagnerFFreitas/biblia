    "21": {
      "traducao_completa": "Deita-se debaixo das árvores sombrias, no esconderijo dos canaviais e da lama.",
      "palavras": [
        { "hebraico": "תַּחַת־", "transliteral": "ta-ḥaṯ-", "traducao_palavra": "Debaixo de" },
        { "hebraico": "צֶאֱלִ֥ים", "transliteral": "ṣe-ʾĕ-lîm", "traducao_palavra": "lotus/árvores sombrias" },
        { "hebraico": "יִשְׁכָּ֑ב", "transliteral": "yiš-kāḇ", "traducao_palavra": "ele se deita" },
        { "hebraico": "בְּסֵ֖תֶר", "transliteral": "bə-śê-ṯer", "traducao_palavra": "no esconderijo de" },
        { "hebraico": "קָנֶ֣ה", "transliteral": "qā-neh", "traducao_palavra": "canas" },
        { "hebraico": "וּבִצָּֽה׃", "transliteral": "ū-ḇiṣ-ṣā", "traducao_palavra": "e pântano/lama" }
      ]
    },
    "22": {
      "traducao_completa": "As árvores sombrias o cobrem com a sua sombra; os salgueiros do ribeiro o cercam.",
      "palavras": [
        { "hebraico": "יְסֻכֻּ֣הוּ", "transliteral": "yə-suk-ku-hū", "traducao_palavra": "Cobrem-no" },
        { "hebraico": "צֶאֱלִ֣ים", "transliteral": "ṣe-ʾĕ-lîm", "traducao_palavra": "lotus/árvores" },
        { "hebraico": "צִלְלֹ֑ו", "transliteral": "ṣil-lô", "traducao_palavra": "[com] sua sombra" },
        { "hebraico": "יְ֝סֻבּ֗וּהוּ", "transliteral": "yə-śub-bū-hū", "traducao_palavra": "cercam-no" },
        { "hebraico": "עַרְבֵi־", "transliteral": "ʿar-ḇê-", "traducao_palavra": "os salgueiros de" },
        { "hebraico": "נָֽחַל׃", "transliteral": "nā-ḥal", "traducao_palavra": "ribeiro" }
      ]
    },
    "23": {
      "traducao_completa": "Eis que um rio transborda, e ele não se apressa; confia, ainda que o Jordão se levante até à sua boca.",
      "palavras": [
        { "hebraico": "הֵ֤ן", "transliteral": "hên", "traducao_palavra": "Eis" },
        { "hebraico": "יַעֲשֹׁ֣ק", "transliteral": "ya-ʿă-šōq", "traducao_palavra": "oprime/transborda" },
        { "hebraico": "נָ֭הָר", "transliteral": "nā-hār", "traducao_palavra": "[o] rio" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "יַחְפֹּ֑וז", "transliteral": "yaḥ-pō-wz", "traducao_palavra": "ele se apressa/se alarma" },
        { "hebraico": "יִבְטַ֕ח", "transliteral": "yiḇ-ṭaḥ", "traducao_palavra": "ele confia" },
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "mesmo que" },
        { "hebraico": "יָגִ֥יחַ", "transliteral": "yā-ḡî-aḥ", "traducao_palavra": "irrompa/suba" },
        { "hebraico": "יַרְדֵּ֖ן", "transliteral": "yar-dên", "traducao_palavra": "[o] Jordão" },
        { "hebraico": "אֶל־", "transliteral": "ʾel-", "traducao_palavra": "até" },
        { "hebraico": "פִּֽיהוּ׃", "transliteral": "pî-hū", "traducao_palavra": "sua boca" }
      ]
    },
    "24": {
      "traducao_completa": "Acaso alguém o apanhara à vista de seus olhos? Ou com laços lhe furará o nariz?",
      "palavras": [
        { "hebraico": "בְּעֵינָ֥יו", "transliteral": "bə-ʿê-nāyw", "traducao_palavra": "Diante dos seus olhos" },
        { "hebraico": "יִקָּחֶ֑נּוּ", "transliteral": "yiq-qā-ḥen-nū", "traducao_palavra": "alguém o apanharia?" },
        { "hebraico": "בְּ֝מֹוקְשִׁ֗ים", "transliteral": "bə-mô-w-qə-šîm", "traducao_palavra": "com laços/anzóis" },
