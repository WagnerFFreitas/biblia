        { "hebraico": "אֵ֑ל", "transliteral": "ʾêl", "traducao_palavra": "Deus" },
        { "hebraico": "הַ֝עֹשֹׂ֗ו", "transliteral": "ha-ʿō-śô", "traducao_palavra": "[Aquele que] o fez" },
