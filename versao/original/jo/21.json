        { "hebraico": "וְנִבְהָ֑לְתִּי", "transliteral": "wə-niḇ-hāl-tî", "traducao_palavra": "então me perturbo" },
        { "hebraico": "וְאָחַ֖ז", "transliteral": "wə-ʾā-ḥaz", "traducao_palavra": "e apodera-se de" },
