        { "hebraico": "רְשָׁעִ֣ים", "transliteral": "rə-šā-ʿîm", "traducao_palavra": "ímpios" },
        { "hebraico": "יִדְעָךְ֮", "transliteral": "yiḏ-ʿāḵ", "traducao_palavra": "se apaga?" },
        { "hebraico": "וְיָבֹ֤א", "transliteral": "wə-yā-ḇō", "traducao_palavra": "e vem" },
        { "hebraico": "עֲלֵיהֶ֪ם", "transliteral": "ʿă-lê-hem", "traducao_palavra": "sobre eles" },
