    "14": {
      "traducao_completa": "E, contudo, dizem a Deus: Retira-te de nós; porque não desejamos ter conhecimento dos teus caminhos.",
      "palavras": [
        { "hebraico": "וַיֹּאמְר֣וּ", "transliteral": "way-yō-mərū", "traducao_palavra": "E dizem" },
        { "hebraico": "לָ֭אֵל", "transliteral": "lā-ʾêl", "traducao_palavra": "a Deus" },
        { "hebraico": "ס֣וּר", "transliteral": "śûr", "traducao_palavra": "Retira-te" },
        { "hebraico": "מִמֶּ֑נּוּ", "transliteral": "mim-men-nû", "traducao_palavra": "de nós" },
