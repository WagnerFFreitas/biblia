{
  "livro": "Jó - אִיּוֹב - ʾIy-yōḇ",
  "capítulo": 21,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Respondeu, porém, Jó, dizendo:",
      "palavras": [
        { "hebraico": "וַיַּ֥עַן", "transliteral": "way-ya-ʿan", "traducao_palavra": "E respondeu" },
        { "hebraico": "אִיֹּ֥וב", "transliteral": "ʾiy-yō-wḇ", "traducao_palavra": "Jó" },
        { "hebraico": "וַיֹּאמַֽר׃", "transliteral": "way-yō-mar", "traducao_palavra": "e disse" }
      ]
    },
    "2": {
      "traducao_completa": "Ouvi atentamente as minhas palavras; e seja isto a vossa consolação.",
      "palavras": [
        { "hebraico": "שִׁמְע֤וּ", "transliteral": "šim-ʿû", "traducao_palavra": "Ouvi" },
        { "hebraico": "שָׁמֹ֨ועַ֙", "transliteral": "šā-mô-aʿ", "traducao_palavra": "atentamente" },
        { "hebraico": "מִלָּתִ֔י", "transliteral": "mil-lā-ṯî", "traducao_palavra": "minha palavra" },
        { "hebraico": "וּתְהִי־", "transliteral": "ū-ṯə-hî-", "traducao_palavra": "e seja" },
        { "hebraico": "זֹ֖את", "transliteral": "zōṯ", "traducao_palavra": "isto" },
        { "hebraico": "תַּנְחוּמֹתֵיכֶֽם׃", "transliteral": "tan-ḥû-mō-ṯê-ḵem", "traducao_palavra": "vossa consolação" }
      ]
    },
    "3": {
      "traducao_completa": "Sofrei-me, e eu falarei; e, havendo eu falado, zombai.",
      "palavras": [
        { "hebraico": "שָׂ֭אוּנִי", "transliteral": "śā-ʾû-nî", "traducao_palavra": "Suportai-me" },
        { "hebraico": "וְאָנֹכִ֥י", "transliteral": "wə-ʾā-nō-ḵî", "traducao_palavra": "e eu" },
        { "hebraico": "אֲדַבֵּ֑ר", "transliteral": "ʾă-ḏab-bêr", "traducao_palavra": "falarei" },
        { "hebraico": "וְאַחַ֖ר", "transliteral": "wə-ʾa-ḥar", "traducao_palavra": "e depois de" },
        { "hebraico": "דַּבְּרִ֣י", "transliteral": "dab-bə-rî", "traducao_palavra": "eu falar" },
        { "hebraico": "תַלְעִֽיג׃", "transliteral": "tal-ʿîḡ", "traducao_palavra": "zombai" }
      ]
    },
    "4": {
      "traducao_completa": "Porventura é para algum homem a minha queixa? Mas, ainda que assim fosse, por que não se angustiaria o meu espírito?",
      "palavras": [
        { "hebraico": "הֶ֭לְאָנֹושׁ", "transliteral": "ha-lə-ʾā-nô-wš", "traducao_palavra": "Acaso para o homem [é]" },
        { "hebraico": "שִׂיחִ֑י", "transliteral": "śî-ḥî", "traducao_palavra": "minha queixa?" },
        { "hebraico": "וְאִם־", "transliteral": "wə-ʾim-", "traducao_palavra": "e se" },
        { "hebraico": "מַ֝דּוּעַ", "transliteral": "mad-dū-aʿ", "traducao_palavra": "por que" },
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "תִקְצַ֥ר", "transliteral": "ṯiq-ṣar", "traducao_palavra": "se angustiaria/encurtaria" },
        { "hebraico": "רוּחִֽי׃", "transliteral": "rû-ḥî", "traducao_palavra": "meu espírito?" }
      ]
