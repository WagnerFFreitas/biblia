    "16": {
      "traducao_completa": "Vede, porém, que a sua prosperidade não está na mão deles; longe de mim esteja o conselho dos ímpios.",
      "palavras": [
        { "hebraico": "הֵ֤ן", "transliteral": "hên", "traducao_palavra": "Eis" },
