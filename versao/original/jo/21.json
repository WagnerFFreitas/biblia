        { "hebraico": "יַגְעִ֑יל", "transliteral": "yaḡ-ʿîl", "traducao_palavra": "falha/rejeita" },
        { "hebraico": "תְּפַלֵּ֥ט", "transliteral": "tə-p̄al-lêṭ", "traducao_palavra": "faz parir" },
