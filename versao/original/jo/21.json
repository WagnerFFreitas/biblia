        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "para que" },
        { "hebraico": "נַעַבְדֶ֑נּוּ", "transliteral": "na-ʿă-ḇə-ḏen-nû", "traducao_palavra": "o sirvamos?" },
