        { "hebraico": "וְלֹ֤א", "transliteral": "wə-lō", "traducao_palavra": "e não [está]" },
        { "hebraico": "שֵׁ֖בֶט", "transliteral": "šê-ḇeṭ", "traducao_palavra": "[a] vara de" },
