        { "hebraico": "וְהָשַׁ֖מּוּ", "transliteral": "wə-hā-šam-mû", "traducao_palavra": "e pasmai" },
        { "hebraico": "וְשִׂ֨ימוּ", "transliteral": "wə-śî-mû", "traducao_palavra": "e ponde" },
        { "hebraico": "יָ֝ד", "transliteral": "yāḏ", "traducao_palavra": "[a] mão" },
