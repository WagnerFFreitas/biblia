      ]
    },
    "7": {
      "traducao_completa": "Por que vivem os ímpios, envelhecem, e ainda se esforçam em poder?",
      "palavras": [
        { "hebraico": "מַדּ֤וּעַ", "transliteral": "mad-dū-aʿ", "traducao_palavra": "Por que" },
        { "hebraico": "רְשָׁעִים֙", "transliteral": "rə-šā-ʿîm", "traducao_palavra": "[os] ímpios" },
        { "hebraico": "יִחְי֔וּ", "transliteral": "yiḥ-yû", "traducao_palavra": "vivem?" },
        { "hebraico": "עָ֝תְק֗וּ", "transliteral": "ʿā-ṯə-qû", "traducao_palavra": "envelhecem" },
        { "hebraico": "גַּם־", "transliteral": "gam-", "traducao_palavra": "também" },
