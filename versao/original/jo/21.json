        { "hebraico": "עֲוִילֵיהֶ֑ם", "transliteral": "ʿă-wî-lê-hem", "traducao_palavra": "seus pequeninos" },
        { "hebraico": "וְ֝יַלְדֵיהֶ֗ם", "transliteral": "wə-yal-ḏê-hem", "traducao_palavra": "e os filhos deles" },
