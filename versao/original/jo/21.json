        { "hebraico": "לִפְנֵיהֶ֣ם", "transliteral": "lip̄-nê-hem", "traducao_palavra": "diante deles" },
        { "hebraico": "עִמָּ֑ם", "transliteral": "ʿim-mām", "traducao_palavra": "com eles" },
        { "hebraico": "וְ֝צֶאֱצָאֵיהֶ֗ם", "transliteral": "wə-ṣe-ʾĕ-ṣā-ʾê-hem", "traducao_palavra": "e seus descendentes" },
