      ]
    },
    "9": {
      "traducao_completa": "As suas casas estão em paz, sem temor; e a vara de Deus não está sobre eles.",
      "palavras": [
        { "hebraico": "בָּתֵּיהֶ֣ם", "transliteral": "bāt-tê-hem", "traducao_palavra": "As casas deles" },
