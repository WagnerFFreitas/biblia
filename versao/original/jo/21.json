      ]
    },
    "18": {
      "traducao_completa": "São como a palha diante do vento, e como a moinha que o furacão arrebata?",
      "palavras": [
        { "hebraico": "יִהְי֥וּ", "transliteral": "yih-yû", "traducao_palavra": "Serão eles" },
