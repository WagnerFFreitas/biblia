{
  "livro": "Jó - אִיּוֹב - ʾIy-yōḇ",
  "capítulo": 28,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Na verdade, há veios de onde se extrai a prata, e lugar onde se refina o ouro.",
      "palavras": [
        { "hebraico": "כִּ֤י", "transliteral": "kî", "traducao_palavra": "Pois" },
        { "hebraico": "יֵ֣שׁ", "transliteral": "yêš", "traducao_palavra": "há" },
        { "hebraico": "לַכֶּ֣סֶף", "transliteral": "lak-ke-sep̄", "traducao_palavra": "para a prata" },
        { "hebraico": "מֹוצָ֑א", "transliteral": "mô-w-ṣā", "traducao_palavra": "uma mina/saída" },
        { "hebraico": "וּמָקֹ֗ום", "transliteral": "ū-mā-qô-wm", "traducao_palavra": "e um lugar" },
        { "hebraico": "לַזָּהָ֥ב", "transliteral": "laz-zā-hāḇ", "traducao_palavra": "para o ouro" },
        { "hebraico": "יָזֹֽקּוּ׃", "transliteral": "yā-zōq-qû", "traducao_palavra": "[onde] o refinam" }
      ]
    },
    "2": {
      "traducao_completa": "O ferro tira-se da terra, e da pedra se funde o cobre.",
      "palavras": [
        { "hebraico": "בַּ֭רְזֶל", "transliteral": "bar-zel", "traducao_palavra": "[O] ferro" },
        { "hebraico": "מֵעָפָ֣ר", "transliteral": "mê-ʿā-p̄ār", "traducao_palavra": "do pó/solo" },
        { "hebraico": "יֻקָּ֑ח", "transliteral": "yuq-qāḥ", "traducao_palavra": "é tomado" },
        { "hebraico": "וְ֝אֶ֗בֶן", "transliteral": "wə-ʾe-ḇen", "traducao_palavra": "e da pedra" },
        { "hebraico": "יָצ֥וּק", "transliteral": "yā-ṣûq", "traducao_palavra": "é fundido" },
        { "hebraico": "נְחוּשָֽׁה׃", "transliteral": "nə-ḥû-šā", "traducao_palavra": "[o] cobre" }
      ]
    },
    "3": {
      "traducao_completa": "Ele põe fim às trevas, e até à extremidade mais remota ele esquadrinha a pedra da escuridão e da sombra da morte.",
      "palavras": [
        { "hebraico": "קֵ֤ץ", "transliteral": "qêṣ", "traducao_palavra": "[Um] fim" },
        { "hebraico": "שָׂ֤ם", "transliteral": "śām", "traducao_palavra": "ele põe" },
        { "hebraico": "לַחֹ֨שֶׁךְ֮", "transliteral": "la-ḥō-šeḵ", "traducao_palavra": "às trevas" },
        { "hebraico": "וּלְכָל־", "transliteral": "ū-lə-ḵāl-", "traducao_palavra": "e para toda" },
        { "hebraico": "תִּ֝כְלִ֗ית", "transliteral": "tiḵ-lîṯ", "traducao_palavra": "extremidade/limite" },
        { "hebraico": "ה֣וּא", "transliteral": "hû", "traducao_palavra": "ele" },
        { "hebraico": "חֹוקֵ֑ר", "transliteral": "ḥô-w-qêr", "traducao_palavra": "esquadrinha" },
        { "hebraico": "אֶ֖בֶן", "transliteral": "ʾe-ḇen", "traducao_palavra": "[a] pedra de" },
        { "hebraico": "אֹ֣פֶל", "transliteral": "ʾō-p̄el", "traducao_palavra": "escuridão" },
        { "hebraico": "וְצַלְמָֽוֶת׃", "transliteral": "wə-ṣal-mā-weṯ", "traducao_palavra": "e sombra da morte" }
      ]
    },
    "4": {
      "traducao_completa": "Abre um poço de mina longe dos homens, em lugares esquecidos pelo pé; ficam pendurados longe dos homens, e oscilam de um lado para o outro.",
      "palavras": [
        { "hebraico": "פָּ֤רַץ", "transliteral": "pā-raṣ", "traducao_palavra": "Abre" },
        { "hebraico": "נַ֨חַל֙", "transliteral": "na-ḥal", "traducao_palavra": "um poço/galeria" },
        { "hebraico": "מֵֽעִם־", "transliteral": "mê-ʿim-", "traducao_palavra": "longe de" },
        { "hebraico": "גָּ֔ר", "transliteral": "ḡār", "traducao_palavra": "[quem] habita" },
        { "hebraico": "הַנִּשְׁכָּחִ֖ים", "transliteral": "han-niš-kā-ḥîm", "traducao_palavra": "[lugares] esquecidos" },
        { "hebraico": "מִנִּי־", "transliteral": "min-nî-", "traducao_palavra": "pelo" },
        { "hebraico": "רָ֑גֶל", "transliteral": "rā-ḡel", "traducao_palavra": "pé" },
        { "hebraico": "דַּ֥לּוּ", "transliteral": "dal-lû", "traducao_palavra": "estão pendurados" },
        { "hebraico": "מֵאֱנֹ֗ושׁ", "transliteral": "mê-ʾĕ-nō-wš", "traducao_palavra": "longe do homem" },
        { "hebraico": "נָֽעוּ׃", "transliteral": "nā-ʿû", "traducao_palavra": "oscilam" }
      ]
    },
    "5": {
      "traducao_completa": "A terra, de onde procede o pão, embaixo é revolvida como por fogo.",
      "palavras": [
        { "hebraico": "אֶ֗רֶץ", "transliteral": "ʾe-reṣ", "traducao_palavra": "A terra" },
        { "hebraico": "מִמֶּ֥נָּה", "transliteral": "mim-men-nā", "traducao_palavra": "dela" },
        { "hebraico": "יֵֽצֶא־", "transliteral": "yê-ṣê-", "traducao_palavra": "sai" },
        { "hebraico": "לָ֑חֶם", "transliteral": "lā-ḥem", "traducao_palavra": "[o] pão" },
        { "hebraico": "וְ֝תַחְתֶּ֗יהָ", "transliteral": "wə-ṯaḥ-te-hā", "traducao_palavra": "e debaixo dela" },
        { "hebraico": "נֶהְפַּ֥ךְ", "transliteral": "neh-pak", "traducao_palavra": "é revolvida" },
        { "hebraico": "כְּמֹו־", "transliteral": "kə-mô-", "traducao_palavra": "como" },
        { "hebraico": "אֵֽשׁ׃", "transliteral": "ʾêš", "traducao_palavra": "fogo" }
      ]
    },
    "6": {
      "traducao_completa": "As suas pedras são o lugar da safira, e têm pó de ouro.",
      "palavras": [
        { "hebraico": "מְקֹום־", "transliteral": "mə-qô-wm-", "traducao_palavra": "Lugar de" },
        { "hebraico": "סַפִּ֥יר", "transliteral": "sap-pîr", "traducao_palavra": "safira" },
        { "hebraico": "אֲבָנֶ֑יהָ", "transliteral": "ʾă-ḇā-ne-hā", "traducao_palavra": "[são] as pedras dela" },
        { "hebraico": "וְעַפְרֹ֖ת", "transliteral": "wə-ʿap̄-rō-wṯ", "traducao_palavra": "e partículas de" },
        { "hebraico": "זָהָ֣ב", "transliteral": "zā-hāḇ", "traducao_palavra": "ouro" },
        { "hebraico": "לֹֽו׃", "transliteral": "lô", "traducao_palavra": "tem ela" }
      ]
    },
    "7": {
      "traducao_completa": "Essa vereda a ave de rapina a ignora, e não a viram os olhos da milhafre.",
      "palavras": [
        { "hebraico": "נָ֭תִיב", "transliteral": "nā-ṯîḇ", "traducao_palavra": "[A] vereda" },
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "יְדָ֣עֹו", "transliteral": "yə-ḏā-ʿô", "traducao_palavra": "conheceu ela" },
        { "hebraico": "עָ֑יִט", "transliteral": "ʿā-yiṭ", "traducao_palavra": "[a] ave de rapina" },
        { "hebraico": "וְלֹ֥א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "שְׁ֝זָפַ֗תּוּ", "transliteral": "šə-zā-p̄at-tû", "traducao_palavra": "viu ela" },
        { "hebraico": "עֵ֣ין", "transliteral": "ʿên", "traducao_palavra": "o olho de" },
        { "hebraico": "אַיָּֽה׃", "transliteral": "ʾay-yā", "traducao_palavra": "falcão/milhafre" }
      ]
    },
    "8": {
      "traducao_completa": "Nunca a pisaram filhos de animais altivos, nem o feroz leão passou por ela.",
      "palavras": [
        { "hebraico": "לֹֽא־", "transliteral": "lō-", "traducao_palavra": "Não" },
        { "hebraico": "הִדְרִיכֻ֥הוּ", "transliteral": "hiḏ-rî-ḵu-hū", "traducao_palavra": "pisaram nela" },
        { "hebraico": "בְנֵי־", "transliteral": "ḇə-nê-", "traducao_palavra": "filhos de" },
        { "hebraico": "שָׁ֑חַץ", "transliteral": "šā-ḥaṣ", "traducao_palavra": "orgulho/animais altivos" },
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "עָ֘דָ֤ה", "transliteral": "ʿā-ḏā", "traducao_palavra": "passou" },
        { "hebraico": "עָלָ֣יו", "transliteral": "ʿā-lāyw", "traducao_palavra": "por ela" },
        { "hebraico": "שָֽׁחַל׃", "transliteral": "šā-ḥal", "traducao_palavra": "o leão feroz" }
      ]
    },
    "9": {
      "traducao_completa": "Ele estende a sua mão contra o pederneira, e transtorna os montes desde as suas raízes.",
      "palavras": [
        { "hebraico": "בַּֽחַלָּמִ֥ישׁ", "transliteral": "ba-ḥal-lā-mîš", "traducao_palavra": "No pederneira/rocha dura" },
        { "hebraico": "שָׁלַ֣ח", "transliteral": "šā-laḥ", "traducao_palavra": "estendeu" },
        { "hebraico": "יָדֹ֑ו", "transliteral": "yā-ḏô", "traducao_palavra": "sua mão" },
        { "hebraico": "הָפַ֖ךְ", "transliteral": "hā-p̄aḵ", "traducao_palavra": "transtornou/revolveu" },
        { "hebraico": "מִשֹּׁ֣רֶשׁ", "transliteral": "miš-šō-reš", "traducao_palavra": "pela raiz" },
        { "hebraico": "הָרִֽים׃", "transliteral": "hā-rîm", "traducao_palavra": "[os] montes" }
      ]
    },
    "10": {
      "traducao_completa": "Fende canais nas rochas, e o seu olho vê tudo o que é precioso.",
      "palavras": [
        { "hebraico": "בַּ֭צּוּרֹות", "transliteral": "baṣ-ṣû-rō-wṯ", "traducao_palavra": "Nas rochas" },
        { "hebraico": "יְאֹרִ֣ים", "transliteral": "yə-ʾō-rîm", "traducao_palavra": "canais" },
        { "hebraico": "בִּקֵּ֑עַ", "transliteral": "biq-qê-aʿ", "traducao_palavra": "ele fendeu" },
        { "hebraico": "וְכָל־", "transliteral": "wə-ḵāl-", "traducao_palavra": "e toda" },
        { "hebraico": "יְ֝קָ֗ר", "transliteral": "yə-qār", "traducao_palavra": "coisa preciosa" },
        { "hebraico": "רָאָ֥תָה", "transliteral": "rā-ʾā-ṯā", "traducao_palavra": "viu" },
        { "hebraico": "עֵינֹֽו׃", "transliteral": "ʿê-nô", "traducao_palavra": "o seu olho" }
      ]
    },
    "11": {
      "traducao_completa": "Os rios ele tapa, para que não gotejem; e o que estava escondido traz à luz.",
      "palavras": [
        { "hebraico": "מִבְּכִ֓י ׀", "transliteral": "mib-bə-ḵî", "traducao_palavra": "Do gotejar" },
        { "hebraico": "נְהָרֹ֧ות", "transliteral": "nə-hā-rō-wṯ", "traducao_palavra": "[os] rios" },
        { "hebraico": "חִבֵּ֑שׁ", "transliteral": "ḥib-bêš", "traducao_palavra": "ele retém/tapa" },
        { "hebraico": "וְ֝תַעֲלֻמָ֗הּ", "transliteral": "wə-ṯa-ʿă-lu-māh", "traducao_palavra": "e o que estava oculto" },
        { "hebraico": "יֹֹ֣צִא", "transliteral": "yō-ṣi", "traducao_palavra": "ele traz" },
        { "hebraico": "אֹֽור׃", "transliteral": "ʾô-wr", "traducao_palavra": "[à] luz" }
      ]
    },
    "12": {
      "traducao_completa": "Mas onde se achará a sabedoria? E onde está o lugar do entendimento?",
      "palavras": [
        { "hebraico": "וְ֝הַחָכְמָ֗ה", "transliteral": "wə-ha-ḥāḵ-mā", "traducao_palavra": "Mas a sabedoria" },
        { "hebraico": "מֵאַ֣יִן", "transliteral": "mê-ʾa-yin", "traducao_palavra": "de onde" },
        { "hebraico": "תִּמָּצֵ֑א", "transliteral": "tim-mā-ṣê", "traducao_palavra": "será achada?" },
        { "hebraico": "וְאֵ֥י", "transliteral": "wə-ʾê", "traducao_palavra": "e onde" },
        { "hebraico": "זֶ֝֗ה", "transliteral": "zeh", "traducao_palavra": "[está] este" },
        { "hebraico": "מְקֹ֣ום", "transliteral": "mə-qô-wm", "traducao_palavra": "lugar de" },
        { "hebraico": "בִּינָֽה׃", "transliteral": "bî-nā", "traducao_palavra": "entendimento" }
      ]
    },
    "13": {
      "traducao_completa": "O homem não conhece o seu valor, nem se acha ela na terra dos viventes.",
      "palavras": [
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "Não" },
        { "hebraico": "יָדַ֣ע", "transliteral": "yā-ḏaʿ", "traducao_palavra": "conheceu" },
        { "hebraico": "אֱנֹ֣ושׁ", "transliteral": "ʾĕ-nō-wš", "traducao_palavra": "[o] homem" },
        { "hebraico": "עֶרְכָּ֑הּ", "transliteral": "ʿer-kāh", "traducao_palavra": "o valor dela" },
        { "hebraico": "וְלֹ֥א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "תִ֝מָּצֵ֗א", "transliteral": "tim-mā-ṣê", "traducao_palavra": "é achada" },
        { "hebraico": "בְּאֶ֣רֶץ", "transliteral": "bə-ʾe-reṣ", "traducao_palavra": "na terra de" },
        { "hebraico": "הַֽחַיִּֽים׃", "transliteral": "ha-ḥay-yîm", "traducao_palavra": "os viventes" }
      ]
    },
    "14": {
      "traducao_completa": "O abismo diz: Não está em mim; e o mar diz: Ela não está comigo.",
      "palavras": [
        { "hebraico": "תְּהֹ֣ום", "transliteral": "tə-hôm", "traducao_palavra": "[O] abismo" },
        { "hebraico": "אָ֭מַר", "transliteral": "ʾā-mar", "traducao_palavra": "disse" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "Não" },
        { "hebraico": "בִ֣י", "transliteral": "ḇî", "traducao_palavra": "[está] em mim" },
        { "hebraico": "הִ֑יא", "transliteral": "hî", "traducao_palavra": "ela" },
        { "hebraico": "וְיָ֥ם", "transliteral": "wə-yām", "traducao_palavra": "e [o] mar" },
        { "hebraico": "אָ֝מַ֗ר", "transliteral": "ʾā-mar", "traducao_palavra": "disse" },
        { "hebraico": "אֵ֣ין", "transliteral": "ʾên", "traducao_palavra": "não [está]" },
        { "hebraico": "עִמָּדִֽי׃", "transliteral": "ʿim-mā-ḏî", "traducao_palavra": "comigo" }
      ]
    },
    "15": {
      "traducao_completa": "Não se dará por ela ouro fino, nem se pesará prata em seu valor.",
      "palavras": [
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "Não" },
        { "hebraico": "יֻתַּ֣ן", "transliteral": "yut-tan", "traducao_palavra": "se dará" },
        { "hebraico": "סְגֹ֣ור", "transliteral": "śə-ḡôr", "traducao_palavra": "ouro fino" },
        { "hebraico": "תַּחְתֶּ֑יהָ", "transliteral": "taḥ-tey-hā", "traducao_palavra": "em seu lugar" },
        { "hebraico": "וְלֹא־", "transliteral": "wə-lō-", "traducao_palavra": "e não" },
        { "hebraico": "יִשָּׁקֵ֥ל", "transliteral": "yiš-šā-qêl", "traducao_palavra": "se pesará" },
        { "hebraico": "כֶּ֝סֶף", "transliteral": "ke-sep̄", "traducao_palavra": "prata" },
        { "hebraico": "מְחִירָֽהּ׃", "transliteral": "mə-ḥî-rāh", "traducao_palavra": "o seu preço" }
      ]
    },
    "16": {
      "traducao_completa": "Não se pode avaliar pelo ouro de Ofir, nem pelo precioso ônix, nem pela safira.",
      "palavras": [
        { "hebraico": "לֹֽא־", "transliteral": "lō-", "traducao_palavra": "Não" },
        { "hebraico": "תְ֭סֻלֶּה", "transliteral": "ṯə-śul-leh", "traducao_palavra": "pode ser avaliada" },
        { "hebraico": "בְּכֶ֣תֶם", "transliteral": "bə-ḵe-ṯem", "traducao_palavra": "com o ouro de" },
        { "hebraico": "אֹופִ֑ir", "transliteral": "ʾô-p̄îr", "traducao_palavra": "Ofir" },
        { "hebraico": "בְּשֹׁ֥הַם", "transliteral": "bə-šō-ham", "traducao_palavra": "com ônix" },
        { "hebraico": "יָ֝קָ֗ר", "transliteral": "yā-qār", "traducao_palavra": "precioso" },
        { "hebraico": "וְסַפִּֽיר׃", "transliteral": "wə-sap-pîr", "traducao_palavra": "e safira" }
      ]
    },
    "17": {
      "traducao_completa": "O ouro não se igualará a ela, nem o cristal; nem se trocará por joia de ouro puro.",
      "palavras": [
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "Não" },
        { "hebraico": "יַעַרְכֶ֣נָּה", "transliteral": "ya-ʿar-ḵen-nā", "traducao_palavra": "se igualará a ela" },
        { "hebraico": "זָהָ֣ḇ", "transliteral": "zā-hāḇ", "traducao_palavra": "o ouro" },
        { "hebraico": "וּזְכֹוכִ֑ית", "transliteral": "ū-zə-ḵô-ḵîṯ", "traducao_palavra": "e o cristal" },
        { "hebraico": "וּתְמ֝וּרָתָ֗הּ", "transliteral": "ū-ṯə-mû-rā-ṯāh", "traducao_palavra": "e a sua troca" },
        { "hebraico": "כְּלִי־", "transliteral": "kə-lî-", "traducao_palavra": "por objeto de" },
        { "hebraico": "פָֽז׃", "transliteral": "p̄āz", "traducao_palavra": "ouro puro" }
      ]
    },
    "18": {
      "traducao_completa": "Coral e cristal não se mencionarão; e a aquisição da sabedoria é melhor que a das pérolas.",
