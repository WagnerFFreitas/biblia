        { "hebraico": "תֳַּעֲרֹ֑וץ", "transliteral": "ta-ʿă-rô-wṣ", "traducao_palavra": "quebrantarias/aterrorizarias?" },
        { "hebraico": "וְאֶת־", "transliteral": "wə-ʾeṯ-", "traducao_palavra": "e [objeto]" },
        { "hebraico": "קַ֖שׁ", "transliteral": "qaš", "traducao_palavra": "palha" },
        { "hebraico": "יָבֵ֣שׁ", "transliteral": "yā-ḇêš", "traducao_palavra": "seca" },
        { "hebraico": "תִּרְדֹּֽף׃", "transliteral": "tir-dōp̄", "traducao_palavra": "perseguirias?" }
      ]
    },
    "26": {
      "traducao_completa": "Porque escreves contra mim amarguras, e me fazes herdar as culpas da minha mocidade.",
      "palavras": [
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "Porque" },
        { "hebraico": "תִכְתֹּ֣ב", "transliteral": "tiḵ-tōḇ", "traducao_palavra": "escreves" },
        { "hebraico": "עָלַ֣י", "transliteral": "ʿā-lay", "traducao_palavra": "contra mim" },
        { "hebraico": "מְרֹרֹ֑ות", "transliteral": "mə-rō-rō-wṯ", "traducao_palavra": "amarguras" },
        { "hebraico": "וְ֝תֹורִישֵׁ֗נִי", "transliteral": "wə-ṯô-w-rî-šê-nî", "traducao_palavra": "e me fazes herdar" },
        { "hebraico": "עֲוֹנֹ֥ות", "transliteral": "ʿă-wō-nō-wṯ", "traducao_palavra": "iniquidades de" },
        { "hebraico": "נְעוּרָֽי׃", "transliteral": "nə-ʿū-rāy", "traducao_palavra": "minha juventude" }
      ]
    },
    "27": {
      "traducao_completa": "Também pões os meus pés no tronco, e observas todos os meus caminhos, e marcas os limites dos meus pés.",
      "palavras": [
        { "hebraico": "וְתָ֘שֵׂ֤ם", "transliteral": "wə-ṯā-śêm", "traducao_palavra": "E pões" },
        { "hebraico": "בַּסַּ֨ד ׀", "transliteral": "bas-saḏ", "traducao_palavra": "no tronco" },
        { "hebraico": "רַגְלַ֗י", "transliteral": "raḡ-lay", "traducao_palavra": "meus pés" },
        { "hebraico": "וְתִשְׁמֹ֥ור", "transliteral": "wə-ṯiš-môr", "traducao_palavra": "e observas" },
        { "hebraico": "כָּל־", "transliteral": "kāl-", "traducao_palavra": "todas" },
        { "hebraico": "אָרְחֹותָ֑י", "transliteral": "ʾā-rə-ḥô-w-ṯāy", "traducao_palavra": "minhas veredas" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre" },
        { "hebraico": "שָׁרְשֵׁ֥i", "transliteral": "šā-rə-šê", "traducao_palavra": "as solas de" },
        { "hebraico": "רַגְלַ֗י", "transliteral": "raḡ-lay", "traducao_palavra": "meus pés" },
        { "hebraico": "תִּתְחַקֶּֽה׃", "transliteral": "tiṯ-ḥaq-qeh", "traducao_palavra": "marcas/fazes limite" }
      ]
    },
    "28": {
      "traducao_completa": "E o homem se consome como a coisa podre, e como a roupa que a traça come.",
      "palavras": [
        { "hebraico": "וְ֝הוּא", "transliteral": "wə-hû", "traducao_palavra": "E ele [o homem]" },
        { "hebraico": "כְּרָקָ֣ב", "transliteral": "kə-rā-qāḇ", "traducao_palavra": "como podridão" },
        { "hebraico": "יִבְלֶ֑ה", "transliteral": "yib-leh", "traducao_palavra": "se consome/desgasta" },
        { "hebraico": "כְּ֝בֶ֗גֶד", "transliteral": "kə-ḇe-ḡeḏ", "traducao_palavra": "como veste [que]" },
        { "hebraico": "אֲכָ֥לֹו", "transliteral": "ʾă-ḵā-lô", "traducao_palavra": "comeu ele" },
