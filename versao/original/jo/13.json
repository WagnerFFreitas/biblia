        { "hebraico": "אֲנִ֥י", "transliteral": "ʾă-nî", "traducao_palavra": "eu" },
        { "hebraico": "אֶצְדָּֽק׃", "transliteral": "ʾeṣ-dāq", "traducao_palavra": "serei declarado justo" }
      ]
    },
    "19": {
      "traducao_completa": "Quem é o que contenderá comigo? Se eu agora me calasse, morreria.",
      "palavras": [
        { "hebraico": "מִֽי־", "transliteral": "mî-", "traducao_palavra": "Quem" },
        { "hebraico": "ה֭וּא", "transliteral": "hû", "traducao_palavra": "[é] ele" },
        { "hebraico": "יָרִ֣יב", "transliteral": "yā-rîḇ", "traducao_palavra": "[que] contenderá" },
        { "hebraico": "עִמָּדִ֑י", "transliteral": "ʿim-mā-ḏî", "traducao_palavra": "comigo?" },
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "porque" },
        { "hebraico": "עַתָּ֖ה", "transliteral": "ʿat-tā", "traducao_palavra": "agora" },
        { "hebraico": "אַחֲרִ֣ישׁ", "transliteral": "ʾa-ḥă-rîš", "traducao_palavra": "[se] eu me calar" },
        { "hebraico": "וְאֶגְוָֽע׃", "transliteral": "wə-ʾeḡ-wāʿ", "traducao_palavra": "então morrerei/expirarei" }
      ]
    },
    "20": {
      "traducao_completa": "Apenas duas coisas não faças para comigo; então não me esconderei do teu rosto:",
      "palavras": [
        { "hebraico": "אַךְ־", "transliteral": "ʾaḵ-", "traducao_palavra": "Somente" },
        { "hebraico": "שְׁ֭תַּיִם", "transliteral": "šə-ta-yim", "traducao_palavra": "duas [coisas]" },
        { "hebraico": "אַל־", "transliteral": "ʾal-", "traducao_palavra": "não" },
        { "hebraico": "תַּ֣עַשׂ", "transliteral": "ta-ʿaś", "traducao_palavra": "faças" },
        { "hebraico": "עִמָּדִ֑י", "transliteral": "ʿim-mā-ḏî", "traducao_palavra": "comigo" },
        { "hebraico": "אָ֥ז", "transliteral": "ʾāz", "traducao_palavra": "então" },
        { "hebraico": "מִ֝פָּנֶ֗יךָ", "transliteral": "mip-pā-ney-ḵā", "traducao_palavra": "de Tua face" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "אֶסָּתֵֽר׃", "transliteral": "ʾes-śā-ṯêr", "traducao_palavra": "me esconderei" }
      ]
    },
    "21": {
      "traducao_completa": "Desvia a tua mão de cima de mim, e não me amedronte o teu terror.",
      "palavras": [
        { "hebraico": "כַּ֭פְּךָ", "transliteral": "kap-pə-ḵā", "traducao_palavra": "Tua palma/mão" },
        { "hebraico": "מֵעָלַ֣י", "transliteral": "mê-ʿā-lay", "traducao_palavra": "de sobre mim" },
        { "hebraico": "הַרְחַ֑ק", "transliteral": "har-ḥaq", "traducao_palavra": "afasta" },
        { "hebraico": "וְ֝אֵ֥ימָתְךָ", "transliteral": "wə-ʾê-mā-ṯə-ḵā", "traducao_palavra": "e Teu terror/pavor" },
        { "hebraico": "אַל־", "transliteral": "ʾal-", "traducao_palavra": "não" },
        { "hebraico": "תְּבַעֲתַֽנִי׃", "transliteral": "tə-ḇa-ʿă-ṯā-nî", "traducao_palavra": "me amedronte" }
      ]
    },
    "22": {
      "traducao_completa": "Depois chama tu, e eu responderei; ou fale eu, e responde-me tu.",
      "palavras": [
        { "hebraico": "וּקְרָ֥א", "transliteral": "ū-qə-rā", "traducao_palavra": "E chama" },
        { "hebraico": "וְאָנֹכִ֥י", "transliteral": "wə-ʾā-nō-ḵî", "traducao_palavra": "e eu" },
        { "hebraico": "אֶעֱנֶ֑ה", "transliteral": "ʾe-ʿĕ-neh", "traducao_palavra": "responderei" },
        { "hebraico": "אֹֽו־", "transliteral": "ʾô-", "traducao_palavra": "ou" },
        { "hebraico": "אֲדַבֵּ֥ר", "transliteral": "ʾă-ḏab-bêr", "traducao_palavra": "falarei" },
        { "hebraico": "וַהֲשִׁיבֵֽנִי׃", "transliteral": "wa-hă-šî-ḇê-nî", "traducao_palavra": "e responde-me Tu" }
      ]
    },
    "23": {
      "traducao_completa": "Quantas culpas e pecados tenho eu? Faze-me saber a minha transgressão e o meu pecado.",
      "palavras": [
        { "hebraico": "כַּמָּ֣ה", "transliteral": "kam-mā", "traducao_palavra": "Quantas" },
        { "hebraico": "לִ֭י", "transliteral": "lî", "traducao_palavra": "[tenho] eu" },
        { "hebraico": "עֲוֹנֹ֣ות", "transliteral": "ʿă-wō-nō-wṯ", "traducao_palavra": "iniquidades" },
        { "hebraico": "וְחַטָּאֹ֑ות", "transliteral": "wə-ḥaṭ-ṭā-ʾō-wṯ", "traducao_palavra": "e pecados" },
        { "hebraico": "פִּשְׁעִ֥י", "transliteral": "p̄iš-ʿî", "traducao_palavra": "minha transgressão" },
        { "hebraico": "וְ֝חַטָּאתִ֗י", "transliteral": "wə-ḥaṭ-ṭā-ṯî", "traducao_palavra": "e meu pecado" },
        { "hebraico": "הֳֹדִיעֵֽנִי׃", "transliteral": "hō-ḏî-ʿê-nî", "traducao_palavra": "faze-me saber" }
      ]
    },
    "24": {
      "traducao_completa": "Por que escondes o teu rosto, e me tens por teu inimigo?",
      "palavras": [
        { "hebraico": "לָ֤מָּה־", "transliteral": "lām-mā-", "traducao_palavra": "Por que" },
        { "hebraico": "פָנֶ֣יךָ", "transliteral": "p̄ā-ne-ḵā", "traducao_palavra": "Tua face" },
        { "hebraico": "תַסְתִּ֑יר", "transliteral": "ṯas-tîr", "traducao_palavra": "escondes?" },
        { "hebraico": "וְתַחְשְׁבֵ֖נִי", "transliteral": "wə-ṯaḥ-šə-ḇê-nî", "traducao_palavra": "e me consideras" },
        { "hebraico": "לְאֹויֵ֣i", "transliteral": "lə-ʾô-w-yêḇ", "traducao_palavra": "por inimigo" },
        { "hebraico": "לָֽךְ׃", "transliteral": "lāḵ", "traducao_palavra": "Teu" }
      ]
    },
    "25": {
      "traducao_completa": "Acaso quebrantarias uma folha arrebatada pelo vento? E perseguirias a palha seca?",
      "palavras": [
        { "hebraico": "הֶעָלֶ֣ה", "transliteral": "he-ʿā-leh", "traducao_palavra": "Acaso uma folha" },
