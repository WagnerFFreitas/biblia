{
  "livro": "Jó - אִיֹּוב - ʾIyyōḇ",
  "capítulo": 5,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Chama agora; há alguém que te responda? E para qual dos santos te virarás?",
      "palavras": [
        { "hebraico": "קְרָא־", "transliteral": "qə-rā-", "traducao_palavra": "chama" },
        { "hebraico": "נָ֭א", "transliteral": "nā", "traducao_palavra": "agora (peço-te)" },
        { "hebraico": "הֲיֵ֣שׁ", "transliteral": "hă-yēš", "traducao_palavra": "se há" },
        { "hebraico": "עֹונֶ֑ךָ", "transliteral": "ʿō-w-ne-ḵā", "traducao_palavra": "[quem] te responda?" },
        { "hebraico": "וְאֶל־", "transliteral": "wə-ʾel-", "traducao_palavra": "e para" },
        { "hebraico": "מִ֖י", "transliteral": "mî", "traducao_palavra": "quem" },
        { "hebraico": "מִקְּדֹשִׁ֣ים", "transliteral": "miq-qə-ḏō-šîm", "traducao_palavra": "dos santos" },
        { "hebraico": "תִּפְנֶֽה׃", "transliteral": "tip̄-neh", "traducao_palavra": "te virarás?" }
      ]
    },
    "2": {
      "traducao_completa": "Porque a ira mata o louco, e a inveja faz morrer o insensato.",
      "palavras": [
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "porque" },
        { "hebraico": "לֶ֭אֱוִיל", "transliteral": "le-ʾĕ-wîl", "traducao_palavra": "ao louco (tolo)" },
        { "hebraico": "יַהֲרָג־", "transliteral": "ya-hă-rāḡ-", "traducao_palavra": "matará" },
        { "hebraico": "כָּ֑עַשׂ", "transliteral": "kā-ʿaś", "traducao_palavra": "a ira (indignação)" },
        { "hebraico": "וּ֝פֹתֶ֗ה", "transliteral": "ū-p̄ō-ṯeh", "traducao_palavra": "e ao simples (insensato)" },
        { "hebraico": "תָּמִ֥ית", "transliteral": "tā-mîṯ", "traducao_palavra": "fará morrer" },
        { "hebraico": "קִנְאָֽה׃", "transliteral": "qin-ʾā", "traducao_palavra": "a inveja (zelo)" }
      ]
    },
    "3": {
      "traducao_completa": "Eu vi o louco enraizar-se; mas logo amaldiçoei a sua habitação.",
      "palavras": [
        { "hebraico": "אֲנִי־", "transliteral": "ʾă-nî-", "traducao_palavra": "eu" },
        { "hebraico": "רָ֭אִיתִי", "transliteral": "rā-ʾî-ṯî", "traducao_palavra": "vi" },
        { "hebraico": "אֱוִ֣יל", "transliteral": "ʾĕ-wîl", "traducao_palavra": "um louco" },
        { "hebraico": "מַשְׁרִ֑ישׁ", "transliteral": "maš-rîš", "traducao_palavra": "enraizando-se" },
        { "hebraico": "וָאֶקֹּ֥וב", "transliteral": "wā-ʾeq-qō-wḇ", "traducao_palavra": "e amaldiçoei" },
        { "hebraico": "נָוֵ֗הוּ", "transliteral": "nā-wē-hū", "traducao_palavra": "sua habitação" },
        { "hebraico": "פִתְאֹֽם׃", "transliteral": "p̄iṯ-ʾōm", "traducao_palavra": "subitamente" }
      ]
    },
    "6": {
      "traducao_completa": "Porque a aflição não sai do pó, nem a dor brota da terra.",
      "palavras": [
        { "hebraico": "כִּ֤י ׀", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "יֵצֵ֣א", "transliteral": "yē-ṣē", "traducao_palavra": "sai" },
        { "hebraico": "מֵעָפָ֣ר", "transliteral": "mē-ʿā-p̄ār", "traducao_palavra": "do pó" },
        { "hebraico": "אָ֑וֶן", "transliteral": "ʾā-wen", "traducao_palavra": "a aflição (iniquidade)" },
        { "hebraico": "וּ֝מֵאֲדָמָ֗ה", "transliteral": "ū-mê-ʾă-ḏā-mā", "traducao_palavra": "e da terra" },
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "יִצְמַ֥ח", "transliteral": "yiṣ-maḥ", "traducao_palavra": "brota" },
        { "hebraico": "עָמָֽל׃", "transliteral": "ʿā-māl", "traducao_palavra": "a dor (trabalho enfadonho)" }
      ]
    },
    "8": {
      "traducao_completa": "Contudo eu buscaria a Deus, e a Deus entregaria a minha causa;",
      "palavras": [
        { "hebraico": "א֭וּלָם", "transliteral": "ʾū-lām", "traducao_palavra": "contudo" },
        { "hebraico": "אֲנִ֭י", "transliteral": "ʾă-nî", "traducao_palavra": "eu" },
        { "hebraico": "אֶדְרֹ֣שׁ", "transliteral": "ʾeḏ-rōš", "traducao_palavra": "buscaria" },
        { "hebraico": "אֶל־", "transliteral": "ʾel-", "traducao_palavra": "a" },
        { "hebraico": "אֵ֑ל", "transliteral": "ʾēl", "traducao_palavra": "Deus (El)" },
        { "hebraico": "וְאֶל־", "transliteral": "wə-ʾel-", "traducao_palavra": "e a" },
        { "hebraico": "אֱ֝לֹהִ֗ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "Deus (Elohim)" },
        { "hebraico": "אָשִׂ֥ים", "transliteral": "ʾā-śîm", "traducao_palavra": "poria (exporia)" },
        { "hebraico": "דִּבְרָתִֽי׃", "transliteral": "diḇ-rā-ṯî", "traducao_palavra": "minha causa (palavra)" }
      ]
    },
    "9": {
      "traducao_completa": "Que faz coisas grandes e inescrutáveis, e maravilhas que não se podem contar;",
      "palavras": [
        { "hebraico": "עֹשֶׂ֣ה", "transliteral": "ʿō-śeh", "traducao_palavra": "fazendo (que faz)" },
        { "hebraico": "גְ֭דֹלֹות", "transliteral": "ḡə-ḏō-lō-wṯ", "traducao_palavra": "grandezas" },
        { "hebraico": "וְאֵ֣ין", "transliteral": "wə-ʾên", "traducao_palavra": "e não há" },
        { "hebraico": "חֵ֑קֶר", "transliteral": "ḥê-qer", "traducao_palavra": "esquadrinhamento (pesquisa)" },
        { "hebraico": "נִ֝פְלָאֹ֗ות", "transliteral": "nip̄-lā-ʾō-wṯ", "traducao_palavra": "maravilhas" },
        { "hebraico": "עַד־", "transliteral": "ʿaḏ-", "traducao_palavra": "até" },
        { "hebraico": "אֵ֥ין", "transliteral": "ʾên", "traducao_palavra": "não [haver]" },
        { "hebraico": "מִסְפָּֽר׃", "transliteral": "mis-pār", "traducao_palavra": "número" }
      ]
    },
    "16": {
      "traducao_completa": "Assim há esperança para o pobre, e a iniquidade tapa a sua boca.",
      "palavras": [
        { "hebraico": "וַתְּהִ֣י", "transliteral": "wat-tə-hî", "traducao_palavra": "e houve" },
        { "hebraico": "לַדַּ֣ל", "transliteral": "lad-dal", "traducao_palavra": "para o pobre" },
        { "hebraico": "תִּקְוָ֑ה", "transliteral": "tiq-wā", "traducao_palavra": "esperança" },
        { "hebraico": "וְ֝עֹלָ֗תָה", "transliteral": "wə-ʿō-lā-ṯā", "traducao_palavra": "e a iniquidade" },
        { "hebraico": "קָ֣פְצָה", "transliteral": "qā-p̄ə-ṣā", "traducao_palavra": "fechou (tapou)" },
        { "hebraico": "פִּֽיהָ׃", "transliteral": "pî-hā", "traducao_palavra": "sua boca" }
      ]
    },
    "17": {
      "traducao_completa": "Eis que bem-aventurado é o homem a quem Deus castiga; não desprezes, pois, o castigo do Todo-Poderoso.",
      "palavras": [
        { "hebraico": "הִנֵּ֘ה", "transliteral": "hin-nēh", "traducao_palavra": "Eis que" },
        { "hebraico": "אַ֝שְׁרֵ֣י", "transliteral": "ʾaš-rê", "traducao_palavra": "bem-aventurado [é o]" },
        { "hebraico": "אֱנֹ֣ושׁ", "transliteral": "ʾĕ-nō-wš", "traducao_palavra": "homem" },
        { "hebraico": "יֹוכִחֶ֣נּוּ", "transliteral": "yō-w-ḵi-ḥen-nū", "traducao_palavra": "[a quem] repreende/castiga" },
        { "hebraico": "אֱלֹ֑והַּ", "transliteral": "ʾĕ-lō-hwah", "traducao_palavra": "Deus" },
        { "hebraico": "וּמוּסַ֥ר", "transliteral": "ū-mū-śar", "traducao_palavra": "e o castigo/disciplina de" },
        { "hebraico": "שַׁ֝דַּ֗י", "transliteral": "šad-day", "traducao_palavra": "Todo-Poderoso" },
        { "hebraico": "אַל־", "transliteral": "ʾal-", "traducao_palavra": "não" },
        { "hebraico": "תִּמְאָֽס׃", "transliteral": "tim-ʾāś", "traducao_palavra": "desprezes" }
      ]
    },
    "18": {
      "traducao_completa": "Porque ele faz a ferida, e ele mesmo a liga; ele fere, e as suas mãos curam.",
      "palavras": [
        { "hebraico": "כִּ֤י", "transliteral": "kî", "traducao_palavra": "Porque" },
        { "hebraico": "ה֣וּא", "transliteral": "hû", "traducao_palavra": "Ele" },
        { "hebraico": "יַכְאִ֣יב", "transliteral": "yaḵ-ʾîḇ", "traducao_palavra": "faz doer/fere" },
        { "hebraico": "וְיֶחְבָּ֑שׁ", "transliteral": "wə-yeḥ-bāš", "traducao_palavra": "e liga/enfaixa" },
        { "hebraico": "יִ֝מְחַ֗ץ", "transliteral": "yim-ḥaṣ", "traducao_palavra": "Ele fere" },
        { "hebraico": "וְיָדָ֥ו", "transliteral": "wə-yā-ḏāw", "traducao_palavra": "e as mãos d'Ele" },
        { "hebraico": "תִּרְפֶּֽינָה׃", "transliteral": "tir-pe-nā", "traducao_palavra": "curam" }
      ]
    },
    "19": {
      "traducao_completa": "Em seis angústias te livrará; e na sétima o mal te não tocará.",
      "palavras": [
        { "hebraico": "בְּשֵׁ֣שׁ", "transliteral": "bə-šêš", "traducao_palavra": "Em seis" },
        { "hebraico": "צָ֭רֹות", "transliteral": "ṣā-rō-wṯ", "traducao_palavra": "angústias" },
        { "hebraico": "יַצִּילֶ֑ךָּ", "transliteral": "yaṣ-ṣî-lek-kā", "traducao_palavra": "Ele te livrará" },
        { "hebraico": "וּבְשֶׁ֝בַע", "transliteral": "ū-ḇə-še-ḇaʿ", "traducao_palavra": "e na sétima" },
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "יִגַּ֖ע", "transliteral": "yig-gaʿ", "traducao_palavra": "tocará" },
        { "hebraico": "בְּךָ֣", "transliteral": "bə-ḵā", "traducao_palavra": "em ti" },
        { "hebraico": "רָֽע׃", "transliteral": "rāʿ", "traducao_palavra": "[o] mal" }
      ]
    },
    "20": {
      "traducao_completa": "Na fome te livrará da morte; e na guerra, do poder da espada.",
      "palavras": [
        { "hebraico": "בְּ֭רָעָב", "transliteral": "bə-rā-ʿāḇ", "traducao_palavra": "Na fome" },
        { "hebraico": "פָּֽדְךָ֣", "transliteral": "pā-ḏə-ḵā", "traducao_palavra": "Ele te remiu/livrou" },
        { "hebraico": "מִמָּ֑וֶת", "transliteral": "mim-mā-weṯ", "traducao_palavra": "da morte" },
        { "hebraico": "וּ֝בְמִלְחָמָ֗ה", "transliteral": "ū-ḇə-mil-ḥā-mā", "traducao_palavra": "e na guerra" },
        { "hebraico": "מִ֧ידֵי", "transliteral": "mî-ḏê", "traducao_palavra": "das mãos/poder de" },
        { "hebraico": "חָֽרֶב׃", "transliteral": "ḥā-reḇ", "traducao_palavra": "espada" }
      ]
    },
    "21": {
      "traducao_completa": "Do açoite da língua estarás abrigado; e não temerás a assolação, quando vier.",
      "palavras": [
        { "hebraico": "בְּשֹׁ֥וט", "transliteral": "bə-šô-wṭ", "traducao_palavra": "No açoite de" },
        { "hebraico": "לָשֹׁ֗ון", "transliteral": "lā-šō-wn", "traducao_palavra": "língua" },
        { "hebraico": "תֵּחָבֵ֑א", "transliteral": "tê-ḥā-ḇê", "traducao_palavra": "serás escondido" },
        { "hebraico": "וְלֹֽא־", "transliteral": "wə-lō-", "traducao_palavra": "e não" },
        { "hebraico": "תִירָ֥א", "transliteral": "ṯî-rā", "traducao_palavra": "temerás" },
        { "hebraico": "מִ֝שֹּׁ֗ד", "transliteral": "miš-šōḏ", "traducao_palavra": "da destruição" },
        { "hebraico": "כִּ֣י", "transliteral": "kî", "traducao_palavra": "quando" },
        { "hebraico": "יָבֹֽוא׃", "transliteral": "yā-ḇô-w", "traducao_palavra": "vier" }
      ]
    },
    "22": {
      "traducao_completa": "Da assolação e da fome te rirás; e dos animais da terra não terás medo.",
      "palavras": [
        { "hebraico": "לְשֹׁ֣ד", "transliteral": "lə-šōḏ", "traducao_palavra": "Da assolação" },
        { "hebraico": "וּלְכָפָ֥ן", "transliteral": "ū-lə-ḵā-p̄ān", "traducao_palavra": "e da fome" },
        { "hebraico": "תִּשְׂחָ֑ק", "transliteral": "tiś-ḥāq", "traducao_palavra": "rirás" },
        { "hebraico": "וּמֵחַיַּ֥ת", "transliteral": "ū-mê-ḥay-yaṯ", "traducao_palavra": "e dos animais de" },
        { "hebraico": "הָ֝אָ֗רֶץ", "transliteral": "hā-ʾā-reṣ", "traducao_palavra": "a terra" },
        { "hebraico": "אַל־", "transliteral": "ʾal-", "traducao_palavra": "não" },
        { "hebraico": "תִּירָֽא׃", "transliteral": "tî-rā", "traducao_palavra": "temas" }
      ]
    },
    "23": {
      "traducao_completa": "Porque até com as pedras do campo terás a tua aliança; e os animais do campo estarão em paz contigo.",
      "palavras": [
        { "hebraico": "כִּ֤י", "transliteral": "kî", "traducao_palavra": "Porque" },
        { "hebraico": "עִם־", "transliteral": "ʿim-", "traducao_palavra": "com" },
        { "hebraico": "אַבְנֵ֣i", "transliteral": "ʾaḇ-nê", "traducao_palavra": "as pedras de" },
        { "hebraico": "הַשָּׂדֶ֣ה", "transliteral": "haś-śā-ḏeh", "traducao_palavra": "o campo" },
        { "hebraico": "בְרִיתֶ֑ךָ", "transliteral": "ḇə-rî-ṯe-ḵā", "traducao_palavra": "[estará] tua aliança" },
        { "hebraico": "וְחַיַּ֥ת", "transliteral": "wə-ḥay-yaṯ", "traducao_palavra": "e os animais de" },
        { "hebraico": "הַ֝שָּׂדֶ֗ה", "transliteral": "haś-śā-ḏeh", "traducao_palavra": "o campo" },
        { "hebraico": "הָשְׁלְמָה־", "transliteral": "hā-šə-lə-mā-", "traducao_palavra": "estão em paz" },
        { "hebraico": "לָּֽךְ׃", "transliteral": "lāḵ", "traducao_palavra": "contigo" }
      ]
    },
    "24": {
      "traducao_completa": "E saberás que a tua tenda está em paz; e visitarás a tua habitação, e nada te faltará.",
      "palavras": [
        { "hebraico": "וְיָ֭דַעְתָּ", "transliteral": "wə-yā-ḏaʿ-tā", "traducao_palavra": "E saberás" },
        { "hebraico": "כִּי־", "transliteral": "kî-", "traducao_palavra": "que" },
        { "hebraico": "שָׁלֹ֣ום", "transliteral": "šā-lō-wm", "traducao_palavra": "[há] paz em" },
        { "hebraico": "אָהֳלֶ֑ךָ", "transliteral": "ʾā-hŏ-le-ḵā", "traducao_palavra": "tua tenda" },
        { "hebraico": "וּפָקַדְתָּ֥", "transliteral": "ū-p̄ā-qaḏ-tā", "traducao_palavra": "e visitarás/inspecionarás" },
        { "hebraico": "נָ֝וְךָ", "transliteral": "nā-wə-ḵā", "traducao_palavra": "tua morada" },
        { "hebraico": "וְלֹ֣א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "תֶחֱטָֽא׃", "transliteral": "ṯe-ḥĕ-ṭā", "traducao_palavra": "pecarás/falharás" }
      ]
    },
    "25": {
      "traducao_completa": "Também saberás que se multiplicará a tua descendência e a tua posteridade como a erva da terra.",
      "palavras": [
        { "hebraico": "וְ֭יָדַעְתָּ", "transliteral": "wə-yā-ḏaʿ-tā", "traducao_palavra": "E saberás" },
        { "hebraico": "כִּי־", "transliteral": "kî-", "traducao_palavra": "que" },
        { "hebraico": "רַ֣ב", "transliteral": "raḇ", "traducao_palavra": "[será] numerosa" },
        { "hebraico": "זַרְעֶ֑ךָ", "transliteral": "zar-ʿe-ḵā", "traducao_palavra": "tua semente/descendência" },
        { "hebraico": "וְ֝צֶאֱצָאֶ֗יךָ", "transliteral": "wə-ṣe-ʾĕ-ṣā-ʾey-ḵā", "traducao_palavra": "e teus brotos/posteridade" },
        { "hebraico": "כְּעֵ֥שֶׂב", "transliteral": "kə-ʿê-śeḇ", "traducao_palavra": "como a erva de" },
        { "hebraico": "הָאָֽרֶץ׃", "transliteral": "hā-ʾā-reṣ", "traducao_palavra": "a terra" }
      ]
    },
    "26": {
      "traducao_completa": "Em robusta velhice entrarás para a sepultura, como se recolhe o feixe de trigo a seu tempo.",
      "palavras": [
        { "hebraico": "תָּבֹ֣וא", "transliteral": "tā-ḇô-w", "traducao_palavra": "Entrarás" },
        { "hebraico": "בְכֶ֣לַח", "transliteral": "ḇə-ḵe-laḥ", "traducao_palavra": "em maturidade/vigor" },
        { "hebraico": "אֱלֵי־", "transliteral": "ʾĕ-lê-", "traducao_palavra": "para" },
