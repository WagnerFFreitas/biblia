    "18": {
      "traducao_completa": "As veredas do seu caminho se desviam; sobem ao vácuo e perecem.",
      "palavras": [
        { "hebraico": "יִ֭לָּפְתוּ", "transliteral": "yil-lā-p̄ə-ṯû", "traducao_palavra": "Desviam-se" },
        { "hebraico": "אָרְחֹ֣ות", "transliteral": "ʾā-rə-ḥō-wṯ", "traducao_palavra": "[as] veredas de" },
        { "hebraico": "דַּרְכָּ֑ם", "transliteral": "dar-kām", "traducao_palavra": "seu caminho" },
        { "hebraico": "יַעֲל֖וּ", "transliteral": "ya-ʿă-lû", "traducao_palavra": "sobem" },
