        { "hebraico": "צָ֑ר", "transliteral": "ṣār", "traducao_palavra": "um adversário" },
        { "hebraico": "וּמִיַּ֖ד", "transliteral": "ū-miy-yaḏ", "traducao_palavra": "e da mão de" },
