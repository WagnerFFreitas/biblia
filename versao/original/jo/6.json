        { "hebraico": "אָרְחֹ֣ות", "transliteral": "ʾā-rə-ḥō-wṯ", "traducao_palavra": "[as] veredas de" },
        { "hebraico": "תֵּמָ֑א", "transliteral": "tê-mā", "traducao_palavra": "Temá" },
        { "hebraico": "הֲלִיכֹ֥ות", "transliteral": "hă-lî-ḵō-wṯ", "traducao_palavra": "as caravanas de" },
        { "hebraico": "שְׁ֝בָ֗א", "transliteral": "šə-ḇā", "traducao_palavra": "Sabá" },
