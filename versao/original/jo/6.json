        { "hebraico": "כִֽי־", "transliteral": "ḵî-", "traducao_palavra": "porque" },
        { "hebraico": "בָטָ֑ח", "transliteral": "ḇā-ṭāḥ", "traducao_palavra": "[cada um] confiou" },
        { "hebraico": "בָּ֥אוּ", "transliteral": "bā-ʾû", "traducao_palavra": "vieram" },
        { "hebraico": "עָ֝דֶ֗יהָ", "transliteral": "ʿā-ḏey-hā", "traducao_palavra": "até ele [o ribeiro]" },
