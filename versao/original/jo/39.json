        { "hebraico": "לְלֹא־", "transliteral": "lə-lō-", "traducao_palavra": "como se não fossem" },
        { "hebraico": "לָ֑הּ", "transliteral": "lāh", "traducao_palavra": "seus" },
        { "hebraico": "לְרִ֖יק", "transliteral": "lə-rîq", "traducao_palavra": "em vão" },
