        { "hebraico": "אֱלֹ֣והַּ", "transliteral": "ʾĕ-lô-ah", "traducao_palavra": "Deus" },
        { "hebraico": "חָכְמָ֑ה", "transliteral": "ḥāḵ-mā", "traducao_palavra": "de sabedoria" },
