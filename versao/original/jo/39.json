        { "hebraico": "רֶ֣גֶל", "transliteral": "re-ḡel", "traducao_palavra": "[um] pé" },
        { "hebraico": "תְּזוּרֶ֑הָ", "transliteral": "tə-zû-re-hā", "traducao_palavra": "pode esmagá-los" },
        { "hebraico": "וְחַיַּ֖ת", "transliteral": "wə-ḥay-yaṯ", "traducao_palavra": "e fera de" },
