        { "hebraico": "לֶ֣דֶת", "transliteral": "le-ḏeṯ", "traducao_palavra": "parir" },
        { "hebraico": "יַעֲלֵי־", "transliteral": "ya-ʿă-lê-", "traducao_palavra": "[as] cabras de" },
        { "hebraico": "סָ֑לַע", "transliteral": "śā-laʿ", "traducao_palavra": "rocha/montês" },
