        { "hebraico": "בַּמָּרֹ֣ום", "transliteral": "bam-mā-rôm", "traducao_palavra": "no alto" },
        { "hebraico": "תַּמְרִ֑יא", "transliteral": "tam-rî", "traducao_palavra": "se levanta/bate as asas" },
        { "hebraico": "תִּשְׂחַ֥ק", "transliteral": "tiś-ḥaq", "traducao_palavra": "ri-se" },
        { "hebraico": "לַ֝סּ֗וּס", "transliteral": "las-sûs", "traducao_palavra": "do cavalo" },
        { "hebraico": "וּלְרֹכְבֹֽו׃", "transliteral": "ū-lə-rō-ḵə-ḇô", "traducao_palavra": "e do seu cavaleiro" }
      ]
    },
    "19": {
      "traducao_completa": "Acaso deste tu força ao cavalo, ou revestiste o seu pescoço de crinas?",
      "palavras": [
        { "hebraico": "הֲתִתֵּ֣ן", "transliteral": "hă-ṯit-tên", "traducao_palavra": "Acaso darás tu" },
        { "hebraico": "לַסּ֣וּס", "transliteral": "las-sûs", "traducao_palavra": "ao cavalo" },
        { "hebraico": "גְּבוּרָ֑ה", "transliteral": "gə-ḇû-rā", "traducao_palavra": "força" },
        { "hebraico": "הֲתַלְבִּ֥ישׁ", "transliteral": "hă-ṯal-bîš", "traducao_palavra": "acaso revestirás" },
        { "hebraico": "צַוָּארֹ֥ו", "transliteral": "ṣaw-wā-rô", "traducao_palavra": "o pescoço dele" },
        { "hebraico": "רַעְמָֽה׃", "transliteral": "ra-ʿmā", "traducao_palavra": "de crina/trovão" }
      ]
    },
    "20": {
      "traducao_completa": "Acaso o farás saltar como ao gafanhoto? Terrível é o fogoso respirar das suas ventas.",
      "palavras": [
        { "hebraico": "הַֽתַּרְעִישֶׁ֥נּוּ", "transliteral": "hat-tar-ʿî-šen-nū", "traducao_palavra": "Acaso o farás saltar/tremer" },
        { "hebraico": "כָּאַרְבֶּ֑ה", "transliteral": "kā-ʾar-beh", "traducao_palavra": "como o gafanhoto?" },
        { "hebraico": "הֹ֥וד", "transliteral": "hôḏ", "traducao_palavra": "A glória/majestade de" },
        { "hebraico": "נַ֝חְרֹ֗ו", "transliteral": "na-ḥərô", "traducao_palavra": "seu resfolegar" },
        { "hebraico": "אֵימָֽה׃", "transliteral": "ʾê-mā", "traducao_palavra": "[é] pavor" }
      ]
    },
    "21": {
      "traducao_completa": "Escarva na terra, e folga na sua força, e sai ao encontro das armas.",
      "palavras": [
        { "hebraico": "יַחְפְּר֣וּ", "transliteral": "yaḥ-pə-rû", "traducao_palavra": "Escarvam" },
        { "hebraico": "בָ֭עֵמֶק", "transliteral": "ḇā-ʿê-meq", "traducao_palavra": "no vale" },
        { "hebraico": "וְיָשִׂ֣ישׂ", "transliteral": "wə-yā-śîś", "traducao_palavra": "e alegra-se" },
        { "hebraico": "בְּכֹ֑חַ", "transliteral": "bə-ḵō-aḥ", "traducao_palavra": "na [sua] força" },
        { "hebraico": "יֵ֝צֵ֗א", "transliteral": "yê-ṣê", "traducao_palavra": "sai" },
        { "hebraico": "לִקְרַאת־", "transliteral": "liq-raṯ-", "traducao_palavra": "ao encontro de" },
        { "hebraico": "נָֽשֶׁק׃", "transliteral": "nā-šeq", "traducao_palavra": "armas" }
      ]
    },
    "22": {
      "traducao_completa": "Ri-se do temor, e não se espanta, e não torna atrás por causa da espada.",
      "palavras": [
        { "hebraico": "יִשְׂחַ֣ק", "transliteral": "yiś-ḥaq", "traducao_palavra": "Ri-se" },
        { "hebraico": "לְ֭פַחַד", "transliteral": "lə-p̄a-ḥaḏ", "traducao_palavra": "do pavor" },
        { "hebraico": "וְלֹ֣א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "יֵחָ֑ת", "transliteral": "yê-ḥāṯ", "traducao_palavra": "se aterroriza" },
        { "hebraico": "וְלֹא־", "transliteral": "wə-lō-", "traducao_palavra": "e não" },
        { "hebraico": "יָ֝שׁוּב", "transliteral": "yā-šûḇ", "traducao_palavra": "volta" },
        { "hebraico": "מִפְּנֵי־", "transliteral": "mip-pə-nê-", "traducao_palavra": "diante da" },
        { "hebraico": "חָֽרֶב׃", "transliteral": "ḥā-reḇ", "traducao_palavra": "espada" }
      ]
    },
    "23": {
      "traducao_completa": "Contra ele range a aljava, a lança flamejante e o dardo.",
      "palavras": [
        { "hebraico": "עָ֭לָיו", "transliteral": "ʿā-lāyw", "traducao_palavra": "Sobre ele" },
        { "hebraico": "תִּרְנֶ֣ה", "transliteral": "tir-neh", "traducao_palavra": "range/soa" },
        { "hebraico": "אַשְׁפָּ֑ה", "transliteral": "ʾaš-pā", "traducao_palavra": "[a] aljava" },
        { "hebraico": "לַ֥הַב", "transliteral": "la-haḇ", "traducao_palavra": "[a] chama de" },
        { "hebraico": "חֲ֝נִית", "transliteral": "ḥă-nîṯ", "traducao_palavra": "lança" },
        { "hebraico": "וְכִידֹֽון׃", "transliteral": "wə-ḵî-ḏôwn", "traducao_palavra": "e dardo" }
      ]
    },
    "24": {
      "traducao_completa": "Agitando-se e furioso, ele devora a terra, e não se detém ao som da trombeta.",
      "palavras": [
        { "hebraico": "בְּרַ֣עַשׁ", "transliteral": "bə-ra-ʿaš", "traducao_palavra": "Com tremor" },
        { "hebraico": "וְ֭רֹגֶז", "transliteral": "wə-rō-ḡez", "traducao_palavra": "e furor" },
        { "hebraico": "יְגַמֶּא־", "transliteral": "yə-ḡam-me-", "traducao_palavra": "ele devora" },
        { "hebraico": "אָ֑רֶץ", "transliteral": "ʾā-reṣ", "traducao_palavra": "[a] terra" },
        { "hebraico": "וְלֹא־", "transliteral": "wə-lō-", "traducao_palavra": "e não" },
        { "hebraico": "יַ֝אֲמִ֗ין", "transliteral": "ya-ʾă-mîn", "traducao_palavra": "fica parado/crê" },
        { "hebraico": "כִּי־", "transliteral": "kî-", "traducao_palavra": "quando [há]" },
        { "hebraico": "קֹ֥ול", "transliteral": "qôl", "traducao_palavra": "[o] som de" },
        { "hebraico": "שֹׁופָֽר׃", "transliteral": "šô-p̄ār", "traducao_palavra": "trombeta" }
      ]
    },
    "25": {
      "traducao_completa": "Ao soar da trombeta diz: Eia! E de longe cheira a guerra, o trovão dos príncipes, e o alarido.",
      "palavras": [
        { "hebraico": "בְּדֵי֮", "transliteral": "bə-ḏê", "traducao_palavra": "Sempre que [soa]" },
        { "hebraico": "שֹׁופָ֪ר", "transliteral": "šô-p̄ār", "traducao_palavra": "[a] trombeta" },
        { "hebraico": "יֹאמַ֨ר ׀", "transliteral": "yō-mar", "traducao_palavra": "diz ele" },
        { "hebraico": "הֶ֫אָ֥ח", "transliteral": "he-ʾāḥ", "traducao_palavra": "Eia!/Ah!" },
        { "hebraico": "וּ֝מֵרָחֹ֗וק", "transliteral": "ū-mê-rā-ḥô-wq", "traducao_palavra": "e de longe" },
        { "hebraico": "יָרִ֥יחַ", "transliteral": "yā-rî-aḥ", "traducao_palavra": "cheira" },
        { "hebraico": "מִלְחָמָ֑ה", "transliteral": "mil-ḥā-mā", "traducao_palavra": "[a] guerra" },
        { "hebraico": "רַ֥עַם", "transliteral": "ra-ʿam", "traducao_palavra": "[o] trovão de" },
        { "hebraico": "שָׂ֝רִ֗ים", "transliteral": "śā-rîm", "traducao_palavra": "príncipes" },
        { "hebraico": "וּתְרוּעָֽה׃", "transliteral": "ū-ṯə-rû-ʿā", "traducao_palavra": "e o alarido" }
      ]
    },
    "26": {
      "traducao_completa": "Porventura voa o gavião pela tua inteligência, estendendo as suas asas para o sul?",
      "palavras": [
        { "hebraico": "הֲמִבִּֽינָתְךָ֭", "transliteral": "hă-mib-bî-nā-ṯə-ḵā", "traducao_palavra": "Acaso pela tua inteligência" },
        { "hebraico": "יַֽאֲבֶר־", "transliteral": "ya-ʾă-ḇer-", "traducao_palavra": "voa/empluma" },
        { "hebraico": "נֵ֑ץ", "transliteral": "nêṣ", "traducao_palavra": "[o] gavião" },
        { "hebraico": "יִפְרֹ֨שׂ", "transliteral": "yip̄-rōś", "traducao_palavra": "[e] estende" },
        { "hebraico": "כְּנָפָ֝ו", "transliteral": "kə-nā-p̄āw", "traducao_palavra": "suas asas" },
        { "hebraico": "לְתֵימָֽן׃", "transliteral": "lə-ṯê-mān", "traducao_palavra": "para o sul?" }
      ]
    },
    "27": {
      "traducao_completa": "Ou se remonta a águia ao teu mandado, e põe no alto o seu ninho?",
      "palavras": [
        { "hebraico": "אִם־", "transliteral": "ʾim-", "traducao_palavra": "Acaso" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sob" },
        { "hebraico": "פִּ֭יךָ", "transliteral": "pî-ḵā", "traducao_palavra": "tua ordem/boca" },
        { "hebraico": "יַגְבִּ֣יהַּ", "transliteral": "yaḡ-bî-ah", "traducao_palavra": "se eleva" },
        { "hebraico": "נָ֑שֶׁר", "transliteral": "nā-šer", "traducao_palavra": "[a] águia" },
        { "hebraico": "וְ֝כִ֗י", "transliteral": "wə-ḵî", "traducao_palavra": "e [porque]" },
        { "hebraico": "יָרִ֥ים", "transliteral": "yā-rîm", "traducao_palavra": "põe no alto" },
        { "hebraico": "קִנֹּֽו׃", "transliteral": "qin-nô", "traducao_palavra": "seu ninho?" }
      ]
    },
    "28": {
      "traducao_completa": "Nas rochas habita e pernoita; no cume do penhasco, e em lugar seguro.",
      "palavras": [
        { "hebraico": "סֶ֣לַע", "transliteral": "śe-laʿ", "traducao_palavra": "[Na] rocha" },
        { "hebraico": "יִ֭שְׁכֹּן", "transliteral": "yiš-kōn", "traducao_palavra": "habita" },
        { "hebraico": "וְיִתְלֹנָ֑ן", "transliteral": "wə-yiṯ-lō-nān", "traducao_palavra": "e pernoita" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre" },
        { "hebraico": "שֶׁן־", "transliteral": "šen-", "traducao_palavra": "[o] dente de/cume de" },
        { "hebraico": "סֶ֝֗לַע", "transliteral": "śe-laʿ", "traducao_palavra": "rocha" },
        { "hebraico": "וּמְצוּדָֽה׃", "transliteral": "ū-mə-ṣû-ḏā", "traducao_palavra": "e fortaleza/lugar seguro" }
      ]
    },
    "29": {
      "traducao_completa": "Dali descobre a presa; de longe a avistam os seus olhos.",
      "palavras": [
        { "hebraico": "מִשָּׁ֥ם", "transliteral": "miš-šām", "traducao_palavra": "Dali" },
        { "hebraico": "חָֽפַר־", "transliteral": "ḥā-p̄ar-", "traducao_palavra": "espreita/cava" },
        { "hebraico": "אָ֑כֶל", "transliteral": "ʾō-ḵel", "traducao_palavra": "[a] comida/presa" },
        { "hebraico": "לְ֝מֵרָחֹ֗וק", "transliteral": "lə-mê-rā-ḥô-wq", "traducao_palavra": "de longe" },
        { "hebraico": "עֵינָ֥יו", "transliteral": "ʿê-nāyw", "traducao_palavra": "seus olhos" },
        { "hebraico": "יַבִּֽיטוּ׃", "transliteral": "yab-bî-ṭû", "traducao_palavra": "avistam" }
      ]
    },
    "30": {
      "traducao_completa": "Seus filhos sugam o sangue; e onde há mortos, ali está ela.",
      "palavras": [
        { "hebraico": "וְאֶפְרֹוחָ֥יו", "transliteral": "wə-ʾep̄-rō-ḥāyw", "traducao_palavra": "E seus filhotes" },
        { "hebraico": "יְעַלְעוּ־", "transliteral": "yə-al-ʿû-", "traducao_palavra": "sugam/bebem" },
        { "hebraico": "דָ֑ם", "transliteral": "ḏām", "traducao_palavra": "sangue" },
        { "hebraico": "וּבַאֲשֶׁ֥ר", "transliteral": "ū-ḇa-ʾă-šer", "traducao_palavra": "e onde" },
        { "hebraico": "חֲ֝לָלִ֗ים", "transliteral": "ḥă-lā-lîm", "traducao_palavra": "[há] mortos" },
        { "hebraico": "שָׁ֣ם", "transliteral": "šām", "traducao_palavra": "ali" },
        { "hebraico": "הֽוּא׃", "transliteral": "hû", "traducao_palavra": "está ela" }
      ]
    }
