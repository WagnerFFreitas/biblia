{
  "livro": "Jó - אִיּוֹב - ʾIy-yōḇ",
  "capítulo": 23,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Respondeu, porém, Jó, dizendo:",
      "palavras": [
        { "hebraico": "וַיַּ֥עַן", "transliteral": "way-ya-ʿan", "traducao_palavra": "E respondeu" },
        { "hebraico": "אִיֹּ֥ob", "transliteral": "ʾiy-yō-wḇ", "traducao_palavra": "Jó" },
        { "hebraico": "וַיֹּאמַֽר׃", "transliteral": "way-yō-mar", "traducao_palavra": "e disse" }
      ]
    },
    "2": {
      "traducao_completa": "Ainda hoje a minha queixa é de rebeldia; a minha mão é pesada por causa do meu gemido.",
      "palavras": [
        { "hebraico": "גַּם־", "transliteral": "gam-", "traducao_palavra": "Também" },
        { "hebraico": "הַיֹּ֥ום", "transliteral": "hay-yō-wm", "traducao_palavra": "hoje" },
        { "hebraico": "מְרִ֣י", "transliteral": "mə-rî", "traducao_palavra": "[é] amargura/rebeldia" },
        { "hebraico": "שִׂחִ֑י", "transliteral": "śi-ḥî", "traducao_palavra": "minha queixa" },
        { "hebraico": "יָדִ֥י", "transliteral": "yā-ḏî", "traducao_palavra": "minha mão" },
        { "hebraico": "כָּ֝בְדָ֗ה", "transliteral": "kā-ḇə-ḏā", "traducao_palavra": "está pesada" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre/por causa de" },
        { "hebraico": "אַנְחָתִֽי׃", "transliteral": "ʾan-ḥā-ṯî", "traducao_palavra": "meu gemido" }
      ]
    },
    "3": {
      "traducao_completa": "Ah, se eu soubesse onde o poderia achar! Então me chegaria ao seu tribunal.",
      "palavras": [
        { "hebraico": "מִֽי־", "transliteral": "mî-", "traducao_palavra": "Quem" },
        { "hebraico": "יִתֵּ֣ן", "transliteral": "yit-tên", "traducao_palavra": "dera [Oxalá]" },
        { "hebraico": "יָדַ֣עְתִּי", "transliteral": "yā-ḏaʿ-tî", "traducao_palavra": "eu soubesse" },
        { "hebraico": "וְאֶמְצָאֵ֑הוּ", "transliteral": "wə-ʾem-ṣā-ʾê-hū", "traducao_palavra": "e o achasse" },
        { "hebraico": "אָ֝בֹ֗וא", "transliteral": "ʾā-ḇô-w", "traducao_palavra": "iria" },
        { "hebraico": "עַד־", "transliteral": "ʿaḏ-", "traducao_palavra": "até" },
        { "hebraico": "תְּכוּנָתֹֽו׃", "transliteral": "tə-ḵû-nā-ṯô", "traducao_palavra": "seu tribunal/lugar" }
      ]
    },
    "4": {
      "traducao_completa": "Ordenaria a minha causa diante dele, e a minha boca encheria de argumentos.",
      "palavras": [
        { "hebraico": "אֶעֶרְכָה֮", "transliteral": "ʾe-ʿer-ḵā", "traducao_palavra": "Ordenaria/Exporia" },
        { "hebraico": "לְפָנָ֪יו", "transliteral": "lə-p̄ā-nāyw", "traducao_palavra": "diante d'Ele" },
        { "hebraico": "מִשְׁפָּ֫ט", "transliteral": "miš-pāṭ", "traducao_palavra": "a causa/juízo" },
        { "hebraico": "וּפִ֥י", "transliteral": "ū-p̄î", "traducao_palavra": "e minha boca" },
        { "hebraico": "אֲמַלֵּ֥א", "transliteral": "ʾă-mal-lê", "traducao_palavra": "encheria de" },
        { "hebraico": "תֹּוכָחֹֽות׃", "transliteral": "ṯô-w-ḵā-ḥō-wṯ", "traducao_palavra": "argumentos/provas" }
      ]
    },
    "5": {
      "traducao_completa": "Saberia as palavras com que ele me responderia, e entenderia o que me dissesse.",
      "palavras": [
        { "hebraico": "אֵ֭דְעָה", "transliteral": "ʾê-ḏə-ʿā", "traducao_palavra": "Saberia" },
        { "hebraico": "מִלִּ֣ים", "transliteral": "mil-lîm", "traducao_palavra": "[as] palavras" },
        { "hebraico": "יַעֲנֵ֑נִי", "transliteral": "ya-ʿă-nê-nî", "traducao_palavra": "[que] me responderia" },
        { "hebraico": "וְ֝אָבִ֗ינָה", "transliteral": "wə-ʾā-ḇî-nā", "traducao_palavra": "e entenderia" },
        { "hebraico": "מַה־", "transliteral": "mah-", "traducao_palavra": "o que" },
        { "hebraico": "יֹּ֥אמַר", "transliteral": "yō-mar", "traducao_palavra": "diria" },
        { "hebraico": "לִֽי׃", "transliteral": "lî", "traducao_palavra": "a mim" }
      ]
    },
    "6": {
      "traducao_completa": "Porventura contenderia comigo segundo a grandeza do seu poder? Não; antes ele me atenderia.",
      "palavras": [
        { "hebraico": "הַבְּרָב־", "transliteral": "hab-bə-rāḇ-", "traducao_palavra": "Acaso com a grandeza de" },
        { "hebraico": "כֹּ֥חַ", "transliteral": "kō-aḥ", "traducao_palavra": "poder" },
        { "hebraico": "יָרִ֥יב", "transliteral": "yā-rîḇ", "traducao_palavra": "contenderia" },
        { "hebraico": "עִמָּדִ֑י", "transliteral": "ʿim-mā-ḏî", "traducao_palavra": "comigo?" },
        { "hebraico": "לֹ֥א", "transliteral": "lō", "traducao_palavra": "Não" },
        { "hebraico": "אַךְ־", "transliteral": "ʾaḵ-", "traducao_palavra": "certamente" },
        { "hebraico": "ה֝וּא", "transliteral": "hû", "traducao_palavra": "Ele" },
        { "hebraico": "יָשִׂ֥ים", "transliteral": "yā-śîm", "traducao_palavra": "poria/atenderia" },
        { "hebraico": "בִּֽי׃", "transliteral": "bî", "traducao_palavra": "em mim [atenção]" }
      ]
    },
    "7": {
      "traducao_completa": "Ali o homem reto pleitearia com ele, e eu me livraria para sempre do meu Juiz.",
      "palavras": [
        { "hebraico": "שָׁ֭ם", "transliteral": "šām", "traducao_palavra": "Ali" },
        { "hebraico": "יָשָׁ֣ר", "transliteral": "yā-šār", "traducao_palavra": "[o] reto" },
        { "hebraico": "נֹוכָ֣ח", "transliteral": "nô-w-ḵāḥ", "traducao_palavra": "arrazoaria/discutiria" },
        { "hebraico": "עִמֹּ֑ו", "transliteral": "ʿim-mô", "traducao_palavra": "com Ele" },
        { "hebraico": "וַאֲפַלְּטָ֥ה", "transliteral": "wa-ʾă-p̄al-lə-ṭā", "traducao_palavra": "e eu me livraria" },
        { "hebraico": "לָ֝נֶ֗צַח", "transliteral": "lā-ne-ṣaḥ", "traducao_palavra": "para sempre" },
        { "hebraico": "מִשֹּׁפְטִֽי׃", "transliteral": "miš-šō-p̄ə-ṭî", "traducao_palavra": "do meu juiz" }
      ]
    },
    "8": {
      "traducao_completa": "Eis que se me vou para o oriente, ele ali não está; e para o ocidente, e não o percebo.",
      "palavras": [
        { "hebraico": "הֵ֤ן", "transliteral": "hên", "traducao_palavra": "Eis que" },
        { "hebraico": "קֶ֣דֶם", "transliteral": "qe-ḏem", "traducao_palavra": "[para o] oriente" },
        { "hebraico": "אֶהֱלֹ֣ךְ", "transliteral": "ʾe-hĕ-lōḵ", "traducao_palavra": "eu vou" },
        { "hebraico": "וְאֵינֶ֑נּוּ", "transliteral": "wə-ʾê-nen-nû", "traducao_palavra": "e Ele não [está]" },
        { "hebraico": "וְאָחֹ֗ור", "transliteral": "wə-ʾā-ḥô-wr", "traducao_palavra": "e para trás/ocidente" },
        { "hebraico": "וְלֹא־", "transliteral": "wə-lō-", "traducao_palavra": "e não" },
        { "hebraico": "אָבִ֥ין", "transliteral": "ʾā-ḇîn", "traducao_palavra": "percebo" },
        { "hebraico": "לֹֽו׃", "transliteral": "lô", "traducao_palavra": "a Ele" }
      ]
    },
    "9": {
      "traducao_completa": "Para a esquerda, onde ele opera, mas não o vejo; esconde-se à direita, e não o diviso.",
      "palavras": [
        { "hebraico": "שְׂמֹאול֮", "transliteral": "śə-mō-wl", "traducao_palavra": "À esquerda" },
        { "hebraico": "בַּעֲשֹׂתֹ֪ו", "transliteral": "ba-ʿă-śō-ṯô", "traducao_palavra": "em Seu operar" },
        { "hebraico": "וְלֹא־", "transliteral": "wə-lō-", "traducao_palavra": "e não" },
        { "hebraico": "אָחַ֫ז", "transliteral": "ʾā-ḥaz", "traducao_palavra": "[o] vejo/agarro" },
        { "hebraico": "יַעְטֹ֥ף", "transliteral": "yaʿ-ṭōp̄", "traducao_palavra": "Ele se volta" },
        { "hebraico": "יָמִ֗ין", "transliteral": "yā-mîn", "traducao_palavra": "[para a] direita" },
        { "hebraico": "וְלֹ֣א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "אֶרְאֶֽה׃", "transliteral": "ʾer-ʾeh", "traducao_palavra": "[O] vejo" }
      ]
    },
    "10": {
      "traducao_completa": "Porém ele sabe o meu caminho; prove-me ele, e sairei como o ouro.",
      "palavras": [
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "Porém" },
        { "hebraico": "יָדַ֬ע", "transliteral": "yā-ḏaʿ", "traducao_palavra": "Ele sabe" },
        { "hebraico": "דֶּ֣רֶךְ", "transliteral": "de-reḵ", "traducao_palavra": "o caminho" },
        { "hebraico": "עִמָּדִ֑י", "transliteral": "ʿim-mā-ḏî", "traducao_palavra": "comigo/meu" },
        { "hebraico": "בְּ֝חָנַ֗נִי", "transliteral": "bə-ḥā-na-nî", "traducao_palavra": "[se] Ele me provar" },
        { "hebraico": "כַּזָּהָ֥ב", "transliteral": "kaz-zā-hāḇ", "traducao_palavra": "como o ouro" },
        { "hebraico": "אֵצֵֽא׃", "transliteral": "ʾê-ṣê", "traducao_palavra": "sairei" }
      ]
    },
    "11": {
      "traducao_completa": "Nas suas pisadas os meus pés se firmaram; guardei o seu caminho, e não me desviei dele.",
      "palavras": [
        { "hebraico": "בַּ֭אֲשֻׁרֹו", "transliteral": "ba-ʾă-šu-rô", "traducao_palavra": "Nas pisadas d'Ele" },
        { "hebraico": "אָחֲזָ֣ה", "transliteral": "ʾā-ḥă-zā", "traducao_palavra": "seguraram-se/firmaram-se" },
        { "hebraico": "רַגְלִ֑י", "transliteral": "raḡ-lî", "traducao_palavra": "meus pés" },
        { "hebraico": "דַּרְכֹּ֖ו", "transliteral": "dar-kô", "traducao_palavra": "o Seu caminho" },
        { "hebraico": "שָׁמַ֣רְתִּי", "transliteral": "šā-mar-tî", "traducao_palavra": "guardei" },
        { "hebraico": "וְלֹא־", "transliteral": "wə-lō-", "traducao_palavra": "e não" },
        { "hebraico": "אָֽט׃", "transliteral": "ʾāṭ", "traducao_palavra": "me desviei" }
      ]
    },
    "12": {
      "traducao_completa": "Do mandamento de seus lábios nunca me apartei, e as palavras da sua boca guardei mais do que a minha porção.",
      "palavras": [
        { "hebraico": "מִצְוַ֣ת", "transliteral": "miṣ-waṯ", "traducao_palavra": "[Do] mandamento de" },
        { "hebraico": "שְׂ֭פָתָיו", "transliteral": "śə-p̄ā-ṯāyw", "traducao_palavra": "Seus lábios" },
        { "hebraico": "וְלֹ֣א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "אָמִ֑ישׁ", "transliteral": "ʾā-mîš", "traducao_palavra": "me apartei" },
        { "hebraico": "מֵ֝חֻקִּ֗י", "transliteral": "mê-ḥuq-qî", "traducao_palavra": "mais que meu limite/porção" },
        { "hebraico": "צָפַ֥נְתִּי", "transliteral": "ṣā-p̄an-tî", "traducao_palavra": "tesourei/guardei" },
        { "hebraico": "אִמְרֵי־", "transliteral": "ʾim-rê-", "traducao_palavra": "as palavras de" },
        { "hebraico": "פִֽיו׃", "transliteral": "p̄îw", "traducao_palavra": "Sua boca" }
      ]
    },
    "13": {
      "traducao_completa": "Mas, se ele resolveu alguma coisa, quem o poderá desviar? O que a sua alma desejar, isso fará.",
      "palavras": [
        { "hebraico": "וְה֣וּא", "transliteral": "wə-hû", "traducao_palavra": "Mas Ele" },
        { "hebraico": "בְ֭אֶחָד", "transliteral": "ḇə-ʾe-ḥāḏ", "traducao_palavra": "[está] em um [só propósito]" },
        { "hebraico": "וּמִ֣י", "transliteral": "ū-mî", "traducao_palavra": "e quem" },
        { "hebraico": "יְשִׁיבֶ֑נּוּ", "transliteral": "yə-šî-ḇen-nû", "traducao_palavra": "pode fazê-Lo voltar/desviar?" },
        { "hebraico": "וְנַפְשֹׁ֥ו", "transliteral": "wə-nap̄-šô", "traducao_palavra": "e o que Sua alma" },
        { "hebraico": "אִ֝וְּתָה", "transliteral": "ʾiw-wə-ṯā", "traducao_palavra": "deseja" },
        { "hebraico": "וַיָּֽעַשׂ׃", "transliteral": "way-ya-ʿaś", "traducao_palavra": "Ele faz" }
      ]
    },
    "14": {
      "traducao_completa": "Porque ele cumprirá o que está ordenado a meu respeito, e muitas coisas como estas ainda tem consigo.",
      "palavras": [
        { "hebraico": "כִּ֭י", "transliteral": "kî", "traducao_palavra": "Porque" },
        { "hebraico": "יַשְׁלִ֣ים", "transliteral": "yaš-lîm", "traducao_palavra": "cumprirá/completará" },
        { "hebraico": "חֻקִּ֑י", "transliteral": "ḥuq-qî", "traducao_palavra": "o meu decreto" },
        { "hebraico": "וְכָהֵ֖נָּה", "transliteral": "wə-ḵā-hên-nā", "traducao_palavra": "e como estas [coisas]" },
        { "hebraico": "רַבֹּ֥ות", "transliteral": "rab-bô-wṯ", "traducao_palavra": "muitas" },
        { "hebraico": "עִמֹּֽו׃", "transliteral": "ʿim-mô", "traducao_palavra": "[há] com Ele" }
      ]
    },
    "15": {
      "traducao_completa": "Portanto, me perturbo perante a sua face, e, quando considero, tenho medo dele.",
      "palavras": [
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "Por" },
        { "hebraico": "כֵּ֭ן", "transliteral": "kên", "traducao_palavra": "isso" },
        { "hebraico": "מִפָּנָ֣יו", "transliteral": "mip-pā-nāyw", "traducao_palavra": "perante Sua face" },
        { "hebraico": "אֶבָּהֵ֑ל", "transliteral": "ʾeb-bā-hêl", "traducao_palavra": "me perturbo" },
        { "hebraico": "אֶ֝תְבֹּונֵ֗ן", "transliteral": "ʾeṯ-bô-w-nên", "traducao_palavra": "considero" },
        { "hebraico": "וְאֶפְחַ֥ד", "transliteral": "wə-ʾep̄-ḥaḏ", "traducao_palavra": "e tenho medo" },
        { "hebraico": "מִמֶּֽנּוּ׃", "transliteral": "mim-men-nū", "traducao_palavra": "d'Ele" }
      ]
    },
    "16": {
      "traducao_completa": "Deus amoleceu o meu coração, e o Todo-Poderoso me perturbou.",
      "palavras": [
        { "hebraico": "וְ֭אֵל", "transliteral": "wə-ʾêl", "traducao_palavra": "E Deus" },
        { "hebraico": "הֵרַ֣ךְ", "transliteral": "hê-raḵ", "traducao_palavra": "amoleceu/enfraqueceu" },
        { "hebraico": "לִבִּ֑י", "transliteral": "lib-bî", "traducao_palavra": "meu coração" },
        { "hebraico": "וְ֝שַׁדַּ֗י", "transliteral": "wə-šad-day", "traducao_palavra": "e o Todo-Poderoso" },
        { "hebraico": "הִבְהִילָֽנִי׃", "transliteral": "hiḇ-hî-lā-nî", "traducao_palavra": "me perturbou/aterrorizou" }
      ]
    },
    "17": {
      "traducao_completa": "Porque não fui cortado antes das trevas, nem ele encobriu dos meus olhos a escuridão.",
      "palavras": [
        { "hebraico": "כִּ֤י", "transliteral": "kî", "traducao_palavra": "Porque" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "נִצְמַ֣תִּי", "transliteral": "niṣ-mat-tî", "traducao_palavra": "fui silenciado/destruído" },
        { "hebraico": "מִפְּנֵי־", "transliteral": "mip-pə-nê-", "traducao_palavra": "diante de" },
        { "hebraico": "חֹ֑שֶׁךְ", "transliteral": "ḥō-šeḵ", "traducao_palavra": "trevas" },
        { "hebraico": "וּ֝מִפָּנַ֗י", "transliteral": "ū-mip-pā-nay", "traducao_palavra": "e da minha face" },
        { "hebraico": "כִּסָּה־", "transliteral": "kis-śā-", "traducao_palavra": "encobriu" },
        { "hebraico": "אֹֽפֶל׃", "transliteral": "ʾō-p̄el", "traducao_palavra": "[a] escuridão" }
      ]
    }
  }
}