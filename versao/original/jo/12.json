        { "hebraico": "אֲשֶׁר", "transliteral": "ʾă-šer", "traducao_palavra": "Em cuja" },
        { "hebraico": "בְּ֭יָדֹו", "transliteral": "bə-yā-ḏô", "traducao_palavra": "[está] mão d'Ele" },
        { "hebraico": "נֶ֣פֶשׁ", "transliteral": "ne-p̄eš", "traducao_palavra": "[a] alma de" },
        { "hebraico": "כָּל־", "transliteral": "kāl-", "traducao_palavra": "toda" },
        { "hebraico": "חָ֑י", "transliteral": "ḥāy", "traducao_palavra": "[coisa] viva" },
        { "hebraico": "וְ֝ר֗וּחַ", "transliteral": "wə-rû-aḥ", "traducao_palavra": "e o espírito de" },
