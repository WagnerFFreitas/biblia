        { "hebraico": "אֹֽהָלִ֪ים", "transliteral": "ʾō-hā-lîm", "traducao_palavra": "as tendas de" },
        { "hebraico": "לְשֹׁ֫דְדִ֥ים", "transliteral": "lə-šō-ḏə-ḏîm", "traducao_palavra": "saqueadores" },
        { "hebraico": "וּ֝בַטֻּחֹות", "transliteral": "ū-ḇaṭ-ṭu-ḥō-wṯ", "traducao_palavra": "e seguranças" },
