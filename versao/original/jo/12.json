        { "hebraico": "וְתֽוּשִׁיָּ֑ה", "transliteral": "wə-ṯû-šî-yā", "traducao_palavra": "e a sabedoria" },
        { "hebraico": "לֹ֥ו", "transliteral": "lô", "traducao_palavra": "d'Ele [é]" },
        { "hebraico": "שֹׁ֝גֵ֗ג", "transliteral": "šō-ḡêḡ", "traducao_palavra": "o que erra" },
