    "4": {
      "traducao_completa": "Eu sou motivo de riso para os meus amigos; eu, que invoco a Deus, e ele me responde; o justo e o íntegro servem de zombaria.",
      "palavras": [
        { "hebraico": "שְׂחֹ֣ק", "transliteral": "śə-ḥōq", "traducao_palavra": "Motivo de riso" },
        { "hebraico": "לְרֵעֵ֣הוּ", "transliteral": "lə-rê-ʿê-hū", "traducao_palavra": "para o seu amigo" },
        { "hebraico": "אֶהְיֶe", "transliteral": "ʾeh-yeh", "traducao_palavra": "sou" },
        { "hebraico": "קֹרֵ֣א", "transliteral": "qō-rê", "traducao_palavra": "[eu que] invoco" },
