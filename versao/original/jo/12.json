        { "hebraico": "בְּיָדֹֽו׃", "transliteral": "bə-yā-ḏô", "traducao_palavra": "na sua mão" }
      ]
    },
    "7": {
      "traducao_completa": "Mas pergunta agora às alimárias, e cada uma delas te ensinará; e às aves dos céus, e elas te farão saber;",
      "palavras": [
        { "hebraico": "וְא֨וּלָם", "transliteral": "wə-ʾû-lām", "traducao_palavra": "Mas" },
        { "hebraico": "שְׁאַל־", "transliteral": "šə-ʾal-", "traducao_palavra": "pergunta" },
        { "hebraico": "נָ֣א", "transliteral": "nā", "traducao_palavra": "agora" },
        { "hebraico": "בְהֵמֹ֣ות", "transliteral": "ḇə-hê-mō-wṯ", "traducao_palavra": "aos animais" },
        { "hebraico": "וְתֹרֶ֑ךָּ", "transliteral": "wə-ṯō-rek-kā", "traducao_palavra": "e eles te ensinarão" },
        { "hebraico": "וְעֹ֥וף", "transliteral": "wə-ʿō-wp̄", "traducao_palavra": "e a ave de" },
        { "hebraico": "הַשָּׁמַ֝יִם", "transliteral": "haš-šā-ma-yim", "traducao_palavra": "os céus" },
