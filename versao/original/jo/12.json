        { "hebraico": "בְּכָל־", "transliteral": "bə-ḵāl-", "traducao_palavra": "em todos" },
        { "hebraico": "אֵ֑לֶּה", "transliteral": "ʾêl-leh", "traducao_palavra": "estes" },
        { "hebraico": "כִּ֛י", "transliteral": "kî", "traducao_palavra": "que" },
