      ]
    },
    "5": {
      "traducao_completa": "Tocha desprezada é, na opinião do que está descansado, aquela que está preparada para os que tropeçam com os pés.",
      "palavras": [
        { "hebraico": "לַפִּ֣יד", "transliteral": "lap-pîḏ", "traducao_palavra": "Tocha" },
        { "hebraico": "בּ֭וּז", "transliteral": "bûz", "traducao_palavra": "[é] desprezada" },
        { "hebraico": "לְעַשְׁתּ֣וּת", "transliteral": "lə-ʿaš-tût", "traducao_palavra": "no pensamento de" },
