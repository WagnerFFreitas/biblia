        { "hebraico": "אֹ֚ו", "transliteral": "ʾô", "traducao_palavra": "Ou" },
        { "hebraico": "שִׂ֣יחַ", "transliteral": "śî-aḥ", "traducao_palavra": "fala" },
        { "hebraico": "לָאָ֣רֶץ", "transliteral": "lā-ʾā-reṣ", "traducao_palavra": "à terra" },
        { "hebraico": "וְתֹרֶ֑ךָּ", "transliteral": "wə-ṯō-rek-kā", "traducao_palavra": "e ela te ensinará" },
