        { "hebraico": "נָ֝כֹ֗ון", "transliteral": "nā-ḵō-wn", "traducao_palavra": "preparada" },
        { "hebraico": "לְמֹ֣ועֲדֵי", "transliteral": "lə-mō-w-ʿă-ḏê", "traducao_palavra": "para os que tropeçam de" },
        { "hebraico": "רָֽגֶL׃", "transliteral": "rā-ḡel", "traducao_palavra": "pé" }
      ]
    },
    "6": {
      "traducao_completa": "As tendas dos ladrões têm descanso, e os que provocam a Deus estão seguros; nas suas mãos Deus lhes põe tudo.",
