      ]
    },
    "2": {
      "traducao_completa": "Na verdade, vós sois o povo, e convosco morrerá a sabedoria.",
      "palavras": [
        { "hebraico": "אָ֭מְנָם", "transliteral": "ʾām-nām", "traducao_palavra": "Na verdade" },
        { "hebraico": "כִּ֣י", "transliteral": "kî", "traducao_palavra": "que" },
        { "hebraico": "אַתֶּם־", "transliteral": "ʾat-tem-", "traducao_palavra": "vós [sois]" },
        { "hebraico": "עָ֑ם", "transliteral": "ʿām", "traducao_palavra": "o povo" },
