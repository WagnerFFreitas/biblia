        { "hebraico": "מִכֶּ֑ם", "transliteral": "mik-kem", "traducao_palavra": "em relação a vós" },
        { "hebraico": "וְאֶת־", "transliteral": "wə-ʾeṯ-", "traducao_palavra": "e com" },
