        { "hebraico": "הֵ֣ן", "transliteral": "hên", "traducao_palavra": "Eis que" },
        { "hebraico": "יַ֭הֲרוֹס", "transliteral": "ya-hă-rō-ws", "traducao_palavra": "Ele derriba" },
        { "hebraico": "וְלֹ֣א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "יִבָּנֶ֑ה", "transliteral": "yib-bā-neh", "traducao_palavra": "se edifica" },
        { "hebraico": "יִסְגֹּ֥ר", "transliteral": "yis-gōr", "traducao_palavra": "Ele encerra" },
