        { "hebraico": "הֲלֹא־", "transliteral": "hă-lō-", "traducao_palavra": "Acaso não" },
        { "hebraico": "אֹ֭זֶן", "transliteral": "ʾō-zen", "traducao_palavra": "[o] ouvido" },
        { "hebraico": "מִלִּ֣ין", "transliteral": "mil-lîn", "traducao_palavra": "palavras" },
        { "hebraico": "תִּבְחָ֑ן", "transliteral": "tiḇ-ḥān", "traducao_palavra": "testará?" },
        { "hebraico": "וְ֝חֵ֗ךְ", "transliteral": "wə-ḥêḵ", "traducao_palavra": "e o paladar" },
