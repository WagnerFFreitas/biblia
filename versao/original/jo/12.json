        { "hebraico": "בַּמַּ֣יִם", "transliteral": "bam-ma-yim", "traducao_palavra": "nas águas" },
        { "hebraico": "וְיִיבָ֑שׁוּ", "transliteral": "wə-yî-ḇā-šû", "traducao_palavra": "e elas secam" },
