{
  "livro": "Jó - אִיּוֹב - ʾIy-yōḇ",
  "capítulo": 8,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Então respondeu Bildade, o suíta, e disse:",
      "palavras": [
        { "hebraico": "וַיַּ֥עַן", "transliteral": "way-ya-ʿan", "traducao_palavra": "Então respondeu" },
        { "hebraico": "בִּלְדַּ֥ד", "transliteral": "bil-daḏ", "traducao_palavra": "Bildade" },
        { "hebraico": "הַשּׁוּחִ֑י", "transliteral": "haš-šû-ḥî", "traducao_palavra": "o suíta" },
        { "hebraico": "וַיֹּאמַֽר׃", "transliteral": "way-yō-mar", "traducao_palavra": "e disse" }
      ]
    },
    "2": {
      "traducao_completa": "Até quando falarás tais coisas, e as palavras da tua boca serão como um vento impetuoso?",
      "palavras": [
        { "hebraico": "עַד־", "transliteral": "ʿaḏ-", "traducao_palavra": "Até" },
        { "hebraico": "אָ֥ן", "transliteral": "ʾān", "traducao_palavra": "onde/quando" },
        { "hebraico": "תְּמַלֶּל־", "transliteral": "tə-mal-lel-", "traducao_palavra": "falarás" },
        { "hebraico": "אֵ֑לֶּה", "transliteral": "ʾêl-leh", "traducao_palavra": "estas coisas" },
        { "hebraico": "וְר֨וּחַ", "transliteral": "wə-rû-aḥ", "traducao_palavra": "e [como] um vento" },
        { "hebraico": "כַּ֝בִּיר", "transliteral": "kab-bîr", "traducao_palavra": "impetuoso/poderoso" },
        { "hebraico": "אִמְרֵי־", "transliteral": "ʾim-rê-", "traducao_palavra": "[são] as palavras de" },
        { "hebraico": "פִֽיךָ׃", "transliteral": "p̄î-ḵā", "traducao_palavra": "tua boca" }
      ]
    },
    "3": {
      "traducao_completa": "Porventura perverteria Deus o direito, ou perverteria o Todo-Poderoso a justiça?",
      "palavras": [
        { "hebraico": "הַ֭אֵל", "transliteral": "ha-ʾêl", "traducao_palavra": "Acaso Deus" },
        { "hebraico": "יְעַוֵּ֣ת", "transliteral": "yə-ʿaw-wêṯ", "traducao_palavra": "perverteria" },
        { "hebraico": "מִשְׁפָּ֑ט", "transliteral": "miš-pāṭ", "traducao_palavra": "[o] direito" },
        { "hebraico": "וְאִם־", "transliteral": "wə-ʾim-", "traducao_palavra": "ou" },
        { "hebraico": "שַׁ֝דַּ֗י", "transliteral": "šad-day", "traducao_palavra": "[o] Todo-Poderoso" },
        { "hebraico": "יְעַוֵּֽת־", "transliteral": "yə-ʿaw-wêṯ-", "traducao_palavra": "perverteria" },
        { "hebraico": "צֶֽדֶק׃", "transliteral": "ṣe-ḏeq", "traducao_palavra": "[a] justiça" }
      ]
    },
    "4": {
      "traducao_completa": "Se teus filhos pecaram contra ele, também ele os lançou na mão da sua transgressão.",
      "palavras": [
        { "hebraico": "אִם־", "transliteral": "ʾim-", "traducao_palavra": "Se" },
        { "hebraico": "בָּנֶ֥יךָ", "transliteral": "bā-ney-ḵā", "traducao_palavra": "teus filhos" },
        { "hebraico": "חָטְאוּ־", "transliteral": "ḥā-ṭə-ʾū-", "traducao_palavra": "pecaram" },
        { "hebraico": "לֹ֑ו", "transliteral": "lô", "traducao_palavra": "contra Ele" },
        { "hebraico": "וַֽ֝יְשַׁלְּחֵ֗ם", "transliteral": "way-šal-lə-ḥêm", "traducao_palavra": "então os entregou/lançou" },
        { "hebraico": "בְּיַד־", "transliteral": "bə-yaḏ-", "traducao_palavra": "na mão de" },
        { "hebraico": "פִּשְׁעָֽם׃", "transliteral": "piš-ʿām", "traducao_palavra": "sua transgressão" }
      ]
    },
    "5": {
      "traducao_completa": "Se tu de madrugada buscares a Deus, e ao Todo-Poderoso pedires misericórdia;",
      "palavras": [
        { "hebraico": "אִם־", "transliteral": "ʾim-", "traducao_palavra": "Se" },
        { "hebraico": "אַ֭תָּה", "transliteral": "ʾat-tā", "traducao_palavra": "tu" },
        { "hebraico": "תְּשַׁחֵ֣ר", "transliteral": "tə-ša-ḥêr", "traducao_palavra": "buscares diligentemente" },
        { "hebraico": "אֶל־", "transliteral": "ʾel-", "traducao_palavra": "a" },
        { "hebraico": "אֵ֑ל", "transliteral": "ʾêl", "traducao_palavra": "Deus" },
        { "hebraico": "וְאֶל־", "transliteral": "wə-ʾel-", "traducao_palavra": "e para" },
        { "hebraico": "שַׁ֝דַּ֗י", "transliteral": "šad-day", "traducao_palavra": "[o] Todo-Poderoso" },
        { "hebraico": "תִּתְחַנָּֽן׃", "transliteral": "tiṯ-ḥan-nān", "traducao_palavra": "suplicares" }
      ]
    },
    "6": {
      "traducao_completa": "Se fores puro e reto, certamente logo despertará por ti, e restaurará a habitação da tua justiça.",
      "palavras": [
        { "hebraico": "אִם־", "transliteral": "ʾim-", "traducao_palavra": "Se" },
        { "hebraico": "זַ֥ךְ", "transliteral": "zaḵ", "traducao_palavra": "puro" },
        { "hebraico": "וְיָשָׁ֗ר", "transliteral": "wə-yā-šār", "traducao_palavra": "e reto" },
        { "hebraico": "אָ֥תָּה", "transliteral": "ʾāt-tā", "traducao_palavra": "[fores] tu" },
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "certamente" },
        { "hebraico": "עַתָּה֮", "transliteral": "ʿat-tā", "traducao_palavra": "agora" },
        { "hebraico": "יָעִ֪יר", "transliteral": "yā-ʿîr", "traducao_palavra": "Ele despertará" },
        { "hebraico": "עָ֫לֶ֥יךָ", "transliteral": "ʿā-ley-ḵā", "traducao_palavra": "por ti" },
        { "hebraico": "וְ֝שִׁלַּ֗ם", "transliteral": "wə-šil-lam", "traducao_palavra": "e restaurará/recompensará" },
        { "hebraico": "נְוַ֣ת", "transliteral": "nə-waṯ", "traducao_palavra": "a habitação de" },
        { "hebraico": "צִדְקֶֽךָ׃", "transliteral": "ṣiḏ-qe-ḵā", "traducao_palavra": "tua justiça" }
      ]
    },
    "7": {
      "traducao_completa": "E o teu princípio, na verdade, terá sido pequeno, mas o teu último estado crescerá sobremaneira.",
      "palavras": [
        { "hebraico": "וְהָיָ֖ה", "transliteral": "wə-hā-yā", "traducao_palavra": "E será" },
        { "hebraico": "רֵאשִׁיתְךָ֥", "transliteral": "rê-šî-ṯə-ḵā", "traducao_palavra": "teu princípio" },
        { "hebraico": "מִצְעָ֑ר", "transliteral": "miṣ-ʿār", "traducao_palavra": "pequeno" },
        { "hebraico": "וְ֝אַחֲרִיתְךָ֗", "transliteral": "wə-ʾa-ḥă-rî-ṯə-ḵā", "traducao_palavra": "mas o teu futuro/fim" },
        { "hebraico": "יִשְׂגֶּ֥ה", "transliteral": "yiś-geh", "traducao_palavra": "crescerá" },
        { "hebraico": "מְאֹֽד׃", "transliteral": "mə-ʾōḏ", "traducao_palavra": "muito" }
      ]
    },
    "8": {
      "traducao_completa": "Pois, pergunta agora às gerações passadas, e prepara-te para a inquirição de seus pais.",
      "palavras": [
        { "hebraico": "כִּי־", "transliteral": "kî-", "traducao_palavra": "Pois" },
        { "hebraico": "שְׁאַל־", "transliteral": "šə-ʾal-", "traducao_palavra": "pergunta" },
        { "hebraico": "נָ֭א", "transliteral": "nā", "traducao_palavra": "agora/rogo-te" },
        { "hebraico": "לְדֹ֣ר", "transliteral": "lə-ḏōr", "traducao_palavra": "à geração" },
        { "hebraico": "רִאשֹׁ֑ון", "transliteral": "ri-šō-wn", "traducao_palavra": "passada/anterior" },
        { "hebraico": "וְ֝כֹונֵ֗ן", "transliteral": "wə-ḵô-nên", "traducao_palavra": "e prepara-te" },
        { "hebraico": "לְחֵ֣קֶר", "transliteral": "lə-ḥê-qer", "traducao_palavra": "para a pesquisa de" },
        { "hebraico": "אֲבֹותָֽם׃", "transliteral": "ʾă-ḇô-ṯām", "traducao_palavra": "pais deles" }
      ]
    },
    "9": {
      "traducao_completa": "Porque nós somos de ontem, e nada sabemos; porquanto nossos dias sobre a terra são como a sombra.",
      "palavras": [
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "Porque" },
        { "hebraico": "תְ֭מֹול", "transliteral": "ṯə-môl", "traducao_palavra": "[de] ontem" },
        { "hebraico": "אֲנַ֣חְנוּ", "transliteral": "ʾă-naḥ-nū", "traducao_palavra": "[somos] nós" },
        { "hebraico": "וְלֹ֣א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "נֵדָ֑ע", "transliteral": "nê-ḏāʿ", "traducao_palavra": "sabemos" },
        { "hebraico": "כִּ֤i", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "צֵ֖ל", "transliteral": "ṣêl", "traducao_palavra": "[como] sombra" },
        { "hebraico": "יָמֵ֣ינוּ", "transliteral": "yā-mê-nū", "traducao_palavra": "nossos dias" },
        { "hebraico": "עֲלֵי־", "transliteral": "ʿă-lê-", "traducao_palavra": "sobre" },
        { "hebraico": "אָֽרֶץ׃", "transliteral": "ʾā-reṣ", "traducao_palavra": "a terra" }
      ]
    },
    "10": {
      "traducao_completa": "Porventura não te ensinarão eles, e não te falarão, e do seu coração não tirarão palavras?",
