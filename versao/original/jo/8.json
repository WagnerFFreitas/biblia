    "11": {
      "traducao_completa": "Porventura cresce o junco sem lodo? Ou cresce a espadana sem água?",
      "palavras": [
        { "hebraico": "הֲיִגְאֶה־", "transliteral": "hă-yiḡ-ʾeh-", "traducao_palavra": "Acaso cresce" },
        { "hebraico": "גֹּמֶא", "transliteral": "ḡō-me", "traducao_palavra": "o junco" },
        { "hebraico": "בְּלִ֧י", "transliteral": "bə-lî", "traducao_palavra": "sem" },
        { "hebraico": "בִצָּ֛ה", "transliteral": "ḇiṣ-ṣā", "traducao_palavra": "pântano/lodo" },
        { "hebraico": "יִשְׂגֶּה־", "transliteral": "yiś-geh-", "traducao_palavra": "ou cresce" },
        { "hebraico": "אָ֥חוּ", "transliteral": "ʾā-ḥû", "traducao_palavra": "a espadana" },
        { "hebraico": "בְלִי־", "transliteral": "ḇə-lî-", "traducao_palavra": "sem" },
        { "hebraico": "מָֽיִם׃", "transliteral": "mā-yim", "traducao_palavra": "água" }
      ]
    },
    "12": {
      "traducao_completa": "Estando ainda no seu vigor, e sem ser cortada, seca-se antes de qualquer outra erva.",
