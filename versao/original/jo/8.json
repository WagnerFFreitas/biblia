        { "hebraico": "וְלִפְנֵ֖י", "transliteral": "wə-lip̄-nê", "traducao_palavra": "mas antes de" },
        { "hebraico": "כָל־", "transliteral": "ḵāl-", "traducao_palavra": "toda" },
        { "hebraico": "חָצִ֣יר", "transliteral": "ḥā-ṣîr", "traducao_palavra": "erva" },
        { "hebraico": "יִיבָֽשׁ׃", "transliteral": "yî-ḇāš", "traducao_palavra": "seca-se" }
      ]
    },
    "13": {
      "traducao_completa": "Tais são as veredas de todos os que se esquecem de Deus; e a esperança do hipócrita perecerá.",
