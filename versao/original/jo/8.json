      ]
    },
    "15": {
      "traducao_completa": "Encostar-se-á à sua casa, e ela não subsistirá; agarrar-se-á a ela, e ela não ficará em pé.",
      "palavras": [
        { "hebraico": "יִשָּׁעֵ֣ן", "transliteral": "yiš-śā-ʿên", "traducao_palavra": "Encostar-se-á" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre" },
        { "hebraico": "בֵּ֭יתֹו", "transliteral": "bê-ṯô", "traducao_palavra": "sua casa" },
        { "hebraico": "וְלֹ֣א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "יַעֲמֹ֑ד", "transliteral": "ya-ʿă-mōḏ", "traducao_palavra": "permanecerá" },
        { "hebraico": "יַחֲזִ֥יק", "transliteral": "ya-ḥă-zîq", "traducao_palavra": "agarrar-se-á" },
        { "hebraico": "בֹּ֝ו", "transliteral": "bô", "traducao_palavra": "nela" },
        { "hebraico": "וְלֹ֣א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "יָקֽוּם׃", "transliteral": "yā-qûm", "traducao_palavra": "se levantará" }
      ]
    },
    "16": {
      "traducao_completa": "Ele é viçoso perante o sol, e os seus renovos saem sobre o seu jardim;",
      "palavras": [
        { "hebraico": "רָטֹ֣ב", "transliteral": "rā-ṭōḇ", "traducao_palavra": "Viçoso/Úmido" },
        { "hebraico": "ה֭וּא", "transliteral": "hū", "traducao_palavra": "ele [está]" },
        { "hebraico": "לִפְנֵי־", "transliteral": "lip̄-nê-", "traducao_palavra": "diante de" },
        { "hebraico": "שָׁ֑מֶשׁ", "transliteral": "šā-meš", "traducao_palavra": "[o] sol" },
        { "hebraico": "וְעַ֥ל", "transliteral": "wə-ʿal", "traducao_palavra": "e sobre" },
