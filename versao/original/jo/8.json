        { "hebraico": "כֵּ֗ן", "transliteral": "kên", "traducao_palavra": "Assim [são]" },
        { "hebraico": "אָרְחֹ֥ות", "transliteral": "ʾā-rə-ḥô-wṯ", "traducao_palavra": "as veredas de" },
        { "hebraico": "כָּל־", "transliteral": "kāl-", "traducao_palavra": "todos" },
        { "hebraico": "שֹׁ֪כְחֵ֫י", "transliteral": "šō-ḵə-ḥê", "traducao_palavra": "os que se esquecem de" },
        { "hebraico": "אֵ֥ל", "transliteral": "ʾêl", "traducao_palavra": "Deus" },
        { "hebraico": "וְתִקְוַ֖ת", "transliteral": "wə-ṯiq-waṯ", "traducao_palavra": "e a esperança de" },
        { "hebraico": "חָנֵ֣ף", "transliteral": "ḥā-nêp̄", "traducao_palavra": "um hipócrita/profano" },
        { "hebraico": "תֹּאבֵֽד׃", "transliteral": "tō-ʾḇêḏ", "traducao_palavra": "perecerá" }
      ]
    },
    "14": {
      "traducao_completa": "A sua confiança será cortada, e a sua esperança será como uma teia de aranha.",
      "palavras": [
        { "hebraico": "אֲשֶׁر־", "transliteral": "ʾă-šer-", "traducao_palavra": "Cujo" },
        { "hebraico": "יָקֹ֥וט", "transliteral": "yā-qô-wṭ", "traducao_palavra": "será cortado" },
        { "hebraico": "כִּסְלֹ֑ו", "transliteral": "kis-lô", "traducao_palavra": "a confiança dele" },
        { "hebraico": "וּבֵ֥ית", "transliteral": "ū-ḇêṯ", "traducao_palavra": "e a casa de" },
        { "hebraico": "עַ֝כָּבִ֗ישׁ", "transliteral": "ʿak-kā-ḇîš", "traducao_palavra": "aranha" },
