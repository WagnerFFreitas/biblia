        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "Sobre" },
        { "hebraico": "גַּ֭ל", "transliteral": "gal", "traducao_palavra": "um monte" },
        { "hebraico": "שָׁרָשָׁ֣יו", "transliteral": "šā-rā-šāyw", "traducao_palavra": "suas raízes" },
        { "hebraico": "יְסֻבָּ֑כוּ", "transliteral": "yə-śub-bā-ḵû", "traducao_palavra": "entrelaçam-se" },
        { "hebraico": "בֵּ֖ית", "transliteral": "bêṯ", "traducao_palavra": "casa de" },
        { "hebraico": "אֲבָנִ֣ים", "transliteral": "ʾă-ḇā-nîm", "traducao_palavra": "pedras" },
        { "hebraico": "יֶחֱזֶֽה׃", "transliteral": "ye-ḥĕ-zeh", "traducao_palavra": "vê/olha" }
