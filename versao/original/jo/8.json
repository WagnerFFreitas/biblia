        { "hebraico": "הֲלֹא־", "transliteral": "hă-lō-", "traducao_palavra": "Acaso não" },
        { "hebraico": "הֵ֣ם", "transliteral": "hêm", "traducao_palavra": "eles" },
        { "hebraico": "יֹור֤וּךָ", "transliteral": "yô-rû-ḵā", "traducao_palavra": "te ensinarão" },
        { "hebraico": "יֹאמְר֣וּ", "transliteral": "yō-mə-rû", "traducao_palavra": "falarão" },
        { "hebraico": "לָ֑ךְ", "transliteral": "lāḵ", "traducao_palavra": "a ti" },
        { "hebraico": "וּ֝מִלִּבָּ֗ם", "transliteral": "ū-mil-lib-bām", "traducao_palavra": "e do coração deles" },
        { "hebraico": "יֹוצִ֥יאוּ", "transliteral": "yô-ṣî-ʾū", "traducao_palavra": "tirarão" },
