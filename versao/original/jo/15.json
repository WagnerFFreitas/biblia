        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "יִסְכֹּ֑ון", "transliteral": "yis-kō-wn", "traducao_palavra": "serve/aproveita" },
        { "hebraico": "וּ֝מִלִּ֗ים", "transliteral": "ū-mil-lîm", "traducao_palavra": "e palavras [que]" },
