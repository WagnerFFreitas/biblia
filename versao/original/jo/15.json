      "palavras": [
        { "hebraico": "אַף־", "transliteral": "ʾap̄-", "traducao_palavra": "Sim/Até" },
        { "hebraico": "אַ֭תָּה", "transliteral": "ʾat-tā", "traducao_palavra": "tu" },
        { "hebraico": "תָּפֵ֣ר", "transliteral": "tā-p̄êr", "traducao_palavra": "anulas/destróis" },
        { "hebraico": "יִרְאָ֑ה", "transliteral": "yir-ʾā", "traducao_palavra": "[o] temor" },
        { "hebraico": "וְתִגְרַ֥ע", "transliteral": "wə-ṯiḡ-raʿ", "traducao_palavra": "e retiras/diminuis" },
