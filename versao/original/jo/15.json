        { "hebraico": "יַאֲמִ֑ין", "transliteral": "ya-ʾă-mîn", "traducao_palavra": "confia" },
        { "hebraico": "וְ֝שָׁמַ֗יִם", "transliteral": "wə-šā-ma-yim", "traducao_palavra": "e os céus" },
