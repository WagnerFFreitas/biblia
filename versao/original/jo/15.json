        { "hebraico": "וְנֶאֱלָ֑ח", "transliteral": "wə-ne-ʾĕ-lāḥ", "traducao_palavra": "e corrupto" },
        { "hebraico": "אִ֥ישׁ", "transliteral": "ʾîš", "traducao_palavra": "o homem" },
