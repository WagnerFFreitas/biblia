        { "hebraico": "לְבַדָּ֑ם", "transliteral": "lə-ḇad-dām", "traducao_palavra": "somente" },
        { "hebraico": "נִתְּנָ֣ה", "transliteral": "nit-tə-nā", "traducao_palavra": "foi dada" },
