      ]
    },
    "20": {
      "traducao_completa": "Todos os dias o ímpio é atormentado, e o número de anos é reservado para o tirano.",
      "palavras": [
        { "hebraico": "כָּל־", "transliteral": "kāl-", "traducao_palavra": "Todos os" },
        { "hebraico": "יְמֵ֣י", "transliteral": "yə-mê", "traducao_palavra": "dias de" },
        { "hebraico": "רָ֭שָׁע", "transliteral": "rā-šāʿ", "traducao_palavra": "[o] ímpio" },
        { "hebraico": "ה֣וּא", "transliteral": "hû", "traducao_palavra": "ele" },
        { "hebraico": "מִתְחֹולֵ֑ל", "transliteral": "miṯ-ḥô-w-lêl", "traducao_palavra": "se atormenta/sofre dores" },
        { "hebraico": "וּמִסְפַּ֥ר", "transliteral": "ū-mis-par", "traducao_palavra": "e o número de" },
        { "hebraico": "שָׁ֝נִ֗ים", "transliteral": "šā-nîm", "traducao_palavra": "anos" },
        { "hebraico": "נִצְפְּנ֥וּ", "transliteral": "niṣ-pə-nû", "traducao_palavra": "[estão] reservados" },
        { "hebraico": "לֶעָרִֽיץ׃", "transliteral": "le-ʿā-rîṣ", "traducao_palavra": "para o tirano" }
      ]
    },
    "21": {
      "traducao_completa": "O som dos horrores está nos seus ouvidos; na prosperidade lhe sobrevirá o assolador.",
      "palavras": [
        { "hebraico": "קֹול־", "transliteral": "qô-wl-", "traducao_palavra": "O som de" },
        { "hebraico": "פְּחָדִ֥ים", "transliteral": "pə-ḥā-ḏîm", "traducao_palavra": "terrores" },
        { "hebraico": "בְּאָזְנָ֑יו", "transliteral": "bə-ʾāz-nāyw", "traducao_palavra": "[está] nos seus ouvidos" },
        { "hebraico": "בַּ֝שָּׁלֹ֗ום", "transliteral": "baš-šā-lôm", "traducao_palavra": "na paz/prosperidade" },
        { "hebraico": "שֹׁודֵ֥ד", "transliteral": "šô-w-ḏêḏ", "traducao_palavra": "[o] assolador" },
        { "hebraico": "יְבֹואֶֽנּוּ׃", "transliteral": "yə-ḇô-ʾen-nû", "traducao_palavra": "virá sobre ele" }
      ]
    },
    "22": {
      "traducao_completa": "Não crê que tornará das trevas, mas que está reservado para a espada.",
      "palavras": [
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "Não" },
        { "hebraico": "יַאֲמִ֥ין", "transliteral": "ya-ʾă-mîn", "traducao_palavra": "ele crê" },
        { "hebraico": "שׁ֣וּב", "transliteral": "šûḇ", "traducao_palavra": "em voltar" },
        { "hebraico": "מִנִּי־", "transliteral": "min-nî-", "traducao_palavra": "das" },
        { "hebraico": "חֹ֑שֶׁךְ", "transliteral": "ḥō-šeḵ", "traducao_palavra": "trevas" },
        { "hebraico": "וְצָפוּ", "transliteral": "wə-ṣā-p̄û", "traducao_palavra": "e está reservado" },
        { "hebraico": "ה֝וּא", "transliteral": "hû", "traducao_palavra": "ele" },
        { "hebraico": "אֱלֵי־", "transliteral": "ʾĕ-lê-", "traducao_palavra": "para" },
        { "hebraico": "חָֽרֶב׃", "transliteral": "ḥā-reḇ", "traducao_palavra": "[a] espada" }
      ]
    },
    "23": {
      "traducao_completa": "Anda vagueando por pão, dizendo: Onde está? Sabe que o dia das trevas lhe está próximo, à mão.",
      "palavras": [
        { "hebraico": "נֹ֘דֵ֤ד", "transliteral": "nō-ḏêḏ", "traducao_palavra": "Vagueia" },
        { "hebraico": "ה֣וּא", "transliteral": "hû", "traducao_palavra": "ele" },
        { "hebraico": "לַלֶּ֣חֶם", "transliteral": "lal-le-ḥem", "traducao_palavra": "por pão" },
        { "hebraico": "אַיֵּ֑ה", "transliteral": "ʾay-yê", "traducao_palavra": "Onde [está]?" },
        { "hebraico": "יָ֝דַ֗ע", "transliteral": "yā-ḏaʿ", "traducao_palavra": "Sabe" },
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "que" },
        { "hebraico": "נָכֹ֥ון", "transliteral": "nā-ḵō-wn", "traducao_palavra": "está pronto/preparado" },
        { "hebraico": "בְּיָדֹ֧ו", "transliteral": "bə-yā-ḏô", "traducao_palavra": "na sua mão" },
        { "hebraico": "יֹום־", "transliteral": "yô-wm-", "traducao_palavra": "o dia de" },
        { "hebraico": "חֹֽשֶׁךְ׃", "transliteral": "ḥō-šeḵ", "traducao_palavra": "trevas" }
      ]
    },
    "24": {
      "traducao_completa": "Angústia e tribulação o assombram; prevalecem contra ele, como o rei preparado para a peleja.",
      "palavras": [
        { "hebraico": "יְבַעֲתֻ֥הוּ", "transliteral": "yə-ḇa-ʿă-ṯu-hū", "traducao_palavra": "Aterrorizam-no" },
        { "hebraico": "צַ֣ר", "transliteral": "ṣar", "traducao_palavra": "[a] angústia" },
        { "hebraico": "וּמְצוּקָ֑ה", "transliteral": "ū-mə-ṣû-qā", "traducao_palavra": "e a tribulação" },
        { "hebraico": "תִּ֝תְקְפֵ֗הוּ", "transliteral": "tiṯ-qə-p̄ê-hū", "traducao_palavra": "prevalecem contra ele" },
        { "hebraico": "כְּמֶ֥לֶךְ", "transliteral": "kə-me-leḵ", "traducao_palavra": "como um rei" },
        { "hebraico": "עָ֝תִ֗יד", "transliteral": "ʿā-ṯîḏ", "traducao_palavra": "pronto" },
        { "hebraico": "לַכִּידֹֽור׃", "transliteral": "lak-kî-ḏôr", "traducao_palavra": "para a peleja/ataque" }
      ]
    },
    "25": {
      "traducao_completa": "Porque estendeu a sua mão contra Deus, e contra o Todo-Poderoso se portou com soberba.",
      "palavras": [
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "Porque" },
        { "hebraico": "נָטָ֣ה", "transliteral": "nā-ṭā", "traducao_palavra": "estendeu" },
        { "hebraico": "אֶל־", "transliteral": "ʾel-", "traducao_palavra": "contra" },
        { "hebraico": "אֵ֣ל", "transliteral": "ʾêl", "traducao_palavra": "Deus" },
        { "hebraico": "יָדֹ֑ו", "transliteral": "yā-ḏô", "traducao_palavra": "sua mão" },
        { "hebraico": "וְאֶל־", "transliteral": "wə-ʾel-", "traducao_palavra": "e contra" },
        { "hebraico": "שַׁ֝דַּ֗י", "transliteral": "šad-day", "traducao_palavra": "o Todo-Poderoso" },
        { "hebraico": "יִתְגַּבָּֽר׃", "transliteral": "yiṯ-gab-bār", "traducao_palavra": "se portou com soberba/desafiou" }
      ]
    },
    "26": {
      "traducao_completa": "Arremete contra ele com dura cerviz, e com as peças espessas dos seus escudos.",
      "palavras": [
        { "hebraico": "יָר֣וּץ", "transliteral": "yā-rûṣ", "traducao_palavra": "Corre" },
        { "hebraico": "אֵלָ֣יו", "transliteral": "ʾê-lāyw", "traducao_palavra": "contra Ele" },
        { "hebraico": "בְּצַוָּ֑אר", "transliteral": "bə-ṣaw-wār", "traducao_palavra": "com a cerviz [erguida]" },
        { "hebraico": "בַּ֝עֲבִ֗י", "transliteral": "ba-ʿă-ḇî", "traducao_palavra": "com a espessura de" },
        { "hebraico": "גַּבֵּ֥i", "transliteral": "gab-bê", "traducao_palavra": "as costas/chefes de" },
        { "hebraico": "מָגִנָּֽיו׃", "transliteral": "mā-ḡin-nāyw", "traducao_palavra": "seus escudos" }
      ]
    },
    "27": {
      "traducao_completa": "Porquanto cobriu o seu rosto com a sua gordura, e criou gordura nos seus lombos.",
      "palavras": [
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "Porque" },
        { "hebraico": "כִסָּ֣ה", "transliteral": "ḵis-śā", "traducao_palavra": "cobriu" },
        { "hebraico": "פָנָ֣יו", "transliteral": "p̄ā-nāyw", "traducao_palavra": "seu rosto" },
        { "hebraico": "בְּחֶלְבֹּ֑ו", "transliteral": "bə-ḥel-bô", "traducao_palavra": "com sua gordura" },
        { "hebraico": "וַיַּ֥עַשׂ", "transliteral": "way-ya-ʿaś", "traducao_palavra": "e acumulou" },
        { "hebraico": "פִּ֝ימָ֗ה", "transliteral": "pî-mā", "traducao_palavra": "gordura" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre" },
        { "hebraico": "כִּסְלָֽה׃", "transliteral": "kis-lā", "traducao_palavra": "[os] lombos" }
      ]
    },
    "28": {
      "traducao_completa": "E habitou em cidades assoladas, em casas em que ninguém morava, que estavam prontas para se tornarem em montões de ruínas.",
      "palavras": [
        { "hebraico": "וַיִּשְׁכֹּ֤ון ׀", "transliteral": "way-yiš-kōn", "traducao_palavra": "E habitou" },
        { "hebraico": "עָרִ֣ים", "transliteral": "ʿā-rîm", "traducao_palavra": "[em] cidades" },
        { "hebraico": "נִכְחָדֹ֑ות", "transliteral": "niḵ-ḥā-ḏô-wṯ", "traducao_palavra": "destruídas/assoladas" },
        { "hebraico": "בָּתִּים֙", "transliteral": "bāt-tîm", "traducao_palavra": "[em] casas" },
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "יֵ֣שְׁבוּ", "transliteral": "yê-šə-ḇū", "traducao_palavra": "habitadas" },
        { "hebraico": "לָ֦מֹו", "transliteral": "lā-mô", "traducao_palavra": "nelas" },
        { "hebraico": "אֲשֶׁ֥ר", "transliteral": "ʾă-šer", "traducao_palavra": "que" },
        { "hebraico": "הִתְעַתְּד֖וּ", "transliteral": "hiṯ-ʿat-tə-ḏû", "traducao_palavra": "estavam destinadas" },
        { "hebraico": "לְגַלִּֽים׃", "transliteral": "lə-ḡal-lîm", "traducao_palavra": "a montões de ruínas" }
      ]
    },
    "29": {
      "traducao_completa": "Não se enriquecerá, nem subsistirá a sua fazenda, nem se estenderão pela terra as suas possessões.",
      "palavras": [
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "Não" },
        { "hebraico": "יֶעְשַׁ֥ר", "transliteral": "ye-ʿə-šar", "traducao_palavra": "se enriquecerá" },
        { "hebraico": "וְלֹא־", "transliteral": "wə-lō-", "traducao_palavra": "e não" },
        { "hebraico": "יָק֣וּם", "transliteral": "yā-qûm", "traducao_palavra": "subsistirá" },
        { "hebraico": "חֵילֹ֑ו", "transliteral": "ḥê-lô", "traducao_palavra": "sua riqueza" },
        { "hebraico": "וְלֹֽא־", "transliteral": "wə-lō-", "traducao_palavra": "e não" },
        { "hebraico": "יִטֶּ֥ה", "transliteral": "yiṭ-ṭeh", "traducao_palavra": "se estenderá" },
        { "hebraico": "לָאָ֧רֶץ", "transliteral": "lā-ʾā-reṣ", "traducao_palavra": "na terra" },
        { "hebraico": "מִנְלָֽם׃", "transliteral": "min-lām", "traducao_palavra": "a possessão deles" }
      ]
    },
    "30": {
      "traducao_completa": "Não escapará das trevas; a chama secará os seus renovos, e ao sopro da sua boca se irá.",
      "palavras": [
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "Não" },
        { "hebraico": "יָס֥וּר", "transliteral": "yā-śûr", "traducao_palavra": "se afastará" },
        { "hebraico": "מִנִּי־", "transliteral": "min-nî-", "traducao_palavra": "das" },
        { "hebraico": "חֹ֑שֶׁךְ", "transliteral": "ḥō-šeḵ", "traducao_palavra": "trevas" },
        { "hebraico": "יֹונַקְתֹּו֙", "transliteral": "yō-w-naq-tô", "traducao_palavra": "seu renovo" },
        { "hebraico": "תְּיַבֵּ֣שׁ", "transliteral": "tə-yab-bêš", "traducao_palavra": "secará" },
        { "hebraico": "לֶהָבָ֔ה", "transliteral": "le-hā-ḇā", "traducao_palavra": "[a] chama" },
        { "hebraico": "וְיָס֖וּר", "transliteral": "wə-yā-śûr", "traducao_palavra": "e passará/irá" },
        { "hebraico": "בְּר֥וּחַ", "transliteral": "bə-rû-aḥ", "traducao_palavra": "pelo sopro de" },
        { "hebraico": "פִּֽיו׃", "transliteral": "pî-w", "traducao_palavra": "Sua boca" }
      ]
    },
    "31": {
      "traducao_completa": "Não confie, pois, na vaidade, enganando-se a si mesmo, porque a vaidade será a sua recompensa.",
      "palavras": [
        { "hebraico": "אַל־", "transliteral": "ʾal-", "traducao_palavra": "Não" },
        { "hebraico": "יַאֲמֵ֣ן", "transliteral": "ya-ʾă-mên", "traducao_palavra": "confie" },
        { "hebraico": "בַּשָּׁוְא", "transliteral": "baš-šā-wə", "traducao_palavra": "na vaidade" },
        { "hebraico": "נִתְעָ֑ה", "transliteral": "niṯ-ʿā", "traducao_palavra": "[o] enganado" },
        { "hebraico": "כִּי־", "transliteral": "kî-", "traducao_palavra": "porque" },
        { "hebraico": "שָׁ֝֗וְא", "transliteral": "šā-wə", "traducao_palavra": "[a] vaidade" },
        { "hebraico": "תִּהְיֶ֥ה", "transliteral": "tih-yeh", "traducao_palavra": "será" },
        { "hebraico": "תְמוּרָתֹֽו׃", "transliteral": "ṯə-mû-rā-ṯô", "traducao_palavra": "sua recompensa" }
      ]
    },
    "32": {
      "traducao_completa": "Antes do seu dia ela se cumprirá, e o seu ramo não reverdecerá.",
      "palavras": [
        { "hebraico": "בְּלֹא־", "transliteral": "bə-lō-", "traducao_palavra": "Antes de" },
        { "hebraico": "יֹומֹ֥ו", "transliteral": "yô-wmô", "traducao_palavra": "seu dia" },
        { "hebraico": "תִּמָּלֵ֑א", "transliteral": "tim-mā-lê", "traducao_palavra": "se cumprirá" },
        { "hebraico": "וְ֝כִפָּתֹ֗ו", "transliteral": "wə-ḵip-pā-ṯô", "traducao_palavra": "e seu ramo" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "רַעֲנָֽנָה׃", "transliteral": "ra-ʿă-nā-nā", "traducao_palavra": "[será] verde" }
      ]
    },
    "33": {
      "traducao_completa": "Sacudirá as suas uvas verdes como a vide, e lançará a sua flor como a oliveira.",
      "palavras": [
        { "hebraico": "יַחְמֹ֣ס", "transliteral": "ya-ḥmōs", "traducao_palavra": "Sacudirá/Despojará" },
        { "hebraico": "כַגֶּ֣פֶן", "transliteral": "ḵag-ge-p̄en", "traducao_palavra": "como a videira" },
        { "hebraico": "בִּסְרֹ֑ו", "transliteral": "bis-rô", "traducao_palavra": "suas uvas verdes" },
        { "hebraico": "וְיַשְׁלֵ֥ךְ", "transliteral": "wə-yaš-lêḵ", "traducao_palavra": "e lançará" },
        { "hebraico": "כַּ֝זַּ֗יִת", "transliteral": "kaz-za-yit", "traducao_palavra": "como a oliveira" },
        { "hebraico": "נִצָּתֹֽו׃", "transliteral": "niṣ-ṣā-ṯô", "traducao_palavra": "sua flor" }
      ]
    },
    "34": {
      "traducao_completa": "Porque a congregação dos hipócritas se fará estéril, e o fogo consumirá as tendas de suborno.",
      "palavras": [
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "Porque" },
        { "hebraico": "עֲדַ֣ת", "transliteral": "ʿă-ḏaṯ", "traducao_palavra": "a congregação de" },
        { "hebraico": "חָנֵ֣ף", "transliteral": "ḥā-nêp̄", "traducao_palavra": "hipócritas" },
        { "hebraico": "גַּלְמ֑וּד", "transliteral": "ḡal-mûḏ", "traducao_palavra": "[será] estéril" },
        { "hebraico": "וְ֝אֵ֗שׁ", "transliteral": "wə-ʾêš", "traducao_palavra": "e o fogo" },
        { "hebraico": "אָכְלָ֥ה", "transliteral": "ʾā-ḵəlā", "traducao_palavra": "comerá/consumirá" },
        { "hebraico": "אָהֳלֵי־", "transliteral": "ʾo-hŏ-lê-", "traducao_palavra": "as tendas de" },
        { "hebraico": "שֹֽׁחַד׃", "transliteral": "šō-ḥaḏ", "traducao_palavra": "suborno" }
      ]
    },
    "35": {
      "traducao_completa": "Concebem o mal, e dão à luz a iniquidade, e o seu ventre prepara o engano.",
      "palavras": [
        { "hebraico": "הָרֹ֤ה", "transliteral": "hā-rōh", "traducao_palavra": "Concebem" },
