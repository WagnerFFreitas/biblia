        { "hebraico": "ר֑וּחַ", "transliteral": "rû-aḥ", "traducao_palavra": "vento" },
        { "hebraico": "וִימַלֵּ֖i", "transliteral": "wî-mal-lê", "traducao_palavra": "e encheria" },
