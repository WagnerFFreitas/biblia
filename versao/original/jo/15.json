        { "hebraico": "נֵדָ֑ע", "transliteral": "nê-ḏāʿ", "traducao_palavra": "saibamos [nós]?" },
        { "hebraico": "תָּ֝בִ֗ין", "transliteral": "tā-ḇîn", "traducao_palavra": "[O que] entendes" },
