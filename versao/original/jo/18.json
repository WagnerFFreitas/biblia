{
  "livro": "Jó - אִיּוֹב - ʾIy-yōḇ",
  "capítulo": 18,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Então respondeu Bildade, o suíta, e disse:",
      "palavras": [
        { "hebraico": "וַיַּ֥עַן", "transliteral": "way-ya-ʿan", "traducao_palavra": "Então respondeu" },
        { "hebraico": "בִּלְדַּ֥ד", "transliteral": "bil-daḏ", "traducao_palavra": "Bildade" },
        { "hebraico": "הַשּׁוּחִ֑י", "transliteral": "haš-šū-ḥî", "traducao_palavra": "o suíta" },
        { "hebraico": "וַיֹּאמַֽר׃", "transliteral": "way-yō-mar", "traducao_palavra": "e disse" }
      ]
    },
    "2": {
      "traducao_completa": "Até quando estareis pondo fim às palavras? Entendei bem, e então falaremos.",
      "palavras": [
        { "hebraico": "עַד־", "transliteral": "ʿaḏ-", "traducao_palavra": "Até" },
        { "hebraico": "אָ֭ן", "transliteral": "ʾān", "traducao_palavra": "quando" },
        { "hebraico": "תְּשִׂימ֣וּן", "transliteral": "tə-śî-mūn", "traducao_palavra": "poreis" },
        { "hebraico": "קִנְצֵ֣י", "transliteral": "qin-ṣê", "traducao_palavra": "fim/limites" },
        { "hebraico": "לְמִלִּ֑ין", "transliteral": "lə-mil-lîn", "traducao_palavra": "às palavras" },
        { "hebraico": "תָּ֝בִ֗ינוּ", "transliteral": "tā-ḇî-nū", "traducao_palavra": "entendei" },
        { "hebraico": "וְאַחַ֥ר", "transliteral": "wə-ʾa-ḥar", "traducao_palavra": "e depois" },
        { "hebraico": "נְדַבֵּֽר׃", "transliteral": "nə-ḏab-bêr", "traducao_palavra": "falaremos" }
      ]
    },
    "3": {
      "traducao_completa": "Por que somos tratados como animais, e passamos por estultos aos vossos olhos?",
      "palavras": [
        { "hebraico": "מַדּ֥וּעַ", "transliteral": "mad-dū-aʿ", "traducao_palavra": "Por que" },
        { "hebraico": "נֶחְשַׁבְנּוּ", "transliteral": "neḥ-šaḇ-nū", "traducao_palavra": "fomos considerados" },
        { "hebraico": "כַבְּהֵמָ֑ה", "transliteral": "ḵa-bə-hê-mā", "traducao_palavra": "como animal" },
        { "hebraico": "נִ֝טְמִ֗ינוּ", "transliteral": "niṭ-mî-nū", "traducao_palavra": "[e] fomos feitos impuros/estultos" },
        { "hebraico": "בְּעֵינֵיכֶֽם׃", "transliteral": "bə-ʿê-nê-ḵem", "traducao_palavra": "aos vossos olhos?" }
      ]
    },
    "4": {
      "traducao_completa": "Oh tu, que despedaças a tua alma na tua ira, será a terra abandonada por tua causa? Ou remover-se-á a rocha do seu lugar?",
      "palavras": [
        { "hebraico": "טֹרֵ֥ף", "transliteral": "ṭō-rêp̄", "traducao_palavra": "[Aquele que] despedaça" },
        { "hebraico": "נַפְשֹׁ֗ו", "transliteral": "nap̄-šô", "traducao_palavra": "sua alma" },
        { "hebraico": "בְּאַ֫פֹּ֥ו", "transliteral": "bə-ʾap-pô", "traducao_palavra": "na sua ira" },
        { "hebraico": "הַלְמַעֲנְךָ֮", "transliteral": "hal-ma-ʿă-nə-ḵā", "traducao_palavra": "acaso por tua causa" },
        { "hebraico": "תֵּעָזַ֪ב", "transliteral": "tê-ʿā-zaḇ", "traducao_palavra": "seria abandonada" },
        { "hebraico": "אָ֥רֶץ", "transliteral": "ʾā-reṣ", "traducao_palavra": "[a] terra?" },
        { "hebraico": "וְיֶעְתַּק־", "transliteral": "wə-yeʿ-taq-", "traducao_palavra": "e seria removida" },
        { "hebraico": "צ֝֗וּר", "transliteral": "ṣûr", "traducao_palavra": "[a] rocha" },
        { "hebraico": "מִמְּקֹמֹֽו׃", "transliteral": "mim-mə-qō-mô", "traducao_palavra": "do seu lugar?" }
      ]
    },
    "5": {
      "traducao_completa": "Na verdade, a luz dos ímpios se apagará, e a faísca do seu fogo não resplandecerá.",
      "palavras": [
        { "hebraico": "גַּ֣ם", "transliteral": "gam", "traducao_palavra": "Sim/Também" },
        { "hebraico": "אֹ֣ור", "transliteral": "ʾôr", "traducao_palavra": "[a] luz de" },
        { "hebraico": "רְשָׁעִ֣ים", "transliteral": "rə-šā-ʿîm", "traducao_palavra": "[os] ímpios" },
        { "hebraico": "יִדְעָ֑ךְ", "transliteral": "yiḏ-ʿāḵ", "traducao_palavra": "se apagará" },
        { "hebraico": "וְלֹֽא־", "transliteral": "wə-lō-", "traducao_palavra": "e não" },
        { "hebraico": "יִ֝גַּ֗הּ", "transliteral": "yig-gah", "traducao_palavra": "brilhará" },
        { "hebraico": "שְׁבִ֣יב", "transliteral": "šə-ḇîḇ", "traducao_palavra": "a faísca de" },
        { "hebraico": "אִשֹּֽׁו׃", "transliteral": "ʾiš-šô", "traducao_palavra": "seu fogo" }
      ]
    },
    "6": {
      "traducao_completa": "A luz se escurecerá na sua tenda, e a sua lâmpada sobre ele se apagará.",
      "palavras": [
        { "hebraico": "אֹ֭ור", "transliteral": "ʾôr", "traducao_palavra": "[A] luz" },
        { "hebraico": "חָשַׁ֣ךְ", "transliteral": "ḥā-šaḵ", "traducao_palavra": "se escurece" },
        { "hebraico": "בְּאָהֳלֹ֑ו", "transliteral": "bə-ʾā-hŏ-lô", "traducao_palavra": "na tenda dele" },
        { "hebraico": "וְ֝נֵרֹ֗ו", "transliteral": "wə-nê-rô", "traducao_palavra": "e a sua lâmpada" },
        { "hebraico": "עָלָ֥יו", "transliteral": "ʿā-lāyw", "traducao_palavra": "sobre ele" },
        { "hebraico": "יִדְעָֽךְ׃", "transliteral": "yiḏ-ʿāḵ", "traducao_palavra": "se apagará" }
      ]
    },
    "7": {
      "traducao_completa": "Os seus passos vigorosos se estreitarão, e o seu próprio conselho o derrubará.",
      "palavras": [
        { "hebraico": "יֵֽצְר֥וּ", "transliteral": "yê-ṣə-rû", "traducao_palavra": "Estreitar-se-ão" },
        { "hebraico": "צַעֲדֵי־", "transliteral": "ṣa-ʿă-ḏê-", "traducao_palavra": "os passos de" },
        { "hebraico": "אֹונֹ֑ו", "transliteral": "ʾō-w-nô", "traducao_palavra": "sua força/vigor" },
        { "hebraico": "וְֽתַשְׁלִיכֵ֥הוּ", "transliteral": "wə-ṯaš-lî-ḵê-hū", "traducao_palavra": "e o derrubará" },
        { "hebraico": "עֲצָתֹֽו׃", "transliteral": "ʿă-ṣā-ṯô", "traducao_palavra": "seu conselho" }
      ]
    },
    "8": {
      "traducao_completa": "Porque por seus próprios pés é lançado na rede, e anda sobre armadilhas.",
      "palavras": [
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "Porque" },
        { "hebraico": "שֻׁלַּ֣ח", "transliteral": "šul-laḥ", "traducao_palavra": "é lançado" },
        { "hebraico": "בְרֶ֣שֶׁת", "transliteral": "ḇə-re-šeṯ", "traducao_palavra": "na rede" },
        { "hebraico": "בְּרַגְלָ֑יו", "transliteral": "bə-raḡ-lāyw", "traducao_palavra": "pelos seus pés" },
        { "hebraico": "וְעַל־", "transliteral": "wə-ʿal-", "traducao_palavra": "e sobre" },
        { "hebraico": "שְׂ֝בָכָ֗ה", "transliteral": "śə-ḇā-ḵā", "traducao_palavra": "[as] malhas/armadilhas" },
        { "hebraico": "יִתְהַלָּֽךְ׃", "transliteral": "yiṯ-hal-lāḵ", "traducao_palavra": "ele caminha" }
      ]
    },
    "9": {
      "traducao_completa": "O laço o apanhará pelo calcanhar, e a armadilha o prenderá.",
      "palavras": [
        { "hebraico": "יֹאחֵ֣ז", "transliteral": "yō-w-ḥêz", "traducao_palavra": "Prenderá/Apanhará" },
        { "hebraico": "בְּעָקֵ֣ב", "transliteral": "bə-ʿā-qêḇ", "traducao_palavra": "pelo calcanhar" },
        { "hebraico": "פָּ֑ח", "transliteral": "pāḥ", "traducao_palavra": "[o] laço" },
        { "hebraico": "יַחֲזֵ֥ק", "transliteral": "ya-ḥă-zêq", "traducao_palavra": "prevalecerá/prenderá" },
        { "hebraico": "עָ֝לָ֗יו", "transliteral": "ʿā-lāyw", "traducao_palavra": "sobre ele" },
        { "hebraico": "צַמִּֽים׃", "transliteral": "ṣam-mîm", "traducao_palavra": "a armadilha/o assaltante" }
      ]
    },
    "10": {
      "traducao_completa": "A corda está escondida para ele na terra, e a armadilha na vereda.",
      "palavras": [
        { "hebraico": "טָמ֧וּן", "transliteral": "ṭā-mûn", "traducao_palavra": "Escondida" },
        { "hebraico": "בָּאָ֥רֶץ", "transliteral": "bā-ʾā-reṣ", "traducao_palavra": "na terra" },
        { "hebraico": "חַבְלֹ֑ו", "transliteral": "ḥaḇ-lô", "traducao_palavra": "[está] a corda dele" },
        { "hebraico": "וּ֝מַלְכֻּדְתֹּ֗ו", "transliteral": "ū-mal-kuḏ-tô", "traducao_palavra": "e sua armadilha" },
        { "hebraico": "עֲלֵ֣i", "transliteral": "ʿă-lê", "traducao_palavra": "sobre" },
        { "hebraico": "נָתִֽיב׃", "transliteral": "nā-ṯîḇ", "traducao_palavra": "[a] vereda" }
      ]
    },
    "11": {
      "traducao_completa": "Assombros o espantarão de todos os lados, e o perseguirão a cada passo.",
      "palavras": [
        { "hebraico": "סָבִ֥יב", "transliteral": "sā-ḇîḇ", "traducao_palavra": "Ao redor/De todos os lados" },
        { "hebraico": "בִּֽעֲתֻ֬הוּ", "transliteral": "bi-ʿă-ṯu-hū", "traducao_palavra": "espantarão ele" },
        { "hebraico": "בַלָּהֹ֑ות", "transliteral": "ḇal-lā-hō-wṯ", "traducao_palavra": "terrores/assombros" },
        { "hebraico": "וֶהֱפִיצֻ֥הוּ", "transliteral": "wə-he-p̄î-ṣu-hū", "traducao_palavra": "e o perseguirão/afugentarão" },
        { "hebraico": "לְרַגְלָֽיו׃", "transliteral": "lə-raḡ-lāyw", "traducao_palavra": "a seus pés/passos" }
      ]
    },
    "12": {
      "traducao_completa": "A sua força será faminta, e a destruição estará pronta ao seu lado.",
      "palavras": [
        { "hebraico": "יְהִי־", "transliteral": "yə-hî-", "traducao_palavra": "Será" },
        { "hebraico": "רָעֵ֥ב", "transliteral": "rā-ʿêḇ", "traducao_palavra": "faminta" },
        { "hebraico": "אֹונֹ֑ו", "transliteral": "ʾô-nô", "traducao_palavra": "a força dele" },
        { "hebraico": "וְ֝אֵ֗יד", "transliteral": "wə-ʾêḏ", "traducao_palavra": "e a destruição/calamidade" },
        { "hebraico": "נָכֹ֥ון", "transliteral": "nā-ḵō-wn", "traducao_palavra": "[está] pronta" },
        { "hebraico": "לְצַלְעֹֽו׃", "transliteral": "lə-ṣal-ʿô", "traducao_palavra": "ao seu lado" }
      ]
    },
    "13": {
      "traducao_completa": "Devorará os membros da sua pele; sim, o primogênito da morte devorará os seus membros.",
      "palavras": [
        { "hebraico": "יֹ֭אכַל", "transliteral": "yō-ʾḵal", "traducao_palavra": "Devorará" },
        { "hebraico": "בַּדֵּ֣i", "transliteral": "bad-dê", "traducao_palavra": "os membros de" },
        { "hebraico": "עֹורֹ֑ו", "transliteral": "ʿô-rô", "traducao_palavra": "sua pele" },
        { "hebraico": "יֹאכַ֥ל", "transliteral": "yō-ḵal", "traducao_palavra": "devorará" },
        { "hebraico": "בַּדָּיָ֗ו", "transliteral": "bad-dā-yāw", "traducao_palavra": "seus membros" },
        { "hebraico": "בְּכֹ֣ור", "transliteral": "bə-ḵō-wr", "traducao_palavra": "[o] primogênito de" },
        { "hebraico": "מָֽוֶת׃", "transliteral": "mā-weṯ", "traducao_palavra": "morte" }
      ]
    },
    "14": {
      "traducao_completa": "A sua confiança será arrancada da sua tenda, e ele será levado ao rei dos terrores.",
      "palavras": [
        { "hebraico": "יִנָּתֵ֣ק", "transliteral": "yin-nā-ṯêq", "traducao_palavra": "Será arrancada" },
        { "hebraico": "מֵאָהֳלֹ֣ו", "transliteral": "mê-ʾā-hŏ-lô", "traducao_palavra": "da tenda dele" },
        { "hebraico": "מִבְטַחֹ֑ו", "transliteral": "miḇ-ṭa-ḥô", "traducao_palavra": "a sua confiança" },
        { "hebraico": "וְ֝תַצְעִדֵ֗הוּ", "transliteral": "wə-ṯaṣ-ʿi-ḏê-hū", "traducao_palavra": "e o farão marchar/levarão" },
        { "hebraico": "לְמֶ֣לֶךְ", "transliteral": "lə-me-leḵ", "traducao_palavra": "ao rei de" },
        { "hebraico": "בַּלָּהֹֽות׃", "transliteral": "bal-lā-hō-wṯ", "traducao_palavra": "terrores" }
      ]
    },
    "15": {
      "traducao_completa": "Morará na sua tenda o que não lhe pertence; espalhar-se-á enxofre sobre a sua habitação.",
      "palavras": [
        { "hebraico": "תִּשְׁכֹּ֤ון", "transliteral": "tiš-kōn", "traducao_palavra": "Habitará" },
        { "hebraico": "בְּאָהֳלֹו֙", "transliteral": "bə-ʾā-hŏ-lô", "traducao_palavra": "na tenda dele" },
        { "hebraico": "מִבְּלִי־", "transliteral": "mib-bə-lî-", "traducao_palavra": "o que [é] sem" },
        { "hebraico": "לֹ֔ו", "transliteral": "lô", "traducao_palavra": "pertencer a ele" },
        { "hebraico": "יְזֹרֶ֥ה", "transliteral": "yə-zō-reh", "traducao_palavra": "espalhar-se-á" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre" },
        { "hebraico": "נָוֵ֖הוּ", "transliteral": "nā-wê-hū", "traducao_palavra": "a habitação dele" },
        { "hebraico": "גָּפְרִֽית׃", "transliteral": "gāp̄-rîṯ", "traducao_palavra": "enxofre" }
      ]
    },
    "16": {
      "traducao_completa": "Por baixo se secarão as suas raízes, e por cima serão cortados os seus ramos.",
      "palavras": [
        { "hebraico": "מִתַּ֭חַת", "transliteral": "mit-ta-ḥaṯ", "traducao_palavra": "Por baixo" },
        { "hebraico": "שָׁרָשָׁ֣יו", "transliteral": "šā-rā-šāyw", "traducao_palavra": "as raízes dele" },
        { "hebraico": "יִיבָ֑שׁוּ", "transliteral": "yî-ḇā-šû", "traducao_palavra": "secarão" },
        { "hebraico": "וּ֝מִמַּ֗עַל", "transliteral": "ū-mim-ma-ʿal", "traducao_palavra": "e por cima" },
        { "hebraico": "יִמַּ֥ל", "transliteral": "yim-mal", "traducao_palavra": "será cortado" },
        { "hebraico": "קְצִירֹֽו׃", "transliteral": "qə-ṣî-rô", "traducao_palavra": "o seu ramo" }
      ]
    },
    "17": {
      "traducao_completa": "A sua memória perecerá da terra, e pelas praças não terá nome.",
      "palavras": [
        { "hebraico": "זִכְרֹו־", "transliteral": "ziḵ-rô-", "traducao_palavra": "A memória dele" },
        { "hebraico": "אָבַ֥ד", "transliteral": "ʾā-ḇaḏ", "traducao_palavra": "pereceu/perecerá" },
        { "hebraico": "מִנִּי־", "transliteral": "min-nî-", "traducao_palavra": "da" },
        { "hebraico": "אָ֑רֶץ", "transliteral": "ʾā-reṣ", "traducao_palavra": "terra" },
        { "hebraico": "וְלֹא־", "transliteral": "wə-lō-", "traducao_palavra": "e não [haverá]" },
        { "hebraico": "שֵׁ֥ם", "transliteral": "šêm", "traducao_palavra": "nome" },
        { "hebraico": "לֹ֝ו", "transliteral": "lô", "traducao_palavra": "para ele" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre" },
        { "hebraico": "פְּנֵי־", "transliteral": "pə-nê-", "traducao_palavra": "a face de" },
        { "hebraico": "חֽוּץ׃", "transliteral": "ḥûṣ", "traducao_palavra": "fora/praça" }
      ]
    },
    "18": {
      "traducao_completa": "Da luz o lançarão nas trevas, e o afugentarão do mundo.",
      "palavras": [
        { "hebraico": "יֶהְדְּפֻ֣הוּ", "transliteral": "yeh-də-p̄u-hū", "traducao_palavra": "Lançarão ele" },
        { "hebraico": "מֵאֹ֣ור", "transliteral": "mê-ʾôr", "traducao_palavra": "da luz" },
        { "hebraico": "אֶל־", "transliteral": "ʾel-", "traducao_palavra": "para" },
        { "hebraico": "חֹ֑שֶׁךְ", "transliteral": "ḥō-šeḵ", "traducao_palavra": "trevas" },
        { "hebraico": "וּ֝מִתֵּבֵ֗ל", "transliteral": "ū-mit-tê-ḇêl", "traducao_palavra": "e do mundo" },
        { "hebraico": "יְנִדֻּֽהוּ׃", "transliteral": "yə-nid-du-hū", "traducao_palavra": "o afugentarão" }
      ]
    },
    "19": {
      "traducao_completa": "Não terá filho nem neto entre o seu povo, nem sobrante algum nas suas moradas.",
      "palavras": [
        { "hebraico": "לֹ֧א", "transliteral": "lō", "traducao_palavra": "Não" },
        { "hebraico": "נִ֣ין", "transliteral": "nîn", "traducao_palavra": "[haverá] filho" },
        { "hebraico": "לֹ֭ו", "transliteral": "lô", "traducao_palavra": "dele" },
