        { "hebraico": "לִקְחִ֑י", "transliteral": "liq-ḥî", "traducao_palavra": "minha doutrina" },
        { "hebraico": "וּ֝בַ֗ר", "transliteral": "ū-ḇar", "traducao_palavra": "e limpo" },
        { "hebraico": "הָיִ֥יתִי", "transliteral": "hā-yî-ṯî", "traducao_palavra": "sou" },
