        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "Pois" },
        { "hebraico": "אַתָּה", "transliteral": "ʾat-tā", "traducao_palavra": "tu" },
        { "hebraico": "עָמָל", "transliteral": "ʿā-māl", "traducao_palavra": "[do] sofrimento/fadiga" },
        { "hebraico": "תִּשְׁכָּח", "transliteral": "tiš-kāḥ", "traducao_palavra": "esquecerias" },
