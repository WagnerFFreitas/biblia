        { "hebraico": "הַרְחִיקֵהוּ", "transliteral": "har-ḥî-qê-hū", "traducao_palavra": "lança-a longe" },
        { "hebraico": "וְאַל־", "transliteral": "wə-ʾal-", "traducao_palavra": "e não" },
