        { "hebraico": "חָלֶד", "transliteral": "ḥā-leḏ", "traducao_palavra": "[a tua] vida/duração" },
        { "hebraico": "תָּעֻפָה", "transliteral": "tā-ʿu-p̄ā", "traducao_palavra": "[ainda que haja] escuridão" },
        { "hebraico": "כַּבֹּקֶר", "transliteral": "kab-bō-qer", "traducao_palavra": "como a manhã" },
