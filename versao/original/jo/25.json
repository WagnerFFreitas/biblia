{
  "livro": "Jó - אִיּוֹב - ʾIy-yōḇ",
  "capítulo": 25,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Então respondeu Bildade, o suíta, e disse:",
      "palavras": [
        { "hebraico": "וַיַּ֥עַן", "transliteral": "way-ya-ʿan", "traducao_palavra": "Então respondeu" },
        { "hebraico": "בִּלְדַּ֥ד", "transliteral": "bil-daḏ", "traducao_palavra": "Bildade" },
        { "hebraico": "הַשּׁוּחִ֑י", "transliteral": "haš-šû-ḥî", "traducao_palavra": "o suíta" },
        { "hebraico": "וַיֹּאמַֽר׃", "transliteral": "way-yō-mar", "traducao_palavra": "e disse" }
      ]
    },
    "2": {
      "traducao_completa": "Dominio e temor estão com ele; ele faz a paz nas suas alturas.",
      "palavras": [
        { "hebraico": "הַמְשֵׁ֧ל", "transliteral": "ham-šêl", "traducao_palavra": "O domínio" },
        { "hebraico": "וָפַ֛חַד", "transliteral": "wā-p̄a-ḥaḏ", "traducao_palavra": "e o temor" },
        { "hebraico": "עִמֹּ֑ו", "transliteral": "ʿim-mô", "traducao_palavra": "[estão] com Ele" },
        { "hebraico": "עֹשֶׂ֥ה", "transliteral": "ʿō-śeh", "traducao_palavra": "[Aquele que] faz" },
        { "hebraico": "שָׁ֝לֹ֗ום", "transliteral": "šā-lôm", "traducao_palavra": "paz" },
        { "hebraico": "בִּמְרֹומָֽיו׃", "transliteral": "bim-rô-w-māyw", "traducao_palavra": "nas Suas alturas" }
      ]
    },
    "3": {
      "traducao_completa": "Acaso têm número os seus exércitos? E sobre quem não resplandece a sua luz?",
      "palavras": [
        { "hebraico": "הֲיֵשׁ־", "transliteral": "hă-yêš-", "traducao_palavra": "Acaso há" },
        { "hebraico": "מִסְפָּ֥ר", "transliteral": "mis-pār", "traducao_palavra": "número" },
        { "hebraico": "לִגְדוּדָ֑יו", "transliteral": "liḡ-ḏû-ḏāyw", "traducao_palavra": "para os Seus exércitos?" },
        { "hebraico": "וְעַל־", "transliteral": "wə-ʿal-", "traducao_palavra": "e sobre" },
        { "hebraico": "מִ֝י", "transliteral": "mî", "traducao_palavra": "quem" },
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "יָק֥וּם", "transliteral": "yā-qûm", "traducao_palavra": "se levanta/resplandece" },
        { "hebraico": "אֹורֹֽו׃", "transliteral": "ʾô-rô", "traducao_palavra": "a Sua luz?" }
      ]
    },
    "4": {
      "traducao_completa": "Como, pois, seria justo o homem perante Deus, e como seria puro aquele que nasce de mulher?",
      "palavras": [
        { "hebraico": "וּמַה־", "transliteral": "ū-mah-", "traducao_palavra": "E como" },
        { "hebraico": "יִּצְדַּ֣ק", "transliteral": "yiṣ-daq", "traducao_palavra": "seria justo" },
        { "hebraico": "אֱ֭נֹושׁ", "transliteral": "ʾĕ-nō-wš", "traducao_palavra": "[o] homem mortal" },
        { "hebraico": "עִם־", "transliteral": "ʿim-", "traducao_palavra": "com/perante" },
        { "hebraico": "אֵ֑ל", "transliteral": "ʾêl", "traducao_palavra": "Deus?" },
        { "hebraico": "וּמַה־", "transliteral": "ū-mah-", "traducao_palavra": "e como" },
        { "hebraico": "יִּ֝זְכֶּ֗ה", "transliteral": "yiz-keh", "traducao_palavra": "seria puro" },
        { "hebraico": "יְל֣וּד", "transliteral": "yə-lûḏ", "traducao_palavra": "[o] nascido de" },
        { "hebraico": "אִשָּֽׁה׃", "transliteral": "ʾiš-šā", "traducao_palavra": "mulher" }
      ]
    },
    "5": {
      "traducao_completa": "Eis que até a lua não resplandece, e as estrelas não são puras aos seus olhos.",
      "palavras": [
        { "hebraico": "הֵ֣ן", "transliteral": "hên", "traducao_palavra": "Eis que" },
        { "hebraico": "עַד־", "transliteral": "ʿaḏ-", "traducao_palavra": "até" },
        { "hebraico": "יָ֭רֵחַ", "transliteral": "yā-rê-aḥ", "traducao_palavra": "[a] lua" },
        { "hebraico": "וְלֹ֣א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "יַאֲהִ֑יל", "transliteral": "ya-ʾă-hîl", "traducao_palavra": "brilha/resplandece" },
        { "hebraico": "וְ֝כֹוכָבִ֗ים", "transliteral": "wə-ḵô-w-ḵā-ḇîm", "traducao_palavra": "e as estrelas" },
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "זַכּ֥וּ", "transliteral": "zak-kû", "traducao_palavra": "são limpas/puras" },
        { "hebraico": "בְעֵינָֽיו׃", "transliteral": "ḇə-ʿê-nāyw", "traducao_palavra": "aos olhos d'Ele" }
      ]
    },
    "6": {
      "traducao_completa": "Quanto menos o homem, que é um verme, e o filho do homem, que é um bicho!",
      "palavras": [
        { "hebraico": "אַ֥ף", "transliteral": "ʾap̄", "traducao_palavra": "Quanto menos" },
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "se" },
        { "hebraico": "אֱנֹ֥ושׁ", "transliteral": "ʾĕ-nō-wš", "traducao_palavra": "[o] homem mortal" },
        { "hebraico": "רִמָּ֑ה", "transliteral": "rim-mā", "traducao_palavra": "[que é] um verme" },
        { "hebraico": "וּבֶן־", "transliteral": "ū-ḇen-", "traducao_palavra": "e o filho do" },
        { "hebraico": "אָ֝דָ֗ם", "transliteral": "ʾā-ḏām", "traducao_palavra": "homem" },
        { "hebraico": "תֹּולֵעָֽה׃", "transliteral": "tô-w-lê-ʿā", "traducao_palavra": "[que é] um bicho/verme" }
      ]
    }
  }
}