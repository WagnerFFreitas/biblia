    },
    "7": {
      "traducao_completa": "Se fores justo, que lhe darás, ou que receberá ele da tua mão?",
      "palavras": [
        { "hebraico": "אִם־", "transliteral": "ʾim-", "traducao_palavra": "Se" },
        { "hebraico": "צָ֭דַקְתָּ", "transliteral": "ṣā-ḏaq-tā", "traducao_palavra": "fores justo" },
        { "hebraico": "מַה־", "transliteral": "mah-", "traducao_palavra": "o que" },
        { "hebraico": "תִּתֶּן־", "transliteral": "tit-ten-", "traducao_palavra": "darás" },
