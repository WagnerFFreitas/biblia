        { "hebraico": "תֹאמַ֥ר", "transliteral": "ṯō-mar", "traducao_palavra": "dizes" },
        { "hebraico": "מַה־", "transliteral": "mah-", "traducao_palavra": "o que" },
        { "hebraico": "יִּסְכָּן־", "transliteral": "yis-kān-", "traducao_palavra": "aproveitaria" },
        { "hebraico": "לָ֑ךְ", "transliteral": "lāḵ", "traducao_palavra": "a ti?" },
        { "hebraico": "מָה־", "transliteral": "mā-", "traducao_palavra": "o que" },
        { "hebraico": "אֹ֝ועִיל", "transliteral": "ʾô-w-ʿîl", "traducao_palavra": "lucraria eu" },
        { "hebraico": "מֵחַטָּאתִֽי׃", "transliteral": "mê-ḥaṭ-ṭā-ṯî", "traducao_palavra": "mais que do meu pecado?" }
      ]
    },
    "4": {
      "traducao_completa": "Eu te darei resposta, a ti e aos teus amigos contigo.",
      "palavras": [
        { "hebraico": "אֲנִ֭י", "transliteral": "ʾă-nî", "traducao_palavra": "Eu" },
        { "hebraico": "אֲשִֽׁיבְךָ֣", "transliteral": "ʾă-šî-ḇə-ḵā", "traducao_palavra": "te responderei" },
        { "hebraico": "מִלִּ֑ין", "transliteral": "mil-lîn", "traducao_palavra": "com palavras" },
        { "hebraico": "וְאֶת־", "transliteral": "wə-ʾeṯ-", "traducao_palavra": "e [objeto]" },
        { "hebraico": "רֵעֶ֥יךָ", "transliteral": "rê-ʿey-ḵā", "traducao_palavra": "[aos] teus amigos" },
        { "hebraico": "עִמָּֽךְ׃", "transliteral": "ʿim-māḵ", "traducao_palavra": "contigo" }
      ]
    },
    "5": {
      "traducao_completa": "Olha para os céus, e vê; e contempla as nuvens, que são mais altas do que tu.",
      "palavras": [
        { "hebraico": "הַבֵּ֣ט", "transliteral": "hab-bêṭ", "traducao_palavra": "Olha" },
        { "hebraico": "שָׁמַ֣יִם", "transliteral": "šā-ma-yim", "traducao_palavra": "[para os] céus" },
        { "hebraico": "וּרְאֵ֑ה", "transliteral": "ū-rə-ʾêh", "traducao_palavra": "e vê" },
        { "hebraico": "וְ֝שׁ֤וּר", "transliteral": "wə-šûr", "traducao_palavra": "e contempla" },
        { "hebraico": "שְׁחָקִ֗ים", "transliteral": "šə-ḥā-qîm", "traducao_palavra": "as nuvens" },
        { "hebraico": "גָּבְה֥וּ", "transliteral": "gā-ḇə-hû", "traducao_palavra": "[que] são mais altas" },
        { "hebraico": "מִמֶּֽךָּ׃", "transliteral": "mim-me-kā", "traducao_palavra": "do que tu" }
      ]
    },
    "6": {
      "traducao_completa": "Se pecares, que efetuarás contra ele? Se as tuas transgressões se multiplicarem, que lhe farás?",
      "palavras": [
        { "hebraico": "אִם־", "transliteral": "ʾim-", "traducao_palavra": "Se" },
        { "hebraico": "חָ֭טָאתָ", "transliteral": "ḥā-ṭā-ṯā", "traducao_palavra": "pecares" },
        { "hebraico": "מַה־", "transliteral": "mah-", "traducao_palavra": "o que" },
        { "hebraico": "תִּפְעָל־", "transliteral": "tip̄-ʿāl-", "traducao_palavra": "efetuarás" },
        { "hebraico": "בֹּ֑ו", "transliteral": "bô", "traducao_palavra": "contra Ele?" },
        { "hebraico": "וְרַבּ֥וּ", "transliteral": "wə-rab-bû", "traducao_palavra": "e se multiplicarem" },
        { "hebraico": "פְ֝שָׁעֶ֗יךָ", "transliteral": "p̄ə-šā-ʿey-ḵā", "traducao_palavra": "as tuas transgressões" },
        { "hebraico": "מַה־", "transliteral": "mah-", "traducao_palavra": "o que" },
        { "hebraico": "תַּעֲשֶׂה־", "transliteral": "ta-ʿă-śeh-", "traducao_palavra": "farás" },
        { "hebraico": "לֹּֽו׃", "transliteral": "lô", "traducao_palavra": "a Ele?" }
