    "8": {
      "traducao_completa": "A tua impiedade pode fazer mal a um homem como tu, e a tua justiça pode aproveitar ao filho do homem.",
      "palavras": [
        { "hebraico": "לְאִֽישׁ־", "transliteral": "lə-ʾîš-", "traducao_palavra": "Para um homem" },
        { "hebraico": "כָּמֹ֥וךָ", "transliteral": "kā-mô-w-ḵā", "traducao_palavra": "como tu" },
        { "hebraico": "רִשְׁעֶ֑ךָ", "transliteral": "riš-ʿe-ḵā", "traducao_palavra": "[afeta] tua impiedade" },
