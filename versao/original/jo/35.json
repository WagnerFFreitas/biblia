{
  "livro": "Jó - אִיּוֹב - ʾIy-yōḇ",
  "capítulo": 35,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Respondeu mais Eliú, dizendo:",
      "palavras": [
        { "hebraico": "וַיַּ֥עַן", "transliteral": "way-ya-ʿan", "traducao_palavra": "E respondeu" },
        { "hebraico": "אֱלִיה֗וּ", "transliteral": "ʾĕ-lî-hû", "traducao_palavra": "Eliú" },
        { "hebraico": "וַיֹּאמַֽר׃", "transliteral": "way-yō-mar", "traducao_palavra": "e disse" }
      ]
    },
    "2": {
      "traducao_completa": "Tens por direito dizeres: Maior é a minha justiça do que a de Deus?",
      "palavras": [
        { "hebraico": "הֲזֹ֣את", "transliteral": "hă-zōṯ", "traducao_palavra": "Acaso isto" },
        { "hebraico": "חָשַׁ֣בְתָּ", "transliteral": "ḥā-šaḇ-tā", "traducao_palavra": "consideraste" },
        { "hebraico": "לְמִשְׁפָּ֑ט", "transliteral": "lə-miš-pāṭ", "traducao_palavra": "por direito/justo?" },
        { "hebraico": "אָ֝מַ֗רְתָּ", "transliteral": "ʾā-mar-tā", "traducao_palavra": "disseste" },
        { "hebraico": "צִדְקִ֥י", "transliteral": "ṣiḏ-qî", "traducao_palavra": "[é] minha justiça" },
        { "hebraico": "מֵאֵֽל׃", "transliteral": "mê-ʾêl", "traducao_palavra": "mais do que a de Deus" }
      ]
    },
    "3": {
      "traducao_completa": "Porque dizes: Que me aproveitaria? Que lucro teria eu mais do que se eu pecara?",
