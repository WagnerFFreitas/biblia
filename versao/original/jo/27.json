        { "hebraico": "יִלְבָּ֑שׁ", "transliteral": "yil-bāš", "traducao_palavra": "as vestirá" },
        { "hebraico": "וְ֝כֶ֗סֶף", "transliteral": "wə-ḵe-sep̄", "traducao_palavra": "e a prata" },
