        { "hebraico": "ḵָעָ֣שׁ", "transliteral": "ḵā-ʿāš", "traducao_palavra": "como a traça" },
        { "hebraico": "בֵּיתֹ֑ו", "transliteral": "bê-ṯô", "traducao_palavra": "sua casa" },
        { "hebraico": "וּ֝כְסֻכָּ֗ה", "transliteral": "ū-ḵə-śuk-kā", "traducao_palavra": "e como cabana/choça" },
        { "hebraico": "עָשָׂ֥ה", "transliteral": "ʿā-śā", "traducao_palavra": "[que] fez" },
