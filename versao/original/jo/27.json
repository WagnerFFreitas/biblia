      ]
    },
    "12": {
      "traducao_completa": "Eis que todos vós já o vistes; por que, pois, vos desvaneceis em pensamentos vãos?",
      "palavras": [
        { "hebraico": "הֵן־", "transliteral": "hên-", "traducao_palavra": "Eis que" },
        { "hebraico": "אַתֶּ֥ם", "transliteral": "ʾat-tem", "traducao_palavra": "vós" },
