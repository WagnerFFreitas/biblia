        { "hebraico": "אִם־", "transliteral": "ʾim-", "traducao_palavra": "Acaso" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "no" },
        { "hebraico": "שַׁדַּ֥י", "transliteral": "šad-day", "traducao_palavra": "Todo-Poderoso" },
