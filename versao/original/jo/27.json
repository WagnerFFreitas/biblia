{
  "livro": "Jó - אִיּוֹב - ʾIy-yōḇ",
  "capítulo": 27,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "E prosseguiu Jó em seu discurso, e disse:",
      "palavras": [
        { "hebraico": "וַיֹּ֥וסֶף", "transliteral": "way-yô-w-sep̄", "traducao_palavra": "E continuou/prosseguiu" },
        { "hebraico": "אִיֹּ֗וב", "transliteral": "ʾiy-yō-wḇ", "traducao_palavra": "Jó" },
        { "hebraico": "שְׂאֵ֥ת", "transliteral": "śə-ʾêṯ", "traducao_palavra": "em levantar" },
        { "hebraico": "מְשָׁלֹ֑ו", "transliteral": "mə-šā-lô", "traducao_palavra": "seu discurso/parábola" },
        { "hebraico": "וַיֹּאמַֽר׃", "transliteral": "way-yō-mar", "traducao_palavra": "e disse" }
      ]
    },
    "2": {
      "traducao_completa": "Vive Deus, que me tirou o meu direito, e o Todo-Poderoso, que amargurou a minha alma;",
      "palavras": [
        { "hebraico": "חַי־", "transliteral": "ḥay-", "traducao_palavra": "Vive" },
        { "hebraico": "אֵ֭ל", "transliteral": "ʾêl", "traducao_palavra": "Deus" },
        { "hebraico": "הֵסִ֣יר", "transliteral": "hê-śîr", "traducao_palavra": "[que] removeu/tirou" },
        { "hebraico": "מִשְׁפָּטִ֑י", "transliteral": "miš-pā-ṭî", "traducao_palavra": "meu direito" },
        { "hebraico": "וְ֝שַׁדַּ֗י", "transliteral": "wə-šad-day", "traducao_palavra": "e o Todo-Poderoso" },
        { "hebraico": "הֵמַ֥ר", "transliteral": "hê-mar", "traducao_palavra": "[que] amargurou" },
        { "hebraico": "נַפְשִֽׁי׃", "transliteral": "nap̄-šî", "traducao_palavra": "minha alma" }
      ]
    },
    "3": {
      "traducao_completa": "Que, enquanto em mim houver alento, e o espírito de Deus no meu nariz,",
      "palavras": [
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "Que" },
        { "hebraico": "כָל־", "transliteral": "ḵāl-", "traducao_palavra": "todo o tempo" },
        { "hebraico": "עֹ֥וד", "transliteral": "ʿô-wḏ", "traducao_palavra": "em que ainda" },
        { "hebraico": "נִשְׁמָתִ֖י", "transliteral": "niš-mā-ṯî", "traducao_palavra": "[estiver] meu fôlego" },
        { "hebraico": "בִ֑י", "transliteral": "ḇî", "traducao_palavra": "em mim" },
        { "hebraico": "וְר֨וּחַ", "transliteral": "wə-rû-aḥ", "traducao_palavra": "e o espírito de" },
        { "hebraico": "אֱלֹ֜והַּ", "transliteral": "ʾĕ-lô-ah", "traducao_palavra": "Deus" },
        { "hebraico": "בְּאַפִּֽי׃", "transliteral": "bə-ʾap-pî", "traducao_palavra": "em meu nariz" }
      ]
    },
    "4": {
      "traducao_completa": "Não falarão os meus lábios iniquidade, nem a minha língua pronunciará engano.",
      "palavras": [
        { "hebraico": "אִם־", "transliteral": "ʾim-", "traducao_palavra": "Que não" },
        { "hebraico": "תְּדַבֵּ֣רְנָה", "transliteral": "tə-ḏab-bêr-nā", "traducao_palavra": "falarão" },
        { "hebraico": "שְׂפָתַ֣י", "transliteral": "śə-p̄ā-ṯay", "traducao_palavra": "meus lábios" },
        { "hebraico": "עַוְלָ֑ה", "transliteral": "ʿaw-lā", "traducao_palavra": "iniquidade" },
        { "hebraico": "וּ֝לְשֹׁונִ֗י", "transliteral": "ū-lə-šô-w-nî", "traducao_palavra": "e minha língua" },
