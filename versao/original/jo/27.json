      ]
    },
    "14": {
      "traducao_completa": "Se os seus filhos se multiplicarem, será para a espada; e os seus renovos não se fartarão de pão.",
      "palavras": [
        { "hebraico": "אִם־", "transliteral": "ʾim-", "traducao_palavra": "Se" },
        { "hebraico": "יִרְבּ֣וּ", "transliteral": "yir-bû", "traducao_palavra": "se multiplicarem" },
        { "hebraico": "בָנָ֣יו", "transliteral": "ḇā-nāyw", "traducao_palavra": "os filhos dele" },
        { "hebraico": "לְמֹו־", "transliteral": "lə-mô-", "traducao_palavra": "[será] para a" },
        { "hebraico": "חָ֑רֶב", "transliteral": "ḥā-reḇ", "traducao_palavra": "espada" },
        { "hebraico": "וְ֝צֶאֱצָאָ֗יו", "transliteral": "wə-ṣe-ʾĕ-ṣā-ʾāyw", "traducao_palavra": "e os seus descendentes" },
