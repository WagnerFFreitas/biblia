        { "hebraico": "יִ֭שְׁכַּב", "transliteral": "yiš-kaḇ", "traducao_palavra": "ele se deita" },
        { "hebraico": "וְלֹ֣א", "transliteral": "wə-lō", "traducao_palavra": "mas não" },
        { "hebraico": "יֵאָסֵ֑ף", "transliteral": "yê-ʾā-śêp̄", "traducao_palavra": "será recolhido/reunido" },
        { "hebraico": "עֵינָ֖יו", "transliteral": "ʿê-nāyw", "traducao_palavra": "seus olhos" },
        { "hebraico": "פָּקַ֣ח", "transliteral": "pā-qaḥ", "traducao_palavra": "[ele] abre" },
