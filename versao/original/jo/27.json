        { "hebraico": "רָשָׁ֛ע", "transliteral": "rā-šāʿ", "traducao_palavra": "ímpio" },
        { "hebraico": "עִם־", "transliteral": "ʿim-", "traducao_palavra": "com" },
        { "hebraico": "אֵ֑ל", "transliteral": "ʾêl", "traducao_palavra": "Deus" },
        { "hebraico": "וְנַחֲלַ֥ת", "transliteral": "wə-na-ḥă-laṯ", "traducao_palavra": "e a herança de" },
