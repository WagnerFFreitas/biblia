        { "hebraico": "וְלֹ֣א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "יַחְמֹ֑ל", "transliteral": "ya-ḥmōl", "traducao_palavra": "poupará" },
        { "hebraico": "מִיָּדֹ֧ו", "transliteral": "miy-yā-ḏô", "traducao_palavra": "da Sua mão" },
        { "hebraico": "בָּרֹ֣וחַ", "transliteral": "bā-rô-aḥ", "traducao_palavra": "fugindo apressadamente" },
