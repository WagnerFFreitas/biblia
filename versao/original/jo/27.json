        { "hebraico": "לָֽחֶם׃", "transliteral": "lā-ḥem", "traducao_palavra": "pão" }
      ]
    },
    "15": {
      "traducao_completa": "Os que ficarem dele, na morte serão sepultados; e as suas viúvas não chorarão.",
