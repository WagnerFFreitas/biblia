        { "hebraico": "קָדִ֣ים", "transliteral": "qā-ḏîm", "traducao_palavra": "[o] vento oriental" },
        { "hebraico": "וְיֵלַ֑ךְ", "transliteral": "wə-yê-laḵ", "traducao_palavra": "e ele se vai" },
        { "hebraico": "וִֽ֝ישָׂעֲרֵ֗הוּ", "transliteral": "wî-śā-ʿă-rê-hū", "traducao_palavra": "e o varre/arranca com tormenta" },
        { "hebraico": "מִמְּקֹמֹֽו׃", "transliteral": "mim-mə-qō-w-mô", "traducao_palavra": "do seu lugar" }
