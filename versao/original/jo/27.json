        { "hebraico": "יְהִ֥י", "transliteral": "yə-hî", "traducao_palavra": "Seja" },
        { "hebraico": "כְרָשָׁ֥ע", "transliteral": "ḵə-rā-šāʿ", "traducao_palavra": "como o ímpio" },
        { "hebraico": "אֹיְבִ֑י", "transliteral": "ʾō-yə-ḇî", "traducao_palavra": "meu inimigo" },
        { "hebraico": "וּמִתְקֹומְמִ֥י", "transliteral": "ū-miṯ-qô-w-mə-mî", "traducao_palavra": "e o que se levanta contra mim" },
        { "hebraico": "כְעַוָּֽל׃", "transliteral": "ḵə-ʿaw-wāl", "traducao_palavra": "como o injusto/perverso" }
      ]
    },
    "8": {
      "traducao_completa": "Porque qual é a esperança do hipócrita, quando for cortado, quando Deus lhe arrancar a alma?",
