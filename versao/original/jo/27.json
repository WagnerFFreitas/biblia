        { "hebraico": "נַפְשֹֽׁו׃", "transliteral": "nap̄-šô", "traducao_palavra": "sua alma?" }
      ]
    },
    "9": {
      "traducao_completa": "Porventura ouvirá Deus o seu clamor, sobrevindo-lhe a angústia?",
      "palavras": [
        { "hebraico": "הַֽצַעֲקָתֹ֗ו", "transliteral": "ha-ṣa-ʿă-qā-ṯô", "traducao_palavra": "Acaso o clamor dele" },
