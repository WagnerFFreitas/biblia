        { "hebraico": "כֶּעָפָ֣ר", "transliteral": "ke-ʿā-p̄ār", "traducao_palavra": "como o pó" },
        { "hebraico": "כָּ֑סֶף", "transliteral": "kā-sep̄", "traducao_palavra": "prata" },
        { "hebraico": "וְ֝כַחֹ֗מֶר", "transliteral": "wə-ḵa-ḥō-mer", "traducao_palavra": "e como o lodo/barro" },
