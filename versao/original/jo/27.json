        { "hebraico": "מִמֶּֽנִּי׃", "transliteral": "mim-men-nî", "traducao_palavra": "de mim" }
      ]
    },
    "6": {
      "traducao_completa": "À minha justiça me apegarei e não a largarei; não me reprova o meu coração em todos os meus dias.",
      "palavras": [
        { "hebraico": "בְּצִדְקָתִ֖י", "transliteral": "bə-ṣiḏ-qā-ṯî", "traducao_palavra": "À minha justiça" },
        { "hebraico": "הֶחֱזַ֥קְתִּי", "transliteral": "he-ḥĕ-zaq-tî", "traducao_palavra": "me apeguei" },
        { "hebraico": "וְלֹ֣א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "אַרְפֶּ֑הָ", "transliteral": "ʾar-pe-hā", "traducao_palavra": "a soltarei" },
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "יֶחֱרַ֥ף", "transliteral": "ye-ḥĕ-rap̄", "traducao_palavra": "reprovará/envergonhará" },
        { "hebraico": "לְבָבִ֗י", "transliteral": "lə-ḇā-ḇî", "traducao_palavra": "meu coração" },
        { "hebraico": "מִיָּמָֽי׃", "transliteral": "mi-yā-māy", "traducao_palavra": "os meus dias" }
      ]
    },
    "7": {
      "traducao_completa": "Seja como o ímpio o meu inimigo, e como o perverso o que se levanta contra mim.",
