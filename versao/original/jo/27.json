        { "hebraico": "ḵַמַּ֣יִם", "transliteral": "ḵam-ma-yim", "traducao_palavra": "como águas" },
        { "hebraico": "בַּלָּהֹ֑ות", "transliteral": "bal-lā-hō-wṯ", "traducao_palavra": "pavores" },
        { "hebraico": "לַ֝יְלָה", "transliteral": "lay-lā", "traducao_palavra": "[de] noite" },
        { "hebraico": "גְּנָבַ֥תּוּ", "transliteral": "gə-nā-ḇat-tû", "traducao_palavra": "rouba-o/arrebata-o" },
        { "hebraico": "סוּפָֽה׃", "transliteral": "śû-p̄ā", "traducao_palavra": "[a] tempestade" }
