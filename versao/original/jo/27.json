        { "hebraico": "יֶהְגֶּ֥ה", "transliteral": "yeh-geh", "traducao_palavra": "meditará/pronunciará" },
        { "hebraico": "רְמִיָּֽה׃", "transliteral": "rə-mî-yā", "traducao_palavra": "engano" }
      ]
    },
    "5": {
      "traducao_completa": "Longe de mim que eu vos justifique; até que eu expire, nunca apartarei de mim a minha integridade.",
      "palavras": [
        { "hebraico": "חָלִ֤ילָה", "transliteral": "ḥā-lî-lā", "traducao_palavra": "Longe" },
        { "hebraico": "לִּ֨י", "transliteral": "lî", "traducao_palavra": "de mim" },
        { "hebraico": "אִם־", "transliteral": "ʾim-", "traducao_palavra": "que" },
        { "hebraico": "אַצְדִּ֪יק", "transliteral": "ʾaṣ-dîq", "traducao_palavra": "eu justifique" },
        { "hebraico": "אֶתְכֶ֥ם", "transliteral": "ʾeṯ-ḵem", "traducao_palavra": "a vós" },
        { "hebraico": "עַד־", "transliteral": "ʿaḏ-", "traducao_palavra": "até que" },
        { "hebraico": "אֶגְוָ֑ע", "transliteral": "ʾeḡ-wāʿ", "traducao_palavra": "eu expire" },
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "não" },
