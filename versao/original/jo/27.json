        { "hebraico": "זֶ֤ה", "transliteral": "zeh", "traducao_palavra": "Esta [é]" },
        { "hebraico": "חֵֽלֶק־", "transliteral": "ḥê-leq-", "traducao_palavra": "a porção de" },
