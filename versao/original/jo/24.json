{
  "livro": "Jó - אִיּוֹב - ʾIy-yōḇ",
  "capítulo": 24,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Por que não se reservaram os tempos da parte do Todo-Poderoso? E por que os que o conhecem não veem os seus dias?",
      "palavras": [
        { "hebraico": "מַ֭דּוּעַ", "transliteral": "mad-dū-aʿ", "traducao_palavra": "Por que" },
        { "hebraico": "מִשַּׁדַּ֬י", "transliteral": "miš-šad-day", "traducao_palavra": "da parte do Todo-Poderoso" },
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "נִצְפְּנ֧וּ", "transliteral": "niṣ-pə-nū", "traducao_palavra": "foram guardados/reservados" },
        { "hebraico": "עִתִּ֑ים", "transliteral": "ʿit-tîm", "traducao_palavra": "tempos" },
        { "hebraico": "וְ֝יֹדְעָ֗יו", "transliteral": "wə-yō-ḏə-ʿāyw", "traducao_palavra": "e os que O conhecem" },
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "חָ֥זוּ", "transliteral": "ḥā-zû", "traducao_palavra": "veem" },
        { "hebraico": "יָמָֽיו׃", "transliteral": "yā-māyw", "traducao_palavra": "Seus dias" }
      ]
    },
    "2": {
      "traducao_completa": "Há os que removem os marcos; roubam os rebanhos, e os apascentam.",
      "palavras": [
        { "hebraico": "גְּבֻלֹ֥ות", "transliteral": "gə-ḇu-lō-wṯ", "traducao_palavra": "Limites/Marcos" },
        { "hebraico": "יַשִּׂ֑יגוּ", "transliteral": "yaś-śî-ḡû", "traducao_palavra": "removem/alcançam" },
        { "hebraico": "עֵ֥דֶר", "transliteral": "ʿê-ḏer", "traducao_palavra": "um rebanho" },
        { "hebraico": "גָּ֝זְל֗וּ", "transliteral": "ḡā-zə-lû", "traducao_palavra": "roubam" },
        { "hebraico": "וַיִּרְעֽוּ׃", "transliteral": "way-yir-ʿû", "traducao_palavra": "e [o] apascentam" }
      ]
    },
    "3": {
      "traducao_completa": "Do órfão levam o jumento; tomam em penhor o boi da viúva.",
      "palavras": [
        { "hebraico": "חֲמֹ֣ור", "transliteral": "ḥă-mō-wr", "traducao_palavra": "[O] jumento de" },
        { "hebraico": "יְתֹומִ֣ים", "transliteral": "yə-ṯō-mîm", "traducao_palavra": "órfãos" },
        { "hebraico": "יִנְהָ֑גוּ", "transliteral": "yin-hā-ḡû", "traducao_palavra": "levam embora" },
        { "hebraico": "יַ֝חְבְּל֗וּ", "transliteral": "yaḥ-bə-lû", "traducao_palavra": "tomam em penhor" },
        { "hebraico": "שֹׁ֣ור", "transliteral": "šôr", "traducao_palavra": "[o] boi de" },
        { "hebraico": "אַלְמָנָֽה׃", "transliteral": "ʾal-mā-nā", "traducao_palavra": "viúva" }
      ]
    },
    "4": {
      "traducao_completa": "Desviam do caminho os necessitados; e os pobres da terra juntos se escondem.",
      "palavras": [
        { "hebraico": "יַטּ֣וּ", "transliteral": "yaṭ-ṭû", "traducao_palavra": "Desviam" },
        { "hebraico": "אֶבְיֹונִ֣ים", "transliteral": "ʾeḇ-yō-w-nîm", "traducao_palavra": "[os] necessitados" },
        { "hebraico": "מִדָּ֑רֶךְ", "transliteral": "mid-dā-reḵ", "traducao_palavra": "do caminho" },
        { "hebraico": "יֳַחַ֥ד", "transliteral": "ya-ḥaḏ", "traducao_palavra": "juntamente" },
        { "hebraico": "חֻ֝בְּא֗וּ", "transliteral": "ḥub-bə-ʾû", "traducao_palavra": "escondem-se" },
        { "hebraico": "עֲנִיֵּי־", "transliteral": "ʿă-niy-yê-", "traducao_palavra": "os pobres de" },
        { "hebraico": "אָֽרֶץ׃", "transliteral": "ʾā-reṣ", "traducao_palavra": "terra" }
      ]
    },
    "5": {
      "traducao_completa": "Eis que, como jumentos monteses no deserto, saem à sua obra, madrugando para a presa; o deserto lhes dá pão para seus filhos.",
      "palavras": [
        { "hebraico": "הֵן֮", "transliteral": "hên", "traducao_palavra": "Eis" },
        { "hebraico": "פְּרָאִ֪ים", "transliteral": "pə-rā-ʾîm", "traducao_palavra": "[como] jumentos selvagens" },
        { "hebraico": "בַּמִּדְבָּ֫ר", "transliteral": "bam-miḏ-bār", "traducao_palavra": "no deserto" },
        { "hebraico": "יָצְא֣וּ", "transliteral": "yā-ṣə-ʾû", "traducao_palavra": "saem" },
        { "hebraico": "בְפָעֳלָ֭ם", "transliteral": "ḇə-p̄ā-ʿo-lām", "traducao_palavra": "em sua obra" },
        { "hebraico": "מְשַׁחֲרֵ֣i", "transliteral": "mə-ša-ḥă-rê", "traducao_palavra": "buscando diligentemente" },
        { "hebraico": "לַטָּ֑רֶף", "transliteral": "laṭ-ṭā-rep̄", "traducao_palavra": "a presa" },
        { "hebraico": "עֲרָבָ֥ה", "transliteral": "ʿă-rā-ḇā", "traducao_palavra": "[o] deserto/planície" },
        { "hebraico": "לֹ֝ו", "transliteral": "lô", "traducao_palavra": "para ele" },
        { "hebraico": "לֶ֗חֶם", "transliteral": "le-ḥem", "traducao_palavra": "[dá] pão" },
        { "hebraico": "לַנְּעָרִֽים׃", "transliteral": "lan-nə-ʿā-rîm", "traducao_palavra": "para os jovens/filhos" }
      ]
    },
    "6": {
      "traducao_completa": "No campo segam o seu pasto, e colhem a vinha do ímpio.",
      "palavras": [
        { "hebraico": "בַּ֭שָּׂדֶה", "transliteral": "baś-śā-ḏeh", "traducao_palavra": "No campo" },
        { "hebraico": "בְּלִילֹ֣ו", "transliteral": "bə-lî-lô", "traducao_palavra": "o seu forragem/pasto" },
        { "hebraico": "יִקְצֹורוּ", "transliteral": "yiq-ṣō-w-rû", "traducao_palavra": "colhem/segam" },
        { "hebraico": "וְכֶ֖רֶם", "transliteral": "wə-ḵe-rem", "traducao_palavra": "e a vinha de" },
        { "hebraico": "רָשָׁ֣ע", "transliteral": "rā-šāʿ", "traducao_palavra": "[o] ímpio" },
        { "hebraico": "יְלַקֵּֽשׁוּ׃", "transliteral": "yə-laq-qê-šû", "traducao_palavra": "rabiscam/colhem tarde" }
      ]
    },
    "7": {
      "traducao_completa": "Ao nu fazem pernoitar sem roupa, não tendo ele cobertura contra o frio.",
      "palavras": [
        { "hebraico": "עָרֹ֣ום", "transliteral": "ʿā-rō-wm", "traducao_palavra": "Nu" },
        { "hebraico": "יָ֭לִינוּ", "transliteral": "yā-lî-nū", "traducao_palavra": "pernoitam" },
        { "hebraico": "מִבְּלִ֣י", "transliteral": "mib-bə-lî", "traducao_palavra": "sem" },
        { "hebraico": "לְב֑וּשׁ", "transliteral": "lə-ḇûš", "traducao_palavra": "vestimenta" },
        { "hebraico": "וְאֵ֥ין", "transliteral": "wə-ʾên", "traducao_palavra": "e não [há]" },
        { "hebraico": "כְּ֝ס֗וּת", "transliteral": "kə-śûṯ", "traducao_palavra": "cobertura" },
        { "hebraico": "בַּקָּרָֽה׃", "transliteral": "baq-qā-rā", "traducao_palavra": "no frio" }
      ]
    },
    "8": {
      "traducao_completa": "Pelas chuvas dos montes são molhados, e por não terem refúgio, abraçam-se com as rochas.",
      "palavras": [
        { "hebraico": "מִזֶּ֨רֶם", "transliteral": "miz-ze-rem", "traducao_palavra": "Pela tempestade de" },
        { "hebraico": "הָרִ֥ים", "transliteral": "hā-rîm", "traducao_palavra": "montes" },
        { "hebraico": "יִרְטָ֑בוּ", "transliteral": "yir-ṭā-ḇû", "traducao_palavra": "ficam molhados" },
        { "hebraico": "וּמִבְּלִ֥י", "transliteral": "ū-mib-bə-lî", "traducao_palavra": "e por falta de" },
        { "hebraico": "מַ֝חְסֶ֗ה", "transliteral": "maḥ-seh", "traducao_palavra": "refúgio" },
        { "hebraico": "חִבְּקוּ־", "transliteral": "ḥib-bə-qû-", "traducao_palavra": "abraçam" },
        { "hebraico": "צוּר׃", "transliteral": "ṣûr", "traducao_palavra": "[a] rocha" }
      ]
    },
    "9": {
      "traducao_completa": "Arrancam ao órfão do peito, e tomam o penhor do pobre.",
      "palavras": [
        { "hebraico": "יִגְזְל֥וּ", "transliteral": "yiḡ-zə-lû", "traducao_palavra": "Arrancam" },
        { "hebraico": "מִשֹּׁ֗ד", "transliteral": "miš-šōḏ", "traducao_palavra": "do peito" },
        { "hebraico": "יָ֫תֹ֥ום", "transliteral": "yā-ṯō-wm", "traducao_palavra": "[o] órfão" },
        { "hebraico": "וְעַל־", "transliteral": "wə-ʿal-", "traducao_palavra": "e sobre" },
        { "hebraico": "עָנִ֥י", "transliteral": "ʿā-nî", "traducao_palavra": "[o] pobre" },
        { "hebraico": "יַחְבֹּֽלוּ׃", "transliteral": "yaḥ-bə-lû", "traducao_palavra": "tomam penhor" }
      ]
    },
    "10": {
      "traducao_completa": "Fazem que estes andem nus, sem roupa; e aos famintos tiram as espigas.",
      "palavras": [
        { "hebraico": "עָרֹ֣ום", "transliteral": "ʿā-rō-wm", "traducao_palavra": "Nu" },
        { "hebraico": "הִ֭לְּכוּ", "transliteral": "hil-lə-ḵû", "traducao_palavra": "andam" },
        { "hebraico": "בְּלִ֣י", "transliteral": "bə-lî", "traducao_palavra": "sem" },
        { "hebraico": "לְב֑וּשׁ", "transliteral": "lə-ḇûš", "traducao_palavra": "vestimenta" },
        { "hebraico": "וּ֝רְעֵבִ֗ים", "transliteral": "ū-rə-ʿê-ḇîm", "traducao_palavra": "e famintos" },
        { "hebraico": "נָשְׂא֥וּ", "transliteral": "nā-śə-ʾû", "traducao_palavra": "carregam" },
        { "hebraico": "עֹֽמֶר׃", "transliteral": "ʿō-mer", "traducao_palavra": "feixe/espigas" }
      ]
    },
    "11": {
      "traducao_completa": "Dentro dos seus muros espremem o azeite; pisam os lagares, e ainda têm sede.",
      "palavras": [
        { "hebraico": "בֵּין־", "transliteral": "bên-", "traducao_palavra": "Entre/Dentro de" },
        { "hebraico": "שׁוּרֹתָ֥ם", "transliteral": "šū-rō-ṯām", "traducao_palavra": "seus muros/fileiras" },
        { "hebraico": "יַצְהִ֑ירוּ", "transliteral": "yaṣ-hî-rû", "traducao_palavra": "espremem o azeite" },
        { "hebraico": "יְקָבִ֥ים", "transliteral": "yə-qā-ḇîm", "traducao_palavra": "lagares" },
        { "hebraico": "דָּ֝רְכ֗וּ", "transliteral": "ḏā-rə-ḵû", "traducao_palavra": "pisaram" },
        { "hebraico": "וַיִּצְמָֽאוּ׃", "transliteral": "way-yiṣ-mā-ʾû", "traducao_palavra": "e [ainda] têm sede" }
      ]
    },
    "12": {
      "traducao_completa": "Desde as cidades gemem os homens, e a alma dos feridos clama; contudo Deus não lhes atribui desvario.",
      "palavras": [
        { "hebraico": "מֵעִ֤יר", "transliteral": "mê-ʿîr", "traducao_palavra": "Da cidade" },
        { "hebraico": "מְתִ֨ים ׀", "transliteral": "mə-ṯîm", "traducao_palavra": "homens" },
        { "hebraico": "יִנְאָ֟קוּ", "transliteral": "yin-ʾā-qû", "traducao_palavra": "gemem" },
        { "hebraico": "וְנֶֽפֶשׁ־", "transliteral": "wə-ne-p̄eš-", "traducao_palavra": "e a alma de" },
        { "hebraico": "חֲלָלִ֥ים", "transliteral": "ḥă-lā-lîm", "traducao_palavra": "feridos" },
        { "hebraico": "תְּשַׁוֵּ֑עַ", "transliteral": "tə-šaw-wê-aʿ", "traducao_palavra": "clama" },
        { "hebraico": "וֶ֝אֱלֹ֗והַּ", "transliteral": "wə-ʾĕ-lô-hwah", "traducao_palavra": "e Deus" },
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "יָשִׂ֥ים", "transliteral": "yā-śîm", "traducao_palavra": "põe/atribui" },
        { "hebraico": "תִּפְלָֽה׃", "transliteral": "tip̄-lā", "traducao_palavra": "insensatez/falta" }
      ]
    },
    "13": {
      "traducao_completa": "Eles estão entre os que se rebelam contra a luz; não conhecem os seus caminhos, nem permanecem nas suas veredas.",
      "palavras": [
        { "hebraico": "הֵ֥מָּה", "transliteral": "hêm-mā", "traducao_palavra": "Eles" },
        { "hebraico": "הָ֭יוּ", "transliteral": "hā-yû", "traducao_palavra": "estão/estavam" },
        { "hebraico": "בְּמֹרְדֵי־", "transliteral": "bə-mōr-ḏê-", "traducao_palavra": "entre os rebeldes contra" },
        { "hebraico": "אֹ֑ור", "transliteral": "ʾôr", "traducao_palavra": "a luz" },
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "הִכִּ֥ירוּ", "transliteral": "hik-kî-rû", "traducao_palavra": "reconheceram" },
        { "hebraico": "דְרָכָ֗יו", "transliteral": "ḏə-rā-ḵāyw", "traducao_palavra": "os Seus caminhos" },
        { "hebraico": "וְלֹ֣א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "יָ֝שְׁבוּ", "transliteral": "yā-šə-ḇû", "traducao_palavra": "permaneceram" },
        { "hebraico": "בִּנְתִיבֹתָֽיו׃", "transliteral": "bin-ṯî-ḇō-ṯāyw", "traducao_palavra": "nas Suas veredas" }
      ]
    },
    "14": {
      "traducao_completa": "De madrugada se levanta o homicida, mata o pobre e o necessitado, e de noite é como o ladrão.",
      "palavras": [
        { "hebraico": "לַ֭אֹור", "transliteral": "la-ʾôr", "traducao_palavra": "Com a luz" },
        { "hebraico": "יָק֣וּם", "transliteral": "yā-qûm", "traducao_palavra": "levanta-se" },
        { "hebraico": "רֹוצֵ֑חַ", "transliteral": "rō-w-ṣê-aḥ", "traducao_palavra": "o assassino" },
        { "hebraico": "יִקְטָל־", "transliteral": "yiq-ṭāl-", "traducao_palavra": "mata" },
        { "hebraico": "עָנִ֥י", "transliteral": "ʿā-nî", "traducao_palavra": "[o] pobre" },
        { "hebraico": "וְאֶבְיֹ֗ון", "transliteral": "wə-ʾeḇ-yō-wn", "traducao_palavra": "e [o] necessitado" },
        { "hebraico": "וּבַלַּ֥יְלָה", "transliteral": "ū-ḇal-lay-lā", "traducao_palavra": "e de noite" },
        { "hebraico": "יְהִי־", "transliteral": "yə-hî-", "traducao_palavra": "ele é" },
        { "hebraico": "כַגַּנָּֽב׃", "transliteral": "ḵaḡ-gan-nāḇ", "traducao_palavra": "como o ladrão" }
      ]
    },
    "15": {
      "traducao_completa": "O olho do adúltero espera pelo crepúsculo, dizendo: Olho nenhum me verá; e cobre o rosto.",
      "palavras": [
        { "hebraico": "וְעֵ֤ין", "transliteral": "wə-ʿên", "traducao_palavra": "E o olho de" },
        { "hebraico": "נֹ֘אֵ֤ף", "transliteral": "nō-ʾêp̄", "traducao_palavra": "adúltero" },
        { "hebraico": "שָׁ֬מְרָה", "transliteral": "šām-rā", "traducao_palavra": "observa/aguarda" },
        { "hebraico": "נֶ֫שֶׁף", "transliteral": "ne-šep̄", "traducao_palavra": "o crepúsculo" },
        { "hebraico": "לֵאמֹ֥ר", "transliteral": "lê-mōr", "traducao_palavra": "dizendo" },
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "תְשׁוּרֵ֥נִי", "transliteral": "ṯə-šû-rê-nî", "traducao_palavra": "me verá" },
        { "hebraico": "עָ֑יִן", "transliteral": "ʿā-yin", "traducao_palavra": "olho [algum]" },
        { "hebraico": "וְסֵ֖תֶר", "transliteral": "wə-śê-ṯer", "traducao_palavra": "e esconderijo" },
        { "hebraico": "פָּנִ֣ים", "transliteral": "pā-nîm", "traducao_palavra": "[para a] face" },
        { "hebraico": "יָשִֽׂים׃", "transliteral": "yā-śîm", "traducao_palavra": "ele põe" }
      ]
    },
    "16": {
      "traducao_completa": "Nas trevas minam as casas que de dia para si marcaram; não conhecem a luz.",
      "palavras": [
        { "hebraico": "חָתַ֨ר", "transliteral": "ḥā-ṯar", "traducao_palavra": "Escavam/Minam" },
        { "hebraico": "בַּחֹ֥שֶׁךְ", "transliteral": "ba-ḥō-šeḵ", "traducao_palavra": "nas trevas" },
        { "hebraico": "בָּתִּ֗ים", "transliteral": "bāt-tîm", "traducao_palavra": "casas" },
        { "hebraico": "יֹ֭ומָם", "transliteral": "yô-wmām", "traducao_palavra": "de dia" },
        { "hebraico": "חִתְּמוּ־", "transliteral": "ḥit-tə-mû-", "traducao_palavra": "se encerram" },
        { "hebraico": "לָ֑מֹו", "transliteral": "lā-mô", "traducao_palavra": "para si" },
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "יָ֥דְעוּ", "transliteral": "yā-ḏə-ʿû", "traducao_palavra": "conhecem" },
        { "hebraico": "אֹֽור׃", "transliteral": "ʾôr", "traducao_palavra": "[a] luz" }
      ]
    },
    "17": {
      "traducao_completa": "Porque a manhã para todos eles é como a sombra da morte; pois, conhecendo os terrores da sombra da morte,",
      "palavras": [
        { "hebraico": "כִּ֚י", "transliteral": "kî", "traducao_palavra": "Porque" },
        { "hebraico": "יַחְדָּ֥ו", "transliteral": "yaḥ-dāw", "traducao_palavra": "juntamente" },
        { "hebraico": "בֹּ֗קֶר", "transliteral": "bō-qer", "traducao_palavra": "[a] manhã" },
        { "hebraico": "לָ֫מֹו", "transliteral": "lā-mô", "traducao_palavra": "para eles" },
        { "hebraico": "צַלְמָ֥וֶת", "transliteral": "ṣal-mā-weṯ", "traducao_palavra": "[é como] sombra da morte" },
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "pois" },
        { "hebraico": "יַ֝כִּיר", "transliteral": "yak-kîr", "traducao_palavra": "[cada um] está familiarizado com" },
        { "hebraico": "בַּלְהֹ֥ות", "transliteral": "bal-hō-wṯ", "traducao_palavra": "os terrores de" },
        { "hebraico": "צַלְמָֽוֶת׃", "transliteral": "ṣal-mā-weṯ", "traducao_palavra": "sombra da morte" }
      ]
    },
    "18": {
      "traducao_completa": "É ligeiro sobre a face das águas; a sua porção é maldita na terra; não volta pelo caminho das vinhas.",
      "palavras": [
        { "hebraico": "קַל־", "transliteral": "qal-", "traducao_palavra": "Leve/Rápido" },
        { "hebraico": "ה֤וּא", "transliteral": "hû", "traducao_palavra": "é ele" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre" },
        { "hebraico": "פְּנֵי־", "transliteral": "pə-nê-", "traducao_palavra": "a face de" },
        { "hebraico": "מַ֗יִם", "transliteral": "ma-yim", "traducao_palavra": "águas" },
        { "hebraico": "תְּקֻלַּ֣ל", "transliteral": "tə-qul-lal", "traducao_palavra": "será maldita" },
        { "hebraico": "חֶלְקָתָ֣ם", "transliteral": "ḥel-qā-ṯām", "traducao_palavra": "a porção deles" },
        { "hebraico": "בָּאָ֑רֶץ", "transliteral": "bā-ʾā-reṣ", "traducao_palavra": "na terra" },
        { "hebraico": "לֹֽא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "יִ֝פְנֶ֗ה", "transliteral": "yip̄-neh", "traducao_palavra": "se voltará" },
        { "hebraico": "דֶּ֣רֶךְ", "transliteral": "de-reḵ", "traducao_palavra": "[pelo] caminho de" },
        { "hebraico": "כְּרָמִֽים׃", "transliteral": "kə-rā-mîm", "traducao_palavra": "vinhas" }
      ]
    },
    "19": {
      "traducao_completa": "A sequidão e o calor arrebatam as águas da neve; assim a sepultura arrebata os que pecaram.",
      "palavras": [
        { "hebraico": "צִיָּ֧ה", "transliteral": "ṣiy-yā", "traducao_palavra": "[A] aridez" },
        { "hebraico": "גַם־", "transliteral": "gam-", "traducao_palavra": "e também" },
        { "hebraico": "חֹ֘ם", "transliteral": "ḥōm", "traducao_palavra": "[o] calor" },
        { "hebraico": "יִגְזְל֪וּ", "transliteral": "yiḡ-zə-lû", "traducao_palavra": "arrebatam" },
        { "hebraico": "מֵימֵי־", "transliteral": "mê-mê-", "traducao_palavra": "águas de" },
        { "hebraico": "שֶׁ֫לֶג", "transliteral": "še-leḡ", "traducao_palavra": "neve" },
        { "hebraico": "שְׁאֹ֥ול", "transliteral": "šə-ʾô-wl", "traducao_palavra": "[assim a] sepultura" },
        { "hebraico": "חָטָֽאוּ׃", "transliteral": "ḥā-ṭā-ʾû", "traducao_palavra": "[aos que] pecaram" }
      ]
    },
    "20": {
      "traducao_completa": "A madre se esquecerá dele, os vermes o comerão docemente; nunca mais haverá memória dele; e a iniquidade se quebrará como uma árvore.",
      "palavras": [
        { "hebraico": "יִשְׁכָּ֘חֵ֤הוּ", "transliteral": "yiš-kā-ḥê-hū", "traducao_palavra": "Esquecerá dele" },
        { "hebraico": "רֶ֨חֶם", "transliteral": "re-ḥem", "traducao_palavra": "a madre/útero" },
        { "hebraico": "מְתָ֘קֹ֤ו", "transliteral": "mə-ṯā-qô", "traducao_palavra": "lhe será doce" },
        { "hebraico": "רִמָּ֗ה", "transliteral": "rim-mā", "traducao_palavra": "o verme" },
        { "hebraico": "עֹ֭וד", "transliteral": "ʿô-wḏ", "traducao_palavra": "mais" },
        { "hebraico": "לֹֽא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "יִזָּכֵ֑ר", "transliteral": "yiz-zā-ḵêr", "traducao_palavra": "será lembrado" },
        { "hebraico": "וַתִּשָּׁבֵ֖ר", "transliteral": "wat-tiš-šā-ḇêr", "traducao_palavra": "e será quebrada" },
        { "hebraico": "כָּעֵ֣ץ", "transliteral": "kā-ʿêṣ", "traducao_palavra": "como árvore" },
        { "hebraico": "עַוְלָֽה׃", "transliteral": "ʿaw-lā", "traducao_palavra": "a injustiça" }
      ]
    },
    "21": {
      "traducao_completa": "Aflige a estéril que não gera, e à viúva não faz bem.",
      "palavras": [
        { "hebraico": "רֹעֶ֣ה", "transliteral": "rō-ʿeh", "traducao_palavra": "Aflige/Devora" },
        { "hebraico": "עֲ֭קָרָה", "transliteral": "ʿă-qā-rā", "traducao_palavra": "a estéril" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "[que] não" },
        { "hebraico": "תֵלֵ֑ד", "transliteral": "ṯê-lêḏ", "traducao_palavra": "gera/dá à luz" },
        { "hebraico": "וְ֝אַלְמָנָ֗ה", "transliteral": "wə-ʾal-mā-nā", "traducao_palavra": "e à viúva" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "יְיֵיטִֽיב׃", "transliteral": "yə-yê-ṭîḇ", "traducao_palavra": "faz bem" }
      ]
    },
    "22": {
      "traducao_completa": "Até aos poderosos arrasta com a sua força; levanta-se, e ninguém crê na sua própria vida.",
      "palavras": [
        { "hebraico": "וּמָשַׁ֣ךְ", "transliteral": "ū-mā-šaḵ", "traducao_palavra": "E arrasta" },
        { "hebraico": "אַבִּירִ֣ים", "transliteral": "ab-bî-rîm", "traducao_palavra": "poderosos" },
        { "hebraico": "בְּכֹ֧חֹו", "transliteral": "bə-ḵō-ḥô", "traducao_palavra": "com Sua força" },
        { "hebraico": "יָ֝ק֗וּם", "transliteral": "yā-qûm", "traducao_palavra": "levanta-se" },
        { "hebraico": "וְלֹא־", "transliteral": "wə-lō-", "traducao_palavra": "e não" },
        { "hebraico": "יַאֲמִ֥ין", "transliteral": "ya-ʾă-mîn", "traducao_palavra": "crê" },
        { "hebraico": "בַּחַיִּֽין׃", "transliteral": "ba-ḥay-yîn", "traducao_palavra": "na vida" }
      ]
    },
    "23": {
      "traducao_completa": "Deus lhe dá descanso, e ele se estriba nele; mas os seus olhos estão sobre os caminhos deles.",
      "palavras": [
        { "hebraico": "יִתֶּן־", "transliteral": "yit-ten-", "traducao_palavra": "Dá" },
        { "hebraico": "לֹ֥ו", "transliteral": "lô", "traducao_palavra": "a ele" },
        { "hebraico": "לָ֝בֶ֗טַח", "transliteral": "lā-ḇe-ṭaḥ", "traducao_palavra": "segurança/confiança" },
        { "hebraico": "וְיִשָּׁעֵ֑ן", "transliteral": "wə-yiš-śā-ʿên", "traducao_palavra": "e ele se apóia" },
        { "hebraico": "וְ֝עֵינֵ֗יהוּ", "transliteral": "wə-ʿê-nê-hū", "traducao_palavra": "mas os olhos d'Ele" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "[estão] sobre" },
        { "hebraico": "דַּרְכֵיהֶֽם׃", "transliteral": "dar-ḵê-hem", "traducao_palavra": "os caminhos deles" }
      ]
    },
    "24": {
      "traducao_completa": "Exaltam-se por um pouco, mas logo desaparecem; são abatidos e colhidos como todos os demais, e cortados como as pontas das espigas.",
      "palavras": [
        { "hebraico": "רֹ֥ומּוּ", "transliteral": "rō-wm-mû", "traducao_palavra": "Exaltam-se" },
        { "hebraico": "מְּעַ֨ט", "transliteral": "mə-ʿaṭ", "traducao_palavra": "por um pouco" },
        { "hebraico": "וְאֵינֶ֗נּוּ", "transliteral": "wə-ʾê-nen-nū", "traducao_palavra": "e já não [existem]" },
        { "hebraico": "וְ֝הֻמְּכ֥וּ", "transliteral": "wə-hum-mə-ḵû", "traducao_palavra": "e são humilhados/rebaixados" },
        { "hebraico": "כַכֹּ֪ל", "transliteral": "ḵak-kōl", "traducao_palavra": "como todos" },
        { "hebraico": "יִקָּפְצֹ֑ון", "transliteral": "yiq-qā-p̄ə-ṣô-wn", "traducao_palavra": "são colhidos" },
        { "hebraico": "וּכְרֹ֖אשׁ", "transliteral": "ū-ḵə-rō-wš", "traducao_palavra": "e como a cabeça de" },
        { "hebraico": "שִׁבֹּ֣לֶת", "transliteral": "šib-bō-leṯ", "traducao_palavra": "espiga" },
        { "hebraico": "יִמָּֽלוּ׃", "transliteral": "yim-mā-lû", "traducao_palavra": "são cortados" }
      ]
    },
    "25": {
      "traducao_completa": "Se não é assim, quem me desmentirá e desfará as minhas palavras?",
      "palavras": [
        { "hebraico": "וְאִם־", "transliteral": "wə-ʾim-", "traducao_palavra": "E se" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "אֵ֭פֹו", "transliteral": "ʾê-p̄ô", "traducao_palavra": "então" },
        { "hebraico": "מִ֣י", "transliteral": "mî", "traducao_palavra": "quem" },
        { "hebraico": "יַכְזִיבֵ֑נִי", "transliteral": "yak-zî-ḇê-nî", "traducao_palavra": "me desmentirá" },
        { "hebraico": "וְיָשֵׂ֥ם", "transliteral": "wə-yā-śêm", "traducao_palavra": "e tornará" },
        { "hebraico": "לְ֝אַ֗ל", "transliteral": "lə-ʾal", "traducao_palavra": "em nada" },
        { "hebraico": "מִלָּתִֽי׃", "transliteral": "mil-lā-ṯî", "traducao_palavra": "minha palavra?" }
      ]
    }
  }
