        { "hebraico": "בָּא֙", "transliteral": "bā", "traducao_palavra": "veio" },
        { "hebraico": "וַיֹּאמַ֑ר", "transliteral": "way-yō-mar", "traducao_palavra": "e disse" },
        { "hebraico": "בָּנֶ֨יךָ", "transliteral": "bā-ne-ḵā", "traducao_palavra": "teus filhos" },
        { "hebraico": "וּבְנֹותֶ֜יךָ", "transliteral": "ū-ḇə-nō-ṯe-ḵā", "traducao_palavra": "e tuas filhas" },
