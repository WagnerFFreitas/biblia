        { "hebraico": "וִירֵ֥א", "transliteral": "wî-rê", "traducao_palavra": "e temente a" },
        { "hebraico": "אֱלֹהִ֖ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "Deus" },
