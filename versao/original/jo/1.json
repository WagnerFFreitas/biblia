        { "hebraico": "גְּדֹולָ֜ה", "transliteral": "ḡə-ḏō-lā", "traducao_palavra": "grande" },
        { "hebraico": "בָּ֣אָה", "transliteral": "bā-ʾā", "traducao_palavra": "veio" },
        { "hebraico": "מֵעֵ֣בֶר", "transliteral": "mê-ʿê-ḇer", "traducao_palavra": "de além de" },
