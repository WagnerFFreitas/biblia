        { "hebraico": "הַבַּיִת֒", "transliteral": "hab-ba-yit", "traducao_palavra": "a casa" },
        { "hebraico": "וַיִּפֹּ֤ל", "transliteral": "way-yip-pōl", "traducao_palavra": "e ela caiu" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre" },
        { "hebraico": "הַנְּעָרִים֙", "transliteral": "han-nə-ʿā-rîm", "traducao_palavra": "os jovens" },
        { "hebraico": "וַיָּמ֔וּתוּ", "transliteral": "way-yā-mû-ṯû", "traducao_palavra": "e morreram" },
        { "hebraico": "וָאִמָּלְטָ֧ה", "transliteral": "wā-ʾim-mā-lə-ṭā", "traducao_palavra": "e escapei" },
