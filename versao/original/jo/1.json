        { "hebraico": "וְשֹׁתִ֥ים", "transliteral": "wə-šō-ṯîm", "traducao_palavra": "e bebendo" },
        { "hebraico": "יַ֙יִן֙", "transliteral": "ya-yin", "traducao_palavra": "vinho" },
        { "hebraico": "בְּבֵ֥ית", "transliteral": "bə-ḇêṯ", "traducao_palavra": "na casa de" },
        { "hebraico": "אֲחִיהֶ֖ם", "transliteral": "ʾă-ḥî-hem", "traducao_palavra": "seu irmão" },
        { "hebraico": "הַבְּכֹֽור׃", "transliteral": "hab-bə-ḵō-wr", "traducao_palavra": "o primogênito" }
