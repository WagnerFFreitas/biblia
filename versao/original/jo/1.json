      ]
    },
    "21": {
      "traducao_completa": "E disse: Nu saí do ventre de minha mãe e nu tornarei para lá; YHWH o deu, e YHWH o tomou: bendito seja o nome de YHWH.",
      "palavras": [
        { "hebraico": "וַיֹּאמֶר֩", "transliteral": "way-yō-mer", "traducao_palavra": "E disse" },
        { "hebraico": "עָרֹ֨ם", "transliteral": "ʿā-rōm", "traducao_palavra": "Nu" },
        { "hebraico": "יָצָ֜תִי", "transliteral": "yā-ṣā-ṯî", "traducao_palavra": "saí" },
        { "hebraico": "מִבֶּ֣טֶן", "transliteral": "mib-be-ṭen", "traducao_palavra": "do ventre de" },
