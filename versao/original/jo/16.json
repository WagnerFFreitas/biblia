{
  "livro": "Jó - אִיּוֹב - ʾIy-yōḇ",
  "capítulo": 16,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Então respondeu Jó, e disse:",
      "palavras": [
        { "hebraico": "וַיַּ֥עַן", "transliteral": "way-ya-ʿan", "traducao_palavra": "Então respondeu" },
        { "hebraico": "אִיֹּ֥וב", "transliteral": "ʾiy-yō-wḇ", "traducao_palavra": "Jó" },
        { "hebraico": "וַיֹּאמַֽר׃", "transliteral": "way-yō-mar", "traducao_palavra": "e disse" }
      ]
    },
    "2": {
      "traducao_completa": "Tenho ouvido muitas coisas como estas; todos vós sois consoladores molestos.",
      "palavras": [
        { "hebraico": "שָׁמַ֣עְתִּי", "transliteral": "šā-maʿ-tî", "traducao_palavra": "Tenho ouvido" },
        { "hebraico": "ḵָאֵ֣לֶּה", "transliteral": "ḵā-ʾēl-leh", "traducao_palavra": "como estas [coisas]" },
        { "hebraico": "רַבֹּ֑ות", "transliteral": "rab-bō-wṯ", "traducao_palavra": "muitas" },
        { "hebraico": "מְנַחֲמֵ֖י", "transliteral": "mə-na-ḥă-mê", "traducao_palavra": "consoladores de" },
        { "hebraico": "עָמָ֣ל", "transliteral": "ʿā-māl", "traducao_palavra": "moléstia/sofrimento" },
        { "hebraico": "כֻּלְּכֶֽם׃", "transliteral": "kul-lə-ḵem", "traducao_palavra": "todos vós" }
      ]
    },
    "3": {
      "traducao_completa": "Porventura não terão fim as palavras de vento? Ou que te instiga a responder assim?",
      "palavras": [
        { "hebraico": "הֲקֵ֘ץ", "transliteral": "hă-qêṣ", "traducao_palavra": "Acaso fim" },
        { "hebraico": "לְדִבְרֵי־", "transliteral": "lə-ḏiḇ-rê-", "traducao_palavra": "às palavras de" },
        { "hebraico": "ר֥וּחַ", "transliteral": "rû-aḥ", "traducao_palavra": "vento?" },
        { "hebraico": "אֹ֥ו", "transliteral": "ʾô", "traducao_palavra": "Ou" },
        { "hebraico": "מַה־", "transliteral": "mah-", "traducao_palavra": "o que" },
        { "hebraico": "יַּמְרִֽיצְךָ", "transliteral": "yam-rî-ṣə-ḵā", "traducao_palavra": "te instiga/provoca" },
        { "hebraico": "כִּ֣י", "transliteral": "kî", "traducao_palavra": "para que" },
        { "hebraico": "תַעֲנֶֽה׃", "transliteral": "ta-ʿă-neh", "traducao_palavra": "respondas?" }
      ]
    },
    "4": {
      "traducao_completa": "Também eu poderia falar como vós; se a vossa alma estivesse no lugar da minha alma, eu poderia amontoar palavras contra vós e menear a minha cabeça contra vós.",
      "palavras": [
        { "hebraico": "גַּ֣ם", "transliteral": "gam", "traducao_palavra": "Também" },
        { "hebraico": "אָנֹכִ֭י", "transliteral": "ʾā-nō-ḵî", "traducao_palavra": "eu" },
        { "hebraico": "כָּכֶ֣ם", "transliteral": "kā-ḵem", "traducao_palavra": "como vós" },
        { "hebraico": "אֲדַבֵּ֑רָה", "transliteral": "ʾă-ḏab-bê-rā", "traducao_palavra": "falaria" },
        { "hebraico": "לוּ־", "transliteral": "lû-", "traducao_palavra": "se" },
        { "hebraico": "יֵ֨שׁ", "transliteral": "yêš", "traducao_palavra": "estivesse" },
        { "hebraico": "נַפְשְׁכֶ֜ם", "transliteral": "nap̄-šə-ḵem", "traducao_palavra": "vossa alma" },
        { "hebraico": "תַּ֧חַת", "transliteral": "ta-ḥaṯ", "traducao_palavra": "em lugar de" },
        { "hebraico": "נַפְשִׁ֗י", "transliteral": "nap̄-šî", "traducao_palavra": "minha alma" },
        { "hebraico": "אַחְבִּירָה", "transliteral": "ʾaḥ-bî-rā", "traducao_palavra": "amontoaria" },
        { "hebraico": "עֲלֵיכֶ֥ם", "transliteral": "ʿă-lê-ḵem", "traducao_palavra": "sobre vós" },
        { "hebraico": "בְּמִלִּ֑ים", "transliteral": "bə-mil-lîm", "traducao_palavra": "com palavras" },
        { "hebraico": "וְאָנִ֥יעָה", "transliteral": "wə-ʾā-nî-ʿā", "traducao_palavra": "e moveria" },
        { "hebraico": "עֲלֵיכֶ֝ם", "transliteral": "ʿă-lê-ḵem", "traducao_palavra": "contra vós" },
        { "hebraico": "בְּמֹ֣ו", "transliteral": "bə-mô", "traducao_palavra": "com" },
        { "hebraico": "רֹאשִֽׁי׃", "transliteral": "rō-šî", "traducao_palavra": "minha cabeça" }
      ]
    },
    "5": {
      "traducao_completa": "Poderia fortalecer-vos com a minha boca, e o movimento dos meus lábios abrandaria a vossa dor.",
      "palavras": [
        { "hebraico": "אֲאַמִּצְכֶ֥ם", "transliteral": "ʾă-ʾam-miṣ-ḵem", "traducao_palavra": "Fortalecer-vos-ia" },
        { "hebraico": "בְּמֹו־", "transliteral": "bə-mô-", "traducao_palavra": "com" },
        { "hebraico": "פִ֑י", "transliteral": "p̄î", "traducao_palavra": "minha boca" },
        { "hebraico": "וְנִ֖יד", "transliteral": "wə-nîḏ", "traducao_palavra": "e o consolo de" },
        { "hebraico": "שְׂפָתַ֣י", "transliteral": "śə-p̄ā-ṯay", "traducao_palavra": "meus lábios" },
        { "hebraico": "יַחְשֹֽׂךְ׃", "transliteral": "yaḥ-śōḵ", "traducao_palavra": "abrandaria/reteria [a dor]" }
      ]
    },
    "6": {
      "traducao_completa": "Se eu falar, a minha dor não cessará; e se eu me calar, o que se me retirará dela?",
      "palavras": [
        { "hebraico": "אִם־", "transliteral": "ʾim-", "traducao_palavra": "Se" },
        { "hebraico": "אֲ֭דַבְּרָה", "transliteral": "ʾă-ḏab-bə-rā", "traducao_palavra": "eu falar" },
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "יֵחָשֵׂ֣ךְ", "transliteral": "yê-ḥā-śêḵ", "traducao_palavra": "será retida/cessada" },
        { "hebraico": "כְּאֵבִ֑י", "transliteral": "kə-ʾê-ḇî", "traducao_palavra": "minha dor" },
        { "hebraico": "וְ֝אַחְדְּלָ֗ה", "transliteral": "wə-ʾaḥ-də-lā", "traducao_palavra": "e se eu cessar/parar" },
        { "hebraico": "מַה־", "transliteral": "mah-", "traducao_palavra": "o que" },
        { "hebraico": "מִּנִּ֥י", "transliteral": "min-nî", "traducao_palavra": "de mim" },
        { "hebraico": "יַהֲלֹֽךְ׃", "transliteral": "ya-hă-lōḵ", "traducao_palavra": "se irá?" }
      ]
    },
    "7": {
      "traducao_completa": "Na verdade, agora ele me cansou; tu assolaste toda a minha família.",
      "palavras": [
        { "hebraico": "אַךְ־", "transliteral": "ʾaḵ-", "traducao_palavra": "Certamente" },
        { "hebraico": "עַתָּ֥ה", "transliteral": "ʿat-tā", "traducao_palavra": "agora" },
        { "hebraico": "הֶלְאָ֑נִי", "transliteral": "hel-ʾā-nî", "traducao_palavra": "Ele me cansou/exauriu" },
        { "hebraico": "הֲ֝שִׁמֹּ֗ותָ", "transliteral": "hă-šim-mô-ṯā", "traducao_palavra": "assolaste" },
        { "hebraico": "כָּל־", "transliteral": "kāl-", "traducao_palavra": "toda" },
        { "hebraico": "עֲדָתִֽי׃", "transliteral": "ʿă-ḏā-ṯî", "traducao_palavra": "minha congregação/família" }
      ]
    },
    "8": {
      "traducao_completa": "Também tu me encheste de rugas, o que serve de testemunha contra mim; e a minha magreza se levanta contra mim, e no meu rosto testifica contra mim.",
      "palavras": [
        { "hebraico": "וַֽתִּקְמְטֵ֬נִי", "transliteral": "wat-tiq-mə-ṭê-nî", "traducao_palavra": "E tu me enrugaste" },
        { "hebraico": "לְעֵ֨ד", "transliteral": "lə-ʿêḏ", "traducao_palavra": "por testemunha" },
        { "hebraico": "הָיָה֮", "transliteral": "hā-yā", "traducao_palavra": "tem sido" },
        { "hebraico": "וַיָּ֤קָם", "transliteral": "way-yā-qām", "traducao_palavra": "e levanta-se" },
        { "hebraico": "בִּ֓י", "transliteral": "bî", "traducao_palavra": "em mim" },
        { "hebraico": "ḵַחֲשִׁ֫י", "transliteral": "ḵa-ḥă-šî", "traducao_palavra": "minha magreza/fraqueza" },
        { "hebraico": "יַעֲנֶ֥ה", "transliteral": "ya-ʿă-neh", "traducao_palavra": "testifica" },
        { "hebraico": "ḇְפָנָֽי׃", "transliteral": "ḇə-p̄ā-nāy", "traducao_palavra": "em meu rosto" }
      ]
    },
    "9": {
      "traducao_completa": "Na sua ira me despedaçou, e ele me perseguiu; rangeu os dentes contra mim; o meu adversário aguçou os seus olhos contra mim.",
      "palavras": [
        { "hebraico": "אַפֹּ֤ו", "transliteral": "ʾap-pô", "traducao_palavra": "Sua ira" },
        { "hebraico": "טָרַ֨ף", "transliteral": "ṭā-rap̄", "traducao_palavra": "despedaçou" },
        { "hebraico": "וַֽיִּשְׂטְמֵ֗נִי", "transliteral": "way-yiś-ṭə-mê-nî", "traducao_palavra": "e me perseguiu/odiou" },
        { "hebraico": "חָרַ֣ק", "transliteral": "ḥā-raq", "traducao_palavra": "rangeu" },
        { "hebraico": "עָלַ֣י", "transliteral": "ʿā-lay", "traducao_palavra": "contra mim" },
        { "hebraico": "בְּשִׁנָּ֑יו", "transliteral": "bə-šin-nāyw", "traducao_palavra": "com seus dentes" },
        { "hebraico": "צָרִ֓י", "transliteral": "ṣā-rî", "traducao_palavra": "meu adversário" },
        { "hebraico": "יִלְטֹ֖ושׁ", "transliteral": "yil-ṭô-wš", "traducao_palavra": "aguça" },
        { "hebraico": "עֵינָ֣יו", "transliteral": "ʿê-nāyw", "traducao_palavra": "seus olhos" },
        { "hebraico": "לִֽי׃", "transliteral": "lî", "traducao_palavra": "em mim" }
      ]
    },
    "10": {
      "traducao_completa": "Abriram a sua boca contra mim; com desprezo me feriram nos queixos, e todos juntos se ajuntaram contra mim.",
      "palavras": [
        { "hebraico": "פָּעֲר֨וּ", "transliteral": "pā-ʿă-rû", "traducao_palavra": "Abriram/Escancararam" },
        { "hebraico": "עָלַ֧י", "transliteral": "ʿā-lay", "traducao_palavra": "contra mim" },
        { "hebraico": "בְּפִיהֶ֛ם", "transliteral": "bə-p̄î-hem", "traducao_palavra": "com a boca deles" },
        { "hebraico": "בְּחֶרְפָּ֖ה", "transliteral": "bə-ḥer-pā", "traducao_palavra": "com desprezo/insulto" },
        { "hebraico": "הִכּ֣וּ", "transliteral": "hik-kû", "traducao_palavra": "feriram" },
        { "hebraico": "לְחָיָ֑י", "transliteral": "lə-ḥā-yāy", "traducao_palavra": "meus queixos" },
        { "hebraico": "יַ֝חַד", "transliteral": "ya-ḥaḏ", "traducao_palavra": "juntamente" },
        { "hebraico": "עָלַ֥י", "transliteral": "ʿā-lay", "traducao_palavra": "contra mim" },
        { "hebraico": "יִתְמַלָּאֽוּן׃", "transliteral": "yiṯ-mal-lā-ʾûn", "traducao_palavra": "eles se aliaram" }
      ]
    },
    "11": {
      "traducao_completa": "Deus me entregou aos ímpios, e nas mãos dos perversos me fez cair.",
      "palavras": [
        { "hebraico": "יַסְגִּירֵ֥נִי", "transliteral": "yas-gî-rê-nî", "traducao_palavra": "Entrega-me" },
        { "hebraico": "אֵ֝ל", "transliteral": "ʾêl", "traducao_palavra": "Deus" },
        { "hebraico": "אֶ֣ל", "transliteral": "ʾel", "traducao_palavra": "a" },
        { "hebraico": "עֲוִ֑יל", "transliteral": "ʿă-wîl", "traducao_palavra": "um perverso/ímpio" },
        { "hebraico": "וְעַל־", "transliteral": "wə-ʿal-", "traducao_palavra": "e nas" },
        { "hebraico": "יְדֵ֖i", "transliteral": "yə-ḏê", "traducao_palavra": "mãos de" },
        { "hebraico": "רְשָׁעִ֣ים", "transliteral": "rə-šā-ʿîm", "traducao_palavra": "ímpios" },
        { "hebraico": "יִרְטֵֽנִי׃", "transliteral": "yir-ṭê-nî", "traducao_palavra": "Ele me lançou" }
      ]
    },
    "12": {
      "traducao_completa": "Descansado estava eu, porém ele me quebrantou; e pegou-me pelo pescoço, e me despedaçou; também me pôs por seu alvo.",
      "palavras": [
        { "hebraico": "שָׁלֵ֣ו", "transliteral": "šā-lêw", "traducao_palavra": "Tranquilo/Descansado" },
        { "hebraico": "הָיִ֣יתִי", "transliteral": "hā-yî-ṯî", "traducao_palavra": "eu estava" },
        { "hebraico": "וַֽיְפַרְפְּרֵ֡נִי", "transliteral": "way-p̄ar-pə-rê-nî", "traducao_palavra": "e Ele me despedaçou" },
        { "hebraico": "וְאָחַ֣ז", "transliteral": "wə-ʾā-ḥaz", "traducao_palavra": "e agarrou" },
        { "hebraico": "בְּ֭עָרְפִּי", "transliteral": "bə-ʿā-rə-pî", "traducao_palavra": "no meu pescoço" },
        { "hebraico": "וַֽיְפַצְפְּצֵ֑נִי", "transliteral": "way-p̄aṣ-pə-ṣê-nî", "traducao_palavra": "e me quebrou em pedaços" },
        { "hebraico": "וַיְקִימֵ֥נִי", "transliteral": "way-qî-mê-nî", "traducao_palavra": "e me pôs" },
        { "hebraico": "לֹ֝ו", "transliteral": "lô", "traducao_palavra": "para Ele" },
        { "hebraico": "לְמַטָּרָֽה׃", "transliteral": "lə-maṭ-ṭā-rā", "traducao_palavra": "por alvo" }
      ]
    },
    "13": {
      "traducao_completa": "Cercam-me os seus flecheiros; atravessa-me os rins, e não me poupa, e o meu fel derrama por terra.",
      "palavras": [
        { "hebraico": "יָסֹ֨בּוּ", "transliteral": "yā-śō-bū", "traducao_palavra": "Cercam" },
        { "hebraico": "עָלַ֜י", "transliteral": "ʿā-lay", "traducao_palavra": "sobre mim" },
        { "hebraico": "רַבָּ֗יו", "transliteral": "rab-bāyw", "traducao_palavra": "os Seus flecheiros" },
        { "hebraico": "יְפַלַּ֣ח", "transliteral": "yə-p̄al-laḥ", "traducao_palavra": "atravessa/fende" },
        { "hebraico": "כִּ֭לְיֹותַי", "transliteral": "kil-yō-w-ṯay", "traducao_palavra": "meus rins" },
        { "hebraico": "וְלֹ֣א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "יַחְמֹ֑ל", "transliteral": "yaḥ-mōl", "traducao_palavra": "poupa" },
        { "hebraico": "יִשְׁפֹּ֥ךְ", "transliteral": "yiš-pōḵ", "traducao_palavra": "derrama" },
        { "hebraico": "לָ֝אָ֗רֶץ", "transliteral": "lā-ʾā-reṣ", "traducao_palavra": "na terra" },
        { "hebraico": "מְרֵרָתִֽי׃", "transliteral": "mərê-rā-ṯî", "traducao_palavra": "meu fel" }
      ]
    },
    "14": {
      "traducao_completa": "Quebranta-me com ferida sobre ferida; arremete contra mim como um gigante.",
      "palavras": [
        { "hebraico": "יִפְרְצֵ֣נִי", "transliteral": "yip̄-rə-ṣê-nî", "traducao_palavra": "Quebranta-me/Abre brecha em mim" },
        { "hebraico": "פֶ֭רֶץ", "transliteral": "p̄e-reṣ", "traducao_palavra": "[com] brecha" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre" },
        { "hebraico": "פְּנֵי־", "transliteral": "pə-nê-", "traducao_palavra": "a face de" },
        { "hebraico": "פָ֑רֶץ", "transliteral": "p̄ā-reṣ", "traducao_palavra": "brecha" },
        { "hebraico": "יָרֻ֥ץ", "transliteral": "yā-ruṣ", "traducao_palavra": "corre/arremete" },
        { "hebraico": "עָ֝לַ֗י", "transliteral": "ʿā-lay", "traducao_palavra": "sobre mim" },
        { "hebraico": "כְּגִבֹּֽור׃", "transliteral": "kə-ḡib-bôr", "traducao_palavra": "como um gigante/guerreiro" }
      ]
    },
    "15": {
      "traducao_completa": "Cosi sobre a minha pele o saco, e revolvi a minha força no pó.",
      "palavras": [
        { "hebraico": "שַׂ֣ק", "transliteral": "śaq", "traducao_palavra": "Pano de saco" },
        { "hebraico": "תָּ֭פַרְתִּי", "transliteral": "tā-p̄ar-tî", "traducao_palavra": "costurei" },
        { "hebraico": "עֲלֵ֣i", "transliteral": "ʿă-lê", "traducao_palavra": "sobre" },
        { "hebraico": "גִּלְדִּ֑י", "transliteral": "gil-dî", "traducao_palavra": "minha pele" },
        { "hebraico": "וְעֹלַ֖לְתִּי", "transliteral": "wə-ʿō-lal-tî", "traducao_palavra": "e revolvi/humilhei" },
        { "hebraico": "בֶעָפָ֣ר", "transliteral": "ḇe-ʿā-p̄ār", "traducao_palavra": "no pó" },
        { "hebraico": "קַרְנִֽי׃", "transliteral": "qar-nî", "traducao_palavra": "meu chifre/força" }
      ]
    },
    "16": {
      "traducao_completa": "O meu rosto está todo avermelhado de chorar, e sobre as minhas pálpebras está a sombra da morte;",
      "palavras": [
        { "hebraico": "פָּנַ֣י", "transliteral": "pā-nay", "traducao_palavra": "Minha face" },
        { "hebraico": "חֳ֭מַרְמְרָה", "transliteral": "ḥo-mar-mə-rā", "traducao_palavra": "está avermelhada/inflamada" },
        { "hebraico": "מִנִּי־", "transliteral": "min-nî-", "traducao_palavra": "pelo" },
