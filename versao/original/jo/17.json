        { "hebraico": "רֵעִ֑ים", "transliteral": "rê-ʿîm", "traducao_palavra": "amigos" },
        { "hebraico": "וְעֵינֵ֖i", "transliteral": "wə-ʿê-nê", "traducao_palavra": "e os olhos de" },
