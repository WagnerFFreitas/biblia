        { "hebraico": "חֻבָּ֣לָה", "transliteral": "ḥub-bā-lā", "traducao_palavra": "está quebrado/consumido" },
        { "hebraico": "יָמַ֣י", "transliteral": "yā-may", "traducao_palavra": "meus dias" },
        { "hebraico": "נִזְעָ֑כוּ", "transliteral": "niz-ʿā-ḵû", "traducao_palavra": "estão extintos" },
        { "hebraico": "קְבָרִ֥ים", "transliteral": "qə-ḇā-rîm", "traducao_palavra": "[a] sepultura" },
