        { "hebraico": "נָּ֭א", "transliteral": "nā", "traducao_palavra": "agora/rogo-te" },
        { "hebraico": "עָרְבֵ֣נִי", "transliteral": "ʿā-rə-ḇê-nî", "traducao_palavra": "meu fiador/penhor" },
        { "hebraico": "עִמָּ֑ךְ", "transliteral": "ʿim-māḵ", "traducao_palavra": "contigo" },
        { "hebraico": "מִ֥י", "transliteral": "mî", "traducao_palavra": "quem" },
