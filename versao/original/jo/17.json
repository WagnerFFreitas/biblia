        { "hebraico": "עִמָּדִ֑י", "transliteral": "ʿim-mā-ḏî", "traducao_palavra": "[estão] comigo" },
        { "hebraico": "וּ֝בְהַמְּרֹותָ֗ם", "transliteral": "ū-ḇə-ham-mə-rō-w-ṯām", "traducao_palavra": "e na provocação deles" },
