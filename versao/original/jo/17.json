        { "hebraico": "לִבָּ֥ם", "transliteral": "lib-bām", "traducao_palavra": "o coração deles" },
        { "hebraico": "צָפַ֪נְתָּ", "transliteral": "ṣā-p̄an-tā", "traducao_palavra": "escondeste" },
        { "hebraico": "מִּשָּׂ֑כֶל", "transliteral": "miś-śā-ḵel", "traducao_palavra": "do entendimento" },
