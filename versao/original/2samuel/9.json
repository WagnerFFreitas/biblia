      "traducao_completa": "Trabalhar-lhe-ás, pois, a terra, tu e teus filhos, e teus servos, e recolherás os frutos, para que o filho de teu senhor tenha pão que coma; e Mefibosete, filho de teu senhor, comerá sempre pão à minha mesa. E tinha Ziba quinze filhos e vinte servos.",
      "palavras": [
        { "hebraico": "וְעָבַדְתָּ֩", "transliteral": "wə-ʿā-ḇaḏ-tā", "traducao_palavra": "e trabalharás" },
        { "hebraico": "לֹּ֨ו", "transliteral": "lô", "traducao_palavra": "para ele" },
        { "hebraico": "אֶת־הָאֲדָמָ֜ה", "transliteral": "ʾeṯ-hā-ʾă-ḏā-mā", "traducao_palavra": "a terra" },
        { "hebraico": "אַתָּ֣ה ׀", "transliteral": "ʾat-tā", "traducao_palavra": "tu" },
        { "hebraico": "וּבָנֶ֣יךָ", "transliteral": "ū-ḇā-ne-ḵā", "traducao_palavra": "e teus filhos" },
        { "hebraico": "וַעֲבָדֶ֗יךָ", "transliteral": "wa-ʿă-ḇā-ḏe-ḵā", "traducao_palavra": "e teus servos" },
        { "hebraico": "וְהֵבֵאתָ֙", "transliteral": "wə-hê-ḇê-ṯā", "traducao_palavra": "e recolherás" },
        { "hebraico": "וְהָיָ֨ה", "transliteral": "wə-hā-yā", "traducao_palavra": "e haverá" },
        { "hebraico": "לְḇֶן־אֲדֹנֶ֥יךָ", "transliteral": "lə-ḇen-ʾă-ḏō-ne-ḵā", "traducao_palavra": "para o filho de teu senhor" },
        { "hebraico": "לֶּ֙חֶם֙", "transliteral": "le-ḥem", "traducao_palavra": "alimento" },
        { "hebraico": "וַאֲכָלֹ֔ו", "transliteral": "wa-ʾă-ḵā-lô", "traducao_palavra": "e o comerá" },
        { "hebraico": "וּמְפִיבֹ֨שֶׁת", "transliteral": "ū-mə-p̄î-ḇō-šeṯ", "traducao_palavra": "e Mefibosete" },
        { "hebraico": "בֶּן־אֲדֹנֶ֙יךָ֙", "transliteral": "ben-ʾă-ḏō-ne-ḵā", "traducao_palavra": "filho de teu senhor" },
        { "hebraico": "יֹאכַ֥ל", "transliteral": "yō-ḵal", "traducao_palavra": "comerá" },
        { "hebraico": "תָּמִ֛יד", "transliteral": "tā-mîḏ", "traducao_palavra": "sempre" },
        { "hebraico": "לֶ֖חֶם", "transliteral": "le-ḥem", "traducao_palavra": "pão" },
        { "hebraico": "עַל־שֻׁלְחָנִ֑י", "transliteral": "ʿal-šul-ḥā-nî", "traducao_palavra": "sobre minha mesa" },
        { "hebraico": "וּלְצִיבָ֕א", "transliteral": "ū-lə-ṣî-ḇā", "traducao_palavra": "e para Ziba" },
        { "hebraico": "חֲמִשָּׁ֥ה", "transliteral": "ḥă-miš-šā", "traducao_palavra": "cinco" },
        { "hebraico": "עָשָׂ֥ר", "transliteral": "ʿā-śār", "traducao_palavra": "dez [quinze]" },
        { "hebraico": "בָּנִ֖ים", "transliteral": "bā-nîm", "traducao_palavra": "filhos" },
        { "hebraico": "וְעֶשְׂרִ֥ים", "transliteral": "wə-ʿeś-rîm", "traducao_palavra": "e vinte" },
        { "hebraico": "עֲבָדִֽים׃", "transliteral": "wa-ʿă-ḇā-ḏîm", "traducao_palavra": "servos" }
      ]
    },
    "11": {
      "traducao_completa": "E disse Ziba ao rei: Conforme tudo quanto meu senhor o rei manda ao seu servo, assim fará o teu servo. E Mefibosete comia à minha mesa, como um dos filhos do rei.",
      "palavras": [
        { "hebraico": "וַיֹּ֤אמֶר", "transliteral": "way-yō-mer", "traducao_palavra": "e disse" },
        { "hebraico": "צִיבָא֙", "transliteral": "ṣî-ḇā", "traducao_palavra": "Ziba" },
        { "hebraico": "אֶל־הַמֶּ֔לֶךְ", "transliteral": "ʾel-ham-me-leḵ", "traducao_palavra": "ao rei" },
        { "hebraico": "כְּכֹל֩", "transliteral": "kə-ḵōl", "traducao_palavra": "como tudo" },
        { "hebraico": "אֲשֶׁ֨ר", "transliteral": "ʾă-šer", "traducao_palavra": "que" },
        { "hebraico": "יְצַוֶּ֜ה", "transliteral": "yə-ṣaw-weh", "traducao_palavra": "mandará" },
        { "hebraico": "אֲדֹנִ֤י", "transliteral": "ʾă-ḏō-nî", "traducao_palavra": "meu senhor" },
        { "hebraico": "הַמֶּ֙לֶךְ֙", "transliteral": "ham-me-leḵ", "traducao_palavra": "o rei" },
        { "hebraico": "אֶת־עַבְדֹּ֔ו", "transliteral": "ʾeṯ-ʿaḇ-dô", "traducao_palavra": "a seu servo" },
        { "hebraico": "כֵּ֖ן", "transliteral": "kên", "traducao_palavra": "assim" },
        { "hebraico": "יַעֲשֶׂ֣ה", "transliteral": "ya-ʿă-śeh", "traducao_palavra": "fará" },
        { "hebraico": "עַבְדֶּ֑ךָ", "transliteral": "ʿaḇ-de-ḵā", "traducao_palavra": "teu servo" },
        { "hebraico": "וּמְפִיבֹ֗שֶׁת", "transliteral": "ū-mə-p̄î-ḇō-šeṯ", "traducao_palavra": "e Mefibosete" },
        { "hebraico": "אֹכֵל֙", "transliteral": "ʾō-ḵēl", "traducao_palavra": "comendo" },
        { "hebraico": "עַל־שֻׁלְחָנִ֔י", "transliteral": "ʿal-šul-ḥā-nî", "traducao_palavra": "sobre minha mesa [do rei]" },
        { "hebraico": "כְּאַחַ֖ד", "transliteral": "kə-ʾa-ḥaḏ", "traducao_palavra": "como um" },
        { "hebraico": "מִבְּנֵ֥י", "transliteral": "mib-bə-nê", "traducao_palavra": "dos filhos de" },
        { "hebraico": "הַמֶּֽלֶךְ׃", "transliteral": "ham-me-leḵ", "traducao_palavra": "o rei" }
      ]
    },
    "12": {
      "traducao_completa": "E tinha Mefibosete um filho pequeno, cujo nome era Mica. E todos os que habitavam na casa de Ziba eram servos de Mefibosete.",
      "palavras": [
        { "hebraico": "וּלְמְפִיבֹ֥שֶׁת", "transliteral": "ū-lə-mə-p̄î-ḇō-šeṯ", "traducao_palavra": "e para Mefibosete" },
        { "hebraico": "בֵּן־קָטָ֖ן", "transliteral": "bên-qā-ṭān", "traducao_palavra": "[havia] um filho pequeno" },
        { "hebraico": "וּשְׁמֹ֣ו", "transliteral": "ū-šə-mô", "traducao_palavra": "e o nome dele" },
        { "hebraico": "מִיכָ֑א", "transliteral": "mî-ḵā", "traducao_palavra": "Mica" },
        { "hebraico": "וְכֹל֙", "transliteral": "wə-ḵōl", "traducao_palavra": "e todos" },
        { "hebraico": "מֹושַׁ֣ב", "transliteral": "mô-šaḇ", "traducao_palavra": "[os do] habitar de" },
        { "hebraico": "בֵּית־צִיבָ֔א", "transliteral": "bêṯ-ṣî-ḇā", "traducao_palavra": "casa de Ziba" },
        { "hebraico": "עֲבָדִ֖ים", "transliteral": "ʿă-ḇā-ḏîm", "traducao_palavra": "[eram] servos" },
        { "hebraico": "לִמְפִיבֹֽשֶׁת׃", "transliteral": "lim-p̄î-ḇō-šeṯ", "traducao_palavra": "de Mefibosete" }
      ]
    },
    "13": {
      "traducao_completa": "E morava Mefibosete em Jerusalém, porquanto sempre comia à mesa do rei, e era coxo de ambos os pés.",
      "palavras": [
        { "hebraico": "וּמְפִיבֹ֗שֶׁת", "transliteral": "ū-mə-p̄î-ḇō-šeṯ", "traducao_palavra": "e Mefibosete" },
        { "hebraico": "יֹשֵׁב֙", "transliteral": "yō-šēḇ", "traducao_palavra": "habitava" },
        { "hebraico": "בִּיר֣וּשָׁלִַ֔ם", "transliteral": "bî-rû-šā-la-yim", "traducao_palavra": "em Jerusalém" },
        { "hebraico": "כִּ֣י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "עַל־שֻׁלְחַ֥ן", "transliteral": "ʿal-šul-ḥan", "traducao_palavra": "sobre a mesa de" },
        { "hebraico": "הַמֶּ֖לֶךְ", "transliteral": "ham-me-leḵ", "traducao_palavra": "o rei" },
        { "hebraico": "ה֣וּא", "transliteral": "hû", "traducao_palavra": "ele" },
        { "hebraico": "אֹכֵ֣ל", "transliteral": "ʾō-ḵêl", "traducao_palavra": "comia" },
        { "hebraico": "תָּמִ֑יד", "transliteral": "tā-mîḏ", "traducao_palavra": "sempre" },
        { "hebraico": "וְה֥וּא", "transliteral": "wə-hû", "traducao_palavra": "e ele" },
        { "hebraico": "פִסֵּ֖חַ", "transliteral": "p̄is-sē-aḥ", "traducao_palavra": "[era] coxo de" },
        { "hebraico": "שְׁתֵּ֥י", "transliteral": "šə-tê", "traducao_palavra": "duas" },
        { "hebraico": "רַגְלָֽיו׃", "transliteral": "raḡ-lāyw", "traducao_palavra": "seus pés" }
