        { "hebraico": "הִקְדִּ֔ישׁ", "transliteral": "hiq-dîš", "traducao_palavra": "consagrara" },
        { "hebraico": "מִכָּל־הַגֹּויִ֖ם", "transliteral": "mik-kāl-hag-gô-yim", "traducao_palavra": "de todas as nações" },
