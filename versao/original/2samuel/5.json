        { "hebraico": "הַה֖וּא", "transliteral": "ha-hû", "traducao_palavra": "aquele" },
        { "hebraico": "בַּ֥עַל", "transliteral": "ba-ʿal", "traducao_palavra": "Baal-" },
        { "hebraico": "פְּרָצִֽים׃", "transliteral": "pə-rā-ṣîm", "traducao_palavra": "Perazim" }
      ]
    },
    "21": {
      "traducao_completa": "E deixaram ali os seus ídolos; e Davi e os seus homens os tomaram.",
      "palavras": [
