        { "hebraico": "וְחָרָשֵׁ֖י", "transliteral": "wə-ḥā-rā-šê", "traducao_palavra": "e artesãos de" },
        { "hebraico": "אֶ֣בֶן", "transliteral": "ʾe-ḇen", "traducao_palavra": "pedra" },
        { "hebraico": "קִ֑יר", "transliteral": "qîr", "traducao_palavra": "parede" },
        { "hebraico": "וַיִּבְנוּ־בַ֖יִת", "transliteral": "way-yiḇ-nû-ḇa-yiṯ", "traducao_palavra": "e edificaram uma casa" },
