        { "hebraico": "שְׁמֹ֧ות", "transliteral": "šə-môṯ", "traducao_palavra": "nomes de" },
        { "hebraico": "הַיִּלֹּדִ֛ים", "transliteral": "hay-yil-lō-ḏîm", "traducao_palavra": "os nascidos" },
        { "hebraico": "לֹ֖ו", "transliteral": "lô", "traducao_palavra": "a ele" },
        { "hebraico": "בִּירוּשָׁלִָ֑ם", "transliteral": "bî-rû-šā-lā-yim", "traducao_palavra": "em Jerusalém" },
