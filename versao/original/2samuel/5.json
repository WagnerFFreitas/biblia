        { "hebraico": "אֶת־דָּוִ֤ד", "transliteral": "ʾeṯ-ḏā-wiḏ", "traducao_palavra": "a Davi" },
        { "hebraico": "לְמֶ֙לֶךְ֙", "transliteral": "lə-me-leḵ", "traducao_palavra": "para rei" },
        { "hebraico": "עַל־יִשְׂרָאֵ֔ל", "transliteral": "ʿal-yiś-rā-ʾēl", "traducao_palavra": "sobre Israel" },
        { "hebraico": "וַיַּעֲל֥וּ", "transliteral": "way-ya-ʿă-lû", "traducao_palavra": "e subiram" },
        { "hebraico": "כָל־פְּלִשְׁתִּ֖ים", "transliteral": "ḵāl-pə-liš-tîm", "traducao_palavra": "todos os filisteus" },
        { "hebraico": "לְבַקֵּ֣שׁ", "transliteral": "lə-ḇaq-qēš", "traducao_palavra": "para buscar" },
        { "hebraico": "אֶת־דָּוִ֑ד", "transliteral": "ʾeṯ-ḏā-wiḏ", "traducao_palavra": "a Davi" },
        { "hebraico": "וַיִּשְׁמַ֣ע", "transliteral": "way-yiš-maʿ", "traducao_palavra": "e ouviu" },
        { "hebraico": "דָּוִ֔ד", "transliteral": "ḏā-wiḏ", "traducao_palavra": "Davi" },
        { "hebraico": "וַיֵּ֖רֶד", "transliteral": "way-yê-reḏ", "traducao_palavra": "e desceu" },
        { "hebraico": "אֶל־הַמְּצֻדָֽה׃", "transliteral": "ʾel-ham-mə-ṣu-ḏā", "traducao_palavra": "à fortaleza" }
      ]
