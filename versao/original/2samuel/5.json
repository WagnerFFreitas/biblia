        { "hebraico": "הֲתִתְּנֵ֖ם", "transliteral": "hă-ṯit-tə-nêm", "traducao_palavra": "darás eles" },
        { "hebraico": "בְּיָדִ֑י", "transliteral": "bə-yā-ḏî", "traducao_palavra": "na minha mão?" },
        { "hebraico": "וַיֹּ֨אמֶר", "transliteral": "way-yō-mer", "traducao_palavra": "e disse" },
        { "hebraico": "יְהוָ֤ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "אֶל־דָּוִד֙", "transliteral": "ʾel-ḏā-wiḏ", "traducao_palavra": "a Davi" },
        { "hebraico": "עֲלֵ֔ה", "transliteral": "ʿă-lēh", "traducao_palavra": "sobe" },
        { "hebraico": "כִּֽי־נָתֹ֥ן", "transliteral": "kî-nā-ṯōn", "traducao_palavra": "pois entregando" },
        { "hebraico": "אֶתֵּ֛ן", "transliteral": "ʾet-tên", "traducao_palavra": "entregarei" },
        { "hebraico": "אֶת־הַפְּלִשְׁתִּ֖ים", "transliteral": "ʾeṯ-hap-pə-liš-tîm", "traducao_palavra": "os filisteus" },
        { "hebraico": "בְּיָדֶֽךָ׃", "transliteral": "bə-yā-ḏe-ḵā", "traducao_palavra": "na tua mão" }
      ]
    },
    "20": {
      "traducao_completa": "Então foi Davi a Baal-Perazim; e feriu-os ali Davi, e disse: Rompeu YHWH a meus inimigos diante de mim, como quem rompe águas. Por isso chamou o nome daquele lugar Baal-Perazim.",
