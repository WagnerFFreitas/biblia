    "19": {
      "traducao_completa": "E Davi consultou a YHWH, dizendo: Subirei contra os filisteus? Entregar-me-ás nas minhas mãos? E disse YHWH a Davi: Sobe, porque certamente entregarei os filisteus nas tuas mãos.",
      "palavras": [
        { "hebraico": "וַיִּשְׁאַ֨ל", "transliteral": "way-yiš-ʾal", "traducao_palavra": "e consultou" },
        { "hebraico": "דָּוִ֤ד", "transliteral": "ḏā-wiḏ", "traducao_palavra": "Davi" },
        { "hebraico": "בַּיהוָה֙", "transliteral": "ba-YHWH", "traducao_palavra": "em YHWH" },
        { "hebraico": "לֵאמֹ֔ר", "transliteral": "lê-mōr", "traducao_palavra": "dizendo" },
        { "hebraico": "הַאֶעֱלֶה֙", "transliteral": "ha-ʾe-ʿĕ-leh", "traducao_palavra": "subirei?" },
