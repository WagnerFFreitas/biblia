        { "hebraico": "וַיָּבֹ֨א", "transliteral": "way-yā-ḇō", "traducao_palavra": "e veio" },
        { "hebraico": "דָוִ֜ד", "transliteral": "ḏā-wiḏ", "traducao_palavra": "Davi" },
        { "hebraico": "בְּבַֽעַל־פְּרָצִים֮", "transliteral": "bə-ḇa-ʿal-pə-rā-ṣîm", "traducao_palavra": "em Baal-Perazim" },
        { "hebraico": "וַיַּכֵּ֣ם", "transliteral": "way-yak-kêm", "traducao_palavra": "e feriu-os" },
        { "hebraico": "שָׁם֮", "transliteral": "šām", "traducao_palavra": "ali" },
        { "hebraico": "דָּוִד֒", "transliteral": "ḏā-wiḏ", "traducao_palavra": "Davi" },
        { "hebraico": "וַיֹּ֕אמֶר", "transliteral": "way-yō-mer", "traducao_palavra": "e disse" },
        { "hebraico": "פָּרַ֨ץ", "transliteral": "pā-raṣ", "traducao_palavra": "rompeu/irrompeu" },
        { "hebraico": "יְהוָ֧ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "אֶת־אֹיְבַ֛י", "transliteral": "ʾeṯ-ʾō-yə-ḇay", "traducao_palavra": "meus inimigos" },
        { "hebraico": "לְפָנַ֖י", "transliteral": "lə-p̄ā-nay", "traducao_palavra": "diante de mim" },
        { "hebraico": "כְּפֶ֣רֶץ", "transliteral": "kə-p̄e-reṣ", "traducao_palavra": "como ruptura de" },
        { "hebraico": "מָ֑יִם", "transliteral": "mā-yim", "traducao_palavra": "águas" },
        { "hebraico": "עַל־כֵּ֗ן", "transliteral": "ʿal-kên", "traducao_palavra": "sobre isso/por isso" },
        { "hebraico": "קָרָ֛א", "transliteral": "qā-rā", "traducao_palavra": "chamou" },
