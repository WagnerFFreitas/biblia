        { "hebraico": "צַעֲדִ֖י", "transliteral": "ṣa-ʿă-ḏî", "traducao_palavra": "meu passo" },
        { "hebraico": "תַּחְתֵּ֑נִי", "transliteral": "ta-ḥə-tê-nî", "traducao_palavra": "debaixo de mim" },
        { "hebraico": "וְלֹ֥א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "מָעֲד֖וּ", "transliteral": "mā-ʿă-ḏû", "traducao_palavra": "escorregaram/vacilaram" },
