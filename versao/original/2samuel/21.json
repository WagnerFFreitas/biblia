        { "hebraico": "תְּרֹומְמֵ֔נִי", "transliteral": "tə-rô-mə-mê-nî", "traducao_palavra": "tu me exaltas" },
        { "hebraico": "מֵאִ֥ישׁ", "transliteral": "mê-ʾîš", "traducao_palavra": "do homem de" },
        { "hebraico": "חֲמָסִ֖ים", "transliteral": "ḥă-mā-śîm", "traducao_palavra": "violências" },
