        { "hebraico": "יִבֹּ֑לוּ", "transliteral": "yib-bō-lû", "traducao_palavra": "desfalecerão" },
        { "hebraico": "וְיַחְגְּר֖וּ", "transliteral": "wə-yaḥ-gə-rû", "traducao_palavra": "e sairão tremendo/cingindo-se" },
