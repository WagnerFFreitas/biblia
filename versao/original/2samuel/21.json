        { "hebraico": "לִ֑י", "transliteral": "lî", "traducao_palavra": "para mim" },
        { "hebraico": "וּמֹורִ֥id", "transliteral": "ū-mô-rîḏ", "traducao_palavra": "e abate/sujeita" },
        { "hebraico": "עַמִּ֖ים", "transliteral": "ʿam-mîm", "traducao_palavra": "povos" },
