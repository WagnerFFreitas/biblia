        { "hebraico": "סַלְעִ֛י", "transliteral": "sal-ʿî", "traducao_palavra": "meu rochedo" },
        { "hebraico": "וּמְצֻדָתִ֖י", "transliteral": "ū-mə-ṣu-ḏā-ṯî", "traducao_palavra": "e minha fortaleza" },
