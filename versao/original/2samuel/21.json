        { "hebraico": "לַמִּלְחָמָ֑ה", "transliteral": "lam-mil-ḥā-mā", "traducao_palavra": "para a batalha" },
        { "hebraico": "תַּכְרִ֥יעַ", "transliteral": "taḵ-rî-aʿ", "traducao_palavra": "fizeste curvar" },
        { "hebraico": "קָמַ֖י", "transliteral": "qā-may", "traducao_palavra": "os que se levantam contra mim" },
