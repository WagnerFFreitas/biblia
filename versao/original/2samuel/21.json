        { "hebraico": "מִמָּרֹ֖ום", "transliteral": "mim-mā-rôm", "traducao_palavra": "do alto" },
        { "hebraico": "יִקָּחֵ֑נִי", "transliteral": "yiq-qā-ḥê-nî", "traducao_palavra": "tomou-me" },
        { "hebraico": "יַמְשֵׁ֖נִי", "transliteral": "yam-šê-nî", "traducao_palavra": "tirou-me" },
        { "hebraico": "מִמַּ֥יִם", "transliteral": "mim-ma-yim", "traducao_palavra": "de águas" },
        { "hebraico": "רַבִּֽים׃", "transliteral": "rab-bîm", "traducao_palavra": "muitas" }
      ]
    },
    "18": {
      "traducao_completa": "Livrou-me do meu poderoso inimigo, e daqueles que me odiavam, porque eram mais fortes do que eu.",
      "palavras": [
        { "hebraico": "יַצִּילֵ֕נִי", "transliteral": "yaṣ-ṣî-lê-nî", "traducao_palavra": "livrou-me" },
        { "hebraico": "מֵאֹיְבִ֖י", "transliteral": "mê-ʾō-yə-ḇî", "traducao_palavra": "do meu inimigo" },
        { "hebraico": "עָ֑ז", "transliteral": "ʿāz", "traducao_palavra": "forte" },
        { "hebraico": "מִשֹּׂנְאַ֕י", "transliteral": "miś-śō-nə-ʾay", "traducao_palavra": "daqueles que me odeiam" },
        { "hebraico": "כִּ֥י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "אָמְצ֖וּ", "transliteral": "ʾā-mə-ṣû", "traducao_palavra": "foram fortes" },
        { "hebraico": "מִמֶּֽנִּי׃", "transliteral": "mim-men-nî", "traducao_palavra": "mais que eu" }
      ]
    },
    "19": {
      "traducao_completa": "Sobrevieram-me no dia da minha calamidade; porém YHWH foi o meu amparo.",
      "palavras": [
        { "hebraico": "יְקַדְּמֻ֖נִי", "transliteral": "yə-qad-də-mu-nî", "traducao_palavra": "sobrevieram-me" },
        { "hebraico": "בְּיֹ֣ום", "transliteral": "bə-yôm", "traducao_palavra": "no dia de" },
        { "hebraico": "אֵידִ֑י", "transliteral": "ʾê-ḏî", "traducao_palavra": "minha calamidade" },
        { "hebraico": "וַיְהִ֧י", "transliteral": "way-hî", "traducao_palavra": "e foi" },
        { "hebraico": "יְהוָ֛ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "מִשְׁעָ֖ן", "transliteral": "miš-ʿān", "traducao_palavra": "amparo" },
        { "hebraico": "לִֽי׃", "transliteral": "lî", "traducao_palavra": "para mim" }
      ]
    },
    "20": {
      "traducao_completa": "E tirou-me para um lugar largo, e livrou-me, porque tinha prazer em mim.",
      "palavras": [
        { "hebraico": "וַיֹּוצֵ֥א", "transliteral": "way-yô-ṣê", "traducao_palavra": "e tirou-me" },
        { "hebraico": "לַמֶּרְחָ֖ב", "transliteral": "lam-mer-ḥāḇ", "traducao_palavra": "para o largo" },
        { "hebraico": "אֹתִ֑י", "transliteral": "ʾō-ṯî", "traducao_palavra": "me" },
        { "hebraico": "יְחַלְּצֵ֖נִי", "transliteral": "yə-ḥal-lə-ṣê-nî", "traducao_palavra": "livrou-me ele" },
        { "hebraico": "כִּי־חָ֥פֵֽץ", "transliteral": "kî-ḥā-p̄êṣ", "traducao_palavra": "porque teve prazer" },
        { "hebraico": "בִּֽי׃", "transliteral": "bî", "traducao_palavra": "em mim" }
      ]
    },
    "21": {
      "traducao_completa": "Retribuiu-me YHWH conforme a minha justiça; conforme a pureza das minhas mãos me recompensou.",
      "palavras": [
        { "hebraico": "יִגְמְלֵ֥נִי", "transliteral": "yiḡ-mə-lê-nî", "traducao_palavra": "retribuiu-me" },
        { "hebraico": "יְהוָ֖ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "כְּצִדְקָתִ֑י", "transliteral": "kə-ṣiḏ-qā-ṯî", "traducao_palavra": "conforme minha justiça" },
        { "hebraico": "כְּבֹ֥ר", "transliteral": "kə-ḇōr", "traducao_palavra": "conforme a pureza de" },
        { "hebraico": "יָדַ֖י", "transliteral": "yā-ḏay", "traducao_palavra": "minhas mãos" },
        { "hebraico": "יָשִׁ֥יב", "transliteral": "yā-šîḇ", "traducao_palavra": "recompensou" },
        { "hebraico": "לִֽי׃", "transliteral": "lî", "traducao_palavra": "a mim" }
      ]
    },
    "22": {
      "traducao_completa": "Porque guardei os caminhos de YHWH, e não me apartei impiamente do meu Deus.",
      "palavras": [
        { "hebraico": "כִּ֣י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "שָׁמַ֔רְתִּי", "transliteral": "šā-mar-tî", "traducao_palavra": "guardei" },
        { "hebraico": "דַּרְכֵ֖י", "transliteral": "dar-ḵê", "traducao_palavra": "[os] caminhos de" },
        { "hebraico": "יְהוָ֑ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "וְלֹא־רָשַׁ֖עְתִּי", "transliteral": "wə-lō-rā-ša-ʿtî", "traducao_palavra": "e não agi impiamente" },
        { "hebraico": "מֵאֱלֹהָֽי׃", "transliteral": "mê-ʾĕ-lō-hāy", "traducao_palavra": "contra meu Deus" }
      ]
    },
    "23": {
      "traducao_completa": "Porque todos os seus juízos estavam diante de mim, e de seus estatutos não me apartei.",
      "palavras": [
        { "hebraico": "כִּ֥י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "כָל־מִשְׁפָּטָ֖יו", "transliteral": "kāl-miš-pā-ṭāyw", "traducao_palavra": "todos os seus juízos" },
        { "hebraico": "לְנֶגְדִּ֑י", "transliteral": "lə-neḡ-dî", "traducao_palavra": "[estavam] diante de mim" },
        { "hebraico": "וְחֻקֹּתָ֖יו", "transliteral": "wə-ḥuq-qō-ṯāyw", "traducao_palavra": "e seus estatutos" },
        { "hebraico": "לֹא־אָס֥וּר", "transliteral": "lō-ʾā-sûr", "traducao_palavra": "não me desviei" },
        { "hebraico": "מִמֶּֽנָּה׃", "transliteral": "mim-men-nā", "traducao_palavra": "deles" }
      ]
    },
    "24": {
      "traducao_completa": "Fui também íntegro para com ele, e guardei-me da minha iniquidade.",
      "palavras": [
        { "hebraico": "וָאֶהְיֶ֥ה", "transliteral": "wā-ʾeh-yeh", "traducao_palavra": "e fui" },
        { "hebraico": "תָמִ֖ים", "transliteral": "ṯā-mîm", "traducao_palavra": "íntegro" },
        { "hebraico": "לֹ֑ו", "transliteral": "lô", "traducao_palavra": "para com ele" },
        { "hebraico": "וָאֶשְׁתַּמְּרָ֖ה", "transliteral": "wā-ʾeš-tam-mə-rā", "traducao_palavra": "e guardei-me" },
        { "hebraico": "מֵעֲוֹנִֽי׃", "transliteral": "mê-ʿă-wō-nî", "traducao_palavra": "da minha iniquidade" }
      ]
    },
    "25": {
      "traducao_completa": "E me retribuiu YHWH conforme a minha justiça; conforme a minha pureza diante dos seus olhos.",
      "palavras": [
        { "hebraico": "וַיָּשֶׁב֩", "transliteral": "way-yā-šeḇ", "traducao_palavra": "e retribuiu" },
        { "hebraico": "יְהוָ֨ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "לִ֜י", "transliteral": "lî", "traducao_palavra": "a mim" },
        { "hebraico": "כְּצִדְקָתִ֗י", "transliteral": "kə-ṣiḏ-qā-ṯî", "traducao_palavra": "conforme minha justiça" },
        { "hebraico": "כְּבֹרִ֖י", "transliteral": "kə-ḇō-rî", "traducao_palavra": "conforme minha pureza" },
        { "hebraico": "לְנֶ֥גֶד", "transliteral": "lə-ne-ḡeḏ", "traducao_palavra": "diante de" },
        { "hebraico": "עֵינָֽיו׃", "transliteral": "ʿê-nāyw", "traducao_palavra": "seus olhos" }
      ]
    },
    "26": {
      "traducao_completa": "Com o benigno te mostras benigno; com o homem íntegro te mostras íntegro.",
      "palavras": [
        { "hebraico": "עִם־חָסִ֖יד", "transliteral": "ʿim-ḥā-śîḏ", "traducao_palavra": "com o piedoso/benigno" },
        { "hebraico": "תִּתְחַסָּ֑ד", "transliteral": "tiṯ-ḥas-sāḏ", "traducao_palavra": "te mostras benigno" },
        { "hebraico": "עִם־גִּבֹּ֥ור", "transliteral": "ʿim-gib-bôr", "traducao_palavra": "com o homem" },
        { "hebraico": "תָּמִ֖ים", "transliteral": "ṯā-mîm", "traducao_palavra": "íntegro" },
        { "hebraico": "תִּתַּמָּֽם׃", "transliteral": "tit-tam-mām", "traducao_palavra": "te mostras íntegro" }
      ]
    },
    "27": {
      "traducao_completa": "Com o puro te mostras puro; e com o perverso te mostras astuto.",
      "palavras": [
        { "hebraico": "עִם־נָבָ֖ר", "transliteral": "ʿim-nā-ḇār", "traducao_palavra": "com o puro" },
        { "hebraico": "תִּתָּבָ֑ר", "transliteral": "tit-tā-ḇār", "traducao_palavra": "te mostras puro" },
        { "hebraico": "וְעִם־עִקֵּ֖שׁ", "transliteral": "wə-ʿim-ʿiq-qēš", "traducao_palavra": "e com o perverso" },
        { "hebraico": "תִּתַּפָּֽל׃", "transliteral": "tit-tap-pāl", "traducao_palavra": "te mostras tortuoso/astuto" }
      ]
    },
    "28": {
      "traducao_completa": "E o povo aflito salvas; mas teus olhos são contra os altivos, e tu os abaterás.",
      "palavras": [
        { "hebraico": "וְאֶת־עַ֥ם", "transliteral": "wə-ʾeṯ-ʿam", "traducao_palavra": "e ao povo" },
        { "hebraico": "עָנִ֖י", "transliteral": "ʿā-nî", "traducao_palavra": "aflito/pobre" },
        { "hebraico": "תֹּושִׁ֑יעַ", "transliteral": "tô-šî-aʿ", "traducao_palavra": "salvas" },
        { "hebraico": "וְעֵינֶ֙יךָ֙", "transliteral": "wə-ʿê-ne-ḵā", "traducao_palavra": "mas teus olhos [são]" },
        { "hebraico": "עַל־רָמִ֔ים", "transliteral": "ʿal-rā-mîm", "traducao_palavra": "sobre os altivos" },
        { "hebraico": "תַּשְׁפִּֽיל׃", "transliteral": "taš-pîl", "traducao_palavra": "[para] abater" }
      ]
    },
    "29": {
      "traducao_completa": "Porque tu és a minha lâmpada, ó YHWH; e YHWH ilumina as minhas trevas.",
      "palavras": [
        { "hebraico": "כִּֽי־אַתָּ֥ה", "transliteral": "kî-ʾat-tā", "traducao_palavra": "porque tu" },
        { "hebraico": "נֵירִ֖י", "transliteral": "nê-rî", "traducao_palavra": "[és] minha lâmpada" },
        { "hebraico": "יְהוָ֑ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "וַֽיהוָ֖ה", "transliteral": "wa-YHWH", "traducao_palavra": "e YHWH" },
        { "hebraico": "יַגִּ֥יהַּ", "transliteral": "yag-gî-ah", "traducao_palavra": "ilumina/faz brilhar" },
        { "hebraico": "חָשְׁכִּֽי׃", "transliteral": "ḥoš-kî", "traducao_palavra": "minha escuridão" }
      ]
    },
    "30": {
      "traducao_completa": "Porque contigo transponho uma tropa; com o meu Deus salto um muro.",
      "palavras": [
        { "hebraico": "כִּ֥י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "בְכָ֖ה", "transliteral": "ḇə-ḵā", "traducao_palavra": "contigo" },
        { "hebraico": "אָר֣וּץ", "transliteral": "ʾā-rûṣ", "traducao_palavra": "corro por/atravesso" },
        { "hebraico": "גְּד֑וּד", "transliteral": "gə-ḏûḏ", "traducao_palavra": "uma tropa/exército" },
        { "hebraico": "בֵּאלֹהַ֖י", "transliteral": "bê-lō-hay", "traducao_palavra": "com meu Deus" },
        { "hebraico": "אֲדַלֶּג־שֽׁוּר׃", "transliteral": "ʾă-ḏal-leḡ-šûr", "traducao_palavra": "salto um muro" }
      ]
    },
    "31": {
      "traducao_completa": "O caminho de Deus é íntegro, a palavra de YHWH é refinada; ele é o escudo de todos os que nele confiam.",
      "palavras": [
        { "hebraico": "הָאֵ֖ל", "transliteral": "hā-ʾēl", "traducao_palavra": "O Deus" },
        { "hebraico": "תָּמִ֣ים", "transliteral": "ṯā-mîm", "traducao_palavra": "[é] íntegro" },
        { "hebraico": "דַּרְכֹּ֑ו", "transliteral": "dar-kô", "traducao_palavra": "seu caminho" },
        { "hebraico": "אִמְרַ֤ת", "transliteral": "ʾim-raṯ", "traducao_palavra": "a palavra de" },
        { "hebraico": "יְהוָה֙", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "צְרוּפָ֔ה", "transliteral": "ṣə-rû-p̄ā", "traducao_palavra": "é refinada" },
        { "hebraico": "מָגֵ֣ן", "transliteral": "mā-ḡên", "traducao_palavra": "[é] escudo" },
        { "hebraico": "ה֧וּא", "transliteral": "hû", "traducao_palavra": "ele" },
        { "hebraico": "לְכֹ֥ל", "transliteral": "lə-ḵōl", "traducao_palavra": "para todos" },
        { "hebraico": "הַחֹסִ֖ים", "transliteral": "ha-ḥō-śîm", "traducao_palavra": "os que se refugiam" },
        { "hebraico": "בֹּֽו׃", "transliteral": "bô", "traducao_palavra": "nele" }
      ]
    },
    "32": {
      "traducao_completa": "Pois, quem é Deus, senão YHWH? E quem é rochedo, senão o nosso Deus?",
      "palavras": [
        { "hebraico": "כִּ֥י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "מִי־אֵ֖ל", "transliteral": "mî-ʾēl", "traducao_palavra": "quem [é] Deus" },
        { "hebraico": "מִבַּלְעֲדֵ֣י", "transliteral": "mib-bal-ʿă-ḏê", "traducao_palavra": "além de" },
        { "hebraico": "יְהוָ֑ה", "transliteral": "YHWH", "traducao_palavra": "YHWH?" },
        { "hebraico": "וּמִ֥י", "transliteral": "ū-mî", "traducao_palavra": "e quem" },
        { "hebraico": "צ֖וּר", "transliteral": "ṣûr", "traducao_palavra": "[é] rocha" },
        { "hebraico": "מִֽבַּלְעֲדֵ֥י", "transliteral": "mib-bal-ʿă-ḏê", "traducao_palavra": "além de" },
        { "hebraico": "אֱלֹהֵֽינוּ׃", "transliteral": "ʾĕ-lō-hê-nû", "traducao_palavra": "nosso Deus?" }
      ]
    },
    "33": {
      "traducao_completa": "Deus é a minha fortaleza e força; e ele torna perfeito o meu caminho.",
      "palavras": [
        { "hebraico": "הָאֵ֥ל", "transliteral": "hā-ʾēl", "traducao_palavra": "o Deus" },
        { "hebraico": "מָעוּזִּ֖י", "transliteral": "mā-ʿûz-zî", "traducao_palavra": "[é] minha fortaleza" },
        { "hebraico": "חָ֑יִל", "transliteral": "ḥā-yil", "traducao_palavra": "de força/vigor" },
        { "hebraico": "וַיַּתֵּ֥ר", "transliteral": "way-yat-têr", "traducao_palavra": "e ele abre/aplana" },
        { "hebraico": "תָּמִ֖ים", "transliteral": "ṯā-mîm", "traducao_palavra": "[torna] íntegro" },
        { "hebraico": "דרכו", "transliteral": "dar-kô", "traducao_palavra": "seu caminho [meu caminho - Qere]" }
      ]
    },
    "34": {
      "traducao_completa": "Faz os meus pés como os das cervas, e põe-me nos meus altos.",
      "palavras": [
        { "hebraico": "מְשַׁוֶּ֥ה", "transliteral": "mə-šaw-weh", "traducao_palavra": "fazendo iguais" },
        { "hebraico": "רגלו", "transliteral": "raḡ-lāw", "traducao_palavra": "seus pés [meus pés - Qere]" },
        { "hebraico": "כָּאַיָּלֹ֑ות", "transliteral": "kā-ʾay-yā-lôṯ", "traducao_palavra": "como os das cervas" },
        { "hebraico": "וְעַ֥ל", "transliteral": "wə-ʿal", "traducao_palavra": "e sobre" },
        { "hebraico": "בָּמֹותַ֖י", "transliteral": "bā-mô-ṯay", "traducao_palavra": "meus altos" },
        { "hebraico": "יַעֲמִדֵֽנִי׃", "transliteral": "ya-ʿă-mi-ḏê-nî", "traducao_palavra": "põe-me em pé" }
      ]
    },
    "35": {
      "traducao_completa": "Ensina as minhas mãos para a peleja, de sorte que um arco de bronze é quebrado pelos meus braços.",
      "palavras": [
        { "hebraico": "מְלַמֵּ֥id", "transliteral": "mə-lam-mêḏ", "traducao_palavra": "ensinando" },
        { "hebraico": "יָדַ֖י", "transliteral": "yā-ḏay", "traducao_palavra": "minhas mãos" },
        { "hebraico": "לַמִּלְחָמָ֑ה", "transliteral": "lam-mil-ḥā-mā", "traducao_palavra": "para a batalha" },
        { "hebraico": "וְנִחַ֥ת", "transliteral": "wə-ni-ḥaṯ", "traducao_palavra": "e verga/quebra" },
        { "hebraico": "קֶֽשֶׁת־נְחוּשָׁ֖ה", "transliteral": "qe-šeṯ-nə-ḥû-šā", "traducao_palavra": "um arco de bronze" },
        { "hebraico": "זְרֹעֹתָֽי׃", "transliteral": "zə-rō-ʿō-ṯāy", "traducao_palavra": "meus braços" }
      ]
    },
    "36": {
      "traducao_completa": "Também me deste o escudo da tua salvação; e a tua mansidão me engrandeceu.",
      "palavras": [
        { "hebraico": "וַתִּתֶּן־לִ֖י", "transliteral": "wat-tit-ten-lî", "traducao_palavra": "e deste a mim" },
        { "hebraico": "מָגֵ֣ן", "transliteral": "mā-ḡên", "traducao_palavra": "o escudo de" },
        { "hebraico": "יִשְׁעֶ֑ךָ", "transliteral": "yiš-ʿe-ḵā", "traducao_palavra": "tua salvação" },
        { "hebraico": "וַעֲנֹתְךָ֖", "transliteral": "wa-ʿă-nō-ṯə-ḵā", "traducao_palavra": "e tua condescendência/mansidão" },
