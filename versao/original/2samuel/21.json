        { "hebraico": "מֹשִׁ֑יעַ", "transliteral": "mō-šî-aʿ", "traducao_palavra": "salvador" },
        { "hebraico": "אֶל־יְהוָ֖ה", "transliteral": "ʾel-YHWH", "traducao_palavra": "para YHWH" },
        { "hebraico": "וְלֹ֥א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
