        { "hebraico": "מגדל", "transliteral": "miḡ-dal", "traducao_palavra": "torre de [Qere: miḡ-dôl - engrandece]" },
        { "hebraico": "יְשׁוּעֹ֥ות", "transliteral": "yə-šû-ʿôṯ", "traducao_palavra": "salvações de" },
        { "hebraico": "מַלְכֹּ֑ו", "transliteral": "mal-kô", "traducao_palavra": "seu rei" },
        { "hebraico": "וְעֹ֤שֶׂה", "transliteral": "wə-ʿō-śeh", "traducao_palavra": "e fazendo" },
        { "hebraico": "חֶ֙סֶד֙", "transliteral": "ḥe-seḏ", "traducao_palavra": "bondade" },
        { "hebraico": "לִמְשִׁיחֹ֔ו", "transliteral": "lim-šî-ḥô", "traducao_palavra": "para seu ungido" },
        { "hebraico": "לְדָוִ֥id", "transliteral": "lə-ḏā-wiḏ", "traducao_palavra": "para Davi" },
        { "hebraico": "וּלְזַרְעֹ֖ו", "transliteral": "ū-lə-zar-ʿô", "traducao_palavra": "e para sua semente" },
        { "hebraico": "עַד־עֹולָֽם׃", "transliteral": "ʿaḏ-ʿô-lām", "traducao_palavra": "até a eternidade" }
