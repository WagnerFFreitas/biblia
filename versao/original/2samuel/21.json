      ]
    },
    "38": {
      "traducao_completa": "Persegui os meus inimigos, e os destruí, e não voltei até que os consumi.",
      "palavras": [
        { "hebraico": "אֶרְדְּפָ֥ה", "transliteral": "ʾer-də-p̄ā", "traducao_palavra": "persegui" },
        { "hebraico": "אֹיְבַ֖י", "transliteral": "ʾō-yə-ḇay", "traducao_palavra": "meus inimigos" },
        { "hebraico": "וָאַשְׁמִידֵ֑ם", "transliteral": "wā-ʾaš-mî-ḏêm", "traducao_palavra": "e os destruí" },
        { "hebraico": "וְלֹ֥א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "אָשׁ֖וּב", "transliteral": "ʾā-šûḇ", "traducao_palavra": "voltei" },
        { "hebraico": "עַד־כַּלֹּותָֽם׃", "transliteral": "ʿaḏ-kal-lô-ṯām", "traducao_palavra": "até consumi-los" }
      ]
    },
    "39": {
      "traducao_completa": "E os consumi, e os atravessei, de modo que não puderam levantar-se; caíram debaixo dos meus pés.",
      "palavras": [
        { "hebraico": "וָאֲכַלֵּ֥ם", "transliteral": "wā-ʾă-ḵal-lêm", "traducao_palavra": "e os consumi" },
        { "hebraico": "וָאֶמְחָצֵ֖ם", "transliteral": "wā-ʾem-ḥā-ṣêm", "traducao_palavra": "e os traspassei" },
        { "hebraico": "וְלֹ֣א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "יְקוּמ֑וּן", "transliteral": "yə-qû-mûn", "traducao_palavra": "levantaram-se" },
        { "hebraico": "וַיִּפְּל֖וּ", "transliteral": "way-yip-pə-lû", "traducao_palavra": "e caíram" },
