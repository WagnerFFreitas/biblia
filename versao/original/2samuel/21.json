        { "hebraico": "לִּ֣י", "transliteral": "lî", "traducao_palavra": "a mim" },
        { "hebraico": "עֹ֑רֶף", "transliteral": "ʿō-rep̄", "traducao_palavra": "[o] pescoço" },
        { "hebraico": "מְשַׂנְאַ֖י", "transliteral": "mə-śan-ʾay", "traducao_palavra": "meus odiadores" },
