        { "hebraico": "יְהוָ֖ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "בַּגֹּויִ֑ם", "transliteral": "bag-gô-yim", "traducao_palavra": "entre as nações" },
        { "hebraico": "וּלְשִׁמְךָ֖", "transliteral": "ū-lə-šim-ḵā", "traducao_palavra": "e ao teu nome" },
