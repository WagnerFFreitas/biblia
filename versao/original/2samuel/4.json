        { "hebraico": "נְקָמֹ֖ות", "transliteral": "nə-qā-môṯ", "traducao_palavra": "vinganças" },
        { "hebraico": "הַיֹּ֣ום", "transliteral": "hay-yôm", "traducao_palavra": "hoje" },
        { "hebraico": "הַזֶּ֑ה", "transliteral": "haz-zeh", "traducao_palavra": "este" },
        { "hebraico": "מִשָּׁא֖וּל", "transliteral": "miš-šā-ʾûl", "traducao_palavra": "de Saul" },
        { "hebraico": "וּמִזַּרְעֹֽו׃", "transliteral": "ū-miz-zar-ʿô", "traducao_palavra": "e de sua semente" }
      ]
    },
    "9": {
      "traducao_completa": "E respondeu Davi a Recabe e a Baaná, seu irmão, filhos de Rimom, o beerotita, e disse-lhes: Vive YHWH, que remiu a minha alma de toda a angústia,",
      "palavras": [
        { "hebraico": "וַיַּ֨עַן", "transliteral": "way-ya-ʿan", "traducao_palavra": "e respondeu" },
        { "hebraico": "דָּוִ֜ד", "transliteral": "ḏā-wiḏ", "traducao_palavra": "Davi" },
        { "hebraico": "אֶת־רֵכָ֣ב ׀", "transliteral": "ʾeṯ-rê-ḵāḇ", "traducao_palavra": "a Recabe" },
        { "hebraico": "וְאֶת־בַּעֲנָ֨ה", "transliteral": "wə-ʾeṯ-ba-ʿă-nā", "traducao_palavra": "e a Baaná" },
        { "hebraico": "אָחִ֗יו", "transliteral": "ʾā-ḥîw", "traducao_palavra": "seu irmão" },
        { "hebraico": "בְּנֵי֙", "transliteral": "bə-nê", "traducao_palavra": "filhos de" },
        { "hebraico": "רִמֹּ֣ון", "transliteral": "rim-mō-wn", "traducao_palavra": "Rimom" },
        { "hebraico": "הַבְּאֵרֹתִ֔י", "transliteral": "hab-bə-ʾê-rō-ṯî", "traducao_palavra": "o beerotita" },
        { "hebraico": "וַיֹּ֣אמֶר", "transliteral": "way-yō-mer", "traducao_palavra": "e disse" },
        { "hebraico": "לָהֶ֑ם", "transliteral": "lā-hem", "traducao_palavra": "a eles" },
        { "hebraico": "חַי־יְהוָ֕ה", "transliteral": "ḥay-YHWH", "traducao_palavra": "vive YHWH" },
        { "hebraico": "אֲשֶׁר־פָּדָ֥ה", "transliteral": "ʾă-šer-pā-ḏā", "traducao_palavra": "que remiu" },
        { "hebraico": "אֶת־נַפְשִׁ֖י", "transliteral": "ʾeṯ-nap̄-šî", "traducao_palavra": "minha alma" },
        { "hebraico": "מִכָּל־צָרָֽה׃", "transliteral": "mik-kāl-ṣā-rā", "traducao_palavra": "de toda angústia" }
      ]
    },
    "10": {
      "traducao_completa": "Se aquele que me trouxe novas, dizendo: Eis que Saul é morto, cuidando que trazia boas novas, eu o prendi, e o matei em Ziclague, o que foi o galardão que lhe dei pelas suas novas,",
      "palavras": [
        { "hebraico": "כִּ֣י", "transliteral": "kî", "traducao_palavra": "pois" },
        { "hebraico": "הַמַּגִּ֨יד", "transliteral": "ham-mag-gîḏ", "traducao_palavra": "o que trazia novas" },
        { "hebraico": "לִ֤י", "transliteral": "lî", "traducao_palavra": "a mim" },
        { "hebraico": "לֵאמֹר֙", "transliteral": "lê-mōr", "traducao_palavra": "dizendo" },
        { "hebraico": "הִנֵּה־מֵ֣ת", "transliteral": "hin-nēh-mēṯ", "traducao_palavra": "eis que morreu" },
        { "hebraico": "שָׁא֔וּל", "transliteral": "šā-ʾûl", "traducao_palavra": "Saul" },
        { "hebraico": "וְהוּא־הָיָ֥ה", "transliteral": "wə-hû-hā-yā", "traducao_palavra": "e ele era/foi" },
        { "hebraico": "כִמְבַשֵּׂ֖ר", "transliteral": "ḵim-ḇaś-śēr", "traducao_palavra": "como quem traz boas novas" },
        { "hebraico": "בְּעֵינָ֑יו", "transliteral": "bə-ʿê-nāyw", "traducao_palavra": "aos olhos dele" },
        { "hebraico": "וָאֹחֲזָ֣ה", "transliteral": "wā-ʾō-ḥă-zā", "traducao_palavra": "e eu segurei" },
        { "hebraico": "בֹ֔ו", "transliteral": "bô", "traducao_palavra": "nele" },
        { "hebraico": "וָאֶהְרְגֵ֙הוּ֙", "transliteral": "wā-ʾeh-rə-ḡê-hû", "traducao_palavra": "e o matei" },
        { "hebraico": "בְּצִקְלָ֔ג", "transliteral": "bə-ṣiq-lāḡ", "traducao_palavra": "em Ziclague" },
        { "hebraico": "אֲשֶׁ֥ר", "transliteral": "ʾă-šer", "traducao_palavra": "que" },
        { "hebraico": "לְתִתִּי־לֹ֖ו", "transliteral": "lə-ṯit-tî-lô", "traducao_palavra": "para o meu dar a ele" },
        { "hebraico": "בְּשֹׂרָֽה׃", "transliteral": "bə-śō-rā", "traducao_palavra": "a recompensa da nova" }
      ]
    },
    "11": {
      "traducao_completa": "Quanto mais a homens ímpios, que mataram a um homem justo em sua casa, sobre o seu leito; agora, pois, não requereria eu o seu sangue de vossas mãos, e não vos tiraria eu da terra?",
      "palavras": [
        { "hebraico": "אַ֧ף", "transliteral": "ʾap̄", "traducao_palavra": "quanto mais" },
        { "hebraico": "כִּֽי־אֲנָשִׁ֣ים", "transliteral": "kî-ʾă-nā-šîm", "traducao_palavra": "que homens" },
        { "hebraico": "רְשָׁעִ֗ים", "transliteral": "rə-šā-ʿîm", "traducao_palavra": "ímpios" },
        { "hebraico": "הָרְג֧וּ", "transliteral": "hā-rə-ḡû", "traducao_palavra": "mataram" },
        { "hebraico": "אֶת־אִֽישׁ־צַדִּ֛יק", "transliteral": "ʾeṯ-ʾîš-ṣad-dîq", "traducao_palavra": "a homem justo" },
        { "hebraico": "בְּבֵיתֹ֖ו", "transliteral": "bə-ḇê-ṯô", "traducao_palavra": "em sua casa" },
        { "hebraico": "עַל־מִשְׁכָּבֹ֑ו", "transliteral": "ʿal-miš-kā-ḇô", "traducao_palavra": "sobre seu leito" },
        { "hebraico": "וְעַתָּ֗ה", "transliteral": "wə-ʿat-tā", "traducao_palavra": "e agora" },
        { "hebraico": "הֲלֹ֨וא", "transliteral": "hă-lô", "traducao_palavra": "não" },
        { "hebraico": "אֲבַקֵּ֤שׁ", "transliteral": "ʾă-ḇaq-qēš", "traducao_palavra": "requererei/buscarei" },
        { "hebraico": "אֶת־דָּמֹו֙", "transliteral": "ʾeṯ-dā-mô", "traducao_palavra": "o seu sangue" },
        { "hebraico": "מִיֶּדְכֶ֔ם", "transliteral": "miy-yeḏ-ḵem", "traducao_palavra": "de vossa mão" },
        { "hebraico": "וּבִעַרְתִּ֥י", "transliteral": "ū-ḇi-ʿar-tî", "traducao_palavra": "e [vos] eliminarei/limparei" },
        { "hebraico": "אֶתְכֶ֖ם", "transliteral": "ʾeṯ-ḵem", "traducao_palavra": "vós" },
        { "hebraico": "מִן־הָאָֽרֶץ׃", "transliteral": "min-hā-ʾā-reṣ", "traducao_palavra": "da terra" }
      ]
    },
    "12": {
      "traducao_completa": "E deu Davi ordem aos seus moços que os matassem; e cortaram-lhes as mãos e os pés, e os penduraram sobre o tanque de Hebrom; tomaram, porém, a cabeça de Isbosete, e a sepultaram na sepultura de Abner, em Hebrom.",
      "palavras": [
        { "hebraico": "וַיְצַ֨ו", "transliteral": "way-ṣaw", "traducao_palavra": "e ordenou" },
        { "hebraico": "דָּוִ֜ד", "transliteral": "ḏā-wiḏ", "traducao_palavra": "Davi" },
        { "hebraico": "אֶת־הַנְּעָרִ֗ים", "transliteral": "ʾeṯ-han-nə-ʿā-rîm", "traducao_palavra": "os moços" },
        { "hebraico": "וַֽיַּהַרְג֑וּם", "transliteral": "way-ya-har-ḡûm", "traducao_palavra": "e mataram-nos" },
        { "hebraico": "וַֽיְקַצְּצ֤וּ", "transliteral": "way-qaṣ-ṣə-ṣû", "traducao_palavra": "e cortaram" },
        { "hebraico": "אֶת־יְדֵיהֶם֙", "transliteral": "ʾeṯ-yə-ḏê-hem", "traducao_palavra": "suas mãos" },
        { "hebraico": "וְאֶת־רַגְלֵיהֶ֔ם", "transliteral": "wə-ʾeṯ-raḡ-lê-hem", "traducao_palavra": "e seus pés" },
        { "hebraico": "וַיִּתְלוּ֙", "transliteral": "way-yit-lû", "traducao_palavra": "e penduraram" },
        { "hebraico": "עַל־הַבְּרֵכָ֣ה", "transliteral": "ʿal-hab-bə-rê-ḵā", "traducao_palavra": "sobre o tanque" },
        { "hebraico": "בְּחֶבְרֹ֑ון", "transliteral": "bə-ḥeḇ-rō-wn", "traducao_palavra": "em Hebrom" },
        { "hebraico": "וְאֵ֨ת", "transliteral": "wə-ʾêṯ", "traducao_palavra": "e" },
