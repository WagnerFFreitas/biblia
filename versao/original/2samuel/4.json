        { "hebraico": "וַיִּקְבְּר֥וּ", "transliteral": "way-yiq-bə-rû", "traducao_palavra": "e sepultaram" },
        { "hebraico": "בְקֶֽבֶר־אַבְנֵ֖ר", "transliteral": "ḇə-qe-ḇer-ʾaḇ-nêr", "traducao_palavra": "na sepultura de Abner" },
        { "hebraico": "בְּחֶבְרֹֽון׃", "transliteral": "bə-ḥeḇ-rō-wn", "traducao_palavra": "em Hebrom" }
      ]
