        { "hebraico": "מִמְּךָ֔", "transliteral": "mim-mə-ḵā", "traducao_palavra": "do que tu" },
        { "hebraico": "וְהָלַכְתִּ֖י", "transliteral": "wə-hā-laḵ-tî", "traducao_palavra": "então irei" },
