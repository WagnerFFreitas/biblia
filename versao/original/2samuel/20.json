        { "hebraico": "אֲשֶׁ֣ר", "transliteral": "ʾă-šer", "traducao_palavra": "que [estava]" },
        { "hebraico": "בְּיַד־יֹואָ֗ב", "transliteral": "bə-yaḏ-yô-ʾāḇ", "traducao_palavra": "na mão de Joabe" },
        { "hebraico": "וַיַּכֵּהוּ֩", "transliteral": "way-yak-kê-hû", "traducao_palavra": "e feriu-o ele" },
        { "hebraico": "בָ֨הּ", "transliteral": "ḇāh", "traducao_palavra": "com ela" },
        { "hebraico": "אֶל־הַחֹ֜מֶשׁ", "transliteral": "ʾel-ha-ḥō-meš", "traducao_palavra": "na [quinta] barriga" },
        { "hebraico": "וַיִּשְׁפֹּ֨ךְ", "transliteral": "way-yiš-pōḵ", "traducao_palavra": "e derramou" },
        { "hebraico": "מֵעָ֥יו", "transliteral": "mê-ʿāyw", "traducao_palavra": "as entranhas dele" },
        { "hebraico": "אַ֛רְצָה", "transliteral": "ʾar-ṣā", "traducao_palavra": "em terra" },
        { "hebraico": "וְלֹא־שָׁ֥נָה", "transliteral": "wə-lō-šā-nā", "traducao_palavra": "e não repetiu" },
        { "hebraico": "לֹ֖ו", "transliteral": "lô", "traducao_palavra": "para ele [o golpe]" },
        { "hebraico": "וַיָּמֹ֑ת", "transliteral": "way-yā-māṯ", "traducao_palavra": "e morreu" },
        { "hebraico": "וְיֹואָב֙", "transliteral": "wə-yô-ʾāḇ", "traducao_palavra": "e Joabe" },
