    "10": {
      "traducao_completa": "E Amasa não se guardou da espada que estava na mão de Joabe, de sorte que este o feriu com ela na quinta costela, e lhe derramou por terra as entranhas; e não o feriu segunda vez, e ele morreu. Então Joabe e Abisai, seu irmão, perseguiram a Seba, filho de Bicri.",
      "palavras": [
        { "hebraico": "וַעֲמָשָׂ֨א", "transliteral": "wa-ʿă-mā-śā", "traducao_palavra": "e Amasa" },
        { "hebraico": "לֹא־נִשְׁמַ֜ר", "transliteral": "lō-niš-mar", "traducao_palavra": "não guardou-se" },
