        { "hebraico": "ויקהלו", "transliteral": "way-yiq-qā-hă-lû", "traducao_palavra": "e congregaram-se" },
        { "hebraico": "וַיָּבֹ֥אוּ", "transliteral": "way-yā-ḇō-ʾû", "traducao_palavra": "e vieram" },
        { "hebraico": "אַף־אַחֲרָֽיו׃", "transliteral": "ʾap̄-ʾa-ḥă-rāyw", "traducao_palavra": "também após ele" }
      ]
    },
    "15": {
      "traducao_completa": "E vieram e o cercaram em Abel-Bete-Maaca, e levantaram contra a cidade uma tranqueira, que estava em frente do antemuro; e todo o povo que estava com Joabe batia o muro para o derrubar.",
      "palavras": [
