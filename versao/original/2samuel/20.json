        { "hebraico": "בַּדָּ֖ם", "transliteral": "bad-dām", "traducao_palavra": "no sangue" },
        { "hebraico": "בְּתֹ֣וךְ", "transliteral": "bə-ṯôḵ", "traducao_palavra": "no meio de" },
        { "hebraico": "הַמְסִלָּ֑ה", "transliteral": "ham-sil-lā", "traducao_palavra": "a estrada" },
