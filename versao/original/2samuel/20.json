        { "hebraico": "קְרַ֣ב", "transliteral": "qə-raḇ", "traducao_palavra": "aproxima-te" },
        { "hebraico": "עַד־הֵ֔נָּה", "transliteral": "ʿaḏ-hên-nā", "traducao_palavra": "até aqui" },
        { "hebraico": "וַאֲדַבְּרָה־אֵלֶֽיךָ׃", "transliteral": "wa-ʾă-ḏab-bə-rā-ʾê-le-ḵā", "traducao_palavra": "e falarei a ti" }
      ]
    },
    "17": {
      "traducao_completa": "E chegando-se ele a ela, disse a mulher: Tu és Joabe? E disse ele: Eu sou. E ela lhe disse: Ouve as palavras da tua serva. E disse ele: Ouço.",
      "palavras": [
