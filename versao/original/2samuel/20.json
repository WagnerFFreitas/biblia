        { "hebraico": "בֶּן־בִּכְרִֽי׃", "transliteral": "ben-biḵ-rî", "traducao_palavra": "filho de Bicri" }
      ]
    },
    "11": {
      "traducao_completa": "E um dos moços de Joabe parou junto a ele, e disse: Quem há que ame a Joabe, e quem seja por Davi, siga a Joabe.",
      "palavras": [
