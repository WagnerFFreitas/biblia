        { "hebraico": "וַיִּשְׁפְּכ֥וּ", "transliteral": "way-yiš-pə-ḵû", "traducao_palavra": "e lançaram/verteram" },
        { "hebraico": "סֹֽלְלָה֙", "transliteral": "sō-lə-lā", "traducao_palavra": "um aterro/tranqueira" },
