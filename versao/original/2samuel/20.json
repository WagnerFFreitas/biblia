        { "hebraico": "אִשָּׁ֥ה", "transliteral": "ʾiš-šā", "traducao_palavra": "uma mulher" },
        { "hebraico": "חֲכָמָ֖ה", "transliteral": "ḥă-ḵā-mā", "traducao_palavra": "sábia" },
        { "hebraico": "מִן־הָעִ֑יר", "transliteral": "min-hā-ʿîr", "traducao_palavra": "da cidade" },
        { "hebraico": "שִׁמְע֤וּ", "transliteral": "šim-ʿû", "traducao_palavra": "ouvi" },
        { "hebraico": "שִׁמְעוּ֙", "transliteral": "šim-ʿû", "traducao_palavra": "ouvi" },
