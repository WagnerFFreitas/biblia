    "23": {
      "traducao_completa": "E Joabe estava sobre todo o exército de Israel; e Benaia, filho de Joiada, sobre os queretitas e sobre os peletitas;",
      "palavras": [
        { "hebraico": "וְיֹואָ֖ב", "transliteral": "wə-yô-ʾāḇ", "traducao_palavra": "e Joabe" },
