        { "hebraico": "אֶת־עֲמָשָׂ֨א", "transliteral": "ʾeṯ-ʿă-mā-śā", "traducao_palavra": "a Amasa" },
        { "hebraico": "מִן־הַמְסִלָּ֜ה", "transliteral": "min-ham-sil-lā", "traducao_palavra": "da estrada" },
        { "hebraico": "הַשָּׂדֶה", "transliteral": "haś-śā-ḏeh", "traducao_palavra": "[para] o campo" },
