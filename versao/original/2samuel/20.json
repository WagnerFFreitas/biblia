        { "hebraico": "אָחִ֔יו", "transliteral": "ʾā-ḥîw", "traducao_palavra": "seu irmão" },
        { "hebraico": "רָדַ֕ף", "transliteral": "rā-ḏap̄", "traducao_palavra": "perseguiu" },
