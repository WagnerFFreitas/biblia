      "palavras": [
        { "hebraico": "עֲשָׂהאֵ֥ל", "transliteral": "ʿă-śā-hêl", "traducao_palavra": "Asael" },
        { "hebraico": "אֲחִֽי־יֹואָ֖ב", "transliteral": "ʾă-ḥî-yô-ʾāḇ", "traducao_palavra": "irmão de Joabe" },
        { "hebraico": "בַּשְּׁלֹשִׁ֑ים", "transliteral": "baš-šə-lō-šîm", "traducao_palavra": "entre os trinta" },
