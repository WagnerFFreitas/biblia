    "21": {
      "traducao_completa": "Também feriu ele um homem egípcio, homem de boa aparência; e o egípcio tinha uma lança na mão, mas ele desceu a ele com um cajado, e arrancou a lança da mão do egípcio, e com a sua própria lança o matou.",
      "palavras": [
        { "hebraico": "וְהֽוּא־הִכָּה֩", "transliteral": "wə-hû-hik-kā", "traducao_palavra": "e ele feriu" },
        { "hebraico": "אִ֨ישׁ", "transliteral": "ʾîš", "traducao_palavra": "um homem" },
