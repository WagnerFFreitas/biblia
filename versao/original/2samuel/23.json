        { "hebraico": "וּבְנָיָ֨הוּ", "transliteral": "ū-ḇə-nā-yā-hû", "traducao_palavra": "e Benaia" },
        { "hebraico": "בֶן־יְהֹויָדָ֧ע", "transliteral": "ben-yə-hô-w-yā-ḏāʿ", "traducao_palavra": "filho de Joiada" },
