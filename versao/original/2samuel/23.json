      ]
    },
    "23": {
      "traducao_completa": "Dos trinta era ele o mais nobre, contudo aos primeiros três não chegou; e Davi o pôs sobre os seus guardas.",
      "palavras": [
        { "hebraico": "מִן־הַשְּׁלֹשִׁ֣ים", "transliteral": "min-haš-šə-lō-šîm", "traducao_palavra": "dos trinta" },
        { "hebraico": "נִכְבָּ֔ד", "transliteral": "niḵ-bāḏ", "traducao_palavra": "nobre/honrado" },
        { "hebraico": "וְאֶל־הַשְּׁלֹשָׁ֖ה", "transliteral": "wə-ʾel-ha-šə-lō-šā", "traducao_palavra": "mas até aos três" },
        { "hebraico": "לֹא־בָ֑אָה", "transliteral": "lō-ḇā-ʾā", "traducao_palavra": "não chegou" },
        { "hebraico": "וַיְשִׂימֵ֥הוּ", "transliteral": "way-śî-mê-hû", "traducao_palavra": "e pôs ele" },
        { "hebraico": "דָוִ֖id", "transliteral": "dā-wiḏ", "traducao_palavra": "Davi" },
