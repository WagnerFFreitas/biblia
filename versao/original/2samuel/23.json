        { "hebraico": "אִ֣ישׁ", "transliteral": "ʾîš", "traducao_palavra": "homem de" },
        { "hebraico": "מַרְאֶ֗ה", "transliteral": "mar-ʾeh", "traducao_palavra": "aparência [notável]" },
        { "hebraico": "וּבְיַ֤id", "transliteral": "ū-ḇə-yaḏ", "traducao_palavra": "e na mão de" },
        { "hebraico": "הַמִּצְרִי֙", "transliteral": "ham-miṣ-rî", "traducao_palavra": "o egípcio" },
        { "hebraico": "חֲנִ֔ית", "transliteral": "ḥă-nîṯ", "traducao_palavra": "[havia] uma lança" },
        { "hebraico": "וַיֵּ֥רֶד", "transliteral": "way-yê-reḏ", "traducao_palavra": "e desceu" },
        { "hebraico": "אֵלָ֖יו", "transliteral": "ʾê-lāyw", "traducao_palavra": "a ele" },
        { "hebraico": "בַּשָּׁ֑בֶט", "transliteral": "baš-šā-ḇeṭ", "traducao_palavra": "com o cajado" },
        { "hebraico": "וַיִּגְזֹ֤ל", "transliteral": "way-yiḡ-zōl", "traducao_palavra": "e arrancou" },
        { "hebraico": "אֶת־הַחֲנִית֙", "transliteral": "ʾeṯ-ha-ḥă-nîṯ", "traducao_palavra": "a lança" },
        { "hebraico": "מִיַּ֣id", "transliteral": "miy-yaḏ", "traducao_palavra": "da mão de" },
        { "hebraico": "הַמִּצְרִ֔י", "transliteral": "ham-miṣ-rî", "traducao_palavra": "o egípcio" },
        { "hebraico": "וַיַּהַרְגֵ֖הוּ", "transliteral": "way-ya-har-ḡê-hû", "traducao_palavra": "e matou-o" },
        { "hebraico": "בַּחֲנִיתֹֽו׃", "transliteral": "ba-ḥă-nî-ṯô", "traducao_palavra": "com a lança dele" }
      ]
    },
    "22": {
      "traducao_completa": "Estas coisas fez Benaia, filho de Joiada, pelo que teve nome entre os três valentes.",
      "palavras": [
        { "hebraico": "אֵ֣לֶּה", "transliteral": "ʾēl-leh", "traducao_palavra": "estas coisas" },
        { "hebraico": "עָשָׂ֔ה", "transliteral": "ʿā-śā", "traducao_palavra": "fez" },
        { "hebraico": "בְּנָיָ֖הוּ", "transliteral": "bə-nā-yā-hû", "traducao_palavra": "Benaia" },
        { "hebraico": "בֶּן־יְהֹויָדָ֑ע", "transliteral": "ben-yə-hô-w-yā-ḏāʿ", "traducao_palavra": "filho de Joiada" },
        { "hebraico": "וְלֹו־שֵׁ֖ם", "transliteral": "wə-lô-šēm", "traducao_palavra": "e para ele [houve] nome" },
        { "hebraico": "בִּשְׁלֹשָׁ֥ה", "transliteral": "biš-lō-šā", "traducao_palavra": "entre os três" },
