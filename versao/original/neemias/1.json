        { "hebraico": "וָאֶשְׁאָלֵ֞ם", "transliteral": "wā-ʾeš-ʾā-lêm", "traducao_palavra": "e perguntei-lhes" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre" },
