        { "hebraico": "אֶחָ֧ד", "transliteral": "ʾe-ḥāḏ", "traducao_palavra": "um" },
        { "hebraico": "מֵאַחַ֛י", "transliteral": "mê-ʾa-ḥay", "traducao_palavra": "dos meus irmãos" },
