        { "hebraico": "חֲכַלְיָ֑ה", "transliteral": "ḥă-ḵal-yā", "traducao_palavra": "Hacalias" },
        { "hebraico": "וַיְהִ֤י", "transliteral": "way-hî", "traducao_palavra": "E aconteceu" },
