        { "hebraico": "לְאֹהֲבָ֖יו", "transliteral": "lə-ʾō-hă-ḇāyw", "traducao_palavra": "para os que o amam" },
        { "hebraico": "וּלְשֹׁמְרֵ֥i", "transliteral": "ū-lə-šō-mə-rê", "traducao_palavra": "e para os que guardam" },
