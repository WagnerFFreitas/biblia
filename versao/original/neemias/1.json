        { "hebraico": "שְׁנַ֣ת", "transliteral": "šə-naṯ", "traducao_palavra": "ano" },
        { "hebraico": "עֶשְׂרִ֔ים", "transliteral": "ʿeś-rîm", "traducao_palavra": "vigésimo" },
        { "hebraico": "וַאֲנִ֥י", "transliteral": "wa-ʾă-nî", "traducao_palavra": "e eu" },
        { "hebraico": "הָיִ֖יתִי", "transliteral": "hā-yî-ṯî", "traducao_palavra": "estava" },
        { "hebraico": "בְּשׁוּשַׁ֥ן", "transliteral": "bə-šū-šan", "traducao_palavra": "em Susã" },
        { "hebraico": "הַבִּירָֽה׃", "transliteral": "hab-bî-rā", "traducao_palavra": "a fortaleza" }
