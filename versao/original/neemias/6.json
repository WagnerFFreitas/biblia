        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "אֱלֹהִ֖ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "Deus" },
        { "hebraico": "שְׁלָחֹ֑ו", "transliteral": "šə-lā-ḥô", "traducao_palavra": "tinha enviado ele" },
        { "hebraico": "כִּ֤י", "transliteral": "kî", "traducao_palavra": "mas" },
        { "hebraico": "הַנְּבוּאָה֙", "transliteral": "han-nə-ḇū-ʾā", "traducao_palavra": "a profecia" },
        { "hebraico": "דִּבֶּ֣ר", "transliteral": "dib-ber", "traducao_palavra": "falara" },
        { "hebraico": "עָלַ֔י", "transliteral": "ʿā-lay", "traducao_palavra": "contra mim" },
        { "hebraico": "וְטֹבִיָּ֥ה", "transliteral": "wə-ṭō-ḇî-yā", "traducao_palavra": "pois Tobias" },
        { "hebraico": "וְסַנְבַלַּ֖ט", "transliteral": "wə-san-ḇal-laṭ", "traducao_palavra": "e Sambalate" },
        { "hebraico": "שְׂכָרֹֽו׃", "transliteral": "śə-ḵā-rô", "traducao_palavra": "tinham subornado ele" }
