        { "hebraico": "הַהֵיכָ֖ל", "transliteral": "ha-hê-ḵāl", "traducao_palavra": "templo" },
        { "hebraico": "וָחָ֑י", "transliteral": "wā-ḥāy", "traducao_palavra": "e viveria" },
        { "hebraico": "לֹ֥א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "אָבֹֽוא׃", "transliteral": "ʾā-ḇō-w", "traducao_palavra": "entrarei" }
