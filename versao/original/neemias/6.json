        { "hebraico": "אֲשֶׁר־", "transliteral": "ʾă-šer-", "traducao_palavra": "que" },
        { "hebraico": "יָבֹ֥וא", "transliteral": "yā-ḇō-w", "traducao_palavra": "entraria" },
