        { "hebraico": "שָׂכ֭וּר", "transliteral": "śā-ḵūr", "traducao_palavra": "[isso foi ele] subornado" },
        { "hebraico": "לְמַֽעַן־", "transliteral": "lə-ma-ʿan-", "traducao_palavra": "para que" },
        { "hebraico": "אִירָ֣א", "transliteral": "ʾî-rā", "traducao_palavra": "eu temesse" },
        { "hebraico": "וְאֶֽעֱשֶׂה־", "transliteral": "wə-ʾe-ʿĕ-śeh-", "traducao_palavra": "e fizesse" },
        { "hebraico": "כֵּ֖ן", "transliteral": "kên", "traducao_palavra": "assim" },
        { "hebraico": "וְחָטָ֑אתִי", "transliteral": "wə-ḥā-ṭā-ṯî", "traducao_palavra": "e pecasse" },
