        { "hebraico": "הֶעֱמַ֥דְתִּי", "transliteral": "he-ʿĕ-maḏ-tî", "traducao_palavra": "tinha assentado" },
        { "hebraico": "בַשְּׁעָרִֽים׃", "transliteral": "baš-šə-ʿā-rîm", "traducao_palavra": "nos portais" }
      ]
    },
    "2": {
      "traducao_completa": "Sambalate e Gesém enviaram-me a dizer: Vem, e congreguemo-nos juntamente nas aldeias, no vale de Ono. Porém intentavam fazer-me mal.",
      "palavras": [
        { "hebraico": "וַיִּשְׁלַ֨ח", "transliteral": "way-yiš-laḥ", "traducao_palavra": "E enviou" },
        { "hebraico": "סַנְבַלַּ֤ט", "transliteral": "san-ḇal-laṭ", "traducao_palavra": "Sambalate" },
        { "hebraico": "וְגֶ֙שֶׁם֙", "transliteral": "wə-ḡe-šem", "traducao_palavra": "e Gesém" },
        { "hebraico": "אֵלַ֣י", "transliteral": "ʾê-lay", "traducao_palavra": "a mim" },
