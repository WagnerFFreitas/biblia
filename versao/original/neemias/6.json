  "versiculos": {
    "1": {
      "traducao_completa": "E sucedeu que, ouvindo Sambalate, Tobias, Gesém, o árabe, e o resto dos nossos inimigos, que eu já tinha edificado o muro, e que nele já não restava brecha alguma (ainda que até aquele tempo não tinha posto as portas nos portais),",
      "palavras": [
        { "hebraico": "וַיְהִ֣י", "transliteral": "way-hî", "traducao_palavra": "E aconteceu" },
        { "hebraico": "כַאֲשֶׁר֩", "transliteral": "ḵa-ʾă-šer", "traducao_palavra": "que quando" },
        { "hebraico": "נִשְׁמַ֨ע", "transliteral": "niš-maʿ", "traducao_palavra": "foi ouvido" },
        { "hebraico": "לְסַנְבַלַּ֜ט", "transliteral": "lə-san-ḇal-laṭ", "traducao_palavra": "por Sambalate" },
        { "hebraico": "וְטֹבִיָּ֗ה", "transliteral": "wə-ṭō-ḇî-yā", "traducao_palavra": "e Tobias" },
        { "hebraico": "וּלְגֶ֙שֶׁם֙", "transliteral": "ū-lə-ḡe-šem", "traducao_palavra": "e por Gesém" },
        { "hebraico": "הָֽעַרְבִ֔י", "transliteral": "hā-ʿar-ḇî", "traducao_palavra": "o árabe" },
        { "hebraico": "וּלְיֶ֙תֶר֙", "transliteral": "ū-lə-ye-ṯer", "traducao_palavra": "e pelo resto de" },
        { "hebraico": "אֹיְבֵינוּ", "transliteral": "ʾō-yə-ḇê-nū", "traducao_palavra": "nossos inimigos" },
        { "hebraico": "כִּ֚י", "transliteral": "kî", "traducao_palavra": "que" },
        { "hebraico": "בָנִ֣יתִי", "transliteral": "ḇā-nî-ṯî", "traducao_palavra": "edifiquei" },
        { "hebraico": "אֶת־", "transliteral": "ʾeṯ-", "traducao_palavra": "[objeto]" },
        { "hebraico": "הַחֹומָ֔ה", "transliteral": "ha-ḥō-w-mā", "traducao_palavra": "o muro" },
        { "hebraico": "וְלֹא־", "transliteral": "wə-lō-", "traducao_palavra": "e não" },
        { "hebraico": "נֹ֥ותַר", "transliteral": "nō-w-ṯar", "traducao_palavra": "restava" },
        { "hebraico": "בָּ֖הּ", "transliteral": "bāh", "traducao_palavra": "nele" },
        { "hebraico": "פָּ֑רֶץ", "transliteral": "pā-reṣ", "traducao_palavra": "brecha" },
        { "hebraico": "גַּ֚ם", "transliteral": "gam", "traducao_palavra": "também/até" },
        { "hebraico": "עַד־", "transliteral": "ʿaḏ-", "traducao_palavra": "até" },
        { "hebraico": "הָעֵ֣ת", "transliteral": "hā-ʿêṯ", "traducao_palavra": "o tempo" },
        { "hebraico": "הַהִ֔יא", "transliteral": "ha-hî", "traducao_palavra": "aquele" },
        { "hebraico": "דְּלָתֹ֖ות", "transliteral": "də-lā-ṯō-wṯ", "traducao_palavra": "portas" },
