        { "hebraico": "וְנִוָּעֲדָ֣ה", "transliteral": "wə-niw-wā-ʿă-ḏā", "traducao_palavra": "e encontremo-nos" },
        { "hebraico": "יַחְדָּ֔ו", "transliteral": "yaḥ-dāw", "traducao_palavra": "juntos" },
        { "hebraico": "בַּכְּפִירִ֖ים", "transliteral": "bak-kə-p̄î-rîm", "traducao_palavra": "nas aldeias" },
