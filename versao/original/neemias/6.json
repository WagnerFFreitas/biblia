        { "hebraico": "תֵעָשֶׂ֑ה", "transliteral": "ṯê-ʿā-śeh", "traducao_palavra": "será feita" },
        { "hebraico": "וְעַתָּ֖ה", "transliteral": "wə-ʿat-tā", "traducao_palavra": "e agora" },
        { "hebraico": "חַזֵּ֥ק", "transliteral": "ḥaz-zêq", "traducao_palavra": "fortalece" },
