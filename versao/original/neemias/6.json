        { "hebraico": "אֹונֹ֑ו", "transliteral": "ʾō-nō-w", "traducao_palavra": "Ono" },
        { "hebraico": "וְהֵ֙מָּה֙", "transliteral": "wə-hêm-mā", "traducao_palavra": "mas eles" },
        { "hebraico": "חֹשְׁבִ֔ים", "transliteral": "ḥō-šə-ḇîm", "traducao_palavra": "intentavam" },
        { "hebraico": "לַעֲשֹׂ֥ות", "transliteral": "la-ʿă-śō-wṯ", "traducao_palavra": "fazer" },
        { "hebraico": "לִ֖י", "transliteral": "lî", "traducao_palavra": "para mim" },
        { "hebraico": "רָעָֽה׃", "transliteral": "rā-ʿā", "traducao_palavra": "mal" }
      ]
    },
    "3": {
      "traducao_completa": "E enviei-lhes mensageiros, a dizer: Faço uma grande obra, de modo que não poderei descer; por que cessaria esta obra, enquanto eu a deixasse e fosse ter convosco?",
