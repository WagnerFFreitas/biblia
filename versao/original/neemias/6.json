        { "hebraico": "אֲלֵיכֶֽם׃", "transliteral": "ʾă-lê-ḵem", "traducao_palavra": "a vós" }
      ]
    },
    "4": {
      "traducao_completa": "E do mesmo modo enviaram a mim quatro vezes; e eu lhes respondi da mesma maneira.",
      "palavras": [
        { "hebraico": "וַיִּשְׁלְחוּ־", "transliteral": "way-yiš-lə-ḥū-", "traducao_palavra": "E enviaram" },
        { "hebraico": "אֵלַי֙", "transliteral": "ʾê-lay", "traducao_palavra": "a mim" },
        { "hebraico": "כַּדָּבָ֣ר", "transliteral": "kad-dā-ḇār", "traducao_palavra": "como este assunto" },
        { "hebraico": "הַזֶּ֔ה", "transliteral": "haz-zeh", "traducao_palavra": "esta [vez]" },
