        { "hebraico": "לְשֵׁ֥ם", "transliteral": "lə-šēm", "traducao_palavra": "por um nome" },
        { "hebraico": "רָ֖ע", "transliteral": "rā", "traducao_palavra": "mau" },
        { "hebraico": "לְמַ֥עַן", "transliteral": "lə-ma-ʿan", "traducao_palavra": "para que" },
        { "hebraico": "יְחָרְפֽוּנִי׃", "transliteral": "yə-ḥā-rə-p̄ū-nî", "traducao_palavra": "me vituperassem" }
