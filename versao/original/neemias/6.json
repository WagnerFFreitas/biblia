      ]
    },
    "5": {
      "traducao_completa": "Então Sambalate enviou a mim o seu moço da mesma maneira pela quinta vez, com uma carta aberta na sua mão;",
      "palavras": [
        { "hebraico": "וַיִּשְׁלַח֩", "transliteral": "way-yiš-laḥ", "traducao_palavra": "E enviou" },
