        { "hebraico": "לָ֣מָּה", "transliteral": "lām-mā", "traducao_palavra": "por que" },
        { "hebraico": "תִשְׁבַּ֤ת", "transliteral": "tiš-baṯ", "traducao_palavra": "cessaria" },
        { "hebraico": "הַמְּלָאכָה֙", "transliteral": "ham-mə-lā-ḵā", "traducao_palavra": "a obra" },
        { "hebraico": "כַּאֲשֶׁ֣ר", "transliteral": "ka-ʾă-šer", "traducao_palavra": "enquanto" },
        { "hebraico": "אַרְפֶּ֔הָ", "transliteral": "ʾar-pe-hā", "traducao_palavra": "a deixasse" },
