        { "hebraico": "וָאֶשְׁלְחָ֨ה", "transliteral": "wā-ʾeš-lə-ḥā", "traducao_palavra": "E enviei" },
        { "hebraico": "עֲלֵיהֶ֤ם", "transliteral": "ʿă-lê-hem", "traducao_palavra": "a eles" },
        { "hebraico": "מַלְאָכִים֙", "transliteral": "mal-ʾā-ḵîm", "traducao_palavra": "mensageiros" },
        { "hebraico": "לֵאמֹ֔ר", "transliteral": "lê-mōr", "traducao_palavra": "dizendo" },
        { "hebraico": "מְלָאָכָה", "transliteral": "mə-lā-ʾā-ḵā", "traducao_palavra": "obra" },
