        { "hebraico": "כָּמֹ֙ונִי֙", "transliteral": "kā-mō-w-nî", "traducao_palavra": "como eu" },
        { "hebraico": "יִבְרָ֔ח", "transliteral": "yiḇ-rāḥ", "traducao_palavra": "fugiria" },
        { "hebraico": "וּמִ֥י", "transliteral": "ū-mî", "traducao_palavra": "e quem" },
