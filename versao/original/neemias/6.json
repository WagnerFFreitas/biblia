        { "hebraico": "יִרְפּ֧וּ", "transliteral": "yir-pū", "traducao_palavra": "largarão/desfalecerão" },
        { "hebraico": "יְדֵיהֶ֛ם", "transliteral": "yə-ḏê-hem", "traducao_palavra": "as mãos deles" },
        { "hebraico": "מִן־", "transliteral": "min-", "traducao_palavra": "de" },
        { "hebraico": "הַמְּלָאכָ֖ה", "transliteral": "ham-mə-lā-ḵā", "traducao_palavra": "a obra" },
