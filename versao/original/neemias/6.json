        { "hebraico": "לְטֹובִיָּ֣ה", "transliteral": "lə-ṭō-ḇî-yā", "traducao_palavra": "de Tobias" },
        { "hebraico": "וּלְסַנְבַלַּט֮", "transliteral": "ū-lə-san-ḇal-laṭ", "traducao_palavra": "e de Sambalate" },
