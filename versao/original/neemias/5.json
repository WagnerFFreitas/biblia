        { "hebraico": "בְּאָחִ֖יו", "transliteral": "bə-ʾā-ḥîw", "traducao_palavra": "de seu irmão" },
        { "hebraico": "אַתֶּ֣ם", "transliteral": "ʾat-tem", "traducao_palavra": "vós" },
