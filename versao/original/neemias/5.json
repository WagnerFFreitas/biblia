        { "hebraico": "מִבְּנֹתֵינוּ֙", "transliteral": "mib-bə-nō-ṯê-nū", "traducao_palavra": "[algumas] de nossas filhas" },
        { "hebraico": "נִכְבָּשֹׁ֔ות", "transliteral": "niḵ-bā-šō-wṯ", "traducao_palavra": "sujeitadas" },
        { "hebraico": "וְאֵ֥ין", "transliteral": "wə-ʾên", "traducao_palavra": "e não há" },
        { "hebraico": "לְאֵ֣ל", "transliteral": "lə-ʾêl", "traducao_palavra": "[está no] poder de" },
        { "hebraico": "יָדֵ֑נוּ", "transliteral": "yā-ḏê-nū", "traducao_palavra": "nossa mão" },
        { "hebraico": "וּשְׂדֹתֵ֥ינוּ", "transliteral": "ū-śə-ḏō-ṯê-nū", "traducao_palavra": "pois nossos campos" },
        { "hebraico": "וּכְרָמֵינוּ", "transliteral": "ū-ḵə-rā-mê-nū", "traducao_palavra": "e nossas vinhas" },
        { "hebraico": "לַאֲחֵרִֽים׃", "transliteral": "la-ʾă-ḥê-rîm", "traducao_palavra": "[pertencem] a outros" }
      ]
    },
    "6": {
      "traducao_completa": "Ouvindo eu, pois, o seu clamor e estas palavras, muito me indignei.",
      "palavras": [
        { "hebraico": "וַיִּ֤חַר", "transliteral": "way-yi-ḥar", "traducao_palavra": "E ardeu [em ira]" },
        { "hebraico": "לִי֙", "transliteral": "lî", "traducao_palavra": "em mim" },
        { "hebraico": "מְאֹ֔ד", "transliteral": "mə-ʾōḏ", "traducao_palavra": "muito" },
        { "hebraico": "כַּאֲשֶׁ֥ר", "transliteral": "ka-ʾă-šer", "traducao_palavra": "quando" },
        { "hebraico": "שָׁמַ֛עְתִּי", "transliteral": "šā-maʿ-tî", "traducao_palavra": "ouvi" },
        { "hebraico": "אֶת־", "transliteral": "ʾeṯ-", "traducao_palavra": "[objeto]" },
        { "hebraico": "זַעֲקָתָ֖ם", "transliteral": "za-ʿă-qā-ṯām", "traducao_palavra": "o clamor deles" },
        { "hebraico": "וְאֶת־", "transliteral": "wə-ʾeṯ-", "traducao_palavra": "e [objeto]" },
        { "hebraico": "הַדְּבָרִ֥ים", "transliteral": "had-də-ḇā-rîm", "traducao_palavra": "as palavras" },
        { "hebraico": "הָאֵֽלֶּה׃", "transliteral": "hā-ʾêl-leh", "traducao_palavra": "estas" }
      ]
    },
    "7": {
      "traducao_completa": "E consultei o meu coração; depois contendi com os nobres e com os magistrados, e disse-lhes: Estais cobrando usura cada um de seu irmão. E convoquei contra eles uma grande assembleia.",
      "palavras": [
        { "hebraico": "וַיִּמָּלֵ֨ךְ", "transliteral": "way-yim-mā-lêḵ", "traducao_palavra": "E consultou" },
        { "hebraico": "לִבִּ֜י", "transliteral": "lib-bî", "traducao_palavra": "meu coração" },
        { "hebraico": "עָלַ֗י", "transliteral": "ʿā-lay", "traducao_palavra": "comigo" },
        { "hebraico": "וָאָרִ֤יבָה", "transliteral": "wā-ʾā-rî-ḇā", "traducao_palavra": "e contendi" },
        { "hebraico": "אֶת־", "transliteral": "ʾeṯ-", "traducao_palavra": "com" },
        { "hebraico": "הַחֹרִים֙", "transliteral": "ha-ḥō-rîm", "traducao_palavra": "os nobres" },
        { "hebraico": "וְאֶת־", "transliteral": "wə-ʾeṯ-", "traducao_palavra": "e com" },
        { "hebraico": "הַסְּגָנִ֔ים", "transliteral": "has-śə-ḡā-nîm", "traducao_palavra": "os magistrados" },
        { "hebraico": "וָאֹמְרָ֣ה", "transliteral": "wā-ʾō-mə-rā", "traducao_palavra": "e disse" },
        { "hebraico": "לָהֶ֔ם", "transliteral": "lā-hem", "traducao_palavra": "a eles" },
        { "hebraico": "מַשָּׁ֥א", "transliteral": "maš-šā", "traducao_palavra": "usura/carga" },
