        { "hebraico": "וָאֶתֵּ֥ן", "transliteral": "wā-ʾet-tên", "traducao_palavra": "e convoquei" },
        { "hebraico": "עֲלֵיהֶ֖ם", "transliteral": "ʿă-lê-hem", "traducao_palavra": "contra eles" },
        { "hebraico": "קְהִלָּ֥ה", "transliteral": "qə-hil-lā", "traducao_palavra": "uma assembleia" },
        { "hebraico": "גְּדֹולָֽה׃", "transliteral": "gə-ḏō-lā", "traducao_palavra": "grande" }
      ]
    },
    "8": {
      "traducao_completa": "E disse-lhes: Nós resgatamos os judeus, nossos irmãos, que foram vendidos às nações, conforme as nossas posses; e vós outra vez venderíeis vossos irmãos, ou seriam vendidos a nós? Então se calaram, e não acharam que responder.",
      "palavras": [
        { "hebraico": "וָאֹמְרָ֣ה", "transliteral": "wā-ʾō-mə-rā", "traducao_palavra": "E disse" },
        { "hebraico": "לָהֶ֗ם", "transliteral": "lā-hem", "traducao_palavra": "a eles" },
        { "hebraico": "אֲנַ֣חְנוּ", "transliteral": "ʾă-naḥ-nū", "traducao_palavra": "nós" },
        { "hebraico": "קָ֠נִינוּ", "transliteral": "qā-nî-nū", "traducao_palavra": "resgatamos/compramos" },
        { "hebraico": "אֶת־", "transliteral": "ʾeṯ-", "traducao_palavra": "[objeto]" },
        { "hebraico": "אַחֵ֨ינוּ", "transliteral": "ʾa-ḥê-nū", "traducao_palavra": "nossos irmãos" },
        { "hebraico": "הַיְּהוּדִ֜ים", "transliteral": "hay-yə-hū-ḏîm", "traducao_palavra": "os judeus" },
        { "hebraico": "הַנִּמְכָּרִ֤ים", "transliteral": "han-nim-kā-rîm", "traducao_palavra": "os vendidos" },
        { "hebraico": "לַגֹּויִם֙", "transliteral": "lag-gō-wy-im", "traducao_palavra": "às nações" },
        { "hebraico": "כְּדֵ֣י", "transliteral": "kə-ḏê", "traducao_palavra": "conforme" },
        { "hebraico": "בָ֔נוּ", "transliteral": "ḇā-nū", "traducao_palavra": "nossa [possibilidade]" },
        { "hebraico": "וְגַם־", "transliteral": "wə-ḡam-", "traducao_palavra": "e também" },
        { "hebraico": "אַתֶּ֛ם", "transliteral": "ʾat-tem", "traducao_palavra": "vós" },
        { "hebraico": "תִּמְכְּר֥וּ", "transliteral": "tim-kə-rū", "traducao_palavra": "venderíeis" },
        { "hebraico": "אֶת־", "transliteral": "ʾeṯ-", "traducao_palavra": "[objeto]" },
        { "hebraico": "אֲחֵיכֶ֖ם", "transliteral": "ʾă-ḥê-ḵem", "traducao_palavra": "vossos irmãos" },
        { "hebraico": "וְנִמְכְּרוּ־", "transliteral": "wə-nim-kə-rū-", "traducao_palavra": "ou seriam vendidos" },
        { "hebraico": "לָ֑נוּ", "transliteral": "lā-nū", "traducao_palavra": "a nós" },
        { "hebraico": "וַֽיַּחֲרִ֔ישׁוּ", "transliteral": "way-ya-ḥă-rî-šū", "traducao_palavra": "e calaram-se" },
        { "hebraico": "וְלֹ֥א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "מָצְא֖וּ", "transliteral": "mā-ṣə-ʾū", "traducao_palavra": "acharam" },
        { "hebraico": "דָּבָֽר׃", "transliteral": "dā-ḇār", "traducao_palavra": "palavra/resposta" }
      ]
    },
    "9": {
      "traducao_completa": "Disse mais: Não é bom o que fazeis. Porventura não devíeis andar no temor do nosso Deus, por causa do opróbrio das nações, os nossos inimigos?",
      "palavras": [
        { "hebraico": "וַיֹּאמֶר", "transliteral": "way-yō-mer", "traducao_palavra": "E disse [eu]" },
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "טֹ֥וב", "transliteral": "ṭō-wḇ", "traducao_palavra": "[é] bom" },
        { "hebraico": "הַדָּבָ֖ר", "transliteral": "had-dā-ḇār", "traducao_palavra": "o negócio/coisa" },
        { "hebraico": "אֲשֶׁר־", "transliteral": "ʾă-šer-", "traducao_palavra": "que" },
        { "hebraico": "אַתֶּ֣ם", "transliteral": "ʾat-tem", "traducao_palavra": "vós" },
        { "hebraico": "עֹשִׂ֑ים", "transliteral": "ʿō-śîm", "traducao_palavra": "fazais" },
        { "hebraico": "הֲלֹ֞וא", "transliteral": "hă-lō-w", "traducao_palavra": "porventura não" },
        { "hebraico": "בְּיִרְאַ֤ת", "transliteral": "bə-yir-ʾaṯ", "traducao_palavra": "no temor de" },
        { "hebraico": "אֱלֹהֵ֙ינוּ֙", "transliteral": "ʾĕ-lō-hê-nū", "traducao_palavra": "nosso Deus" },
        { "hebraico": "תֵּלֵ֔כוּ", "transliteral": "tê-lê-ḵū", "traducao_palavra": "devíeis andar" },
        { "hebraico": "מֵחֶרְפַּ֥ת", "transliteral": "mê-ḥer-paṯ", "traducao_palavra": "por causa do opróbrio de" },
        { "hebraico": "הַגֹּויִ֖ם", "transliteral": "hag-gō-wy-im", "traducao_palavra": "as nações" },
        { "hebraico": "אֹויְבֵֽינוּ׃", "transliteral": "ʾō-wy-ḇê-nū", "traducao_palavra": "nossos inimigos" }
      ]
    },
    "10": {
      "traducao_completa": "Também eu, meus irmãos e meus moços, lhes temos emprestado dinheiro e trigo; deixemos este penhor.",
      "palavras": [
