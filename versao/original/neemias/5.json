{
  "livro": "Neemias - נְחֶמְיָה - Nə-ḥem-yā",
  "capítulo": 5,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Foi, porém, grande o clamor do povo e de suas mulheres contra os judeus, seus irmãos.",
      "palavras": [
        { "hebraico": "וַתְּהִ֨י", "transliteral": "wat-tə-hî", "traducao_palavra": "E houve" },
        { "hebraico": "צַעֲקַ֥ת", "transliteral": "ṣa-ʿă-qaṯ", "traducao_palavra": "o clamor de" },
        { "hebraico": "הָעָ֛ם", "transliteral": "hā-ʿām", "traducao_palavra": "o povo" },
        { "hebraico": "וּנְשֵׁיהֶ֖ם", "transliteral": "ū-nə-šê-hem", "traducao_palavra": "e de suas mulheres" },
        { "hebraico": "גְּדֹולָ֑ה", "transliteral": "gə-ḏō-lā", "traducao_palavra": "grande" },
        { "hebraico": "אֶל־", "transliteral": "ʾel-", "traducao_palavra": "contra" },
        { "hebraico": "אֲחֵיהֶ֖ם", "transliteral": "ʾă-ḥê-hem", "traducao_palavra": "seus irmãos" },
        { "hebraico": "הַיְּהוּדִֽים׃", "transliteral": "hay-yə-hū-ḏîm", "traducao_palavra": "os judeus" }
      ]
    },
    "2": {
      "traducao_completa": "Porque havia quem dizia: Nossos filhos e nossas filhas, nós somos muitos; pelo que tomemos trigo, para que comamos e vivamos.",
      "palavras": [
        { "hebraico": "וְיֵשׁ֙", "transliteral": "wə-yêš", "traducao_palavra": "E havia" },
        { "hebraico": "אֲשֶׁ֣ר", "transliteral": "ʾă-šer", "traducao_palavra": "[aqueles] que" },
        { "hebraico": "אֹמְרִ֔ים", "transliteral": "ʾō-mə-rîm", "traducao_palavra": "diziam" },
        { "hebraico": "בָּנֵ֨ינוּ", "transliteral": "bā-nê-nū", "traducao_palavra": "nossos filhos" },
        { "hebraico": "וּבְנֹתֵינוּ֙", "transliteral": "ū-ḇə-nō-ṯê-nū", "traducao_palavra": "e nossas filhas" },
        { "hebraico": "אֲנַ֣חְנוּ", "transliteral": "ʾă-naḥ-nū", "traducao_palavra": "nós" },
        { "hebraico": "רַבִּ֑ים", "transliteral": "rab-bîm", "traducao_palavra": "[somos] muitos" },
        { "hebraico": "וְנִקְחָ֥ה", "transliteral": "wə-niq-ḥā", "traducao_palavra": "pelo que tomemos" },
        { "hebraico": "דָגָ֖ן", "transliteral": "ḏā-ḡān", "traducao_palavra": "trigo" },
        { "hebraico": "וְנֹאכְלָ֥ה", "transliteral": "wə-nō-ḵə-lā", "traducao_palavra": "e comamos" },
        { "hebraico": "וְנִחְיֶֽה׃", "transliteral": "wə-niḥ-yeh", "traducao_palavra": "e vivamos" }
      ]
    },
    "3": {
      "traducao_completa": "Também havia quem dizia: As nossas terras, as nossas vinhas e as nossas casas empenhamos para tomarmos trigo nesta fome.",
      "palavras": [
        { "hebraico": "וְיֵשׁ֙", "transliteral": "wə-yêš", "traducao_palavra": "E havia" },
        { "hebraico": "אֲשֶׁ֣ר", "transliteral": "ʾă-šer", "traducao_palavra": "[aqueles] que" },
        { "hebraico": "אֹמְרִ֔ים", "transliteral": "ʾō-mə-rîm", "traducao_palavra": "diziam" },
        { "hebraico": "שְׂדֹתֵינוּ", "transliteral": "śə-ḏō-ṯê-nū", "traducao_palavra": "nossos campos" },
        { "hebraico": "וּכְרָמֵינוּ", "transliteral": "ū-ḵə-rā-mê-nū", "traducao_palavra": "e nossas vinhas" },
        { "hebraico": "וּבָתֵּינוּ", "transliteral": "ū-ḇāt-tê-nū", "traducao_palavra": "e nossas casas" },
        { "hebraico": "אֲנַחְנוּ", "transliteral": "ʾă-naḥ-nū", "traducao_palavra": "nós" },
        { "hebraico": "עֹרְבִים", "transliteral": "ʿō-rə-ḇîm", "traducao_palavra": "[estamos] empenhando" },
        { "hebraico": "וְנִקְחָ֥ה", "transliteral": "wə-niq-ḥā", "traducao_palavra": "para tomarmos" },
        { "hebraico": "דָגָ֖ן", "transliteral": "ḏā-ḡān", "traducao_palavra": "trigo" },
        { "hebraico": "בָּרָעָֽב׃", "transliteral": "bā-rā-ʿāḇ", "traducao_palavra": "na fome" }
      ]
    },
    "4": {
      "traducao_completa": "Havia ainda quem dizia: Tomamos emprestado dinheiro para o tributo do rei, sobre as nossas terras e as nossas vinhas.",
      "palavras": [
        { "hebraico": "וְיֵשׁ֙", "transliteral": "wə-yêš", "traducao_palavra": "E havia" },
        { "hebraico": "אֲשֶׁ֣ר", "transliteral": "ʾă-šer", "traducao_palavra": "[aqueles] que" },
        { "hebraico": "אֹמְרִ֔ים", "transliteral": "ʾō-mə-rîm", "traducao_palavra": "diziam" },
        { "hebraico": "לָוִ֥ינוּ", "transliteral": "lā-wî-nū", "traducao_palavra": "tomamos emprestado" },
        { "hebraico": "כֶ֖סֶף", "transliteral": "ḵe-sep̄", "traducao_palavra": "dinheiro" },
        { "hebraico": "לְמִדַּ֣ת", "transliteral": "lə-mid-daṯ", "traducao_palavra": "para o tributo de" },
        { "hebraico": "הַמֶּּ֑לֶךְ", "transliteral": "ham-me-leḵ", "traducao_palavra": "o rei" },
        { "hebraico": "שְׂדֹתֵ֖ינוּ", "transliteral": "śə-ḏō-ṯê-nū", "traducao_palavra": "[sobre] nossos campos" },
        { "hebraico": "וּכְרָמֵֽינוּ׃", "transliteral": "ū-ḵə-rā-mê-nū", "traducao_palavra": "e nossas vinhas" }
      ]
    },
    "5": {
      "traducao_completa": "Agora, pois, a nossa carne é como a carne de nossos irmãos, e nossos filhos como os filhos deles; e eis que sujeitamos nossos filhos e nossas filhas para serem servos, e algumas de nossas filhas já estão sujeitas, e não está no poder de nossas mãos evitá-lo; pois outros têm as nossas terras e as nossas vinhas.",
      "palavras": [
        { "hebraico": "וְעַתָּה֙", "transliteral": "wə-ʿat-tā", "traducao_palavra": "E agora" },
        { "hebraico": "כִּבְשַׂ֤ר", "transliteral": "kə-ḇə-śar", "traducao_palavra": "como a carne de" },
        { "hebraico": "אֲחֵ֙ינוּ֙", "transliteral": "ʾă-ḥê-nū", "traducao_palavra": "nossos irmãos" },
        { "hebraico": "בְּשָׂרֵ֔נוּ", "transliteral": "bə-śā-rê-nū", "traducao_palavra": "[é] nossa carne" },
        { "hebraico": "כִּבְנֵיהֶ֖ם", "transliteral": "kə-ḇə-nê-hem", "traducao_palavra": "como os filhos deles" },
        { "hebraico": "בָּנֵ֑ינוּ", "transliteral": "bā-nê-nū", "traducao_palavra": "[são] nossos filhos" },
        { "hebraico": "וְהִנֵּ֣ה", "transliteral": "wə-hin-nēh", "traducao_palavra": "e eis que" },
        { "hebraico": "אֲנַ֣חְנוּ", "transliteral": "ʾă-naḥ-nū", "traducao_palavra": "nós" },
