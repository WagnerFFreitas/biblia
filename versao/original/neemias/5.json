        { "hebraico": "בָּנֵ֨ינוּ", "transliteral": "bā-nê-nū", "traducao_palavra": "nossos filhos" },
        { "hebraico": "וְאֶת־", "transliteral": "wə-ʾeṯ-", "traducao_palavra": "e [objeto]" },
        { "hebraico": "בְּנֹתֵינוּ֙", "transliteral": "bə-nō-ṯê-nū", "traducao_palavra": "nossas filhas" },
        { "hebraico": "לַעֲבָדִ֔ים", "transliteral": "la-ʿă-ḇā-ḏîm", "traducao_palavra": "para servos" },
