        { "hebraico": "יָשְׁב֞וּ", "transliteral": "yā-šə-ḇū", "traducao_palavra": "habitaram" },
        { "hebraico": "בְּקִרְיַ֤ת", "transliteral": "bə-qir-yaṯ", "traducao_palavra": "em Quiriate-" },
        { "hebraico": "הָֽאַרְבַּע֙", "transliteral": "hā-ʾar-baʿ", "traducao_palavra": "Arba" },
        { "hebraico": "וּבְנֹתֶ֔יהָ", "transliteral": "ū-ḇə-nō-ṯe-hā", "traducao_palavra": "e suas vilas" },
        { "hebraico": "וּבְדִיבֹן֙", "transliteral": "ū-ḇə-ḏî-ḇōn", "traducao_palavra": "e em Dibom" },
        { "hebraico": "וּבְנֹתֶ֔יהָ", "transliteral": "ū-ḇə-nō-ṯe-hā", "traducao_palavra": "e suas vilas" },
        { "hebraico": "וּבִיקַּבְצְאֵ֖ל", "transliteral": "ū-ḇî-qab-ṣə-ʾêl", "traducao_palavra": "e em Jecabzeel" },
