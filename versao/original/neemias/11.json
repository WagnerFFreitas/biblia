        { "hebraico": "בֶן־", "transliteral": "ben-", "traducao_palavra": "filho de" },
        { "hebraico": "מְשֵׁיזַבְאֵ֜ל", "transliteral": "mə-šê-zaᇔ-ʾêl", "traducao_palavra": "Mesezabeel" },
        { "hebraico": "מִבְּנֵי־", "transliteral": "mib-bə-nê-", "traducao_palavra": "dos filhos de" },
        { "hebraico": "זֶ֤רַע", "transliteral": "ze-raʿ", "traducao_palavra": "Zerá" },
        { "hebraico": "בֶּן־", "transliteral": "ben-", "traducao_palavra": "filho de" },
        { "hebraico": "יְהוּדָה֙", "transliteral": "yə-hū-ḏā", "traducao_palavra": "Judá" },
        { "hebraico": "לְיַ֣ד", "transliteral": "lə-yaḏ", "traducao_palavra": "à mão de" },
        { "hebraico": "הַמֶּ֔לֶךְ", "transliteral": "ham-me-leḵ", "traducao_palavra": "o rei" },
        { "hebraico": "לְכָל־", "transliteral": "lə-ḵāl-", "traducao_palavra": "para todo" },
        { "hebraico": "דָּבָ֖ר", "transliteral": "dā-ḇār", "traducao_palavra": "negócio/assunto" },
        { "hebraico": "לָעָֽם׃", "transliteral": "lā-ʿām", "traducao_palavra": "do povo" }
      ]
    },
    "25": {
      "traducao_completa": "E quanto às aldeias com as suas terras, alguns dos filhos de Judá habitaram em Quiriate-Arba e nos seus lugares, em Dibom e nos seus lugares, e em Jecabzeel e nas suas aldeias,",
