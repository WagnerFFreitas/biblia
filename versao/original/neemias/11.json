        { "hebraico": "הַחֲצֵרִ֖ים", "transliteral": "ha-ḥă-ṣê-rîm", "traducao_palavra": "as aldeias" },
        { "hebraico": "בִּשְׂדֹתָ֑ם", "transliteral": "biś-ḏō-ṯām", "traducao_palavra": "com seus campos" },
        { "hebraico": "מִבְּנֵ֣i", "transliteral": "mib-bə-nê", "traducao_palavra": "dos filhos de" },
