        { "hebraico": "אֲשֶׁ֣ר", "transliteral": "ʾă-šer", "traducao_palavra": "que" },
        { "hebraico": "עָל֞וּ", "transliteral": "ʿā-lû", "traducao_palavra": "subiram" },
        { "hebraico": "עִם־", "transliteral": "ʿim-", "traducao_palavra": "com" },
