    "45": {
      "traducao_completa": "E guardavam o ministério do seu Deus, e o ministério da purificação; como também os cantores e os porteiros, conforme o mandamento de Davi e de seu filho Salomão.",
      "palavras": [
        { "hebraico": "וַֽיִּשְׁמְר֞וּ", "transliteral": "way-yiš-mə-rû", "traducao_palavra": "E guardavam" },
