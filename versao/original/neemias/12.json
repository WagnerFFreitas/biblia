        { "hebraico": "אֱלֹהֵיהֶם֙", "transliteral": "ʾĕ-lō-hê-hem", "traducao_palavra": "Deus deles" },
        { "hebraico": "וּמִשְׁמֶ֣רֶת", "transliteral": "ū-miš-me-reṯ", "traducao_palavra": "e o serviço de" },
        { "hebraico": "הַטָּהֳרָ֔ה", "transliteral": "ha-ṭā-hŏ-rā", "traducao_palavra": "purificação" },
        { "hebraico": "וְהַמְשֹׁרְרִ֖ים", "transliteral": "wə-ham-šō-rə-rîm", "traducao_palavra": "e os cantores" },
        { "hebraico": "וְהַשֹּׁועֲרִ֑ים", "transliteral": "wə-ha-šō-w-ă-rîm", "traducao_palavra": "e os porteiros" },
        { "hebraico": "כְּמִצְוַ֥ת", "transliteral": "kə-miṣ-waṯ", "traducao_palavra": "segundo o mandamento de" },
        { "hebraico": "דָּוִ֖יד", "transliteral": "dā-wîḏ", "traducao_palavra": "Davi" },
        { "hebraico": "שְׁלֹמֹ֥ה", "transliteral": "šə-lō-mōh", "traducao_palavra": "[e]" },
