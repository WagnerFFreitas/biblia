        { "hebraico": "שְׁאַלְתִּיאֵ֛ל", "transliteral": "šə-ʾal-tî-ʾêl", "traducao_palavra": "Sealtiel" },
        { "hebraico": "וְיֵשׁ֖וּעַ", "transliteral": "wə-yê-šū-aʿ", "traducao_palavra": "e Jesua" },
        { "hebraico": "שְׂרָיָ֥ה", "transliteral": "śə-rā-yā", "traducao_palavra": "Seraías" },
        { "hebraico": "יִרְמְיָ֖ה", "transliteral": "yir-mə-yā", "traducao_palavra": "Jeremias" },
        { "hebraico": "עֶזְרָֽא׃", "transliteral": "ʿez-rā", "traducao_palavra": "Esdras" }
