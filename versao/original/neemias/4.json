        { "hebraico": "הָעָ֔ם", "transliteral": "hā-ʿām", "traducao_palavra": "o povo" },
        { "hebraico": "הַמְּלָאכָ֥ה", "transliteral": "ham-mə-lā-ḵā", "traducao_palavra": "a obra" },
