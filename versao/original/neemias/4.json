        { "hebraico": "וְהָרְמָחִ֣ים", "transliteral": "wə-ha-rə-mā-ḥîm", "traducao_palavra": "as lanças" },
        { "hebraico": "הַמָּגִנִּים֙", "transliteral": "ham-mā-ḡin-nîm", "traducao_palavra": "os escudos" },
        { "hebraico": "וְהַקְּשָׁתֹ֣ות", "transliteral": "wə-ha-qə-šā-ṯō-wṯ", "traducao_palavra": "os arcos" },
        { "hebraico": "וְהַשִּׁרְיֹנִ֑ים", "transliteral": "wə-haš-šir-yō-nîm", "traducao_palavra": "e as couraças" },
        { "hebraico": "וְהַשָּׂרִ֕ים", "transliteral": "wə-has-śā-rîm", "traducao_palavra": "e os príncipes/chefes" },
