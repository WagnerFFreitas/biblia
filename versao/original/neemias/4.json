        { "hebraico": "כָּל־", "transliteral": "kāl-", "traducao_palavra": "toda a" },
        { "hebraico": "בֵּ֥ית", "transliteral": "bêṯ", "traducao_palavra": "casa de" },
        { "hebraico": "יְהוּדָֽה׃", "transliteral": "yə-hū-ḏā", "traducao_palavra": "Judá" }
      ]
