        { "hebraico": "אַל־", "transliteral": "ʾal-", "traducao_palavra": "Não" },
        { "hebraico": "תִּֽירְא֣וּ", "transliteral": "tî-rə-ʾū", "traducao_palavra": "temais" },
        { "hebraico": "מִפְּנֵיהֶם֒", "transliteral": "mip-pə-nê-hem", "traducao_palavra": "diante deles" },
