    "15": {
      "traducao_completa": "E sucedeu que, ouvindo os nossos inimigos que já o sabíamos, e que Deus tinha dissipado o conselho deles, todos voltamos ao muro, cada um à sua obra.",
      "palavras": [
        { "hebraico": "וַיְהִ֞י", "transliteral": "way-hî", "traducao_palavra": "E aconteceu" },
        { "hebraico": "כַּאֲשֶׁר־", "transliteral": "ka-ʾă-šer-", "traducao_palavra": "que quando" },
        { "hebraico": "שָׁמְע֣וּ", "transliteral": "šā-mə-ʿū", "traducao_palavra": "ouviram" },
        { "hebraico": "אֹויְבֵ֗ינוּ", "transliteral": "ʾō-wy-ḇê-nū", "traducao_palavra": "nossos inimigos" },
