        { "hebraico": "וַאֲנַ֙חְנוּ֙", "transliteral": "wa-ʾă-naḥ-nū", "traducao_palavra": "e nós" },
        { "hebraico": "נִפְרָדִ֣ים", "transliteral": "nī-p̄ə-rā-ḏîm", "traducao_palavra": "estamos separados" },
