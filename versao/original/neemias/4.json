        { "hebraico": "אֲשֶׁ֤ר", "transliteral": "ʾă-šer", "traducao_palavra": "onde" },
        { "hebraico": "תִּשְׁמְעוּ֙", "transliteral": "tiš-mə-ʿū", "traducao_palavra": "ouvirdes" },
        { "hebraico": "אֶת־", "transliteral": "ʾeṯ-", "traducao_palavra": "[objeto]" },
        { "hebraico": "קֹ֣ול", "transliteral": "qō-wl", "traducao_palavra": "o som de" },
