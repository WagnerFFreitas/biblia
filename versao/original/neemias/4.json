        { "hebraico": "וְחַטָּאתָ֖ם", "transliteral": "wə-ḥaṭ-ṭā-ṯām", "traducao_palavra": "e o pecado deles" },
        { "hebraico": "מִלְּפָנֶ֥יךָ", "transliteral": "mil-lə-p̄ā-ne-ḵā", "traducao_palavra": "de diante de Ti" },
