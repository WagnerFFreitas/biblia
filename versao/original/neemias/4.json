        { "hebraico": "אִ֖ישׁ", "transliteral": "ʾîš", "traducao_palavra": "cada homem" },
        { "hebraico": "אֶל־", "transliteral": "ʾel-", "traducao_palavra": "para" },
        { "hebraico": "מְלַאכְתֹּֽו׃", "transliteral": "mə-laḵ-tō-w", "traducao_palavra": "sua obra" }
      ]
    },
    "16": {
      "traducao_completa": "E sucedeu que, desde aquele dia, metade dos meus moços trabalhava na obra, e a outra metade deles tinha as lanças, os escudos, os arcos e as couraças; e os chefes estavam por detrás de toda a casa de Judá.",
      "palavras": [
        { "hebraico": "וַיְהִ֣י ׀", "transliteral": "way-hî", "traducao_palavra": "E aconteceu" },
        { "hebraico": "מִן־", "transliteral": "min-", "traducao_palavra": "desde" },
        { "hebraico": "הַיֹּ֣ום", "transliteral": "hay-yō-wm", "traducao_palavra": "o dia" },
