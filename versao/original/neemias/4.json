    "13": {
      "traducao_completa": "Pelo que pus guardas nos lugares baixos por detrás do muro e nos lugares abertos; e pus o povo pelas suas famílias com as suas espadas, com as suas lanças e com os seus arcos.",
      "palavras": [
        { "hebraico": "וָאַעֲמִ֞יד", "transliteral": "wā-ʾa-ʿă-mîḏ", "traducao_palavra": "E pus" },
        { "hebraico": "מִתַּחְתִּיֹּ֧ות", "transliteral": "mit-taḥ-tî-yō-wṯ", "traducao_palavra": "nos lugares baixos" },
        { "hebraico": "לַמָּקֹ֛ום", "transliteral": "lam-mā-qō-wm", "traducao_palavra": "do lugar" },
