        { "hebraico": "וְהָֽיוּ־", "transliteral": "wə-hā-yū-", "traducao_palavra": "e sirvam" },
        { "hebraico": "לָ֧נוּ", "transliteral": "lā-nū", "traducao_palavra": "para nós" },
        { "hebraico": "הַלַּ֛יְלָה", "transliteral": "hal-lay-lā", "traducao_palavra": "de noite [como]" },
