        { "hebraico": "בַּחֹומָ֗ה", "transliteral": "ba-ḥō-w-mā", "traducao_palavra": "no muro" },
        { "hebraico": "וְהַנֹּשְׂאִ֥ים", "transliteral": "wə-han-nō-śə-ʾîm", "traducao_palavra": "e os carregadores" },
        { "hebraico": "בַּסֶּ֙בֶל֙", "transliteral": "bas-se-ḇel", "traducao_palavra": "nas cargas" },
        { "hebraico": "עֹמְשִׂ֔ים", "transliteral": "ʿō-mə-śîm", "traducao_palavra": "os que carregavam" },
        { "hebraico": "בְּאַחַ֤ת", "transliteral": "bə-ʾa-ḥaṯ", "traducao_palavra": "com uma" },
        { "hebraico": "יָדֹו֙", "transliteral": "yā-ḏō-w", "traducao_palavra": "mão dele" },
        { "hebraico": "עֹשֶׂ֣ה", "transliteral": "ʿō-śeh", "traducao_palavra": "fazia" },
        { "hebraico": "בַמְּלָאכָ֔ה", "transliteral": "ḇam-mə-lā-ḵā", "traducao_palavra": "na obra" },
        { "hebraico": "וְאַחַ֖ת", "transliteral": "wə-ʾa-ḥaṯ", "traducao_palavra": "e com a outra" },
        { "hebraico": "מַחֲזֶ֥קֶת", "transliteral": "ma-ḥă-ze-qeṯ", "traducao_palavra": "segurava" },
        { "hebraico": "הַשָּֽׁלַח׃", "transliteral": "haš-šā-laḥ", "traducao_palavra": "a arma" }
      ]
    },
    "18": {
      "traducao_completa": "E os edificadores cada um trazia a sua espada cingida aos lombos, e edificavam; e o que tocava a trombeta estava junto a mim.",
      "palavras": [
        { "hebraico": "וְהַבֹּונִ֗ים", "transliteral": "wə-hab-bō-w-nîm", "traducao_palavra": "E os edificadores" },
        { "hebraico": "אִ֣ישׁ", "transliteral": "ʾîš", "traducao_palavra": "cada homem" },
        { "hebraico": "חַרְבֹּ֤ו", "transliteral": "ḥar-bō-w", "traducao_palavra": "sua espada" },
