        { "hebraico": "הַהִיא֙", "transliteral": "ha-hî", "traducao_palavra": "aquele" },
        { "hebraico": "אָמַ֣רְתִּי", "transliteral": "ʾā-mar-tî", "traducao_palavra": "disse" },
        { "hebraico": "לָעָ֔ם", "transliteral": "lā-ʿām", "traducao_palavra": "ao povo" },
        { "hebraico": "אִ֣ישׁ", "transliteral": "ʾîš", "traducao_palavra": "cada homem" },
