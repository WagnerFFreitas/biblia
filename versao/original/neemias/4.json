        { "hebraico": "לַחֹומָ֖ה", "transliteral": "la-ḥō-w-mā", "traducao_palavra": "o muro" },
        { "hebraico": "בַּצְּחִיחִ֑ים", "transliteral": "baṣ-ṣə-ḥî-ḥîm", "traducao_palavra": "nos lugares abertos" },
        { "hebraico": "וָאַעֲמִ֤יד", "transliteral": "wā-ʾa-ʿă-mîḏ", "traducao_palavra": "e pus" },
