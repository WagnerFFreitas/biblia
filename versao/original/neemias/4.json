        { "hebraico": "בַּמְּלָאכָ֑ה", "transliteral": "bam-mə-lā-ḵā", "traducao_palavra": "a obra" },
        { "hebraico": "וְחֶצְיָ֗ם", "transliteral": "wə-ḥeṣ-yām", "traducao_palavra": "e a metade deles" },
        { "hebraico": "מַחֲזִיקִים֙", "transliteral": "ma-ḥă-zî-qîm", "traducao_palavra": "seguravam" },
