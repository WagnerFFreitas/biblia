        { "hebraico": "וַיָּ֥פֶר", "transliteral": "way-yā-p̄er", "traducao_palavra": "e frustrou" },
        { "hebraico": "הָאֱלֹהִ֖ים", "transliteral": "hā-ʾĕ-lō-hîm", "traducao_palavra": "o Deus" },
        { "hebraico": "אֶת־", "transliteral": "ʾeṯ-", "traducao_palavra": "[objeto]" },
