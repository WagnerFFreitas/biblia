        { "hebraico": "בְּגָדִ֜ים", "transliteral": "bə-ḡā-ḏîm", "traducao_palavra": "vestes" },
        { "hebraico": "לְהַלְבִּ֣ישׁ", "transliteral": "lə-hal-bîš", "traducao_palavra": "para vestir" },
        { "hebraico": "אֶת־", "transliteral": "ʾeṯ-", "traducao_palavra": "[objeto]" },
        { "hebraico": "מָרְדֳּכַ֗י", "transliteral": "mā-rə-ḏo-ḵay", "traducao_palavra": "a Mardoqueu" },
        { "hebraico": "וּלְהָסִ֥יר", "transliteral": "ū-lə-hā-śîr", "traducao_palavra": "e para tirar" },
