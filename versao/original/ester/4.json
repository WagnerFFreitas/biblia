{
  "livro": "Ester - אֶסְתֵּר - ʾEs-tēr",
  "capítulo": 4,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Quando Mardoqueu soube tudo quanto se havia feito, rasgou Mardoqueu as suas vestes, e vestiu-se de saco e de cinza, e saiu pelo meio da cidade, e clamou com grande e amargo clamor;",
