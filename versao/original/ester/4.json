        { "hebraico": "מִסָּרִיסֵ֣י", "transliteral": "mis-śā-rî-śê", "traducao_palavra": "dos eunucos de" },
        { "hebraico": "הַמֶּּלֶךְ֮", "transliteral": "ham-me-leḵ", "traducao_palavra": "o rei" },
        { "hebraico": "אֲשֶׁ֣ר", "transliteral": "ʾă-šer", "traducao_palavra": "que" },
        { "hebraico": "הֶעֱמִ֣יד", "transliteral": "he-ʿĕ-mîḏ", "traducao_palavra": "tinha posto" },
