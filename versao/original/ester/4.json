        { "hebraico": "לַיְּהוּדִ֔ים", "transliteral": "lay-hū-ḏîm", "traducao_palavra": "para os judeus" },
        { "hebraico": "וְצֹ֥ום", "transliteral": "wə-ṣō-wm", "traducao_palavra": "e jejum" },
        { "hebraico": "וּבְכִ֖י", "transliteral": "ū-ḇə-ḵî", "traducao_palavra": "e choro" },
