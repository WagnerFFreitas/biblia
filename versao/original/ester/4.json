        { "hebraico": "מֵעָלָ֖יו", "transliteral": "mê-ʿā-lāyw", "traducao_palavra": "de sobre ele" },
        { "hebraico": "וְלֹ֥א", "transliteral": "wə-lō", "traducao_palavra": "mas não" },
        { "hebraico": "קִבֵּֽל׃", "transliteral": "qib-bêl", "traducao_palavra": "aceitou" }
