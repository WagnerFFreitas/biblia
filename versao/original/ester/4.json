        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "para" },
        { "hebraico": "מָרְדֳּכָ֑י", "transliteral": "mā-rə-ḏo-ḵāy", "traducao_palavra": "Mardoqueu" },
        { "hebraico": "לָדַ֥עַת", "transliteral": "lā-ḏa-ʿaṯ", "traducao_palavra": "para saber" },
        { "hebraico": "מַה־", "transliteral": "mah-", "traducao_palavra": "o que" },
