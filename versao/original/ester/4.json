        { "hebraico": "אֶת־", "transliteral": "ʾeṯ-", "traducao_palavra": "[objeto]" },
        { "hebraico": "כָּל־", "transliteral": "kāl-", "traducao_palavra": "tudo" },
        { "hebraico": "אֲשֶׁ֥ר", "transliteral": "ʾă-šer", "traducao_palavra": "o que" },
        { "hebraico": "נַעֲשָׂ֑ה", "transliteral": "na-ʿă-śā", "traducao_palavra": "se havia feito" },
        { "hebraico": "וַיִּקְרַ֨ע", "transliteral": "way-yiq-raʿ", "traducao_palavra": "e rasgou" },
        { "hebraico": "מָרְדֳּכַי֙", "transliteral": "mā-rə-ḏo-ḵay", "traducao_palavra": "Mardoqueu" },
        { "hebraico": "בְּגָדָ֔יו", "transliteral": "bə-ḡā-ḏāyw", "traducao_palavra": "suas vestes" },
        { "hebraico": "וַיִּלְבַּ֥שׁ", "transliteral": "way-yil-baš", "traducao_palavra": "e vestiu" },
        { "hebraico": "שַׂ֖ק", "transliteral": "śaq", "traducao_palavra": "pano de saco" },
        { "hebraico": "וָאֵ֑פֶר", "transliteral": "wā-ʾê-p̄er", "traducao_palavra": "e cinza" },
        { "hebraico": "וַיֵּצֵא֙", "transliteral": "way-yê-ṣê", "traducao_palavra": "e saiu" },
        { "hebraico": "בְּתֹ֣וךְ", "transliteral": "bə-ṯō-wḵ", "traducao_palavra": "pelo meio de" },
        { "hebraico": "הָעִ֔יר", "transliteral": "hā-ʿîr", "traducao_palavra": "a cidade" },
