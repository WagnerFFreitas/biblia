        { "hebraico": "לָרַבִּֽים׃", "transliteral": "lā-rab-bîm", "traducao_palavra": "para muitos" }
      ]
    },
    "4": {
      "traducao_completa": "Então vieram as moças de Ester e os seus eunucos, e fizeram-no saber, o que muito deprimiu a rainha; e enviou vestes para vestir a Mardoqueu, e tirar-lhe o saco; porém ele não as aceitou.",
      "palavras": [
        { "hebraico": "וַתָּבֹואֶינָה֩", "transliteral": "wat-tā-ḇō-w-ʾe-nā", "traducao_palavra": "E vieram" },
        { "hebraico": "נַעֲרֹ֨ות", "transliteral": "na-ʿă-rō-wṯ", "traducao_palavra": "as moças de" },
        { "hebraico": "אֶסְתֵּ֤ר", "transliteral": "ʾes-têr", "traducao_palavra": "Ester" },
        { "hebraico": "וְסָרִיסֶ֙יהָ֙", "transliteral": "wə-śā-rî-śe-hā", "traducao_palavra": "e seus eunucos" },
        { "hebraico": "וַיַּגִּ֣ידוּ", "transliteral": "way-yag-gî-ḏū", "traducao_palavra": "e contaram" },
        { "hebraico": "לָ֔הּ", "transliteral": "lāh", "traducao_palavra": "a ela" },
        { "hebraico": "וַתִּתְחַלְחַ֥ל", "transliteral": "wat-tiṯ-ḥal-ḥal", "traducao_palavra": "e ficou angustiada" },
