        { "hebraico": "גְדֹלָ֖ה", "transliteral": "ḡə-ḏō-lā", "traducao_palavra": "grande" },
        { "hebraico": "וּמָרָֽה׃", "transliteral": "ū-mā-rā", "traducao_palavra": "e amargo" }
      ]
