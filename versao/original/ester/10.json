        { "hebraico": "אֲחַשְׁוֵרֹ֧שׁ", "transliteral": "ʾă-ḥaš-wê-rōš", "traducao_palavra": "Assuero" },
        { "hebraico": "מַ֛ס", "transliteral": "mas", "traducao_palavra": "tributo" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre" },
