        { "hebraico": "גְּדֻלַּ֣ת", "transliteral": "gə-ḏul-laṯ", "traducao_palavra": "a grandeza de" },
        { "hebraico": "מָרְדֳּכַ֔י", "transliteral": "mā-rə-ḏo-ḵay", "traducao_palavra": "Mardoqueu" },
        { "hebraico": "אֲשֶׁ֥ר", "transliteral": "ʾă-šer", "traducao_palavra": "que" },
