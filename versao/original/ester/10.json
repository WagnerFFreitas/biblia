        { "hebraico": "מַעֲשֵׂ֤ה", "transliteral": "ma-ʿă-śê", "traducao_palavra": "as obras de" },
        { "hebraico": "תָקְפֹּו֙", "transliteral": "ṯāq-pō-w", "traducao_palavra": "seu poder" },
