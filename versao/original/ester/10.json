        { "hebraico": "הַמֶּּ֑לֶךְ", "transliteral": "ham-me-leḵ", "traducao_palavra": "o rei" },
        { "hebraico": "הֲלֹוא־", "transliteral": "hă-lô-w-", "traducao_palavra": "porventura não" },
        { "hebraico": "הֵ֣ם", "transliteral": "hêm", "traducao_palavra": "[estão] elas" },
