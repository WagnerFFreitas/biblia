        { "hebraico": "אֵ֣ין", "transliteral": "ʾên", "traducao_palavra": "não havia" },
        { "hebraico": "אֹנֵ֑ס", "transliteral": "ʾō-nês", "traducao_palavra": "quem forçasse" },
        { "hebraico": "כִּי־", "transliteral": "kî-", "traducao_palavra": "porque" },
        { "hebraico": "כֵ֣ן", "transliteral": "ḵên", "traducao_palavra": "assim" },
        { "hebraico": "יִסַּ֣ד", "transliteral": "yis-saḏ", "traducao_palavra": "tinha ordenado" },
        { "hebraico": "הַמֶּלֶךְ֮", "transliteral": "ham-me-leḵ", "traducao_palavra": "o rei" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "a" },
