        { "hebraico": "וְעַמּ֣וּדֵי", "transliteral": "wə-ʿam-mû-ḏê", "traducao_palavra": "e colunas de" },
        { "hebraico": "שֵׁ֑שׁ", "transliteral": "šêš", "traducao_palavra": "mármore/alabastro" },
        { "hebraico": "מִטֹּות֙", "transliteral": "miṭ-ṭō-wṯ", "traducao_palavra": "leitos de" },
