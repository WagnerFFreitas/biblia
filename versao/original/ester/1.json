        { "hebraico": "לַעֲשֹׂ֖ות", "transliteral": "la-ʿă-śō-wṯ", "traducao_palavra": "para fazer" },
        { "hebraico": "כִּרְצֹ֥ון", "transliteral": "kir-ṣō-wn", "traducao_palavra": "conforme a vontade de" },
