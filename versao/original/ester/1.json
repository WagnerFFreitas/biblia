        { "hebraico": "בִּיתַ֖ן", "transliteral": "bî-ṯan", "traducao_palavra": "palácio de" },
        { "hebraico": "הַמֶּּֽלֶךְ׃", "transliteral": "ham-me-leḵ", "traducao_palavra": "o rei" }
      ]
    },
    "6": {
      "traducao_completa": "As tapeçarias eram de pano branco, verde e azul, presas com cordões de linho fino e púrpura a argolas de prata e a colunas de mármore; os leitos eram de ouro e de prata, sobre um pavimento de pórfiro, de mármore, de alabastro e de pedras preciosas.",
