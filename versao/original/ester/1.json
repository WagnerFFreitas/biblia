{
  "livro": "Ester - אֶסְתֵּר - ʾEs-tēr",
  "capítulo": 1,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "E sucedeu nos dias de Assuero (o Assuero que reinou desde a Índia até à Etiópia, sobre cento e vinte e sete províncias),",
      "palavras": [
        { "hebraico": "וַיְהִ֖י", "transliteral": "way-hî", "traducao_palavra": "E aconteceu" },
        { "hebraico": "בִּימֵ֣י", "transliteral": "bî-mê", "traducao_palavra": "nos dias de" },
        { "hebraico": "אֲחַשְׁוֵרֹ֑ושׁ", "transliteral": "ʾă-ḥaš-wê-rō-wš", "traducao_palavra": "Assuero" },
        { "hebraico": "ה֣וּא", "transliteral": "hû", "traducao_palavra": "ele [é]" },
        { "hebraico": "אֲחַשְׁוֵרֹ֗ושׁ", "transliteral": "ʾă-ḥaš-wê-rō-wš", "traducao_palavra": "Assuero" },
        { "hebraico": "הַמֹּלֵךְ֙", "transliteral": "ham-mō-lêḵ", "traducao_palavra": "que reinava" },
        { "hebraico": "מֵהֹ֣דּוּ", "transliteral": "mê-hō-dû", "traducao_palavra": "desde a Índia" },
        { "hebraico": "וְעַד־", "transliteral": "wə-ʿaḏ-", "traducao_palavra": "e até" },
        { "hebraico": "כּ֔וּשׁ", "transliteral": "kûš", "traducao_palavra": "Etiópia [Cuxe]" },
        { "hebraico": "שֶׁ֧בַע", "transliteral": "še-ḇaʿ", "traducao_palavra": "sete" },
        { "hebraico": "וְעֶשְׂרִ֛ים", "transliteral": "wə-ʿeś-rîm", "traducao_palavra": "e vinte" },
        { "hebraico": "וּמֵאָ֥ה", "transliteral": "ū-mê-ʾā", "traducao_palavra": "e cem" },
        { "hebraico": "מְדִינָֽה׃", "transliteral": "mə-ḏî-nā", "traducao_palavra": "províncias" }
      ]
    },
    "2": {
      "traducao_completa": "Naqueles dias, assentando-se o rei Assuero sobre o trono do seu reino, que estava na fortaleza de Susã,",
      "palavras": [
        { "hebraico": "בַּיָּמִ֖ים", "transliteral": "bay-yā-mîm", "traducao_palavra": "Nos dias" },
        { "hebraico": "הָהֵ֑ם", "transliteral": "hā-hêm", "traducao_palavra": "aqueles" },
        { "hebraico": "כְּשֶׁ֣בֶת", "transliteral": "kə-še-ḇeṯ", "traducao_palavra": "ao assentar-se" },
        { "hebraico": "הַמֶּ֣לֶךְ", "transliteral": "ham-me-leḵ", "traducao_palavra": "o rei" },
        { "hebraico": "אֲחַשְׁוֵרֹ֗ושׁ", "transliteral": "ʾă-ḥaš-wê-rō-wš", "traducao_palavra": "Assuero" },
        { "hebraico": "עַ֚ל", "transliteral": "ʿal", "traducao_palavra": "sobre" },
        { "hebraico": "כִּסֵּ֣א", "transliteral": "kis-śê", "traducao_palavra": "o trono de" },
        { "hebraico": "מַלְכוּתֹ֔ו", "transliteral": "mal-ḵû-ṯô", "traducao_palavra": "seu reino" },
        { "hebraico": "אֲשֶׁ֖ר", "transliteral": "ʾă-šer", "traducao_palavra": "que [estava]" },
        { "hebraico": "בְּשׁוּשַׁ֥ן", "transliteral": "bə-šū-šan", "traducao_palavra": "em Susã" },
        { "hebraico": "הַבִּירָֽה׃", "transliteral": "hab-bî-rā", "traducao_palavra": "a fortaleza" }
      ]
    },
    "3": {
      "traducao_completa": "No terceiro ano do seu reinado, fez um banquete a todos os seus príncipes e seus servos (o exército da Pérsia e da Média, e os nobres e governadores das províncias estavam perante ele),",
      "palavras": [
        { "hebraico": "בִּשְׁנַ֤ת", "transliteral": "biš-naṯ", "traducao_palavra": "No ano" },
        { "hebraico": "שָׁלֹושׁ֙", "transliteral": "šā-lō-wš", "traducao_palavra": "terceiro" },
        { "hebraico": "לְמָלְכֹ֔ו", "transliteral": "lə-māl-ḵô", "traducao_palavra": "do seu reinado" },
        { "hebraico": "עָשָׂ֣ה", "transliteral": "ʿā-śā", "traducao_palavra": "fez" },
        { "hebraico": "מִשְׁתֶּ֔ה", "transliteral": "miš-teh", "traducao_palavra": "um banquete" },
        { "hebraico": "לְכָל־", "transliteral": "lə-ḵāl-", "traducao_palavra": "para todos" },
        { "hebraico": "שָׂרָ֖יו", "transliteral": "śā-rāyw", "traducao_palavra": "seus príncipes" },
        { "hebraico": "וַעֲבָדָ֑יו", "transliteral": "wa-ʿă-ḇā-ḏāyw", "traducao_palavra": "e seus servos" },
        { "hebraico": "חֵ֣יל", "transliteral": "ḥêl", "traducao_palavra": "o exército de" },
        { "hebraico": "פָּרַ֣ס", "transliteral": "pā-ras", "traducao_palavra": "Pérsia" },
        { "hebraico": "וּמָדַ֗י", "transliteral": "ū-mā-ḏay", "traducao_palavra": "e Média" },
        { "hebraico": "הַפַּרְתְּמִ֛ים", "transliteral": "hap-par-tə-mîm", "traducao_palavra": "os nobres" },
        { "hebraico": "וְשָׂרֵ֥י", "transliteral": "wə-śā-rê", "traducao_palavra": "e os chefes de" },
        { "hebraico": "הַמְּדִינֹ֖ות", "transliteral": "ham-mə-ḏî-nō-wṯ", "traducao_palavra": "as províncias" },
        { "hebraico": "לְפָנָֽיו׃", "transliteral": "lə-p̄ā-nāyw", "traducao_palavra": "diante dele" }
      ]
    },
    "4": {
      "traducao_completa": "Para mostrar as riquezas da glória do seu reino, e o esplendor da sua excelente grandeza, por muitos dias, a saber, cento e oitenta dias.",
      "palavras": [
        { "hebraico": "בְּהַרְאֹתֹ֗ו", "transliteral": "bə-har-ʾō-ṯô", "traducao_palavra": "ao mostrar ele" },
        { "hebraico": "אֶת־", "transliteral": "ʾeṯ-", "traducao_palavra": "[objeto]" },
        { "hebraico": "עֹ֙שֶׁר֙", "transliteral": "ʿō-šer", "traducao_palavra": "as riquezas de" },
        { "hebraico": "כְּבֹ֣וד", "transliteral": "kə-ḇō-wḏ", "traducao_palavra": "glória de" },
