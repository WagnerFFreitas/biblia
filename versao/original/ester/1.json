        { "hebraico": "וְאֶת־", "transliteral": "wə-ʾeṯ-", "traducao_palavra": "e [objeto]" },
        { "hebraico": "יְקָ֕ר", "transliteral": "yə-qār", "traducao_palavra": "a honra/esplendor de" },
        { "hebraico": "תִּפְאֶ֖רֶת", "transliteral": "tip̄-ʾe-reṯ", "traducao_palavra": "excelência de" },
