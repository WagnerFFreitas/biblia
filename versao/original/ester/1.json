      ]
    },
    "8": {
      "traducao_completa": "E o beber era, por lei, sem que ninguém forçasse a outro; porque assim tinha ordenado o rei a todos os oficiais da sua casa, que fizessem conforme a vontade de cada um.",
      "palavras": [
        { "hebraico": "וְהַשְּׁתִיָּ֥ה", "transliteral": "wə-haš-šə-ṯî-yā", "traducao_palavra": "E o beber" },
