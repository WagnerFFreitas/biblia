      ]
    },
    "5": {
      "traducao_completa": "E, cumpridos aqueles dias, fez o rei um banquete a todo o povo que se achou na fortaleza de Susã, desde o maior até ao menor, por sete dias, no pátio do jardim do palácio do rei.",
      "palavras": [
