        { "hebraico": "אֶת־מַלְכּ֣וּת", "transliteral": "ʾeṯ-mal-ḵūṯ", "traducao_palavra": "o reino de" },
        { "hebraico": "יְהוּדָ֔ה", "transliteral": "yə-hū-ḏāh", "traducao_palavra": "Judá" },
        { "hebraico": "וַיְאַמְּצ֛וּ", "transliteral": "way-ʾam-mə-ṣū", "traducao_palavra": "e corroboraram/fortaleceram" },
        { "hebraico": "אֶת־רְחַבְעָ֥ם", "transliteral": "ʾeṯ-rə-ḥaḇ-ʿām", "traducao_palavra": "a Roboão" },
        { "hebraico": "בֶּן־שְׁלֹמֹ֖ה", "transliteral": "ben-šə-lō-mōh", "traducao_palavra": "filho de Salomão" },
