        { "hebraico": "כִּ֣י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "הָלְכ֗וּ", "transliteral": "hā-lə-ḵû", "traducao_palavra": "andaram" },
        { "hebraico": "בְּדֶ֧רֶךְ", "transliteral": "bə-ḏe-reḵ", "traducao_palavra": "no caminho de" },
        { "hebraico": "דָּוִ֛יד", "transliteral": "dā-wîḏ", "traducao_palavra": "Davi" },
        { "hebraico": "וּשְׁלֹמֹ֖ה", "transliteral": "ū-šə-lō-mōh", "traducao_palavra": "e Salomão" },
