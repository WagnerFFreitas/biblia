        { "hebraico": "עָשָׂ֛ה", "transliteral": "ʿā-śāh", "traducao_palavra": "fizera" },
        { "hebraico": "מְנַשֶּׁ֥ה", "transliteral": "mə-naš-šeh", "traducao_palavra": "Manassés" },
