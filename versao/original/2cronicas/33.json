        { "hebraico": "וְהַמְּקֹומֹ֡ות", "transliteral": "wə-ham-mə-qô-môṯ", "traducao_palavra": "e os lugares" },
        { "hebraico": "אֲשֶׁר֩", "transliteral": "ʾă-šer", "traducao_palavra": "onde" },
        { "hebraico": "בָּנָ֨ה", "transliteral": "bā-nāh", "traducao_palavra": "edificou" },
