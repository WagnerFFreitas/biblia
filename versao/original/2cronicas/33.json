        { "hebraico": "הָרַ֛ע", "transliteral": "hā-raʿ", "traducao_palavra": "o mau" },
        { "hebraico": "בְּעֵינֵ֥י", "transliteral": "bə-ʿê-nê", "traducao_palavra": "nos olhos de" },
        { "hebraico": "יְהוָ֖ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "כַּאֲשֶׁ֥ר", "transliteral": "ka-ʾă-šer", "traducao_palavra": "conforme" },
        { "hebraico": "עָשָׂ֖ה", "transliteral": "ʿā-śāh", "traducao_palavra": "fez" },
        { "hebraico": "מְנַשֶּׁ֣ה", "transliteral": "mə-naš-šeh", "traducao_palavra": "Manassés" },
        { "hebraico": "אָבִ֑יו", "transliteral": "ʾā-ḇîw", "traducao_palavra": "seu pai" },
        { "hebraico": "וּלְכָל־הַפְּסִילִ֗ים", "transliteral": "ū-lə-ḵāl-hap-pə-śî-lîm", "traducao_palavra": "e a todos os ídolos" },
