        { "hebraico": "וְהֵעָ֨תֶר־לֹ֜ו", "transliteral": "wə-hê-ʿā-ṯer-lô", "traducao_palavra": "e o ser aplacado para ele" },
        { "hebraico": "וְכָל־חַטָּאתֹ֣ו", "transliteral": "wə-ḵāl-ḥaṭ-ṭā-ṯô", "traducao_palavra": "e todo o pecado dele" },
