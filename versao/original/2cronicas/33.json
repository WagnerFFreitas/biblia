        { "hebraico": "וְהֵעֱמִ֤יד", "transliteral": "wə-hê-ʿĕ-mîḏ", "traducao_palavra": "e estabeleceu" },
        { "hebraico": "הָאֲשֵׁרִים֙", "transliteral": "hā-ʾă-šê-rîm", "traducao_palavra": "os bosques" },
        { "hebraico": "וְהַפְּסִלִ֔ים", "transliteral": "wə-hap-pə-śi-lîm", "traducao_palavra": "e as imagens" },
        { "hebraico": "לִפְנֵ֖י", "transliteral": "lip̄-nê", "traducao_palavra": "antes de" },
