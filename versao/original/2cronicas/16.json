    "12": {
      "traducao_completa": "E adoeceu Asa de seus pés no trigésimo nono ano do seu reinado; e a sua enfermidade era mui grave; contudo, na sua enfermidade não buscou a YHWH, mas aos médicos.",
      "palavras": [
        { "hebraico": "וַיֶּחֱלֶ֣א", "transliteral": "way-ye-ḥĕ-le", "traducao_palavra": "e adoeceu" },
        { "hebraico": "אָֺסָ֡א", "transliteral": "ʾā-śā", "traducao_palavra": "Asa" },
        { "hebraico": "בִּשְׁנַת֩", "transliteral": "biš-naṯ", "traducao_palavra": "no ano" },
        { "hebraico": "שְׁלֹשִׁ֨ים", "transliteral": "šə-lō-šîm", "traducao_palavra": "trinta" },
        { "hebraico": "וָתֵ֤שַׁע", "transliteral": "wā-ṯê-šaʿ", "traducao_palavra": "e nove" },
        { "hebraico": "לְמַלְכוּתֹו֙", "transliteral": "lə-mal-ḵū-ṯô", "traducao_palavra": "do seu reinado" },
