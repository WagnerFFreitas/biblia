        { "hebraico": "וַיְרַצֵּ֥ץ", "transliteral": "way-raṣ-ṣêṣ", "traducao_palavra": "e oprimiu/esmagou" },
        { "hebraico": "אָסָ֛א", "transliteral": "ʾā-śā", "traducao_palavra": "Asa" },
        { "hebraico": "מִן־הָעָ֖ם", "transliteral": "min-hā-ʿām", "traducao_palavra": "[alguns] do povo" },
