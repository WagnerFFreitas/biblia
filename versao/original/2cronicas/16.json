        { "hebraico": "דִּבְרֵ֣י", "transliteral": "diḇ-rê", "traducao_palavra": "os atos/palavras de" },
        { "hebraico": "אָסָ֔א", "transliteral": "ʾā-śā", "traducao_palavra": "Asa" },
        { "hebraico": "הָרִאשֹׁנִ֖ים", "transliteral": "hā-ri-šō-nîm", "traducao_palavra": "os primeiros" },
