        { "hebraico": "חָלְיֹ֑ו", "transliteral": "ḥo-lə-yô", "traducao_palavra": "a sua doença" },
        { "hebraico": "וְגַם־בְּחָלְיֹו֙", "transliteral": "wə-ḡam-bə-ḥo-lə-yô", "traducao_palavra": "e também na sua doença" },
        { "hebraico": "לֹא־דָרַ֣שׁ", "transliteral": "lō-ḏā-raš", "traducao_palavra": "não buscou" },
        { "hebraico": "אֶת־יְהוָ֔ה", "transliteral": "ʾeṯ-YHWH", "traducao_palavra": "a YHWH" },
