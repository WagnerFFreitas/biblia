        { "hebraico": "וּבְהִשָּׁעֶנְךָ֥", "transliteral": "ū-ḇə-hiš-šā-ʿen-ḵā", "traducao_palavra": "e por teu apoiar-te" },
        { "hebraico": "עַל־יְהוָ֖ה", "transliteral": "ʿal-YHWH", "traducao_palavra": "em YHWH" },
        { "hebraico": "נְתָנָ֥ם", "transliteral": "nə-ṯā-nām", "traducao_palavra": "entregou-os" },
        { "hebraico": "בְּיָדֶֽךָ׃", "transliteral": "bə-yā-ḏe-ḵā", "traducao_palavra": "na tua mão" }
