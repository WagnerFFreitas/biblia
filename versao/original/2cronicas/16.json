        { "hebraico": "בַמִּשְׁכָּ֗ב", "transliteral": "ḇam-miš-kāḇ", "traducao_palavra": "no leito/cama" },
        { "hebraico": "אֲשֶׁ֨ר", "transliteral": "ʾă-šer", "traducao_palavra": "que" },
