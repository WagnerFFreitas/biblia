        { "hebraico": "שְׂרֵפָ֖ה", "transliteral": "śə-rê-p̄āh", "traducao_palavra": "[uma] queima" },
        { "hebraico": "גְּדֹולָ֥ה", "transliteral": "gə-ḏô-lāh", "traducao_palavra": "grande" },
