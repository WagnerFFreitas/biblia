    "9": {
      "traducao_completa": "Porque, quanto a YHWH, os seus olhos correm por toda a terra, para mostrar-se forte para com aqueles cujo coração é perfeito para com ele; nisso agiste loucamente; portanto, desde agora haverá guerras contra ti.",
      "palavras": [
        { "hebraico": "כִּ֣י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "יְהוָ֗ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "עֵינָ֞יו", "transliteral": "ʿê-nāyw", "traducao_palavra": "olhos dele" },
        { "hebraico": "מְשֹׁטְטֹ֤ות", "transliteral": "mə-šō-ṭə-ṭôṯ", "traducao_palavra": "[estão] percorrendo" },
        { "hebraico": "בְּכָל־הָאָ֙רֶץ֙", "transliteral": "bə-ḵāl-hā-ʾā-reṣ", "traducao_palavra": "em toda a terra" },
        { "hebraico": "לְהִתְחַזֵּק֮", "transliteral": "lə-hiṯ-ḥaz-zêq", "traducao_palavra": "para mostrar-se forte" },
        { "hebraico": "עִם־לְבָבָ֥ם", "transliteral": "ʿim-lə-ḇā-ḇām", "traducao_palavra": "com coração deles [que]" },
        { "hebraico": "שָׁלֵ֖ם", "transliteral": "šā-lêm", "traducao_palavra": "[é] perfeito" },
        { "hebraico": "אֵלָ֑יו", "transliteral": "ʾê-lāyw", "traducao_palavra": "para com ele" },
        { "hebraico": "נִסְכַּ֥לְתָּ", "transliteral": "nis-kal-tā", "traducao_palavra": "agiste loucamente" },
        { "hebraico": "עַל־זֹ֔את", "transliteral": "ʿal-zōṯ", "traducao_palavra": "nisto" },
        { "hebraico": "כִּ֣י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "מֵעַתָּה", "transliteral": "mê-ʿat-tā", "traducao_palavra": "desde agora" },
        { "hebraico": "יֵ֥שׁ", "transliteral": "yêš", "traducao_palavra": "haverá" },
        { "hebraico": "עִמְּךָ֖", "transliteral": "ʿim-mə-ḵā", "traducao_palavra": "contigo" },
        { "hebraico": "מִלְחָמֹֽות׃", "transliteral": "mil-ḥā-môṯ", "traducao_palavra": "guerras" }
      ]
    },
    "10": {
      "traducao_completa": "E Asa se indignou contra o vidente, e o lançou na casa do tronco; porque se enfurecera contra ele por causa disto; também Asa oprimiu alguns do povo naquele mesmo tempo.",
      "palavras": [
