        { "hebraico": "אָסָ֖א", "transliteral": "ʾā-śā", "traducao_palavra": "Asa" },
        { "hebraico": "עִם־אֲבֹתָ֑יו", "transliteral": "ʿim-ʾă-ḇō-ṯāyw", "traducao_palavra": "com seus pais" },
        { "hebraico": "וַיָּ֕מָת", "transliteral": "way-yā-māṯ", "traducao_palavra": "e morreu" },
        { "hebraico": "בִּשְׁנַ֛ת", "transliteral": "biš-naṯ", "traducao_palavra": "no ano" },
        { "hebraico": "אַרְבָּעִ֥ים", "transliteral": "ʾar-bā-ʿîm", "traducao_palavra": "quarenta" },
        { "hebraico": "וְאַחַ֖ת", "transliteral": "wə-ʾa-ḥaṯ", "traducao_palavra": "e um" },
