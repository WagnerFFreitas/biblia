        { "hebraico": "יָרָבְעָם֒", "transliteral": "yā-rā-ḇə-ʿām", "traducao_palavra": "Jeroboão" },
        { "hebraico": "וַיִּלְכֹּ֤ד", "transliteral": "way-yil-kōḏ", "traducao_palavra": "e tomou" },
