      "palavras": [
        { "hebraico": "וַיִּתְחַזֵּ֣ק", "transliteral": "way-yiṯ-ḥaz-zêq", "traducao_palavra": "e fortaleceu-se" },
        { "hebraico": "אֲבִיָּ֔הוּ", "transliteral": "ʾă-ḇî-yā-hū", "traducao_palavra": "Abias" },
        { "hebraico": "וַיִּשָּׂא־לֹו֮", "transliteral": "way-yiś-śā-lô", "traducao_palavra": "e tomou para si" },
        { "hebraico": "נָשִׁ֣ים", "transliteral": "nā-šîm", "traducao_palavra": "mulheres" },
        { "hebraico": "אַרְבַּ֣ע", "transliteral": "ʾar-baʿ", "traducao_palavra": "quatro" },
