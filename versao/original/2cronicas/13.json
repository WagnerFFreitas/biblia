        { "hebraico": "וַיַּאְמְצוּ֙", "transliteral": "way-ya-ʾəm-ṣū", "traducao_palavra": "e prevaleceram" },
        { "hebraico": "בְּנֵ֣י", "transliteral": "bə-nê", "traducao_palavra": "os filhos de" },
