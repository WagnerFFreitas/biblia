        { "hebraico": "וֶאֶת־יְשָׁנָ֖ה", "transliteral": "wə-ʾeṯ-yə-šā-nāh", "traducao_palavra": "e Jesana" },
        { "hebraico": "וְאֶת־בְּנֹתֶ֑יהָ", "transliteral": "wə-ʾeṯ-bə-nō-ṯe-yhā", "traducao_palavra": "e suas aldeias" },
