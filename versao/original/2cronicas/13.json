        { "hebraico": "הַנָּבִ֥יא", "transliteral": "han-nā-ḇî", "traducao_palavra": "o profeta" },
        { "hebraico": "עִדֹּֽו׃", "transliteral": "ʿid-dô", "traducao_palavra": "Ido" }
