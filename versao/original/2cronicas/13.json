        { "hebraico": "וּדְרָכָ֖יו", "transliteral": "ū-ḏə-rā-ḵāyw", "traducao_palavra": "e seus caminhos" },
        { "hebraico": "וּדְבָרָ֑יו", "transliteral": "ū-ḏə-ḇā-rāyw", "traducao_palavra": "e suas falas" },
        { "hebraico": "כְּתוּבִ֕ים", "transliteral": "kə-ṯū-ḇîm", "traducao_palavra": "escritos" },
