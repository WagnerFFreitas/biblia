        { "hebraico": "עַל־יְהוָ֖ה", "transliteral": "ʿal-YHWH", "traducao_palavra": "em YHWH" },
        { "hebraico": "אֱלֹהֵ֥י", "transliteral": "ʾĕ-lō-hê", "traducao_palavra": "Deus de" },
        { "hebraico": "אֲבֹותֵיהֶֽם׃", "transliteral": "ʾă-ḇô-ṯê-hem", "traducao_palavra": "vossos pais" }
      ]
