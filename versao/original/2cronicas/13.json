        { "hebraico": "וַיֹּ֗ולֶד", "transliteral": "way-yô-leḏ", "traducao_palavra": "e gerou" },
        { "hebraico": "עֶשְׂרִ֤ים", "transliteral": "ʿeś-rîm", "traducao_palavra": "vinte" },
        { "hebraico": "וּשְׁנַ֙יִם֙", "transliteral": "ū-šə-na-yim", "traducao_palavra": "e dois" },
        { "hebraico": "בָּנִ֔ים", "transliteral": "bā-nîm", "traducao_palavra": "filhos" },
        { "hebraico": "וְשֵׁ֥שׁ", "transliteral": "wə-šêš", "traducao_palavra": "e seis" },
        { "hebraico": "עֶשְׂרֵ֖ה", "transliteral": "ʿeś-rêh", "traducao_palavra": "dez [dezesseis]" },
