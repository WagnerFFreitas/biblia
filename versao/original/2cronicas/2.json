        { "hebraico": "הַחִטִּ֤ים", "transliteral": "ha-ḥiṭ-ṭîm", "traducao_palavra": "o trigo" },
        { "hebraico": "וְהַשְּׂעֹרִים֙", "transliteral": "wə-haś-śə-ʿō-rîm", "traducao_palavra": "e a cevada" },
