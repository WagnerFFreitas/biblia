        { "hebraico": "עֵצִ֤ים", "transliteral": "ʿê-ṣîm", "traducao_palavra": "madeiras" },
        { "hebraico": "מִן־הַלְּבָנֹון֙", "transliteral": "min-hal-lə-ḇā-nôn", "traducao_palavra": "do Líbano" },
        { "hebraico": "כְּכָל־צָרְכֶּ֔ךָ", "transliteral": "kə-ḵāl-ṣā-rə-ke-ḵā", "traducao_palavra": "conforme toda tua necessidade" },
        { "hebraico": "וּנְבִיאֵ֥ם", "transliteral": "ū-nə-ḇî-ʾêm", "traducao_palavra": "e as traremos" },
