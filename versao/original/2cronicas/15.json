        { "hebraico": "אֲשֶׁ֧ר", "transliteral": "ʾă-šer", "traducao_palavra": "que" },
        { "hebraico": "לֹֽא־יִדְרֹ֛שׁ", "transliteral": "lō-yiḏ-rōš", "traducao_palavra": "não buscasse" },
        { "hebraico": "לַיהוָ֥ה", "transliteral": "lay-YHWH", "traducao_palavra": "a YHWH" },
        { "hebraico": "אֱלֹהֵֽי־יִשְׂרָאֵ֖ל", "transliteral": "ʾĕ-lō-hê-yiś-rā-ʾêl", "traducao_palavra": "Deus de Israel" },
