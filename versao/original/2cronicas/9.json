        { "hebraico": "מַלְכֵ֣י", "transliteral": "mal-ḵê", "traducao_palavra": "[os] reis de" },
        { "hebraico": "הָאָ֔רֶץ", "transliteral": "hā-ʾā-reṣ", "traducao_palavra": "a terra" },
        { "hebraico": "מְבַקְשִׁ֖ים", "transliteral": "mə-ḇaq-šîm", "traducao_palavra": "buscavam" },
        { "hebraico": "אֶת־פְּנֵ֣י", "transliteral": "ʾeṯ-pə-nê", "traducao_palavra": "a face de" },
        { "hebraico": "שְׁלֹמֹ֑ה", "transliteral": "šə-lō-mōh", "traducao_palavra": "Salomão" },
        { "hebraico": "לִשְׁמֹ֨עַ֙", "transliteral": "liš-mō-aʿ", "traducao_palavra": "para ouvir" },
