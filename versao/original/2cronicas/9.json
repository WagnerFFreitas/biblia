        { "hebraico": "אֲשֶׁר־נָתַ֥ן", "transliteral": "ʾă-šer-nā-ṯan", "traducao_palavra": "que deu" },
        { "hebraico": "הָאֱלֹהִ֖ים", "transliteral": "hā-ʾĕ-lō-hîm", "traducao_palavra": "Deus" },
        { "hebraico": "בְּלִבֹּֽו׃", "transliteral": "bə-lib-bô", "traducao_palavra": "no seu coração" }
