      ]
    },
    "25": {
      "traducao_completa": "Teve também Salomão quatro mil estrebaria para cavalos e carros, e doze mil cavaleiros; e os pôs nas cidades dos carros, e junto ao rei, em Jerusalém.",
      "palavras": [
        { "hebraico": "וַיְהִ֣י", "transliteral": "way-hî", "traducao_palavra": "e houve" },
        { "hebraico": "לִשְׁלֹמֹה֩", "transliteral": "liš-lō-mōh", "traducao_palavra": "para Salomão" },
        { "hebraico": "אַרְבַּ֨עַת", "transliteral": "ʾar-ba-ʿaṯ", "traducao_palavra": "quatro" },
        { "hebraico": "אֲלָפִ֜ים", "transliteral": "ʾă-lā-p̄îm", "traducao_palavra": "milhares" },
        { "hebraico": "אֻֽרְיֹ֤ות", "transliteral": "ʾūr-yôṯ", "traducao_palavra": "estrebaria/estábulos" },
        { "hebraico": "סוּסִים֙", "transliteral": "śū-śîm", "traducao_palavra": "[para] cavalos" },
        { "hebraico": "וּמַרְכָּבֹ֔ות", "transliteral": "ū-mar-kā-ḇôṯ", "traducao_palavra": "e carros" },
        { "hebraico": "וּשְׁנֵים־עָשָׂ֥ר", "transliteral": "ū-šə-nêm-ʿā-śār", "traducao_palavra": "e doze" },
        { "hebraico": "אֶ֖לֶף", "transliteral": "ʾe-lep̄", "traducao_palavra": "mil" },
        { "hebraico": "פָּרָשִׁ֑ים", "transliteral": "pā-rā-šîm", "traducao_palavra": "cavaleiros" },
        { "hebraico": "וַיַּנִּיחֵם֙", "transliteral": "way-yan-nî-ḥêm", "traducao_palavra": "e os colocou" },
        { "hebraico": "בְּעָרֵ֣י", "transliteral": "bə-ʿā-rê", "traducao_palavra": "nas cidades de" },
        { "hebraico": "הָרֶ֔כֶב", "transliteral": "hā-re-ḵeḇ", "traducao_palavra": "os carros" },
        { "hebraico": "וְעִם־הַמֶּ֖לֶךְ", "transliteral": "wə-ʿim-ham-me-leḵ", "traducao_palavra": "e com o rei" },
        { "hebraico": "בִּירוּשָׁלִָֽם׃", "transliteral": "bî-rū-šā-lā-im", "traducao_palavra": "em Jerusalém" }
      ]
    },
    "26": {
      "traducao_completa": "E dominava sobre todos os reis, desde o rio até à terra dos filisteus, e até ao termo do Egito.",
      "palavras": [
        { "hebraico": "וַיְהִ֥י", "transliteral": "way-hî", "traducao_palavra": "e foi" },
        { "hebraico": "מֹושֵׁ֖ל", "transliteral": "mô-šêl", "traducao_palavra": "dominador/governador" },
        { "hebraico": "בְּכָל־הַמְּלָכִ֑ים", "transliteral": "bə-ḵāl-ham-mə-lā-ḵîm", "traducao_palavra": "em todos os reis" },
        { "hebraico": "מִן־הַנָּהָר֙", "transliteral": "min-han-nā-hār", "traducao_palavra": "desde o Rio [Eufrates]" },
        { "hebraico": "וְעַד־אֶ֣רֶץ", "transliteral": "wə-ʿaḏ-ʾe-reṣ", "traducao_palavra": "e até terra de" },
