    },
    "24": {
      "traducao_completa": "E traziam cada um o seu presente, vasos de prata, vasos de ouro, vestes, armas, especiarias, cavalos e mulos; isso de ano em ano.",
      "palavras": [
        { "hebraico": "וְהֵ֜מָּה", "transliteral": "wə-hêm-mā", "traducao_palavra": "e eles" },
