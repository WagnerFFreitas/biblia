      ]
    },
    "27": {
      "traducao_completa": "E o rei fez que a prata em Jerusalém fosse como as pedras; e os cedros fez como os sicômoros que há nas planícies em abundância.",
      "palavras": [
        { "hebraico": "וַיִּתֵּ֨ן", "transliteral": "way-yit-tên", "traducao_palavra": "e deu/fez" },
        { "hebraico": "הַמֶּ֧לֶךְ", "transliteral": "ham-me-leḵ", "traducao_palavra": "o rei" },
        { "hebraico": "אֶת־הַכֶּ֛סֶף", "transliteral": "ʾeṯ-hak-ke-sep̄", "traducao_palavra": "a prata" },
        { "hebraico": "בִּירוּשָׁלִַ֖ם", "transliteral": "bî-rū-šā-la-im", "traducao_palavra": "em Jerusalém" },
        { "hebraico": "כָּאֲבָנִ֑ים", "transliteral": "kā-ʾă-ḇā-nîm", "traducao_palavra": "como pedras" },
        { "hebraico": "וְאֶת־הָאֲרָזִים֮", "transliteral": "wə-ʾeṯ-hā-ʾă-rā-zîm", "traducao_palavra": "e os cedros" },
