        { "hebraico": "וַיִּגְדַּל֙", "transliteral": "way-yiḡ-dal", "traducao_palavra": "e tornou-se maior" },
        { "hebraico": "הַמֶּ֣לֶךְ", "transliteral": "ham-me-leḵ", "traducao_palavra": "o rei" },
        { "hebraico": "שְׁלֹמֹ֔ה", "transliteral": "šə-lō-mōh", "traducao_palavra": "Salomão" },
        { "hebraico": "מִכֹּ֖ל", "transliteral": "mik-kōl", "traducao_palavra": "que todos" },
