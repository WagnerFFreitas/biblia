        { "hebraico": "תַּרְשִׁ֗ישׁ", "transliteral": "tar-šîš", "traducao_palavra": "Társis" },
        { "hebraico": "נֹשְׂאֹות֙", "transliteral": "nō-śə-ʾôṯ", "traducao_palavra": "trazendo/carregando" },
