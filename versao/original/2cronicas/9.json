        { "hebraico": "אִ֣ישׁ", "transliteral": "ʾîš", "traducao_palavra": "cada homem" },
        { "hebraico": "מִנְחָתֹ֗ו", "transliteral": "min-ḥā-ṯô", "traducao_palavra": "seu presente" },
        { "hebraico": "כְּלֵ֣י", "transliteral": "kə-lê", "traducao_palavra": "vasos de" },
        { "hebraico": "כֶ֡סֶף", "transliteral": "ḵe-sep̄", "traducao_palavra": "prata" },
        { "hebraico": "וּכְלֵ֣י", "transliteral": "ū-ḵə-lê", "traducao_palavra": "e vasos de" },
        { "hebraico": "זָהָב֩", "transliteral": "zā-hāḇ", "traducao_palavra": "ouro" },
        { "hebraico": "וּשְׂלָמֹ֨ות", "transliteral": "ū-śə-lā-môṯ", "traducao_palavra": "e vestes" },
        { "hebraico": "נֵ֜שֶׁק", "transliteral": "nê-šeq", "traducao_palavra": "armas" },
        { "hebraico": "וּבְשָׂמִ֗ים", "transliteral": "ū-ḇə-śā-mîm", "traducao_palavra": "e especiarias" },
        { "hebraico": "סוּסִים֙", "transliteral": "śū-śîm", "traducao_palavra": "cavalos" },
        { "hebraico": "וּפְרָדִ֔ים", "transliteral": "ū-p̄ə-rā-ḏîm", "traducao_palavra": "e mulos" },
        { "hebraico": "דְּבַר־שָׁנָ֖ה", "transliteral": "də-ḇar-šā-nāh", "traducao_palavra": "assunto de ano" },
