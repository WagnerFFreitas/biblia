        { "hebraico": "וַיִּתֵּ֖ן", "transliteral": "way-yit-tên", "traducao_palavra": "e pôs" },
        { "hebraico": "עַל־רֹ֣אשׁ", "transliteral": "ʿal-rōš", "traducao_palavra": "sobre [a] cabeça de" },
        { "hebraico": "הָעַמּוּדִ֑ים", "transliteral": "hā-ʿam-mū-ḏîm", "traducao_palavra": "as colunas" },
        { "hebraico": "וַיַּ֙עַשׂ֙", "transliteral": "way-ya-ʿaś", "traducao_palavra": "e fez" },
        { "hebraico": "רִמֹּונִ֣ים", "transliteral": "rim-mô-nîm", "traducao_palavra": "romãs" },
        { "hebraico": "מֵאָ֔ה", "transliteral": "mê-ʾāh", "traducao_palavra": "cem" },
        { "hebraico": "וַיִּתֵּ֖ן", "transliteral": "way-yit-tên", "traducao_palavra": "e as pôs" },
        { "hebraico": "בַּֽשַּׁרְשְׁרֹֽות׃", "transliteral": "baš-šar-šə-rôṯ", "traducao_palavra": "nas cadeias" }
