        { "hebraico": "מֵהַשְּׂמֹ֑אול", "transliteral": "mê-haś-śə-mōl", "traducao_palavra": "da esquerda" },
        { "hebraico": "וַיִּקְרָ֤א", "transliteral": "way-yiq-rā", "traducao_palavra": "e chamou" },
        { "hebraico": "שֵׁם־הַיְמָנִית֙", "transliteral": "šêm-hay-mā-nîṯ", "traducao_palavra": "nome da direita" },
        { "hebraico": "יָכִ֔ין", "transliteral": "yā-ḵîn", "traducao_palavra": "Jachin" },
