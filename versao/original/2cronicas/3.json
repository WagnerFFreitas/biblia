    "5": {
      "traducao_completa": "E a casa grande forrou com madeira de cipreste, a qual sobrepôs com ouro bom, e fez nela palmas e cadeias.",
      "palavras": [
        { "hebraico": "וְאֵת֩", "transliteral": "wə-ʾêṯ", "traducao_palavra": "e [objeto]" },
