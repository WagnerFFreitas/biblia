        { "hebraico": "עָלָ֖יו", "transliteral": "ʿā-lāyw", "traducao_palavra": "sobre ele" },
        { "hebraico": "כְּרוּבִֽים׃", "transliteral": "kə-rū-ḇîm", "traducao_palavra": "querubins" }
      ]
    },
    "15": {
      "traducao_completa": "Fez também diante da casa duas colunas de trinta e cinco côvados de altura; e o capitel que estava sobre a cabeça de cada uma era de cinco côvados.",
      "palavras": [
        { "hebraico": "וַיַּ֣עַשׂ", "transliteral": "way-ya-ʿaś", "traducao_palavra": "e fez" },
