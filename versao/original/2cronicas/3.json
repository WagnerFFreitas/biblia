        { "hebraico": "הַבַּ֗יִת", "transliteral": "hab-ba-yiṯ", "traducao_palavra": "a casa" },
        { "hebraico": "עַמּוּדִ֤ים", "transliteral": "ʿam-mū-ḏîm", "traducao_palavra": "colunas" },
        { "hebraico": "שְׁנַ֙יִם֙", "transliteral": "šə-na-yim", "traducao_palavra": "duas" },
        { "hebraico": "אַמֹּ֣ות", "transliteral": "ʾam-môṯ", "traducao_palavra": "côvados" },
        { "hebraico": "שְׁלֹשִׁ֣ים", "transliteral": "šə-lō-šîm", "traducao_palavra": "trinta" },
        { "hebraico": "וְחָמֵ֔שׁ", "transliteral": "wə-ḥā-mêš", "traducao_palavra": "e cinco" },
        { "hebraico": "אֹ֑רֶךְ", "transliteral": "ʾō-reḵ", "traducao_palavra": "comprimento/altura" },
        { "hebraico": "וְהַצֶּ֙פֶת֙", "transliteral": "wə-haṣ-ṣe-p̄eṯ", "traducao_palavra": "e o capitel" },
        { "hebraico": "אֲשֶׁר־עַל־רֹאשֹׁ֖ו", "transliteral": "ʾă-šer-ʿal-rō-šô", "traducao_palavra": "que sobre sua cabeça" },
        { "hebraico": "אַמֹּ֥ות", "transliteral": "ʾam-môṯ", "traducao_palavra": "côvados" },
