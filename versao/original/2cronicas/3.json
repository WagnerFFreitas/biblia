    "13": {
      "traducao_completa": "As asas destes querubins se estendiam por vinte côvados; e eles estavam em pé sobre os seus pés, e os seus rostos virados para o interior.",
      "palavras": [
        { "hebraico": "כַּנְפֵי֙", "transliteral": "kan-p̄ê", "traducao_palavra": "[as] asas de" },
        { "hebraico": "הַכְּרוּבִ֣ים", "transliteral": "hak-kə-rū-ḇîm", "traducao_palavra": "os querubins" },
        { "hebraico": "הָאֵ֔לֶּה", "transliteral": "hā-ʾêl-leh", "traducao_palavra": "estes" },
        { "hebraico": "פֹּרְשִׂ֖ים", "transliteral": "pō-rə-śîm", "traducao_palavra": "[se] estendiam" },
        { "hebraico": "אַמֹּ֣ות", "transliteral": "ʾam-môṯ", "traducao_palavra": "côvados" },
        { "hebraico": "עֶשְׂרִ֑ים", "transliteral": "ʿeś-rîm", "traducao_palavra": "vinte" },
        { "hebraico": "וְהֵ֛ם", "transliteral": "wə-hêm", "traducao_palavra": "e eles" },
        { "hebraico": "עֹמְדִ֥ים", "transliteral": "ʿō-mə-ḏîm", "traducao_palavra": "[estavam] em pé" },
        { "hebraico": "עַל־רַגְלֵיהֶ֖ם", "transliteral": "ʿal-raḡ-lê-hem", "traducao_palavra": "sobre seus pés" },
        { "hebraico": "וּפְנֵיהֶ֥ם", "transliteral": "ū-p̄ə-nê-hem", "traducao_palavra": "e seus rostos" },
        { "hebraico": "לַבָּֽיִת׃", "transliteral": "lab-bā-yiṯ", "traducao_palavra": "para a casa [interior]" }
      ]
    },
    "14": {
      "traducao_completa": "Também fez o véu de azul, e de púrpura, e de carmesim, e de linho fino; e fez nele querubins.",
      "palavras": [
        { "hebraico": "וַיַּ֙עַשׂ֙", "transliteral": "way-ya-ʿaś", "traducao_palavra": "e fez" },
        { "hebraico": "אֶת־הַפָּרֹ֔כֶת", "transliteral": "ʾeṯ-hap-pā-rō-ḵeṯ", "traducao_palavra": "o véu" },
        { "hebraico": "תְּכֵ֥לֶת", "transliteral": "tə-ḵē-leṯ", "traducao_palavra": "[de] azul" },
        { "hebraico": "וְאַרְגָּוָ֖ן", "transliteral": "wə-ʾar-gā-wān", "traducao_palavra": "e púrpura" },
        { "hebraico": "וְכַרְמִ֣יל", "transliteral": "wə-ḵar-mîl", "traducao_palavra": "e carmesim" },
        { "hebraico": "וּב֑וּץ", "transliteral": "ū-ḇūṣ", "traducao_palavra": "e linho fino" },
