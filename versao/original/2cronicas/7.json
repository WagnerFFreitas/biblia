        { "hebraico": "וְיָשֻׁ֖בוּ", "transliteral": "wə-yā-šu-ḇû", "traducao_palavra": "e se converterem" },
        { "hebraico": "מִדַּרְכֵיהֶ֣ם", "transliteral": "mid-dar-ḵê-hem", "traducao_palavra": "de seus caminhos" },
        { "hebraico": "הָרָעִ֑ים", "transliteral": "hā-rā-ʿîm", "traducao_palavra": "os maus" },
