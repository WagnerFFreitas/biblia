    "16": {
      "traducao_completa": "Porque agora escolhi e santifiquei esta casa, para que o meu nome esteja nela para sempre; e nela estarão fixos os meus olhos e o meu coração todos os dias.",
      "palavras": [
        { "hebraico": "וְעַתָּה֙", "transliteral": "wə-ʿat-tāh", "traducao_palavra": "e agora" },
        { "hebraico": "בָּחַ֣רְתִּי", "transliteral": "bā-ḥar-tî", "traducao_palavra": "escolhi" },
        { "hebraico": "וְקִדַּ֙שְׁתִּי֙", "transliteral": "wə-qid-daš-tî", "traducao_palavra": "e santifiquei" },
