        { "hebraico": "וְהָי֨וּ", "transliteral": "wə-hā-yû", "traducao_palavra": "e estarão" },
        { "hebraico": "עֵינַ֧י", "transliteral": "ʿê-nay", "traducao_palavra": "meus olhos" },
        { "hebraico": "וְלִבִּ֛י", "transliteral": "wə-lib-bî", "traducao_palavra": "e meu coração" },
        { "hebraico": "שָׁ֖ם", "transliteral": "šām", "traducao_palavra": "ali" },
        { "hebraico": "כָּל־הַיָּמִֽים׃", "transliteral": "kāl-hay-yā-mîm", "traducao_palavra": "todos os dias" }
      ]
    },
    "17": {
      "traducao_completa": "E, quanto a ti, se andares diante de mim, como andou Davi teu pai, e fizeres conforme tudo o que te ordenei, e guardares os meus estatutos e os meus juízos,",
