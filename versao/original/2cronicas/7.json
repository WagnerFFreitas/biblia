        { "hebraico": "לְפָנַי֮", "transliteral": "lə-p̄ā-nay", "traducao_palavra": "diante de mim" },
        { "hebraico": "כַּאֲשֶׁ֣ר", "transliteral": "ka-ʾă-šer", "traducao_palavra": "conforme" },
