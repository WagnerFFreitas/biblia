        { "hebraico": "אַתֶּ֔ם", "transliteral": "ʾat-tem", "traducao_palavra": "vós" },
        { "hebraico": "וַעֲזַבְתֶּם֙", "transliteral": "wa-ʿă-zaḇ-tem", "traducao_palavra": "e deixardes" },
