        { "hebraico": "לֵאמֹ֑ר", "transliteral": "lê-mōr", "traducao_palavra": "dizendo" },
        { "hebraico": "לֹא־יִכָּרֵ֤ת", "transliteral": "lō-yik-kā-rêṯ", "traducao_palavra": "não será cortado" },
        { "hebraico": "לְךָ֙", "transliteral": "lə-ḵā", "traducao_palavra": "para ti" },
