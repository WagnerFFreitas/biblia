        { "hebraico": "וְלַעֲשֹׂ֕ות", "transliteral": "wə-la-ʿă-śôṯ", "traducao_palavra": "e fizeres" },
        { "hebraico": "כְּכֹ֥ל", "transliteral": "kə-ḵōl", "traducao_palavra": "conforme tudo" },
        { "hebraico": "אֲשֶׁ֣ר", "transliteral": "ʾă-šer", "traducao_palavra": "que" },
        { "hebraico": "צִוִּיתִ֑יךָ", "transliteral": "ṣiw-wî-ṯî-ḵā", "traducao_palavra": "te ordenei" },
