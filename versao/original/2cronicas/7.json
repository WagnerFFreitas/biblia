        { "hebraico": "אַשְׁלִ֖יךְ", "transliteral": "ʾaš-lîḵ", "traducao_palavra": "lançarei" },
        { "hebraico": "מֵעַ֣ל", "transliteral": "mê-ʿal", "traducao_palavra": "de sobre" },
