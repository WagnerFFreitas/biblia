        { "hebraico": "לָהֶֽם׃", "transliteral": "lā-hem", "traducao_palavra": "a eles" }
      ]
    },
    "20": {
      "traducao_completa": "Então os arrancarei da minha terra que lhes dei, e esta casa, que santifiquei ao meu nome, lançarei longe da minha presença, e a farei por provérbio e mote entre todos os povos.",
      "palavras": [
