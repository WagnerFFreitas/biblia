      ]
    },
    "19": {
      "traducao_completa": "Mas se vós vos desviardes, e deixardes os meus estatutos e os meus mandamentos, que vos tenho proposto, e fordes, e servirdes a outros deuses, e vos prostrardes a eles,",
      "palavras": [
