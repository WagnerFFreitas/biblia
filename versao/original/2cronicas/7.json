      "palavras": [
        { "hebraico": "וְיִכָּנְע֣וּ", "transliteral": "wə-yin-nā-ḵə-ʿû", "traducao_palavra": "e se humilharem" },
        { "hebraico": "עַמִּ֗י", "transliteral": "ʿam-mî", "traducao_palavra": "meu povo" },
        { "hebraico": "אֲשֶׁ֧ר", "transliteral": "ʾă-šer", "traducao_palavra": "que" },
        { "hebraico": "נִקְרָֽא־שְׁמִ֣י", "transliteral": "niq-rā-šə-mî", "traducao_palavra": "é chamado meu nome" },
