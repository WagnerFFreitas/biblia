    "13": {
      "traducao_completa": "E isto segundo o dever de cada dia, oferecendo conforme o preceito de Moisés, nos sábados, e nas luas novas, e nas festas solenes, três vezes no ano: na festa dos pães ázimos, e na festa das semanas, e na festa dos tabernáculos.",
      "palavras": [
        { "hebraico": "וּבִדְבַר־יֹ֣ום", "transliteral": "ū-ḇiḏ-ḇar-yôm", "traducao_palavra": "e conforme o dever de dia" },
