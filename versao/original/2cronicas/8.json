        { "hebraico": "שָׁלֹ֣שׁ", "transliteral": "šā-lōš", "traducao_palavra": "três" },
        { "hebraico": "פְּעָמִ֣ים", "transliteral": "pə-ʿā-mîm", "traducao_palavra": "vezes" },
        { "hebraico": "בַּשָּׁנָ֑ה", "transliteral": "ba-šā-nāh", "traducao_palavra": "no ano" },
