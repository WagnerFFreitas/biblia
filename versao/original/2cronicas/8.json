        { "hebraico": "מֹשֶׁ֔ה", "transliteral": "mō-šeh", "traducao_palavra": "Moisés" },
        { "hebraico": "לַשַּׁבָּתֹות֙", "transliteral": "laš-šab-bā-ṯôṯ", "traducao_palavra": "nos sábados" },
