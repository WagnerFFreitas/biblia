        { "hebraico": "לְהַלֵּ֤ל", "transliteral": "lə-hal-lêl", "traducao_palavra": "para louvar" },
        { "hebraico": "וּלְשָׁרֵת֙", "transliteral": "ū-lə-šā-rêṯ", "traducao_palavra": "e para ministrar" },
