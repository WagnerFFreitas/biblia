        { "hebraico": "עָלָה֩", "transliteral": "ʿā-lāh", "traducao_palavra": "subiu" },
        { "hebraico": "נְכֹ֨ו", "transliteral": "nə-ḵô", "traducao_palavra": "Neco" },
        { "hebraico": "מֶֽלֶךְ־מִצְרַ֜יִם", "transliteral": "me-leḵ-miṣ-ra-yim", "traducao_palavra": "rei do Egito" },
        { "hebraico": "לְהִלָּחֵ֧ם", "transliteral": "lə-hil-lā-ḥêm", "traducao_palavra": "para lutar" },
        { "hebraico": "בְּכַרְכְּמִ֛ישׁ", "transliteral": "bə-ḵar-kə-mîš", "traducao_palavra": "em Carquemis" },
        { "hebraico": "עַל־פְּרָ֑ת", "transliteral": "ʿal-pə-rāṯ", "traducao_palavra": "junto ao Eufrates" },
