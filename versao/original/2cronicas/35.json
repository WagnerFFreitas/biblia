        { "hebraico": "וַיֹּולִיכֻ֣הוּ", "transliteral": "way-yô-lî-ḵu-hū", "traducao_palavra": "e levaram-no" },
        { "hebraico": "יְרוּשָׁלִַם֮", "transliteral": "yə-rū-šā-la-im", "traducao_palavra": "[a] Jerusalém" },
        { "hebraico": "וַיָּמֹת֒", "transliteral": "way-yā-māṯ", "traducao_palavra": "e morreu" },
        { "hebraico": "וַיִּקָּבֵר֙", "transliteral": "way-yiq-qā-ḇêr", "traducao_palavra": "e foi sepultado" },
