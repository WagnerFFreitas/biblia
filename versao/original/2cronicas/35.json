        { "hebraico": "הָחֳלֵ֖יתִי", "transliteral": "ho-ḥo-lê-ṯî", "traducao_palavra": "estou ferido/doente" },
        { "hebraico": "מְאֹֽד׃", "transliteral": "mə-ʾōḏ", "traducao_palavra": "muito" }
      ]
    },
    "24": {
      "traducao_completa": "E seus servos o tiraram do carro, e o levaram no segundo carro que tinha, e o trouxeram a Jerusalém, e morreu, e o sepultaram nos sepulcros de seus pais; e todo o Judá e Jerusalém choraram a Josias.",
      "palavras": [
        { "hebraico": "וַיַּעֲבִירֻ֨הוּ", "transliteral": "way-ya-ʿă-ḇî-ru-hū", "traducao_palavra": "e removeram-no" },
        { "hebraico": "עֲבָדָ֜יו", "transliteral": "ʿă-ḇā-ḏāyw", "traducao_palavra": "seus servos" },
        { "hebraico": "מִן־הַמֶּרְכָּבָ֗ה", "transliteral": "min-ham-mer-kā-ḇāh", "traducao_palavra": "do carro" },
        { "hebraico": "וַֽיַּרְכִּיבֻהוּ֮", "transliteral": "way-yar-kî-ḇu-hū", "traducao_palavra": "e fizeram-no montar" },
