    "25": {
      "traducao_completa": "E Jeremias fez uma lamentação sobre Josias; e todos os cantores e cantoras falam de Josias nas suas lamentações, até ao dia de hoje; e as deram por estatuto em Israel; e eis que estão escritas nas lamentações.",
      "palavras": [
        { "hebraico": "וַיְקֹונֵ֣ן", "transliteral": "way-qô-nên", "traducao_palavra": "e lamentou" },
        { "hebraico": "יִרְמְיָהוּ֮", "transliteral": "yir-mə-yā-hū", "traducao_palavra": "Jeremias" },
        { "hebraico": "עַל־יֹאשִׁיָּהוּ֒", "transliteral": "ʿal-yô-šiy-yā-hū", "traducao_palavra": "sobre Josias" },
        { "hebraico": "וַיֹּאמְר֣וּ", "transliteral": "way-yō-mər-ū", "traducao_palavra": "e disseram/falam" },
        { "hebraico": "כָל־הַשָּׁרִ֣ים׀", "transliteral": "ḵāl-haš-šā-rîm", "traducao_palavra": "todos os cantores" },
        { "hebraico": "וְהַשָּׁרֹות֩", "transliteral": "wə-haš-šā-rôṯ", "traducao_palavra": "e as cantoras" },
        { "hebraico": "בְּקִינֹותֵיהֶ֨ם", "transliteral": "bə-qî-nô-ṯê-hem", "traducao_palavra": "em suas lamentações" },
        { "hebraico": "עַל־יֹאשִׁיָּ֜הוּ", "transliteral": "ʿal-yô-šiy-yā-hū", "traducao_palavra": "sobre Josias" },
        { "hebraico": "עַד־הַיֹּ֗ום", "transliteral": "ʿaḏ-hay-yôm", "traducao_palavra": "até hoje" },
        { "hebraico": "וַיִּתְּנ֥וּם", "transliteral": "way-yit-tə-nūm", "traducao_palavra": "e as deram" },
        { "hebraico": "לְחֹק֙", "transliteral": "lə-ḥōq", "traducao_palavra": "por estatuto" },
        { "hebraico": "עַל־יִשְׂרָאֵ֔ל", "transliteral": "ʿal-yiś-rā-ʾēl", "traducao_palavra": "em Israel" },
        { "hebraico": "וְהִנָּ֥ם", "transliteral": "wə-hin-nām", "traducao_palavra": "e eis que elas" },
        { "hebraico": "כְתוּבִ֖ים", "transliteral": "ḵə-ṯū-ḇîm", "traducao_palavra": "[estão] escritas" },
