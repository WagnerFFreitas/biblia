        { "hebraico": "וִירוּשָׁלִַ֔ם", "transliteral": "wî-rū-šā-lā-im", "traducao_palavra": "e Jerusalém" },
        { "hebraico": "מִתְאַבְּלִ֖ים", "transliteral": "miṯ-ʾab-bə-lîm", "traducao_palavra": "lamentaram/prantearam" },
        { "hebraico": "עַל־יֹאשִׁיָּֽהוּ׃", "transliteral": "ʿal-yô-šiy-yā-hū", "traducao_palavra": "por Josias" }
