        { "hebraico": "יֹאשִׁיָּ֨הוּ֙", "transliteral": "yô-šiy-yā-hū", "traducao_palavra": "Josias" },
        { "hebraico": "וְהַכֹּהֲנִ֣ים", "transliteral": "wə-hak-kō-hă-nîm", "traducao_palavra": "e os sacerdotes" },
        { "hebraico": "וְהַלְוִיִּ֣ם", "transliteral": "wə-hal-wiy-yim", "traducao_palavra": "e os levitas" },
