        { "hebraico": "יֹאשִׁיָּ֜הוּ", "transliteral": "yô-šiy-yā-hū", "traducao_palavra": "Josias" },
        { "hebraico": "פָנָ֣יו", "transliteral": "p̄ā-nāyw", "traducao_palavra": "sua face" },
        { "hebraico": "מִמֶּ֗נּוּ", "transliteral": "mim-men-nū", "traducao_palavra": "dele" },
        { "hebraico": "כִּ֤י", "transliteral": "kî", "traducao_palavra": "pois" },
        { "hebraico": "לְהִלָּחֵֽם־בֹּו֙", "transliteral": "lə-hil-lā-ḥêm-bô", "traducao_palavra": "para lutar com ele" },
        { "hebraico": "הִתְחַפֵּ֔שׂ", "transliteral": "hiṯ-ḥap-pêś", "traducao_palavra": "disfarçou-se" },
        { "hebraico": "וְלֹ֥א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "שָׁמַ֛ע", "transliteral": "šā-maʿ", "traducao_palavra": "ouviu" },
        { "hebraico": "אֶל־דִּבְרֵ֥י", "transliteral": "ʾel-diḇ-rê", "traducao_palavra": "as palavras de" },
        { "hebraico": "נְכֹ֖ו", "transliteral": "nə-ḵô", "traducao_palavra": "Neco" },
        { "hebraico": "מִפִּ֣י", "transliteral": "mip-pî", "traducao_palavra": "da boca de" },
        { "hebraico": "אֱלֹהִ֑ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "Deus" },
