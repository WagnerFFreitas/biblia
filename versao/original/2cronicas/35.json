      ]
    },
    "21": {
      "traducao_completa": "Mas Neco lhe enviou mensageiros, dizendo: Que tenho eu contigo, rei de Judá? Não venho hoje contra ti, mas contra a casa que me faz guerra; e Deus disse que me apressasse; guarda-te de te opores a Deus, que é comigo, para que ele não te destrua.",
      "palavras": [
        { "hebraico": "וַיִּשְׁלַ֣ח", "transliteral": "way-yiš-laḥ", "traducao_palavra": "e enviou" },
        { "hebraico": "אֵלָ֣יו", "transliteral": "ʾê-lāyw", "traducao_palavra": "a ele" },
        { "hebraico": "מַלְאָכִ֣ים׀", "transliteral": "mal-ʾā-ḵîm", "traducao_palavra": "mensageiros" },
        { "hebraico": "לֵאמֹ֡ר", "transliteral": "lê-mōr", "traducao_palavra": "dizendo" },
        { "hebraico": "מַה־לִּ֨י", "transliteral": "mah-lî", "traducao_palavra": "o que a mim" },
        { "hebraico": "וָלָ֜ךְ", "transliteral": "wā-lāḵ", "traducao_palavra": "e a ti?" },
        { "hebraico": "מֶ֣לֶךְ יְהוּדָ֗ה", "transliteral": "me-leḵ yə-hū-ḏāh", "traducao_palavra": "rei de Judá" },
        { "hebraico": "לֹא־עָלֶ֨יךָ", "transliteral": "lō-ʿā-le-yḵā", "traducao_palavra": "não contra ti" },
        { "hebraico": "אַתָּ֤ה", "transliteral": "ʾat-tāh", "traducao_palavra": "tu" },
        { "hebraico": "הַיֹּום֙", "transliteral": "hay-yôm", "traducao_palavra": "hoje" },
        { "hebraico": "כִּ֚י", "transliteral": "kî", "traducao_palavra": "mas" },
        { "hebraico": "אֶל־בֵּ֣ית", "transliteral": "ʾel-bêṯ", "traducao_palavra": "contra a casa" },
        { "hebraico": "מִלְחַמְתִּ֔י", "transliteral": "mil-ḥam-tî", "traducao_palavra": "[de] minha guerra" },
        { "hebraico": "וֵֽאלֹהִ֖ים", "transliteral": "wê-lō-hîm", "traducao_palavra": "e Deus" },
        { "hebraico": "אָמַ֣ר", "transliteral": "ʾā-mar", "traducao_palavra": "disse" },
        { "hebraico": "לְבַהֲלֵ֑נִי", "transliteral": "lə-ḇa-hă-lê-nî", "traducao_palavra": "para me apressar" },
        { "hebraico": "חֲדַל־לְךָ֙", "transliteral": "ḥă-ḏal-lə-ḵā", "traducao_palavra": "cessa para ti/deixa de" },
        { "hebraico": "מֵאֱלֹהִ֣ים", "transliteral": "mê-ʾĕ-lō-hîm", "traducao_palavra": "[opor-se] a Deus" },
        { "hebraico": "אֲשֶׁר־עִמִּ֔י", "transliteral": "ʾă-šer-ʿim-mî", "traducao_palavra": "que [está] comigo" },
        { "hebraico": "וְאַל־יַשְׁחִיתֶֽךָ׃", "transliteral": "wə-ʾal-yaš-ḥî-ṯe-ḵā", "traducao_palavra": "para que não destrua a ti" }
      ]
