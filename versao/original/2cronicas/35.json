        { "hebraico": "כָל־זֹאת֮", "transliteral": "ḵāl-zōṯ", "traducao_palavra": "tudo isto" },
        { "hebraico": "אֲשֶׁ֣ר", "transliteral": "ʾă-šer", "traducao_palavra": "que" },
        { "hebraico": "הֵכִ֣ין", "transliteral": "hê-ḵîn", "traducao_palavra": "preparara/estabelecera" },
        { "hebraico": "יֹאשִׁיָּּהוּ֮", "transliteral": "yô-šiy-yā-hū", "traducao_palavra": "Josias" },
