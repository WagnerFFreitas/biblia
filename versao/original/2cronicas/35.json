        { "hebraico": "לַמֶּ֖לֶךְ", "transliteral": "lam-me-leḵ", "traducao_palavra": "no rei" },
        { "hebraico": "יֹאשִׁיָּ֑הוּ", "transliteral": "yô-šiy-yā-hū", "traducao_palavra": "Josias" },
        { "hebraico": "וַיֹּ֨אמֶר", "transliteral": "way-yō-mer", "traducao_palavra": "e disse" },
        { "hebraico": "הַמֶּ֤לֶךְ", "transliteral": "ham-me-leḵ", "traducao_palavra": "o rei" },
        { "hebraico": "לַעֲבָדָיו֙", "transliteral": "la-ʿă-ḇā-ḏāyw", "traducao_palavra": "a seus servos" },
        { "hebraico": "הַעֲבִיר֔וּנִי", "transliteral": "ha-ʿă-ḇî-rū-nî", "traducao_palavra": "tirai-me/removei-me" },
