        { "hebraico": "וְלֵ֣ב", "transliteral": "wə-lêḇ", "traducao_palavra": "e o coração de" },
        { "hebraico": "הַשָּׂרִ֑ים", "transliteral": "haś-śā-rîm", "traducao_palavra": "os príncipes" },
        { "hebraico": "וְנָשַׁ֙מּוּ֙", "transliteral": "wə-nā-šam-mū", "traducao_palavra": "e pasmarão" },
        { "hebraico": "הַכֹּ֣הֲנִ֔ים", "transliteral": "hak-kō-hă-nîm", "traducao_palavra": "os sacerdotes" },
        { "hebraico": "וְהַנְּבִיאִ֖ים", "transliteral": "wə-han-nə-ḇî-ʾîm", "traducao_palavra": "e os profetas" },
        { "hebraico": "יִתְמָֽהוּ׃", "transliteral": "yiṯ-mā-hū", "traducao_palavra": "ficarão atônitos/maravilhados." }
      ]
    },
    "10": {
      "traducao_completa": "Então disse eu: Ah! Senhor YHWH! Verdadeiramente enganaste grandemente a este povo e a Jerusalém, dizendo: Tereis paz; pois a espada penetra até à alma.",
