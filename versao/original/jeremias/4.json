        { "hebraico": "נִ֥ירוּ", "transliteral": "nî-rū", "traducao_palavra": "arai/lavrai" },
        { "hebraico": "לָכֶ֖ם", "transliteral": "lā-ḵem", "traducao_palavra": "para vós" },
        { "hebraico": "נִ֑יר", "transliteral": "nîr", "traducao_palavra": "alqueive/campo novo" },
        { "hebraico": "וְאַֽל־תִּזְרְע֖וּ", "transliteral": "wə-ʾal-tiz-rə-ʿū", "traducao_palavra": "e não semeeis" },
        { "hebraico": "אֶל־קוֹצִֽים׃", "transliteral": "ʾel-qō-w-ṣîm", "traducao_palavra": "entre espinhos." }
      ]
    },
    "4": {
      "traducao_completa": "Circuncidai-vos a YHWH, e tirai as prepúcios do vosso coração, ó homens de Judá e habitantes de Jerusalém, para que o meu furor não saia como fogo e arda sem que haja quem o apague, por causa da maldade das vossas obras.",
      "palavras": [
        { "hebraico": "הִמֹּ֙לוּ֙", "transliteral": "him-mō-lū", "traducao_palavra": "Circuncidai-vos" },
        { "hebraico": "לַֽיהוָ֔ה", "transliteral": "la-YHWH", "traducao_palavra": "para YHWH" },
        { "hebraico": "וְהָסִ֙רוּ֙", "transliteral": "wə-hā-śi-rū", "traducao_palavra": "e tirai" },
