        { "hebraico": "דֶּ֖רֶךְ", "transliteral": "de-reḵ", "traducao_palavra": "em direção a" },
        { "hebraico": "בַּת־עַמִּ֑י", "transliteral": "baṯ-ʿam-mî", "traducao_palavra": "filha do meu povo" },
