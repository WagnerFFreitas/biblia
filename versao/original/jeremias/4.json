{
  "livro": "Jeremias - יִרְמְיָהוּ - Yirməyāhū",
  "capítulo": 4,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Se voltares, ó Israel, diz YHWH, para mim voltares; e se tirares as tuas abominações de diante de mim, e não andares errante;",
      "palavras": [
        { "hebraico": "אִם־תָּשׁ֨וּב", "transliteral": "ʾim-tā-šūḇ", "traducao_palavra": "Se voltares" },
        { "hebraico": "יִשְׂרָאֵ֜ל", "transliteral": "yiś-rā-ʾēl", "traducao_palavra": "Israel" },
        { "hebraico": "נְאֻם־יְהוָ֗ה", "transliteral": "nə-ʾum-YHWH", "traducao_palavra": "diz/oráculo de YHWH" },
        { "hebraico": "אֵלַי֙", "transliteral": "ʾê-lay", "traducao_palavra": "para mim" },
        { "hebraico": "תָּשׁ֔וּב", "transliteral": "tā-šūḇ", "traducao_palavra": "voltares" },
        { "hebraico": "וְאִם־תָּסִ֧יר", "transliteral": "wə-ʾim-tā-śîr", "traducao_palavra": "e se tirares" },
        { "hebraico": "שִׁקּוּצֶ֛יךָ", "transliteral": "šiq-qū-ṣe-y-ḵā", "traducao_palavra": "tuas abominações" },
        { "hebraico": "מִפָּנַ֖י", "transliteral": "mip-pā-nay", "traducao_palavra": "de diante de mim" },
        { "hebraico": "וְלֹ֥א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "תָנֽוּד׃", "transliteral": "ṯā-nūḏ", "traducao_palavra": "andares errante/vacilares." }
      ]
    },
    "2": {
      "traducao_completa": "E jurares: Vive YHWH, em verdade, em juízo e em justiça; então as nações se bendirão nele, e nele se gloriarão.",
      "palavras": [
        { "hebraico": "וְנִשְׁבַּעְתָּ֙", "transliteral": "wə-niš-ba-ʿtā", "traducao_palavra": "E jurares" },
        { "hebraico": "חַי־יְהוָ֔ה", "transliteral": "ḥay-YHWH", "traducao_palavra": "vive YHWH" },
        { "hebraico": "בֶּאֱמֶ֖ת", "transliteral": "be-ʾĕ-meṯ", "traducao_palavra": "em verdade" },
        { "hebraico": "בְּמִשְׁפָּ֣ט", "transliteral": "bə-miš-pāṭ", "traducao_palavra": "em juízo" },
        { "hebraico": "וּבִצְדָקָ֑ה", "transliteral": "ū-ḇiṣ-dā-qāh", "traducao_palavra": "e em justiça" },
        { "hebraico": "וְהִתְבָּ֤רְכוּ", "transliteral": "wə-hiṯ-bā-rə-ḵū", "traducao_palavra": "e bendirão a si" },
        { "hebraico": "בֹו֙", "transliteral": "bō-w", "traducao_palavra": "nele" },
        { "hebraico": "גֹּויִ֔ם", "transliteral": "gō-w-yim", "traducao_palavra": "nações" },
        { "hebraico": "וּבֹ֥ו", "transliteral": "ū-ḇō-w", "traducao_palavra": "e nele" },
        { "hebraico": "יִתְהַלָּֽלוּ׃", "transliteral": "yiṯ-hal-lā-lū", "traducao_palavra": "se gloriarão." }
      ]
    },
    "3": {
      "traducao_completa": "Porque assim diz YHWH aos homens de Judá e a Jerusalém: Lavrai para vós campo novo, e não semeeis entre espinhos.",
      "palavras": [
        { "hebraico": "כִּי־כֹ֣ה ׀", "transliteral": "kî-ḵōh", "traducao_palavra": "Porque assim" },
        { "hebraico": "אָמַ֣ר", "transliteral": "ʾā-mar", "traducao_palavra": "disse" },
        { "hebraico": "יְהוָ֗ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "לְאִ֤ישׁ", "transliteral": "lə-ʾîš", "traducao_palavra": "ao homem de" },
        { "hebraico": "יְהוּדָה֙", "transliteral": "yə-hū-ḏāh", "traducao_palavra": "Judá" },
