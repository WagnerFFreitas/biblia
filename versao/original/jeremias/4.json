    },
    "6": {
      "traducao_completa": "Arvorai a bandeira para Sião; buscai refúgio, não vos detenhais; porque eu trago um mal do norte, sim, uma grande destruição.",
      "palavras": [
        { "hebraico": "שְׂאוּ־נֵ֣ס", "transliteral": "śə-ʾū-nês", "traducao_palavra": "Arvorai bandeira" },
        { "hebraico": "צִיֹּ֑ונָה", "transliteral": "ṣiy-yō-w-nāh", "traducao_palavra": "para Sião" },
        { "hebraico": "הָעִ֥יזוּ", "transliteral": "hā-ʿî-zū", "traducao_palavra": "buscai refúgio" },
        { "hebraico": "אַֽל־תַּעֲמֹ֑דוּ", "transliteral": "ʾal-ta-ʿă-mō-ḏū", "traducao_palavra": "não vos detenhais/pareis" },
