        { "hebraico": "קֹֽול", "transliteral": "qō-wl", "traducao_palavra": "[o] som de" },
        { "hebraico": "שֹׁופָ֛ר", "transliteral": "šō-w-p̄ār", "traducao_palavra": "trombeta" },
