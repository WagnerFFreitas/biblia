        { "hebraico": "לָעָ֤ם", "transliteral": "lā-ʿām", "traducao_palavra": "a este povo" },
        { "hebraico": "הַזֶּה֙", "transliteral": "haz-zeh", "traducao_palavra": "este" },
        { "hebraico": "וְלִירוּשָׁלִַ֙ם֙", "transliteral": "wə-li-y-rū-šā-la-im", "traducao_palavra": "e a Jerusalém" },
        { "hebraico": "לֵאמֹ֔ר", "transliteral": "lē-ʾmōr", "traducao_palavra": "dizendo" },
        { "hebraico": "שָׁלֹ֖ום", "transliteral": "šā-lō-wm", "traducao_palavra": "Paz" },
