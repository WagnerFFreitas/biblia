        { "hebraico": "וְשֶׁ֥בֶר", "transliteral": "wə-še-ḇer", "traducao_palavra": "e destruição" },
        { "hebraico": "גָּדֹֽול׃", "transliteral": "gā-ḏō-wl", "traducao_palavra": "grande." }
      ]
    },
    "7": {
      "traducao_completa": "Já subiu o leão da sua ramada, e o destruidor das nações partiu; ele saiu do seu lugar para pôr a tua terra em assolação, para que as tuas cidades sejam desertas e sem habitantes.",
      "palavras": [
        { "hebraico": "עָלָ֥ה", "transliteral": "ʿā-lāh", "traducao_palavra": "Subiu" },
        { "hebraico": "אַרְיֵ֖ה", "transliteral": "ʾar-yēh", "traducao_palavra": "[o] leão" },
        { "hebraico": "מִסֻּבְּכֹ֑ו", "transliteral": "mis-śub-bə-ḵō-w", "traducao_palavra": "da sua ramada/esconderijo" },
        { "hebraico": "וּמַשְׁחִ֣ית", "transliteral": "ū-maš-ḥîṯ", "traducao_palavra": "e o destruidor de" },
        { "hebraico": "גֹּויִ֗ם", "transliteral": "gō-w-yim", "traducao_palavra": "nações" },
        { "hebraico": "נָסַע֙", "transliteral": "nā-sa-ʿ", "traducao_palavra": "partiu" },
        { "hebraico": "יָצָ֣א", "transliteral": "yā-ṣā", "traducao_palavra": "saiu" },
        { "hebraico": "מִמְּקֹמֹ֔ו", "transliteral": "mim-mə-qō-mō-w", "traducao_palavra": "do seu lugar" },
