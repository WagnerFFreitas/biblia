        { "hebraico": "עָרַ֥יִךְ", "transliteral": "ʿā-ra-yiḵ", "traducao_palavra": "tuas cidades" },
        { "hebraico": "תִּצֶּ֖ינָה", "transliteral": "tiṣ-ṣe-nāh", "traducao_palavra": "serão desoladas" },
