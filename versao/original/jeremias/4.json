      ]
    },
    "9": {
      "traducao_completa": "E sucederá naquele dia, diz YHWH, que desfalecerá o coração do rei e o coração dos príncipes; e os sacerdotes pasmarão, e os profetas se maravilharão.",
      "palavras": [
        { "hebraico": "וְהָיָ֤ה", "transliteral": "wə-hā-yāh", "traducao_palavra": "E será/sucederá" },
        { "hebraico": "בַיֹּום־הַהוּא֙", "transliteral": "ḇay-yō-wm-ha-hū", "traducao_palavra": "naquele dia" },
        { "hebraico": "נְאֻם־יְהוָ֔ה", "transliteral": "nə-ʾum-YHWH", "traducao_palavra": "diz YHWH" },
        { "hebraico": "יֹאבַ֥ד", "transliteral": "yō-ḇaḏ", "traducao_palavra": "desfalecerá/perderá" },
