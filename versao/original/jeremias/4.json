        { "hebraico": "שֹׁופָ֖ר", "transliteral": "šō-w-p̄ār", "traducao_palavra": "[a] trombeta" },
        { "hebraico": "בָּאָ֑רֶץ", "transliteral": "bā-ʾā-reṣ", "traducao_palavra": "na terra" },
