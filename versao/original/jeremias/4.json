        { "hebraico": "וְיֹשְׁבֵ֣י", "transliteral": "wə-yō-šə-ḇê", "traducao_palavra": "e habitantes de" },
        { "hebraico": "יְרוּשָׁלִָ֑ם", "transliteral": "yə-rū-šā-lā-im", "traducao_palavra": "Jerusalém" },
        { "hebraico": "פֶּן־תֵּצֵ֤א", "transliteral": "pen-tê-ṣē", "traducao_palavra": "para que não saia" },
        { "hebraico": "כָאֵשׁ֙", "transliteral": "ḵā-ʾēš", "traducao_palavra": "como fogo" },
        { "hebraico": "חֲמָתִ֔י", "transliteral": "ḥă-mā-ṯî", "traducao_palavra": "meu furor" },
        { "hebraico": "וּבָעֲרָה֙", "transliteral": "ū-ḇā-ʿă-rāh", "traducao_palavra": "e queime" },
        { "hebraico": "וְאֵ֣ין", "transliteral": "wə-ʾên", "traducao_palavra": "e sem que haja" },
        { "hebraico": "מְכַבֶּ֔ה", "transliteral": "mə-ḵab-beh", "traducao_palavra": "quem apague" },
        { "hebraico": "מִפְּנֵ֖י", "transliteral": "mip-pə-nê", "traducao_palavra": "por causa de/da face de" },
        { "hebraico": "רֹ֥עַ", "transliteral": "rō-aʿ", "traducao_palavra": "[a] maldade de" },
        { "hebraico": "מַעַלְלֵיכֶֽם׃", "transliteral": "ma-ʿal-lê-ḵem", "traducao_palavra": "vossas obras/práticas." }
      ]
    },
    "5": {
      "traducao_completa": "Anunciai em Judá, e fazei ouvir em Jerusalém, e dizei: Tocai a trombeta na terra; gritai em voz alta e dizei: Ajuntai-vos, e entremos nas cidades fortificadas.",
