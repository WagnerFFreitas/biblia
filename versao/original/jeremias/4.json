        { "hebraico": "מֵעַ֣י", "transliteral": "mē-ʿay", "traducao_palavra": "minhas entranhas" },
        { "hebraico": "אוחילה", "transliteral": "ʾō-w-ḥî-lāh", "traducao_palavra": "eu me contorço em dor [Qere: ʾō-w-ḥî-lāh]" },
