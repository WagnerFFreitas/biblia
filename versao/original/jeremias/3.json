        { "hebraico": "אֶרְפָּ֖ה", "transliteral": "ʾer-pāh", "traducao_palavra": "curarei/sararei" },
        { "hebraico": "מְשׁוּבֹתֵיכֶ֑ם", "transliteral": "mə-šū-ḇō-ṯê-ḵem", "traducao_palavra": "vossas rebeldias" },
