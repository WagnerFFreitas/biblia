        { "hebraico": "ל֣וּחַ", "transliteral": "lū-aḥ", "traducao_palavra": "[a] tábua de" },
        { "hebraico": "לִבָּ֔ם", "transliteral": "lib-bām", "traducao_palavra": "coração deles" },
        { "hebraico": "וּלְקַרְנֹ֖ות", "transliteral": "ū-lə-qar-nō-wṯ", "traducao_palavra": "e nas pontas de" },
