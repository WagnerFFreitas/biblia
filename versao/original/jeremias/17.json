        { "hebraico": "בְּנֵיהֶם֙", "transliteral": "bə-nê-hem", "traducao_palavra": "os seus filhos" },
        { "hebraico": "מִזְבְּחֹותָ֣ם", "transliteral": "miz-bə-ḥō-w-ṯām", "traducao_palavra": "[dos] seus altares" },
        { "hebraico": "וַאֲשֵׁרֵיהֶ֔ם", "transliteral": "wa-ʾă-šê-rê-hem", "traducao_palavra": "e dos seus Asherim/bosques" },
