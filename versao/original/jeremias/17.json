    "5": {
      "traducao_completa": "Assim diz YHWH: Maldito o homem que confia no homem, e faz da carne o seu braço, e cujo coração se aparta de YHWH!",
      "palavras": [
        { "hebraico": "כֹּ֣ה ׀", "transliteral": "kōh", "traducao_palavra": "Assim" },
        { "hebraico": "אָמַ֣ר", "transliteral": "ʾā-mar", "traducao_palavra": "disse" },
        { "hebraico": "יְהוָ֗ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "אָר֤וּר", "transliteral": "ʾā-rūr", "traducao_palavra": "maldito" },
        { "hebraico": "הַגֶּ֙בֶר֙", "transliteral": "hag-ge-ḇer", "traducao_palavra": "o homem" },
