    "9": {
      "traducao_completa": "Enganoso é o coração, mais do que todas as coisas, e perverso; quem o conhecerá?",
      "palavras": [
        { "hebraico": "עָקֹ֥ב", "transliteral": "ʿā-qōḇ", "traducao_palavra": "Enganoso/Suplantador [é]" },
