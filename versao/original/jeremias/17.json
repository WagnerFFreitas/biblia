        { "hebraico": "רַעֲנָ֑ן", "transliteral": "ra-ʿă-nān", "traducao_palavra": "verde" },
        { "hebraico": "עַ֖ל", "transliteral": "ʿal", "traducao_palavra": "sobre" },
        { "hebraico": "גְּבָעֹ֥ות", "transliteral": "gə-ḇā-ʿō-wṯ", "traducao_palavra": "outeiros" },
