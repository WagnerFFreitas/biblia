        { "hebraico": "וְשָׁמַטְתָּה֮", "transliteral": "wə-šā-maṭ-tāh", "traducao_palavra": "E deixarás cair/despossuirás" },
        { "hebraico": "וּבְךָ֗", "transliteral": "ū-ḇə-ḵā", "traducao_palavra": "e em ti/por ti mesma" },
        { "hebraico": "מִנַּחֲלָתְךָ֙", "transliteral": "min-na-ḥă-lā-ṯə-ḵā", "traducao_palavra": "da tua herança" },
        { "hebraico": "אֲשֶׁ֣ר", "transliteral": "ʾă-šer", "traducao_palavra": "que" },
        { "hebraico": "נָתַ֣תִּי", "transliteral": "nā-ṯat-tî", "traducao_palavra": "dei" },
        { "hebraico": "לָ֔ךְ", "transliteral": "lāḵ", "traducao_palavra": "a ti" },
        { "hebraico": "וְהַעֲבַדְתִּ֙יךָ֙", "transliteral": "wə-ha-ʿă-ḇaḏ-tî-ḵā", "traducao_palavra": "e far-te-ei servir" },
        { "hebraico": "אֶת־", "transliteral": "ʾeṯ-", "traducao_palavra": "[partícula]" },
        { "hebraico": "אֹיְבֶ֔יךָ", "transliteral": "ʾō-yə-ḇe-y-ḵā", "traducao_palavra": "teus inimigos" },
        { "hebraico": "בָּאָ֖רֶץ", "transliteral": "bā-ʾā-reṣ", "traducao_palavra": "na terra" },
        { "hebraico": "אֲשֶׁ֣ר", "transliteral": "ʾă-šer", "traducao_palavra": "que" },
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "יָדָ֑עְתָּ", "transliteral": "yā-ḏā-ʿə-tā", "traducao_palavra": "conheces" },
