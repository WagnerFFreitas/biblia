        { "hebraico": "מִ֣י", "transliteral": "mî", "traducao_palavra": "quem" },
        { "hebraico": "יַחְמֹ֤ל", "transliteral": "yaḥ-mōl", "traducao_palavra": "terá compaixão" },
        { "hebraico": "עָלַ֙יִךְ֙", "transliteral": "ʿā-la-yiḵ", "traducao_palavra": "de ti" },
        { "hebraico": "יְרוּשָׁלַ֔͏ִם", "transliteral": "Yə-rū-šā-la-im", "traducao_palavra": "ó Jerusalém?" },
