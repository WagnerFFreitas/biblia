        { "hebraico": "כֻּלֹּ֖ה", "transliteral": "kul-lōh", "traducao_palavra": "todos eles" },
        { "hebraico": "מְקַֽלְלַוְנִי׃", "transliteral": "mə-qal-la-wə-nî", "traducao_palavra": "estão amaldiçoando-me." }
      ]
    },
    "11": {
      "traducao_completa": "Disse YHWH: Decerto que te fortalecerei para o bem; decerto que farei o inimigo suplicar-te no tempo da calamidade e no tempo da angústia.",
