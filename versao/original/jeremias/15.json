        { "hebraico": "לֹ֧א", "transliteral": "lō", "traducao_palavra": "não [juramento]" },
        { "hebraico": "שרותך", "transliteral": "šê-rî-ṯî-ḵā", "traducao_palavra": "fortalecerei-te [Qere: šê-rî-ṯî-ḵā]" },
