        { "hebraico": "עָלֶ֖יךָ", "transliteral": "ʿā-le-y-ḵā", "traducao_palavra": "por causa de ti" },
        { "hebraico": "חֶרְפָּֽה׃", "transliteral": "ḥer-pāh", "traducao_palavra": "[a] afronta." }
      ]
    },
    "16": {
      "traducao_completa": "Achando-se as tuas palavras, logo as comi, e a tua palavra foi para mim o gozo e alegria do meu coração; porque pelo teu nome sou chamado, ó YHWH, Deus dos Exércitos.",
      "palavras": [
        { "hebraico": "נִמְצְא֥וּ", "transliteral": "nim-ṣə-ʾū", "traducao_palavra": "Acharam-se" },
        { "hebraico": "דְבָרֶ֖יךָ", "transliteral": "də-ḇā-re-y-ḵā", "traducao_palavra": "tuas palavras" },
        { "hebraico": "וָאֹכְלֵ֑ם", "transliteral": "wā-ʾō-ḵə-lêm", "traducao_palavra": "e eu as comi" },
        { "hebraico": "וַיְהִ֨י", "transliteral": "way-hî", "traducao_palavra": "e foi" },
        { "hebraico": "דבריך", "transliteral": "də-ḇā-re-y-ḵā", "traducao_palavra": "tua palavra [Qere: wə-ha-yāh də-ḇā-rə-ḵā]" },
        { "hebraico": "לִ֤י", "transliteral": "lî", "traducao_palavra": "para mim" },
        { "hebraico": "לְשָׂשֹׂון֙", "transliteral": "lə-śā-śō-wn", "traducao_palavra": "por gozo" },
        { "hebraico": "וּלְשִׂמְחַ֣ת", "transliteral": "ū-lə-śim-ḥaṯ", "traducao_palavra": "e por alegria de" },
        { "hebraico": "לְבָבִ֔י", "transliteral": "lə-ḇā-ḇî", "traducao_palavra": "meu coração" },
        { "hebraico": "כִּֽי־נִקְרָ֧א", "transliteral": "kî-niq-rā", "traducao_palavra": "porque é chamado" },
        { "hebraico": "שִׁמְךָ֛", "transliteral": "šim-ḵā", "traducao_palavra": "teu nome" },
        { "hebraico": "עָלַ֖י", "transliteral": "ʿā-lay", "traducao_palavra": "sobre mim" },
        { "hebraico": "יְהוָ֥ה ׀", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "אֱלֹהֵ֥י", "transliteral": "ʾĕ-lō-hê", "traducao_palavra": "Deus de" },
        { "hebraico": "צְבָאֹֽות׃", "transliteral": "ṣə-ḇā-ʾō-wṯ", "traducao_palavra": "Exércitos." }
      ]
    },
    "17": {
      "traducao_completa": "Nunca me assentei no conselho dos que se alegram, nem me regozijei; por causa da tua mão me assentei solitário, pois me encheste de indignação.",
      "palavras": [
        { "hebraico": "לֹא־יָשַׁ֥בְתִּי", "transliteral": "lō-yā-šaḇ-tî", "traducao_palavra": "Não me assentei" },
        { "hebraico": "בְסֹוד־", "transliteral": "ḇə-śō-wḏ-", "traducao_palavra": "no conselho/assembleia de" },
        { "hebraico": "מְשַׂחֲקִ֖ים", "transliteral": "mə-śa-ḥă-qîm", "traducao_palavra": "[os que] se divertem/riem" },
        { "hebraico": "וָאֶעְלֹ֑ז", "transliteral": "wā-ʾe-ʿlōz", "traducao_palavra": "nem exultei" },
        { "hebraico": "מִפְּנֵי־", "transliteral": "mip-pə-nê-", "traducao_palavra": "por causa de/da face de" },
        { "hebraico": "יָֽדְךָ֙", "transliteral": "yā-ḏə-ḵā", "traducao_palavra": "tua mão" },
        { "hebraico": "בָּדָ֣ד", "transliteral": "bā-ḏāḏ", "traducao_palavra": "solitário" },
        { "hebraico": "יָשַׁ֔בְתִּי", "transliteral": "yā-šaḇ-tî", "traducao_palavra": "me assentei" },
        { "hebraico": "כִּֽי־זַ֖עַם", "transliteral": "kî-za-ʿam", "traducao_palavra": "pois indignação" },
        { "hebraico": "מִלֵּאתָֽנִי׃", "transliteral": "mil-lê-ṯā-nî", "traducao_palavra": "encheste a mim." }
      ]
    },
    "18": {
      "traducao_completa": "Por que é a minha dor perpétua, e a minha chaga grave, que não admite cura? Serias tu para mim como ilusória torrente, como águas que não são fiéis?",
      "palavras": [
        { "hebraico": "לָ֤מָּה", "transliteral": "lām-māh", "traducao_palavra": "Por que" },
        { "hebraico": "הָיָ֧ה", "transliteral": "hā-yāh", "traducao_palavra": "foi/é" },
        { "hebraico": "כְאֵבִ֛י", "transliteral": "ḵə-ʾê-ḇî", "traducao_palavra": "minha dor" },
        { "hebraico": "נֶ֖צַח", "transliteral": "ne-ṣaḥ", "traducao_palavra": "perpétua/vencida" },
        { "hebraico": "וּמַכָּתִ֣י", "transliteral": "ū-mak-kā-ṯî", "traducao_palavra": "e minha ferida" },
        { "hebraico": "אֲנוּשָׁ֑ה", "transliteral": "ʾă-nū-šāh", "traducao_palavra": "grave/incurável" },
        { "hebraico": "מֵאֲנָ֖ה", "transliteral": "mê-ʾă-nāh", "traducao_palavra": "recusou" },
        { "hebraico": "הֵרָפֵ֑א", "transliteral": "hê-rā-p̄ē", "traducao_palavra": "ser curada" },
        { "hebraico": "הָיֹ֨ו", "transliteral": "hā-yō-w", "traducao_palavra": "Acaso ser" },
        { "hebraico": "תִהְיֶ֥ה", "transliteral": "ṯih-yeh", "traducao_palavra": "serás tu" },
        { "hebraico": "לִִי֙", "transliteral": "lî", "traducao_palavra": "para mim" },
        { "hebraico": "כְּמֹ֣ו", "transliteral": "kə-mō-w", "traducao_palavra": "como" },
