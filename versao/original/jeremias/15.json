        { "hebraico": "לִ֣י", "transliteral": "lî", "traducao_palavra": "de mim" },
        { "hebraico": "אִמִּ֔י", "transliteral": "ʾim-mî", "traducao_palavra": "minha mãe" },
        { "hebraico": "כִּ֣י", "transliteral": "kî", "traducao_palavra": "porque" },
