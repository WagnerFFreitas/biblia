    "13": {
      "traducao_completa": "Os teus bens e os teus tesouros entregarei ao saque por nada, e isso em todos os teus termos, e por todos os teus pecados.",
      "palavras": [
        { "hebraico": "חֵילְךָ֧", "transliteral": "ḥê-lə-ḵā", "traducao_palavra": "Teus bens/riquezas" },
        { "hebraico": "וְאֹוצְרֹותֶ֛יךָ", "transliteral": "wə-ʾō-w-ṣə-rō-w-ṯê-ḵā", "traducao_palavra": "e teus tesouros" },
        { "hebraico": "לָבַ֥ז", "transliteral": "lā-ḇaz", "traducao_palavra": "para o saque" },
        { "hebraico": "אֶתֵּ֖ן", "transliteral": "ʾet-tên", "traducao_palavra": "darei" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "בִמְחִ֑יר", "transliteral": "ḇim-ḥîr", "traducao_palavra": "por preço" },
        { "hebraico": "וּבְכָל־", "transliteral": "ū-ḇə-ḵāl-", "traducao_palavra": "e em todos" },
        { "hebraico": "חַטֹּאותֶ֖יךָ", "transliteral": "ḥaṭ-ṭō-w-ṯe-y-ḵā", "traducao_palavra": "teus pecados" },
        { "hebraico": "וּבְכָל־", "transliteral": "ū-ḇə-ḵāl-", "traducao_palavra": "e em todos" },
        { "hebraico": "גְּבוּלֶֽיךָ׃", "transliteral": "gə-ḇū-le-y-ḵā", "traducao_palavra": "teus limites/termos." }
      ]
    },
    "14": {
      "traducao_completa": "E farei que passem a teus inimigos numa terra que não conheces; porque um fogo se acendeu na minha ira e sobre vós arderá.",
      "palavras": [
        { "hebraico": "והעברתי", "transliteral": "wə-ha-ʿă-ḇar-tî", "traducao_palavra": "E farei passar [Qere: wə-ha-ʿă-ḇaḏ-tî - farei servir]" },
        { "hebraico": "אֶת־", "transliteral": "ʾeṯ-", "traducao_palavra": "[partícula]" },
        { "hebraico": "אֹיְבֶ֔יךָ", "transliteral": "ʾō-yə-ḇe-y-ḵā", "traducao_palavra": "[a] teus inimigos" },
        { "hebraico": "בְּאֶ֖רֶץ", "transliteral": "bə-ʾe-reṣ", "traducao_palavra": "em terra" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "[que] não" },
        { "hebraico": "יָדָ֑עְתָּ", "transliteral": "yā-ḏā-ʿə-tā", "traducao_palavra": "conheces" },
        { "hebraico": "כִּֽי־אֵשׁ֙", "transliteral": "kî-ʾēš", "traducao_palavra": "porque fogo" },
        { "hebraico": "קָדְחָ֣ה", "transliteral": "qāḏ-ḥāh", "traducao_palavra": "acendeu-se" },
        { "hebraico": "בְאַפִּ֔י", "transliteral": "ḇə-ʾap-pî", "traducao_palavra": "na minha ira" },
        { "hebraico": "עֲלֵיכֶ֖ם", "transliteral": "ʿă-lê-ḵem", "traducao_palavra": "sobre vós" },
        { "hebraico": "תּוּקָֽד׃", "transliteral": "tū-qāḏ", "traducao_palavra": "ardará." }
      ]
    },
    "15": {
      "traducao_completa": "Tu o sabes, ó YHWH; lembra-te de mim, e visita-me, e vinga-me dos meus perseguidores; não me arrebtes pela tua longanimidade; sabe que por amor de ti sofri afronta.",
      "palavras": [
        { "hebraico": "אַתָּ֤ה", "transliteral": "ʾat-tāh", "traducao_palavra": "Tu" },
        { "hebraico": "יָדַ֙עְתָּ֙", "transliteral": "yā-ḏa-ʿ-tā", "traducao_palavra": "sabes" },
        { "hebraico": "יְהוָ֔ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "זָכְרֵ֥נִי", "transliteral": "zā-ḵə-rē-nî", "traducao_palavra": "lembra-te de mim" },
        { "hebraico": "וּפָקְדֵ֕נִי", "transliteral": "ū-p̄ā-qə-ḏē-nî", "traducao_palavra": "e visita-me" },
        { "hebraico": "וְהִנָּ֥קֶם", "transliteral": "wə-hin-nā-qem", "traducao_palavra": "e vinga-me" },
        { "hebraico": "לִ֖י", "transliteral": "lî", "traducao_palavra": "por mim" },
        { "hebraico": "מֵרֹדְפָ֑י", "transliteral": "mê-rō-ḏə-p̄āy", "traducao_palavra": "dos meus perseguidores" },
        { "hebraico": "אַל־", "transliteral": "ʾal-", "traducao_palavra": "não" },
        { "hebraico": "לְאֶ֥רֶךְ", "transliteral": "lə-ʾe-reḵ", "traducao_palavra": "[pela] longanimidade de" },
        { "hebraico": "אַפְּךָ֖", "transliteral": "ʾap-pə-ḵā", "traducao_palavra": "tua ira" },
        { "hebraico": "תִּקָּחֵ֑נִי", "transliteral": "tiq-qā-ḥē-nî", "traducao_palavra": "me arrebatas" },
        { "hebraico": "דַּ֕ע", "transliteral": "da-ʿ", "traducao_palavra": "sabe" },
