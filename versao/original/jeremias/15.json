        { "hebraico": "הִפְגַּ֣עְתִּי", "transliteral": "hip̄-ga-ʿtî", "traducao_palavra": "fiz interceder/suplicar" },
        { "hebraico": "בְךָ֗", "transliteral": "ḇə-ḵā", "traducao_palavra": "contigo" },
        { "hebraico": "בְּעֵ֥ת", "transliteral": "bə-ʿêṯ", "traducao_palavra": "no tempo de" },
        { "hebraico": "רָעָ֛ה", "transliteral": "rā-ʿāh", "traducao_palavra": "mal" },
        { "hebraico": "וּבְעֵ֥ת", "transliteral": "ū-ḇə-ʿêṯ", "traducao_palavra": "e no tempo de" },
        { "hebraico": "צָרָ֖ה", "transliteral": "ṣā-rāh", "traducao_palavra": "angústia" },
        { "hebraico": "אֶת־", "transliteral": "ʾeṯ-", "traducao_palavra": "[partícula]" },
