      ]
    },
    "12": {
      "traducao_completa": "Acaso pode o homem quebrar o ferro, o ferro do norte, ou o bronze?",
      "palavras": [
        { "hebraico": "הֲיָרֹ֥עַ", "transliteral": "hă-yā-rō-aʿ", "traducao_palavra": "Acaso quebrará" },
