        { "hebraico": "רִ֛יב", "transliteral": "rîḇ", "traducao_palavra": "contenda" },
        { "hebraico": "וְאִ֥ישׁ", "transliteral": "wə-ʾîš", "traducao_palavra": "e homem de" },
        { "hebraico": "מָדֹ֖ון", "transliteral": "mā-ḏō-wn", "traducao_palavra": "discórdia" },
        { "hebraico": "לְכָל־", "transliteral": "lə-ḵāl-", "traducao_palavra": "para toda" },
        { "hebraico": "הָאָ֑רֶץ", "transliteral": "hā-ʾā-reṣ", "traducao_palavra": "a terra" },
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "נָשִׁ֥יתִי", "transliteral": "nā-šî-ṯî", "traducao_palavra": "emprestei com usura" },
        { "hebraico": "וְלֹא־", "transliteral": "wə-lō-", "traducao_palavra": "e não" },
        { "hebraico": "נָשׁוּ־", "transliteral": "nā-šū-", "traducao_palavra": "emprestaram com usura" },
