        { "hebraico": "הִנֵּ֨ה", "transliteral": "hin-nēh", "traducao_palavra": "Eis que" },
        { "hebraico": "בִדְבַר־יְהוָ֣ה", "transliteral": "biḏ-ḇar-YHWH", "traducao_palavra": "da palavra de YHWH" },
        { "hebraico": "מָאָ֔סוּ", "transliteral": "mā-ʾā-śū", "traducao_palavra": "rejeitaram" },
        { "hebraico": "וְחָכְמַת־מֶ֖ה", "transliteral": "wə-ḥāḵ-maṯ-meh", "traducao_palavra": "e que sabedoria" },
        { "hebraico": "לָהֶֽם׃", "transliteral": "lā-hem", "traducao_palavra": "[há] para eles?" }
      ]
    },
    "10": {
      "traducao_completa": "Portanto darei as suas mulheres a outros, e as suas herdades aos que as hão de possuir; porque desde o menor até ao maior, cada um se dá à ganância; desde o profeta até ao sacerdote, cada um procede falsamente.",
