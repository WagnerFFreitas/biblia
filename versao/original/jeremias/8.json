    "12": {
      "traducao_completa": "Porventura envergonharam-se por cometerem abominação? Pelo contrário, de maneira nenhuma se envergonharam, nem souberam o que era envergonhar-se; portanto cairão entre os que caem; no tempo da sua visitação tropeçarão, diz YHWH.",
      "palavras": [
        { "hebraico": "הֹבִ֕ישׁוּ", "transliteral": "hō-ḇî-šū", "traducao_palavra": "Envergonharam-se?" },
        { "hebraico": "כִּ֥י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "תֹועֵבָ֖ה", "transliteral": "ṯō-w-ʿê-ḇāh", "traducao_palavra": "abominação" },
        { "hebraico": "עָשׂ֑וּ", "transliteral": "ʿā-śū", "traducao_palavra": "fizeram" },
        { "hebraico": "גַּם־בֹּ֣ושׁ", "transliteral": "gam-bō-wš", "traducao_palavra": "também de vergonha" },
        { "hebraico": "לֹֽא־יֵבֹ֗ושׁוּ", "transliteral": "lō-w-yê-ḇō-w-šū", "traducao_palavra": "não se envergonharam" },
