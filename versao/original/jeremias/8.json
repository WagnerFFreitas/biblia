    "3": {
      "traducao_completa": "E será escolhida antes a morte do que a vida por todo o remanescente que restar desta linhagem maligna, em todos os lugares para onde os lancei, diz YHWH dos Exércitos.",
      "palavras": [
        { "hebraico": "וְנִבְחַ֥ר", "transliteral": "wə-niḇ-ḥar", "traducao_palavra": "E será escolhida" },
        { "hebraico": "מָ֙וֶת֙", "transliteral": "mā-weṯ", "traducao_palavra": "[a] morte" },
        { "hebraico": "מֵֽחַיִּ֔ים", "transliteral": "mê-ḥay-yîm", "traducao_palavra": "mais do que a vida" },
        { "hebraico": "לְכֹל֙", "transliteral": "lə-ḵōl", "traducao_palavra": "por todo" },
        { "hebraico": "הַשְּׁאֵרִ֣ית", "transliteral": "haš-šə-ʾê-rîṯ", "traducao_palavra": "o remanescente" },
        { "hebraico": "הַנִּשְׁאָרִ֔ים", "transliteral": "han-niš-ʾā-rîm", "traducao_palavra": "dos que restarem" },
        { "hebraico": "מִן־הַמִּשְׁפָּחָ֥ה", "transliteral": "min-ham-miš-pā-ḥāh", "traducao_palavra": "desta família/linhagem" },
        { "hebraico": "הָרָעָ֖ה", "transliteral": "hā-rā-ʿāh", "traducao_palavra": "maligna" },
        { "hebraico": "הַזֹּ֑את", "transliteral": "haz-zōṯ", "traducao_palavra": "esta" },
        { "hebraico": "בְּכָל־הַמְּקֹמֹות֙", "transliteral": "bə-ḵāl-ham-mə-qō-mō-wṯ", "traducao_palavra": "em todos os lugares" },
        { "hebraico": "אֲשֶׁ֣ר", "transliteral": "ʾă-šer", "traducao_palavra": "para onde" },
        { "hebraico": "הִדַּחְתִּ֣ים", "transliteral": "hid-daḥ-tîm", "traducao_palavra": "lancei eles" },
        { "hebraico": "שָׁ֔ם", "transliteral": "šām", "traducao_palavra": "ali" },
