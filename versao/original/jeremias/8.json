      ]
    },
    "7": {
      "traducao_completa": "Até a cegonha no céu conhece os seus tempos determinados; e a rola, e o grou, e a andorinha observam o tempo da sua vinda; mas o meu povo não conhece o juízo de YHWH.",
      "palavras": [
        { "hebraico": "גַּם־חֲסִידָ֣ה", "transliteral": "gam-ḥă-śî-ḏāh", "traducao_palavra": "Até a cegonha" },
        { "hebraico": "בַשָּׁמַ֗יִם", "transliteral": "baš-šā-ma-yim", "traducao_palavra": "nos céus" },
        { "hebraico": "יָֽדְעָה֙", "transliteral": "yā-ḏə-ʿāh", "traducao_palavra": "conheceu" },
        { "hebraico": "מֹועֲדֶ֔יהָ", "transliteral": "mō-w-ʿă-ḏe-hā", "traducao_palavra": "seus tempos" },
        { "hebraico": "וְתֹ֤ר", "transliteral": "wə-ṯōr", "traducao_palavra": "e [a] rola" },
        { "hebraico": "וסיס", "transliteral": "wə-śîś", "traducao_palavra": "e [o] andorinhão [Qere: wə-śûs]" },
