        { "hebraico": "עַל־רָעָתֹ֗ו", "transliteral": "ʿal-rā-ʿā-ṯō-w", "traducao_palavra": "de sua maldade" },
        { "hebraico": "לֵאמֹר֙", "transliteral": "lē-ʾmōr", "traducao_palavra": "dizendo" },
