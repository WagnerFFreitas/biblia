        { "hebraico": "עָשִׂ֔יתִי", "transliteral": "ʿā-śî-ṯî", "traducao_palavra": "fiz eu?" },
        { "hebraico": "כֻּלֹּ֕ו", "transliteral": "kul-lō-w", "traducao_palavra": "cada um deles" },
        { "hebraico": "שָׁ֖ב", "transliteral": "šāḇ", "traducao_palavra": "voltou/virou-se" },
        { "hebraico": "במרוצותם", "transliteral": "bim-rū-ṣō-w-ṯām", "traducao_palavra": "em sua carreira [Qere: bim-rū-ṣā-ṯām]" },
        { "hebraico": "כְּס֥וּס", "transliteral": "kə-śūś", "traducao_palavra": "como cavalo" },
