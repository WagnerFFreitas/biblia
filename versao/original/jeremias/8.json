      ]
    },
    "4": {
      "traducao_completa": "Dir-lhes-ás mais: Assim diz YHWH: Acaso os que caem não se levantam? Ou o que se desvia não volta?",
      "palavras": [
        { "hebraico": "וְאָמַרְתָּ֣", "transliteral": "wə-ʾā-mar-tā", "traducao_palavra": "E dirás" },
        { "hebraico": "אֲלֵיהֶ֗ם", "transliteral": "ʾă-lê-hem", "traducao_palavra": "a eles" },
        { "hebraico": "כֹּ֚ה", "transliteral": "kōh", "traducao_palavra": "Assim" },
        { "hebraico": "אָמַ֣ר", "transliteral": "ʾā-mar", "traducao_palavra": "disse" },
        { "hebraico": "יְהוָ֔ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "הֲיִפְּל֖וּ", "transliteral": "hă-yip-pə-lū", "traducao_palavra": "Acaso os que caem" },
        { "hebraico": "וְלֹ֣א", "transliteral": "wə-lō", "traducao_palavra": "não" },
        { "hebraico": "יָק֑וּמוּ", "transliteral": "yā-qū-mū", "traducao_palavra": "se levantam?" },
        { "hebraico": "אִם־יָשׁ֥וּב", "transliteral": "ʾim-yā-šūḇ", "traducao_palavra": "Ou se volta" },
        { "hebraico": "וְלֹ֥א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "יָשֽׁוּב׃", "transliteral": "yā-šūḇ", "traducao_palavra": "torna a voltar?" }
      ]
    },
    "5": {
      "traducao_completa": "Por que, pois, se desviou este povo de Jerusalém com uma apostasia contínua? Retêm o engano, recusam-se a voltar.",
      "palavras": [
        { "hebraico": "מַדּ֨וּעַ", "transliteral": "mad-dū-aʿ", "traducao_palavra": "Por que" },
