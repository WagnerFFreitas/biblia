      ]
    },
    "6": {
      "traducao_completa": "Eu escutei e ouvi; não falam o que é reto; ninguém há que se arrependa da sua maldade, dizendo: Que fiz eu? Cada um se desvia na sua carreira, como o cavalo que arremete na peleja.",
      "palavras": [
        { "hebraico": "הִקְשַׁ֤בְתִּי", "transliteral": "hiq-šaḇ-tî", "traducao_palavra": "Escutei" },
