        { "hebraico": "אֵיכָ֤ה", "transliteral": "ʾê-ḵāh", "traducao_palavra": "Como" },
        { "hebraico": "תֹֽאמְרוּ֙", "transliteral": "ṯō-mə-rū", "traducao_palavra": "dizeis vós" },
