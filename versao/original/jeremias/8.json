  "versiculos": {
    "1": {
      "traducao_completa": "Naquele tempo, diz YHWH, tirarão os ossos dos reis de Judá, os ossos dos seus príncipes, os ossos dos sacerdotes, os ossos dos profetas e os ossos dos habitantes de Jerusalém, de suas sepulturas;",
      "palavras": [
        { "hebraico": "בָּעֵ֣ת", "transliteral": "bā-ʿēṯ", "traducao_palavra": "No tempo" },
        { "hebraico": "הַהִ֡יא", "transliteral": "ha-hî", "traducao_palavra": "aquele" },
        { "hebraico": "נְאֻם־יְהוָ֗ה", "transliteral": "nə-ʾum-YHWH", "traducao_palavra": "diz YHWH" },
        { "hebraico": "יוציאו", "transliteral": "yō-w-ṣî-ʾū", "traducao_palavra": "tirarão/farão sair [Qere: yō-w-ṣî-ʾū]" },
        { "hebraico": "אֶת־עַצְמֹ֣ות", "transliteral": "ʾeṯ-ʿaṣ-mō-wṯ", "traducao_palavra": "os ossos de" },
        { "hebraico": "מַלְכֵי־יְהוּדָ֣ה", "transliteral": "mal-ḵê-Yə-hū-ḏāh", "traducao_palavra": "reis de Judá" },
        { "hebraico": "וְאֶת־עַצְמֹֽות־שָׂרָיו", "transliteral": "wə-ʾeṯ-ʿaṣ-mō-wṯ-śā-rāy-w", "traducao_palavra": "e os ossos dos seus príncipes" },
        { "hebraico": "וְאֶת־עַצְמֹ֨ות", "transliteral": "wə-ʾeṯ-ʿaṣ-mō-wṯ", "traducao_palavra": "e os ossos de" },
        { "hebraico": "הַכֹּהֲנִ֜ים", "transliteral": "hak-kō-hă-nîm", "traducao_palavra": "os sacerdotes" },
        { "hebraico": "וְאֵת֙", "transliteral": "wə-ʾêṯ", "traducao_palavra": "e" },
        { "hebraico": "עַצְמֹ֣ות", "transliteral": "ʿaṣ-mō-wṯ", "traducao_palavra": "ossos de" },
        { "hebraico": "הַנְּבִיאִ֔ים", "transliteral": "han-nə-ḇî-ʾîm", "traducao_palavra": "os profetas" },
        { "hebraico": "וְאֵ֛ת", "transliteral": "wə-ʾêṯ", "traducao_palavra": "e" },
        { "hebraico": "עַצְמֹ֥ות", "transliteral": "ʿaṣ-mō-wṯ", "traducao_palavra": "ossos de" },
        { "hebraico": "יֹושְׁבֵֽי־יְרוּשָׁלַ֖͏ִם", "transliteral": "yō-šə-ḇê-Yə-rū-šā-la-im", "traducao_palavra": "habitantes de Jerusalém" },
        { "hebraico": "מִקִּבְרֵיהֶֽם׃", "transliteral": "miq-qiḇ-rê-hem", "traducao_palavra": "das sepulturas deles." }
      ]
    },
    "2": {
      "traducao_completa": "E os espalharão perante o sol, e a lua, e todo o exército do céu, a quem amaram, e a quem serviram, e após quem andaram, e a quem buscaram, e perante quem se encurvaram; não serão recolhidos nem enterrados; serão como esterco sobre a face da terra.",
      "palavras": [
        { "hebraico": "וּשְׁטָח֞וּם", "transliteral": "ū-šə-ṭā-ḥūm", "traducao_palavra": "E os espalharão" },
        { "hebraico": "לַשֶּׁ֣מֶשׁ", "transliteral": "laš-še-meš", "traducao_palavra": "perante o sol" },
        { "hebraico": "וְלַיָּרֵ֗חַ", "transliteral": "wə-lay-yā-rē-aḥ", "traducao_palavra": "e perante a lua" },
        { "hebraico": "וּלְכֹל֙", "transliteral": "ū-lə-ḵōl", "traducao_palavra": "e perante todo" },
        { "hebraico": "צְבָ֣א", "transliteral": "ṣə-ḇā", "traducao_palavra": "o exército de" },
        { "hebraico": "הַשָּׁמַ֔יִם", "transliteral": "haš-šā-ma-yim", "traducao_palavra": "os céus" },
        { "hebraico": "אֲשֶׁ֣ר", "transliteral": "ʾă-šer", "traducao_palavra": "os quais" },
        { "hebraico": "אֲהֵב֗וּם", "transliteral": "ʾă-hê-ḇūm", "traducao_palavra": "amaram eles" },
        { "hebraico": "וַאֲשֶׁ֤ר", "transliteral": "wa-ʾă-šer", "traducao_palavra": "e os quais" },
        { "hebraico": "עֲבָדּוּם֙", "transliteral": "ʿă-ḇā-ḏūm", "traducao_palavra": "serviram eles" },
        { "hebraico": "וַאֲשֶׁר֙", "transliteral": "wa-ʾă-šer", "traducao_palavra": "e os quais" },
        { "hebraico": "הָלְכ֣וּ", "transliteral": "hā-lə-ḵū", "traducao_palavra": "andaram" },
        { "hebraico": "אַחֲרֵיהֶ֔ם", "transliteral": "ʾa-ḥă-rê-hem", "traducao_palavra": "após eles" },
        { "hebraico": "וַאֲשֶׁ֣ר", "transliteral": "wa-ʾă-šer", "traducao_palavra": "e os quais" },
        { "hebraico": "דְּרָשׁ֔וּם", "transliteral": "də-rā-šūm", "traducao_palavra": "buscaram eles" },
        { "hebraico": "וַאֲשֶׁ֥ר", "transliteral": "wa-ʾă-šer", "traducao_palavra": "e perante os quais" },
        { "hebraico": "הִשְׁתַּחֲוּ֖וּ", "transliteral": "hiš-ta-ḥă-wwū", "traducao_palavra": "se prostraram" },
        { "hebraico": "לָהֶ֑ם", "transliteral": "lā-hem", "traducao_palavra": "a eles" },
        { "hebraico": "לֹ֤א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "יֵאָסְפוּ֙", "transliteral": "yê-ʾā-śə-p̄ū", "traducao_palavra": "serão recolhidos" },
        { "hebraico": "וְלֹ֣א", "transliteral": "wə-lō", "traducao_palavra": "nem" },
        { "hebraico": "יִקָּבֵ֔רוּ", "transliteral": "yiq-qā-ḇê-rū", "traducao_palavra": "serão enterrados" },
        { "hebraico": "לְדֹ֛מֶן", "transliteral": "lə-ḏō-men", "traducao_palavra": "em esterco" },
        { "hebraico": "עַל־פְּנֵ֥י", "transliteral": "ʿal-pə-nê", "traducao_palavra": "sobre a face de" },
        { "hebraico": "הָאֲדָמָ֖ה", "transliteral": "hā-ʾă-ḏā-māh", "traducao_palavra": "a terra" },
