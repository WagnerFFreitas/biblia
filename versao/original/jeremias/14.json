    "6": {
      "traducao_completa": "E os jumentos monteses paravam nos lugares altos, sorvendo o vento como os chacais; os seus olhos falhavam, por não haver erva.",
      "palavras": [
        { "hebraico": "וּפְרָאִים֙", "transliteral": "ū-p̄ə-rā-ʾîm", "traducao_palavra": "E jumentos monteses" },
