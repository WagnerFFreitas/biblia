        { "hebraico": "נָטָ֥ה", "transliteral": "nā-ṭāh", "traducao_palavra": "[que] se desvia/inclina" },
        { "hebraico": "לָלֽוּן׃", "transliteral": "lā-lūn", "traducao_palavra": "para pernoitar." }
      ]
