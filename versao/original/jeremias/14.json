        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "רָצָ֔ם", "transliteral": "rā-ṣām", "traducao_palavra": "agradou-se deles" },
        { "hebraico": "עַתָּה֙", "transliteral": "ʿat-tāh", "traducao_palavra": "agora" },
