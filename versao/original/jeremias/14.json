        { "hebraico": "בְקִרְבֵּ֙נוּ֙", "transliteral": "ḇə-qir-bê-nū", "traducao_palavra": "no nosso meio [estás]" },
        { "hebraico": "יְהוָ֔ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "וְשִׁמְךָ֕", "transliteral": "wə-šim-ḵā", "traducao_palavra": "e o teu nome" },
        { "hebraico": "עָלֵ֥ינוּ", "transliteral": "ʿā-lê-nū", "traducao_palavra": "sobre nós" },
