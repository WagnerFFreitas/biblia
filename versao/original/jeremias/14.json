        { "hebraico": "וְאַדִּירֵיהֶ֖ם", "transliteral": "wə-ʾad-dî-rê-hem", "traducao_palavra": "E os nobres/poderosos deles" },
        { "hebraico": "שָׁלְח֥וּ", "transliteral": "šāl-ḥū", "traducao_palavra": "enviaram" },
        { "hebraico": "צעוריהם", "transliteral": "ṣə-ʿî-rê-hem", "traducao_palavra": "os seus pequenos/servos [Qere: ṣə-ʿî-rê-hem]" },
        { "hebraico": "לַמָּ֑יִם", "transliteral": "lam-mā-yim", "traducao_palavra": "às águas" },
        { "hebraico": "בָּ֣אוּ", "transliteral": "bā-ʾū", "traducao_palavra": "vieram" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "para" },
