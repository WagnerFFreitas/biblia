    "9": {
      "traducao_completa": "Por que serias como um homem espantado, como um valente que não pode salvar? Mas tu estás no meio de nós, ó YHWH, e o teu nome é chamado sobre nós; não nos desampares.",
      "palavras": [
        { "hebraico": "לָ֤מָּה", "transliteral": "lām-māh", "traducao_palavra": "Por que" },
        { "hebraico": "תִהְיֶה֙", "transliteral": "ṯih-yeh", "traducao_palavra": "serias tu" },
        { "hebraico": "כְּאִ֣ישׁ", "transliteral": "kə-ʾîš", "traducao_palavra": "como homem" },
