        { "hebraico": "לָנ֔וּעַ", "transliteral": "lā-nū-aʿ", "traducao_palavra": "errar/vagar" },
        { "hebraico": "רַגְלֵיהֶ֖ם", "transliteral": "raḡ-lê-hem", "traducao_palavra": "os pés deles" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "חָשָׂ֑כוּ", "transliteral": "ḥā-śā-ḵū", "traducao_palavra": "pouparem/reterem" },
