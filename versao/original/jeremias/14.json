        { "hebraico": "וְחָפְתּ֥וּ", "transliteral": "wə-ḥā-p̄ə-ṯū", "traducao_palavra": "e cobriram" },
        { "hebraico": "רֹאשָֽׁם׃", "transliteral": "rō-šām", "traducao_palavra": "cabeça deles." }
      ]
    },
    "4": {
      "traducao_completa": "Por causa da terra que se fendeu, pois não houve chuva na terra, os lavradores se envergonharam e cobriram as suas cabeças.",
      "palavras": [
