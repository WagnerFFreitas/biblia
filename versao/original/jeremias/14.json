        { "hebraico": "לָעָ֣ם", "transliteral": "lā-ʿām", "traducao_palavra": "para o povo" },
        { "hebraico": "הַזֶּ֗ה", "transliteral": "haz-zeh", "traducao_palavra": "este" },
