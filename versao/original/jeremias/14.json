        { "hebraico": "כְלֵיהֶם֙", "transliteral": "ḵə-lê-hem", "traducao_palavra": "[com] os seus vasos" },
        { "hebraico": "רֵיקָ֔ם", "transliteral": "rê-qām", "traducao_palavra": "vazios" },
