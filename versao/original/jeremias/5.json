        { "hebraico": "מֵאֲנ֖וּ", "transliteral": "mê-ʾă-nū", "traducao_palavra": "recusaram" },
        { "hebraico": "לָשּֽׁוּב׃", "transliteral": "lā-šūḇ", "traducao_palavra": "voltar." }
      ]
    },
    "4": {
      "traducao_completa": "E eu disse: Deveras estes são pobres; são insensatos, pois não conhecem o caminho de YHWH, nem o juízo do seu Deus.",
