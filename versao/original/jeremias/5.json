        { "hebraico": "הֲלֹ֣וא", "transliteral": "hă-lō-w", "traducao_palavra": "acaso não" },
        { "hebraico": "לֶאֱמוּנָה֒", "transliteral": "le-ʾĕ-mū-nāh", "traducao_palavra": "para a fidelidade?" },
        { "hebraico": "הִכִּיתָה", "transliteral": "hik-kî-ṯāh", "traducao_palavra": "Tu feriste" },
        { "hebraico": "אֹותָם֙", "transliteral": "ʾō-w-ṯām", "traducao_palavra": "eles" },
        { "hebraico": "וְלֹא־", "transliteral": "wə-lō-", "traducao_palavra": "e não" },
        { "hebraico": "חָ֔לוּ", "transliteral": "ḥā-lū", "traducao_palavra": "sentiram dor" },
