        { "hebraico": "הַעַל־אֵ֥לֶּה", "transliteral": "ha-ʿal-ʾēl-leh", "traducao_palavra": "Acaso por estas [coisas]" },
        { "hebraico": "לֹֽוא־אֶפְקֹ֖ד", "transliteral": "lō-w-ʾep̄-qōḏ", "traducao_palavra": "não visitarei/castigarei?" },
        { "hebraico": "נְאֻם־יְהוָ֑ה", "transliteral": "nə-ʾum-YHWH", "traducao_palavra": "diz YHWH" },
        { "hebraico": "וְאִם֙", "transliteral": "wə-ʾim", "traducao_palavra": "e se" },
        { "hebraico": "בְּגֹ֣וי", "transliteral": "bə-ḡō-wy", "traducao_palavra": "de nação" },
        { "hebraico": "אֲשֶׁר־כָּזֶ֔ה", "transliteral": "ʾă-šer-kā-zeh", "traducao_palavra": "que [seja] como esta" },
        { "hebraico": "לֹ֥א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "תִתְנַקֵּ֖ם", "transliteral": "tiṯ-naq-qêm", "traducao_palavra": "se vingará" },
        { "hebraico": "נַפְשִֽׁי׃", "transliteral": "nap̄-šî", "traducao_palavra": "minha alma?" }
      ]
    },
    "10": {
      "traducao_completa": "Subi aos seus muros e destruí; mas não façais um extermínio completo; tirai as suas ramadas, porque não são de YHWH.",
      "palavras": [
        { "hebraico": "עֲל֤וּ", "transliteral": "ʿă-lū", "traducao_palavra": "Subi" },
