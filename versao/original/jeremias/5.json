        { "hebraico": "מוּסָ֑ר", "transliteral": "mū-śār", "traducao_palavra": "correção/instrução" },
        { "hebraico": "חִזְּק֤וּ", "transliteral": "ḥiz-zə-qū", "traducao_palavra": "endureceram" },
        { "hebraico": "פְנֵיהֶם֙", "transliteral": "p̄ə-nê-hem", "traducao_palavra": "suas faces" },
