        { "hebraico": "יֹורֶ֧ה", "transliteral": "yō-w-reh", "traducao_palavra": "[a] temporã" },
        { "hebraico": "וּמַלְקֹ֛ושׁ", "transliteral": "ū-mal-qō-wš", "traducao_palavra": "e a tardia" },
        { "hebraico": "בְּעִתֹּ֑ו", "transliteral": "bə-ʿit-tō-w", "traducao_palavra": "no seu tempo" },
        { "hebraico": "שְׁבֻעֹ֛ות", "transliteral": "šə-ḇu-ʿō-wṯ", "traducao_palavra": "semanas de" },
        { "hebraico": "חֻקֹּ֥ות", "transliteral": "ḥuq-qō-wṯ", "traducao_palavra": "estatutos/determinadas de" },
