        { "hebraico": "לִּ֧י", "transliteral": "lî", "traducao_palavra": "eu" },
        { "hebraico": "אֶל־", "transliteral": "ʾel-", "traducao_palavra": "para" },
        { "hebraico": "הַגְּדֹלִים", "transliteral": "hag-gə-ḏō-lîm", "traducao_palavra": "os grandes" },
