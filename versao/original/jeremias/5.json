        { "hebraico": "כָּל־", "transliteral": "kāl-", "traducao_palavra": "todo aquele" },
        { "hebraico": "הַיֹּוצֵ֥א", "transliteral": "hay-yō-w-ṣê", "traducao_palavra": "que sair" },
        { "hebraico": "מֵהֵ֖נָּה", "transliteral": "mê-hên-nāh", "traducao_palavra": "delas" },
