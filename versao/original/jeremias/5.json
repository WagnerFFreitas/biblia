        { "hebraico": "רֵעֵ֖הוּ", "transliteral": "rē-ʿê-hū", "traducao_palavra": "seu próximo" },
        { "hebraico": "יִצְהָֽלוּ׃", "transliteral": "yiṣ-hā-lū", "traducao_palavra": "relincham." }
      ]
    },
    "9": {
      "traducao_completa": "Acaso não visitaria eu por estas coisas? diz YHWH; ou da tal nação como esta não se vingaria a minha alma?",
