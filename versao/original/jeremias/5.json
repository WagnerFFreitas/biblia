        { "hebraico": "אִם־", "transliteral": "ʾim-", "traducao_palavra": "se" },
        { "hebraico": "תִּמְצְא֣וּ", "transliteral": "tim-ṣə-ʾū", "traducao_palavra": "achardes" },
        { "hebraico": "אִ֔ישׁ", "transliteral": "ʾîš", "traducao_palavra": "um homem" },
