        { "hebraico": "יָתֹ֖ום", "transliteral": "yā-ṯō-wm", "traducao_palavra": "órfão" },
        { "hebraico": "וְיַצְלִ֑יחוּ", "transliteral": "wə-yaṣ-lî-ḥū", "traducao_palavra": "para que prosperassem" },
        { "hebraico": "וּמִשְׁפַּ֥ט", "transliteral": "ū-miš-paṭ", "traducao_palavra": "e o juízo/direito de" },
        { "hebraico": "אֶבְיֹונִ֖ים", "transliteral": "ʾeḇ-yō-w-nîm", "traducao_palavra": "pobres/necessitados" },
