    "7": {
      "traducao_completa": "Como te perdoaria eu por isto? Teus filhos me deixaram e juram pelos que não são deuses; quando os fartei, eles adulteraram, e em casa de prostitutas se ajuntaram em bandos.",
      "palavras": [
        { "hebraico": "אֵי֙", "transliteral": "ʾê", "traducao_palavra": "Como?" },
        { "hebraico": "לָזֹ֣את", "transliteral": "lā-zōṯ", "traducao_palavra": "por isto" },
        { "hebraico": "אֶסְלַח־", "transliteral": "ʾeś-laḥ-", "traducao_palavra": "perdoaria eu" },
        { "hebraico": "לָ֔ךְ", "transliteral": "lāḵ", "traducao_palavra": "a ti?" },
        { "hebraico": "בָּנַ֙יִךְ֙", "transliteral": "bā-na-yiḵ", "traducao_palavra": "teus filhos" },
        { "hebraico": "עֲזָב֔וּנִי", "transliteral": "ʿă-zā-ḇū-nî", "traducao_palavra": "deixaram-me" },
        { "hebraico": "וַיִּשָּׁבְע֖וּ", "transliteral": "way-yiš-šā-ḇə-ʿū", "traducao_palavra": "e juraram" },
        { "hebraico": "בְּלֹ֣א", "transliteral": "bə-lō", "traducao_palavra": "por [o que] não" },
        { "hebraico": "אֱלֹהִ֑ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "[são] deuses" },
        { "hebraico": "וָאַשְׂבִּ֤עַ", "transliteral": "wā-ʾaś-bi-aʿ", "traducao_palavra": "e [quando] os fartei" },
        { "hebraico": "אֹותָם֙", "transliteral": "ʾō-w-ṯām", "traducao_palavra": "eles" },
        { "hebraico": "וַיִּנְאָ֔פוּ", "transliteral": "way-yin-ʾā-p̄ū", "traducao_palavra": "adulteraram" },
        { "hebraico": "וּבֵ֥ית", "transliteral": "ū-ḇêṯ", "traducao_palavra": "e na casa de" },
        { "hebraico": "זֹונָ֖ה", "transliteral": "zō-w-nāh", "traducao_palavra": "prostituta" },
        { "hebraico": "יִתְגֹּודָֽדוּ׃", "transliteral": "yiṯ-gō-w-ḏā-ḏū", "traducao_palavra": "ajuntaram-se em bandos." }
      ]
    },
    "8": {
      "traducao_completa": "Como cavalos bem fartos andam eles de manhã; cada um relincha à mulher do seu próximo.",
      "palavras": [
        { "hebraico": "סוּסִ֥ים", "transliteral": "śū-śîm", "traducao_palavra": "Cavalos" },
        { "hebraico": "מְיֻזָּנִ֖ים", "transliteral": "mə-yuz-zā-nîm", "traducao_palavra": "bem alimentados/fartos" },
        { "hebraico": "מַשְׁכִּ֣ים", "transliteral": "maš-kîm", "traducao_palavra": "pela manhã [andando]" },
        { "hebraico": "הָי֑וּ", "transliteral": "hā-yū", "traducao_palavra": "foram/eram" },
        { "hebraico": "אִ֚ישׁ", "transliteral": "ʾîš", "traducao_palavra": "cada um" },
