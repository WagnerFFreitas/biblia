    "6": {
      "traducao_completa": "Por isso um leão do bosque os feriu, um lobo das estepes os assolará; um leopardo vigia contra as suas cidades; qualquer que sair delas será despedaçado; porque as suas transgressões se multiplicaram, as suas rebeldias se fortaleceram.",
      "palavras": [
        { "hebraico": "עַל־כֵּן֩", "transliteral": "ʿal-kên", "traducao_palavra": "Por isso" },
        { "hebraico": "הִכָּ֨ם", "transliteral": "hik-kām", "traducao_palavra": "feriu eles" },
        { "hebraico": "אַרְיֵ֜ה", "transliteral": "ʾar-yēh", "traducao_palavra": "[um] leão" },
