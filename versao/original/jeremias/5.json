        { "hebraico": "אֲנָשִׁ֥ים", "transliteral": "ʾă-nā-šîm", "traducao_palavra": "homens" },
        { "hebraico": "יְלַכֵּֽדוּ׃", "transliteral": "yə-lak-kê-ḏū", "traducao_palavra": "eles caçam." }
      ]
    },
    "27": {
      "traducao_completa": "Como a gaiola cheia de aves, assim as suas casas estão cheias de engano; por isso se engrandeceram e enriqueceram.",
