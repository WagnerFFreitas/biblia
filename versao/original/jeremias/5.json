  "versiculos": {
    "1": {
      "traducao_completa": "Percorrei as ruas de Jerusalém, e vede agora, e sabei, e buscai pelas suas praças, se achardes um homem, se houver quem pratique o juízo, que busque a fidelidade; e eu lhe perdoarei.",
      "palavras": [
        { "hebraico": "שֹׁוטְט֞וּ", "transliteral": "šō-w-ṭə-ṭū", "traducao_palavra": "Percorrei/Correi de um lado para outro" },
        { "hebraico": "בְּחוּצֹ֣ות", "transliteral": "bə-ḥū-ṣō-wṯ", "traducao_palavra": "pelas ruas de" },
        { "hebraico": "יְרוּשָׁלַ͏ִם֮", "transliteral": "Yə-rū-šā-la-im", "traducao_palavra": "Jerusalém" },
        { "hebraico": "וּרְאוּ־", "transliteral": "ū-rə-ʾū-", "traducao_palavra": "e vede" },
