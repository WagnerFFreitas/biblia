        { "hebraico": "עַל־כֵּ֥ן", "transliteral": "ʿal-kên", "traducao_palavra": "por isso" },
        { "hebraico": "גָּדְל֖וּ", "transliteral": "gā-ḏə-lū", "traducao_palavra": "engrandeceram-se" },
