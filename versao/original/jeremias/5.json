        { "hebraico": "יֹאמֵ֑רוּ", "transliteral": "yō-mē-rū", "traducao_palavra": "eles digam" },
        { "hebraico": "לָכֵ֥ן", "transliteral": "lā-ḵēn", "traducao_palavra": "certamente/por isso" },
