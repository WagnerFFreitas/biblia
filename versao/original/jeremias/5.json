        { "hebraico": "תִתְנַקֵּ֖ם", "transliteral": "tiṯ-naq-qêm", "traducao_palavra": "se vingará" },
        { "hebraico": "נַפְשִֽׁי׃", "transliteral": "nap̄-šî", "traducao_palavra": "minha alma?" }
      ]
