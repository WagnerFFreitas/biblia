    "12": {
      "traducao_completa": "E as suas casas passarão a outros, juntamente com as suas herdades e as suas mulheres; porque estenderei a minha mão contra os habitantes da terra, diz YHWH.",
      "palavras": [
        { "hebraico": "וְנָסַ֨בּוּ", "transliteral": "wə-nā-śab-bū", "traducao_palavra": "E passarão/girarão" },
        { "hebraico": "בָתֵּיהֶ֜ם", "transliteral": "bāt-tê-hem", "traducao_palavra": "suas casas" },
