        { "hebraico": "בּור", "transliteral": "bayir", "traducao_palavra": "[uma] fonte [Qere: ba-yir]" },
        { "hebraico": "מֵימֶיהָ", "transliteral": "mê-me-hā", "traducao_palavra": "[as] águas dela" },
        { "hebraico": "כֵּ֖ן", "transliteral": "kên", "traducao_palavra": "assim" },
        { "hebraico": "הֵקֵ֣ירָה", "transliteral": "hē-qê-rāh", "traducao_palavra": "ela emitiu/fez brotar" },
        { "hebraico": "רָעָתָ֑הּ", "transliteral": "rā-ʿā-ṯāh", "traducao_palavra": "sua maldade" },
        { "hebraico": "חָמָ֨ס", "transliteral": "ḥā-mās", "traducao_palavra": "violência" },
