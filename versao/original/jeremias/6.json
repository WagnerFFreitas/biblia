        { "hebraico": "שָׁמַ֥עְנוּ", "transliteral": "šā-ma-ʿnū", "traducao_palavra": "Ouvimos" },
        { "hebraico": "אֶת־", "transliteral": "ʾeṯ-", "traducao_palavra": "[partícula acusativa]" },
        { "hebraico": "שָׁמְעֹ֖ו", "transliteral": "šām-ʿō-w", "traducao_palavra": "sua fama/relato" },
        { "hebraico": "רָפ֣וּ", "transliteral": "rā-p̄ū", "traducao_palavra": "afrouxaram-se" },
