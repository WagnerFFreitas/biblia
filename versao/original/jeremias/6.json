    "13": {
      "traducao_completa": "Porque desde o menor deles até ao maior, cada um se dá à ganância; e desde o profeta até ao sacerdote, cada um procede falsamente.",
      "palavras": [
        { "hebraico": "כִּ֤י", "transliteral": "kî", "traducao_palavra": "Porque" },
        { "hebraico": "מִקְּטַנָּם֙", "transliteral": "miq-qə-ṭan-nām", "traducao_palavra": "desde o menor deles" },
        { "hebraico": "וְעַד־גְּדֹולָ֔ם", "transliteral": "wə-ʿaḏ-gə-ḏō-w-lām", "traducao_palavra": "e até o maior deles" },
        { "hebraico": "כֻּלֹּ֖ו", "transliteral": "kul-lō-w", "traducao_palavra": "cada um deles" },
        { "hebraico": "בֹּוצֵ֣עַ", "transliteral": "bō-w-ṣê-aʿ", "traducao_palavra": "[se dá à] ganância" },
        { "hebraico": "בָּ֑צַע", "transliteral": "bā-ṣa-ʿ", "traducao_palavra": "lucro/ganância" },
        { "hebraico": "וּמִנָּבִיא֙", "transliteral": "ū-min-nā-ḇî", "traducao_palavra": "e desde o profeta" },
        { "hebraico": "וְעַד־כֹּהֵ֔ן", "transliteral": "wə-ʿaḏ-kō-hên", "traducao_palavra": "e até o sacerdote" },
        { "hebraico": "כֻּלֹּ֖ו", "transliteral": "kul-lō-w", "traducao_palavra": "cada um dele" },
        { "hebraico": "עֹ֥שֶׂה", "transliteral": "ʿō-śeh", "traducao_palavra": "pratica" },
        { "hebraico": "שָּֽׁקֶר׃", "transliteral": "šā-qer", "traducao_palavra": "falsidade/mentira." }
      ]
    },
    "14": {
      "traducao_completa": "E curam a ferida da filha do meu povo levianamente, dizendo: Paz, paz; quando não há paz.",
      "palavras": [
        { "hebraico": "וַיְרַפְּא֞וּ", "transliteral": "way-rap-pə-ʾū", "traducao_palavra": "E curaram" },
        { "hebraico": "אֶת־שֶׁ֤בֶר", "transliteral": "ʾeṯ-še-ḇer", "traducao_palavra": "o quebrantamento/ferida de" },
        { "hebraico": "עַמִּי֙", "transliteral": "ʿam-mî", "traducao_palavra": "meu povo" },
        { "hebraico": "עַל־קַלָּ֔ה", "transliteral": "ʿal-qal-lāh", "traducao_palavra": "sobre leviandade/superficialmente" },
        { "hebraico": "לֵאמֹ֖ר", "transliteral": "lē-ʾmōr", "traducao_palavra": "dizendo" },
        { "hebraico": "שָׁלֹ֣ום", "transliteral": "šā-lō-wm", "traducao_palavra": "Paz" },
        { "hebraico": "שָׁלֹ֑ום", "transliteral": "šā-lō-wm", "traducao_palavra": "paz" },
        { "hebraico": "וְאֵ֥ין", "transliteral": "wə-ʾên", "traducao_palavra": "e não [há]" },
        { "hebraico": "שָׁלֹֽום׃", "transliteral": "šā-lō-wm", "traducao_palavra": "paz." }
      ]
    },
    "15": {
      "traducao_completa": "Porventura envergonharam-se por cometerem abominação? Pelo contrário, de maneira nenhuma se envergonharam, nem souberam que coisa é envergonhar-se; portanto cairão entre os que caem; no tempo em que eu os visitar, tropeçarão, diz YHWH.",
      "palavras": [
        { "hebraico": "הֹבִ֕ישׁוּ", "transliteral": "hō-ḇî-šū", "traducao_palavra": "Acaso envergonharam-se" },
        { "hebraico": "כִּ֥י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "תֹועֵבָ֖ה", "transliteral": "ṯō-w-ʿê-ḇāh", "traducao_palavra": "abominação" },
        { "hebraico": "עָשׂ֑וּ", "transliteral": "ʿā-śū", "traducao_palavra": "fizeram?" },
        { "hebraico": "גַּם־בֹּ֣ושׁ", "transliteral": "gam-bō-wš", "traducao_palavra": "também de vergonha" },
        { "hebraico": "לֹא־יֵבֹ֗ושׁוּ", "transliteral": "lō-yê-ḇō-w-šū", "traducao_palavra": "não se envergonharam" },
        { "hebraico": "גַּם־הִכָּלֵ֥ם", "transliteral": "gam-hik-kā-lêm", "traducao_palavra": "nem confundir-se" },
        { "hebraico": "לֹא־יָדָ֑עוּ", "transliteral": "lō-yā-ḏā-ʿū", "traducao_palavra": "não souberam" },
        { "hebraico": "לָכֵ֞ן", "transliteral": "lā-ḵēn", "traducao_palavra": "portanto" },
        { "hebraico": "יִפְּל֣וּ", "transliteral": "yip-pə-lū", "traducao_palavra": "cairão" },
        { "hebraico": "בַנֹּפְלִ֗ים", "transliteral": "ḇan-nō-p̄ə-lîm", "traducao_palavra": "entre os que caem" },
        { "hebraico": "בְּעֵת־פְּקַדְתִּ֥ים", "transliteral": "bə-ʿêṯ-pə-qaḏ-tîm", "traducao_palavra": "no tempo do meu visitá-los" },
        { "hebraico": "יִכָּשְׁל֖וּ", "transliteral": "yik-kā-šə-lū", "traducao_palavra": "tropeçarão" },
        { "hebraico": "אָמַ֥ר", "transliteral": "ʾā-mar", "traducao_palavra": "disse" },
