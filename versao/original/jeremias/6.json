        { "hebraico": "נָחַ֣ר", "transliteral": "nā-ḥar", "traducao_palavra": "Bufou/Queimou" },
        { "hebraico": "מַפֻּ֔חַ", "transliteral": "map-pu-aḥ", "traducao_palavra": "[o] fole" },
        { "hebraico": "מאשתם", "transliteral": "mē-ʾeš-tam", "traducao_palavra": "do fogo se consumiu [Qere: mē-ʾēš tam]" },
