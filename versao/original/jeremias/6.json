        { "hebraico": "וְשִׁפְכ֥וּ", "transliteral": "wə-šip̄-ḵū", "traducao_palavra": "e derramai/levantai" },
        { "hebraico": "עַל־יְרוּשָׁלַ֖͏ִם", "transliteral": "ʿal-yə-rū-šā-la-im", "traducao_palavra": "contra Jerusalém" },
