        { "hebraico": "עֲשִׂ֣י", "transliteral": "ʿă-śî", "traducao_palavra": "faze" },
        { "hebraico": "לָ֔ךְ", "transliteral": "lāḵ", "traducao_palavra": "para ti" },
        { "hebraico": "מִסְפַּ֖ד", "transliteral": "mis-paḏ", "traducao_palavra": "lamentação" },
        { "hebraico": "תַּמְרוּרִ֑ים", "transliteral": "tam-rū-rîm", "traducao_palavra": "[de] amarguras" },
        { "hebraico": "כִּ֣י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "פִתְאֹ֔ם", "transliteral": "piṯ-ʾōm", "traducao_palavra": "de repente" },
        { "hebraico": "יָבֹ֥א", "transliteral": "yā-ḇō", "traducao_palavra": "virá" },
