        { "hebraico": "כְּבֹוצֵ֖ר", "transliteral": "kə-ḇō-w-ṣêr", "traducao_palavra": "como vindimador" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre" },
