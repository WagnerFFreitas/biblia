    "19": {
      "traducao_completa": "Ouve, ó terra! Eis que eu trarei mal sobre este povo, o próprio fruto dos seus pensamentos; porque não atenderam às minhas palavras e rejeitaram a minha lei.",
      "palavras": [
        { "hebraico": "שִׁמְעִ֣י", "transliteral": "šim-ʿî", "traducao_palavra": "Ouve" },
        { "hebraico": "הָאָ֔רֶץ", "transliteral": "hā-ʾā-reṣ", "traducao_palavra": "ó terra" },
        { "hebraico": "הִנֵּ֨ה", "transliteral": "hin-nēh", "traducao_palavra": "Eis que" },
        { "hebraico": "אָנֹכִ֜י", "transliteral": "ʾā-nō-ḵî", "traducao_palavra": "eu" },
        { "hebraico": "מֵבִ֥יא", "transliteral": "mê-ḇî", "traducao_palavra": "trazendo" },
