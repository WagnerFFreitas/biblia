        { "hebraico": "מַשְׁחִיתִ֖ים", "transliteral": "maš-ḥî-ṯîm", "traducao_palavra": "corruptores" },
        { "hebraico": "הֵֽמָּה׃", "transliteral": "hêm-māh", "traducao_palavra": "eles [são]." }
      ]
    },
    "29": {
