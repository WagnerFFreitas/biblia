      ]
    },
    "26": {
      "traducao_completa": "Ó filha do meu povo, cinge-te de saco e revolve-te na cinza; faze luto como por um filho único, pranto de amarguras; porque de repente virá o destruidor sobre nós.",
      "palavras": [
        { "hebraico": "בַּת־עַמִּ֨י", "transliteral": "baṯ-ʿam-mî", "traducao_palavra": "Filha do meu povo" },
        { "hebraico": "חִגְרִי־", "transliteral": "ḥiḡ-rî-", "traducao_palavra": "cinge" },
        { "hebraico": "שַׂ֜ק", "transliteral": "śaq", "traducao_palavra": "saco" },
        { "hebraico": "וְהִתְפַּלְּשִׁ֣י", "transliteral": "wə-hiṯ-pal-lə-šî", "traducao_palavra": "e revolve-te/rola" },
        { "hebraico": "בָאֵ֗פֶר", "transliteral": "ḇā-ʾê-p̄er", "traducao_palavra": "na cinza" },
