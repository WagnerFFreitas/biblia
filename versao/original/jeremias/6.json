        { "hebraico": "וְעַל־", "transliteral": "wə-ʿal-", "traducao_palavra": "e sobre" },
        { "hebraico": "סוּסִ֖ים", "transliteral": "śū-śîm", "traducao_palavra": "cavalos" },
        { "hebraico": "יִרְכָּ֑בוּ", "transliteral": "yir-kā-ḇū", "traducao_palavra": "cavalgarão" },
        { "hebraico": "עָר֤וּךְ", "transliteral": "ʿā-rūḵ", "traducao_palavra": "posto em ordem" },
