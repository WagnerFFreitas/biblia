        { "hebraico": "ק֚וּמוּ", "transliteral": "qū-mū", "traducao_palavra": "Levantai-vos" },
        { "hebraico": "וְנַעֲלֶ֣ה", "transliteral": "wə-na-ʿă-leh", "traducao_palavra": "e subamos" },
        { "hebraico": "בַלָּ֑יְלָה", "transliteral": "ḇal-lā-yə-lāh", "traducao_palavra": "de noite" },
        { "hebraico": "וְנַשְׁחִ֖יתָה", "transliteral": "wə-naš-ḥî-ṯāh", "traducao_palavra": "e destruamos" },
        { "hebraico": "אַרְמְנֹותֶֽיהָ׃", "transliteral": "ʾar-mə-nō-w-ṯe-hā", "traducao_palavra": "seus palácios." }
