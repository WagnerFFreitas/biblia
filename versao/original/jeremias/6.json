        { "hebraico": "וּמַכָּֽה׃", "transliteral": "ū-mak-kāh", "traducao_palavra": "e ferida." }
      ]
    },
    "8": {
      "traducao_completa": "Corrige-te, ó Jerusalém, para que a minha alma não se aparte de ti; para que eu não te ponha em assolação, em terra não habitada.",
      "palavras": [
        { "hebraico": "הִוָּסְרִ֕י", "transliteral": "hiw-wā-śə-rî", "traducao_palavra": "Corrige-te/Aceita instrução" },
        { "hebraico": "יְרוּשָׁלַ֖͏ִם", "transliteral": "yə-rū-šā-la-im", "traducao_palavra": "ó Jerusalém" },
        { "hebraico": "פֶּן־תֵּקַ֥ע", "transliteral": "pen-tê-qa-ʿ", "traducao_palavra": "para que não se aparte/desloque" },
        { "hebraico": "נַפְשִׁ֖י", "transliteral": "nap̄-šî", "traducao_palavra": "minha alma" },
