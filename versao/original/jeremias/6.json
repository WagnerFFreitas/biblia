        { "hebraico": "מִיַּרְכְּתֵי־", "transliteral": "miy-yar-kə-ṯê-", "traducao_palavra": "das extremidades de" },
        { "hebraico": "אָֽרֶץ׃", "transliteral": "ʾā-reṣ", "traducao_palavra": "[a] terra." }
