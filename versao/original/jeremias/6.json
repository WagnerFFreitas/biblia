        { "hebraico": "יַחְדָּ֑ו", "transliteral": "yaḥ-dāw", "traducao_palavra": "juntamente" },
        { "hebraico": "כִּֽי־אַטֶּ֧ה", "transliteral": "kî-ʾaṭ-ṭeh", "traducao_palavra": "porque estenderei" },
        { "hebraico": "אֶת־יָדִ֛י", "transliteral": "ʾeṯ-yā-ḏî", "traducao_palavra": "a minha mão" },
        { "hebraico": "עַל־יֹשְׁבֵ֥י", "transliteral": "ʿal-yō-šə-ḇê", "traducao_palavra": "contra os moradores de" },
        { "hebraico": "הָאָ֖רֶץ", "transliteral": "hā-ʾā-reṣ", "traducao_palavra": "a terra" },
        { "hebraico": "נְאֻם־יְהוָֽה׃", "transliteral": "nə-ʾum-YHWH", "traducao_palavra": "diz YHWH." }
