        { "hebraico": "נַקְשִֽׁיב׃", "transliteral": "naq-šîḇ", "traducao_palavra": "atenderemos." }
      ]
    },
    "18": {
      "traducao_completa": "Portanto ouvi, nações, e conhece, ó congregação, o que há entre eles.",
