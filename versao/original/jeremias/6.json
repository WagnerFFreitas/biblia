    "30": {
      "traducao_completa": "Prata rejeitada lhes chamarão, porque YHWH os rejeitou.",
      "palavras": [
        { "hebraico": "כֶּ֥סֶף", "transliteral": "ke-sep̄", "traducao_palavra": "Prata" },
        { "hebraico": "נִמְאָ֖ס", "transliteral": "nim-ʾās", "traducao_palavra": "rejeitada" },
        { "hebraico": "קָ֣רְאוּ", "transliteral": "qā-rə-ʾū", "traducao_palavra": "chamaram" },
