    "23": {
      "traducao_completa": "Arco e lança segurarão; cruéis são, e não usarão de misericórdia; a sua voz bramará como o mar, e em cavalos cavalgarão, postos em ordem como homens de guerra contra ti, ó filha de Sião.",
      "palavras": [
        { "hebraico": "קֶ֣שֶׁת", "transliteral": "qe-šeṯ", "traducao_palavra": "Arco" },
        { "hebraico": "וְכִידֹ֞ון", "transliteral": "wə-ḵî-ḏō-wn", "traducao_palavra": "e lança/dardo" },
        { "hebraico": "יַחֲזִ֗יקוּ", "transliteral": "ya-ḥă-zî-qū", "traducao_palavra": "segurarão" },
        { "hebraico": "אַכְזָרִ֥י", "transliteral": "ʾaḵ-zā-rî", "traducao_palavra": "cruel" },
        { "hebraico": "ה֛וּא", "transliteral": "hū", "traducao_palavra": "ele [é]" },
        { "hebraico": "וְלֹ֣א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "יְרַחֵ֑מוּ", "transliteral": "yə-ra-ḥê-mū", "traducao_palavra": "terão misericórdia" },
        { "hebraico": "קֹולָם֙", "transliteral": "qō-w-lām", "traducao_palavra": "a voz deles" },
        { "hebraico": "כַּיָּ֣ם", "transliteral": "kay-yām", "traducao_palavra": "como o mar" },
