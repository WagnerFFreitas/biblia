        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre/a" },
        { "hebraico": "דְּבָרַי֙", "transliteral": "də-ḇā-ray", "traducao_palavra": "minhas palavras" },
