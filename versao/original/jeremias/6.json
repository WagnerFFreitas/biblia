        { "hebraico": "לָ֤מָּה־", "transliteral": "lām-māh-", "traducao_palavra": "Para que" },
        { "hebraico": "זֶּה", "transliteral": "zeh", "traducao_palavra": "isto" },
        { "hebraico": "לִּי֙", "transliteral": "lî", "traducao_palavra": "para mim" },
        { "hebraico": "לְבֹונָ֣ה", "transliteral": "lə-ḇō-w-nāh", "traducao_palavra": "incenso" },
        { "hebraico": "מִשְּׁבָ֣א", "transliteral": "miš-šə-ḇā", "traducao_palavra": "de Sabá" },
        { "hebraico": "תָבֹ֔וא", "transliteral": "ṯā-ḇō-w", "traducao_palavra": "virá" },
        { "hebraico": "וְקָנֶ֥ה", "transliteral": "wə-qā-neh", "traducao_palavra": "e cana" },
        { "hebraico": "הַטֹּ֖וב", "transliteral": "haṭ-ṭō-wḇ", "traducao_palavra": "a boa/doce" },
