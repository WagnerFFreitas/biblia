    },
    "10": {
      "traducao_completa": "A quem falarei e testemunharei, para que ouçam? Eis que os seus ouvidos estão incircuncisos, e não podem ouvir; eis que a palavra de YHWH é para eles coisa vergonhosa; não gostam dela.",
      "palavras": [
        { "hebraico": "עַל־מִ֨י", "transliteral": "ʿal-mî", "traducao_palavra": "Sobre quem" },
        { "hebraico": "אֲדַבְּרָ֜ה", "transliteral": "ʾă-ḏab-bə-rāh", "traducao_palavra": "falarei" },
        { "hebraico": "וְאָעִ֗ידָה", "transliteral": "wə-ʾā-ʿî-ḏāh", "traducao_palavra": "e testemunharei" },
        { "hebraico": "וְיִשְׁמָ֑עוּ", "transliteral": "wə-yiš-mā-ʿū", "traducao_palavra": "para que ouçam?" },
