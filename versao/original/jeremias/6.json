        { "hebraico": "פְּרִ֣י", "transliteral": "pə-rî", "traducao_palavra": "fruto de" },
        { "hebraico": "מַחְשְׁבֹותָ֑ם", "transliteral": "maḥ-šə-ḇō-w-ṯām", "traducao_palavra": "seus pensamentos" },
