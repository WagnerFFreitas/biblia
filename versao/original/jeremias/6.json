    "2": {
      "traducao_completa": "À formosa e delicada, à filha de Sião, eu assemelhei.",
      "palavras": [
        { "hebraico": "הַנָּוָה֙", "transliteral": "han-nā-wāh", "traducao_palavra": "A formosa" },
        { "hebraico": "וְהַמְּעֻנָּגָ֔ה", "transliteral": "wə-ham-mə-ʿun-nā-ḡāh", "traducao_palavra": "e a delicada" },
        { "hebraico": "דָּמִ֖יתִי", "transliteral": "dā-mî-ṯî", "traducao_palavra": "eu assemelhei/destruirei [raiz dupla]" },
        { "hebraico": "בַּת־צִיֹּֽון׃", "transliteral": "baṯ-ṣiy-yō-wn", "traducao_palavra": "filha de Sião." }
      ]
    },
    "3": {
      "traducao_completa": "A ela virão pastores com os seus rebanhos; armarão contra ela tendas em redor; cada um apascentará no seu lugar.",
