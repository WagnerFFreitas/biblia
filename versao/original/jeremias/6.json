      ]
    },
    "4": {
      "traducao_completa": "Santificai a guerra contra ela; levantai-vos, e subamos ao meio-dia. Ai de nós! que já declina o dia, que já se estendem as sombras da tarde.",
      "palavras": [
        { "hebraico": "קַדְּשׁ֤וּ", "transliteral": "qad-də-šū", "traducao_palavra": "Santificai/Preparai" },
        { "hebraico": "עָלֶ֙יהָ֙", "transliteral": "ʿā-le-hā", "traducao_palavra": "contra ela" },
        { "hebraico": "מִלְחָמָ֔ה", "transliteral": "mil-ḥā-māh", "traducao_palavra": "guerra" },
        { "hebraico": "ק֖וּמוּ", "transliteral": "qū-mū", "traducao_palavra": "Levantai-vos" },
