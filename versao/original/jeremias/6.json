      ]
    },
    "25": {
      "traducao_completa": "Não saiais ao campo, nem andeis pelo caminho; porque a espada do inimigo e o terror estão em redor.",
      "palavras": [
        { "hebraico": "אַל־", "transliteral": "ʾal-", "traducao_palavra": "Não" },
        { "hebraico": "תֵּצְא֣וּ", "transliteral": "tê-ṣə-ʾū", "traducao_palavra": "saiais [ao]" },
        { "hebraico": "הַשָּׂדֶ֔ה", "transliteral": "haś-śā-ḏeh", "traducao_palavra": "campo" },
        { "hebraico": "וּבַדֶּ֖רֶךְ", "transliteral": "ū-ḇad-de-reḵ", "traducao_palavra": "e pelo caminho" },
        { "hebraico": "אַל־", "transliteral": "ʾal-", "traducao_palavra": "não" },
        { "hebraico": "תֵּלֵ֑כוּ", "transliteral": "tê-lê-ḵū", "traducao_palavra": "andeis" },
