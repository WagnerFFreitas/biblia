        { "hebraico": "אֶ֖רֶץ", "transliteral": "ʾe-reṣ", "traducao_palavra": "terra" },
        { "hebraico": "לֹ֥וא", "transliteral": "lō-w", "traducao_palavra": "não" },
        { "hebraico": "נֹושָֽׁבָה׃", "transliteral": "nō-w-šā-ḇāh", "traducao_palavra": "habitada." }
      ]
    },
    "9": {
      "traducao_completa": "Assim diz YHWH dos Exércitos: Diligentemente rabiscarão o remanescente de Israel como uma vinha; torna a passar a tua mão, como o vindimador, pelos cestos.",
      "palavras": [
        { "hebraico": "כֹּ֤ה", "transliteral": "kōh", "traducao_palavra": "Assim" },
