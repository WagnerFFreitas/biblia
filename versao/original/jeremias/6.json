        { "hebraico": "לָכֵ֣ן", "transliteral": "lā-ḵēn", "traducao_palavra": "Portanto" },
        { "hebraico": "שִׁמְע֣וּ", "transliteral": "šim-ʿū", "traducao_palavra": "ouvi" },
        { "hebraico": "הַגֹּויִ֑ם", "transliteral": "hag-gō-w-yim", "traducao_palavra": "ó nações" },
        { "hebraico": "וּדְעִ֥י", "transliteral": "ū-ḏə-ʿî", "traducao_palavra": "e conhece" },
        { "hebraico": "עֵדָ֖ה", "transliteral": "ʿê-ḏāh", "traducao_palavra": "ó congregação" },
        { "hebraico": "אֶת־", "transliteral": "ʾeṯ-", "traducao_palavra": "[partícula acusativa]" },
