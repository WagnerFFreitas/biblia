        { "hebraico": "עַל־פָּנַ֧י", "transliteral": "ʿal-pā-nay", "traducao_palavra": "perante minha face" },
        { "hebraico": "תָּמִ֛יד", "transliteral": "tā-mîḏ", "traducao_palavra": "continuamente" },
