    "27": {
      "traducao_completa": "Por provador te pus entre o meu povo, por fortaleza, para que conheças e proves o seu caminho.",
      "palavras": [
        { "hebraico": "בָּחֹ֛ון", "transliteral": "bā-ḥō-wn", "traducao_palavra": "[Como] provador/examinador" },
        { "hebraico": "נְתַתִּ֥יךָ", "transliteral": "nə-ṯat-tî-ḵā", "traducao_palavra": "pus a ti/dei a ti" },
        { "hebraico": "בְעַמִּ֖י", "transliteral": "ḇə-ʿam-mî", "traducao_palavra": "em meu povo" },
        { "hebraico": "מִבְצָ֑ר", "transliteral": "miḇ-ṣār", "traducao_palavra": "[como] fortaleza/torre" },
        { "hebraico": "וְתֵדַ֕ע", "transliteral": "wə-ṯê-ḏa-ʿ", "traducao_palavra": "para que saibas" },
        { "hebraico": "וּבָחַנְתָּ֙", "transliteral": "ū-ḇā-ḥan-tā", "traducao_palavra": "e proves" },
        { "hebraico": "אֶת־", "transliteral": "ʾeṯ-", "traducao_palavra": "[partícula acusativa]" },
        { "hebraico": "דַּרְכָּֽם׃", "transliteral": "dar-kām", "traducao_palavra": "o caminho deles." }
      ]
    },
