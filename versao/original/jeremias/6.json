        { "hebraico": "כַגֶּ֖פֶן", "transliteral": "ḵag-ge-p̄en", "traducao_palavra": "como a videira" },
        { "hebraico": "שְׁאֵרִ֣ית", "transliteral": "šə-ʾê-rîṯ", "traducao_palavra": "[o] remanescente de" },
        { "hebraico": "יִשְׂרָאֵ֑ל", "transliteral": "yiś-rā-ʾēl", "traducao_palavra": "Israel" },
        { "hebraico": "הָשֵׁ֤ב", "transliteral": "hā-šêḇ", "traducao_palavra": "Torna/Faz voltar" },
