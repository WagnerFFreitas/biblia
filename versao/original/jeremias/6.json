    "17": {
      "traducao_completa": "Também pus vigias sobre vós, dizendo: Atendei ao som da trombeta; mas eles disseram: Não atenderemos.",
      "palavras": [
        { "hebraico": "וַהֲקִמֹתִ֤י", "transliteral": "wa-hă-qi-mō-ṯî", "traducao_palavra": "E levantei/estabeleci" },
        { "hebraico": "עֲלֵיכֶם֙", "transliteral": "ʿă-lê-ḵem", "traducao_palavra": "sobre vós" },
