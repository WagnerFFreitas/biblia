    "11": {
      "traducao_completa": "Pelo que estou cheio do furor de YHWH; estou cansado de o reter; derramá-lo-ei sobre os meninos pelas ruas e sobre a assembleia de jovens; porque até o marido com a mulher serão presos, e o velho com o pleno de dias.",
      "palavras": [
        { "hebraico": "וְאֵת֩", "transliteral": "wə-ʾêṯ", "traducao_palavra": "E" },
        { "hebraico": "חֲמַ֨ת", "transliteral": "ḥă-maṯ", "traducao_palavra": "[do] furor de" },
