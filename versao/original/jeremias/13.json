        { "hebraico": "מַרְאֲשֹׁותֵיכֶ֔ם", "transliteral": "mar-ʾă-šō-w-ṯê-ḵem", "traducao_palavra": "[o que estava] em vossas cabeças/liderança" },
        { "hebraico": "עֲטֶ֖רֶת", "transliteral": "ʿă-ṭe-reṯ", "traducao_palavra": "[a] coroa de" },
        { "hebraico": "תִּפְאַרְתְּכֶֽם׃", "transliteral": "tip̄-ʾar-tə-ḵem", "traducao_palavra": "vossa glória." }
      ]
    },
    "19": {
      "traducao_completa": "As cidades do sul estão fechadas, e não há quem as abra; todo o Judá foi levado cativo, sim, inteiramente foi levado.",
      "palavras": [
        { "hebraico": "עָרֵ֥י", "transliteral": "ʿā-rê", "traducao_palavra": "As cidades de" },
        { "hebraico": "הַנֶּ֖גֶב", "transliteral": "han-ne-ḡeḇ", "traducao_palavra": "o sul/Naguebe" },
        { "hebraico": "סֻגְּר֑וּ", "transliteral": "śug-gə-rū", "traducao_palavra": "foram fechadas" },
        { "hebraico": "וְאֵ֣ין", "transliteral": "wə-ʾên", "traducao_palavra": "e não há" },
        { "hebraico": "פֹּתֵ֔חַ", "transliteral": "pō-ṯê-aḥ", "traducao_palavra": "quem abra" },
        { "hebraico": "הָגְלָ֧ת", "transliteral": "hāḡ-lāṯ", "traducao_palavra": "foi levada cativa" },
        { "hebraico": "יְהוּדָ֛ה", "transliteral": "Yə-hū-ḏāh", "traducao_palavra": "Judá" },
        { "hebraico": "כֻּלָּ֖הּ", "transliteral": "kul-lāh", "traducao_palavra": "toda ela" },
        { "hebraico": "הָגְלָ֥ת", "transliteral": "hāḡ-lāṯ", "traducao_palavra": "foi levada cativa" },
        { "hebraico": "שְׁלֹומִֽים׃", "transliteral": "šə-lō-w-mîm", "traducao_palavra": "inteiramente/em paz (ironia)." }
      ]
    },
    "20": {
      "traducao_completa": "Levantai os vossos olhos e vede os que vêm do norte; onde está o rebanho que se te deu, o teu lindo rebanho?",
      "palavras": [
        { "hebraico": "שאו", "transliteral": "śə-ʾū", "traducao_palavra": "Levantai [Qere: śə-ʾî]" },
        { "hebraico": "עֵינֵיכֶ֗ם", "transliteral": "ʿê-nê-ḵem", "traducao_palavra": "vossos olhos [Qere: ʿê-na-yiḵ]" },
        { "hebraico": "וראו", "transliteral": "ūr-ʾū", "traducao_palavra": "e vede [Qere: ūr-ʾî]" },
        { "hebraico": "הַבָּאִ֖ים", "transliteral": "hab-bā-ʾîm", "traducao_palavra": "os que vêm" },
        { "hebraico": "מִצָּפֹ֑ון", "transliteral": "miṣ-ṣā-p̄ō-wn", "traducao_palavra": "do norte" },
        { "hebraico": "אַיֵּ֤ה", "transliteral": "ʾay-yêh", "traducao_palavra": "Onde [está]" },
        { "hebraico": "הָעֵ֙דֶר֙", "transliteral": "hā-ʿê-ḏer", "traducao_palavra": "o rebanho" },
        { "hebraico": "נִתַּן־", "transliteral": "nit-tan-", "traducao_palavra": "[que] foi dado" },
        { "hebraico": "לָ֔ךְ", "transliteral": "lāḵ", "traducao_palavra": "a ti" },
        { "hebraico": "צֹ֥אן", "transliteral": "ṣō-wn", "traducao_palavra": "[o] rebanho de" },
        { "hebraico": "תִּפְאַרְתֵּֽךְ׃", "transliteral": "tip̄-ʾar-têḵ", "traducao_palavra": "tua glória/beleza." }
      ]
    },
    "21": {
      "traducao_completa": "Que dirás, quando ele te punir? Pois tu mesma os ensinaste a serem capitães e chefes sobre ti; acaso não te tomarão as dores, como à mulher que está de parto?",
      "palavras": [
        { "hebraico": "מַה־תֹּאמְרִ֗י", "transliteral": "mah-tō-mə-rî", "traducao_palavra": "Que dirás tu" },
        { "hebraico": "כִּֽי־יִפְקֹ֧ד", "transliteral": "kî-yip̄-qōḏ", "traducao_palavra": "quando [ele] punir/visitar" },
        { "hebraico": "עָלַ֛יִךְ", "transliteral": "ʿā-la-yiḵ", "traducao_palavra": "a ti?" },
        { "hebraico": "וְאַתְּ֙", "transliteral": "wə-ʾat", "traducao_palavra": "visto que tu" },
        { "hebraico": "לִמַּ֣דְתְּ", "transliteral": "lim-maḏt", "traducao_palavra": "ensinaste" },
        { "hebraico": "אֹ֠תָם", "transliteral": "ʾō-ṯām", "traducao_palavra": "eles" },
        { "hebraico": "עָלַ֨יִךְ֙", "transliteral": "ʿā-la-yiḵ", "traducao_palavra": "sobre ti" },
        { "hebraico": "אַלֻּפִ֣ים", "transliteral": "ʾal-lū-p̄îm", "traducao_palavra": "[serem] chefes/amigos" },
        { "hebraico": "לְרֹ֔אשׁ", "transliteral": "lə-rōš", "traducao_palavra": "para cabeça" },
        { "hebraico": "הֲלֹ֧וא", "transliteral": "hă-lō-w", "traducao_palavra": "acaso não" },
        { "hebraico": "חֲבָלִ֛ים", "transliteral": "ḥă-ḇā-lîm", "traducao_palavra": "dores" },
        { "hebraico": "יֹאחֲז֖וּךְ", "transliteral": "yō-w-ḥă-zūḵ", "traducao_palavra": "tomarão a ti" },
        { "hebraico": "כְּמֹ֥ו", "transliteral": "kə-mō-w", "traducao_palavra": "como" },
        { "hebraico": "אֵ֥שֶׁת", "transliteral": "ʾê-šeṯ", "traducao_palavra": "[a] mulher de" },
        { "hebraico": "לֵדָֽה׃", "transliteral": "lê-ḏāh", "traducao_palavra": "parto." }
      ]
    },
    "22": {
      "traducao_completa": "E quando disseres no teu coração: Por que me sobrevieram estas coisas? Pela multidão da tua iniquidade se descobriram as tuas fraldas, e os teus calcanhares sofrem violência.",
      "palavras": [
        { "hebraico": "וְכִ֨י", "transliteral": "wə-ḵî", "traducao_palavra": "E quando" },
        { "hebraico": "תֹאמְרִ֤י", "transliteral": "ṯō-mə-rî", "traducao_palavra": "disseres tu" },
        { "hebraico": "בִלְבָבֵךְ֙", "transliteral": "bil-ḇā-ḇêḵ", "traducao_palavra": "em teu coração" },
        { "hebraico": "מַדּ֖וּעַ", "transliteral": "mad-dū-aʿ", "traducao_palavra": "Por que" },
        { "hebraico": "קְרָאֻ֣נִי", "transliteral": "qə-rā-ʾu-nî", "traducao_palavra": "encontraram-me/sobrevieram-me" },
        { "hebraico": "אֵ֑לֶּה", "transliteral": "ʾēl-leh", "traducao_palavra": "estas coisas?" },
        { "hebraico": "בְּרֹ֥ב", "transliteral": "bə-rōḇ", "traducao_palavra": "Pela multidão de" },
        { "hebraico": "עֲוֹנֵ֛ךְ", "transliteral": "ʿă-wō-nêḵ", "traducao_palavra": "tua iniquidade" },
        { "hebraico": "נִגְלּ֥וּ", "transliteral": "niḡ-lū", "traducao_palavra": "foram descobertas" },
        { "hebraico": "שׁוּלַ֖יִךְ", "transliteral": "šū-la-yiḵ", "traducao_palavra": "tuas fraldas/caudas" },
        { "hebraico": "נֶחְמְס֥וּ", "transliteral": "neḥ-mə-śū", "traducao_palavra": "foram violados/expostos" },
        { "hebraico": "עֲקֵבָֽיִךְ׃", "transliteral": "ʿă-qē-ḇā-yiḵ", "traducao_palavra": "teus calcanhares." }
      ]
    },
    "23": {
      "traducao_completa": "Acaso pode o etíope mudar a sua pele, ou o leopardo as suas manchas? Assim também vós podereis fazer o bem, sendo ensinados a fazer o mal.",
      "palavras": [
        { "hebraico": "הֲיַהֲפֹ֤ךְ", "transliteral": "hă-ya-hă-p̄ōḵ", "traducao_palavra": "Acaso mudará" },
        { "hebraico": "כּוּשִׁי֙", "transliteral": "kū-šî", "traducao_palavra": "[o] etíope" },
        { "hebraico": "עֹורֹ֔ו", "transliteral": "ʿō-w-rō-w", "traducao_palavra": "sua pele" },
        { "hebraico": "וְנָמֵ֖ר", "transliteral": "wə-nā-mêr", "traducao_palavra": "ou o leopardo" },
        { "hebraico": "חֲבַרְבֻּרֹתָ֑יו", "transliteral": "ḥă-ḇar-bu-rō-ṯāy-w", "traducao_palavra": "suas manchas?" },
        { "hebraico": "גַּם־אַתֶּם֙", "transliteral": "gam-ʾat-tem", "traducao_palavra": "também vós" },
        { "hebraico": "תּוּכְל֣וּ", "transliteral": "ṯū-ḵə-lū", "traducao_palavra": "podereis" },
        { "hebraico": "הֵיטִ֔יב", "transliteral": "hê-ṭîḇ", "traducao_palavra": "fazer o bem" },
        { "hebraico": "לִמֻּדֵ֖י", "transliteral": "lim-mu-ḏê", "traducao_palavra": "[sendo] acostumados/ensinados a" },
        { "hebraico": "הָרֵֽעַ׃", "transliteral": "hā-rê-aʿ", "traducao_palavra": "fazer o mal." }
      ]
    },
    "24": {
      "traducao_completa": "Pelo que os espalharei como o restolho que passa pelo vento do deserto.",
      "palavras": [
        { "hebraico": "וַאֲפִיצֵ֖ם", "transliteral": "wa-ʾă-p̄î-ṣêm", "traducao_palavra": "E espalharei eles" },
        { "hebraico": "כְּקַשׁ־", "transliteral": "kə-qaš-", "traducao_palavra": "como restolho" },
        { "hebraico": "עֹובֵ֑ר", "transliteral": "ʿō-w-ḇêr", "traducao_palavra": "[que] passa" },
        { "hebraico": "לְר֖וּחַ", "transliteral": "lə-rū-aḥ", "traducao_palavra": "pelo vento de" },
        { "hebraico": "מִדְבָּֽר׃", "transliteral": "miḏ-bār", "traducao_palavra": "deserto." }
      ]
    },
    "25": {
      "traducao_completa": "Esta é a tua sorte, a porção que te medi, diz YHWH; porquanto te esqueceste de mim e confiaste na falsidade.",
      "palavras": [
        { "hebraico": "זֶ֤ה", "transliteral": "zeh", "traducao_palavra": "Esta [é]" },
        { "hebraico": "גֹורָלֵךְ֙", "transliteral": "ḡō-w-rā-lêḵ", "traducao_palavra": "tua sorte" },
        { "hebraico": "מְנָת־", "transliteral": "mə-nāṯ-", "traducao_palavra": "porção de" },
        { "hebraico": "מִדַּ֣יִךְ", "transliteral": "mid-day-yiḵ", "traducao_palavra": "tua medida" },
        { "hebraico": "מֵֽאִתִּ֔י", "transliteral": "mê-ʾit-tî", "traducao_palavra": "de mim" },
        { "hebraico": "נְאֻם־", "transliteral": "nə-ʾum-", "traducao_palavra": "diz/oráculo de" },
        { "hebraico": "יְהוָ֑ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "אֲשֶׁר֙", "transliteral": "ʾă-šer", "traducao_palavra": "porque" },
        { "hebraico": "שָׁכַ֣חַתְּ", "transliteral": "šā-ḵa-ḥat", "traducao_palavra": "esqueceste" },
        { "hebraico": "אֹותִ֔י", "transliteral": "ʾō-w-ṯî", "traducao_palavra": "de mim" },
        { "hebraico": "וַתִּבְטְחִ֖י", "transliteral": "wat-tiḇ-ṭə-ḥî", "traducao_palavra": "e confiaste" },
        { "hebraico": "בַּשָּֽׁקֶר׃", "transliteral": "baš-šā-qer", "traducao_palavra": "na mentira." }
      ]
    },
    "26": {
      "traducao_completa": "Assim também eu levantarei as tuas fraldas sobre o teu rosto, e ver-se-á a tua ignomínia.",
      "palavras": [
        { "hebraico": "וְגַם־אֲנִ֥י", "transliteral": "wə-ḡam-ʾă-nî", "traducao_palavra": "E também eu" },
        { "hebraico": "חָשַׂ֥ףְתִּי", "transliteral": "ḥā-śap̄-tî", "traducao_palavra": "descobri/levantei" },
        { "hebraico": "שׁוּלַ֖יִךְ", "transliteral": "šū-la-yiḵ", "traducao_palavra": "tuas abas/fraldas" },
        { "hebraico": "עַל־פָּנָ֑יִךְ", "transliteral": "ʿal-pā-nā-yiḵ", "traducao_palavra": "sobre tua face" },
        { "hebraico": "וְנִרְאָ֖ה", "transliteral": "wə-nir-ʾāh", "traducao_palavra": "e será vista" },
        { "hebraico": "קְלֹונֵֽךְ׃", "transliteral": "qə-lō-w-nêḵ", "traducao_palavra": "tua vergonha/ignomínia." }
      ]
    },
    "27": {
      "traducao_completa": "Os teus adultérios, e os teus relinchos, e a infâmia da tua prostituição sobre os outeiros no campo, eu vi as tuas abominações. Ai de ti, Jerusalém! Não te purificarás? Até quando ainda?",
      "palavras": [
        { "hebraico": "נִֽאֻפַיִךְ֮", "transliteral": "ni-ʾu-p̄a-yiḵ", "traducao_palavra": "Teus adultérios" },
        { "hebraico": "וּמִצְהֲלֹותַיִךְ֮", "transliteral": "ū-miṣ-hă-lō-ṯa-yiḵ", "traducao_palavra": "e teus relinchos" },
        { "hebraico": "זִמַּ֣ת", "transliteral": "zim-maṯ", "traducao_palavra": "[a] infâmia de" },
        { "hebraico": "זְנוּתֵךְ֮", "transliteral": "zə-nū-ṯêḵ", "traducao_palavra": "tua prostituição" },
        { "hebraico": "עַל־גְּבָעֹות֙", "transliteral": "ʿal-gə-ḇā-ʿō-wṯ", "traducao_palavra": "sobre [os] outeiros" },
        { "hebraico": "בַּשָּׂדֶ֔ה", "transliteral": "baś-śā-ḏeh", "traducao_palavra": "no campo" },
        { "hebraico": "רָאִ֖יתִי", "transliteral": "rā-ʾî-ṯî", "traducao_palavra": "eu vi" },
        { "hebraico": "שִׁקּוּצָ֑יִךְ", "transliteral": "šiq-qū-ṣā-yiḵ", "traducao_palavra": "tuas abominações" },
        { "hebraico": "אֹ֣וי", "transliteral": "ʾō-wy", "traducao_palavra": "Ai" },
        { "hebraico": "לָךְ֙", "transliteral": "lāḵ", "traducao_palavra": "de ti" },
        { "hebraico": "יְרוּשָׁלַ֔͏ִם", "transliteral": "Yə-rū-šā-la-im", "traducao_palavra": "Jerusalém" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "תִטְהֲרִ֔י", "transliteral": "tiṭ-hă-rî", "traducao_palavra": "te purificarás?" },
        { "hebraico": "אַחֲרֵ֥י", "transliteral": "ʾa-ḥă-rê", "traducao_palavra": "depois de" },
        { "hebraico": "מָתַ֖י", "transliteral": "mā-ṯay", "traducao_palavra": "quanto [tempo]" },
        { "hebraico": "עֹֽוד׃", "transliteral": "ʿō-wḏ", "traducao_palavra": "mais/ainda?" }
      ]
