        { "hebraico": "מִכֹּהֵ֗ן", "transliteral": "mik-kō-hên", "traducao_palavra": "do sacerdote" },
        { "hebraico": "וְעֵצָה֙", "transliteral": "wə-ʿê-ṣāh", "traducao_palavra": "nem conselho" },
        { "hebraico": "מֵחָכָ֔ם", "transliteral": "mē-ḥā-ḵām", "traducao_palavra": "do sábio" },
