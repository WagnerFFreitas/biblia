    },
    "15": {
      "traducao_completa": "Pois o meu povo se esqueceu de mim, queimando incenso à vaidade; e tropeçaram nos seus caminhos, nas veredas antigas, para andarem por desvios, por caminho não aterrado;",
      "palavras": [
        { "hebraico": "כִּֽי־שְׁכָחֻ֥נִי", "transliteral": "kî-šə-ḵā-ḥu-nî", "traducao_palavra": "Porque esqueceram-me" },
        { "hebraico": "עַמִּ֖י", "transliteral": "ʿam-mî", "traducao_palavra": "meu povo" },
        { "hebraico": "לַשַּׁ֣וְא", "transliteral": "laš-šāw", "traducao_palavra": "para o vácuo/vaidade" },
        { "hebraico": "יְקַטֵּ֑רוּ", "transliteral": "yə-qaṭ-ṭê-rū", "traducao_palavra": "queimam incenso" },
        { "hebraico": "וַיַּכְשִׁלוּם֙", "transliteral": "way-yaḵ-ši-lūm", "traducao_palavra": "e eles os fizeram tropeçar" },
        { "hebraico": "בְּדַרְכֵיהֶ֔ם", "transliteral": "bə-ḏar-ḵê-hem", "traducao_palavra": "nos seus caminhos" },
        { "hebraico": "שְׁבִילֵ֣י", "transliteral": "šə-ḇî-lê", "traducao_palavra": "[nas] veredas de" },
        { "hebraico": "עֹולָ֔ם", "transliteral": "ʿō-w-lām", "traducao_palavra": "antiguidade/eterno" },
        { "hebraico": "לָלֶ֥כֶת", "transliteral": "lā-le-ḵeṯ", "traducao_palavra": "para andar" },
        { "hebraico": "נְתִיבֹ֖ות", "transliteral": "nə-ṯî-ḇō-wṯ", "traducao_palavra": "[por] trilhas" },
        { "hebraico": "דֶּ֥רֶךְ", "transliteral": "de-reḵ", "traducao_palavra": "um caminho" },
        { "hebraico": "לֹ֥א", "transliteral": "lō", "traducao_palavra": "não" },
