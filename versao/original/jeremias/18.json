        { "hebraico": "אֵלָ֑י", "transliteral": "ʾê-lāy", "traducao_palavra": "a mim" },
        { "hebraico": "וּשְׁמַ֕ע", "transliteral": "ū-šə-ma-ʿ", "traducao_palavra": "e ouve" },
