        { "hebraico": "הָרָ֖ע", "transliteral": "hā-rā-ʿ", "traducao_palavra": "mau" },
        { "hebraico": "נַעֲשֶֽׂה׃", "transliteral": "na-ʿă-śeh", "traducao_palavra": "faremos." }
