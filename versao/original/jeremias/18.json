    "20": {
      "traducao_completa": "Acaso pagar-se-á mal por bem? Pois cavaram uma cova para a minha alma. Lembra-te de que eu me pus diante de ti, para falar bem por eles, para desviar deles o teu furor.",
      "palavras": [
        { "hebraico": "הַיְשֻׁלַּ֥ם", "transliteral": "hay-šul-lam", "traducao_palavra": "Acaso se pagará" },
        { "hebraico": "תַּֽחַת־", "transliteral": "ta-ḥaṯ-", "traducao_palavra": "em lugar de/por" },
        { "hebraico": "טֹובָה֙", "transliteral": "ṭō-w-ḇāh", "traducao_palavra": "bem" },
        { "hebraico": "רָעָ֔ה", "transliteral": "rā-ʿāh", "traducao_palavra": "mal?" },
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "pois" },
        { "hebraico": "כָר֥וּ", "transliteral": "ḵā-rū", "traducao_palavra": "cavaram" },
        { "hebraico": "שׁוּחָ֖ה", "transliteral": "šū-ḥāh", "traducao_palavra": "[uma] cova" },
        { "hebraico": "לְנַפְשִׁ֑י", "transliteral": "lə-nap̄-šî", "traducao_palavra": "para minha alma" },
        { "hebraico": "זְכֹ֣ר ׀", "transliteral": "zə-ḵōr", "traducao_palavra": "Lembra-te [do]" },
        { "hebraico": "עָמְדִ֣י", "transliteral": "ʿām-ḏî", "traducao_palavra": "meu estar em pé" },
        { "hebraico": "לְפָנֶ֗יךָ", "transliteral": "lə-p̄ā-ne-ḵā", "traducao_palavra": "diante de ti" },
        { "hebraico": "לְדַבֵּ֥ר", "transliteral": "lə-ḏab-bêr", "traducao_palavra": "para falar" },
        { "hebraico": "עֲלֵיהֶ֛ם", "transliteral": "ʿă-lê-hem", "traducao_palavra": "sobre eles" },
        { "hebraico": "טֹובָ֖ה", "transliteral": "ṭō-w-ḇāh", "traducao_palavra": "bem" },
        { "hebraico": "לְהָשִׁ֥יב", "transliteral": "lə-hā-šîᇀ", "traducao_palavra": "para fazer voltar" },
        { "hebraico": "אֶת־", "transliteral": "ʾeṯ-", "traducao_palavra": "[partícula]" },
        { "hebraico": "חֲמָתְךָ֖", "transliteral": "ḥă-mā-ṯə-ḵā", "traducao_palavra": "teu furor" },
        { "hebraico": "מֵהֶֽם׃", "transliteral": "mê-hem", "traducao_palavra": "deles." }
      ]
    },
    "21": {
      "traducao_completa": "Portanto, entrega os seus filhos à fome, e entrega-os ao poder da espada; e sejam as suas mulheres privadas de filhos, e fiquem viúvas; e seus maridos sejam feridos de morte, e os seus jovens feridos à espada na peleja.",
