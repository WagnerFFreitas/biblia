        { "hebraico": "לָ֠כֵן", "transliteral": "lā-ḵēn", "traducao_palavra": "Portanto" },
        { "hebraico": "תֵּ֨ן", "transliteral": "tēn", "traducao_palavra": "entrega" },
        { "hebraico": "אֶת־", "transliteral": "ʾeṯ-", "traducao_palavra": "[partícula]" },
        { "hebraico": "בְּנֵיהֶ֥ם", "transliteral": "bə-nê-hem", "traducao_palavra": "os filhos deles" },
        { "hebraico": "לָרָעָב֮", "transliteral": "lā-rā-ʿāḇ", "traducao_palavra": "à fome" },
