        { "hebraico": "יְהוָה֮", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "עַל־כָּל־שְׁכֵנַ֣י", "transliteral": "ʿal-kāl-šə-ḵē-nay", "traducao_palavra": "sobre todos os meus vizinhos" },
