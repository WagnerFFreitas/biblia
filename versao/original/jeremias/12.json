        { "hebraico": "חִטִּים֙", "transliteral": "ḥiṭ-ṭîm", "traducao_palavra": "trigo" },
        { "hebraico": "וְקֹצִ֣ים", "transliteral": "wə-qō-ṣîm", "traducao_palavra": "mas espinhos" },
