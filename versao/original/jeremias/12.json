        { "hebraico": "מֵחֲרֹ֖ון", "transliteral": "mê-ḥă-rō-wn", "traducao_palavra": "por causa do ardor de" },
        { "hebraico": "אַף־יְהוָֽה׃", "transliteral": "ʾap̄-YHWH", "traducao_palavra": "ira de YHWH." }
