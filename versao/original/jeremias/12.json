        { "hebraico": "כָּל־", "transliteral": "kāl-", "traducao_palavra": "todos" },
        { "hebraico": "בֹּ֥גְדֵי", "transliteral": "bō-ḡə-ḏê", "traducao_palavra": "[os que] agem traiçoeiramente" },
        { "hebraico": "בָֽגֶד׃", "transliteral": "ḇā-ḡeḏ", "traducao_palavra": "com traição." }
      ]
    },
    "2": {
      "traducao_completa": "Plantaste-os, e eles se arraigaram; crescem e dão fruto; perto estás da sua boca, mas longe dos seus rins.",
      "palavras": [
        { "hebraico": "נְטַעְתָּם֙", "transliteral": "nə-ṭa-ʿtām", "traducao_palavra": "Tu plantaste eles" },
        { "hebraico": "גַּם־", "transliteral": "gam-", "traducao_palavra": "também" },
        { "hebraico": "שֹׁרָ֔שׁוּ", "transliteral": "šō-rā-šū", "traducao_palavra": "arraigaram-se" },
        { "hebraico": "יֵלְכ֕וּ", "transliteral": "yê-lə-ḵū", "traducao_palavra": "vão/crescem" },
