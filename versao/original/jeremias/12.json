    "3": {
      "traducao_completa": "Mas tu, ó YHWH, me conheces, tu me viste e provaste o meu coração para contigo; arranca-os como ovelhas para o matadouro e prepara-os para o dia da matança.",
      "palavras": [
        { "hebraico": "וְאַתָּ֤ה", "transliteral": "wə-ʾat-tāh", "traducao_palavra": "Mas tu" },
        { "hebraico": "יְהוָה֙", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "יְדַעְתָּ֔נִי", "transliteral": "yə-ḏa-ʿtā-nî", "traducao_palavra": "conheces-me" },
        { "hebraico": "תִּרְאֵ֕נִי", "transliteral": "tir-ʾē-nî", "traducao_palavra": "vês-me" },
        { "hebraico": "וּבָחַנְתָּ֥", "transliteral": "ū-ḇā-ḥan-tā", "traducao_palavra": "e provaste" },
        { "hebraico": "לִבִּ֖י", "transliteral": "lib-bî", "traducao_palavra": "meu coração" },
        { "hebraico": "אִתָּ֑ךְ", "transliteral": "ʾit-tāḵ", "traducao_palavra": "contigo" },
        { "hebraico": "הַתִּקֵם֙", "transliteral": "hat-ti-qêm", "traducao_palavra": "arranca eles" },
        { "hebraico": "כְּצֹ֣אן", "transliteral": "kə-ṣō-wn", "traducao_palavra": "como ovelhas" },
        { "hebraico": "לְטִבְחָ֔ה", "transliteral": "lə-ṭiḇ-ḥāh", "traducao_palavra": "para o abate" },
        { "hebraico": "וְהַקְדִּשֵׁ֖ם", "transliteral": "wə-haq-di-šêm", "traducao_palavra": "e consagra/prepara eles" },
        { "hebraico": "לְיֹ֥ום", "transliteral": "lə-yō-wm", "traducao_palavra": "para o dia de" },
        { "hebraico": "הֲרֵגָֽה׃", "transliteral": "hă-rê-ḡāh", "traducao_palavra": "matança." }
      ]
    },
    "4": {
      "traducao_completa": "Até quando lamentará a terra e se secará a erva de todo o campo? Por causa da maldade dos que nela habitam, perecem os animais e as aves; porquanto dizem: Ele não verá o nosso fim.",
      "palavras": [
        { "hebraico": "עַד־מָתַי֙", "transliteral": "ʿaḏ-mā-ṯay", "traducao_palavra": "Até quando" },
        { "hebraico": "תֶּאֱבַ֣ל", "transliteral": "te-ʾĕ-ḇal", "traducao_palavra": "lamentará/pranteará" },
        { "hebraico": "הָאָ֔רֶץ", "transliteral": "hā-ʾā-reṣ", "traducao_palavra": "a terra" },
        { "hebraico": "וְעֵ֥שֶׂב", "transliteral": "wə-ʿê-śeḇ", "traducao_palavra": "e a erva de" },
        { "hebraico": "כָּל־הַשָּׂדֶ֖ה", "transliteral": "kāl-haś-śā-ḏeh", "traducao_palavra": "todo o campo" },
        { "hebraico": "יִיבָ֑שׁ", "transliteral": "yî-ḇāš", "traducao_palavra": "se secará?" },
        { "hebraico": "מֵרָעַ֣ת", "transliteral": "mê-rā-ʿaṯ", "traducao_palavra": "Pela maldade de" },
        { "hebraico": "יֹשְׁבֵי־בָ֗הּ", "transliteral": "yō-šə-ḇê-ḇāh", "traducao_palavra": "[os] moradores nela" },
        { "hebraico": "סָפְתָה", "transliteral": "śā-p̄ə-ṯāh", "traducao_palavra": "consumiu-se/pereceu" },
        { "hebraico": "בְהֵמֹות֙", "transliteral": "ḇə-hē-mō-wṯ", "traducao_palavra": "animais" },
        { "hebraico": "וָעֹ֔וף", "transliteral": "wā-ʿō-wp̄", "traducao_palavra": "e aves" },
        { "hebraico": "כִּ֣י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "אָמְר֔וּ", "transliteral": "ʾā-mə-rū", "traducao_palavra": "disseram" },
        { "hebraico": "לֹ֥א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "יִרְאֶ֖ה", "transliteral": "yir-ʾeh", "traducao_palavra": "verá ele" },
        { "hebraico": "אֶת־אַחֲרִיתֵֽנוּ׃", "transliteral": "ʾeṯ-ʾa-ḥă-rî-ṯê-nū", "traducao_palavra": "o nosso fim." }
      ]
    },
    "5": {
      "traducao_completa": "Se te fadigaste correndo com homens que vão a pé, como poderás competir com os cavalos? E se confias na terra de paz, como farás na enchente do Jordão?",
      "palavras": [
        { "hebraico": "כִּ֤י", "transliteral": "kî", "traducao_palavra": "Se" },
        { "hebraico": "אֶת־רַגְלִים֙", "transliteral": "ʾeṯ-raḡ-lîm", "traducao_palavra": "com [os de] pé" },
        { "hebraico": "רַ֣צְתָּה", "transliteral": "raṣ-tāh", "traducao_palavra": "tu correste" },
        { "hebraico": "וַיַּלְא֕וּךָ", "transliteral": "way-yal-ʾū-ḵā", "traducao_palavra": "e fadigaram a ti" },
        { "hebraico": "וְאֵ֥יךְ", "transliteral": "wə-ʾêḵ", "traducao_palavra": "então como" },
        { "hebraico": "תְּתַחֲרֶ֖ה", "transliteral": "tə-ṯa-ḥă-reh", "traducao_palavra": "competirás/contenderás" },
        { "hebraico": "אֶת־הַסּוּסִ֑ים", "transliteral": "ʾeṯ-has-śū-śîm", "traducao_palavra": "com os cavalos?" },
        { "hebraico": "וּבְאֶ֥רֶץ", "transliteral": "ū-ḇə-ʾe-reṣ", "traducao_palavra": "e em terra de" },
        { "hebraico": "שָׁלֹ֖ום", "transliteral": "šā-lō-wm", "traducao_palavra": "paz" },
        { "hebraico": "אַתָּ֣ה", "transliteral": "ʾat-tāh", "traducao_palavra": "tu [estás]" },
        { "hebraico": "בֹוטֵ֑חַ", "transliteral": "bō-w-ṭê-aḥ", "traducao_palavra": "confiante" },
        { "hebraico": "וְאֵ֥יךְ", "transliteral": "wə-ʾêḵ", "traducao_palavra": "mas como" },
        { "hebraico": "תַּעֲשֶׂ֖ה", "transliteral": "ta-ʿă-śeh", "traducao_palavra": "farás" },
        { "hebraico": "בִּגְאֹ֥ון", "transliteral": "biḡ-ʾō-wn", "traducao_palavra": "na soberba/enchente de" },
        { "hebraico": "הַיַּרְדֵּֽן׃", "transliteral": "hay-yar-dên", "traducao_palavra": "o Jordão?" }
      ]
    },
    "6": {
      "traducao_completa": "Porque até os teus irmãos e a casa de teu pai, eles próprios procedem aleivosamente contigo; eles mesmos gritam após ti em voz alta; não creias neles, ainda que te digam coisas boas.",
      "palavras": [
        { "hebraico": "כִּ֧י", "transliteral": "kî", "traducao_palavra": "Porque" },
        { "hebraico": "גַם־אַחֶ֣יךָ", "transliteral": "gam-ʾa-ḥe-y-ḵā", "traducao_palavra": "até teus irmãos" },
        { "hebraico": "וּבֵית־אָבִ֗יךָ", "transliteral": "ū-ḇêṯ-ʾā-ḇî-ḵā", "traducao_palavra": "e a casa de teu pai" },
        { "hebraico": "גַּם־הֵ֙מָּה֙", "transliteral": "gam-hêm-māh", "traducao_palavra": "também eles" },
        { "hebraico": "בָּ֣גְדוּ", "transliteral": "bā-ḡə-ḏū", "traducao_palavra": "agiram traiçoeiramente" },
        { "hebraico": "בָ֔ךְ", "transliteral": "bāḵ", "traducao_palavra": "contigo" },
        { "hebraico": "גַּם־הֵ֛מָּה", "transliteral": "gam-hêm-māh", "traducao_palavra": "também eles" },
        { "hebraico": "קָרְא֥וּ", "transliteral": "qā-rə-ʾū", "traducao_palavra": "chamaram/gritaram" },
        { "hebraico": "אַחֲרֶ֖יךָ", "transliteral": "ʾa-ḥă-re-y-ḵā", "traducao_palavra": "atrás de ti" },
        { "hebraico": "מָלֵ֑א", "transliteral": "mā-lē", "traducao_palavra": "[em voz] plena/alta" },
        { "hebraico": "אַל־תַּאֲמֵ֣ן", "transliteral": "ʾal-ta-ʾă-mên", "traducao_palavra": "não creias" },
        { "hebraico": "בָּ֔ם", "transliteral": "bām", "traducao_palavra": "neles" },
        { "hebraico": "כִּֽי־יְדַבְּר֥וּ", "transliteral": "kî-yə-ḏab-bə-rū", "traducao_palavra": "ainda que falem" },
        { "hebraico": "אֵלֶ֖יךָ", "transliteral": "ʾê-le-ḵā", "traducao_palavra": "a ti" },
        { "hebraico": "טֹובֹֽות׃", "transliteral": "ṭō-w-ḇō-wṯ", "traducao_palavra": "[coisas] boas." }
      ]
    },
    "7": {
      "traducao_completa": "Desamparei a minha casa, abandonei a minha herança; entreguei a amada da minha alma na mão de seus inimigos.",
      "palavras": [
        { "hebraico": "עָזַ֙בְתִּי֙", "transliteral": "ʿā-zaḇ-tî", "traducao_palavra": "Abandonei" },
        { "hebraico": "אֶת־בֵּיתִ֔י", "transliteral": "ʾeṯ-bê-ṯî", "traducao_palavra": "minha casa" },
        { "hebraico": "נָטַ֖שְׁתִּי", "transliteral": "nā-ṭaš-tî", "traducao_palavra": "desamparei/deixei" },
        { "hebraico": "אֶת־נַחֲלָתִ֑י", "transliteral": "ʾeṯ-na-ḥă-lā-ṯî", "traducao_palavra": "minha herança" },
        { "hebraico": "נָתַ֜תִּי", "transliteral": "nā-ṯat-tî", "traducao_palavra": "dei/entreguei" },
        { "hebraico": "אֶת־יְדִדֹ֧ות", "transliteral": "ʾeṯ-yə-ḏi-ḏō-wṯ", "traducao_palavra": "a amada de" },
        { "hebraico": "נַפְשִׁ֛י", "transliteral": "nap̄-šî", "traducao_palavra": "minha alma" },
        { "hebraico": "בְּכַ֥ף", "transliteral": "bə-ḵap̄", "traducao_palavra": "na palma de/mão de" },
        { "hebraico": "אֹיְבֶֽיהָ׃", "transliteral": "ʾō-yə-ḇe-hā", "traducao_palavra": "inimigos dela." }
      ]
    },
    "8": {
      "traducao_completa": "Tornou-se a minha herança para mim como um leão no bosque; levantou a sua voz contra mim; por isso a odiei.",
      "palavras": [
        { "hebraico": "הָיְתָה־לִּ֨י", "transliteral": "hā-yə-ṯāh-lî", "traducao_palavra": "Foi/Tornou-se para mim" },
        { "hebraico": "נַחֲלָתִ֧י", "transliteral": "na-ḥă-lā-ṯî", "traducao_palavra": "minha herança" },
        { "hebraico": "כְּאַרְיֵ֣ה", "transliteral": "kə-ʾar-yēh", "traducao_palavra": "como leão" },
        { "hebraico": "בַיָּ֑עַר", "transliteral": "ḇay-yā-ʿar", "traducao_palavra": "no bosque" },
        { "hebraico": "נָתְנָ֥ה", "transliteral": "nā-ṯə-nāh", "traducao_palavra": "deu/levantou" },
        { "hebraico": "עָלַ֛י", "transliteral": "ʿā-lay", "traducao_palavra": "contra mim" },
        { "hebraico": "בְּקֹולָ֖הּ", "transliteral": "bə-qō-w-lāh", "traducao_palavra": "em sua voz" },
        { "hebraico": "עַל־כֵּ֥ן", "transliteral": "ʿal-kên", "traducao_palavra": "por isso" },
        { "hebraico": "שְׂנֵאתִֽיהָ׃", "transliteral": "śə-nê-ṯî-hā", "traducao_palavra": "odiei ela." }
      ]
    },
    "9": {
      "traducao_completa": "Acaso é para mim a minha herança como uma ave de rapina de várias cores? Estão as aves de rapina contra ela em redor? Vinde, pois, ajuntai todos os animais do campo, trazei-os para comer.",
      "palavras": [
        { "hebraico": "הַעַ֨יִט", "transliteral": "ha-ʿa-yiṭ", "traducao_palavra": "Acaso ave de rapina" },
        { "hebraico": "צָב֜וּעַ", "transliteral": "ṣā-ḇū-aʿ", "traducao_palavra": "tingida/colorida" },
        { "hebraico": "נַחֲלָתִ֥י", "transliteral": "na-ḥă-lā-ṯî", "traducao_palavra": "[é] minha herança" },
        { "hebraico": "לִ֗י", "transliteral": "lî", "traducao_palavra": "para mim?" },
        { "hebraico": "הַעַ֙יִט֙", "transliteral": "ha-ʿa-yiṭ", "traducao_palavra": "as aves de rapina" },
        { "hebraico": "סָבִ֣יב", "transliteral": "śā-ḇîḇ", "traducao_palavra": "[estão] em redor" },
        { "hebraico": "עָלֶ֑יהָ", "transliteral": "ʿā-le-hā", "traducao_palavra": "contra ela?" },
        { "hebraico": "לְכ֧וּ", "transliteral": "lə-ḵū", "traducao_palavra": "ide/vinde" },
        { "hebraico": "אִסְפּ֛וּ", "transliteral": "ʾis-pū", "traducao_palavra": "ajuntai" },
        { "hebraico": "כָּל־חַיַּ֥ת", "transliteral": "kāl-ḥay-yaṯ", "traducao_palavra": "toda fera de" },
        { "hebraico": "הַשָּׂדֶ֖ה", "transliteral": "haś-śā-ḏeh", "traducao_palavra": "campo" },
        { "hebraico": "הֵתָ֥יוּ", "transliteral": "hê-ṯā-yū", "traducao_palavra": "vinde" },
        { "hebraico": "לְאָכְלָֽה׃", "transliteral": "lə-ʾāḵ-lāh", "traducao_palavra": "para comer." }
      ]
    },
    "10": {
      "traducao_completa": "Muitos pastores destruíram a minha vinha, pisaram o meu quinhão; tornaram o meu quinhão desejado em um deserto ermo.",
      "palavras": [
        { "hebraico": "רֹעִ֤ים", "transliteral": "rō-ʿîm", "traducao_palavra": "Pastores" },
        { "hebraico": "רַבִּים֙", "transliteral": "rab-bîm", "traducao_palavra": "muitos" },
