  "versiculos": {
    "1": {
      "traducao_completa": "Justo és tu, ó YHWH, quando pleiteio contigo; contudo falarei contigo de juízos: Por que prospera o caminho dos ímpios? Por que vivem em paz todos os que procedem aleivosamente?",
      "palavras": [
