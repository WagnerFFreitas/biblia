        { "hebraico": "אַתָּה֙", "transliteral": "ʾat-tāh", "traducao_palavra": "tu" },
        { "hebraico": "יְהוָ֔ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "כִּ֥י", "transliteral": "kî", "traducao_palavra": "quando/embora" },
        { "hebraico": "אָרִ֖יב", "transliteral": "ʾā-rîḇ", "traducao_palavra": "pleiteie eu" },
        { "hebraico": "אֵלֶ֑יךָ", "transliteral": "ʾê-le-ḵā", "traducao_palavra": "a ti" },
        { "hebraico": "אַ֤ךְ", "transliteral": "ʾaḵ", "traducao_palavra": "contudo" },
        { "hebraico": "מִשְׁפָּטִים֙", "transliteral": "miš-pā-ṭîm", "traducao_palavra": "juízos/questões de justiça" },
        { "hebraico": "אֲדַבֵּ֣ר", "transliteral": "ʾă-ḏab-bêr", "traducao_palavra": "falarei eu" },
        { "hebraico": "אֹותָ֔ךְ", "transliteral": "ʾō-w-ṯāḵ", "traducao_palavra": "contigo" },
        { "hebraico": "מַדּ֤וּעַ", "transliteral": "mad-dū-aʿ", "traducao_palavra": "por que" },
        { "hebraico": "דֶּ֤רֶךְ", "transliteral": "de-reḵ", "traducao_palavra": "[o] caminho de" },
        { "hebraico": "רְשָׁעִים֙", "transliteral": "rə-šā-ʿîm", "traducao_palavra": "[os] ímpios" },
        { "hebraico": "צָלֵ֔חָה", "transliteral": "ṣā-lê-ḥāh", "traducao_palavra": "prospera?" },
