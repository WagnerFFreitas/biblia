        { "hebraico": "תַּנִּ֑ים", "transliteral": "tan-nîm", "traducao_palavra": "chacais" },
        { "hebraico": "וְאֶת־עָרֵ֧י", "transliteral": "wə-ʾeṯ-ʿā-rê", "traducao_palavra": "e as cidades de" },
        { "hebraico": "יְהוּדָ֛ה", "transliteral": "Yə-hū-ḏāh", "traducao_palavra": "Judá" },
        { "hebraico": "אֶתֵּ֥ן", "transliteral": "ʾet-tên", "traducao_palavra": "farei" },
