    "4": {
      "traducao_completa": "E cada um enganará o seu próximo, e não falarão a verdade; ensinaram a sua língua a falar mentiras, afadigam-se em praticar a iniquidade.",
      "palavras": [
        { "hebraico": "וְאִ֤ישׁ", "transliteral": "wə-ʾîš", "traducao_palavra": "E cada um" },
