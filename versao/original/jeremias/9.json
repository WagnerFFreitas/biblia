    "10": {
      "traducao_completa": "E farei de Jerusalém montões de pedras, morada de chacais, e as cidades de Judá porei em assolação, de sorte que ninguém nelas habite.",
      "palavras": [
        { "hebraico": "וְנָתַתִּ֧י", "transliteral": "wə-nā-ṯat-tî", "traducao_palavra": "E farei/porei" },
        { "hebraico": "אֶת־יְרוּשָׁלַ֛͏ִם", "transliteral": "ʾeṯ-Yə-rū-šā-la-im", "traducao_palavra": "Jerusalém" },
        { "hebraico": "לְגַלִּ֖ים", "transliteral": "lə-ḡal-lîm", "traducao_palavra": "em montões [de pedras]" },
