        { "hebraico": "אִ֣ישׁ", "transliteral": "ʾîš", "traducao_palavra": "homem/ninguém" },
        { "hebraico": "עֹבֵ֔ר", "transliteral": "ʿō-ḇêr", "traducao_palavra": "passar" },
        { "hebraico": "וְלֹ֥א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "שָׁמְע֖וּ", "transliteral": "šā-mə-ʿū", "traducao_palavra": "ouviram" },
