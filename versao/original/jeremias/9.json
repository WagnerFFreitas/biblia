    "6": {
      "traducao_completa": "Portanto assim diz YHWH dos Exércitos: Eis que eu os refinarei e os provarei; porque, de que outra maneira procederia eu com a filha do meu povo?",
      "palavras": [
        { "hebraico": "לָכֵ֗ן", "transliteral": "lā-ḵēn", "traducao_palavra": "Portanto" },
        { "hebraico": "כֹּ֤ה", "transliteral": "kōh", "traducao_palavra": "assim" },
        { "hebraico": "אָמַר֙", "transliteral": "ʾā-mar", "traducao_palavra": "disse" },
        { "hebraico": "יְהוָ֣ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "צְבָאֹ֔ות", "transliteral": "ṣə-ḇā-ʾō-wṯ", "traducao_palavra": "dos Exércitos" },
