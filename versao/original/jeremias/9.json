  "versiculos": {
    "1": {
      "traducao_completa": "Quem me dera no deserto um lugar de repouso de caminhantes! Então deixaria o meu povo e me afastaria deles; porque todos eles são adúlteros, uma assembleia de traidores.",
      "palavras": [
        { "hebraico": "מִֽי־", "transliteral": "mî-", "traducao_palavra": "Quem" },
        { "hebraico": "יִתְּנֵ֣נִי", "transliteral": "yit-tə-nê-nî", "traducao_palavra": "der/me dera" },
        { "hebraico": "בַמִּדְבָּ֗ר", "transliteral": "ḇam-miḏ-bār", "traducao_palavra": "no deserto" },
