        { "hebraico": "וּכְעָמִיר֙", "transliteral": "ū-ḵə-ʿā-mîr", "traducao_palavra": "e como manípulo/feixe" },
        { "hebraico": "מֵאַחֲרֵ֣י", "transliteral": "mê-ʾa-ḥă-rê", "traducao_palavra": "de trás de" },
        { "hebraico": "הַקֹּצֵ֔ר", "transliteral": "haq-qō-ṣēr", "traducao_palavra": "o ceifeiro" },
