      ]
    },
    "3": {
      "traducao_completa": "Guarde-se cada um do seu próximo, e em irmão nenhum confieis; porque todo irmão certamente enganará, e todo próximo anda caluniando.",
      "palavras": [
        { "hebraico": "אִ֤ישׁ", "transliteral": "ʾîš", "traducao_palavra": "Cada um" },
        { "hebraico": "מֵרֵעֵ֙הוּ֙", "transliteral": "mê-rē-ʿê-hū", "traducao_palavra": "do seu próximo" },
        { "hebraico": "הִשָּׁמֵ֔רוּ", "transliteral": "hiš-šā-mê-rū", "traducao_palavra": "guardai-vos" },
