    "9": {
      "traducao_completa": "Pelos montes levantarei choro e pranto, e pelas pastagens do deserto lamentação; porque foram queimadas, de modo que ninguém passa por elas; nem se ouve a voz do gado; desde as aves dos céus até aos animais, fugiram e se foram.",
      "palavras": [
        { "hebraico": "עַל־הֶהָרִים֙", "transliteral": "ʿal-he-hā-rîm", "traducao_palavra": "Sobre os montes" },
