        { "hebraico": "מֵֽאִתָּ֑ם", "transliteral": "mê-ʾit-tām", "traducao_palavra": "de junto deles" },
        { "hebraico": "כִּ֤י", "transliteral": "kî", "traducao_palavra": "porque" },
