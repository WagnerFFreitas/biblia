        { "hebraico": "מִבְּלִ֥י", "transliteral": "mib-bə-lî", "traducao_palavra": "sem" },
        { "hebraico": "יֹושֵֽׁב׃", "transliteral": "yō-šêḇ", "traducao_palavra": "morador." }
      ]
    },
    "11": {
      "traducao_completa": "Quem é o homem sábio, que entenda isto? E a quem falou a boca de YHWH, para que o possa anunciar? Por que pereceu a terra, e se queimou como o deserto, de sorte que ninguém passa por ela?",
      "palavras": [
        { "hebraico": "מִֽי־הָאִ֤ישׁ", "transliteral": "mî-hā-ʾîš", "traducao_palavra": "Quem [é] o homem" },
        { "hebraico": "הֶחָכָם֙", "transliteral": "he-ḥā-ḵām", "traducao_palavra": "sábio" },
        { "hebraico": "וְיָבֵ֣ן", "transliteral": "wə-yā-ḇên", "traducao_palavra": "que entenda" },
        { "hebraico": "אֶת־זֹ֔את", "transliteral": "ʾeṯ-zōṯ", "traducao_palavra": "isto?" },
        { "hebraico": "וַאֲשֶׁ֨ר", "transliteral": "wa-ʾă-šer", "traducao_palavra": "E a quem" },
        { "hebraico": "דִּבֶּ֧ר", "transliteral": "dib-ber", "traducao_palavra": "falou" },
        { "hebraico": "פִּֽי־יְהוָ֛ה", "transliteral": "pî-YHWH", "traducao_palavra": "a boca de YHWH" },
        { "hebraico": "אֵלָ֖יו", "transliteral": "ʾê-lāy-w", "traducao_palavra": "a ele" },
        { "hebraico": "וְיַגִּדָ֑הּ", "transliteral": "wə-yag-gi-ḏāh", "traducao_palavra": "para que a anuncie?" },
        { "hebraico": "עַל־מָה֙", "transliteral": "ʿal-māh", "traducao_palavra": "Por que" },
        { "hebraico": "אָבְדָ֣ה", "transliteral": "ʾāḇ-ḏāh", "traducao_palavra": "pereceu" },
        { "hebraico": "הָאָ֔רֶץ", "transliteral": "hā-ʾā-reṣ", "traducao_palavra": "a terra" },
        { "hebraico": "נִצְּתָ֥ה", "transliteral": "niṣ-ṣə-ṯāh", "traducao_palavra": "[e] queimou-se" },
        { "hebraico": "כַמִּדְבָּ֖ר", "transliteral": "ḵam-miḏ-bār", "traducao_palavra": "como o deserto" },
        { "hebraico": "מִבְּלִ֖י", "transliteral": "mib-bə-lî", "traducao_palavra": "sem [que]" },
        { "hebraico": "עֹבֵֽר׃", "transliteral": "ʿō-ḇêr", "traducao_palavra": "[ninguém] passe." }
      ]
    },
    "12": {
      "traducao_completa": "E disse YHWH: Porque deixaram a minha lei, que pus diante deles, e não deram ouvidos à minha voz, nem andaram nela;",
      "palavras": [
        { "hebraico": "וַיֹּ֣אמֶר", "transliteral": "way-yō-mer", "traducao_palavra": "E disse" },
        { "hebraico": "יְהוָ֔ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "עַל־עָזְבָם֙", "transliteral": "ʿal-ʿā-zə-ḇām", "traducao_palavra": "sobre o abandonarem eles" },
        { "hebraico": "אֶת־תֹּורָתִ֔י", "transliteral": "ʾeṯ-tō-w-rā-ṯî", "traducao_palavra": "a minha lei" },
        { "hebraico": "אֲשֶׁ֥ר", "transliteral": "ʾă-šer", "traducao_palavra": "que" },
        { "hebraico": "נָתַ֖תִּי", "transliteral": "nā-ṯat-tî", "traducao_palavra": "pus/dei" },
        { "hebraico": "לִפְנֵיהֶ֑ם", "transliteral": "lip̄-nê-hem", "traducao_palavra": "diante deles" },
        { "hebraico": "וְלֹא־שָׁמְע֥וּ", "transliteral": "wə-lō-šā-mə-ʿū", "traducao_palavra": "e não ouviram" },
        { "hebraico": "בְקֹולִ֖י", "transliteral": "ḇə-qō-w-lî", "traducao_palavra": "na minha voz" },
        { "hebraico": "וְלֹא־הָלְכ֥וּ", "transliteral": "wə-lō-hā-lə-ḵū", "traducao_palavra": "e não andaram" },
        { "hebraico": "בָֽהּ׃", "transliteral": "bāh", "traducao_palavra": "nela." }
      ]
    },
    "13": {
      "traducao_completa": "Antes andaram após a obstinação do seu coração, e após os Baais, como lhes ensinaram os seus pais.",
      "palavras": [
        { "hebraico": "וַיֵּלְכ֕וּ", "transliteral": "way-yê-lə-ḵū", "traducao_palavra": "E foram/andaram" },
        { "hebraico": "אַחֲרֵ֖י", "transliteral": "ʾa-ḥă-rê", "traducao_palavra": "após" },
        { "hebraico": "שְׁרִר֣וּת", "transliteral": "šə-ri-rūṯ", "traducao_palavra": "[a] obstinação de" },
        { "hebraico": "לִבָּ֑ם", "transliteral": "lib-bām", "traducao_palavra": "seu coração" },
        { "hebraico": "וְאַחֲרֵי֙", "transliteral": "wə-ʾa-ḥă-rê", "traducao_palavra": "e após" },
        { "hebraico": "הַבְּעָלִ֔ים", "transliteral": "hab-bə-ʿā-lîm", "traducao_palavra": "os Baais" },
        { "hebraico": "אֲשֶׁ֥ר", "transliteral": "ʾă-šer", "traducao_palavra": "[conforme] que" },
        { "hebraico": "לִמְּד֖וּם", "transliteral": "lim-mə-ḏūm", "traducao_palavra": "ensinaram-lhes" },
        { "hebraico": "אֲבֹותָֽם׃", "transliteral": "ʾă-ḇō-w-ṯām", "traducao_palavra": "seus pais." }
      ]
    },
    "14": {
      "traducao_completa": "Portanto assim diz YHWH dos Exércitos, o Deus de Israel: Eis que darei de comer losna a este povo, e lhes darei a beber água de fel.",
      "palavras": [
        { "hebraico": "לָכֵ֗ן", "transliteral": "lā-ḵēn", "traducao_palavra": "Portanto" },
        { "hebraico": "כֹּֽה־אָמַ֞ר", "transliteral": "kōh-ʾā-mar", "traducao_palavra": "assim disse" },
        { "hebraico": "יְהוָ֧ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "צְבָאֹות֙", "transliteral": "ṣə-ḇā-ʾō-wṯ", "traducao_palavra": "[dos] Exércitos" },
        { "hebraico": "אֱלֹהֵ֣י", "transliteral": "ʾĕ-lō-hê", "traducao_palavra": "Deus de" },
        { "hebraico": "יִשְׂרָאֵ֔ל", "transliteral": "yiś-rā-ʾēl", "traducao_palavra": "Israel" },
        { "hebraico": "הִנְנִ֧י", "transliteral": "hin-nî", "traducao_palavra": "eis que eu" },
        { "hebraico": "מַאֲכִילָ֛ם", "transliteral": "ma-ʾă-ḵî-lām", "traducao_palavra": "alimentando eles" },
        { "hebraico": "אֶת־הָעָ֥ם", "transliteral": "ʾeṯ-hā-ʿām", "traducao_palavra": "[com] o povo" },
        { "hebraico": "הַזֶּ֖ה", "transliteral": "haz-zeh", "traducao_palavra": "este" },
        { "hebraico": "לַעֲנָ֑ה", "transliteral": "la-ʿă-nāh", "traducao_palavra": "[com] losna/absinto" },
        { "hebraico": "וְהִשְׁקִיתִ֖ים", "transliteral": "wə-hiš-qî-ṯîm", "traducao_palavra": "e darei de beber a eles" },
        { "hebraico": "מֵי־רֹֽאשׁ׃", "transliteral": "mê-rōš", "traducao_palavra": "água de fel/veneno." }
      ]
    },
    "15": {
      "traducao_completa": "E os espalharei entre nações que nem eles nem seus pais conheceram; e enviarei a espada após eles, até que os venha a consumir.",
      "palavras": [
        { "hebraico": "וַהֲפִֽצֹותִים֙", "transliteral": "wa-hă-p̄î-ṣō-w-ṯîm", "traducao_palavra": "E espalharei eles" },
        { "hebraico": "בַּגֹּויִ֔ם", "transliteral": "bag-gō-w-yim", "traducao_palavra": "nas nações" },
        { "hebraico": "אֲשֶׁ֣ר", "transliteral": "ʾă-šer", "traducao_palavra": "que" },
        { "hebraico": "לֹא־יָדְע֔וּ", "transliteral": "lō-yā-ḏə-ʿū", "traducao_palavra": "não conheceram" },
        { "hebraico": "הֵ֖מָּה", "transliteral": "hêm-māh", "traducao_palavra": "eles" },
        { "hebraico": "וַאֲבֹותָ֑ם", "transliteral": "wa-ʾă-ḇō-w-ṯām", "traducao_palavra": "e seus pais" },
        { "hebraico": "וְשִׁלַּחְתִּ֤י", "transliteral": "wə-šil-laḥ-tî", "traducao_palavra": "e enviarei" },
        { "hebraico": "אַחֲרֵיהֶם֙", "transliteral": "ʾa-ḥă-rê-hem", "traducao_palavra": "atrás deles" },
        { "hebraico": "אֶת־הַחֶ֔רֶב", "transliteral": "ʾeṯ-ha-ḥe-reḇ", "traducao_palavra": "a espada" },
        { "hebraico": "עַ֥ד", "transliteral": "ʿaḏ", "traducao_palavra": "até" },
        { "hebraico": "כַּלֹּותִ֖י", "transliteral": "kal-lō-w-ṯî", "traducao_palavra": "meu consumir" },
        { "hebraico": "אֹותָֽם׃", "transliteral": "ʾō-w-ṯām", "traducao_palavra": "eles." }
      ]
    },
    "16": {
      "traducao_completa": "Assim diz YHWH dos Exércitos: Considerai, e chamai as carpideiras, para que venham; e enviai pelas peritas, para que venham;",
      "palavras": [
        { "hebraico": "כֹּ֣ה", "transliteral": "kōh", "traducao_palavra": "Assim" },
        { "hebraico": "אָמַ֞ר", "transliteral": "ʾā-mar", "traducao_palavra": "disse" },
        { "hebraico": "יְהוָ֣ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "צְבָאֹות֮", "transliteral": "ṣə-ḇā-ʾō-wṯ", "traducao_palavra": "Exércitos" },
        { "hebraico": "הִתְבֹּונְנּוּ֙", "transliteral": "hiṯ-bō-w-nə-nū", "traducao_palavra": "considerai/discerni" },
        { "hebraico": "וְקִרְא֣וּ", "transliteral": "wə-qir-ʾū", "traducao_palavra": "e chamai" },
        { "hebraico": "לַמְקֹונְנֹ֔ות", "transliteral": "lam-qō-w-nə-nō-wṯ", "traducao_palavra": "pelas carpideiras/lamentadoras" },
        { "hebraico": "וּתְבֹואֶ֑ינָה", "transliteral": "ū-ṯə-ḇō-w-ʾe-nāh", "traducao_palavra": "para que venham" },
        { "hebraico": "וְאֶל־הַחֲכָמֹ֥ות", "transliteral": "wə-ʾel-ha-ḥă-ḵā-mō-wṯ", "traducao_palavra": "e para as [mulheres] sábias/peritas" },
        { "hebraico": "שִׁלְח֖וּ", "transliteral": "šil-ḥū", "traducao_palavra": "enviai" },
        { "hebraico": "וְתָבֹֽואנָה׃", "transliteral": "wə-ṯā-ḇō-w-nāh", "traducao_palavra": "para que venham." }
      ]
    },
    "17": {
      "traducao_completa": "E apressem-se, e levantem sobre nós o seu lamento; e desçam lágrimas dos nossos olhos, e as nossas pálpebras destilem águas.",
      "palavras": [
        { "hebraico": "וּתְמַהֵ֕רְנָה", "transliteral": "ū-ṯə-ma-hêr-nāh", "traducao_palavra": "E que se apressem" },
        { "hebraico": "וְתִשֶּׂ֥נָה", "transliteral": "wə-ṯiś-śe-nāh", "traducao_palavra": "e levantem" },
        { "hebraico": "עָלֵ֖ינוּ", "transliteral": "ʿā-lê-nū", "traducao_palavra": "sobre nós" },
        { "hebraico": "נֶ֑הִי", "transliteral": "ne-hî", "traducao_palavra": "[um] lamento" },
        { "hebraico": "וְתֵרַ֧דְנָה", "transliteral": "wə-ṯê-raḏ-nāh", "traducao_palavra": "e desçam" },
        { "hebraico": "עֵינֵ֛ינוּ", "transliteral": "ʿê-nê-nū", "traducao_palavra": "[dos] nossos olhos" },
        { "hebraico": "דִּמְעָ֑ה", "transliteral": "dim-ʿāh", "traducao_palavra": "lágrima" },
        { "hebraico": "וְעַפְעַפֵּ֖ינוּ", "transliteral": "wə-ʿap̄-ʿap-pê-nū", "traducao_palavra": "e nossas pálpebras" },
        { "hebraico": "יִזְּלוּ־", "transliteral": "yiz-zə-lū-", "traducao_palavra": "derramem/destilem" },
        { "hebraico": "מָֽיִם׃", "transliteral": "mā-yim", "traducao_palavra": "águas." }
      ]
    },
    "18": {
      "traducao_completa": "Porque uma voz de lamento se ouviu de Sião: Como fomos assolados! Estamos mui envergonhados, porque deixamos a terra, porquanto derrubaram as nossas moradas.",
      "palavras": [
        { "hebraico": "כִּ֣י", "transliteral": "kî", "traducao_palavra": "Porque" },
        { "hebraico": "קֹ֥ול", "transliteral": "qō-wl", "traducao_palavra": "[a] voz de" },
        { "hebraico": "נְהִ֛י", "transliteral": "nə-hî", "traducao_palavra": "lamento" },
        { "hebraico": "נִשְׁמַ֥ע", "transliteral": "niš-ma-ʿ", "traducao_palavra": "foi ouvida" },
        { "hebraico": "מִצִּיֹּ֖ון", "transliteral": "miṣ-ṣiy-yō-wn", "traducao_palavra": "de Sião" },
        { "hebraico": "אֵ֣יךְ", "transliteral": "ʾêḵ", "traducao_palavra": "Como" },
        { "hebraico": "שֻׁדָּ֑דְנוּ", "transliteral": "šud-dā-ḏə-nū", "traducao_palavra": "fomos assolados/destruídos" },
        { "hebraico": "בֹּ֥שְׁנוּ", "transliteral": "bō-šə-nū", "traducao_palavra": "envergonhamo-nos" },
        { "hebraico": "מְאֹ֕ד", "transliteral": "mə-ʾōḏ", "traducao_palavra": "muito" },
        { "hebraico": "כִּֽי־עָזַ֥בְנוּ", "transliteral": "kî-ʿā-zaḇ-nū", "traducao_palavra": "porque deixamos" },
        { "hebraico": "אָ֑רֶץ", "transliteral": "ʾā-reṣ", "traducao_palavra": "[a] terra" },
        { "hebraico": "כִּ֥י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "הִשְׁלִ֖יכוּ", "transliteral": "hiš-lî-ḵū", "traducao_palavra": "derrubaram/lançaram abaixo" },
        { "hebraico": "מִשְׁכְּנֹותֵֽינוּ׃", "transliteral": "miš-kə-nō-w-ṯê-nū", "traducao_palavra": "nossas moradas." }
      ]
    },
    "19": {
      "traducao_completa": "Ouvi, pois, vós, mulheres, a palavra de YHWH, e receba o vosso ouvido a palavra da sua boca; e ensinai o lamento a vossas filhas, e cada uma à sua companheira a lamentação.",
      "palavras": [
        { "hebraico": "כִּֽי־שְׁמַ֤עְנָה", "transliteral": "kî-šə-ma-ʿ-nāh", "traducao_palavra": "Pois ouvi" },
        { "hebraico": "נָשִׁים֙", "transliteral": "nā-šîm", "traducao_palavra": "ó mulheres" },
        { "hebraico": "דְּבַר־יְהוָ֔ה", "transliteral": "də-ḇar-YHWH", "traducao_palavra": "a palavra de YHWH" },
        { "hebraico": "וְתִקַּ֥ח", "transliteral": "wə-ṯiq-qaḥ", "traducao_palavra": "e receba" },
        { "hebraico": "אָזְנְכֶ֖ם", "transliteral": "ʾāz-nə-ḵem", "traducao_palavra": "vosso ouvido" },
        { "hebraico": "דְּבַר־פִּ֑יו", "transliteral": "də-ḇar-pîw", "traducao_palavra": "a palavra da boca dele" },
        { "hebraico": "וְלַמֵּ֤דְנָה", "transliteral": "wə-lam-mêḏ-nāh", "traducao_palavra": "e ensinai" },
        { "hebraico": "בְנֹותֵיכֶם֙", "transliteral": "ḇə-nō-ṯê-ḵem", "traducao_palavra": "vossas filhas" },
        { "hebraico": "נֶ֔הִי", "transliteral": "ne-hî", "traducao_palavra": "[o] lamento" },
        { "hebraico": "וְאִשָּׁ֥ה", "transliteral": "wə-ʾiš-šāh", "traducao_palavra": "e cada mulher" },
        { "hebraico": "רְעוּתָ֖הּ", "transliteral": "rə-ʿū-ṯāh", "traducao_palavra": "à sua companheira" },
        { "hebraico": "קִינָֽה׃", "transliteral": "qî-nāh", "traducao_palavra": "lamentação." }
      ]
    },
    "20": {
      "traducao_completa": "Porque a morte subiu pelas nossas janelas, e entrou em nossos palácios, para exterminar as crianças das ruas e os jovens das praças.",
      "palavras": [
        { "hebraico": "כִּֽי־עָ֧לָה", "transliteral": "kî-ʿā-lāh", "traducao_palavra": "Porque subiu" },
        { "hebraico": "מָ֙וֶת֙", "transliteral": "mā-weṯ", "traducao_palavra": "[a] morte" },
        { "hebraico": "בְּחַלֹּונֵ֔ינוּ", "transliteral": "bə-ḥal-lō-w-nê-nū", "traducao_palavra": "em nossas janelas" },
        { "hebraico": "בָּ֖א", "transliteral": "bā", "traducao_palavra": "veio/entrou" },
