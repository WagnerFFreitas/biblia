        { "hebraico": "וְאַרְגָּמָ֛ן", "transliteral": "wə-ʾar-gā-mān", "traducao_palavra": "e púrpura" },
        { "hebraico": "לְבוּשָׁ֖ם", "transliteral": "lə-ḇū-šām", "traducao_palavra": "[é] a vestimenta deles" },
