        { "hebraico": "יְהוָ֗ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "אֶל־דֶּ֤רֶךְ", "transliteral": "ʾel-de-reḵ", "traducao_palavra": "para o caminho de" },
