        { "hebraico": "וּמֵאֹתֹ֥ות", "transliteral": "ū-mê-ʾō-ṯō-wṯ", "traducao_palavra": "e dos sinais de" },
        { "hebraico": "הַשָּׁמַ֖יִם", "transliteral": "haš-šā-ma-yim", "traducao_palavra": "os céus" },
