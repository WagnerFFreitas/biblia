        { "hebraico": "וּבְכָל־", "transliteral": "ū-ḇə-ḵāl-", "traducao_palavra": "e em todo" },
        { "hebraico": "מַלְכוּתָ֖ם", "transliteral": "mal-ḵū-ṯām", "traducao_palavra": "reino deles" },
        { "hebraico": "מֵאֵ֥ין", "transliteral": "mē-ʾên", "traducao_palavra": "não há [ninguém]" },
