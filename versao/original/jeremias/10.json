        { "hebraico": "חֲכָמִ֖ים", "transliteral": "ḥă-ḵā-mîm", "traducao_palavra": "sábios/peritos" },
        { "hebraico": "כֻּלָּֽם׃", "transliteral": "kul-lām", "traducao_palavra": "todos eles." }
      ]
    },
    "10": {
      "traducao_completa": "Mas YHWH Deus é a verdade; ele é o Deus vivo e o Rei eterno; ao seu furor treme a terra, e as nações não podem suportar a sua indignação.",
      "palavras": [
        { "hebraico": "וַֽיהוָ֥ה", "transliteral": "wa-YHWH", "traducao_palavra": "Mas YHWH" },
        { "hebraico": "אֱלֹהִ֛ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "[é] Deus" },
        { "hebraico": "אֱמֶ֖ת", "transliteral": "ʾĕ-meṯ", "traducao_palavra": "verdade" },
        { "hebraico": "הֽוּא־", "transliteral": "hū-", "traducao_palavra": "ele" },
        { "hebraico": "אֱלֹהִ֣ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "Deus" },
        { "hebraico": "חַיִּים֮", "transliteral": "ḥay-yîm", "traducao_palavra": "vivo" },
        { "hebraico": "וּמֶ֣לֶךְ", "transliteral": "ū-me-leḵ", "traducao_palavra": "e Rei" },
        { "hebraico": "עֹולָם֒", "transliteral": "ʿō-w-lām", "traducao_palavra": "eterno" },
        { "hebraico": "מִקִּצְפֹּו֙", "transliteral": "miq-qiṣ-pō-w", "traducao_palavra": "pelo seu furor" },
