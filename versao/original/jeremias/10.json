        { "hebraico": "יִֽירָאֲךָ֙", "transliteral": "yî-rā-ʾă-ḵā", "traducao_palavra": "temerá a ti" },
        { "hebraico": "מֶ֣לֶךְ", "transliteral": "me-leḵ", "traducao_palavra": "Rei de" },
        { "hebraico": "הַגֹּויִ֔ם", "transliteral": "hag-gō-w-yim", "traducao_palavra": "as nações?" },
        { "hebraico": "כִּ֥י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "לְךָ֖", "transliteral": "lə-ḵā", "traducao_palavra": "a ti" },
