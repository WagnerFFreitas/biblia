        { "hebraico": "גָּדֹ֥ול", "transliteral": "gā-ḏō-wl", "traducao_palavra": "grande [és]" },
        { "hebraico": "אַתָּ֛ה", "transliteral": "ʾat-tāh", "traducao_palavra": "tu" },
        { "hebraico": "וְגָדֹ֥ול", "transliteral": "wə-ḡā-ḏō-wl", "traducao_palavra": "e grande" },
