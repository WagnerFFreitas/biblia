        { "hebraico": "כֶּ֣סֶף", "transliteral": "ke-sep̄", "traducao_palavra": "Prata" },
        { "hebraico": "מְרֻקָּ֞ע", "transliteral": "mə-ruq-qā-ʿ", "traducao_palavra": "batida/estendida" },
        { "hebraico": "מִתַּרְשִׁ֣ישׁ", "transliteral": "mit-Tar-šîš", "traducao_palavra": "de Társis" },
