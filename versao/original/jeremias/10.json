        { "hebraico": "אֱלָהַיָּא֙", "transliteral": "ʾĕ-lā-hay-yā", "traducao_palavra": "[que] os deuses" },
        { "hebraico": "דִּֽי־", "transliteral": "dî-", "traducao_palavra": "que" },
