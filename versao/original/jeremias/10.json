      ]
    },
    "4": {
      "traducao_completa": "Com prata e com ouro a embeleza, com pregos e com martelos a firmam, para que não se mova.",
      "palavras": [
        { "hebraico": "בְּכֶ֥סֶף", "transliteral": "bə-ḵe-sep̄", "traducao_palavra": "Com prata" },
