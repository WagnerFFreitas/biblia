        { "hebraico": "בִּרְבֹ֤ות", "transliteral": "bir-ḇôṯ", "traducao_palavra": "No aumentar de" },
        { "hebraico": "הַטֹּובָה֙", "transliteral": "haṭ-ṭô-ḇā", "traducao_palavra": "o bem/fazenda" },
