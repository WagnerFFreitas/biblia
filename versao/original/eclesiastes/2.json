        { "hebraico": "בְּרֹאשֹׁ֔ו", "transliteral": "bə-rō-šô", "traducao_palavra": "na sua cabeça" },
        { "hebraico": "וְהַכְּסִ֖יל", "transliteral": "wə-hak-kə-sîl", "traducao_palavra": "mas o tolo" },
