        { "hebraico": "הַשָּֽׁמֶשׁ׃", "transliteral": "haš-šā-meš", "traducao_palavra": "o sol" }
      ]
    },
    "12": {
      "traducao_completa": "Então passei a contemplar a sabedoria, e a loucura e a estultícia; pois que fará o homem que vier depois do rei? Somente o que já se fez.",
      "palavras": [
        { "hebraico": "וּפָנִ֤יתִי", "transliteral": "ū-p̄ā-nî-ṯî", "traducao_palavra": "E voltei-me" },
        { "hebraico": "אֲנִי֙", "transliteral": "ʾă-nî", "traducao_palavra": "eu" },
        { "hebraico": "לִרְאֹ֣ות", "transliteral": "lir-ʾôṯ", "traducao_palavra": "para ver/contemplar" },
