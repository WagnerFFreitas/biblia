      ]
    },
    "20": {
      "traducao_completa": "Pelo que eu me voltei e entreguei o meu coração ao desespero, por todo o trabalho em que me afadiguei debaixo do sol.",
      "palavras": [
        { "hebraico": "וְסַבֹּותִ֖י", "transliteral": "wə-śab-bô-ṯî", "traducao_palavra": "E voltei-me" },
