        { "hebraico": "וּמִ֣י", "transliteral": "ū-mî", "traducao_palavra": "E quem" },
        { "hebraico": "יֹודֵ֗עַ", "transliteral": "yô-ḏê-aʿ", "traducao_palavra": "sabe" },
        { "hebraico": "הֶחָכָ֣ם", "transliteral": "he-ḥā-ḵām", "traducao_palavra": "[se] sábio" },
        { "hebraico": "יִהְיֶה֮", "transliteral": "yih-yeh", "traducao_palavra": "ele será" },
        { "hebraico": "אֹ֣ו", "transliteral": "ʾô", "traducao_palavra": "ou" },
        { "hebraico": "סָכָל֒", "transliteral": "śā-ḵāl", "traducao_palavra": "tolo?" },
        { "hebraico": "וְיִשְׁלַט֙", "transliteral": "wə-yiš-laṭ", "traducao_palavra": "e ele dominará" },
        { "hebraico": "בְּכָל־עֲמָלִ֔י", "transliteral": "bə-ḵāl-ʿă-mā-lî", "traducao_palavra": "em todo meu trabalho" },
        { "hebraico": "שֶׁעָמַ֧לְתִּי", "transliteral": "še-ʿā-mal-tî", "traducao_palavra": "em que trabalhei" },
        { "hebraico": "וְשֶׁחָכַ֖מְתִּי", "transliteral": "wə-še-ḥā-ḵam-tî", "traducao_palavra": "e em que fui sábio" },
        { "hebraico": "תַּ֣חַת", "transliteral": "ta-ḥaṯ", "traducao_palavra": "debaixo de" },
        { "hebraico": "הַשָּׁ֑מֶשׁ", "transliteral": "haš-šā-meš", "traducao_palavra": "o sol" },
        { "hebraico": "גַּם־זֶ֥ה", "transliteral": "gam-zeh", "traducao_palavra": "também isso" },
