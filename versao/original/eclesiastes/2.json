        { "hebraico": "וְיָדַ֣עְתִּי", "transliteral": "wə-yā-ḏa-ʿatî", "traducao_palavra": "e soube/entendi" },
        { "hebraico": "גַם־אָ֕נִי", "transliteral": "gam-ʾā-nî", "traducao_palavra": "também eu" },
