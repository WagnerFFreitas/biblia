        { "hebraico": "שֶׁיֵּ֥שׁ", "transliteral": "še-yyêš", "traducao_palavra": "que há" },
        { "hebraico": "יִתְרֹ֛ון", "transliteral": "yit-rôn", "traducao_palavra": "proveito/excelência" },
        { "hebraico": "לַֽחָכְמָ֖ה", "transliteral": "la-ḥā-ḵə-mā", "traducao_palavra": "para a sabedoria" },
        { "hebraico": "מִן־", "transliteral": "min-", "traducao_palavra": "mais que" },
        { "hebraico": "הַסִּכְל֑וּת", "transliteral": "has-siḵ-lût", "traducao_palavra": "a estultícia" },
        { "hebraico": "כִּיתְרֹ֥ון", "transliteral": "kî-ṯə-rôn", "traducao_palavra": "como a excelência de" },
        { "hebraico": "הָאֹ֖ור", "transliteral": "hā-ʾôr", "traducao_palavra": "a luz" },
        { "hebraico": "מִן־", "transliteral": "min-", "traducao_palavra": "sobre" },
        { "hebraico": "הַחֹֽשֶׁךְ׃", "transliteral": "ha-ḥō-šeḵ", "traducao_palavra": "as trevas" }
      ]
    },
    "14": {
      "traducao_completa": "O sábio tem os seus olhos na sua cabeça, mas o tolo anda em trevas; contudo entendi também que o mesmo sucesso ocorre a todos eles.",
