        { "hebraico": "וְסִכְל֑וּת", "transliteral": "wə-siḵ-lût", "traducao_palavra": "e estultícia" },
        { "hebraico": "כִּ֣י ׀", "transliteral": "kî", "traducao_palavra": "pois" },
