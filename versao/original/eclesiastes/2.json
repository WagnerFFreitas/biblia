        { "hebraico": "הַמַּעֲשֶׂ֔ה", "transliteral": "ham-ma-ʿă-śeh", "traducao_palavra": "a obra" },
        { "hebraico": "שֶׁנַּעֲשָׂ֖ה", "transliteral": "šen-na-ʿă-śā", "traducao_palavra": "que se faz" },
