        { "hebraico": "שֶׁאֲנִ֥י", "transliteral": "še-ʾă-nî", "traducao_palavra": "em que eu" },
        { "hebraico": "עָמֵ֖ל", "transliteral": "ʿā-mêl", "traducao_palavra": "trabalhei" },
        { "hebraico": "תַּ֣חַת", "transliteral": "ta-ḥaṯ", "traducao_palavra": "debaixo de" },
