        { "hebraico": "זִכְרֹ֧ון", "transliteral": "ziḵ-rôn", "traducao_palavra": "memória" },
        { "hebraico": "לֶחָכָ֛ם", "transliteral": "le-ḥā-ḵām", "traducao_palavra": "para o sábio" },
        { "hebraico": "עִם־הַכְּסִ֖יל", "transliteral": "ʿim-hak-kə-sîl", "traducao_palavra": "com o tolo" },
        { "hebraico": "לְעֹולָ֑ם", "transliteral": "lə-ʿô-lām", "traducao_palavra": "para sempre" },
        { "hebraico": "בְּשֶׁכְּבָ֞ר", "transliteral": "bə-šek-kə-ḇār", "traducao_palavra": "visto que já" },
        { "hebraico": "הַיָּמִ֤ים", "transliteral": "hay-yā-mîm", "traducao_palavra": "[nos] dias" },
        { "hebraico": "הַבָּאִים֙", "transliteral": "hab-bā-ʾîm", "traducao_palavra": "vindouros" },
