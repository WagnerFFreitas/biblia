        { "hebraico": "הַשָּׁ֑מֶשׁ", "transliteral": "haš-šā-meš", "traducao_palavra": "o sol" },
        { "hebraico": "כִּֽי־הַכֹּ֥ל", "transliteral": "kî-hak-kōl", "traducao_palavra": "porque tudo" },
        { "hebraico": "הֶ֖בֶל", "transliteral": "he-ḇel", "traducao_palavra": "[é] vaidade" },
        { "hebraico": "וּרְע֥וּת", "transliteral": "ū-rə-ʿûṯ", "traducao_palavra": "e correr atrás de" },
        { "hebraico": "רֽוּחַ׃", "transliteral": "rū-aḥ", "traducao_palavra": "espírito" }
      ]
    },
    "18": {
      "traducao_completa": "Também eu odiei todo o meu trabalho, em que trabalhei debaixo do sol, visto que eu havia de deixá-lo ao homem que viesse depois de mim.",
      "palavras": [
        { "hebraico": "וְשָׂנֵ֣אתִי", "transliteral": "wə-śā-nê-ṯî", "traducao_palavra": "E odiei" },
