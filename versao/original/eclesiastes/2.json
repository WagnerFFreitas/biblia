    "17": {
      "traducao_completa": "Pelo que odiei esta vida, porque a obra que se faz debaixo do sol me era penosa; porquanto tudo é vaidade e aflição de espírito.",
      "palavras": [
        { "hebraico": "וְשָׂנֵ֨אתִי֙", "transliteral": "wə-śā-nê-ṯî", "traducao_palavra": "E odiei" },
