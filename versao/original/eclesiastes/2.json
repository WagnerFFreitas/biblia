        { "hebraico": "חָכַ֛מְתִּי", "transliteral": "ḥā-ḵam-tî", "traducao_palavra": "fui sábio" },
        { "hebraico": "אֲנִ֖י", "transliteral": "ʾă-nî", "traducao_palavra": "eu" },
        { "hebraico": "אָ֣ז", "transliteral": "ʾāz", "traducao_palavra": "então" },
        { "hebraico": "יֹותֵ֑ר", "transliteral": "yô-ṯēr", "traducao_palavra": "mais/em excesso" },
        { "hebraico": "וְדִבַּ֣רְתִּי", "transliteral": "wə-ḏib-bar-tî", "traducao_palavra": "e falei" },
