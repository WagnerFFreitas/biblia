        { "hebraico": "נִשְׁכָּ֔ח", "transliteral": "niš-kāḥ", "traducao_palavra": "[será] esquecido" },
        { "hebraico": "וְאֵיךְ֙", "transliteral": "wə-ʾêḵ", "traducao_palavra": "e como" },
        { "hebraico": "יָמ֣וּת", "transliteral": "yā-mûṯ", "traducao_palavra": "morre" },
