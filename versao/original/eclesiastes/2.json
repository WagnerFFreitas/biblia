        { "hebraico": "שֶׁיִּהְיֶ֥ה", "transliteral": "še-yyih-yeh", "traducao_palavra": "que viria" },
        { "hebraico": "אַחֲרָֽי׃", "transliteral": "ʾa-ḥă-rāy", "traducao_palavra": "depois de mim" }
      ]
    },
    "19": {
      "traducao_completa": "E quem sabe se será sábio ou tolo? Contudo, ele se assenhoreará de todo o meu trabalho em que me afadiguei e em que me houve sabiamente debaixo do sol; também isso é vaidade.",
