        { "hebraico": "כְּמִקְרֵ֤ה", "transliteral": "kə-miq-rēh", "traducao_palavra": "como o evento de" },
        { "hebraico": "הַכְּסִיל֙", "transliteral": "hak-kə-sîl", "traducao_palavra": "o tolo" },
