        { "hebraico": "יִקְרֶ֥ה", "transliteral": "yiq-reh", "traducao_palavra": "ocorrerá" },
        { "hebraico": "אֶת־כֻּלָּֽם׃", "transliteral": "ʾeṯ-kul-lām", "traducao_palavra": "a todos eles" }
      ]
    },
    "15": {
      "traducao_completa": "Pelo que eu disse no meu coração: Como acontece ao tolo, assim me sucederá a mim; por que, pois, busquei eu mais a sabedoria? Então disse no meu coração que também isso era vaidade.",
      "palavras": [
        { "hebraico": "וְאָמַ֨רְתִּי", "transliteral": "wə-ʾā-mar-tî", "traducao_palavra": "E disse" },
