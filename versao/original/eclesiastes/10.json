        { "hebraico": "סִכְל֥וּת", "transliteral": "siḵ-lût", "traducao_palavra": "estultícia" },
        { "hebraico": "מְעָֽט׃", "transliteral": "mə-ʿāṭ", "traducao_palavra": "um pouco de" }
      ]
    },
    "2": {
      "traducao_completa": "O coração do sábio está à sua direita, mas o coração do tolo está à sua esquerda.",
