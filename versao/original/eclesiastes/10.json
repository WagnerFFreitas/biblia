        { "hebraico": "וְלֵב־", "transliteral": "wə-lêḇ-", "traducao_palavra": "mas o coração de" },
        { "hebraico": "כְּסִ֖יל", "transliteral": "kə-śîl", "traducao_palavra": "um tolo" },
        { "hebraico": "לִשְׂמֹאלֹֽו׃", "transliteral": "li-śə-mō-lô", "traducao_palavra": "à sua esquerda" }
      ]
    },
    "3": {
