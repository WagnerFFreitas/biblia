  "versiculos": {
    "1": {
      "traducao_completa": "As moscas mortas fazem o óleo do perfumista exalar mau cheiro; assim, um pouco de estultícia pesa mais do que a sabedoria e a honra.",
      "palavras": [
        { "hebraico": "זְב֣וּבֵי", "transliteral": "zə-ḇû-ḇê", "traducao_palavra": "Moscas de" },
        { "hebraico": "מָ֔וֶת", "transliteral": "mā-weṯ", "traducao_palavra": "morte/mortas" },
        { "hebraico": "יַבְאִ֥ישׁ", "transliteral": "yaḇ-ʾîš", "traducao_palavra": "fazem feder" },
