        { "hebraico": "תְּיַגְּעֶ֑נּוּ", "transliteral": "tə-yaḡ-gə-ʿen-nû", "traducao_palavra": "os fatiga/cansa" },
        { "hebraico": "אֲשֶׁ֥ר", "transliteral": "ʾă-šer", "traducao_palavra": "visto que" },
        { "hebraico": "לֹֽא־יָדַ֖ע", "transliteral": "lō-yā-ḏaʿ", "traducao_palavra": "não sabe" },
        { "hebraico": "לָלֶ֥כֶת", "transliteral": "lā-le-ḵeṯ", "traducao_palavra": "ir" },
        { "hebraico": "אֶל־עִֽיר׃", "transliteral": "ʾel-ʿîr", "traducao_palavra": "para a cidade" }
      ]
    },
    "16": {
      "traducao_completa": "Ai de ti, ó terra, cujo rei é criança e cujos príncipes banqueteiam de manhã!",
      "palavras": [
        { "hebraico": "אִֽי־לָ֣ךְ", "transliteral": "ʾî-lāḵ", "traducao_palavra": "Ai de ti" },
        { "hebraico": "אֶ֔רֶץ", "transliteral": "ʾe-reṣ", "traducao_palavra": "terra" },
        { "hebraico": "שֶׁמַּלְכֵּ֖ךְ", "transliteral": "šem-mal-kêḵ", "traducao_palavra": "que o teu rei" },
        { "hebraico": "נָ֑עַר", "transliteral": "nā-ʿar", "traducao_palavra": "[é] um jovem/servo" },
        { "hebraico": "וְשָׂרַ֖יִךְ", "transliteral": "wə-śā-ra-yiḵ", "traducao_palavra": "e teus príncipes" },
        { "hebraico": "בַּבֹּ֥קֶר", "transliteral": "bab-bō-qer", "traducao_palavra": "de manhã" },
        { "hebraico": "יֹאכֵֽלוּ׃", "transliteral": "yō-ḵê-lû", "traducao_palavra": "comem/banqueteiam" }
      ]
    },
    "17": {
      "traducao_completa": "Bem-aventurada tu, ó terra, cujo rei é filho de nobres, e cujos príncipes comem a seu tempo, para refazer as forças e não para bebedice!",
      "palavras": [
        { "hebraico": "אַשְׁרֵ֣יךְ", "transliteral": "ʾaš-rê-ḵə", "traducao_palavra": "Feliz tu/Bem-aventurada" },
        { "hebraico": "אֶ֔רֶץ", "transliteral": "ʾe-reṣ", "traducao_palavra": "terra" },
        { "hebraico": "שֶׁמַּלְכֵּ֖ךְ", "transliteral": "šem-mal-kêḵ", "traducao_palavra": "que o teu rei [é]" },
        { "hebraico": "בֶּן־חֹורִ֑ים", "transliteral": "ben-ḥô-rîm", "traducao_palavra": "filho de nobres/livres" },
        { "hebraico": "וְשָׂרַ֙יִךְ֙", "transliteral": "wə-śā-ra-yiḵ", "traducao_palavra": "e teus príncipes" },
        { "hebraico": "בָּעֵ֣ת", "transliteral": "bā-ʿêṯ", "traducao_palavra": "no tempo [certo]" },
        { "hebraico": "יֹאכֵ֔לוּ", "transliteral": "yō-ḵê-lû", "traducao_palavra": "comem" },
        { "hebraico": "בִּגְבוּרָ֖ה", "transliteral": "biḡ-ḇû-rā", "traducao_palavra": "com força/moderação" },
        { "hebraico": "וְלֹ֥א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "בַשְּׁתִֽי׃", "transliteral": "ḇaš-šə-ṯî", "traducao_palavra": "com bebedice" }
      ]
    },
    "18": {
      "traducao_completa": "Pela muita preguiça desaba o teto, e pela frouxidão das mãos goteja a casa.",
      "palavras": [
        { "hebraico": "בַּעֲצַלְתַּ֖יִם", "transliteral": "ba-ʿă-ṣal-ta-yim", "traducao_palavra": "Pela dupla preguiça/negligência" },
        { "hebraico": "יִמַּ֣ךְ", "transliteral": "yim-maḵ", "traducao_palavra": "abaixa-se/desaba" },
        { "hebraico": "הַמְּקָרֶ֑ה", "transliteral": "ham-mə-qā-reh", "traducao_palavra": "o teto/travejamento" },
        { "hebraico": "וּבְשִׁפְלַ֥ת", "transliteral": "ū-ḇə-šip̄-laṯ", "traducao_palavra": "e pela frouxidão de" },
        { "hebraico": "יָדַ֖יִם", "transliteral": "yā-ḏa-yim", "traducao_palavra": "mãos" },
        { "hebraico": "יִדְלֹ֥ף", "transliteral": "yiḏ-lōp̄", "traducao_palavra": "goteja/vaza" },
        { "hebraico": "הַבָּֽיִת׃", "transliteral": "hab-ba-yiṯ", "traducao_palavra": "a casa" }
      ]
    },
    "19": {
      "traducao_completa": "Para rir se fazem banquetes, e o vinho alegra a vida; e o dinheiro responde a tudo.",
      "palavras": [
        { "hebraico": "לִשְׂחֹוק֙", "transliteral": "liś-ḥôq", "traducao_palavra": "Para o riso" },
        { "hebraico": "עֹשִׂ֣ים", "transliteral": "ʿō-śîm", "traducao_palavra": "fazem" },
        { "hebraico": "לֶ֔חֶם", "transliteral": "le-ḥem", "traducao_palavra": "banquete/pão" },
        { "hebraico": "וְיַ֖יִן", "transliteral": "wə-ya-yin", "traducao_palavra": "e o vinho" },
        { "hebraico": "יְשַׂמַּ֣ח", "transliteral": "yə-śam-maḥ", "traducao_palavra": "alegra" },
        { "hebraico": "חַיִּ֑ים", "transliteral": "hay-yîm", "traducao_palavra": "a vida" },
        { "hebraico": "וְהַכֶּ֖סֶף", "transliteral": "wə-hak-ke-sep̄", "traducao_palavra": "e o dinheiro" },
        { "hebraico": "יַעֲנֶ֥ה", "transliteral": "ya-ʿă-neh", "traducao_palavra": "responde/atende" },
        { "hebraico": "אֶת־הַכֹּֽל׃", "transliteral": "ʾeṯ-hak-kōl", "traducao_palavra": "a tudo" }
      ]
    },
    "20": {
      "traducao_completa": "Nem ainda no teu pensamento amaldiçoes o rei, nem no mais interior do teu quarto amaldiçoes o rico; porque as aves do céu levariam a voz, e o que tem asas daria notícia do assunto.",
      "palavras": [
        { "hebraico": "גַּ֣ם", "transliteral": "gam", "traducao_palavra": "Também/Nem" },
        { "hebraico": "בְּּמַדָּֽעֲךָ֗", "transliteral": "bə-mad-dā-ʿă-ḵā", "traducao_palavra": "no teu pensamento" },
        { "hebraico": "מֶ֚לֶךְ", "transliteral": "me-leḵ", "traducao_palavra": "[o] rei" },
        { "hebraico": "אַל־תְּקַלֵּ֔ל", "transliteral": "ʾal-tə-qal-lêl", "traducao_palavra": "não amaldiçoes" },
        { "hebraico": "וּבְחַדְרֵי֙", "transliteral": "ū-ḇə-ḥaḏ-rê", "traducao_palavra": "e nos quartos de" },
        { "hebraico": "מִשְׁכָּבְךָ֔", "transliteral": "miš-kā-ḇə-ḵā", "traducao_palavra": "teu leito" },
        { "hebraico": "אַל־תְּקַלֵּ֖ל", "transliteral": "ʾal-tə-qal-lêl", "traducao_palavra": "não amaldiçoes" },
        { "hebraico": "עָשִׁ֑יר", "transliteral": "ʿā-šîr", "traducao_palavra": "[o] rico" },
        { "hebraico": "כִּ֣י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "עֹ֤וף", "transliteral": "ʿôp̄", "traducao_palavra": "[a] ave de" },
        { "hebraico": "הַשָּׁמַ֙יִם֙", "transliteral": "haš-šā-ma-yim", "traducao_palavra": "os céus" },
        { "hebraico": "יֹולִ֣יךְ", "transliteral": "yô-lîḵ", "traducao_palavra": "levará" },
        { "hebraico": "אֶת־הַקֹּ֔ול", "transliteral": "ʾeṯ-ha-qôl", "traducao_palavra": "a voz" },
        { "hebraico": "וּבַ֥עַל", "transliteral": "ū-ḇa-ʿal", "traducao_palavra": "e o dono de" },
        { "hebraico": "הַכְּנָפַ֖יִם", "transliteral": "hak-kə-nā-p̄a-yim", "traducao_palavra": "asas" },
        { "hebraico": "יַגֵּ֥יד", "transliteral": "yag-gêḏ", "traducao_palavra": "dirá/declarará" },
        { "hebraico": "דָּבָֽר׃", "transliteral": "dā-ḇār", "traducao_palavra": "[o] assunto" }
      ]
    }
  }
