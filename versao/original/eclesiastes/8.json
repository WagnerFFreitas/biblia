        { "hebraico": "הַשֶּׁ֔מֶשׁ", "transliteral": "haš-še-meš", "traducao_palavra": "o sol" },
        { "hebraico": "כִּ֠י", "transliteral": "kî", "traducao_palavra": "senão" },
        { "hebraico": "אִם־לֶאֱכֹ֥ל", "transliteral": "ʾim-le-ʾĕ-ḵōl", "traducao_palavra": "comer" },
        { "hebraico": "וְלִשְׁתֹּ֖ות", "transliteral": "wə-liš-tôṯ", "traducao_palavra": "e beber" },
        { "hebraico": "וְלִשְׂמֹ֑וחַ", "transliteral": "wə-liś-mô-aḥ", "traducao_palavra": "e alegrar-se" },
