        { "hebraico": "וְיֵ֣שׁ", "transliteral": "wə-yêš", "traducao_palavra": "e há" },
        { "hebraico": "רְשָׁעִ֗ים", "transliteral": "rə-šā-ʿîm", "traducao_palavra": "ímpios" },
