    "14": {
      "traducao_completa": "Há uma vaidade que se faz sobre a terra: que há justos a quem sucede segundo as obras dos ímpios, e há ímpios a quem sucede segundo as obras dos justos. Digo que também isto é vaidade.",
      "palavras": [
        { "hebraico": "יֶשׁ־הֶ֨בֶל֙", "transliteral": "yeš-he-ḇel", "traducao_palavra": "Há vaidade" },
        { "hebraico": "אֲשֶׁ֣ר", "transliteral": "ʾă-šer", "traducao_palavra": "que" },
        { "hebraico": "נַעֲשָׂ֣ה", "transliteral": "na-ʿă-śā", "traducao_palavra": "se faz" },
        { "hebraico": "עַל־הָאָ֔רֶץ", "transliteral": "ʿal-hā-ʾā-reṣ", "traducao_palavra": "sobre a terra" },
        { "hebraico": "אֲשֶׁ֣ר ׀ יֵ֣שׁ", "transliteral": "ʾă-šer yêš", "traducao_palavra": "que há" },
        { "hebraico": "צַדִּיקִ֗ים", "transliteral": "ṣad-dî-qîm", "traducao_palavra": "justos" },
        { "hebraico": "אֲשֶׁ֨ר מַגִּ֧יעַ", "transliteral": "ʾă-šer mag-gî-aʿ", "traducao_palavra": "a quem sucede/chega" },
        { "hebraico": "אֲלֵהֶ֛ם", "transliteral": "ʾă-lê-hem", "traducao_palavra": "a eles" },
