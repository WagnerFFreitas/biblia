        { "hebraico": "הַשָּׁ֑מֶשׁ", "transliteral": "haš-šā-meš", "traducao_palavra": "o sol" },
        { "hebraico": "עִ֚ם", "transliteral": "ʿim", "traducao_palavra": "com" },
