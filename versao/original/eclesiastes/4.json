        { "hebraico": "גַּ֣ם", "transliteral": "gam", "traducao_palavra": "também" },
        { "hebraico": "בְּמַלְכוּתֹ֔ו", "transliteral": "bə-mal-ḵû-ṯô", "traducao_palavra": "no seu reino" },
        { "hebraico": "נֹולַ֥ד", "transliteral": "nô-laḏ", "traducao_palavra": "[tinha] nascido" },
        { "hebraico": "רָֽשׁ׃", "transliteral": "rāš", "traducao_palavra": "pobre" }
      ]
    },
    "15": {
      "traducao_completa": "Vi a todos os viventes que andam debaixo do sun com a criança, o sucessor que ficará no lugar do rei.",
