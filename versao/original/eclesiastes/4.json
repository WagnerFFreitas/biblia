        { "hebraico": "לָהֶ֑ם", "transliteral": "lā-hem", "traducao_palavra": "para eles" },
        { "hebraico": "וּלְאֶחָ֖ד", "transliteral": "ū-lə-ʾe-ḥāḏ", "traducao_palavra": "mas para um" },
        { "hebraico": "אֵ֥יךְ", "transliteral": "ʾêḵ", "traducao_palavra": "como" },
        { "hebraico": "יֵחָֽם׃", "transliteral": "yê-ḥām", "traducao_palavra": "se aquecerá?" }
      ]
    },
    "12": {
      "traducao_completa": "E, se alguém prevalecer contra um, os dois lhe resistirão; e o cordão de três dobras não se quebra tão depressa.",
