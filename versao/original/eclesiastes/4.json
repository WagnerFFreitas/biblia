    "16": {
      "traducao_completa": "Não tem fim todo o povo que foi antes deles; tampouco os que vierem depois se alegrarão nele. Na verdade que também isto é vaidade e aflição de espírito.",
      "palavras": [
        { "hebraico": "אֵֽין־קֵ֣ץ", "transliteral": "ʾên-qēṣ", "traducao_palavra": "Não há fim" },
        { "hebraico": "לְכָל־הָעָ֗ם", "transliteral": "lə-ḵāl-hā-ʿām", "traducao_palavra": "para todo o povo" },
        { "hebraico": "לְכֹ֥ל", "transliteral": "lə-ḵōl", "traducao_palavra": "para tudo" },
        { "hebraico": "אֲשֶׁר־", "transliteral": "ʾă-šer-", "traducao_palavra": "que" },
