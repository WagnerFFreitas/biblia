        { "hebraico": "רָאִ֨יתִי֙", "transliteral": "rā-ʾî-ṯî", "traducao_palavra": "Vi" },
        { "hebraico": "אֶת־כָּל־", "transliteral": "ʾeṯ-kāl-", "traducao_palavra": "todos" },
        { "hebraico": "הַחַיִּ֔ים", "transliteral": "ha-ḥay-yîm", "traducao_palavra": "os viventes" },
        { "hebraico": "הַֽמְהַלְּכִ֖ים", "transliteral": "ham-hal-lə-ḵîm", "traducao_palavra": "que caminham/andam" },
