        { "hebraico": "לֹ֥א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "בִמְהֵרָ֖ה", "transliteral": "ḇi-mə-hê-rā", "traducao_palavra": "em pressa/depressa" },
        { "hebraico": "יִנָּתֵֽק׃", "transliteral": "yin-nā-ṯêq", "traducao_palavra": "se romperá/quebrará" }
      ]
    },
    "13": {
      "traducao_completa": "Melhor é a criança pobre e sábia do que o rei velho e insensato, que não se deixa mais admoestar.",
      "palavras": [
        { "hebraico": "טֹ֗וב", "transliteral": "ṭôḇ", "traducao_palavra": "Melhor [é]" },
        { "hebraico": "יֶ֧לֶד", "transliteral": "ye-leḏ", "traducao_palavra": "[um] jovem/criança" },
        { "hebraico": "מִסְכֵּן֙", "transliteral": "mis-kēn", "traducao_palavra": "pobre" },
        { "hebraico": "וְחָכָ֔ם", "transliteral": "wə-ḥā-ḵām", "traducao_palavra": "e sábio" },
        { "hebraico": "מִמֶּ֥לֶךְ", "transliteral": "mim-me-leḵ", "traducao_palavra": "do que um rei" },
        { "hebraico": "זָקֵ֖ן", "transliteral": "zā-qên", "traducao_palavra": "velho" },
        { "hebraico": "וּכְסִ֑יל", "transliteral": "ū-ḵə-śîl", "traducao_palavra": "e tolo" },
        { "hebraico": "אֲשֶׁ֛ר", "transliteral": "ʾă-šer", "traducao_palavra": "que" },
        { "hebraico": "לֹא־יָדַ֥ע", "transliteral": "lō-yā-ḏaʿ", "traducao_palavra": "não soube/pôde" },
        { "hebraico": "לְהִזָּהֵ֖ר", "transliteral": "lə-hiz-zā-hêr", "traducao_palavra": "ser avisado/admoestado" },
        { "hebraico": "עֹֽוד׃", "transliteral": "ʿôḏ", "traducao_palavra": "mais" }
      ]
    },
    "14": {
      "traducao_completa": "Porque um sai do cárcere para reinar; enquanto outro, que nasceu no seu reino, torna-se pobre.",
      "palavras": [
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "Porque" },
