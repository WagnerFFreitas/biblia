        { "hebraico": "הַשֵּׁנִ֔י", "transliteral": "haš-šê-nî", "traducao_palavra": "o segundo/sucessor" },
        { "hebraico": "אֲשֶׁ֥ר", "transliteral": "ʾă-šer", "traducao_palavra": "que" },
        { "hebraico": "יַעֲמֹ֖ד", "transliteral": "ya-ʿă-mōḏ", "traducao_palavra": "se levantará" },
        { "hebraico": "תַּחְתָּֽיו׃", "transliteral": "taḥ-tāyw", "traducao_palavra": "em lugar dele" }
