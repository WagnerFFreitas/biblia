        { "hebraico": "הָאֶחָ֔ד", "transliteral": "hā-ʾe-ḥāḏ", "traducao_palavra": "o um" },
        { "hebraico": "הַשְּׁנַ֖יִם", "transliteral": "haš-šə-na-yim", "traducao_palavra": "os dois" },
        { "hebraico": "יַעַמְד֣וּ", "transliteral": "ya-ʿam-ḏû", "traducao_palavra": "ficarão de pé/resistirão" },
        { "hebraico": "נֶגְדֹּ֑ו", "transliteral": "neḡ-dô", "traducao_palavra": "contra ele" },
