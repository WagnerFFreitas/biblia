        { "hebraico": "יָצָ֣א", "transliteral": "yā-ṣā", "traducao_palavra": "saiu" },
        { "hebraico": "לִמְלֹ֑ךְ", "transliteral": "lim-lōḵ", "traducao_palavra": "para reinar" },
