    "12": {
      "traducao_completa": "Pois o homem não sabe o seu tempo; como os peixes que se prendem na rede maligna, e como os passarinhos que se prendem no laço, assim se enlaçam também os filhos dos homens no tempo mau, quando este lhes sobrevem de repente.",
      "palavras": [
        { "hebraico": "כִּ֡י", "transliteral": "kî", "traducao_palavra": "Pois" },
        { "hebraico": "גַּ֣ם", "transliteral": "gam", "traducao_palavra": "também" },
        { "hebraico": "לֹֽא־יֵדַ֤ע", "transliteral": "lō-yê-ḏaʿ", "traducao_palavra": "não sabe" },
        { "hebraico": "הָאָדָם֙", "transliteral": "hā-ʾā-ḏām", "traducao_palavra": "o homem" },
