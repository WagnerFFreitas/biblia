      ]
    },
    "16": {
      "traducao_completa": "Então disse eu: Melhor é a sabedoria do que a força, ainda que a sabedoria do pobre seja desprezada, e as suas palavras não sejam ouvidas.",
      "palavras": [
        { "hebraico": "וְאָמַ֣רְתִּי", "transliteral": "wə-ʾā-mar-tî", "traducao_palavra": "E disse" },
        { "hebraico": "אֲנִ֔י", "transliteral": "ʾă-nî", "traducao_palavra": "eu" },
        { "hebraico": "טֹובָ֥ה", "transliteral": "ṭô-ḇā", "traducao_palavra": "melhor [é]" },
        { "hebraico": "חָכְמָ֖ה", "transliteral": "ḥā-ḵə-mā", "traducao_palavra": "[a] sabedoria" },
        { "hebraico": "מִגְּבוּרָ֑ה", "transliteral": "mig-gə-ḇû-rā", "traducao_palavra": "do que a força" },
        { "hebraico": "וְחָכְמַ֤ת", "transliteral": "wə-ḥā-ḵə-maṯ", "traducao_palavra": "embora a sabedoria de" },
        { "hebraico": "הַמִּסְכֵּן֙", "transliteral": "ham-mis-kên", "traducao_palavra": "o pobre" },
        { "hebraico": "בְּזוּיָ֔ה", "transliteral": "bə-zû-yā", "traducao_palavra": "[seja] desprezada" },
        { "hebraico": "וּדְבָרָ֖יו", "transliteral": "ū-ḏə-ḇā-rāyw", "traducao_palavra": "e as suas palavras" },
        { "hebraico": "אֵינָ֥ם", "transliteral": "ʾê-nām", "traducao_palavra": "não" },
        { "hebraico": "נִשְׁמָעִֽים׃", "transliteral": "niš-mā-ʿîm", "traducao_palavra": "ouvidas" }
      ]
    },
    "17": {
      "traducao_completa": "As palavras dos sábios ouvidas em silêncio valem mais do que o clamor do que domina entre os tolos.",
      "palavras": [
        { "hebraico": "דִּבְרֵ֣י", "transliteral": "diḇ-rê", "traducao_palavra": "As palavras de" },
        { "hebraico": "חֲכָמִים֮", "transliteral": "ḥă-ḵā-mîm", "traducao_palavra": "sábios" },
        { "hebraico": "בְּנַ֣חַת", "transliteral": "bə-na-ḥaṯ", "traducao_palavra": "em silêncio/descanso" },
        { "hebraico": "נִשְׁמָ֕עִים", "transliteral": "niš-mā-ʿîm", "traducao_palavra": "são ouvidas" },
        { "hebraico": "מִזַּעֲקַ֥ת", "transliteral": "miz-za-ʿă-qaṯ", "traducao_palavra": "mais que o clamor de" },
        { "hebraico": "מֹושֵׁ֖ל", "transliteral": "mô-šêl", "traducao_palavra": "[um] governante" },
        { "hebraico": "בַּכְּסִילִֽים׃", "transliteral": "bak-kə-śî-lîm", "traducao_palavra": "entre os tolos" }
      ]
    },
    "18": {
