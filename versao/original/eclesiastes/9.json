        { "hebraico": "כַּדָּגִים֮", "transliteral": "kad-dā-ḡîm", "traducao_palavra": "como os peixes" },
        { "hebraico": "שֶׁנֶּאֱחָזִים֙", "transliteral": "šen-ne-ʾĕ-ḥā-zîm", "traducao_palavra": "que são apanhados" },
        { "hebraico": "בִּמְצֹודָ֣ה", "transliteral": "bim-ṣô-ḏā", "traducao_palavra": "em rede" },
        { "hebraico": "רָעָ֔ה", "transliteral": "rā-ʿā", "traducao_palavra": "má" },
        { "hebraico": "וְכַצִּפֳּרִ֖ים", "transliteral": "wə-ḵaṣ-ṣip-pǒ-rîm", "traducao_palavra": "e como os pássaros" },
