    "10": {
      "traducao_completa": "Tudo quanto te vier à mão para fazer, faze-o conforme as tuas forças; porque na sepultura, para onde tu vais, não há obra, nem projeto, nem conhecimento, nem sabedoria alguma.",
      "palavras": [
        { "hebraico": "כֹּ֠ל", "transliteral": "kōl", "traducao_palavra": "Tudo" },
        { "hebraico": "אֲשֶׁ֨ר", "transliteral": "ʾă-šer", "traducao_palavra": "que" },
        { "hebraico": "תִּמְצָ֧א", "transliteral": "tim-ṣā", "traducao_palavra": "encontrar" },
