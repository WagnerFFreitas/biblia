        { "hebraico": "וּבָֽא־אֵלֶ֨יהָ", "transliteral": "ū-ḇā-ʾê-le-hā", "traducao_palavra": "e veio contra ela" },
        { "hebraico": "מֶ֤לֶךְ", "transliteral": "me-leḵ", "traducao_palavra": "[um] rei" },
        { "hebraico": "גָּדֹול֙", "transliteral": "gā-ḏôl", "traducao_palavra": "grande" },
        { "hebraico": "וְסָבַ֣ב", "transliteral": "wə-śā-ḇaḇ", "traducao_palavra": "e cercou" },
        { "hebraico": "אֹתָ֔הּ", "transliteral": "ʾō-ṯāh", "traducao_palavra": "a ela" },
        { "hebraico": "וּבָנָ֥ה", "transliteral": "ū-ḇā-nā", "traducao_palavra": "e edificou" },
        { "hebraico": "עָלֶ֖יהָ", "transliteral": "ʿā-le-hā", "traducao_palavra": "contra ela" },
        { "hebraico": "מְצֹודִ֥ים", "transliteral": "mə-ṣô-ḏîm", "traducao_palavra": "redes/baluartes" },
        { "hebraico": "גְּדֹלִֽים׃", "transliteral": "gə-ḏō-lîm", "traducao_palavra": "grandes" }
      ]
    },
    "15": {
      "traducao_completa": "E achou-se nela um sábio pobre, que livrou a cidade pela sua sabedoria, e ninguém se lembrava daquele pobre homem.",
      "palavras": [
        { "hebraico": "וּמָ֣צָא", "transliteral": "ū-mā-ṣā", "traducao_palavra": "E achou" },
        { "hebraico": "בָ֗הּ", "transliteral": "ḇāh", "traducao_palavra": "nela" },
        { "hebraico": "אִ֤ישׁ", "transliteral": "ʾîš", "traducao_palavra": "um homem" },
        { "hebraico": "מִסְכֵּן֙", "transliteral": "mis-kên", "traducao_palavra": "pobre" },
        { "hebraico": "חָכָ֔ם", "transliteral": "ḥā-ḵām", "traducao_palavra": "sábio" },
        { "hebraico": "וּמִלַּט־ה֥וּא", "transliteral": "ū-mil-laṭ-hû", "traducao_palavra": "e ele livrou" },
        { "hebraico": "אֶת־הָעִ֖יר", "transliteral": "ʾeṯ-hā-ʿîr", "traducao_palavra": "a cidade" },
        { "hebraico": "בְּחָכְמָתֹ֑ו", "transliteral": "bə-ḥā-ḵə-mā-ṯô", "traducao_palavra": "pela sua sabedoria" },
        { "hebraico": "וְאָדָם֙", "transliteral": "wə-ʾā-ḏām", "traducao_palavra": "mas homem" },
