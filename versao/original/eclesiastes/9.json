        { "hebraico": "וְרָאֹ֣ה", "transliteral": "wə-rā-ʾōh", "traducao_palavra": "e vi" },
        { "hebraico": "תַֽחַת־הַשֶּׁ֗מֶשׁ", "transliteral": "ta-ḥaṯ-haš-še-meš", "traducao_palavra": "debaixo do sol" },
