        { "hebraico": "לַגִּבֹּורִ֨ים", "transliteral": "lag-gib-bô-rîm", "traducao_palavra": "para os fortes" },
        { "hebraico": "הַמִּלְחָמָ֜ה", "transliteral": "ham-mil-ḥā-mā", "traducao_palavra": "a batalha" },
        { "hebraico": "וְגַ֣ם", "transliteral": "wə-ḡam", "traducao_palavra": "e também" },
        { "hebraico": "לֹ֧א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "לַחֲכָמִ֣ים", "transliteral": "la-ḥă-ḵā-mîm", "traducao_palavra": "para os sábios" },
