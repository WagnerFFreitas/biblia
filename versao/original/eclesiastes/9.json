        { "hebraico": "זָכַ֔ר", "transliteral": "zā-ḵar", "traducao_palavra": "lembrou-se" },
        { "hebraico": "אֶת־הָאִ֥ישׁ", "transliteral": "ʾeṯ-hā-ʾîš", "traducao_palavra": "daquele homem" },
        { "hebraico": "הַמִּסְכֵּ֖ן", "transliteral": "ham-mis-kên", "traducao_palavra": "o pobre" },
