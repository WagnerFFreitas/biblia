        { "hebraico": "וַאֲנָשִׁ֥ים", "transliteral": "wa-ʾă-nā-šîm", "traducao_palavra": "e homens" },
        { "hebraico": "בָּ֖הּ", "transliteral": "bāh", "traducao_palavra": "nela" },
