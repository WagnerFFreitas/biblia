        { "hebraico": "חָכְמָ֖ה", "transliteral": "ḥā-ḵə-mā", "traducao_palavra": "[como] sabedoria" },
        { "hebraico": "תַּ֣חַת", "transliteral": "ta-ḥaṯ", "traducao_palavra": "debaixo de" },
