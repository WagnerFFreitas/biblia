{
  "livro": "Salmos - תְּהִלִּים - Tə-hil-lîm",
  "capítulo": 8,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Ao mestre de canto, sobre Gitite. Salmo de Davi. YHWH, Senhor nosso, quão admirável é o teu nome em toda a terra! Tu que puseste a tua glória sobre os céus.",
      "palavras": [
        { "hebraico": "לַמְנַצֵּ֥חַ", "transliteral": "lam-naṣ-ṣê-aḥ", "traducao_palavra": "Ao mestre de canto" },
        { "hebraico": "עַֽל־", "transliteral": "ʿal-", "traducao_palavra": "sobre" },
        { "hebraico": "הַגִּתִּ֗ית", "transliteral": "ha-ḡit-tîṯ", "traducao_palavra": "Gitite [instrumento]" },
        { "hebraico": "מִזְמֹ֥ור", "transliteral": "miz-môr", "traducao_palavra": "salmo" },
        { "hebraico": "לְדָוִֽד׃", "transliteral": "lə-ḏā-wiḏ", "traducao_palavra": "de Davi" },
        { "hebraico": "יְהוָ֣ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "אֲדֹנֵינוּ֮", "transliteral": "ʾă-ḏō-nê-nū", "traducao_palavra": "Senhor nosso" },
        { "hebraico": "מָֽה־", "transliteral": "māh-", "traducao_palavra": "quão" },
        { "hebraico": "אַדִּ֥יר", "transliteral": "ʾad-dîr", "traducao_palavra": "admirável/majestoso" },
        { "hebraico": "שִׁמְךָ֗", "transliteral": "šim-ḵā", "traducao_palavra": "Teu nome" },
        { "hebraico": "בְּכָל־", "transliteral": "bə-ḵāl-", "traducao_palavra": "em toda" },
        { "hebraico": "הָאָ֥רֶץ", "transliteral": "hā-ʾā-reṣ", "traducao_palavra": "a terra" },
        { "hebraico": "אֲשֶׁר־", "transliteral": "ʾă-šer-", "traducao_palavra": "que" },
        { "hebraico": "תְּנָ֥ה", "transliteral": "tə-nā", "traducao_palavra": "puseste" },
        { "hebraico": "הֹודְךָ֗", "transliteral": "hō-w-ḏə-ḵā", "traducao_palavra": "Tua majestade/glória" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre" },
        { "hebraico": "הַשָּׁמָֽיִם׃", "transliteral": "haš-šā-mā-yim", "traducao_palavra": "os céus" }
      ]
    },
    "2": {
      "traducao_completa": "Da boca de crianças e de recém-nascidos estabeleceste força, por causa dos teus adversários, para fazer calar o inimigo e o vingador.",
      "palavras": [
        { "hebraico": "מִפִּ֤י", "transliteral": "mip-pî", "traducao_palavra": "Da boca de" },
        { "hebraico": "עֹולְלִ֨ים", "transliteral": "ʿô-lə-lîm", "traducao_palavra": "crianças" },
        { "hebraico": "וְֽיֹנְקִים֮", "transliteral": "wə-yō-nə-qîm", "traducao_palavra": "e de lactentes" },
        { "hebraico": "יִסַּ֪דְתָּ֫", "transliteral": "yis-śaḏ-tā", "traducao_palavra": "fundaste/estabeleceste" },
        { "hebraico": "עֹ֥ז", "transliteral": "ʿōz", "traducao_palavra": "força/louvor" },
        { "hebraico": "לְמַ֥עַן", "transliteral": "lə-ma-ʿan", "traducao_palavra": "por causa de" },
        { "hebraico": "צֹורְרֶ֑יךָ", "transliteral": "ṣō-w-rə-rey-ḵā", "traducao_palavra": "Teus adversários" },
        { "hebraico": "לְהַשְׁבִּ֥ית", "transliteral": "lə-haš-bîṯ", "traducao_palavra": "para fazer cessar" },
        { "hebraico": "אֹ֝ויֵ֗ב", "transliteral": "ʾô-yêḇ", "traducao_palavra": "[o] inimigo" },
        { "hebraico": "וּמִתְנַקֵּֽם׃", "transliteral": "ū-miṯ-naq-qêm", "traducao_palavra": "e o vingador" }
      ]
    },
    "3": {
      "traducao_completa": "Quando contemplo os teus céus, obra dos teus dedos, a lua e as estrelas que estabeleceste,",
      "palavras": [
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "Quando" },
        { "hebraico": "אֶרְאֶ֣ה", "transliteral": "ʾer-ʾeh", "traducao_palavra": "vejo/contemplo" },
        { "hebraico": "שָׁ֭מֶיךָ", "transliteral": "šā-mey-ḵā", "traducao_palavra": "Teus céus" },
        { "hebraico": "מַעֲשֵׂ֣i", "transliteral": "ma-ʿă-śê", "traducao_palavra": "obra de" },
        { "hebraico": "אֶצְבְּעֹתֶ֑יךָ", "transliteral": "ʾeṣ-bə-ʿō-ṯey-ḵā", "traducao_palavra": "Teus dedos" },
        { "hebraico": "יָרֵ֥חַ", "transliteral": "yā-rê-aḥ", "traducao_palavra": "[a] lua" },
        { "hebraico": "וְ֝כֹוכָבִ֗ים", "transliteral": "wə-ḵô-w-ḵā-ḇîm", "traducao_palavra": "e estrelas" },
        { "hebraico": "אֲשֶׁ֣ר", "transliteral": "ʾă-šer", "traducao_palavra": "que" },
        { "hebraico": "כֹּונָֽנְתָּה׃", "transliteral": "kô-w-nān-tā", "traducao_palavra": "estabeleceste" }
      ]
    },
    "4": {
      "traducao_completa": "Que é o homem mortal para que te lembres dele? E o filho do homem, para que o visites?",
      "palavras": [
        { "hebraico": "מָֽה־", "transliteral": "māh-", "traducao_palavra": "O que [é]" },
        { "hebraico": "אֱנֹ֥ושׁ", "transliteral": "ʾĕ-nô-wš", "traducao_palavra": "[o] homem mortal" },
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "para que" },
        { "hebraico": "תִזְכְּרֶ֑נּוּ", "transliteral": "ṯiz-kə-ren-nû", "traducao_palavra": "Te lembres dele" },
        { "hebraico": "וּבֶן־", "transliteral": "ū-ḇen-", "traducao_palavra": "e o filho de" },
        { "hebraico": "אָ֝דָ֗ם", "transliteral": "ʾā-ḏām", "traducao_palavra": "Adão/homem" },
        { "hebraico": "כִּ֣י", "transliteral": "kî", "traducao_palavra": "para que" },
        { "hebraico": "תִפְקְדֶֽנּוּ׃", "transliteral": "ṯip̄-qə-ḏen-nû", "traducao_palavra": "o visites/cuides" }
      ]
    },
    "5": {
      "traducao_completa": "Pois pouco menor o fizeste do que os anjos, e de glória e de honra o coroaste.",
      "palavras": [
        { "hebraico": "וַתְּחַסְּרֵ֣הוּ", "transliteral": "wat-tə-ḥaś-śə-rê-hū", "traducao_palavra": "E fizeste ele carecer" },
        { "hebraico": "מְּ֭עַט", "transliteral": "mə-ʿaṭ", "traducao_palavra": "um pouco" },
        { "hebraico": "מֵאֱלֹהִ֑ים", "transliteral": "mê-ʾĕ-lō-hîm", "traducao_palavra": "mais que os anjos/seres celestiais" },
        { "hebraico": "וְכָבֹ֖וד", "transliteral": "wə-ḵā-ḇôḏ", "traducao_palavra": "e com glória" },
        { "hebraico": "וְהָדָ֣ר", "transliteral": "wə-hā-ḏār", "traducao_palavra": "e honra" },
        { "hebraico": "תְּעַטְּרֵֽהוּ׃", "transliteral": "tə-ʿaṭ-ṭə-rê-hū", "traducao_palavra": "coroaste-o" }
      ]
    },
    "6": {
      "traducao_completa": "Fazes com que ele tenha domínio sobre as obras das tuas mãos; tudo puseste debaixo de seus pés:",
      "palavras": [
        { "hebraico": "תַּ֭מְשִׁילֵהוּ", "transliteral": "tam-šî-lê-hū", "traducao_palavra": "Fazes ele dominar" },
        { "hebraico": "בְּמַעֲשֵׂ֣i", "transliteral": "bə-ma-ʿă-śê", "traducao_palavra": "nas obras de" },
        { "hebraico": "יָדֶ֑יךָ", "transliteral": "yā-ḏey-ḵā", "traducao_palavra": "Tuas mãos" },
        { "hebraico": "כֹּ֝ל", "transliteral": "kōl", "traducao_palavra": "tudo" },
        { "hebraico": "שַׁ֣תָּה", "transliteral": "šat-tā", "traducao_palavra": "puseste" },
        { "hebraico": "תַֽחַת־", "transliteral": "ta-ḥaṯ-", "traducao_palavra": "debaixo de" },
        { "hebraico": "רַגְלָֽיו׃", "transliteral": "raḡ-lāyw", "traducao_palavra": "seus pés" }
      ]
    },
    "7": {
      "traducao_completa": "Todas as ovelhas e bois, assim como os animais do campo,",
      "palavras": [
        { "hebraico": "צֹנֶ֣ה", "transliteral": "ṣō-neh", "traducao_palavra": "Ovelhas" },
        { "hebraico": "וַאֲלָפִ֣ים", "transliteral": "wa-ʾă-lā-p̄îm", "traducao_palavra": "e bois" },
        { "hebraico": "כֻּלָּ֑ם", "transliteral": "kul-lām", "traducao_palavra": "todos eles" },
        { "hebraico": "וְ֝גַ֗ם", "transliteral": "wə-ḡam", "traducao_palavra": "e também" },
        { "hebraico": "בַּהֲמֹ֥ות", "transliteral": "ba-hă-mô-wṯ", "traducao_palavra": "os animais de" },
        { "hebraico": "שָׂדָֽי׃", "transliteral": "śā-ḏāy", "traducao_palavra": "campo" }
      ]
    },
    "8": {
      "traducao_completa": "As aves dos céus, e os peixes do mar, e tudo o que passa pelas veredas dos mares.",
      "palavras": [
        { "hebraico": "צִפֹּ֣ור", "transliteral": "ṣip-pôr", "traducao_palavra": "Ave de" },
        { "hebraico": "שָׁ֭מַיִם", "transliteral": "šā-ma-yim", "traducao_palavra": "céus" },
        { "hebraico": "וּדְגֵ֣i", "transliteral": "ū-ḏə-ḡê", "traducao_palavra": "e os peixes de" },
        { "hebraico": "הַיָּ֑ם", "transliteral": "hay-yām", "traducao_palavra": "o mar" },
        { "hebraico": "עֹ֝בֵר", "transliteral": "ʿō-ḇêr", "traducao_palavra": "[que] passa" },
        { "hebraico": "אָרְחֹ֥ות", "transliteral": "ʾār-ḥô-wṯ", "traducao_palavra": "[pelas] veredas de" },
        { "hebraico": "יַמִּֽים׃", "transliteral": "yam-mîm", "traducao_palavra": "mares" }
      ]
    },
    "9": {
      "traducao_completa": "YHWH, Senhor nosso, quão admirável é o teu nome em toda a terra!",
      "palavras": [
        { "hebraico": "יְהוָ֥ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "אֲדֹנֵ֑ינוּ", "transliteral": "ʾă-ḏō-nê-nū", "traducao_palavra": "Senhor nosso" },
        { "hebraico": "מָֽה־", "transliteral": "māh-", "traducao_palavra": "quão" },
        { "hebraico": "אַדִּ֥יר", "transliteral": "ʾad-dîr", "traducao_palavra": "admirável" },
        { "hebraico": "שִׁ֝מְךָ֗", "transliteral": "šim-ḵā", "traducao_palavra": "Teu nome" },
        { "hebraico": "בְּכָל־", "transliteral": "bə-ḵāl-", "traducao_palavra": "em toda" },
        { "hebraico": "הָאָֽרֶץ׃", "transliteral": "hā-ʾā-reṣ", "traducao_palavra": "a terra" }
      ]
    }
  }
}