        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "porque" },
        { "hebraico": "נָפַ֥ל", "transliteral": "nāp̄al", "traducao_palavra": "caiu" },
        { "hebraico": "פַּחְדָּ֝ם", "transliteral": "paḥdām", "traducao_palavra": "[o] pavor deles" },
