      ]
    },
    "14": {
      "traducao_completa": "Não permitiu que ninguém os oprimisse, e por amor deles repreendeu reis,",
      "palavras": [
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "הִנִּ֣יחַ", "transliteral": "hin-nî-aḥ", "traducao_palavra": "permitiu/deixou" },
