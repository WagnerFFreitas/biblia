        { "hebraico": "מְלָכִֽים׃", "transliteral": "mə-lā-ḵîm", "traducao_palavra": "reis" }
      ]
    },
    "15": {
      "traducao_completa": "Dizendo: Não toqueis nos meus ungidos, e não façais mal aos meus profetas.",
      "palavras": [
        { "hebraico": "אַֽל־", "transliteral": "ʾal-", "traducao_palavra": "não" },
