        { "hebraico": "שָׁבָֽר׃", "transliteral": "šā-ḇār", "traducao_palavra": "ele quebrou" }
      ]
    },
    "17": {
      "traducao_completa": "Enviou um homem adiante deles, a José, que foi vendido como escravo.",
