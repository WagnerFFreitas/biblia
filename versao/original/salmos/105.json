      ]
    },
    "13": {
      "traducao_completa": "Quando andavam de nação em nação e de um reino para outro povo;",
      "palavras": [
        { "hebraico": "וַ֭יִּתְהַלְּכוּ", "transliteral": "way-yiṯ-hal-lə-ḵû", "traducao_palavra": "e eles andaram" },
        { "hebraico": "מִגֹּ֣וי", "transliteral": "mig-gôy", "traducao_palavra": "de nação" },
        { "hebraico": "אֶל־", "transliteral": "ʾel-", "traducao_palavra": "para" },
        { "hebraico": "גֹּ֑וי", "transliteral": "gôy", "traducao_palavra": "nação" },
        { "hebraico": "מִ֝מַּמְלָכָ֗ה", "transliteral": "mim-mam-lā-ḵā", "traducao_palavra": "de um reino" },
