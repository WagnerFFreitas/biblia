{
  "livro": "Salmos - תְּהִלִּים - Tehillim",
  "capítulo": 105,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Rendei graças a YHWH, invocai o seu nome; fazei conhecidos os seus feitos entre os povos.",
      "palavras": [
        { "hebraico": "הֹוד֣וּ", "transliteral": "hô-ḏû", "traducao_palavra": "rendei graças" },
        { "hebraico": "לַיהוָ֣ה", "transliteral": "lay-hwāh", "traducao_palavra": "a YHWH" },
        { "hebraico": "קִרְא֬וּ", "transliteral": "qir-ʾû", "traducao_palavra": "invocai" },
        { "hebraico": "בִשְׁמֹ֑ו", "transliteral": "biš-mô", "traducao_palavra": "no nome dele" },
        { "hebraico": "הֹודִ֥יעוּ", "transliteral": "hô-ḏî-ʿû", "traducao_palavra": "fazei saber/conhecido" },
        { "hebraico": "בָ֝עַמִּ֗ים", "transliteral": "ḇā-ʿam-mîm", "traducao_palavra": "entre os povos" },
        { "hebraico": "עֲלִילֹותָֽיו׃", "transliteral": "ʿă-lî-lô-ṯāw", "traducao_palavra": "os seus feitos" }
      ]
    },
    "2": {
      "traducao_completa": "Cantai-lhe, salmodiai-lhe; falai de todas as suas maravilhas.",
      "palavras": [
        { "hebraico": "שִֽׁירוּ־", "transliteral": "šî-rû-", "traducao_palavra": "cantai" },
        { "hebraico": "לֹ֭ו", "transliteral": "lô", "traducao_palavra": "a ele" },
        { "hebraico": "זַמְּרוּ־", "transliteral": "zam-mə-rû-", "traducao_palavra": "salmodiai" },
        { "hebraico": "לֹ֑ו", "transliteral": "lô", "traducao_palavra": "a ele" },
        { "hebraico": "שִׂ֝יחוּ", "transliteral": "śî-ḥû", "traducao_palavra": "falai/meditai" },
        { "hebraico": "בְּכָל־", "transliteral": "bə-ḵāl-", "traducao_palavra": "em todas" },
        { "hebraico": "נִפְלְאֹותָֽיו׃", "transliteral": "nip̄-lə-ʾô-ṯāw", "traducao_palavra": "suas maravilhas" }
      ]
    },
    "3": {
      "traducao_completa": "Gloriai-vos no seu santo nome; alegre-se o coração dos que buscam a YHWH.",
      "palavras": [
        { "hebraico": "הִֽתְהַלְל֗וּ", "transliteral": "hiṯ-hal-lə-lû", "traducao_palavra": "gloriai-vos" },
        { "hebraico": "בְּשֵׁ֣ם", "transliteral": "bə-šēm", "traducao_palavra": "no nome de" },
        { "hebraico": "קָדְשֹׁ֑ו", "transliteral": "qāḏ-šô", "traducao_palavra": "sua santidade" },
        { "hebraico": "יִשְׂמַח", "transliteral": "yiś-maḥ", "traducao_palavra": "alegre-se" },
        { "hebraico": "לֵ֝ב", "transliteral": "lēḇ", "traducao_palavra": "[o] coração de" },
        { "hebraico": "מְבַקְשֵׁ֥י", "transliteral": "mə-ḇaq-šê", "traducao_palavra": "[os que] buscam" },
        { "hebraico": "יְהוָֽה׃", "transliteral": "YHWH", "traducao_palavra": "YHWH" }
      ]
    },
    "4": {
      "traducao_completa": "Buscai a YHWH e a sua força; buscai a sua face continuamente.",
      "palavras": [
        { "hebraico": "דִּרְשׁ֣וּ", "transliteral": "dir-šû", "traducao_palavra": "buscai" },
        { "hebraico": "יְהוָ֣ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "וְעֻזֹּ֑ו", "transliteral": "wə-ʿuz-zô", "traducao_palavra": "e sua força" },
        { "hebraico": "בַּקְּשׁ֖וּ", "transliteral": "baq-qə-šû", "traducao_palavra": "buscai" },
        { "hebraico": "פָנָ֣יו", "transliteral": "p̄ā-nāw", "traducao_palavra": "face dele" },
        { "hebraico": "תָּמִֽיד׃", "transliteral": "tā-mîḏ", "traducao_palavra": "continuamente" }
      ]
    },
    "5": {
      "traducao_completa": "Lembrai-vos das maravilhas que ele fez, dos seus prodígios e dos juízos da sua boca.",
      "palavras": [
        { "hebraico": "זִכְר֗וּ", "transliteral": "ziḵ-rû", "traducao_palavra": "lembrai-vos" },
