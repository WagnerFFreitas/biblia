        { "hebraico": "אֶת־", "transliteral": "ʾeṯ-", "traducao_palavra": "[objeto]" },
        { "hebraico": "עַמֹּ֣ו", "transliteral": "ʿam-mô", "traducao_palavra": "povo dele" },
        { "hebraico": "מְאֹ֑ד", "transliteral": "mə-ʾōḏ", "traducao_palavra": "muito" },
