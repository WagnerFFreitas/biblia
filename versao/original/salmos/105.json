        { "hebraico": "וְזָהָ֑ב", "transliteral": "wəzāhāḇ", "traducao_palavra": "e ouro" },
        { "hebraico": "וְאֵ֖ין", "transliteral": "wəʾên", "traducao_palavra": "e não [havia]" },
        { "hebraico": "בִּשְׁבָטָ֣יו", "transliteral": "bišḇāṭāyw", "traducao_palavra": "em tribos dele" },
