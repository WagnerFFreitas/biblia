    "38": {
      "traducao_completa": "O Egito alegrou-se quando eles saíram, porque o seu temor caíra sobre eles.",
      "palavras": [
        { "hebraico": "שָׂמַ֣ח", "transliteral": "śāmaḥ", "traducao_palavra": "alegrou-se" },
