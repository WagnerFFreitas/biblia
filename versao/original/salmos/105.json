        { "hebraico": "וַיַּחְשִׁ֑ךְ", "transliteral": "way-yaḥ-šîḵ", "traducao_palavra": "e fez escurecer" },
        { "hebraico": "וְלֹֽא־", "transliteral": "wə-lō-", "traducao_palavra": "e não" },
