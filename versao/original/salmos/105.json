        { "hebraico": "בְּנֵ֖י", "transliteral": "bə-nê", "traducao_palavra": "filhos de" },
        { "hebraico": "יַעֲקֹ֣ב", "transliteral": "ya-ʿă-qōḇ", "traducao_palavra": "Jacó" },
