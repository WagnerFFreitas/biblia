      ]
    },
    "16": {
      "traducao_completa": "Chamou a fome sobre a terra; quebrou todo o sustento do pão.",
      "palavras": [
        { "hebraico": "וַיִּקְרָ֣א", "transliteral": "way-yiq-rā", "traducao_palavra": "e ele chamou" },
