        { "hebraico": "וַיַתִּירֵ֑הוּ", "transliteral": "way-yat-tî-rē-hû", "traducao_palavra": "e soltou-o" },
        { "hebraico": "מֹשֵׁ֥ל", "transliteral": "mō-šēl", "traducao_palavra": "[o] dominador de" },
