        { "hebraico": "אֶת־", "transliteral": "ʾeṯ-", "traducao_palavra": "com" },
        { "hebraico": "אַבְרָהָ֑ם", "transliteral": "ʾaḇ-rā-hām", "traducao_palavra": "Abraão" },
        { "hebraico": "וּשְׁב֖וּעָתֹ֥ו", "transliteral": "ū-šə-ḇû-ʿā-ṯô", "traducao_palavra": "e seu juramento" },
