        { "hebraico": "בְּכֹ֣ור", "transliteral": "bəḵôr", "traducao_palavra": "primogênito" },
        { "hebraico": "בְּאַרְצָ֑ם", "transliteral": "bəʾarṣām", "traducao_palavra": "na terra deles" },
        { "hebraico": "רֵ֝אשִׁ֗ית", "transliteral": "rēšîṯ", "traducao_palavra": "princípio/primícias de" },
