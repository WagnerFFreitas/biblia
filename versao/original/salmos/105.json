        { "hebraico": "לְדָ֑ם", "transliteral": "lə-ḏām", "traducao_palavra": "em sangue" },
        { "hebraico": "וַ֝יָּ֗מֶת", "transliteral": "way-yā-meṯ", "traducao_palavra": "e fez morrer" },
        { "hebraico": "אֶת־", "transliteral": "ʾeṯ-", "traducao_palavra": "[objeto]" },
