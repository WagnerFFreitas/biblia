        { "hebraico": "אָדֹ֨ון", "transliteral": "ʾā-ḏôn", "traducao_palavra": "[como] senhor" },
        { "hebraico": "לְבֵיתֹ֑ו", "transliteral": "lə-ḇê-ṯô", "traducao_palavra": "para sua casa" },
        { "hebraico": "וּ֝מֹשֵׁ֗ל", "transliteral": "ū-mō-šēl", "traducao_palavra": "e dominador/regente" },
        { "hebraico": "בְּכָל־", "transliteral": "bə-ḵāl-", "traducao_palavra": "em todas" },
