        { "hebraico": "לְ֝יִשְׂרָאֵ֗ל", "transliteral": "lə-yiś-rā-ʾēl", "traducao_palavra": "a Israel" },
        { "hebraico": "בְּרִ֣ית", "transliteral": "bə-rîṯ", "traducao_palavra": "[por] aliança" },
