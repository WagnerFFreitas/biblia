        { "hebraico": "אֲשֶׁר־", "transliteral": "ʾă-šer-", "traducao_palavra": "que" },
        { "hebraico": "עָשָׂ֑ה", "transliteral": "ʿā-śā", "traducao_palavra": "ele fez" },
        { "hebraico": "מֹ֝פְתָ֗יו", "transliteral": "mō-p̄ə-ṯāw", "traducao_palavra": "seus prodígios" },
        { "hebraico": "וּמִשְׁפְּטֵי־", "transliteral": "ū-miš-pə-ṭê-", "traducao_palavra": "e os juízos de" },
        { "hebraico": "פִֽיו׃", "transliteral": "p̄îw", "traducao_palavra": "sua boca" }
      ]
    },
    "6": {
      "traducao_completa": "Vós, descendência de Abraão, seu servo, vós, filhos de Jacó, seus escolhidos.",
      "palavras": [
        { "hebraico": "זֶ֭רַע", "transliteral": "ze-raʿ", "traducao_palavra": "semente/descendência de" },
