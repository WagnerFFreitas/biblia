        { "hebraico": "עֵ֣שֶׂב", "transliteral": "ʿēśeḇ", "traducao_palavra": "erva" },
        { "hebraico": "בְּאַרְצָ֑ם", "transliteral": "bəʾarṣām", "traducao_palavra": "na terra deles" },
        { "hebraico": "וַ֝יֹּ֗אכַל", "transliteral": "wayyōʾḵal", "traducao_palavra": "e comeu" },
        { "hebraico": "פְּרִ֣י", "transliteral": "pərî", "traducao_palavra": "[o] fruto de" },
