        { "hebraico": "אֹtextֹתָ֑יו", "transliteral": "ʾô-ṯô-ṯāyw", "traducao_palavra": "sinais dele" },
        { "hebraico": "וּ֝מֹפְתִ֗ים", "transliteral": "ū-mō-p̄ə-ṯîm", "traducao_palavra": "e prodígios" },
        { "hebraico": "בְּאֶ֣רֶץ", "transliteral": "bə-ʾe-reṣ", "traducao_palavra": "na terra de" },
        { "hebraico": "חָֽם׃", "transliteral": "ḥām", "traducao_palavra": "Cam" }
      ]
    },
    "28": {
      "traducao_completa": "Mandou trevas e as fez escurecer; e não foram rebeldes à sua palavra.",
