      ]
    },
    "7": {
      "traducao_completa": "Ele é YHWH, nosso Deus; os seus juízos estão em toda a terra.",
      "palavras": [
        { "hebraico": "ה֤וּא", "transliteral": "hû", "traducao_palavra": "ele [é]" },
        { "hebraico": "יְהוָ֣ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "אֱלֹהֵ֑ינוּ", "transliteral": "ʾĕ-lō-hê-nû", "traducao_palavra": "Deus nosso" },
        { "hebraico": "בְּכָל־", "transliteral": "bə-ḵāl-", "traducao_palavra": "em toda" },
        { "hebraico": "הָ֝אָ֗רֶץ", "transliteral": "hā-ʾā-reṣ", "traducao_palavra": "a terra" },
        { "hebraico": "מִשְׁפָּטָֽיו׃", "transliteral": "miš-pā-ṭāyw", "traducao_palavra": "[estão] seus juízos" }
      ]
    },
    "8": {
      "traducao_completa": "Lembrou-se para sempre da sua aliança, da palavra que mandou a mil gerações.",
      "palavras": [
        { "hebraico": "זָכַ֣ר", "transliteral": "zā-ḵar", "traducao_palavra": "lembrou-se" },
        { "hebraico": "לְעֹולָ֣ם", "transliteral": "lə-ʿô-lām", "traducao_palavra": "para sempre" },
        { "hebraico": "בְּרִיתֹ֑ו", "transliteral": "bə-rî-ṯô", "traducao_palavra": "sua aliança" },
        { "hebraico": "דָּבָ֥ר", "transliteral": "dā-ḇār", "traducao_palavra": "[a] palavra" },
        { "hebraico": "צִ֝וָּ֗ה", "transliteral": "ṣiw-wā", "traducao_palavra": "ordenou" },
