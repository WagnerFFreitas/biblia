        { "hebraico": "עַמֹּ֑ו", "transliteral": "ʿam-mô", "traducao_palavra": "seu povo" },
        { "hebraico": "לְ֝הִתְנַכֵּ֗ל", "transliteral": "lə-hiṯ-nak-kēl", "traducao_palavra": "para conspirar/agir astutamente" },
