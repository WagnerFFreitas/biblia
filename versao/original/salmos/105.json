      ]
    },
    "12": {
      "traducao_completa": "Quando eram poucos homens em número, sim, muito poucos, e estrangeiros nela;",
      "palavras": [
        { "hebraico": "בִּ֭הְיֹותָם", "transliteral": "bih-yô-ṯām", "traducao_palavra": "no serem eles" },
        { "hebraico": "מְתֵ֣י", "transliteral": "mə-ṯê", "traducao_palavra": "homens de" },
        { "hebraico": "מִסְפָּ֑ר", "transliteral": "mis-pār", "traducao_palavra": "número/contáveis" },
        { "hebraico": "כִּ֝מְעַ֗ט", "transliteral": "kim-ʿaṭ", "traducao_palavra": "como pouco/quase nada" },
