        { "hebraico": "לֵאמֹ֗ר", "transliteral": "lê-mōr", "traducao_palavra": "dizendo" },
        { "hebraico": "לְךָ֗", "transliteral": "lə-ḵā", "traducao_palavra": "a ti" },
        { "hebraico": "אֶתֵּ֥ן", "transliteral": "ʾet-tēn", "traducao_palavra": "darei" },
        { "hebraico": "אֶת־", "transliteral": "ʾeṯ-", "traducao_palavra": "[objeto]" },
        { "hebraico": "אֶֽרֶץ־", "transliteral": "ʾe-reṣ-", "traducao_palavra": "terra de" },
        { "hebraico": "כְּנָ֑עַן", "transliteral": "kə-nā-ʿan", "traducao_palavra": "Canaã" },
