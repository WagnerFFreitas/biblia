        { "hebraico": "יְגִיל֣וּן", "transliteral": "yə-ḡî-lûn", "traducao_palavra": "eles exultarão" },
        { "hebraico": "כָּל־", "transliteral": "kāl-", "traducao_palavra": "todo" },
        { "hebraico": "הַיֹּ֑ום", "transliteral": "hay-yôm", "traducao_palavra": "o dia" },
        { "hebraico": "וּבְצִדְקָתְךָ֥", "transliteral": "ū-ḇiṣ-ḏā-qā-ṯə-ḵā", "traducao_palavra": "e em tua justiça" },
        { "hebraico": "יָרֽוּמוּ׃", "transliteral": "yā-rû-mû", "traducao_palavra": "serão exaltados" }
      ]
    },
    "17": {
      "traducao_completa": "Pois tu és a glória da sua força; e pelo teu favor será exaltado o nosso poder.",
      "palavras": [
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "porque" },
        { "hebraico": "תִפְאֶ֣רֶת", "transliteral": "ṯip̄-ʾe-reṯ", "traducao_palavra": "[a] glória de" },
        { "hebraico": "עֻזָּ֣מֹו", "transliteral": "uz-zā-mô", "traducao_palavra": "força deles" },
        { "hebraico": "אָ֑תָּה", "transliteral": "ʾāt-tā", "traducao_palavra": "és tu" },
        { "hebraico": "וּ֝בִרְצֹונְךָ֗", "transliteral": "ū-ḇir-ṣô-nə-ḵā", "traducao_palavra": "e em teu favor/vontade" },
        { "hebraico": "תָּר֥וּם", "transliteral": "tā-rûm", "traducao_palavra": "será levantada" },
        { "hebraico": "קַרְנֵֽנוּ׃", "transliteral": "qar-nê-nû", "traducao_palavra": "nossa fronte/força" }
      ]
    },
    "18": {
      "traducao_completa": "Porque YHWH é o nosso escudo, e o Santo de Israel o nosso Rei.",
      "palavras": [
        { "hebraico": "כִּ֣י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "לַֽ֭יהוָה", "transliteral": "lay-hwāh", "traducao_palavra": "a YHWH [pertence]" },
        { "hebraico": "מָֽגִנֵּ֑נוּ", "transliteral": "mā-ḡin-nê-nû", "traducao_palavra": "nosso escudo" },
        { "hebraico": "וְלִקְדֹ֥ושׁ", "transliteral": "wə-liq-ḏôš", "traducao_palavra": "e ao Santo de" },
        { "hebraico": "יִ֝שְׂרָאֵ֗ל", "transliteral": "yiś-rā-ʾēl", "traducao_palavra": "Israel" },
        { "hebraico": "מַלְכֵּֽנוּ׃", "transliteral": "mal-kê-nû", "traducao_palavra": "nosso Rei" }
      ]
    },
    "19": {
      "traducao_completa": "Então falaste em visão aos teus santos, e disseste: Pus o auxílio sobre um que é poderoso; exaltei um escolhido do povo.",
      "palavras": [
        { "hebraico": "אָ֤ז", "transliteral": "ʾāz", "traducao_palavra": "então" },
        { "hebraico": "דִּבַּ֪רְתָּ", "transliteral": "dib-bar-tā", "traducao_palavra": "falaste" },
        { "hebraico": "בְחָ֫זֹ֥ון", "transliteral": "ḇə-ḥā-zôn", "traducao_palavra": "em visão" },
        { "hebraico": "לַֽחֲסִידֶ֗יךָ", "transliteral": "la-ḥă-śî-ḏey-ḵā", "traducao_palavra": "aos teus santos/fiéis" },
        { "hebraico": "וַתֹּ֗אמֶר", "transliteral": "wat-tō-mer", "traducao_palavra": "e disseste" },
        { "hebraico": "שִׁוִּ֣יתִי", "transliteral": "šiw-wî-ṯî", "traducao_palavra": "pus/atribuí" },
        { "hebraico": "עֵ֭זֶר", "transliteral": "ʿē-zer", "traducao_palavra": "ajuda/auxílio" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre" },
        { "hebraico": "גִּבֹּ֑ור", "transliteral": "gib-bôr", "traducao_palavra": "[um] poderoso" },
        { "hebraico": "הֲרִימֹ֖ותִי", "transliteral": "hă-rî-mô-ṯî", "traducao_palavra": "exaltei" },
        { "hebraico": "בָח֣וּר", "transliteral": "ḇā-ḥûr", "traducao_palavra": "[um] escolhido" },
        { "hebraico": "מֵעָֽם׃", "transliteral": "mē-ʿām", "traducao_palavra": "do povo" }
      ]
    },
    "20": {
      "traducao_completa": "Achei a Davi, meu servo; com o meu santo óleo o ungi.",
      "palavras": [
        { "hebraico": "מָ֭צָאתִי", "transliteral": "mā-ṣā-ṯî", "traducao_palavra": "achei" },
        { "hebraico": "דָּוִ֣ד", "transliteral": "dā-wiḏ", "traducao_palavra": "Davi" },
        { "hebraico": "עַבְדִּ֑י", "transliteral": "ʿaḇ-dî", "traducao_palavra": "meu servo" },
        { "hebraico": "בְּשֶׁ֖מֶן", "transliteral": "bə-še-men", "traducao_palavra": "com óleo de" },
        { "hebraico": "קָדְשִׁ֣י", "transliteral": "qāḏ-šî", "traducao_palavra": "minha santidade" },
        { "hebraico": "מְשַׁחְתִּיו׃", "transliteral": "mə-šaḥ-tîw", "traducao_palavra": "ungi-o" }
      ]
    },
    "21": {
      "traducao_completa": "Com o qual a minha mão será firme, e o meu braço o fortalecerá.",
      "palavras": [
        { "hebraico": "אֲשֶׁ֣ר", "transliteral": "ʾă-šer", "traducao_palavra": "com o qual" },
        { "hebraico": "יָ֭דִי", "transliteral": "yā-ḏî", "traducao_palavra": "minha mão" },
        { "hebraico": "תִּכֹּ֣ון", "transliteral": "tik-kôn", "traducao_palavra": "será firme/estabelecida" },
        { "hebraico": "עִמֹּ֑ו", "transliteral": "ʿim-mô", "traducao_palavra": "com ele" },
        { "hebraico": "אַף־", "transliteral": "ap̄-", "traducao_palavra": "também" },
        { "hebraico": "זְרֹועִ֥י", "transliteral": "zə-rô-ʿî", "traducao_palavra": "meu braço" },
        { "hebraico": "תְאַמְּצֶֽנּוּ׃", "transliteral": "ṯə-ʾam-mə-ṣen-nû", "traducao_palavra": "fortalecerá ele" }
      ]
    },
    "22": {
      "traducao_completa": "O inimigo não o importunará, nem o filho da perversidade o afligirá.",
      "palavras": [
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "יַשִּׁ֣יא", "transliteral": "yaš-šî", "traducao_palavra": "exigirá/importunará" },
        { "hebraico": "אֹויֵ֣ב", "transliteral": "ʾô-yēḇ", "traducao_palavra": "[o] inimigo" },
        { "hebraico": "בֹּ֑ו", "transliteral": "bô", "traducao_palavra": "nele" },
        { "hebraico": "וּבֶן־", "transliteral": "ū-ḇen-", "traducao_palavra": "e o filho de" },
        { "hebraico": "עַ֝וְלָ֗ה", "transliteral": "ʿaw-lā", "traducao_palavra": "perversidade" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "יְעַנֶּֽנּוּ׃", "transliteral": "yə-ʿan-nen-nû", "traducao_palavra": "afligirá ele" }
      ]
    },
    "23": {
      "traducao_completa": "E eu esmagarei os seus adversários diante da sua face, e ferirei os que o odeiam.",
      "palavras": [
        { "hebraico": "וְכַתֹּותִ֣י", "transliteral": "wə-ḵat-tô-ṯî", "traducao_palavra": "e esmagarei/triturarei" },
        { "hebraico": "מִפָּנָ֣יו", "transliteral": "mip-pā-nāw", "traducao_palavra": "de diante da face dele" },
        { "hebraico": "צָרָ֑יו", "transliteral": "ṣā-rāw", "traducao_palavra": "adversários dele" },
        { "hebraico": "וּמְשַׂנְאָ֥יו", "transliteral": "ū-mə-śan-ʾāw", "traducao_palavra": "e seus odiadores" },
        { "hebraico": "אֶגֹּֽוף׃", "transliteral": "ʾeg-gôp̄", "traducao_palavra": "ferirei/golpearei" }
      ]
    },
    "24": {
      "traducao_completa": "E a minha fidelidade e a minha misericórdia estarão com ele; e em meu nome será exaltado o seu poder.",
      "palavras": [
        { "hebraico": "וֶֽאֱמוּנָתִ֥י", "transliteral": "wə-ʾĕ-mû-nā-ṯî", "traducao_palavra": "e minha fidelidade" },
        { "hebraico": "וְחַסְדִּ֥י", "transliteral": "wə-ḥas-dî", "traducao_palavra": "e minha misericórdia" },
        { "hebraico": "עִמֹּ֑ו", "transliteral": "ʿim-mô", "traducao_palavra": "[estarão] com ele" },
        { "hebraico": "וּ֝בְשִׁמִ֗י", "transliteral": "ū-ḇə-šim-î", "traducao_palavra": "e em meu nome" },
        { "hebraico": "תָּר֥וּם", "transliteral": "tā-rûm", "traducao_palavra": "será levantada" },
        { "hebraico": "קַרְנֹֽו׃", "transliteral": "qar-nô", "traducao_palavra": "sua fronte/força" }
      ]
    },
    "25": {
      "traducao_completa": "Porei também a sua mão no mar, e a sua direita nos rios.",
      "palavras": [
        { "hebraico": "וְשַׂמְתִּ֣י", "transliteral": "wə-śam-tî", "traducao_palavra": "e porei" },
        { "hebraico": "בַיָּ֣ם", "transliteral": "ḇay-yām", "traducao_palavra": "no mar" },
        { "hebraico": "יָדֹ֑ו", "transliteral": "yā-ḏô", "traducao_palavra": "mão dele" },
        { "hebraico": "וּ֝בַנְּהָרֹ֗ות", "transliteral": "ū-ḇan-nə-hā-rôṯ", "traducao_palavra": "e nos rios" },
        { "hebraico": "יְמִינֹֽו׃", "transliteral": "yə-mî-nô", "traducao_palavra": "sua direita" }
      ]
    },
    "26": {
      "traducao_completa": "Ele me invocará, dizendo: Tu és meu pai, meu Deus, e a rocha da minha salvação.",
      "palavras": [
        { "hebraico": "ה֣וּא", "transliteral": "hû", "traducao_palavra": "ele" },
        { "hebraico": "יִקְרָאֵ֣נִי", "transliteral": "yiq-rā-ʾē-nî", "traducao_palavra": "invocará me" },
        { "hebraico": "אָבִ֣י", "transliteral": "ʾā-ḇî", "traducao_palavra": "pai meu" },
        { "hebraico": "אָ֑תָּה", "transliteral": "ʾāt-tā", "traducao_palavra": "[és] tu" },
        { "hebraico": "אֵ֝לִ֗י", "transliteral": "ʾē-lî", "traducao_palavra": "Deus meu" },
        { "hebraico": "וְצ֣וּר", "transliteral": "wə-ṣûr", "traducao_palavra": "e rocha de" },
        { "hebraico": "יְשׁוּעָתִֽי׃", "transliteral": "yə-šû-ʿā-ṯî", "traducao_palavra": "minha salvação" }
      ]
    },
    "27": {
      "traducao_completa": "Também o farei meu primogênito, mais elevado do que os reis da terra.",
      "palavras": [
        { "hebraico": "אַף־", "transliteral": "ap̄-", "traducao_palavra": "também" },
        { "hebraico": "אָ֭נִי", "transliteral": "ʾā-nî", "traducao_palavra": "eu" },
        { "hebraico": "בְּכֹ֣ור", "transliteral": "bə-ḵôr", "traducao_palavra": "primogênito" },
        { "hebraico": "אֶתְּנֵ֑הוּ", "transliteral": "ʾet-tə-nē-hû", "traducao_palavra": "farei ele" },
        { "hebraico": "עֶ֝לְיֹ֗ון", "transliteral": "ʿel-yôn", "traducao_palavra": "mais elevado" },
        { "hebraico": "לְמַלְכֵi־", "transliteral": "lə-mal-ḵê-", "traducao_palavra": "para reis de" },
        { "hebraico": "אָֽרֶץ׃", "transliteral": "ʾā-reṣ", "traducao_palavra": "terra" }
      ]
    },
    "28": {
      "traducao_completa": "A minha misericórdia lhe conservarei para sempre, e a minha aliança lhe será fiel.",
      "palavras": [
        { "hebraico": "לְ֭עֹולָם", "transliteral": "lə-ʿô-lām", "traducao_palavra": "para sempre" },
        { "hebraico": "אֶשְׁמָר־", "transliteral": "ʾeš-mar-", "traducao_palavra": "guardarei" },
        { "hebraico": "לֹ֣ו", "transliteral": "lô", "traducao_palavra": "para ele" },
        { "hebraico": "חַסְדִּ֑י", "transliteral": "ḥas-dî", "traducao_palavra": "minha misericórdia" },
        { "hebraico": "וּ֝בְרִיתִ֗י", "transliteral": "ū-ḇə-rî-ṯî", "traducao_palavra": "e minha aliança" },
        { "hebraico": "נֶאֱמֶ֥נֶת", "transliteral": "ne-ʾĕ-me-neṯ", "traducao_palavra": "[será] fiel/firme" },
        { "hebraico": "לֹֽו׃", "transliteral": "lô", "traducao_palavra": "para ele" }
      ]
    },
    "29": {
      "traducao_completa": "E farei que a sua descendência dure para sempre, e o seu trono como os dias do céu.",
      "palavras": [
        { "hebraico": "וְשַׂמְתִּ֣י", "transliteral": "wə-śam-tî", "traducao_palavra": "e porei" },
        { "hebraico": "לָעַ֣ד", "transliteral": "lā-ʿaḏ", "traducao_palavra": "eternamente" },
        { "hebraico": "זַרְעֹ֑ו", "transliteral": "zar-ʿô", "traducao_palavra": "semente dele" },
        { "hebraico": "וְ֝כִסְאֹ֗ו", "transliteral": "wə-ḵis-ʾô", "traducao_palavra": "e o trono dele" },
        { "hebraico": "כִּימֵ֥י", "transliteral": "kî-mê", "traducao_palavra": "como os dias de" },
        { "hebraico": "שָׁמָֽיִם׃", "transliteral": "šā-mā-yim", "traducao_palavra": "céus" }
      ]
    },
    "30": {
      "traducao_completa": "Se os seus filhos deixarem a minha lei, e não andarem nos meus juízos,",
      "palavras": [
        { "hebraico": "אִם־", "transliteral": "ʾim-", "traducao_palavra": "se" },
        { "hebraico": "יַעַזְב֣וּ", "transliteral": "ya-ʿaz-ḇû", "traducao_palavra": "abandonarem" },
        { "hebraico": "בָ֭נָיו", "transliteral": "ḇā-nāw", "traducao_palavra": "filhos dele" },
        { "hebraico": "תֹּורָתִ֑י", "transliteral": "tô-rā-ṯî", "traducao_palavra": "minha lei" },
        { "hebraico": "וּ֝בְמִשְׁפָּטַ֗י", "transliteral": "ū-ḇə-miš-pā-ṭay", "traducao_palavra": "e em meus juízos" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "יֵלֵכֽוּן׃", "transliteral": "yê-lē-ḵûn", "traducao_palavra": "andarem" }
      ]
    },
    "31": {
      "traducao_completa": "Se profanarem os meus estatutos, e não guardarem os meus mandamentos,",
      "palavras": [
        { "hebraico": "אִם־", "transliteral": "ʾim-", "traducao_palavra": "se" },
        { "hebraico": "חֻקֹּתַ֥י", "transliteral": "ḥuq-qō-ṯay", "traducao_palavra": "meus estatutos" },
        { "hebraico": "יְחַלֵּ֑לוּ", "transliteral": "yə-ḥal-lē-lû", "traducao_palavra": "profanarem" },
        { "hebraico": "וּ֝מִצְוֹתַ֗י", "transliteral": "ū-miṣ-wō-ṯay", "traducao_palavra": "e meus mandamentos" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "יִשְׁמֹֽרוּ׃", "transliteral": "yiš-mō-rû", "traducao_palavra": "guardarem" }
      ]
    },
    "32": {
      "traducao_completa": "Então visitarei com vara a sua transgressão, e a sua iniquidade com açoites.",
      "palavras": [
        { "hebraico": "וּפָקַדְתִּ֣י", "transliteral": "ū-p̄ā-qaḏ-tî", "traducao_palavra": "e visitarei/castigarei" },
        { "hebraico": "בְשֵׁ֣בֶט", "transliteral": "ḇə-šē-ḇeṭ", "traducao_palavra": "com vara" },
        { "hebraico": "פִּשְׁעָ֑ם", "transliteral": "piš-ʿām", "traducao_palavra": "a transgressão deles" },
        { "hebraico": "וּבִנְגָעִ֥ים", "transliteral": "ū-ḇin-ḡā-ʿîm", "traducao_palavra": "e com açoites/golpes" },
        { "hebraico": "עֲוֹנָֽם׃", "transliteral": "ʿă-wō-nām", "traducao_palavra": "a iniquidade deles" }
      ]
    },
    "33": {
      "traducao_completa": "Mas não retirarei dele totalmente a minha benignidade, nem faltarei à minha verdade.",
      "palavras": [
        { "hebraico": "וְ֝חַסְדִּ֗י", "transliteral": "wə-ḥas-dî", "traducao_palavra": "mas minha misericórdia" },
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "אָפִ֥יר", "transliteral": "ʾā-p̄îr", "traducao_palavra": "quebrarei/anularei" },
        { "hebraico": "מֵֽעִמֹּ֑ו", "transliteral": "mē-ʿim-mô", "traducao_palavra": "de com ele" },
        { "hebraico": "וְלֹֽא־", "transliteral": "wə-lō-", "traducao_palavra": "e não" },
        { "hebraico": "אֲשַׁקֵּ֥ר", "transliteral": "ʾă-šaq-qēr", "traducao_palavra": "mentirei/falharei" },
        { "hebraico": "בֶּאֱמוּנָתִֽי׃", "transliteral": "be-ʾĕ-mû-nā-ṯî", "traducao_palavra": "na minha fidelidade" }
      ]
    },
    "34": {
      "traducao_completa": "Não quebrarei a minha aliança, não alterarei o que saiu dos meus lábios.",
      "palavras": [
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "אֲחַלֵּ֥ל", "transliteral": "ʾă-ḥal-lēl", "traducao_palavra": "profanarei/quebrarei" },
        { "hebraico": "בְּרִיתִ֑י", "transliteral": "bə-rî-ṯî", "traducao_palavra": "minha aliança" },
        { "hebraico": "וּמֹוצָ֥א", "transliteral": "ū-mô-ṣā", "traducao_palavra": "e a saída de" },
