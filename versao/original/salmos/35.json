        { "hebraico": "לֹ֥א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "שָׁלֹ֪ום", "transliteral": "šā-lôm", "traducao_palavra": "paz" },
        { "hebraico": "יְדַבֵּ֑רוּ", "transliteral": "yə-ḏab-bê-rû", "traducao_palavra": "falam" },
        { "hebraico": "וְעַ֥ל", "transliteral": "wə-ʿal", "traducao_palavra": "e contra" },
        { "hebraico": "רִגְעֵי־אֶ֗רֶץ", "transliteral": "riḡ-ʿê-ʾe-reṣ", "traducao_palavra": "os quietos da terra" },
        { "hebraico": "דִּבְרֵ֥י", "transliteral": "diḇ-rê", "traducao_palavra": "palavras de" },
        { "hebraico": "מִ֝רְמֹ֗ות", "transliteral": "mir-môṯ", "traducao_palavra": "enganos" },
        { "hebraico": "יַחֲשֹׁבֽוּן", "transliteral": "ya-ḥă-šō-ḇûn", "traducao_palavra": "planejam/maquinam" }
      ]
    },
    "21": {
      "traducao_completa": "Escancararam contra mim a sua boca e disseram: Ah! Ah! Os nossos olhos o viram.",
      "palavras": [
        { "hebraico": "וַיַּרְחִ֥יבוּ", "transliteral": "way-yar-ḥî-ḇû", "traducao_palavra": "e alargaram/escancararam" },
        { "hebraico": "עָלַ֗י", "transliteral": "ʿā-lay", "traducao_palavra": "contra mim" },
        { "hebraico": "פִּ֫יהֶ֥ם", "transliteral": "pî-hem", "traducao_palavra": "boca deles" },
        { "hebraico": "אָ֭מְרוּ", "transliteral": "ʾā-mə-rû", "traducao_palavra": "disseram" },
        { "hebraico": "הֶ֘אָ֥ח ׀", "transliteral": "he-ʾāḥ", "traducao_palavra": "ah!/bem feito!" },
