        { "hebraico": "וְיַחְפְּר֨וּ ׀", "transliteral": "wə-yaḥ-pə-rû", "traducao_palavra": "e fiquem pálidos/confundidos" },
        { "hebraico": "יַחְדָּו֮", "transliteral": "yaḥ-dāw", "traducao_palavra": "juntamente/à uma" },
        { "hebraico": "שְׂמֵחֵ֪י", "transliteral": "śə-mē-ḥê", "traducao_palavra": "alegres de/com" },
        { "hebraico": "רָעָ֫תִ֥י", "transliteral": "rā-ʿā-ṯî", "traducao_palavra": "meu mal" },
        { "hebraico": "יִֽלְבְּשׁוּ־בֹ֥שֶׁת", "transliteral": "yil-bə-šû-ḇō-šet", "traducao_palavra": "vistam-se de vergonha" },
        { "hebraico": "וּכְלִמָּ֑ה", "transliteral": "ū-ḵə-lim-mā", "traducao_palavra": "e confusão/insulto" },
