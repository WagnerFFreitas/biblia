        { "hebraico": "לְמִשְׁפָּטִ֑י", "transliteral": "lə-miš-pā-ṭî", "traducao_palavra": "para o meu julgamento" },
        { "hebraico": "אֱלֹהַ֖י", "transliteral": "ʾĕ-lō-hay", "traducao_palavra": "Deus meu" },
        { "hebraico": "וַאדֹנָ֣י", "transliteral": "wa-ḏō-nāy", "traducao_palavra": "e Senhor meu" },
