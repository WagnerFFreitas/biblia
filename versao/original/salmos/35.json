      ]
    },
    "22": {
      "traducao_completa": "Tu o viste, YHWH, não te cales; Senhor, não te alongues de mim.",
      "palavras": [
        { "hebraico": "רָאִ֣יתָה", "transliteral": "rā-ʾî-ṯā", "traducao_palavra": "tu viste" },
        { "hebraico": "יְ֭הוָה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "אַֽל־תֶּחֱרַ֑שׁ", "transliteral": "ʾal-te-ḥĕ-raš", "traducao_palavra": "não te cales" },
        { "hebraico": "אֲ֝דֹנָי", "transliteral": "ʾă-ḏō-nāy", "traducao_palavra": "Senhor" },
        { "hebraico": "אַל־תִּרְחַ֥ק", "transliteral": "ʾal-tir-ḥaq", "traducao_palavra": "não te alongues/afastes" },
        { "hebraico": "מִמֶּֽנִּי׃", "transliteral": "mim-men-nî", "traducao_palavra": "de mim" }
      ]
    },
    "23": {
      "traducao_completa": "Desperta e acorda para o meu julgamento, para a minha causa, Deus meu e Senhor meu.",
