        { "hebraico": "עָלָֽי׃", "transliteral": "ʿā-lāy", "traducao_palavra": "contra mim" }
      ]
    },
    "27": {
      "traducao_completa": "Cantem e alegrem-se os que amam a minha justiça; e digam continuamente: Engrandecido seja YHWH, que ama a prosperidade do seu servo.",
      "palavras": [
        { "hebraico": "יָרֹ֨נּוּ ׀", "transliteral": "yā-rōn-nû", "traducao_palavra": "cantem de alegria" },
        { "hebraico": "וְיִשְׂמְח֬וּ", "transliteral": "wə-yiś-mə-ḥû", "traducao_palavra": "e alegrem-se" },
        { "hebraico": "חֲפֵצֵ֪י", "transliteral": "ḥă-p̄ê-ṣê", "traducao_palavra": "[os que] desejam/amam" },
        { "hebraico": "צִדְקִ֥י", "transliteral": "ṣiḏ-qî", "traducao_palavra": "minha justiça" },
        { "hebraico": "וְיֹאמְר֣וּ", "transliteral": "wə-yō-mərû", "traducao_palavra": "e digam" },
        { "hebraico": "תָ֭מִיד", "transliteral": "ṯā-mîḏ", "traducao_palavra": "continuamente" },
        { "hebraico": "יִגְדַּ֣ל", "transliteral": "yiḡ-dal", "traducao_palavra": "seja engrandecido" },
        { "hebraico": "יְהוָ֑ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "הֶ֝חָפֵ֗ץ", "transliteral": "he-ḥā-p̄ēṣ", "traducao_palavra": "[que] deseja" },
