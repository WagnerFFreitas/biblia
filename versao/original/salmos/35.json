    "28": {
      "traducao_completa": "E a minha língua falará da tua justiça e do teu louvor todo o dia.",
      "palavras": [
        { "hebraico": "וּ֭לְשֹׁונִי", "transliteral": "ū-lə-šô-nî", "traducao_palavra": "e minha língua" },
        { "hebraico": "תֶּהְגֶּ֣ה", "transliteral": "teh-geh", "traducao_palavra": "meditará/proferirá" },
