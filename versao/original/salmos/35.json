        { "hebraico": "כְצִדְקְךָ֮", "transliteral": "ḵə-ṣiḏ-qə-ḵā", "traducao_palavra": "segundo tua justiça" },
        { "hebraico": "יְהוָ֪ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "אֱלֹהָ֑י", "transliteral": "ʾĕ-lō-hāy", "traducao_palavra": "Deus meu" },
        { "hebraico": "וְאַל־יִשְׂמְחוּ־לִֽי׃", "transliteral": "wə-ʾal-yiś-mə-ḥû-lî", "traducao_palavra": "e não se alegrem de mim" }
      ]
    },
    "25": {
      "traducao_completa": "Não digam em seu coração: Ah! Era o que a nossa alma desejava! Não digam: Devoramo-lo.",
      "palavras": [
        { "hebraico": "אַל־יֹאמְר֣וּ", "transliteral": "ʾal-yō-mə-rû", "traducao_palavra": "não digam" },
        { "hebraico": "בְלִבָּ֣ם", "transliteral": "ḇə-lib-bām", "traducao_palavra": "em seu coração" },
        { "hebraico": "הֶ֭אָח", "transliteral": "he-ʾāḥ", "traducao_palavra": "ah!" },
        { "hebraico": "נַפְשֵׁ֑נוּ", "transliteral": "nap̄-šê-nû", "traducao_palavra": "[o desejo da] nossa alma" },
        { "hebraico": "אַל־יֹ֝אמְר֗וּ", "transliteral": "ʾal-yō-mə-rû", "traducao_palavra": "não digam" },
        { "hebraico": "בִּלַּעֲנֽוּהוּ׃", "transliteral": "bil-la-ʿă-nû-hû", "traducao_palavra": "nós o devoramos" }
      ]
