{
  "livro": "Salmos - תְּהִלִּים - Tehillim",
  "capítulo": 39,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Ao mestre de canto, a Jedutum. Salmo de Davi.",
      "palavras": [
        { "hebraico": "לַמְנַצֵּ֥חַ", "transliteral": "lam-naṣ-ṣē-aḥ", "traducao_palavra": "ao mestre de canto" },
        { "hebraico": "לִֽידוּת֗וּן", "transliteral": "lî-ḏû-ṯûn", "traducao_palavra": "a Jedutum" },
        { "hebraico": "מִזְמֹ֥ור", "transliteral": "miz-môr", "traducao_palavra": "salmo" },
        { "hebraico": "לְדָוִֽד׃", "transliteral": "lə-ḏā-wiḏ", "traducao_palavra": "de Davi" }
      ]
    },
    "2": {
      "traducao_completa": "Disse eu: Guardarei os meus caminhos para não pecar com a minha língua; guardarei a minha boca com um freio, enquanto o ímpio estiver diante de mim.",
      "palavras": [
        { "hebraico": "אָמַ֗רְתִּי", "transliteral": "ʾā-mar-tî", "traducao_palavra": "disse [eu]" },
        { "hebraico": "אֶשְׁמְרָ֣ה", "transliteral": "ʾeš-mə-rā", "traducao_palavra": "guardarei" },
        { "hebraico": "דְרָכַי֮", "transliteral": "ḏə-rā-ḵay", "traducao_palavra": "meus caminhos" },
        { "hebraico": "מֵחֲטֹ֪וא", "transliteral": "mē-ḥă-ṭô", "traducao_palavra": "de pecar" },
        { "hebraico": "בִלְשֹׁ֫ונִ֥י", "transliteral": "ḇil-šô-nî", "traducao_palavra": "com minha língua" },
        { "hebraico": "אֶשְׁמְרָ֥ה", "transliteral": "ʾeš-mə-rā", "traducao_palavra": "guardarei" },
        { "hebraico": "לְpִ֣̄י", "transliteral": "lə-p̄î", "traducao_palavra": "para minha boca" },
        { "hebraico": "מַחְסֹ֑ום", "transliteral": "maḥ-śôm", "traducao_palavra": "um freio/mordaça" },
        { "hebraico": "בְּעֹ֖ד", "transliteral": "bə-ʿôḏ", "traducao_palavra": "enquanto" },
        { "hebraico": "רָשָׁ֣ע", "transliteral": "rā-šāʿ", "traducao_palavra": "[o] ímpio" },
        { "hebraico": "לְנֶגְדִּֽי׃", "transliteral": "lə-neḡ-dî", "traducao_palavra": "estiver diante de mim" }
      ]
    },
    "3": {
      "traducao_completa": "Com o silêncio fiquei mudo; calava-me até do bem, e a minha dor se agravou.",
      "palavras": [
        { "hebraico": "נֶאֱלַ֣מְתִּי", "transliteral": "ne-ʾĕ-lam-tî", "traducao_palavra": "emudeci" },
        { "hebraico": "ד֭וּמִיָּה", "transliteral": "ḏû-miy-yā", "traducao_palavra": "[em] silêncio" },
        { "hebraico": "הֶחֱשֵׁ֣יתִי", "transliteral": "he-ḥĕ-šê-ṯî", "traducao_palavra": "calei-me" },
        { "hebraico": "מִטֹּ֑וב", "transliteral": "miṭ-ṭôḇ", "traducao_palavra": "do bem/mesmo do que é bom" },
        { "hebraico": "וּכְאֵבִ֥י", "transliteral": "ū-ḵə-ʾē-ḇî", "traducao_palavra": "e minha dor" },
        { "hebraico": "נֶעְכָּֽר׃", "transliteral": "ne-ʿkār", "traducao_palavra": "foi perturbada/agravada" }
      ]
    },
    "4": {
      "traducao_completa": "Esquentou-se-me o coração dentro de mim; enquanto eu meditava, acendeu-se um fogo; então falei com a minha língua:",
      "palavras": [
        { "hebraico": "חַם־לִבִּ֨י", "transliteral": "ḥam-lib-bî", "traducao_palavra": "esquentou meu coração" },
        { "hebraico": "בְּקִרְבִּ֗י", "transliteral": "bə-qir-bî", "traducao_palavra": "no meu íntimo" },
        { "hebraico": "בַּהֲגִיגִ֥י", "transliteral": "ba-hă-ḡî-ḡî", "traducao_palavra": "no meu meditar" },
        { "hebraico": "תִḇְעַר־אֵ֑שׁ", "transliteral": "tiḇ-ʿar-ʾēš", "traducao_palavra": "ardeu fogo" },
        { "hebraico": "דִּ֝בַּ֗רְתִּי", "transliteral": "dib-bar-tî", "traducao_palavra": "falei" },
        { "hebraico": "בִּלְשֹׁונִֽי׃", "transliteral": "bil-šô-nî", "traducao_palavra": "com minha língua" }
      ]
    },
    "5": {
      "traducao_completa": "Faze-me conhecer, YHWH, o meu fim, e a medida dos meus dias qual é, para que eu saiba quanto sou frágil.",
      "palavras": [
        { "hebraico": "הֹודִיעֵ֤נִי", "transliteral": "hô-ḏî-ʿē-nî", "traducao_palavra": "faze-me saber" },
        { "hebraico": "יְהוָ֨ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "קִצִּ֗י", "transliteral": "qiṣ-ṣî", "traducao_palavra": "meu fim" },
        { "hebraico": "וּמִדַּ֣ת", "transliteral": "ū-mid-daṯ", "traducao_palavra": "e a medida de" },
        { "hebraico": "יָמַ֣י", "transliteral": "yā-may", "traducao_palavra": "meus dias" },
        { "hebraico": "מַה־הִ֑יא", "transliteral": "mah-hî", "traducao_palavra": "o que é ela" },
        { "hebraico": "אֵ֝דְעָ֗ה", "transliteral": "ʾē-ḏə-ʿā", "traducao_palavra": "que eu saiba" },
        { "hebraico": "מֶה־חָדֵ֥ל", "transliteral": "meh-ḥā-ḏēl", "traducao_palavra": "quão passageiro/frágil" },
        { "hebraico": "אָֽנִי׃", "transliteral": "ʾā-nî", "traducao_palavra": "[sou] eu" }
      ]
    },
    "6": {
      "traducao_completa": "Eis que fizeste os meus dias como a largura de alguns palmos; o tempo da minha vida é como nada diante de ti; na verdade, todo homem, por mais firme que esteja, é puramente vaidade. (Selah)",
      "palavras": [
        { "hebraico": "הִנֵּ֤ה", "transliteral": "hin-nēh", "traducao_palavra": "eis que" },
        { "hebraico": "ṭְפָחֹ֨ות", "transliteral": "ṭə-p̄ā-ḥôṯ", "traducao_palavra": "[como] palmos" },
        { "hebraico": "נָ֘תַ֤תָּה", "transliteral": "nā-ṯat-tā", "traducao_palavra": "tu puseste/deste" },
        { "hebraico": "יָמַ֗י", "transliteral": "yā-may", "traducao_palavra": "meus dias" },
        { "hebraico": "וְחֶלְדִּ֣י", "transliteral": "wə-ḥel-dî", "traducao_palavra": "e minha duração de vida" },
        { "hebraico": "ḵְאַ֣יִן", "transliteral": "ḵə-ʾa-yin", "traducao_palavra": "como nada" },
        { "hebraico": "נֶגְדֶּ֑ךָ", "transliteral": "neḡ-de-ḵā", "traducao_palavra": "diante de ti" },
        { "hebraico": "אַ֥ךְ", "transliteral": "ʾaḵ", "traducao_palavra": "certamente/apenas" },
        { "hebraico": "כָּֽל־הֶ֥בֶל", "transliteral": "kāl-he-ḇel", "traducao_palavra": "todo vaidade/sopro" },
        { "hebraico": "כָּל־אָ֝דָ֗ם", "transliteral": "kāl-ʾā-ḏām", "traducao_palavra": "todo homem" },
        { "hebraico": "נִצָּ֥ב", "transliteral": "niṣ-ṣāḇ", "traducao_palavra": "posto/firmado" },
        { "hebraico": "סֶֽלָה׃", "transliteral": "se-lā", "traducao_palavra": "Selah" }
      ]
    },
    "7": {
      "traducao_completa": "Na verdade, o homem anda como uma sombra; na verdade, em vão se inquietam; amontoam tesouros, e não sabem quem os levará.",
      "palavras": [
        { "hebraico": "אַךְ־בְּצֶ֤ל", "transliteral": "ʾaḵ-bə-ṣel", "traducao_palavra": "apenas como sombra" },
        { "hebraico": "יִתְהַלֶּךְ־אִ֗ישׁ", "transliteral": "yiṯ-hal-leḵ-ʾîš", "traducao_palavra": "anda o homem" },
        { "hebraico": "אַךְ־הֶ֥ḇֶל", "transliteral": "ʾaḵ-he-ḇel", "traducao_palavra": "apenas [em] vaidade" },
        { "hebraico": "יֶהֱמָי֑וּן", "transliteral": "ye-hĕ-mā-yûn", "traducao_palavra": "se inquietam/fazem barulho" },
        { "hebraico": "יִ֝צְבֹּ֗ר", "transliteral": "yiṣ-bōr", "traducao_palavra": "ele ajunta/acumula" },
        { "hebraico": "וְלֹא־יֵ֭דַע", "transliteral": "wə-lō-yē-ḏaʿ", "traducao_palavra": "e não sabe" },
        { "hebraico": "מִֽי־אֹסְפָֽם׃", "transliteral": "mî-ʾō-śə-p̄ām", "traducao_palavra": "quem os recolherá" }
      ]
    },
    "8": {
      "traducao_completa": "Agora, pois, Senhor, que espero eu? A minha esperança está em ti.",
      "palavras": [
        { "hebraico": "וְעַתָּ֣ה", "transliteral": "wə-ʿat-tā", "traducao_palavra": "e agora" },
        { "hebraico": "מַה־קִּוִּ֣יתִי", "transliteral": "mah-qiw-wî-ṯî", "traducao_palavra": "o que esperei?" },
        { "hebraico": "אֲדֹנָ֑י", "transliteral": "ʾă-ḏō-nāy", "traducao_palavra": "Senhor" },
        { "hebraico": "תֹּ֝וחַלְתִּ֗י", "transliteral": "tô-ḥal-tî", "traducao_palavra": "minha esperança" },
        { "hebraico": "לְךָ֣", "transliteral": "lə-ḵā", "traducao_palavra": "em ti" },
        { "hebraico": "הִֽיא׃", "transliteral": "hî", "traducao_palavra": "[está] ela" }
      ]
    },
    "9": {
      "traducao_completa": "Livra-me de todas as minhas transgressões; não me faças o opróbrio do insensato.",
      "palavras": [
        { "hebraico": "מִכָּל־פְּשָׁעַ֥י", "transliteral": "mik-kāl-pə-šā-ʿay", "traducao_palavra": "de todas minhas transgressões" },
        { "hebraico": "הַצִּילֵ֑נִי", "transliteral": "haṣ-ṣî-lē-nî", "traducao_palavra": "livra-me" },
        { "hebraico": "חֶרְפַּ֥ת", "transliteral": "ḥer-paṯ", "traducao_palavra": "[o] opróbrio de" },
        { "hebraico": "נָ֝ḇָ֗ל", "transliteral": "nā-ḇāl", "traducao_palavra": "[o] tolo/insensato" },
        { "hebraico": "אַל־תְּשִׂימֵֽנִי׃", "transliteral": "ʾal-tə-śî-mē-nî", "traducao_palavra": "não me ponhas" }
      ]
    },
    "10": {
      "traducao_completa": "Emudeci, não abri a minha boca, porquanto tu o fizeste.",
      "palavras": [
        { "hebraico": "נֶ֭אֱלַמְתִּי", "transliteral": "ne-ʾĕ-lam-tî", "traducao_palavra": "emudeci" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "אֶפְתַּח־פִּ֑י", "transliteral": "ʾep̄-taḥ-pî", "traducao_palavra": "abri minha boca" },
        { "hebraico": "כִּ֖י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "אַתָּ֥ה", "transliteral": "ʾat-tā", "traducao_palavra": "tu" },
        { "hebraico": "עָשִֽׂיתָ׃", "transliteral": "ʿā-śî-ṯā", "traducao_palavra": "fizeste" }
      ]
    },
    "11": {
      "traducao_completa": "Tira de sobre mim a tua praga; estou consumido pelo golpe da tua mão.",
      "palavras": [
        { "hebraico": "הָסֵ֣ר", "transliteral": "hā-śēr", "traducao_palavra": "remove/afasta" },
        { "hebraico": "מֵעָלַ֣י", "transliteral": "mē-ʿā-lay", "traducao_palavra": "de sobre mim" },
        { "hebraico": "נִגְעֶ֑ךָ", "transliteral": "niḡ-ʿe-ḵā", "traducao_palavra": "tua praga/golpe" },
        { "hebraico": "מִתִּגְרַ֥ת", "transliteral": "mit-tiḡ-raṯ", "traducao_palavra": "pelo combate/conflito de" },
        { "hebraico": "יָ֝דְךָ֗", "transliteral": "yā-ḏə-ḵā", "traducao_palavra": "tua mão" },
        { "hebraico": "אֲנִ֣י", "transliteral": "ʾă-nî", "traducao_palavra": "eu" },
        { "hebraico": "כָלִֽיתִי׃", "transliteral": "ḵā-lî-ṯî", "traducao_palavra": "fui consumido" }
      ]
    },
    "12": {
      "traducao_completa": "Quando castigas o homem, com repreensões por causa da iniquidade, fazes com que a sua beleza se consuma como a traça; na verdade, todo homem é vaidade. (Selah)",
      "palavras": [
        { "hebraico": "בְּתֹוכָ֘חֹ֤ות", "transliteral": "bə-ṯô-ḵā-ḥôṯ", "traducao_palavra": "com repreensões/castigos" },
        { "hebraico": "עַל־עָוֹ֨ן", "transliteral": "ʿal-ʿā-wōn", "traducao_palavra": "por causa da iniquidade" },
        { "hebraico": "יִסַּ֬רְתָּ", "transliteral": "yis-sar-tā", "traducao_palavra": "tu disciplinas" },
        { "hebraico": "אִ֗ישׁ", "transliteral": "ʾîš", "traducao_palavra": "[o] homem" },
        { "hebraico": "וַתֶּ֣מֶס", "transliteral": "wat-te-mes", "traducao_palavra": "e consomes/derretes" },
        { "hebraico": "כָּעָ֣שׁ", "transliteral": "kā-ʿāš", "traducao_palavra": "como a traça" },
        { "hebraico": "חֲמוּדֹ֑ו", "transliteral": "ḥă-mû-ḏô", "traducao_palavra": "o que lhe é precioso/beleza" },
        { "hebraico": "אַ֤ךְ", "transliteral": "ʾaḵ", "traducao_palavra": "apenas/certamente" },
        { "hebraico": "הֶ֖ḇֶל", "transliteral": "he-ḇel", "traducao_palavra": "vaidade" },
        { "hebraico": "כָּל־אָדָ֣ם", "transliteral": "kāl-ʾā-ḏām", "traducao_palavra": "todo homem" },
        { "hebraico": "סֶֽלָה׃", "transliteral": "se-lā", "traducao_palavra": "Selah" }
      ]
    },
    "13": {
      "traducao_completa": "Ouve, YHWH, a minha oração, e inclina os teus ouvidos ao meu clamor; não te cales perante as minhas lágrimas, porque sou um estrangeiro contigo e peregrino, como todos os meus pais.",
      "palavras": [
        { "hebraico": "שִׁמְעָֽה־תְpִ̄לָּתִ֥י", "transliteral": "šim-ʿā-ṯə-p̄il-lā-ṯî", "traducao_palavra": "ouve minha oração" },
        { "hebraico": "יְהוָ֨ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "וְשַׁוְעָתִ֨י", "transliteral": "wə-šaw-ʿā-ṯî", "traducao_palavra": "e ao meu clamor" },
        { "hebraico": "הַאֲזִ֘ינָה֮", "transliteral": "ha-ʾă-zî-nā", "traducao_palavra": "dá ouvidos" },
        { "hebraico": "אֶל־דִּמְעָתִ֗י", "transliteral": "ʾel-dim-ʿā-ṯî", "traducao_palavra": "para minhas lágrimas" },
        { "hebraico": "אַֽל־תֶּחֱרַ֫שׁ", "transliteral": "ʾal-te-ḥĕ-raš", "traducao_palavra": "não te cales" },
        { "hebraico": "כִּ֤י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "גֵ֣ר", "transliteral": "ḡēr", "traducao_palavra": "estrangeiro" },
        { "hebraico": "אָנֹכִ֣י", "transliteral": "ʾā-nō-ḵî", "traducao_palavra": "[sou] eu" },
        { "hebraico": "עִמָּ֑ךְ", "transliteral": "ʿim-māḵ", "traducao_palavra": "contigo" },
        { "hebraico": "תֹּ֝ושָׁ֗ḇ", "transliteral": "tô-šāḇ", "traducao_palavra": "peregrino" },
        { "hebraico": "כְּכָל־אֲבֹותָֽי׃", "transliteral": "kə-ḵāl-ʾă-ḇô-ṯāy", "traducao_palavra": "como todos meus pais" }
      ]
    },
    "14": {
      "traducao_completa": "Desvia de mim o teu olhar, para que eu tome alento, antes que me vá e não exista mais.",
      "palavras": [
        { "hebraico": "הָשַׁ֣ע", "transliteral": "hā-šaʿ", "traducao_palavra": "desvia o olhar" },
        { "hebraico": "מִמֶּ֣נִּי", "transliteral": "mim-men-nî", "traducao_palavra": "de mim" },
        { "hebraico": "וְאַבְלִ֑יגָה", "transliteral": "wə-ʾaḇ-lî-ḡā", "traducao_palavra": "para que eu tome alento/sorria" },
        { "hebraico": "בְּטֶ֖רֶם", "transliteral": "bə-ṭe-rem", "traducao_palavra": "antes que" },
        { "hebraico": "אֵלֵ֣ךְ", "transliteral": "ʾē-lēḵ", "traducao_palavra": "eu vá" },
        { "hebraico": "וְאֵינֶֽנִּי׃", "transliteral": "wə-ʾê-nen-nî", "traducao_palavra": "e não [exista] mais" }
      ]
    }
  }
}