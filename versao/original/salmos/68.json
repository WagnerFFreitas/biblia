        { "hebraico": "בָ֑הּ", "transliteral": "ḇāh", "traducao_palavra": "nela" },
        { "hebraico": "תָּ֘כִ֤ין", "transliteral": "tā-ḵîn", "traducao_palavra": "preparaste" },
