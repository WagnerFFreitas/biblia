    "9": {
      "traducao_completa": "Tu, ó Deus, enviaste uma chuva generosa e restauraste a tua herança, quando estava cansada.",
      "palavras": [
        { "hebraico": "גֶּ֣שֶׁם", "transliteral": "ge-šem", "traducao_palavra": "chuva" },
        { "hebraico": "נְ֭דָבֹות", "transliteral": "nə-ḏā-ḇôṯ", "traducao_palavra": "generosa" },
        { "hebraico": "תָּנִ֣יף", "transliteral": "tā-nîp̄", "traducao_palavra": "tu balançaste/enviaste" },
        { "hebraico": "אֱלֹהִ֑ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "ó Deus" },
