        { "hebraico": "הַר־", "transliteral": "har-", "traducao_palavra": "monte de" },
        { "hebraico": "אֱ֭לֹהִים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "Deus" },
        { "hebraico": "הַר־", "transliteral": "har-", "traducao_palavra": "monte de" },
