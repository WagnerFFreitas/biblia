        { "hebraico": "נֶחְפָּ֥ה", "transliteral": "neḥ-pā", "traducao_palavra": "recobertas" },
        { "hebraico": "בַכֶּ֑סֶף", "transliteral": "ḇak-ke-sep̄", "traducao_palavra": "com a prata" },
