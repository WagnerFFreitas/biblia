        { "hebraico": "אֱלֹהִים֮", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "Deus" },
        { "hebraico": "מֹושִׁ֤יב", "transliteral": "mô-šîḇ", "traducao_palavra": "faz habitar" },
