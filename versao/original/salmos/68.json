        { "hebraico": "בִּירַקְרַ֥ק", "transliteral": "bî-raq-raq", "traducao_palavra": "com o amarelado de" },
        { "hebraico": "חָרֽוּץ׃", "transliteral": "ḥā-rûṣ", "traducao_palavra": "ouro" }
