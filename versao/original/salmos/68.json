    },
    "13": {
      "traducao_completa": "Ainda que vos deiteis entre os currais, as asas da pomba serão cobertas de prata, e as suas penas de ouro amarelo.",
      "palavras": [
        { "hebraico": "אִם־", "transliteral": "ʾim-", "traducao_palavra": "se/ainda que" },
        { "hebraico": "תִּשְׁכְּב֖וּן", "transliteral": "tiš-kə-ḇûn", "traducao_palavra": "vos deiteis" },
        { "hebraico": "בֵּ֣ין", "transliteral": "bên", "traducao_palavra": "entre" },
        { "hebraico": "שְׁפַתָּ֑יִם", "transliteral": "šə-p̄at-ta-yim", "traducao_palavra": "[os] currais/pedras da lareira" },
        { "hebraico": "כַּנְפֵ֣י", "transliteral": "kan-p̄ê", "traducao_palavra": "asas de" },
