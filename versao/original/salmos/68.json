        { "hebraico": "לֵאלֹהִים֮", "transliteral": "lê-lō-hîm", "traducao_palavra": "a Deus" },
        { "hebraico": "זַמְּר֪וּ", "transliteral": "zam-mə-rû", "traducao_palavra": "salmodiai/cantai louvores" },
        { "hebraico": "שְׁמֹ֫ו", "transliteral": "šə-mô", "traducao_palavra": "[ao] seu nome" },
