        { "hebraico": "אַתָּ֥ה", "transliteral": "ʾat-tā", "traducao_palavra": "tu" },
        { "hebraico": "כֹונַנְתָּֽהּ׃", "transliteral": "ḵô-nan-tāh", "traducao_palavra": "confirmaste-a" }
      ]
    },
    "10": {
      "traducao_completa": "Nela habitou o teu rebanho; pela tua bondade, ó Deus, proveste ao necessitado.",
      "palavras": [
        { "hebraico": "חַיָּתְךָ֥", "transliteral": "ḥay-yā-ṯə-ḵā", "traducao_palavra": "teu rebanho/congregação" },
