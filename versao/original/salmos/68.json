      ]
    },
    "7": {
      "traducao_completa": "Ó Deus, quando saías diante do teu povo, quando caminhavas pelo deserto, (Selah)",
      "palavras": [
        { "hebraico": "אֱלֹהִ֗ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "ó Deus" },
        { "hebraico": "בְּצֵאתְךָ֥", "transliteral": "bə-ṣê-ṯə-ḵā", "traducao_palavra": "quando saías" },
        { "hebraico": "לִפְנֵ֣i", "transliteral": "lip̄-nê", "traducao_palavra": "diante de" },
        { "hebraico": "עַמֶּ֑ךָ", "transliteral": "ʿam-me-ḵā", "traducao_palavra": "teu povo" },
        { "hebraico": "בְּצַעְדְּךָ֖", "transliteral": "bə-ṣa-ʿdə-ḵā", "traducao_palavra": "no teu marchar" },
