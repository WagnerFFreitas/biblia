        { "hebraico": "לֶעָנִ֣י", "transliteral": "le-ʿā-nî", "traducao_palavra": "ao pobre/aflito" },
        { "hebraico": "אֱלֹהִֽים׃", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "ó Deus" }
      ]
    },
    "11": {
      "traducao_completa": "O Senhor deu a palavra; grande era o exército das mulheres que anunciavam as boas-novas.",
      "palavras": [
        { "hebraico": "אֲדֹנָ֥י", "transliteral": "ʾă-ḏō-nāy", "traducao_palavra": "O Senhor" },
