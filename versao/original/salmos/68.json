{
  "livro": "Salmos - תְּהִלִּים - Tehillim",
  "capítulo": 68,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Levante-se Deus, sejam dispersos os seus inimigos; fujam de diante dele os que o odeiam.",
      "palavras": [
        { "hebraico": "יָק֣וּם", "transliteral": "yā-qûm", "traducao_palavra": "levante-se" },
        { "hebraico": "אֱ֭לֹהִים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "Deus" },
        { "hebraico": "יָפ֣וּצוּ", "transliteral": "yā-p̄û-ṣû", "traducao_palavra": "sejam dispersos" },
        { "hebraico": "אֹויְבָ֑יו", "transliteral": "ʾô-yə-ḇāw", "traducao_palavra": "inimigos dele" },
        { "hebraico": "וְיָנ֥וּסוּ", "transliteral": "wə-yā-nû-śû", "traducao_palavra": "e fujam" },
        { "hebraico": "מְ֝שַׂנְאָ֗יו", "transliteral": "mə-śan-ʾāw", "traducao_palavra": "os que o odeiam" },
        { "hebraico": "מִפָּנָֽיו׃", "transliteral": "mip-pā-nāw", "traducao_palavra": "de diante da face dele" }
      ]
    },
    "2": {
      "traducao_completa": "Como se impele a fumaça, assim tu os impeles; como a cera se derrete diante do fogo, assim pereçam os ímpios diante de Deus.",
      "palavras": [
        { "hebraico": "כְּהִנָּדֹ֣ף", "transliteral": "kə-hin-nā-ḏōp̄", "traducao_palavra": "conforme o ser expelida" },
        { "hebraico": "עָ֭שָׁן", "transliteral": "ʿā-šān", "traducao_palavra": "[a] fumaça" },
        { "hebraico": "תִּנְדֹּ֑ף", "transliteral": "tin-dōp̄", "traducao_palavra": "expele [tu]" },
        { "hebraico": "כְּהִמֵּ֣ס", "transliteral": "kə-him-mēs", "traducao_palavra": "conforme o derreter de" },
        { "hebraico": "דֹּ֭ונַג", "transliteral": "dô-naḡ", "traducao_palavra": "cera" },
        { "hebraico": "מִפְּנֵי־", "transliteral": "mip-pə-nê-", "traducao_palavra": "de diante de" },
        { "hebraico": "אֵ֑שׁ", "transliteral": "ʾēš", "traducao_palavra": "fogo" },
        { "hebraico": "יֹאבְד֥וּ", "transliteral": "yō-ḇə-ḏû", "traducao_palavra": "pereçam" },
        { "hebraico": "רְ֝שָׁעִ֗ים", "transliteral": "rə-šā-ʿîm", "traducao_palavra": "[os] ímpios" },
        { "hebraico": "מִפְּנֵ֥י", "transliteral": "mip-pə-nê", "traducao_palavra": "diante de" },
        { "hebraico": "אֱלֹhִֽים׃", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "Deus" }
      ]
    },
    "3": {
      "traducao_completa": "Mas alegrem-se os justos, exultem na presença de Deus, e folguem com alegria.",
      "palavras": [
        { "hebraico": "וְֽצַדִּיקִ֗ים", "transliteral": "wə-ṣad-dî-qîm", "traducao_palavra": "mas [os] justos" },
        { "hebraico": "יִשְׂמְח֓וּ", "transliteral": "yiś-mə-ḥû", "traducao_palavra": "alegrem-se" },
        { "hebraico": "יַ֥עַלְצוּ", "transliteral": "ya-ʿal-ṣû", "traducao_palavra": "exultem" },
        { "hebraico": "לִפְנֵ֥י", "transliteral": "lip̄-nê", "traducao_palavra": "diante de" },
        { "hebraico": "אֱלֹהִ֑ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "Deus" },
        { "hebraico": "וְיָשִׂ֥ישׂוּ", "transliteral": "wə-yā-śî-śû", "traducao_palavra": "e folguem/regozijem" },
