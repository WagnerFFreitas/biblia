        { "hebraico": "אֹ֑מֶר", "transliteral": "ʾō-mer", "traducao_palavra": "[a] palavra" },
        { "hebraico": "הַֽ֝מְבַשְּׂרֹ֗ות", "transliteral": "ham-ḇaś-śə-rôṯ", "traducao_palavra": "as que anunciam" },
