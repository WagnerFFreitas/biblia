        { "hebraico": "שְׁמֹ֑ו", "transliteral": "šə-mô", "traducao_palavra": "seu nome" },
        { "hebraico": "וְ֝עִלְז֗וּ", "transliteral": "wə-ʿil-zû", "traducao_palavra": "e exultai" },
        { "hebraico": "לְפָנָֽיו׃", "transliteral": "lə-p̄ā-nāw", "traducao_palavra": "diante dele" }
