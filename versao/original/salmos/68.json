        { "hebraico": "יִדֹּד֑וּן", "transliteral": "yid-dō-ḏûn", "traducao_palavra": "fogem" },
        { "hebraico": "וּנְוַת־", "transliteral": "ū-nə-waṯ-", "traducao_palavra": "e a que mora em" },
        { "hebraico": "בַּ֝֗יִת", "transliteral": "ba-yiṯ", "traducao_palavra": "casa" },
        { "hebraico": "תְּחַלֵּ֥ק", "transliteral": "tə-ḥal-lēq", "traducao_palavra": "reparte" },
