    "5": {
      "traducao_completa": "Pai de órfãos e juiz de viúvas é Deus no seu santo lugar.",
      "palavras": [
        { "hebraico": "אֲבִ֣י", "transliteral": "ʾă-ḇî", "traducao_palavra": "pai de" },
        { "hebraico": "יְ֭תֹומִים", "transliteral": "yə-ṯô-mîm", "traducao_palavra": "órfãos" },
        { "hebraico": "וְדַיַּ֣ן", "transliteral": "wə-ḏay-yan", "traducao_palavra": "e juiz de" },
        { "hebraico": "אַלְמָנֹ֑ות", "transliteral": "ʾal-mā-nôṯ", "traducao_palavra": "viúvas" },
        { "hebraico": "אֱ֝לֹהִ֗ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "Deus" },
        { "hebraico": "בִּמְעֹ֥ון", "transliteral": "bim-ʿôn", "traducao_palavra": "na morada de" },
        { "hebraico": "קָדְשֹֽׁו׃", "transliteral": "qāḏ-šô", "traducao_palavra": "sua santidade" }
