  "versiculos": {
    "1": {
      "traducao_completa": "Louvai a YHWH! Cantai a YHWH um cântico novo, e o seu louvor na congregação dos santos.",
      "palavras": [
        { "hebraico": "הַֽלְלוּיָ֨הּ", "transliteral": "hal-lû-yāh", "traducao_palavra": "louvai a YAH" },
        { "hebraico": "שִׁ֤ירוּ", "transliteral": "šî-rû", "traducao_palavra": "cantai" },
        { "hebraico": "לַֽיהוָ֣ה", "transliteral": "lay-hwāh", "traducao_palavra": "a YHWH" },
        { "hebraico": "שִׁ֣יר", "transliteral": "šîr", "traducao_palavra": "[um] cântico" },
        { "hebraico": "חָדָ֑שׁ", "transliteral": "ḥā-ḏāš", "traducao_palavra": "novo" },
        { "hebraico": "תְּ֝הִלָּתֹ֗ו", "transliteral": "tə-hil-lā-ṯô", "traducao_palavra": "o louvor dele" },
        { "hebraico": "בִּקְהַ֥ל", "transliteral": "biq-hal", "traducao_palavra": "na congregação de" },
        { "hebraico": "חֲסִידִֽים׃", "transliteral": "ḥă-śî-ḏîm", "traducao_palavra": "santos/fiéis" }
      ]
    },
    "2": {
      "traducao_completa": "Alegre-se Israel naquele que o fez; regozijem-se os filhos de Sião no seu Rei.",
      "palavras": [
        { "hebraico": "יִשְׂמַ֣ח", "transliteral": "yiś-maḥ", "traducao_palavra": "alegre-se" },
        { "hebraico": "יִשְׂרָאֵ֣ל", "transliteral": "yiś-rā-ʾēl", "traducao_palavra": "Israel" },
        { "hebraico": "בְּעֹשָׂ֑יו", "transliteral": "bə-ʿō-śāyw", "traducao_palavra": "naquele que o fez" },
        { "hebraico": "בְּנֵי־", "transliteral": "bə-nê-", "traducao_palavra": "filhos de" },
        { "hebraico": "צִ֝יֹּון", "transliteral": "ṣiy-yôn", "traducao_palavra": "Sião" },
        { "hebraico": "יָגִ֥ילוּ", "transliteral": "yā-ḡî-lû", "traducao_palavra": "regozijem-se" },
        { "hebraico": "בְמַלְכָּֽם׃", "transliteral": "ḇə-mal-kām", "traducao_palavra": "no seu Rei" }
      ]
    },
    "3": {
      "traducao_completa": "Louvem o seu nome com danças; cantem-lhe louvores com adufe e harpa.",
      "palavras": [
        { "hebraico": "יְהַלְל֣וּ", "transliteral": "yə-hal-lû", "traducao_palavra": "louvem" },
        { "hebraico": "שְׁמֹ֣ו", "transliteral": "šə-mô", "traducao_palavra": "nome dele" },
        { "hebraico": "בְמָחֹ֑ול", "transliteral": "ḇə-mā-ḥôl", "traducao_palavra": "com dança" },
        { "hebraico": "בְּתֹ֥ף", "transliteral": "bə-ṯōp̄", "traducao_palavra": "com adufe" },
        { "hebraico": "וְ֝כִנֹּ֗ור", "transliteral": "wə-ḵin-nôr", "traducao_palavra": "e harpa" },
        { "hebraico": "יְזַמְּרוּ־", "transliteral": "yə-zam-mə-rû-", "traducao_palavra": "salmodiem" },
        { "hebraico": "לֹֽו׃", "transliteral": "lô", "traducao_palavra": "a ele" }
      ]
    },
    "4": {
      "traducao_completa": "Porque YHWH se agrada do seu povo; ele adornará os mansos com a salvação.",
      "palavras": [
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "porque" },
        { "hebraico": "רֹוצֶ֣ה", "transliteral": "rô-ṣeh", "traducao_palavra": "agrada-se/favorece" },
        { "hebraico": "יְהוָ֣ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "בְּעַמֹּ֑ו", "transliteral": "bə-ʿam-mô", "traducao_palavra": "do seu povo" },
        { "hebraico": "יְפָאֵ֥ר", "transliteral": "yə-p̄ā-ʾēr", "traducao_palavra": "ele adornará/beleza dará" },
        { "hebraico": "עֲ֝נָוִ֗ים", "transliteral": "ʿă-nā-wîm", "traducao_palavra": "aos mansos" },
        { "hebraico": "בִּישׁוּעָֽה׃", "transliteral": "bî-šû-ʿā", "traducao_palavra": "com salvação" }
      ]
    },
    "5": {
      "traducao_completa": "Exultem os santos na glória; cantem de júbilo nos seus leitos.",
      "palavras": [
        { "hebraico": "יַעְלְז֣וּ", "transliteral": "ya-ʿlə-zû", "traducao_palavra": "exultem" },
        { "hebraico": "חֲסִידִ֣ים", "transliteral": "ḥă-śî-ḏîm", "traducao_palavra": "[os] santos" },
        { "hebraico": "בְּכָבֹ֑וד", "transliteral": "bə-ḵā-ḇôḏ", "traducao_palavra": "na glória" },
        { "hebraico": "יְ֝רַנְּנ֗וּ", "transliteral": "yə-ran-nə-nû", "traducao_palavra": "cantem de júbilo" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre" },
        { "hebraico": "מִשְׁכְּבֹותָֽם׃", "transliteral": "miš-kə-ḇô-ṯām", "traducao_palavra": "seus leitos" }
      ]
    },
    "6": {
      "traducao_completa": "Estejam na sua garganta os altos louvores de Deus, e uma espada de dois gumes nas suas mãos,",
      "palavras": [
        { "hebraico": "רֹומְמֹ֣ות", "transliteral": "rô-mə-môṯ", "traducao_palavra": "exaltações de/altos louvores" },
        { "hebraico": "אֵ֭ל", "transliteral": "ʾēl", "traducao_palavra": "Deus" },
        { "hebraico": "בִּגְרֹונָ֑ם", "transliteral": "biḡ-rô-nām", "traducao_palavra": "na garganta deles" },
        { "hebraico": "וְחֶ֖רֶב", "transliteral": "wə-ḥe-reḇ", "traducao_palavra": "e espada de" },
        { "hebraico": "פִּיפִיֹּ֣ות", "transliteral": "pî-p̄iy-yôṯ", "traducao_palavra": "dois gumes/vários cortes" },
        { "hebraico": "בְּיָדָֽם׃", "transliteral": "bə-yā-ḏām", "traducao_palavra": "na mão deles" }
      ]
    },
    "7": {
      "traducao_completa": "Para exercerem vingança sobre as nações, e castigos sobre os povos;",
      "palavras": [
        { "hebraico": "לַעֲשֹׂ֣ות", "transliteral": "la-ʿă-śôṯ", "traducao_palavra": "para fazer" },
        { "hebraico": "נְקָמָה֮", "transliteral": "nə-qā-mā", "traducao_palavra": "vingança" },
        { "hebraico": "בַּגֹּויִם֒", "transliteral": "bag-gô-yim", "traducao_palavra": "nas nações" },
        { "hebraico": "תֹּֽוכֵחֹ֗ת", "transliteral": "tô-ḵê-ḥōṯ", "traducao_palavra": "repreensões/castigos" },
        { "hebraico": "בַּל־", "transliteral": "bal-", "traducao_palavra": "nos/entre" },
        { "hebraico": "אֻמִּֽים׃", "transliteral": "ʾum-mîm", "traducao_palavra": "povos" }
      ]
    },
    "8": {
      "traducao_completa": "Para prenderem os seus reis com cadeias, e os seus nobres com grilhões de ferro;",
      "palavras": [
        { "hebraico": "לֶאֱסֹ֣ר", "transliteral": "le-ʾĕ-śōr", "traducao_palavra": "para prender" },
        { "hebraico": "מַלְכֵיהֶ֣ם", "transliteral": "mal-ḵê-hem", "traducao_palavra": "reis deles" },
        { "hebraico": "בְּזִקִּ֑ים", "transliteral": "bə-ziq-qîm", "traducao_palavra": "com cadeias/grilhões" },
        { "hebraico": "וְנִכְבְּדֵיהֶ֗ם", "transliteral": "wə-niḵ-bə-ḏê-hem", "traducao_palavra": "e os nobres deles" },
        { "hebraico": "בְּכַבְלֵ֥י", "transliteral": "bə-ḵaḇ-lê", "traducao_palavra": "com grilhões de" },
        { "hebraico": "בַרְזֶֽל׃", "transliteral": "ḇar-zel", "traducao_palavra": "ferro" }
      ]
    },
    "9": {
      "traducao_completa": "Para executarem neles o juízo escrito; esta glória será para todos os seus santos. Louvai a YHWH!",
      "palavras": [
        { "hebraico": "לַעֲשֹׂ֤ות", "transliteral": "la-ʿă-śôṯ", "traducao_palavra": "para fazer" },
        { "hebraico": "בָּהֶ֨ם ׀", "transliteral": "bā-hem", "traducao_palavra": "neles" },
        { "hebraico": "מִשְׁפָּ֬ט", "transliteral": "miš-pāṭ", "traducao_palavra": "[o] juízo" },
        { "hebraico": "כָּת֗וּב", "transliteral": "kā-ṯûḇ", "traducao_palavra": "escrito" },
        { "hebraico": "הָדָ֣ר", "transliteral": "hā-ḏār", "traducao_palavra": "honra/esplendor" },
        { "hebraico": "ה֭וּא", "transliteral": "hû", "traducao_palavra": "[é] ele" },
        { "hebraico": "לְכָל־", "transliteral": "lə-ḵāl-", "traducao_palavra": "para todos" },
        { "hebraico": "חֲסִידָ֗יו", "transliteral": "ḥă-śî-ḏāyw", "traducao_palavra": "seus santos/fiéis" },
        { "hebraico": "הַֽלְלוּ־", "transliteral": "hal-lû-", "traducao_palavra": "louvai" },
        { "hebraico": "יָֽהּ׃", "transliteral": "yāh", "traducao_palavra": "YAH" }
      ]
    }
  }
