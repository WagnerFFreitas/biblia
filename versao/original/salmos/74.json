    "10": {
      "traducao_completa": "Até quando, ó Deus, o adversário afrontará? Blasfemará o inimigo o teu nome para sempre?",
      "palavras": [
        { "hebraico": "עַד־", "transliteral": "ʿaḏ-", "traducao_palavra": "até" },
