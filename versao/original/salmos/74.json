      ]
    },
    "4": {
      "traducao_completa": "Os teus adversários rugem no meio dos teus lugares de assembleia; postam os seus próprios sinais por sinais.",
      "palavras": [
        { "hebraico": "שָׁאֲג֣וּ", "transliteral": "šā-ʾă-ḡû", "traducao_palavra": "rugiram" },
        { "hebraico": "צֹ֭רְרֶיךָ", "transliteral": "ṣō-rə-re-ḵā", "traducao_palavra": "teus adversários" },
