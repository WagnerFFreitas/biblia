        { "hebraico": "אֱ֭לֹהִים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "ó Deus" },
        { "hebraico": "זָנַ֣חְתָּ", "transliteral": "zā-naḥ-tā", "traducao_palavra": "rejeitaste/abandonaste" },
        { "hebraico": "לָנֶ֑צַח", "transliteral": "lā-ne-ṣaḥ", "traducao_palavra": "para sempre" },
        { "hebraico": "יֶעְשַׁ֥ן", "transliteral": "ye-ʿə-šan", "traducao_palavra": "fumegará/se acende" },
        { "hebraico": "אַ֝פְּךָ֗", "transliteral": "ʾap-pə-ḵā", "traducao_palavra": "tua ira" },
        { "hebraico": "בְּצֹ֣אן", "transliteral": "bə-ṣōn", "traducao_palavra": "contra as ovelhas de" },
        { "hebraico": "מַרְעִיתֶֽךָ׃", "transliteral": "mar-ʿî-ṯe-ḵā", "traducao_palavra": "teu pasto" }
      ]
    },
    "2": {
      "traducao_completa": "Lembra-te da tua congregação, que adquiriste desde a antiguidade; que remiste para ser a tribo da tua herança; deste monte Sião, onde habitaste.",
