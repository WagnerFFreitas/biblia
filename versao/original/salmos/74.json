        { "hebraico": "לֹ֥א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "רָ֘אִ֤ינוּ", "transliteral": "rā-ʾî-nû", "traducao_palavra": "vimos" },
