        { "hebraico": "פְעָ֭מֶיךָ", "transliteral": "p̄ə-ʿā-me-ḵā", "traducao_palavra": "teus passos" },
        { "hebraico": "לְמַשֻּׁאֹ֣ות", "transliteral": "lə-maš-šu-ʾôṯ", "traducao_palavra": "para ruínas/desolações" },
