        { "hebraico": "נַחֲלָתֶ֑ךָ", "transliteral": "na-ḥă-lā-ṯe-ḵā", "traducao_palavra": "tua herança" },
        { "hebraico": "הַר־", "transliteral": "har-", "traducao_palavra": "monte" },
        { "hebraico": "צִ֝יֹּ֗ון", "transliteral": "ṣiy-yôn", "traducao_palavra": "Sião" },
        { "hebraico": "זֶ֤ה", "transliteral": "zeh", "traducao_palavra": "este" },
        { "hebraico": "שָׁכַ֥נְתָּ", "transliteral": "šā-ḵan-tā", "traducao_palavra": "[onde] habitaste" },
        { "hebraico": "בֹּֽו׃", "transliteral": "bô", "traducao_palavra": "nele" }
