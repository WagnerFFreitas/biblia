    "11": {
      "traducao_completa": "Diz em seu coração: Deus esqueceu-se; cobriu o seu rosto; nunca o verá.",
      "palavras": [
        { "hebraico": "אָמַ֣ר", "transliteral": "ʾā-mar", "traducao_palavra": "ele diz" },
        { "hebraico": "בִּלִבֹּ֔ו", "transliteral": "bi-lib-bô", "traducao_palavra": "em seu coração" },
        { "hebraico": "שָׁכַ֥ח", "transliteral": "šā-ḵaḥ", "traducao_palavra": "esqueceu" },
        { "hebraico": "אֵ֑ל", "transliteral": "ʾēl", "traducao_palavra": "Deus" },
        { "hebraico": "הִסְתִּ֥יר", "transliteral": "his-tîr", "traducao_palavra": "ele escondeu" },
        { "hebraico": "פָּ֝נָ֗יו", "transliteral": "pā-nāw", "traducao_palavra": "rosto dele" },
