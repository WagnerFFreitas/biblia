    },
    "8": {
      "traducao_completa": "Põe-se de emboscada nas aldeias; nos lugares ocultos mata o inocente; os seus olhos estão espreitando o desamparado.",
      "palavras": [
        { "hebraico": "יֵשֵׁ֤ב ׀", "transliteral": "yē-šēḇ", "traducao_palavra": "ele senta-se" },
        { "hebraico": "בְּמַאְרַ֬ב", "transliteral": "bə-ma-ʾə-raḇ", "traducao_palavra": "na emboscada de" },
        { "hebraico": "חֲצֵרִ֗ים", "transliteral": "ḥă-ṣê-rîm", "traducao_palavra": "aldeias/pátios" },
        { "hebraico": "בַּ֭מִּסְתָּרִים", "transliteral": "bam-mis-tā-rîm", "traducao_palavra": "nos esconderijos" },
        { "hebraico": "יַהֲרֹ֣ג", "transliteral": "ya-hă-rōḡ", "traducao_palavra": "ele mata" },
        { "hebraico": "נָקִ֑י", "transliteral": "nā-qî", "traducao_palavra": "[o] inocente" },
        { "hebraico": "עֵינָ֝יו", "transliteral": "ʿê-nāw", "traducao_palavra": "olhos dele" },
        { "hebraico": "לְחֵלְכָ֥ה", "transliteral": "lə-ḥê-lə-ḵā", "traducao_palavra": "pelo infeliz/desamparado" },
