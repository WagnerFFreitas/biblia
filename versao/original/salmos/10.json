        { "hebraico": "שְׁ֭בֹר", "transliteral": "šə-ḇōr", "traducao_palavra": "quebra" },
        { "hebraico": "זְרֹ֣ועַ", "transliteral": "zə-rô-aʿ", "traducao_palavra": "[o] braço de" },
        { "hebraico": "רָשָׁ֑ע", "transliteral": "rā-šāʿ", "traducao_palavra": "ímpio" },
