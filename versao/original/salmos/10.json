        { "hebraico": "חָשָֽׁבוּ׃", "transliteral": "ḥā-šā-ḇû", "traducao_palavra": "maquinaram" }
      ]
    },
    "3": {
      "traducao_completa": "Pois o ímpio gloria-se do desejo da sua alma, e o avarento amaldiçoa e despreza a YHWH.",
