      ]
    },
    "2": {
      "traducao_completa": "Na sua soberba, o ímpio persegue ardentemente o aflito; sejam eles apanhados nas ciladas que maquinaram.",
      "palavras": [
        { "hebraico": "בְּגַאֲוַ֣ת", "transliteral": "bə-ḡa-ʾă-waṯ", "traducao_palavra": "na soberba de" },
        { "hebraico": "רָ֭שָׁע", "transliteral": "rā-šāʿ", "traducao_palavra": "ímpio" },
        { "hebraico": "יִדְלַ֣ק", "transliteral": "yiḏ-laq", "traducao_palavra": "persegue ardentemente" },
        { "hebraico": "עָנִ֑י", "transliteral": "ʿā-nî", "traducao_palavra": "o aflito" },
        { "hebraico": "יִתָּפְשׂ֓וּ", "transliteral": "yit-tā-p̄ə-śû", "traducao_palavra": "sejam apanhados" },
