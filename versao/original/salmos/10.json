        { "hebraico": "כִּֽי־הִלֵּ֣ל", "transliteral": "kî-hil-lēl", "traducao_palavra": "pois gloria-se" },
        { "hebraico": "רָ֭שָׁע", "transliteral": "rā-šāʿ", "traducao_palavra": "o ímpio" },
        { "hebraico": "עַל־תַּאֲוַ֣ת", "transliteral": "ʿal-ta-ʾă-waṯ", "traducao_palavra": "pelo desejo de" },
        { "hebraico": "נַפְשֹׁ֑ו", "transliteral": "nap̄-šô", "traducao_palavra": "sua alma" },
        { "hebraico": "וּבֹצֵ֥עַ", "transliteral": "ū-ḇō-ṣē-aʿ", "traducao_palavra": "e o ganancioso/avarento" },
        { "hebraico": "בֵּ֝רֵ֗ךְ", "transliteral": "bē-rēḵ", "traducao_palavra": "amaldiçoa [irônico: abençoa para se despedir]" },
        { "hebraico": "נִ֘אֵ֥ץ", "transliteral": "ni-ʾēṣ", "traducao_palavra": "despreza" },
        { "hebraico": "יְהוָֽה׃", "transliteral": "YHWH", "traducao_palavra": "YHWH" }
      ]
    },
    "4": {
      "traducao_completa": "O ímpio, pela altivez do seu rosto, não busca a Deus; todas as suas cogitações são: Não há Deus.",
      "palavras": [
        { "hebraico": "רָשָׁ֗ע", "transliteral": "rā-šāʿ", "traducao_palavra": "o ímpio" },
        { "hebraico": "כְּגֹ֣בַהּ", "transliteral": "kə-ḡō-ḇah", "traducao_palavra": "pela altura/altivez de" },
        { "hebraico": "אַפֹּ֭ו", "transliteral": "ap-pô", "traducao_palavra": "seu nariz/rosto" },
        { "hebraico": "בַּל־יִדְרֹ֑שׁ", "transliteral": "bal-yiḏ-rōš", "traducao_palavra": "não busca" },
