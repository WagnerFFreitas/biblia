      ]
    },
    "5": {
      "traducao_completa": "Os seus caminhos são sempre prósperos; os teus juízos estão longe dele, no alto; quanto a todos os seus adversários, ele os sopra.",
      "palavras": [
        { "hebraico": "יָ֘חִ֤ילוּ", "transliteral": "yā-ḥî-lû", "traducao_palavra": "são prósperos" },
        { "hebraico": "דְרָכָ֨ו ׀", "transliteral": "ḏə-rā-ḵāw", "traducao_palavra": "caminhos dele" },
        { "hebraico": "בְּכָל־עֵ֗ת", "transliteral": "bə-ḵāl-ʿêṯ", "traducao_palavra": "em todo tempo" },
        { "hebraico": "מָרֹ֣ום", "transliteral": "mā-rôm", "traducao_palavra": "[estão no] alto" },
        { "hebraico": "מִשְׁפָּטֶיךָ", "transliteral": "miš-pā-ṭe-ḵā", "traducao_palavra": "teus juízos" },
        { "hebraico": "מִנֶּגְדֹּ֑ו", "transliteral": "min-neḡ-dô", "traducao_palavra": "longe dele" },
        { "hebraico": "כָּל־צֹ֝ורְרָ֗יו", "transliteral": "kāl-ṣô-rə-rāw", "traducao_palavra": "todos os seus adversários" },
        { "hebraico": "יָפִ֥יחַ", "transliteral": "yā-p̄î-aḥ", "traducao_palavra": "ele sopra/despreza" },
        { "hebraico": "בָּהֶֽם׃", "transliteral": "bā-hem", "traducao_palavra": "neles" }
      ]
    },
    "6": {
      "traducao_completa": "Diz em seu coração: Não serei abalado; pois de geração em geração nunca estarei em adversidade.",
      "palavras": [
        { "hebraico": "אָמַ֪ר", "transliteral": "ʾā-mar", "traducao_palavra": "ele diz" },
        { "hebraico": "בְּלִבֹּ֫ו", "transliteral": "bə-lib-bô", "traducao_palavra": "em seu coração" },
        { "hebraico": "בַּל־אֶמֹּ֑וט", "transliteral": "bal-ʾem-môṭ", "traducao_palavra": "não serei abalado" },
        { "hebraico": "לְדֹ֥ר", "transliteral": "lə-ḏōr", "traducao_palavra": "de geração" },
        { "hebraico": "וָדֹ֓ר ׀", "transliteral": "wā-ḏōr", "traducao_palavra": "e geração" },
        { "hebraico": "אֲשֶׁ֭ר", "transliteral": "ʾă-šer", "traducao_palavra": "que" },
        { "hebraico": "לֹא־בְרָֽע׃", "transliteral": "lō-ḇə-rāʿ", "traducao_palavra": "não [estarei] no mal" }
      ]
    },
    "7": {
      "traducao_completa": "A sua boca está cheia de maldição, de enganos e de fraude; debaixo da sua língua há malícia e iniquidade.",
      "palavras": [
        { "hebraico": "אָ֘לָ֤ה", "transliteral": "ʾā-lā", "traducao_palavra": "maldição" },
        { "hebraico": "פִּ֣יהוּ", "transliteral": "pî-hû", "traducao_palavra": "boca dele" },
        { "hebraico": "מָ֭לֵא", "transliteral": "mā-lê", "traducao_palavra": "[está] cheia" },
        { "hebraico": "וּמִרְמֹ֣ות", "transliteral": "ū-mir-môṯ", "traducao_palavra": "e de enganos" },
        { "hebraico": "וָתֹ֑ךְ", "transliteral": "wā-ṯōḵ", "traducao_palavra": "e opressão/fraude" },
