        { "hebraico": "יְהוָה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "תַּעֲמֹ֣ד", "transliteral": "ta-ʿă-mōḏ", "traducao_palavra": "te pões/estás" },
        { "hebraico": "בְּרָחֹ֑וק", "transliteral": "bə-rā-ḥôq", "traducao_palavra": "ao longe" },
