    "10": {
      "traducao_completa": "Encolhe-se, abaixa-se, para que os desamparados caiam em suas fortes garras.",
      "palavras": [
        { "hebraico": "יִדְכֶּ֥ה", "transliteral": "yiḏ-keh", "traducao_palavra": "ele se agacha/esmaga" },
        { "hebraico": "יָשֹׁ֑חַ", "transliteral": "yā-šō-aḥ", "traducao_palavra": "ele se curva" },
        { "hebraico": "וְנָפַ֥ל", "transliteral": "wə-nā-p̄al", "traducao_palavra": "e cai" },
