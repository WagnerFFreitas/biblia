        { "hebraico": "עָ֫נִ֥י", "transliteral": "ʿā-nî", "traducao_palavra": "[o] pobre" },
        { "hebraico": "יַחְטֹ֥ף", "transliteral": "yaḥ-ṭōp̄", "traducao_palavra": "ele arrebata" },
        { "hebraico": "עָנִ֑י", "transliteral": "ʿā-nî", "traducao_palavra": "[o] pobre" },
        { "hebraico": "בְּמָשְׁכֹ֥ו", "transliteral": "bə-mā-šə-ḵô", "traducao_palavra": "ao atraí-lo" },
        { "hebraico": "בְּרִשְׁתֹּֽו׃", "transliteral": "bə-riš-tô", "traducao_palavra": "na sua rede" }
