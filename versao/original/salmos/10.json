      ]
    },
    "9": {
      "traducao_completa": "Arma ciladas no esconderijo, como o leão no seu covil; arma ciladas para roubar o pobre; rouba o pobre, atraindo-o para a sua rede.",
      "palavras": [
        { "hebraico": "יֶאֱרֹ֬ב", "transliteral": "ye-ʾĕ-rōḇ", "traducao_palavra": "ele espreita" },
        { "hebraico": "בַּמִּסְתָּ֨ר ׀", "transliteral": "bam-mis-tār", "traducao_palavra": "no esconderijo" },
        { "hebraico": "כְּאַרְיֵ֬ה", "transliteral": "kə-ʾar-yēh", "traducao_palavra": "como leão" },
        { "hebraico": "בְסֻכֹּ֗ו", "transliteral": "ḇə-suk-kô", "traducao_palavra": "no seu covil" },
        { "hebraico": "יֶאֱרֹ֥ב", "transliteral": "ye-ʾĕ-rōḇ", "traducao_palavra": "ele espreita" },
