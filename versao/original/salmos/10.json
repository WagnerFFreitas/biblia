{
  "livro": "Salmos - תְּהִלִּים - Tehillim",
  "capítulo": 10,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Por que, YHWH, te pões ao longe? Por que te escondes em tempos de angústia?",
