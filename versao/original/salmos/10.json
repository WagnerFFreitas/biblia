        { "hebraico": "נְשָׂ֣א", "transliteral": "nə-śā", "traducao_palavra": "levanta" },
        { "hebraico": "יָדֶ֑ךָ", "transliteral": "yā-ḏe-ḵā", "traducao_palavra": "tua mão" },
        { "hebraico": "אַל־תִּשְׁכַּ֥ח", "transliteral": "ʾal-tiš-kaḥ", "traducao_palavra": "não esqueças" },
        { "hebraico": "עֲנָוִים׃", "transliteral": "ʿă-nā-wîm", "traducao_palavra": "[os] humildes" }
      ]
    },
    "13": {
      "traducao_completa": "Por que o ímpio despreza a Deus, dizendo no seu coração: Tu não o inquirirás?",
      "palavras": [
        { "hebraico": "עַל־מֶ֤ה ׀", "transliteral": "ʿal-meh", "traducao_palavra": "por que" },
        { "hebraico": "נִאֵ֖ץ", "transliteral": "ni-ʾēṣ", "traducao_palavra": "despreza" },
        { "hebraico": "רָשָׁ֥ע ׀", "transliteral": "rā-šāʿ", "traducao_palavra": "o ímpio" },
        { "hebraico": "אֱלֹהִ֑ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "Deus" },
        { "hebraico": "אָמַ֥ר", "transliteral": "ʾā-mar", "traducao_palavra": "ele disse" },
        { "hebraico": "בְּלִבֹּ֗ו", "transliteral": "bə-lib-bô", "traducao_palavra": "no coração dele" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "תִּדְרֹֽשׁ׃", "transliteral": "tiḏ-rōš", "traducao_palavra": "requererás/inquirirás" }
      ]
    },
    "14": {
      "traducao_completa": "Tu o viste, pois atentas para o trabalho e enfado, para o retribuíres com tua mão; a ti o pobre se encomenda; tu és o auxílio do órfão.",
      "palavras": [
        { "hebraico": "רָאִ֜תָה", "transliteral": "rā-ʾî-ṯā", "traducao_palavra": "viste" },
        { "hebraico": "כִּֽי־אַתָּ֤ה", "transliteral": "kî-ʾat-tā", "traducao_palavra": "pois tu" },
        { "hebraico": "עָ֘מָ֤ל", "transliteral": "ʿā-māl", "traducao_palavra": "sofrimento/trabalho" },
        { "hebraico": "וָכַ֨עַס ׀", "transliteral": "wā-ḵa-ʿas", "traducao_palavra": "e enfado/provocação" },
        { "hebraico": "תַּבִּ֗יט", "transliteral": "tab-bîṭ", "traducao_palavra": "contemplas" },
        { "hebraico": "לָתֵ֥ת", "transliteral": "lā-ṯêṯ", "traducao_palavra": "para pôr/dar" },
        { "hebraico": "בְּיָדֶ֑ךָ", "transliteral": "bə-yā-ḏe-ḵā", "traducao_palavra": "na tua mão" },
        { "hebraico": "עָלֶ֨יךָ ׀", "transliteral": "ʿā-le-ḵā", "traducao_palavra": "sobre ti" },
        { "hebraico": "יַעֲזֹ֬ב", "transliteral": "ya-ʿă-zōḇ", "traducao_palavra": "se entrega/confia" },
        { "hebraico": "חֵלֵ֗כָה", "transliteral": "ḥê-lē-ḵā", "traducao_palavra": "o infeliz/desamparado" },
        { "hebraico": "יָ֝תֹ֗ום", "transliteral": "yā-ṯôm", "traducao_palavra": "[do] órfão" },
        { "hebraico": "אַתָּ֤ה ׀", "transliteral": "ʾat-tā", "traducao_palavra": "tu" },
        { "hebraico": "הָיִ֬יתָ", "transliteral": "hā-yî-ṯā", "traducao_palavra": "tens sido" },
