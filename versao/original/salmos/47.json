    "10": {
      "traducao_completa": "Os príncipes dos povos se reuniram, como o povo do Deus de Abraão; porque a Deus pertencem os escudos da terra; ele é sumamente exaltado.",
      "palavras": [
        { "hebraico": "נְדִ֘יבֵ֤י", "transliteral": "nə-ḏî-ḇê", "traducao_palavra": "os nobres/voluntários de" },
        { "hebraico": "עַמִּ֨ים", "transliteral": "ʿam-mîm", "traducao_palavra": "povos" },
        { "hebraico": "נֶאֱסָ֗פוּ", "transliteral": "ne-ʾĕ-śā-p̄û", "traducao_palavra": "reuniram-se" },
        { "hebraico": "עַם֮", "transliteral": "ʿam", "traducao_palavra": "[como o] povo de" },
