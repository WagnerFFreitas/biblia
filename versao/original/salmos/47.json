        { "hebraico": "בִּתְרוּעָ֑ה", "transliteral": "biṯ-rû-ʿā", "traducao_palavra": "com aclamação/grito" },
        { "hebraico": "יְ֝הֹוָ֗ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "בְּקֹ֣ול", "transliteral": "bə-qôl", "traducao_palavra": "ao som de" },
        { "hebraico": "שֹׁופָֽר׃", "transliteral": "šô-p̄ār", "traducao_palavra": "shofar/trombeta" }
      ]
    },
    "7": {
      "traducao_completa": "Cantai louvores a Deus, cantai louvores; cantai louvores ao nosso Rei, cantai louvores.",
      "palavras": [
        { "hebraico": "זַמְּר֣וּ", "transliteral": "zam-mə-rû", "traducao_palavra": "salmodiai/cantai louvores" },
        { "hebraico": "אֱלֹהִ֣ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "[a] Deus" },
        { "hebraico": "זַמֵּ֑רוּ", "transliteral": "zam-mē-rû", "traducao_palavra": "salmodiai" },
        { "hebraico": "זַמְּר֥וּ", "transliteral": "zam-mə-rû", "traducao_palavra": "salmodiai" },
        { "hebraico": "לְמַלְכֵּ֗נוּ", "transliteral": "lə-mal-kê-nû", "traducao_palavra": "ao nosso Rei" },
        { "hebraico": "זַמֵּֽרוּ׃", "transliteral": "zam-mē-rû", "traducao_palavra": "salmodiai" }
      ]
    },
    "8": {
      "traducao_completa": "Pois Deus é o Rei de toda a terra; cantai louvores com inteligência.",
      "palavras": [
        { "hebraico": "כִּ֤י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "מֶ֖לֶךְ", "transliteral": "me-leḵ", "traducao_palavra": "[o] Rei de" },
        { "hebraico": "כָּל־הָאָ֥רֶץ", "transliteral": "kāl-hā-ʾā-reṣ", "traducao_palavra": "toda a terra" },
        { "hebraico": "אֱלֹהִ֗ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "[é] Deus" },
        { "hebraico": "זַמְּר֥וּ", "transliteral": "zam-mə-rû", "traducao_palavra": "salmodiai" },
        { "hebraico": "מַשְׂכִּֽיל׃", "transliteral": "maś-kîl", "traducao_palavra": "[com] masquil/entendimento" }
      ]
    },
    "9": {
      "traducao_completa": "Deus reina sobre as nações; Deus se assenta sobre o seu santo trono.",
      "palavras": [
        { "hebraico": "מָלַ֣ךְ", "transliteral": "mā-laḵ", "traducao_palavra": "reina" },
        { "hebraico": "אֱ֭לֹהִים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "Deus" },
        { "hebraico": "עַל־גֹּויִ֑ם", "transliteral": "ʿal-gô-yim", "traducao_palavra": "sobre [as] nações" },
        { "hebraico": "אֱ֝לֹהִ֗ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "Deus" },
        { "hebraico": "יָשַׁ֥ב", "transliteral": "yā-šab", "traducao_palavra": "sentou-se" },
        { "hebraico": "עַל־כִּסֵּ֥א", "transliteral": "ʿal-kis-sē", "traducao_palavra": "sobre [o] trono de" },
