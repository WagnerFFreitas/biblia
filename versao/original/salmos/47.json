        { "hebraico": "אַבְרָ֫הָ֥ם", "transliteral": "ʾaḇ-rā-hām", "traducao_palavra": "Abraão" },
        { "hebraico": "כִּ֣י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "לֵ֭אלֹהִים", "transliteral": "lê-lō-hîm", "traducao_palavra": "a Deus [pertencem]" },
        { "hebraico": "מָֽגִנֵּי־אֶ֗רֶץ", "transliteral": "mā-ḡin-nê-ʾe-reṣ", "traducao_palavra": "os escudos da terra" },
