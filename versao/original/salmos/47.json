{
  "livro": "Salmos - תְּהִלִּים - Tehillim",
  "capítulo": 47,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Ao mestre de canto. Dos filhos de Corá. Salmo.",
      "palavras": [
        { "hebraico": "לַמְנַצֵּ֥חַ", "transliteral": "lam-naṣ-ṣē-aḥ", "traducao_palavra": "ao mestre de canto" },
        { "hebraico": "לִבְנֵי־קֹ֑רַח", "transliteral": "liḇ-nê-qō-raḥ", "traducao_palavra": "para os filhos de Corá" },
        { "hebraico": "מִזְמֹֽור׃", "transliteral": "miz-môr", "traducao_palavra": "salmo" }
      ]
    },
    "2": {
      "traducao_completa": "Batei palmas, todos os povos; aclamai a Deus com voz de júbilo.",
      "palavras": [
        { "hebraico": "כָּֽל־הָ֭עַמִּים", "transliteral": "kāl-hā-ʿam-mîm", "traducao_palavra": "todos os povos" },
        { "hebraico": "תִּקְעוּ־כָ֑ף", "transliteral": "tiq-ʿû-ḵāp̄", "traducao_palavra": "batei a palma/mão" },
        { "hebraico": "הָרִ֥יעוּ", "transliteral": "hā-rî-ʿû", "traducao_palavra": "aclamai/gritai" },
        { "hebraico": "לֵ֝אלֹהִ֗ים", "transliteral": "lê-lō-hîm", "traducao_palavra": "a Deus" },
        { "hebraico": "בְּקֹ֥ול", "transliteral": "bə-qôl", "traducao_palavra": "com voz de" },
        { "hebraico": "רִנָּֽה׃", "transliteral": "rin-nā", "traducao_palavra": "júbilo/canto" }
      ]
    },
    "3": {
      "traducao_completa": "Porque YHWH Altíssimo é tremendo, e Rei grande sobre toda a terra.",
      "palavras": [
        { "hebraico": "כִּֽי־יְהוָ֣ה", "transliteral": "kî-YHWH", "traducao_palavra": "porque YHWH" },
        { "hebraico": "עֶלְיֹ֣ון", "transliteral": "ʿel-yôn", "traducao_palavra": "Altíssimo" },
        { "hebraico": "נֹורָ֑א", "transliteral": "nô-rā", "traducao_palavra": "[é] tremendo/temível" },
        { "hebraico": "מֶ֥לֶךְ", "transliteral": "me-leḵ", "traducao_palavra": "Rei" },
        { "hebraico": "גָּ֝דֹ֗ול", "transliteral": "gā-ḏôl", "traducao_palavra": "grande" },
        { "hebraico": "עַל־כָּל־הָאָֽרֶץ׃", "transliteral": "ʿal-kāl-hā-ʾā-reṣ", "traducao_palavra": "sobre toda a terra" }
      ]
    },
    "4": {
      "traducao_completa": "Ele sujeitou os povos debaixo de nós e as nações debaixo dos nossos pés.",
      "palavras": [
        { "hebraico": "יַדְבֵּ֣ר", "transliteral": "yaḏ-bēr", "traducao_palavra": "ele sujeitou/submeteu" },
        { "hebraico": "עַמִּ֣ים", "transliteral": "ʿam-mîm", "traducao_palavra": "povos" },
        { "hebraico": "תַּחְתֵּ֑ינוּ", "transliteral": "taḥ-tê-nû", "traducao_palavra": "debaixo de nós" },
        { "hebraico": "וּ֝לְאֻמִּ֗ים", "transliteral": "ū-lə-ʾum-mîm", "traducao_palavra": "e nações" },
        { "hebraico": "תַּ֣חַת", "transliteral": "ta-ḥaṯ", "traducao_palavra": "debaixo de" },
        { "hebraico": "רַגְלֵֽינוּ׃", "transliteral": "raḡ-lê-nû", "traducao_palavra": "nossos pés" }
      ]
    },
    "5": {
      "traducao_completa": "Escolheu para nós a nossa herança, a excelência de Jacó, a quem amou. (Selah)",
      "palavras": [
        { "hebraico": "יִבְחַר־לָ֥נוּ", "transliteral": "yiḇ-ḥar-lā-nû", "traducao_palavra": "escolheu para nós" },
        { "hebraico": "אֶת־נַחֲלָתֵ֑נוּ", "transliteral": "ʾeṯ-na-ḥă-lā-ṯê-nû", "traducao_palavra": "a nossa herança" },
        { "hebraico": "אֶ֥ת", "transliteral": "ʾeṯ", "traducao_palavra": "[objeto]" },
        { "hebraico": "גְּאֹ֨ון", "transliteral": "gə-ʾôn", "traducao_palavra": "a excelência/orgulho de" },
        { "hebraico": "יַעֲקֹ֖ב", "transliteral": "ya-ʿă-qōḇ", "traducao_palavra": "Jacó" },
        { "hebraico": "אֲשֶׁר־אָהֵ֥ב", "transliteral": "ʾă-šer-ʾā-hēḇ", "traducao_palavra": "a quem amou" },
        { "hebraico": "סֶֽלָה׃", "transliteral": "se-lā", "traducao_palavra": "Selah [pausa]" }
      ]
    },
    "6": {
      "traducao_completa": "Deus subiu por entre aclamações, YHWH ao som do shofar.",
      "palavras": [
        { "hebraico": "עָלָ֣ה", "transliteral": "ʿā-lā", "traducao_palavra": "subiu" },
