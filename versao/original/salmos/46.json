        { "hebraico": "עִיר־אֱלֹהִ֑ים", "transliteral": "ʿîr-ʾĕ-lō-hîm", "traducao_palavra": "[a] cidade de Deus" },
        { "hebraico": "קְ֝דֹ֗שׁ", "transliteral": "qə-ḏōš", "traducao_palavra": "o lugar santo de" },
