    "5": {
      "traducao_completa": "Há um rio cujas correntes alegram a cidade de Deus, o santuário das moradas do Altíssimo.",
      "palavras": [
        { "hebraico": "נָהָ֗ר", "transliteral": "nā-hār", "traducao_palavra": "[há um] rio" },
