        { "hebraico": "אֱלֹהִ֣ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "Deus" },
        { "hebraico": "בְּ֭קִרְבָּהּ", "transliteral": "bə-qir-bāh", "traducao_palavra": "no meio dela" },
        { "hebraico": "בַּל־תִּמֹּ֑וט", "transliteral": "bal-tim-môṭ", "traducao_palavra": "não será abalada" },
        { "hebraico": "יַעְזְרֶ֥הָ", "transliteral": "yaʿ-zə-re-hā", "traducao_palavra": "ajudará ela" },
        { "hebraico": "אֱ֝לֹהִ֗ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "Deus" },
