{
  "livro": "Salmos - תְּהִלִּים - Tehillim",
  "capítulo": 46,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Ao mestre de canto. Dos filhos de Corá. Sobre Alamote. Cântico.",
      "palavras": [
        { "hebraico": "לַמְנַצֵּ֥חַ", "transliteral": "lam-naṣ-ṣē-aḥ", "traducao_palavra": "ao mestre de canto" },
        { "hebraico": "לִבְנֵי־קֹ֑רַח", "transliteral": "liḇ-nê-qō-raḥ", "traducao_palavra": "para os filhos de Corá" },
        { "hebraico": "עַֽל־עֲלָמֹ֥ות", "transliteral": "ʿal-ʿălā-môṯ", "traducao_palavra": "sobre Alamote [vozes agudas]" },
        { "hebraico": "שִֽׁיר׃", "transliteral": "šîr", "traducao_palavra": "cântico" }
      ]
    },
    "2": {
      "traducao_completa": "Deus é o nosso refúgio e fortaleza, socorro bem presente na angústia.",
      "palavras": [
        { "hebraico": "אֱלֹהִ֣ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "Deus" },
        { "hebraico": "לָ֭נוּ", "transliteral": "lā-nû", "traducao_palavra": "para nós [é]" },
        { "hebraico": "מַחֲסֶ֣ה", "transliteral": "ma-ḥă-seh", "traducao_palavra": "refúgio" },
        { "hebraico": "וָעֹ֑ז", "transliteral": "wā-ʿōz", "traducao_palavra": "e fortaleza/força" },
        { "hebraico": "עֶזְרָ֥ה", "transliteral": "ʿez-rā", "traducao_palavra": "ajuda/socorro" },
        { "hebraico": "בְ֝צָרֹ֗ות", "transliteral": "ḇə-ṣā-rôṯ", "traducao_palavra": "nas angústias" },
        { "hebraico": "נִמְצָ֥א", "transliteral": "nim-ṣā", "traducao_palavra": "achado/encontrado" },
        { "hebraico": "מְאֹֽד׃", "transliteral": "mə-ʾōḏ", "traducao_palavra": "muito/grandemente" }
      ]
    },
    "3": {
      "traducao_completa": "Pelo que não temeremos, ainda que a terra se mude, e ainda que os montes se transportem para o meio dos mares.",
      "palavras": [
        { "hebraico": "עַל־כֵּ֣ן", "transliteral": "ʿal-kēn", "traducao_palavra": "por isso/portanto" },
        { "hebraico": "לֹא־נִ֭ירָא", "transliteral": "lō-yî-rā", "traducao_palavra": "não temeremos" },
        { "hebraico": "בְּהָמִ֣יר", "transliteral": "bə-hā-mîr", "traducao_palavra": "no mudar/alterar de" },
        { "hebraico": "אָ֑רֶץ", "transliteral": "ʾā-reṣ", "traducao_palavra": "[a] terra" },
        { "hebraico": "וּבְמֹ֥וט", "transliteral": "ū-ḇə-môṭ", "traducao_palavra": "e no abalar de" },
        { "hebraico": "הָ֝רִ֗ים", "transliteral": "hā-rîm", "traducao_palavra": "montes" },
        { "hebraico": "בְּלֶ֣ב", "transliteral": "bə-lēḇ", "traducao_palavra": "no coração/meio de" },
        { "hebraico": "יַמִּֽים׃", "transliteral": "yam-mîm", "traducao_palavra": "mares" }
      ]
    },
    "4": {
      "traducao_completa": "Ainda que as suas águas rujam e se perturbem, ainda que os montes tremam com a sua soberba. (Selah)",
      "palavras": [
        { "hebraico": "יֶהֱמ֣וּ", "transliteral": "ye-hĕ-mû", "traducao_palavra": "rujam/façam barulho" },
        { "hebraico": "יֶחְמְר֣וּ", "transliteral": "ye-ḥəmə-rû", "traducao_palavra": "fervam/espumem" },
        { "hebraico": "מֵימָ֑יו", "transliteral": "mê-māw", "traducao_palavra": "águas dele" },
        { "hebraico": "יִרְעֲשֽׁוּ־הָרִ֖ים", "transliteral": "yir-ʿă-śû-hā-rîm", "traducao_palavra": "tremam os montes" },
