    "8": {
      "traducao_completa": "YHWH dos Exércitos está conosco; o Deus de Jacó é o nosso refúgio. (Selah)",
      "palavras": [
        { "hebraico": "יְהוָ֣ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
