    "7": {
      "traducao_completa": "As nações bramaram, os reinos se moveram; ele levantou a sua voz e a terra se derreteu.",
      "palavras": [
        { "hebraico": "הָמ֣וּ", "transliteral": "hā-mû", "traducao_palavra": "bramaram/agitaram-se" },
        { "hebraico": "גֹ֭ויִם", "transliteral": "ḡô-yim", "traducao_palavra": "nações" },
        { "hebraico": "מָ֣טוּ", "transliteral": "mā-ṭû", "traducao_palavra": "abalaram-se/vacilaram" },
