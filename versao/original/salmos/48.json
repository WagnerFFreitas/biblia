        { "hebraico": "כְּשִׁמְךָ֤", "transliteral": "kə-šim-ḵā", "traducao_palavra": "como teu nome" },
        { "hebraico": "אֱלֹהִ֗ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "ó Deus" },
        { "hebraico": "כֵּ֣ן", "transliteral": "kên", "traducao_palavra": "assim" },
        { "hebraico": "תְּ֭הִלָּתְךָ", "transliteral": "tə-hil-lā-ṯə-ḵā", "traducao_palavra": "[é] teu louvor" },
