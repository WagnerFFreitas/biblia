        { "hebraico": "מֶ֣לֶךְ", "transliteral": "me-leḵ", "traducao_palavra": "Rei" },
        { "hebraico": "רָֽב׃", "transliteral": "rāḇ", "traducao_palavra": "grande" }
      ]
    },
    "4": {
      "traducao_completa": "Deus, nos seus palácios, é conhecido como um alto refúgio.",
      "palavras": [
        { "hebraico": "אֱלֹהִ֥ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "Deus" },
