        { "hebraico": "הַר־קָדְשֹֽׁו׃", "transliteral": "har-qāḏ-šô", "traducao_palavra": "monte da sua santidade" }
      ]
    },
    "3": {
      "traducao_completa": "Belo em sua elevação, a alegria de toda a terra é o monte Sião, nos confins do norte, a cidade do grande Rei.",
