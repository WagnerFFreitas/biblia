        { "hebraico": "יַחְדָּֽו׃", "transliteral": "yaḥ-dāw", "traducao_palavra": "juntamente" }
      ]
    },
    "6": {
      "traducao_completa": "Viram-na, e assim se maravilharam; ficaram perturbados e fugiram apressados.",
      "palavras": [
        { "hebraico": "הֵ֣מָּה", "transliteral": "hēm-mā", "traducao_palavra": "eles" },
