        { "hebraico": "יְהוָ֮ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "וּמְהֻלָּ֪ל", "transliteral": "ū-mə-hul-lāl", "traducao_palavra": "e louvado" },
        { "hebraico": "מְ֫אֹ֥ד", "transliteral": "mə-ʾōḏ", "traducao_palavra": "muito" },
        { "hebraico": "בְּעִ֥יר", "transliteral": "bə-ʿîr", "traducao_palavra": "na cidade de" },
