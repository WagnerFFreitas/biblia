{
  "livro": "Salmos - תְּהִלִּים - Tehillim",
  "capítulo": 48,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Cântico. Salmo para os filhos de Corá.",
      "palavras": [
        { "hebraico": "שִׁ֥יר", "transliteral": "šîr", "traducao_palavra": "cântico" },
        { "hebraico": "מִ֝זְמֹ֗ור", "transliteral": "miz-môr", "traducao_palavra": "salmo" },
        { "hebraico": "לִבְנֵi־קֹֽרַח׃", "transliteral": "liḇ-nê-qō-raḥ", "traducao_palavra": "para os filhos de Corá" }
      ]
    },
    "2": {
      "traducao_completa": "Grande é YHWH e mui digno de louvor, na cidade do nosso Deus, no seu santo monte.",
      "palavras": [
