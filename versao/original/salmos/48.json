        { "hebraico": "חִ֝֗יל", "transliteral": "ḥîl", "traducao_palavra": "angústia/dor" },
        { "hebraico": "כַּיֹּולֵדָֽה׃", "transliteral": "kay-yô-lê-ḏā", "traducao_palavra": "como a parturiente" }
      ]
