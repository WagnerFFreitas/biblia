        { "hebraico": "מְשֹׂ֪ושׂ", "transliteral": "mə-śôś", "traducao_palavra": "alegria de" },
        { "hebraico": "כָּל־הָ֫אָ֥רֶץ", "transliteral": "kāl-hā-ʾā-reṣ", "traducao_palavra": "toda a terra" },
        { "hebraico": "הַר־צִ֭יֹּון", "transliteral": "har-ṣiy-yôn", "traducao_palavra": "monte Sião" },
        { "hebraico": "יַרְכְּתֵ֣י", "transliteral": "yar-kə-ṯê", "traducao_palavra": "lados/confins de" },
