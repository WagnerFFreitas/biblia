        { "hebraico": "עַמֶּ֑ךָ", "transliteral": "ʿam-me-ḵā", "traducao_palavra": "teu povo" },
        { "hebraico": "כִּסִּ֖יתָ", "transliteral": "kis-śî-ṯā", "traducao_palavra": "cobriste" },
        { "hebraico": "כָל־", "transliteral": "ḵāl-", "traducao_palavra": "toda" },
        { "hebraico": "חַטָּאתָ֣ם", "transliteral": "ḥaṭ-ṭā-ṯām", "traducao_palavra": "pecado deles" },
        { "hebraico": "סֶֽלָה׃", "transliteral": "śe-lā", "traducao_palavra": "Selah [pausa]" }
