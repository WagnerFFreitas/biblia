        { "hebraico": "כָל־", "transliteral": "ḵāl-", "traducao_palavra": "toda" },
        { "hebraico": "עֶבְרָתֶ֑ךָ", "transliteral": "ʿeḇ-rā-ṯe-ḵā", "traducao_palavra": "tua indignação/fúria" },
        { "hebraico": "הֱ֝שִׁיבֹ֗ותָ", "transliteral": "hĕ-šî-ḇô-ṯā", "traducao_palavra": "desviaste/fizeste voltar" },
        { "hebraico": "מֵחֲרֹ֥ון", "transliteral": "mē-ḥă-rôn", "traducao_palavra": "do ardor de" },
