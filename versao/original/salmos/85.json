        { "hebraico": "יְהוָ֣ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "אַרְצֶ֑ךָ", "transliteral": "ʾar-ṣe-ḵā", "traducao_palavra": "tua terra" },
        { "hebraico": "שַׁ֝֗בְתָּ", "transliteral": "šaḇ-tā", "traducao_palavra": "restauraste/fizeste voltar" },
        { "hebraico": "שְׁב֣וּת", "transliteral": "šə-ḇûṯ", "traducao_palavra": "[o] cativeiro de" },
        { "hebraico": "יַעֲקֹֽב׃", "transliteral": "ya-ʿă-qōḇ", "traducao_palavra": "Jacó" }
      ]
    },
    "2": {
