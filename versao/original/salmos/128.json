        { "hebraico": "כִּ֣י", "transliteral": "kî", "traducao_palavra": "pois/quando" },
        { "hebraico": "תֹאכֵ֑ל", "transliteral": "ṯō-ḵēl", "traducao_palavra": "comerás" },
