    "5": {
      "traducao_completa": "Os que têm o coração robusto foram despojados; dormiram o seu sono; e nenhum dos homens de força pôde usar as mãos.",
      "palavras": [
        { "hebraico": "אֶשְׁתֹּ֘ולֲל֨וּ ׀", "transliteral": "ʾeš-tô-lə-lû", "traducao_palavra": "foram despojados" },
