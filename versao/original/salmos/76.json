    "8": {
      "traducao_completa": "Desde os céus fizeste ouvir o teu juízo; a terra tremeu e se aquietou,",
      "palavras": [
        { "hebraico": "מִ֭שָּׁמַיִם", "transliteral": "miš-šā-ma-yim", "traducao_palavra": "dos céus" },
        { "hebraico": "הִשְׁמַ֣עְתָּ", "transliteral": "hiš-ma-ʿat-tā", "traducao_palavra": "fizeste ouvir" },
        { "hebraico": "דִּ֑ין", "transliteral": "dîn", "traducao_palavra": "juízo" },
        { "hebraico": "אֶ֖רֶץ", "transliteral": "ʾe-reṣ", "traducao_palavra": "[a] terra" },
        { "hebraico": "יָרְאָ֥ה", "transliteral": "yā-rə-ʾā", "traducao_palavra": "temeu" },
        { "hebraico": "וְשָׁקָֽטָה׃", "transliteral": "wə-šā-qā-ṭā", "traducao_palavra": "e se aquietou" }
