        { "hebraico": "אָ֑תָּה", "transliteral": "ʾāt-tā", "traducao_palavra": "tu [és]" },
        { "hebraico": "וּמִי־", "transliteral": "ū-mî-", "traducao_palavra": "e quem" },
        { "hebraico": "יַעֲמֹ֥ד", "transliteral": "ya-ʿă-mōḏ", "traducao_palavra": "subsistirá/ficará de pé" },
