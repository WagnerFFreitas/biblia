        { "hebraico": "קָ֑שֶׁת", "transliteral": "qā-šeṯ", "traducao_palavra": "arco" },
        { "hebraico": "מָ֘גֵ֤ן", "transliteral": "mā-ḡēn", "traducao_palavra": "escudo" },
        { "hebraico": "וְחֶ֖רֶב", "transliteral": "wə-ḥe-reḇ", "traducao_palavra": "e espada" },
        { "hebraico": "וּמִלְחָמָ֣ה", "transliteral": "ū-mil-ḥā-mā", "traducao_palavra": "e batalha/guerra" },
