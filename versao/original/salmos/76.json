        { "hebraico": "וּמְעֹונָתֹ֥ו", "transliteral": "ū-mə-ʿô-nā-ṯô", "traducao_palavra": "e sua morada" },
        { "hebraico": "בְצִיֹּֽון׃", "transliteral": "ḇə-ṣiy-yôn", "traducao_palavra": "em Sião" }
