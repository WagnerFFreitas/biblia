        { "hebraico": "נִ֝רְדָּ֗ם", "transliteral": "nir-dām", "traducao_palavra": "adormeceu" },
        { "hebraico": "וְרֶ֥כֶב", "transliteral": "wə-re-ḵeḇ", "traducao_palavra": "tanto carro" },
