  "versiculos": {
    "1": {
      "traducao_completa": "Conhecido é Deus em Judá; grande é o seu nome em Israel.",
      "palavras": [
        { "hebraico": "נֹודָ֥ע", "transliteral": "nô-ḏāʿ", "traducao_palavra": "conhecido [é]" },
        { "hebraico": "בִּיהוּדָ֪ה", "transliteral": "bî-hû-ḏā", "traducao_palavra": "em Judá" },
        { "hebraico": "אֱלֹהִ֑ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "Deus" },
        { "hebraico": "בְּ֝יִשְׂרָאֵ֗ל", "transliteral": "bə-yiś-rā-ʾēl", "traducao_palavra": "em Israel" },
        { "hebraico": "גָּדֹ֥ול", "transliteral": "gā-ḏôl", "traducao_palavra": "grande [é]" },
        { "hebraico": "שְׁמֹֽו׃", "transliteral": "šə-mô", "traducao_palavra": "o seu nome" }
