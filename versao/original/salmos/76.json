    "9": {
      "traducao_completa": "Quando Deus se levantou para julgar, para salvar a todos os mansos da terra. (Selah)",
      "palavras": [
        { "hebraico": "בְּקוּם־", "transliteral": "bə-qûm-", "traducao_palavra": "ao levantar-se" },
