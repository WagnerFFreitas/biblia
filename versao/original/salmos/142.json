{
  "livro": "Salmos - תְּהִלִּים - Tehillim",
  "capítulo": 142,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Com a minha voz clamo a YHWH; com a minha voz suplico a YHWH.",
