        { "hebraico": "אֶל־", "transliteral": "ʾel-", "traducao_palavra": "a/para" },
        { "hebraico": "יְהוָ֥ah", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "אֶזְעָ֑ק", "transliteral": "ʾez-ʿāq", "traducao_palavra": "eu clamo" },
        { "hebraico": "קֹולִ֥י", "transliteral": "qô-lî", "traducao_palavra": "minha voz" },
        { "hebraico": "אֶל־", "transliteral": "ʾel-", "traducao_palavra": "a/para" },
        { "hebraico": "יְהוָ֥ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "אֶתְחַנָּֽן׃", "transliteral": "ʾeṯ-ḥan-nān", "traducao_palavra": "eu suplico/imploro" }
      ]
    },
    "2": {
      "traducao_completa": "Derramo perante ele a minha queixa; exponho diante dele a minha tribulação.",
      "palavras": [
        { "hebraico": "אֶשְׁפֹּ֤ךְ", "transliteral": "ʾeš-pōḵ", "traducao_palavra": "eu derramo" },
        { "hebraico": "לְפָנָ֨יו", "transliteral": "lə-p̄ā-nāw", "traducao_palavra": "perante ele" },
        { "hebraico": "שִׂיחִ֑י", "transliteral": "śî-ḥî", "traducao_palavra": "minha queixa/meditação" },
        { "hebraico": "צָרָתִ֓י", "transliteral": "ṣā-rā-ṯî", "traducao_palavra": "minha angústia/tribulação" },
        { "hebraico": "לְפָנָ֖יו", "transliteral": "lə-p̄ā-nāw", "traducao_palavra": "perante ele" },
        { "hebraico": "אַגִּֽיד׃", "transliteral": "ʾag-gîḏ", "traducao_palavra": "eu declaro/exponho" }
      ]
    },
    "3": {
      "traducao_completa": "Quando o meu espírito desfalecia dentro de mim, tu conhecias a minha vereda. No caminho em que eu andava, esconderam-me um laço.",
      "palavras": [
        { "hebraico": "בְּהִתְעַטֵּ֬ף", "transliteral": "bə-hiṯ-ʿaṭ-ṭēp̄", "traducao_palavra": "no desfalecer/desfalecendo" },
        { "hebraico": "עָלַ֨י ׀", "transliteral": "ʿā-lay", "traducao_palavra": "sobre mim" },
        { "hebraico": "רוּחִ֗י", "transliteral": "rû-ḥî", "traducao_palavra": "meu espírito" },
        { "hebraico": "וְאַתָּה֮", "transliteral": "wə-ʾat-tā", "traducao_palavra": "e tu" },
        { "hebraico": "יָדַ֪עְתָּ", "transliteral": "yā-ḏa-ʿtā", "traducao_palavra": "conhecias" },
        { "hebraico": "נְתִיבָ֫תִ֥י", "transliteral": "nə-ṯî-ḇā-ṯî", "traducao_palavra": "minha vereda" },
        { "hebraico": "בְּאֹֽרַח־", "transliteral": "bə-ʾō-raḥ-", "traducao_palavra": "no caminho" },
        { "hebraico": "ז֥וּ", "transliteral": "zû", "traducao_palavra": "que" },
        { "hebraico": "אֲהַלֵּ֑ךְ", "transliteral": "ʾă-hal-lēḵ", "traducao_palavra": "eu ando/andava" },
        { "hebraico": "טָמְנ֖וּ", "transliteral": "ṭām-nû", "traducao_palavra": "esconderam" },
        { "hebraico": "פַ֣ח", "transliteral": "p̄aḥ", "traducao_palavra": "um laço" },
        { "hebraico": "לִֽי׃", "transliteral": "lî", "traducao_palavra": "para mim" }
      ]
    },
    "4": {
      "traducao_completa": "Olha para a minha direita, e vê; pois não há quem me conheça. Refúgio me faltou; ninguém cuida da minha alma.",
      "palavras": [
        { "hebraico": "הַבֵּ֤יט", "transliteral": "hab-bêṭ", "traducao_palavra": "olha" },
        { "hebraico": "יָ֘מִ֤ין", "transliteral": "yā-mîn", "traducao_palavra": "[à] direita" },
        { "hebraico": "וּרְאֵ֗ה", "transliteral": "ū-rə-ʾēh", "traducao_palavra": "e vê" },
        { "hebraico": "וְאֵֽין־", "transliteral": "wə-ʾên-", "traducao_palavra": "e não há" },
        { "hebraico": "לִ֫י", "transliteral": "lî", "traducao_palavra": "para mim" },
        { "hebraico": "מַכִּ֥יר", "transliteral": "mak-kîr", "traducao_palavra": "[quem] conheça/reconheça" },
        { "hebraico": "אָבַ֣ד", "transliteral": "ʾā-ḇaḏ", "traducao_palavra": "pereceu/perdeu-se" },
        { "hebraico": "מָ֭נֹוס", "transliteral": "mā-nôś", "traducao_palavra": "refúgio" },
        { "hebraico": "מִמֶּ֑נִּי", "transliteral": "mim-men-nî", "traducao_palavra": "de mim" },
        { "hebraico": "אֵ֖ין", "transliteral": "ʾên", "traducao_palavra": "não há" },
        { "hebraico": "דֹּורֵ֣שׁ", "transliteral": "dô-rēš", "traducao_palavra": "[quem] busque/cuide de" },
        { "hebraico": "לְנַפְשִֽׁי׃", "transliteral": "lə-nap̄-šî", "traducao_palavra": "minha alma" }
      ]
    },
    "5": {
      "traducao_completa": "A ti, YHWH, clamei; eu disse: Tu és o meu refúgio, e a minha porção na terra dos viventes.",
      "palavras": [
        { "hebraico": "זָעַ֥קְתִּי", "transliteral": "zā-ʿaq-tî", "traducao_palavra": "clamei" },
        { "hebraico": "אֵלֶיךָ֮", "transliteral": "ʾē-ley-ḵā", "traducao_palavra": "a ti" },
        { "hebraico": "יְהוָ֪ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "אָ֫מַ֥רְתִּי", "transliteral": "ʾā-mar-tî", "traducao_palavra": "eu disse" },
        { "hebraico": "אַתָּ֥ה", "transliteral": "ʾat-tā", "traducao_palavra": "tu [és]" },
        { "hebraico": "מַחְסִ֑י", "transliteral": "maḥ-śî", "traducao_palavra": "meu refúgio" },
        { "hebraico": "חֶ֝לְקִ֗י", "transliteral": "ḥel-qî", "traducao_palavra": "minha porção" },
        { "hebraico": "בְּאֶ֣רֶץ", "transliteral": "bə-ʾe-reṣ", "traducao_palavra": "na terra de" },
        { "hebraico": "הַֽחַיִּים׃", "transliteral": "ha-ḥay-yîm", "traducao_palavra": "os viventes" }
      ]
    },
    "6": {
      "traducao_completa": "Atende ao meu clamor, porque estou muito abatido; livra-me dos meus perseguidores, porque são mais fortes do que eu.",
      "palavras": [
        { "hebraico": "הַקְשִׁ֤יבָה ׀", "transliteral": "haq-šî-ḇā", "traducao_palavra": "atende" },
        { "hebraico": "אֶֽל־", "transliteral": "ʾel-", "traducao_palavra": "a" },
        { "hebraico": "רִנָּתִ֗י", "transliteral": "rin-nā-ṯî", "traducao_palavra": "meu clamor" },
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "porque" },
        { "hebraico": "דַלֹּ֥ותִי", "transliteral": "dal-lô-ṯî", "traducao_palavra": "estou enfraquecido/abatido" },
        { "hebraico": "מְאֹ֑ד", "transliteral": "mə-ʾōḏ", "traducao_palavra": "muito" },
        { "hebraico": "הַצִּילֵ֥נִי", "transliteral": "haṣ-ṣî-lē-nî", "traducao_palavra": "livra-me" },
        { "hebraico": "מֵרֹדְפַ֗י", "transliteral": "mē-rō-ḏə-p̄ay", "traducao_palavra": "dos meus perseguidores" },
        { "hebraico": "כִּ֖י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "אָמְצ֣וּ", "transliteral": "ʾā-mə-ṣû", "traducao_palavra": "são fortes/poderosos" },
        { "hebraico": "מִמֶּֽנִּי׃", "transliteral": "mim-men-nî", "traducao_palavra": "mais do que eu" }
      ]
    },
    "7": {
      "traducao_completa": "Tira a minha alma da prisão, para que eu louve o teu nome; os justos me cercarão, quando me fizeres bem.",
      "palavras": [
        { "hebraico": "הֹ֘וצִ֤יאָה", "transliteral": "hô-ṣî-ʾā", "traducao_palavra": "tira/faz sair" },
        { "hebraico": "מִמַּסְגֵּ֨ר ׀", "transliteral": "mim-maś-gēr", "traducao_palavra": "da prisão/confinamento" },
        { "hebraico": "נַפְשִׁ֗י", "transliteral": "nap̄-šî", "traducao_palavra": "minha alma" },
        { "hebraico": "לְהֹודֹ֥ות", "transliteral": "lə-hō-ḏôṯ", "traducao_palavra": "para dar graças/louvar" },
        { "hebraico": "אֶת־", "transliteral": "ʾeṯ-", "traducao_palavra": "[objeto]" },
        { "hebraico": "שְׁמֶ֑ךָ", "transliteral": "šə-me-ḵā", "traducao_palavra": "teu nome" },
        { "hebraico": "בִּ֭י", "transliteral": "bî", "traducao_palavra": "em mim/por minha causa" },
        { "hebraico": "יַכְתִּ֣רוּ", "transliteral": "yaḵ-ti-rû", "traducao_palavra": "cercarão/coroarão" },
        { "hebraico": "צַדִּיקִ֑ים", "transliteral": "ṣad-dî-qîm", "traducao_palavra": "[os] justos" },
