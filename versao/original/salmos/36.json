{
  "livro": "Salmos - תְּהִלִּים - Tehillim",
  "capítulo": 36,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Ao mestre de canto. Do servo de YHWH. De Davi.",
      "palavras": [
        { "hebraico": "לַמְנַצֵּ֥חַ", "transliteral": "lam-naṣ-ṣē-aḥ", "traducao_palavra": "ao mestre de canto" },
        { "hebraico": "לְעֶֽבֶד־יְהוָ֗ה", "transliteral": "lə-ʿe-ḇeḏ-YHWH", "traducao_palavra": "do servo de YHWH" },
        { "hebraico": "לְדָוִֽד׃", "transliteral": "lə-ḏā-wiḏ", "traducao_palavra": "de Davi" }
      ]
    },
    "2": {
      "traducao_completa": "A transgressão do ímpio diz no íntimo do meu coração: Não há temor de Deus diante dos seus olhos.",
      "palavras": [
        { "hebraico": "נְאֻם־פֶּ֣שַׁע", "transliteral": "nə-ʾum-pe-šaʿ", "traducao_palavra": "diz o crime/transgressão" },
        { "hebraico": "לָ֭רָשָׁע", "transliteral": "lā-rā-šāʿ", "traducao_palavra": "ao ímpio" },
        { "hebraico": "בְּקֶ֣רֶב", "transliteral": "bə-qe-reḇ", "traducao_palavra": "no meio/íntimo de" },
        { "hebraico": "לִבִּ֑י", "transliteral": "lib-bî", "traducao_palavra": "meu coração" },
        { "hebraico": "אֵֽין־פַּ֥חַד", "transliteral": "ʾên-pa-ḥaḏ", "traducao_palavra": "não há pavor/temor" },
        { "hebraico": "אֱ֝לֹהִ֗ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "de Deus" },
        { "hebraico": "לְנֶ֣גֶד", "transliteral": "lə-ne-ḡeḏ", "traducao_palavra": "diante de" },
        { "hebraico": "עֵינָֽיו׃", "transliteral": "ʿê-nāw", "traducao_palavra": "olhos dele" }
      ]
    },
    "3": {
      "traducao_completa": "Porque em seus olhos se lisonjeia, cuidando que a sua iniquidade não será descoberta e odiada.",
      "palavras": [
        { "hebraico": "כִּֽי־הֶחֱלִ֣יק", "transliteral": "kî-he-ḥĕ-lîq", "traducao_palavra": "pois lisonjeia/suaviza" },
        { "hebraico": "אֵלָ֣יו", "transliteral": "ʾē-lāw", "traducao_palavra": "a ele mesmo" },
        { "hebraico": "בְּעֵינָ֑יו", "transliteral": "bə-ʿê-nāw", "traducao_palavra": "em seus olhos" },
        { "hebraico": "לִמְצֹ֖א", "transliteral": "lim-ṣō", "traducao_palavra": "para achar/descobrir" },
        { "hebraico": "עֲוֹנֹ֣ו", "transliteral": "ʿă-wō-nô", "traducao_palavra": "iniquidade dele" },
        { "hebraico": "לִשְׂנֹֽא׃", "transliteral": "liś-nō", "traducao_palavra": "para odiar" }
      ]
    },
    "4": {
      "traducao_completa": "As palavras da sua boca são malícia e engano; deixou de ser sábio e de fazer o bem.",
      "palavras": [
        { "hebraico": "דִּבְרֵי־פִ֭יו", "transliteral": "diḇ-rê-p̄îw", "traducao_palavra": "palavras da boca dele" },
        { "hebraico": "אָ֣וֶן", "transliteral": "ʾā-wen", "traducao_palavra": "[são] iniquidade" },
        { "hebraico": "וּמִרְמָ֑ה", "transliteral": "ū-mir-mā", "traducao_palavra": "e engano" },
        { "hebraico": "חָדַ֥ל", "transliteral": "ḥā-ḏal", "traducao_palavra": "ele cessou/parou" },
        { "hebraico": "לְהַשְׂכִּ֗יל", "transliteral": "lə-haś-kîl", "traducao_palavra": "de ser sábio/entendido" },
        { "hebraico": "לְהֵיטִֽיב׃", "transliteral": "lə-hê-ṭîḇ", "traducao_palavra": "de fazer o bem" }
      ]
    },
    "5": {
      "traducao_completa": "Maquina a malícia na sua cama; põe-se no caminho que não é bom; não odeia o mal.",
      "palavras": [
        { "hebraico": "אָ֤וֶן", "transliteral": "ʾā-wen", "traducao_palavra": "iniquidade" },
        { "hebraico": "יַחְשֹׁ֣ב", "transliteral": "ya-ḥă-šōḇ", "traducao_palavra": "ele planeja/pensa" },
        { "hebraico": "עַל־מִשְׁכָּבֹ֑ו", "transliteral": "ʿal-miš-kā-ḇô", "traducao_palavra": "sobre sua cama" },
        { "hebraico": "יִ֝תְיַצֵּ֗ב", "transliteral": "yiṯ-yaṣ-ṣēḇ", "traducao_palavra": "ele se coloca/posiciona" },
        { "hebraico": "עַל־דֶּ֥רֶךְ", "transliteral": "ʿal-de-reḵ", "traducao_palavra": "sobre caminho" },
        { "hebraico": "לֹא־טֹ֗וב", "transliteral": "lō-ṭôḇ", "traducao_palavra": "não bom" },
        { "hebraico": "רָ֣ע", "transliteral": "rāʿ", "traducao_palavra": "[o] mal" },
        { "hebraico": "לֹא־יִמְאָֽס׃", "transliteral": "lō-yim-ʾās", "traducao_palavra": "não rejeita/odeia" }
      ]
    },
    "6": {
      "traducao_completa": "A tua misericórdia, YHWH, está nos céus, e a tua fidelidade chega até às nuvens.",
      "palavras": [
        { "hebraico": "יְ֭הוָה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "בְּהַשָּׁמַ֣יִם", "transliteral": "bə-haš-šā-ma-yim", "traducao_palavra": "nos céus" },
        { "hebraico": "חַסְדֶּ֑ךָ", "transliteral": "ḥas-de-ḵā", "traducao_palavra": "[está] tua misericórdia" },
        { "hebraico": "אֱ֝מֽוּנָתְךָ֗", "transliteral": "ʾĕ-mû-nā-ṯə-ḵā", "traducao_palavra": "tua fidelidade" },
        { "hebraico": "עַד־שְׁחָקִֽים׃", "transliteral": "ʿaḏ-šə-ḥā-qîm", "traducao_palavra": "até [as] nuvens/céus" }
      ]
    },
    "7": {
      "traducao_completa": "A tua justiça é como as grandes montanhas; os teus juízos são um grande abismo. Tu, YHWH, preservas os homens e os animais.",
      "palavras": [
        { "hebraico": "צִדְקָתְךָ֨", "transliteral": "ṣiḏ-qā-ṯə-ḵā", "traducao_palavra": "tua justiça" },
        { "hebraico": "כְּֽהַרְרֵי־אֵ֗ל", "transliteral": "kə-har-rê-ʾēl", "traducao_palavra": "como montanhas de Deus" },
        { "hebraico": "מִ֭שְׁפָּטֶךָ", "transliteral": "miš-pā-ṭe-ḵā", "traducao_palavra": "teus juízos" },
        { "hebraico": "תְּהֹ֣ום", "transliteral": "tə-hôm", "traducao_palavra": "[são] abismo" },
        { "hebraico": "רַבָּ֑ה", "transliteral": "rab-bā", "traducao_palavra": "grande" },
        { "hebraico": "אָ֘דָ֤ם", "transliteral": "ʾā-ḏām", "traducao_palavra": "homem" },
        { "hebraico": "וּבהֵמָ֖ה", "transliteral": "ū-ḇə-hē-mā", "traducao_palavra": "e animal" },
        { "hebraico": "תֹושִׁ֣יעַ", "transliteral": "tô-šî-aʿ", "traducao_palavra": "salvas/preservas" },
        { "hebraico": "יְהוָֽה׃", "transliteral": "YHWH", "traducao_palavra": "YHWH" }
      ]
    },
    "8": {
      "traducao_completa": "Quão preciosa é, ó Deus, a tua misericórdia! Por isso os filhos dos homens se refugiam à sombra das tuas asas.",
      "palavras": [
        { "hebraico": "מַה־יָּקָ֥ר", "transliteral": "mah-yā-qār", "traducao_palavra": "quão preciosa" },
        { "hebraico": "חַסְדְּךָ֗", "transliteral": "ḥas-də-ḵā", "traducao_palavra": "tua misericórdia" },
        { "hebraico": "אֱלֹ֫הִ֥ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "Deus" },
        { "hebraico": "וּבְנֵ֥י", "transliteral": "ū-ḇə-nê", "traducao_palavra": "e filhos de" },
        { "hebraico": "אָדָ֑ם", "transliteral": "ʾā-ḏām", "traducao_palavra": "homem" },
        { "hebraico": "בְּצֵ֥ל", "transliteral": "bə-ṣēl", "traducao_palavra": "na sombra de" },
        { "hebraico": "כְּ֝נָפֶ֗יךָ", "transliteral": "kə-nā-p̄e-ḵā", "traducao_palavra": "tuas asas" },
        { "hebraico": "יֶחֱסָיֽוּן׃", "transliteral": "ye-ḥĕ-śā-yûn", "traducao_palavra": "se refugiam" }
      ]
    },
    "9": {
      "traducao_completa": "Eles se fartarão da gordura da tua casa, e os farás beber da torrente das tuas delícias.",
      "palavras": [
        { "hebraico": "יִרְוְיֻן֮", "transliteral": "yir-wə-yun", "traducao_palavra": "eles se fartam/saciam" },
        { "hebraico": "מִדֶּ֪שֶׁן", "transliteral": "mid-de-šen", "traducao_palavra": "da gordura/abundância de" },
        { "hebraico": "בֵּיתֶ֥ךָ", "transliteral": "bê-ṯe-ḵā", "traducao_palavra": "tua casa" },
        { "hebraico": "וְנַ֖חַל", "transliteral": "wə-na-ḥal", "traducao_palavra": "e da torrente de" },
        { "hebraico": "עֲדָנֶ֣יךָ", "transliteral": "ʿă-ḏā-ne-ḵā", "traducao_palavra": "tuas delícias" },
        { "hebraico": "תַשְׁקֵֽם׃", "transliteral": "taš-qēm", "traducao_palavra": "tu os fazes beber" }
      ]
    },
    "10": {
      "traducao_completa": "Porque em ti está o manancial da vida; na tua luz veremos a luz.",
      "palavras": [
        { "hebraico": "כִּֽי־עִ֭מְּךָ", "transliteral": "kî-ʿim-mə-ḵā", "traducao_palavra": "porque contigo" },
        { "hebraico": "מְקֹ֣ור", "transliteral": "mə-qôr", "traducao_palavra": "[está o] manancial/fonte de" },
        { "hebraico": "חַיִּ֑ים", "transliteral": "ḥay-yîm", "traducao_palavra": "vida" },
        { "hebraico": "בְּ֝אֹורְךָ֗", "transliteral": "bə-ʾôr-ḵā", "traducao_palavra": "na tua luz" },
        { "hebraico": "נִרְאֶה־אֹֽור׃", "transliteral": "nir-ʾeh-ʾôr", "traducao_palavra": "veremos luz" }
      ]
    },
    "11": {
      "traducao_completa": "Estende a tua misericórdia sobre os que te conhecem, e a tua justiça sobre os retos de coração.",
      "palavras": [
        { "hebraico": "מְשֹׁ֥ךְ", "transliteral": "mə-šōḵ", "traducao_palavra": "puxa/estende" },
        { "hebraico": "חַ֭סְדְּךָ", "transliteral": "ḥas-də-ḵā", "traducao_palavra": "tua misericórdia" },
        { "hebraico": "לְיֹדְעֶ֑יךָ", "transliteral": "lə-yō-ḏə-ʿe-ḵā", "traducao_palavra": "para os que te conhecem" },
        { "hebraico": "וְ֝צִדְקָתְךָ֗", "transliteral": "wə-ṣiḏ-qā-ṯə-ḵā", "traducao_palavra": "e tua justiça" },
        { "hebraico": "לְיִשְׁרֵי־לֵֽב׃", "transliteral": "lə-yiš-rê-lêḇ", "traducao_palavra": "para os retos de coração" }
      ]
    },
    "12": {
      "traducao_completa": "Não venha sobre mim o pé da soberba, e não me mova a mão dos ímpios.",
      "palavras": [
        { "hebraico": "אַל־תְּ֭בֹואֵנִי", "transliteral": "ʾal-tə-ḇô-ʾē-nî", "traducao_palavra": "não venha contra mim" },
        { "hebraico": "רֶ֣גֶל", "transliteral": "re-ḡel", "traducao_palavra": "[o] pé de" },
        { "hebraico": "גַּאֲוָ֑ה", "transliteral": "ga-ʾă-wā", "traducao_palavra": "soberba" },
        { "hebraico": "וְיַד־רְ֝שָׁעִ֗ים", "transliteral": "wə-yaḏ-rə-šā-ʿîm", "traducao_palavra": "e a mão de ímpios" },
        { "hebraico": "אַל־תְּנִדֵֽנִי׃", "transliteral": "ʾal-tə-ni-ḏē-nî", "traducao_palavra": "não me afugente/mova" }
      ]
    },
    "13": {
      "traducao_completa": "Ali caíram os praticantes da iniquidade; foram derrubados e não puderam levantar-se.",
      "palavras": [
        { "hebraico": "שָׁ֣ם", "transliteral": "šām", "traducao_palavra": "ali" },
        { "hebraico": "נָ֭פְלוּ", "transliteral": "nā-p̄ə-lû", "traducao_palavra": "caíram" },
        { "hebraico": "פֹּ֣עֲלֵי", "transliteral": "pō-ʿă-lê", "traducao_palavra": "praticantes de" },
        { "hebraico": "אָ֑וֶן", "transliteral": "ʾā-wen", "traducao_palavra": "iniquidade" },
        { "hebraico": "דֹּ֝ח֗וּ", "transliteral": "dō-ḥû", "traducao_palavra": "foram empurrados/derrubados" },
        { "hebraico": "וְלֹא־יָכְל֥וּ", "transliteral": "wə-lō-yā-ḵə-lû", "traducao_palavra": "e não puderam" },
        { "hebraico": "קֽוּם׃", "transliteral": "qûm", "traducao_palavra": "levantar-se" }
      ]
    }
  }
