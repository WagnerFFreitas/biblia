        { "hebraico": "כְּסִֽיסְרָ֭א", "transliteral": "kə-śî-śə-rā", "traducao_palavra": "como [a] Sísera" },
        { "hebraico": "כְיָבִ֣ין", "transliteral": "ḵə-yā-ḇîn", "traducao_palavra": "como [a] Jabim" },
