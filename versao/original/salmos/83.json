      ]
    },
    "6": {
      "traducao_completa": "As tendas de Edom, e os ismaelitas, Moabe e os hagarenos,",
      "palavras": [
        { "hebraico": "אָהֳלֵ֣י", "transliteral": "ʾā-ho-lê", "traducao_palavra": "as tendas de" },
        { "hebraico": "אֱ֭דֹום", "transliteral": "ʾĕ-ḏôm", "traducao_palavra": "Edom" },
        { "hebraico": "וְיִשְׁמְעֵאלִ֑ים", "transliteral": "wə-yiš-mə-ʿē-lîm", "traducao_palavra": "e ismaelitas" },
        { "hebraico": "מֹ֝ואָ֗ב", "transliteral": "mô-ʾāḇ", "traducao_palavra": "Moabe" },
