        { "hebraico": "גַּם־", "transliteral": "gam-", "traducao_palavra": "também" },
        { "hebraico": "אַשּׁ֥וּר", "transliteral": "ʾaš-šûr", "traducao_palavra": "Assur/Assíria" },
