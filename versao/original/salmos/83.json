        { "hebraico": "אֲשֶׁ֣ר", "transliteral": "ʾă-šer", "traducao_palavra": "que" },
        { "hebraico": "אָמְר֗וּ", "transliteral": "ʾā-mərû", "traducao_palavra": "disseram" },
