{
  "livro": "Salmos - תְּהִלִּים - Tehillim",
  "capítulo": 83,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Ó Deus, não fiques em silêncio; não te cales, nem te aquietes, ó Deus.",
      "palavras": [
