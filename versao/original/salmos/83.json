        { "hebraico": "לְ֭כוּ", "transliteral": "lə-ḵû", "traducao_palavra": "vinde" },
        { "hebraico": "וְנַכְחִידֵ֣ם", "transliteral": "wə-naḵ-ḥî-ḏēm", "traducao_palavra": "e cortemo-los/exterminemo-los" },
        { "hebraico": "מִגֹּ֑וי", "transliteral": "mig-gôy", "traducao_palavra": "de [ser] nação" },
        { "hebraico": "וְלֹֽא־", "transliteral": "wə-lō-", "traducao_palavra": "e não" },
        { "hebraico": "יִזָּכֵ֥ר", "transliteral": "yiz-zā-ḵēr", "traducao_palavra": "seja lembrado" },
        { "hebraico": "שֵֽׁם־", "transliteral": "šēm-", "traducao_palavra": "[o] nome de" },
