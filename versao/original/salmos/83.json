        { "hebraico": "שִׁיתֵ֣מֹו", "transliteral": "šî-ṯê-mô", "traducao_palavra": "põe-nos" },
        { "hebraico": "נְדִיבֵ֑מֹו", "transliteral": "nə-ḏî-ḇê-mô", "traducao_palavra": "os nobres deles" },
        { "hebraico": "כְּעֹרֵ֥ב", "transliteral": "kə-ʿō-rēḇ", "traducao_palavra": "como Orebe" },
        { "hebraico": "וְכִזְאֵ֑ב", "transliteral": "wə-ḵiz-ʾēḇ", "traducao_palavra": "e como Zeebe" },
