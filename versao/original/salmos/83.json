        { "hebraico": "עִם־", "transliteral": "ʿim-", "traducao_palavra": "com" },
        { "hebraico": "יֹ֥שְׁבֵי", "transliteral": "yō-šə-ḇê", "traducao_palavra": "moradores de" },
        { "hebraico": "צֹֽור׃", "transliteral": "ṣôr", "traducao_palavra": "Tiro" }
