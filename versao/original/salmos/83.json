        { "hebraico": "הָי֨וּ", "transliteral": "hā-yû", "traducao_palavra": "eles foram" },
        { "hebraico": "זְרֹ֖ועַ", "transliteral": "zə-rô-aʿ", "traducao_palavra": "braço/ajuda" },
        { "hebraico": "לִבְנֵי־", "transliteral": "liḇ-nê-", "traducao_palavra": "para os filhos de" },
