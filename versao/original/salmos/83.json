        { "hebraico": "אַל־", "transliteral": "ʾal-", "traducao_palavra": "não" },
        { "hebraico": "דֳּמִי־", "transliteral": "do-mî-", "traducao_palavra": "silêncio" },
        { "hebraico": "לָ֑ךְ", "transliteral": "lāk", "traducao_palavra": "para ti" },
        { "hebraico": "אַל־", "transliteral": "ʾal-", "traducao_palavra": "não" },
        { "hebraico": "תֶּחֱרַ֖שׁ", "transliteral": "te-ḥĕ-raš", "traducao_palavra": "te cales" },
        { "hebraico": "וְאַל־", "transliteral": "wə-ʾal-", "traducao_palavra": "e não" },
        { "hebraico": "תִּשְׁקֹ֣ט", "transliteral": "tiš-qōṭ", "traducao_palavra": "te aquietes" },
        { "hebraico": "אֵֽל׃", "transliteral": "ʾēl", "traducao_palavra": "ó Deus/Poderoso" }
      ]
    },
    "2": {
      "traducao_completa": "Porque eis que os teus inimigos fazem tumulto, e os que te odeiam levantaram a cabeça.",
      "palavras": [
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "pois" },
        { "hebraico": "הִנֵּ֣ה", "transliteral": "hin-nēh", "traducao_palavra": "eis que" },
        { "hebraico": "אֹ֭ויְבֶיךָ", "transliteral": "ʾô-yə-ḇe-ḵā", "traducao_palavra": "teus inimigos" },
        { "hebraico": "יֶהֱמָי֑וּן", "transliteral": "ye-hĕ-mā-yûn", "traducao_palavra": "fazem barulho/tumulto" },
        { "hebraico": "וּ֝מְשַׂנְאֶ֗יךָ", "transliteral": "ū-mə-śan-ʾe-ḵā", "traducao_palavra": "e os teus odiadores" },
        { "hebraico": "נָשְׂא֥וּ", "transliteral": "nā-śə-ʾû", "traducao_palavra": "levantaram" },
        { "hebraico": "רֹֽאשׁ׃", "transliteral": "rōš", "traducao_palavra": "[a] cabeça" }
      ]
    },
    "3": {
      "traducao_completa": "Tomam astuto conselho contra o teu povo, e conspiram contra os teus protegidos.",
      "palavras": [
        { "hebraico": "עַֽל־", "transliteral": "ʿal-", "traducao_palavra": "contra" },
        { "hebraico": "עַ֭מְּךָ", "transliteral": "ʿam-mə-ḵā", "traducao_palavra": "teu povo" },
        { "hebraico": "יַעֲרִ֣ימוּ", "transliteral": "ya-ʿă-rî-mû", "traducao_palavra": "eles agem astutamente" },
        { "hebraico": "סֹ֑וד", "transliteral": "śôḏ", "traducao_palavra": "[em] conselho" },
        { "hebraico": "וְ֝יִתְיָעֲצ֗וּ", "transliteral": "wə-yiṯ-yā-ʿă-ṣû", "traducao_palavra": "e conspiram/consultam-se" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "contra" },
        { "hebraico": "צְפוּנֶֽיךָ׃", "transliteral": "ṣə-p̄û-ney-ḵā", "traducao_palavra": "teus tesouros/protegidos" }
      ]
    },
    "4": {
      "traducao_completa": "Disseram: Vinde, e exterminemo-los para que não sejam nação, nem se saiba mais o nome de Israel.",
