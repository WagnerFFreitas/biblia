        { "hebraico": "נֹועֲצ֣וּ", "transliteral": "nô-ʿă-ṣû", "traducao_palavra": "consultaram" },
        { "hebraico": "לֵ֣ב", "transliteral": "lēḇ", "traducao_palavra": "[de] coração" },
        { "hebraico": "יַחְדָּ֑ו", "transliteral": "yaḥ-dāw", "traducao_palavra": "juntamente" },
        { "hebraico": "עָ֝לֶ֗יךָ", "transliteral": "ʿā-ley-ḵā", "traducao_palavra": "contra ti" },
        { "hebraico": "בְּרִ֣ית", "transliteral": "bə-rîṯ", "traducao_palavra": "[uma] aliança" },
