      ]
    },
    "7": {
      "traducao_completa": "Gebal, Amom e Amaleque; a Filístia com os moradores de Tiro.",
      "palavras": [
        { "hebraico": "גְּבָ֣ל", "transliteral": "ḡə-ḇal", "traducao_palavra": "Gebal" },
        { "hebraico": "וְ֭עַמֹּון", "transliteral": "wə-ʿam-môn", "traducao_palavra": "e Amom" },
