        { "hebraico": "וְלֹ֣א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "אֵדָ֑ע", "transliteral": "ʾē-ḏāʿ", "traducao_palavra": "conhecia/sabia" },
        { "hebraico": "בְּ֝הֵמֹ֗ות", "transliteral": "bə-hē-môṯ", "traducao_palavra": "[como] animais" },
