        { "hebraico": "עִמָּ֑ךְ", "transliteral": "ʿim-māḵ", "traducao_palavra": "contigo" },
        { "hebraico": "אָ֝חַ֗זְתָּ", "transliteral": "ʾā-ḥaz-tā", "traducao_palavra": "seguraste" },
        { "hebraico": "בְּיַד־", "transliteral": "bə-yaḏ-", "traducao_palavra": "pela mão de" },
