{
  "livro": "Salmos - תְּהִלִּים - Tə-hil-lîm",
  "capítulo": 51,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Ao regente, um salmo de Davi.",
      "palavras": [
        { "hebraico": "לַמְנַצֵּ֥חַ", "transliteral": "lam-naṣ-ṣē-aḥ", "traducao_palavra": "Ao regente" },
        { "hebraico": "מִזְמֹ֗ור", "transliteral": "miz-môr", "traducao_palavra": "um salmo" },
        { "hebraico": "לְדָ֫וִ֥ד", "transliteral": "lĕ-ḏā-wiḏ", "traducao_palavra": "de Davi" }
      ]
    },
    "2": {
      "traducao_completa": "Em vindo a ele Natã, o profeta, quando ele entrou a Bate-Seba.",
      "palavras": [
        { "hebraico": "בְּבֹֽוא־", "transliteral": "bĕ-ḇô-", "traducao_palavra": "em vindo" },
        { "hebraico": "אֵ֭לָיו", "transliteral": "ʾē-lā-yw", "traducao_palavra": "a ele" },
        { "hebraico": "נָתָ֣ן", "transliteral": "nā-ṯān", "traducao_palavra": "Natã" },
        { "hebraico": "הַנָּבִ֑יא", "transliteral": "han-nā-ḇîʾ", "traducao_palavra": "o profeta" },
        { "hebraico": "כַּֽאֲשֶׁר־", "transliteral": "ka-ʾă-šer-", "traducao_palavra": "quando" },
        { "hebraico": "בָּ֝֗א", "transliteral": "bāʾ", "traducao_palavra": "ele entrou" },
        { "hebraico": "אֶל־", "transliteral": "ʾel-", "traducao_palavra": "a" },
        { "hebraico": "בַּת־שָֽׁבַע׃", "transliteral": "baṯ-šā-ḇaʿ", "traducao_palavra": "Bate-Seba" }
      ]
    },
    "3": {
      "traducao_completa": "Tem piedade de mim, Deus, conforme a Tua benevolência; conforme a multidão de Tuas compaixões, apaga minhas transgressões.",
      "palavras": [
        { "hebraico": "חָנֵּ֣נִי", "transliteral": "ḥān-nē-nî", "traducao_palavra": "Tem piedade de mim" },
        { "hebraico": "אֱלֹהִ֣ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "Deus" },
        { "hebraico": "כְּחַסְדֶּ֑ךָ", "transliteral": "kĕ-ḥas-de-ḵā", "traducao_palavra": "conforme a Tua benevolência" },
        { "hebraico": "כְּרֹ֥ב", "transliteral": "kĕ-rōḇ", "traducao_palavra": "conforme a multidão de" },
        { "hebraico": "רַ֝חֲמֶ֗יךָ", "transliteral": "ra-ḥă-me-ḵā", "traducao_palavra": "Tuas compaixões" },
        { "hebraico": "מְחֵ֣ה", "transliteral": "mĕ-ḥēh", "traducao_palavra": "apaga" },
        { "hebraico": "פְשָׁעָֽי׃", "transliteral": "pĕ-šā-ʿāy", "traducao_palavra": "minhas transgressões" }
      ]
    },
    "4": {
      "traducao_completa": "Lava-me totalmente de minha iniquidade e de meu pecado purifica-me.",
      "palavras": [
        { "hebraico": "הֶ֭רֶב", "transliteral": "he-reḇ", "traducao_palavra": "Multiplica (lava-me totalmente)" },
        { "hebraico": "כַּבְּסֵ֣נִי", "transliteral": "kab-bĕ-sē-nî", "traducao_palavra": "lava-me" },
        { "hebraico": "מֵעֲוֳֹנִ֑י", "transliteral": "mē-ʿă-wō-nî", "traducao_palavra": "de minha iniquidade" },
        { "hebraico": "וּמֵחַטָּאתִ֥י", "transliteral": "û-mē-ḥat-ṭā-ṯî", "traducao_palavra": "e de meu pecado" },
        { "hebraico": "טַהֲרֵֽנִי׃", "transliteral": "ṭa-hă-rē-nî", "traducao_palavra": "purifica-me" }
      ]
    },
    "5": {
      "traducao_completa": "Pois minhas transgressões eu conheço, e meu pecado está diante de mim continuamente.",
      "palavras": [
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "Pois" },
        { "hebraico": "פְשָׁעַ֥י", "transliteral": "pĕ-šā-ʿay", "traducao_palavra": "minhas transgressões" },
        { "hebraico": "אֲנִ֣י", "transliteral": "ʾă-nî", "traducao_palavra": "eu" },
        { "hebraico": "אֵדָ֑ע", "transliteral": "ʾê-ḏāʿ", "traducao_palavra": "conheço" },
        { "hebraico": "וְחַטָּאתִ֖י", "transliteral": "wĕ-ḥat-ṭā-ṯî", "traducao_palavra": "e meu pecado" },
        { "hebraico": "נֶגְדִּ֣י", "transliteral": "neḡ-dî", "traducao_palavra": "diante de mim" },
        { "hebraico": "תָמִֽיד׃", "transliteral": "ṯā-mîḏ", "traducao_palavra": "continuamente" }
      ]
    },
    "6": {
      "traducao_completa": "Contra Ti, contra Ti somente pequei, e o que é mau aos Teus olhos fiz; para que sejas justo no Teu falar e puro no Teu julgar.",
      "palavras": [
        { "hebraico": "לְךָ֤", "transliteral": "lĕ-ḵā", "traducao_palavra": "Contra Ti" },
        { "hebraico": "לְבַדְּךָ֨", "transliteral": "lĕ-ḇad-dĕ-ḵā", "traducao_palavra": "somente" },
        { "hebraico": "חָטָ֜אתִי", "transliteral": "ḥā-ṭā-ṯî", "traducao_palavra": "pequei" },
        { "hebraico": "וְהָרַ֖ע", "transliteral": "wĕ-hā-raʿ", "traducao_palavra": "e o mal" },
        { "hebraico": "בְּעֵינֶ֣יךָ", "transliteral": "bĕ-ʿê-ne-ḵā", "traducao_palavra": "aos Teus olhos" },
        { "hebraico": "עָשִׂ֑יתִי", "transliteral": "ʿā-śî-ṯî", "traducao_palavra": "fiz" },
        { "hebraico": "לְמַ֤עַן", "transliteral": "lĕ-ma-ʿan", "traducao_palavra": "para que" },
        { "hebraico": "תִּצְדַּ֥ק", "transliteral": "tiṣ-daq", "traducao_palavra": "sejas justo" },
        { "hebraico": "בְּדָבְרֶ֗ךָ", "transliteral": "bĕ-ḏā-ḇĕ-re-ḵā", "traducao_palavra": "no Teu falar" },
        { "hebraico": "תִּזְכֶּ֥ה", "transliteral": "tiz-keh", "traducao_palavra": "sejas puro" },
        { "hebraico": "בְשָׁפְטֶֽךָ׃", "transliteral": "ḇĕ-šā-p̄ĕ-ṭe-ḵā", "traducao_palavra": "no Teu julgar" }
      ]
    },
    "7": {
      "traducao_completa": "Eis que em iniquidade fui gerado, e em pecado me concebeu minha mãe.",
      "palavras": [
        { "hebraico": "הֵן־", "transliteral": "hēn-", "traducao_palavra": "Eis que" },
        { "hebraico": "בְּעָוֹ֥ון", "transliteral": "bĕ-ʿā-wōn", "traducao_palavra": "em iniquidade" },
        { "hebraico": "חֹולָ֑לְתִּי", "transliteral": "ḥô-lā-lĕ-tî", "traducao_palavra": "fui gerado" },
        { "hebraico": "וּ֝בְחֵ֗טְא", "transliteral": "û-ḇĕ-ḥē-ṭĕʾ", "traducao_palavra": "e em pecado" },
        { "hebraico": "יֶֽחֱמַ֥תְנִי", "transliteral": "ye-ḥĕ-maṯ-nî", "traducao_palavra": "me concebeu" },
        { "hebraico": "אִמִּֽי׃", "transliteral": "ʾim-mî", "traducao_palavra": "minha mãe" }
      ]
    },
    "8": {
      "traducao_completa": "Eis que a verdade desejas no íntimo, e no oculto me fazes conhecer a sabedoria.",
      "palavras": [
        { "hebraico": "הֵן־", "transliteral": "hēn-", "traducao_palavra": "Eis que" },
        { "hebraico": "אֱ֭מֶת", "transliteral": "ʾĕ-meṯ", "traducao_palavra": "verdade" },
        { "hebraico": "חָפַ֣צְתָּ", "transliteral": "ḥā-p̄aṣ-tā", "traducao_palavra": "desejas" },
        { "hebraico": "בַטֻּחֹ֑ות", "transliteral": "ḇaṭ-ṭu-ḥôṯ", "traducao_palavra": "no íntimo" },
        { "hebraico": "וּ֝בְסָתֻ֗ם", "transliteral": "û-ḇĕ-śā-ṯum", "traducao_palavra": "e no oculto" },
        { "hebraico": "חָכְמָ֥ה", "transliteral": "ḥāḵ-māh", "traducao_palavra": "sabedoria" },
        { "hebraico": "תֹודִיעֵֽנִי׃", "transliteral": "ṯô-ḏî-ʿē-nî", "traducao_palavra": "me fazes conhecer" }
      ]
    },
    "9": {
      "traducao_completa": "Purifica-me com hissopo e serei limpo; lava-me e mais que a neve me tornarei branco.",
      "palavras": [
        { "hebraico": "תְּחַטְּאֵ֣נִי", "transliteral": "tĕ-ḥat-ṭĕ-ʾē-nî", "traducao_palavra": "Purifica-me" },
        { "hebraico": "בְאֵזֹ֣וב", "transliteral": "ḇĕ-ʾē-zôḇ", "traducao_palavra": "com hissopo" },
        { "hebraico": "וְאֶטְהָ֑ר", "transliteral": "wĕ-ʾeṭ-hār", "traducao_palavra": "e serei limpo" },
        { "hebraico": "תְּ֝כַבְּסֵ֗נִי", "transliteral": "tĕ-ḵab-bĕ-sē-nî", "traducao_palavra": "lava-me" },
        { "hebraico": "וּמִשֶּׁ֥לֶג", "transliteral": "û-miš-še-leḡ", "traducao_palavra": "e do que a neve" },
        { "hebraico": "אַלְבִּֽין׃", "transliteral": "ʾal-bîn", "traducao_palavra": "me tornarei branco" }
      ]
    },
    "10": {
      "traducao_completa": "Faze-me ouvir alegria e regozijo; exultem os ossos que Tu esmagaste.",
      "palavras": [
        { "hebraico": "תַּשְׁמִיעֵנִי֮", "transliteral": "taš-mî-ʿê-nî", "traducao_palavra": "Faze-me ouvir" },
        { "hebraico": "śā-śôn", "transliteral": "śā-śôn", "traducao_palavra": "alegria" },
        { "hebraico": "וְשִׂמְחָ֫ה", "transliteral": "wĕ-śim-ḥāh", "traducao_palavra": "e regozijo" },
        { "hebraico": "תָּ֝גֵ֗לְנָה", "transliteral": "tā-ḡēl-nāh", "traducao_palavra": "exultem" },
        { "hebraico": "עֲצָמֹ֥ות", "transliteral": "ʿă-ṣā-môṯ", "traducao_palavra": "ossos" },
        { "hebraico": "דִּכִּֽיתָ׃", "transliteral": "dik-kî-ṯā", "traducao_palavra": "que esmagaste" }
      ]
    },
    "11": {
      "traducao_completa": "Esconde o Teu rosto de meus pecados e todas as minhas iniquidades apaga.",
      "palavras": [
        { "hebraico": "הַסְתֵּ֣ר", "transliteral": "has-tēr", "traducao_palavra": "Esconde" },
        { "hebraico": "פָּ֭נֶיךָ", "transliteral": "pā-ne-ḵā", "traducao_palavra": "Teu rosto" },
        { "hebraico": "מֵחֲטָאָ֑י", "transliteral": "mē-ḥă-ṭā-ʾāy", "traducao_palavra": "de meus pecados" },
        { "hebraico": "וְֽכָל־", "transliteral": "wĕ-ḵol-", "traducao_palavra": "e todas" },
        { "hebraico": "עֲוֳֹנֹתַ֥י", "transliteral": "ʿă-wō-nō-ṯay", "traducao_palavra": "minhas iniquidades" },
        { "hebraico": "מְחֵֽה׃", "transliteral": "mĕ-ḥēh", "traducao_palavra": "apaga" }
      ]
    },
    "12": {
      "traducao_completa": "Coração puro cria para mim, Deus, e espírito reto renova no meu íntimo.",
      "palavras": [
        { "hebraico": "לֵ֣ב", "transliteral": "lēḇ", "traducao_palavra": "Coração" },
        { "hebraico": "טָ֭הֹור", "transliteral": "ṭā-hôr", "traducao_palavra": "puro" },
        { "hebraico": "בְּרָא־", "transliteral": "bĕ-rāʾ-", "traducao_palavra": "cria" },
        { "hebraico": "לִ֣י", "transliteral": "lî", "traducao_palavra": "para mim" },
        { "hebraico": "אֱלֹהִ֑ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "Deus" },
        { "hebraico": "וְר֥וּחַ", "transliteral": "wĕ-rû-aḥ", "traducao_palavra": "e espírito" },
        { "hebraico": "נָ֝כֹ֗ון", "transliteral": "nā-ḵôn", "traducao_palavra": "reto" },
        { "hebraico": "חַדֵּ֥שׁ", "transliteral": "ḥad-dēš", "traducao_palavra": "renova" },
        { "hebraico": "בְּקִרְבִּֽי׃", "transliteral": "bĕ-qir-bî", "traducao_palavra": "no meu íntimo" }
      ]
    },
    "13": {
      "traducao_completa": "Não me lances da Tua presença e o Espírito de Teu Santuário não retires de mim.",
      "palavras": [
        { "hebraico": "אַל־", "transliteral": "ʾal-", "traducao_palavra": "Não" },
        { "hebraico": "תַּשְׁלִיכֵ֥נִי", "transliteral": "taš-lî-ḵē-nî", "traducao_palavra": "me lances" },
        { "hebraico": "מִלְּפָנֶ֑יךָ", "transliteral": "mil-lĕ-p̄ā-ne-ḵā", "traducao_palavra": "da Tua presença" },
        { "hebraico": "וְר֨וּחַ", "transliteral": "wĕ-rû-aḥ", "traducao_palavra": "e o espírito de" },
        { "hebraico": "קָדְשְׁךָ֗", "transliteral": "qāḏ-šĕ-ḵā", "traducao_palavra": "Teu Santuário" },
        { "hebraico": "אַל־", "transliteral": "ʾal-", "traducao_palavra": "não" },
        { "hebraico": "תִּקַּ֥ח", "transliteral": "tiq-qaḥ", "traducao_palavra": "retires" },
        { "hebraico": "מִמֶּֽנִּי׃", "transliteral": "mim-men-nî", "traducao_palavra": "de mim" }
      ]
    },
    "14": {
      "traducao_completa": "Restitui para mim o gozo da Tua salvação e com um espírito generoso sustenta-me.",
      "palavras": [
        { "hebraico": "הָשִׁ֣יבָה", "transliteral": "hā-šî-ḇāh", "traducao_palavra": "Restitui" },
        { "hebraico": "לִּ֭י", "transliteral": "lî", "traducao_palavra": "para mim" },
        { "hebraico": "śĕ-śôn", "transliteral": "śĕ-śôn", "traducao_palavra": "o gozo de" },
        { "hebraico": "יִשְׁעֶ֑ךָ", "transliteral": "yiš-ʿe-ḵā", "traducao_palavra": "Tua salvação" },
        { "hebraico": "וְר֖וּחַ", "transliteral": "wĕ-rû-aḥ", "traducao_palavra": "e espírito" },
        { "hebraico": "נְדִיבָ֣ה", "transliteral": "nĕ-ḏî-ḇāh", "traducao_palavra": "generoso" },
        { "hebraico": "תִסְמְכֵֽנִי׃", "transliteral": "ṯis-mĕ-ḵē-nî", "traducao_palavra": "sustenta-me" }
      ]
    },
    "15": {
      "traducao_completa": "Ensinarei aos transgressores os Teus caminhos, e os pecadores a Ti retornarão.",
      "palavras": [
        { "hebraico": "אֲלַמְּדָ֣ה", "transliteral": "ʾă-lam-mĕ-ḏāh", "traducao_palavra": "Ensinarei" },
        { "hebraico": "פֹשְׁעִ֣ים", "transliteral": "p̄ō-šĕ-ʿîm", "traducao_palavra": "aos transgressores" },
        { "hebraico": "דְּרָכֶ֑יךָ", "transliteral": "dĕ-rā-ḵe-ḵā", "traducao_palavra": "Teus caminhos" },
        { "hebraico": "וְ֝חַטָּאִ֗ים", "transliteral": "wĕ-ḥat-ṭā-ʾîm", "traducao_palavra": "e pecadores" },
        { "hebraico": "אֵלֶ֥יךָ", "transliteral": "ʾē-le-ḵā", "traducao_palavra": "a Ti" },
        { "hebraico": "יָשֽׁוּבוּ׃", "transliteral": "yā-šû-ḇû", "traducao_palavra": "retornarão" }
      ]
    },
    "16": {
      "traducao_completa": "Livra-me de culpas de sangue, Deus, Deus de minha salvação; cantará minha língua a Tua justiça.",
      "palavras": [
        { "hebraico": "הַצִּ֘ילֵ֤נִי", "transliteral": "haṣ-ṣî-lē-nî", "traducao_palavra": "Livra-me" },
        { "hebraico": "מִדָּמִ֨ים", "transliteral": "mid-dā-mîm", "traducao_palavra": "de sangues/culpas de sangue" },
        { "hebraico": "אֱ֘לֹהִ֥ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "Deus" },
        { "hebraico": "אֱלֹהֵ֪י", "transliteral": "ʾĕ-lō-hê", "traducao_palavra": "Deus de" },
        { "hebraico": "יְשׁוּעָ֫תִ֥י", "transliteral": "yĕ-šû-ʿā-ṯî", "traducao_palavra": "minha salvação" },
        { "hebraico": "תְּרַנֵּ֥ן", "transliteral": "tĕ-ran-nēn", "traducao_palavra": "cantará" },
        { "hebraico": "לְשֹׁונִ֗י", "transliteral": "lĕ-šô-nî", "traducao_palavra": "minha língua" },
        { "hebraico": "צִדְקָתֶֽךָ׃", "transliteral": "ṣiḏ-qā-ṯe-ḵā", "traducao_palavra": "a Tua justiça" }
      ]
    },
    "17": {
      "traducao_completa": "Senhor, meus lábios abre, e minha boca anunciará o Teu louvor.",
      "palavras": [
        { "hebraico": "אֲדֹנָי", "transliteral": "ʾă-ḏō-nāy", "traducao_palavra": "Senhor" },
        { "hebraico": "שְׂפָתַ֥י", "transliteral": "śĕ-p̄ā-ṯay", "traducao_palavra": "meus lábios" },
        { "hebraico": "תִּפְתָּ֑ח", "transliteral": "tip̄-tāḥ", "traducao_palavra": "abre" },
        { "hebraico": "וּ֝פִ֗י", "transliteral": "û-p̄î", "traducao_palavra": "e minha boca" },
        { "hebraico": "יַגִּ֥יד", "transliteral": "yag-gîḏ", "traducao_palavra": "anunciará" },
        { "hebraico": "תְּהִלָּתֶֽךָ׃", "transliteral": "tĕ-hil-lā-ṯe-ḵā", "traducao_palavra": "o Teu louvor" }
      ]
    },
    "18": {
      "traducao_completa": "Pois não desejas sacrifício, senão eu o daria; em holocausto não Te deleitas.",
      "palavras": [
        { "hebraico": "כִּ֤י", "transliteral": "kî", "traducao_palavra": "Pois" },
