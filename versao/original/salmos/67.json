        { "hebraico": "אֱלֹהִ֪ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "ó Deus" },
        { "hebraico": "יֹוד֥וּךָ", "transliteral": "yô-ḏû-ḵā", "traducao_palavra": "louvem-te" },
