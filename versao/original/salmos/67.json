        { "hebraico": "בָּאָ֣רֶץ", "transliteral": "bā-ʾā-reṣ", "traducao_palavra": "na terra" },
        { "hebraico": "דַּרְכֶּ֑ךָ", "transliteral": "dar-ke-ḵā", "traducao_palavra": "teu caminho" },
        { "hebraico": "בְּכָל־", "transliteral": "bə-ḵāl-", "traducao_palavra": "em todas" },
        { "hebraico": "גֹּ֝ויִ֗ם", "transliteral": "gô-yim", "traducao_palavra": "[as] nações" },
        { "hebraico": "יְשׁוּעָתֶֽךָ׃", "transliteral": "yə-šû-ʿā-ṯe-ḵā", "traducao_palavra": "tua salvação" }
      ]
    },
    "3": {
      "traducao_completa": "Louvem-te a ti, ó Deus, os povos; louvem-te os povos todos.",
      "palavras": [
