{
  "livro": "Salmos - תְּהִלִּים - Tehillim",
  "capítulo": 67,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Deus tenha misericórdia de nós e nos abençoe; e faça resplandecer o seu rosto sobre nós. (Selah)",
      "palavras": [
        { "hebraico": "אֱלֹהִ֗ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "Deus" },
        { "hebraico": "יְחָנֵּ֥נוּ", "transliteral": "yə-ḥon-nē-nû", "traducao_palavra": "tenha graça/misericórdia de nós" },
        { "hebraico": "וִֽיבָרְכֵ֑נוּ", "transliteral": "wî-ḇā-rə-ḵē-nû", "traducao_palavra": "e abençoe-nos" },
        { "hebraico": "יָאֵ֨ר", "transliteral": "yā-ʾēr", "traducao_palavra": "faça resplandecer" },
        { "hebraico": "פָּנָ֖יו", "transliteral": "pā-nāw", "traducao_palavra": "sua face" },
        { "hebraico": "אִתָּ֣נוּ", "transliteral": "ʾit-tā-nû", "traducao_palavra": "conosco/sobre nós" },
        { "hebraico": "סֶֽלָה׃", "transliteral": "se-lā", "traducao_palavra": "Selah [pausa]" }
      ]
    },
    "2": {
