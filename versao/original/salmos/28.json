{
  "livro": "Salmos - תְּהִלִּים - Tehillim",
  "capítulo": 28,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "De Davi. A ti clamo, YHWH, Rocha minha; não te ensurdeças para comigo; para que, não te calando tu para comigo, eu não me torne semelhante aos que descem à cova.",
      "palavras": [
        { "hebraico": "לְדָ֫וִ֥ד", "transliteral": "lə-ḏā-wiḏ", "traducao_palavra": "de Davi" },
        { "hebraico": "אֵלֶ֤יךָ", "transliteral": "ʾê-le-ḵā", "traducao_palavra": "a ti" },
        { "hebraico": "יְהוָ֨ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "אֶקְרָ֗א", "transliteral": "ʾeq-rā", "traducao_palavra": "clamarei/invocarei" },
        { "hebraico": "צוּרִי֮", "transliteral": "ṣûr-î", "traducao_palavra": "minha Rocha" },
        { "hebraico": "אַֽל־תֶּחֱרַ֪שׁ", "transliteral": "ʾal-te-ḥĕ-raš", "traducao_palavra": "não sejas surdo/mudo" },
        { "hebraico": "מִ֫מֶּ֥נִּי", "transliteral": "mim-men-nî", "traducao_palavra": "para comigo" },
        { "hebraico": "פֶּן־תֶּחֱשֶׁ֥ה", "transliteral": "pen-te-ḥĕ-šeh", "traducao_palavra": "para que não te cales" },
        { "hebraico": "מִמֶּ֑נִּי", "transliteral": "mim-men-nî", "traducao_palavra": "de mim" },
        { "hebraico": "וְ֝נִמְשַׁ֗לְתִּי", "transliteral": "wə-nim-šal-tî", "traducao_palavra": "e eu me torne semelhante" },
        { "hebraico": "עִם־יֹ֥ורְדֵי", "transliteral": "ʿim-yôr-ḏê", "traducao_palavra": "com os que descem a" },
        { "hebraico": "בֹֽור׃", "transliteral": "ḇôr", "traducao_palavra": "[a] cova/poço" }
      ]
    },
    "2": {
      "traducao_completa": "Ouve a voz das minhas súplicas, quando a ti clamo, quando levanto as minhas mãos para o teu santo oráculo.",
      "palavras": [
        { "hebraico": "שְׁמַ֤ע", "transliteral": "šə-maʿ", "traducao_palavra": "ouve" },
        { "hebraico": "קֹ֣ול", "transliteral": "qôl", "traducao_palavra": "[a] voz de" },
        { "hebraico": "תַּ֭חֲנוּנַי", "transliteral": "ta-ḥă-nû-nay", "traducao_palavra": "minhas súplicas" },
        { "hebraico": "בְּשַׁוְּעִ֣י", "transliteral": "bə-šaw-wə-ʿî", "traducao_palavra": "no meu clamar" },
        { "hebraico": "אֵלֶ֑יךָ", "transliteral": "ʾê-le-ḵā", "traducao_palavra": "a ti" },
        { "hebraico": "בְּ֝נָשְׂאִ֗י", "transliteral": "bə-nā-śə-ʾî", "traducao_palavra": "no meu levantar" },
        { "hebraico": "יָדַ֗י", "transliteral": "yā-ḏay", "traducao_palavra": "minhas mãos" },
        { "hebraico": "אֶל־דְּבִ֥יר", "transliteral": "ʾel-də-ḇîr", "traducao_palavra": "para o santuário/oráculo" },
        { "hebraico": "קָדְשֶֽׁךָ׃", "transliteral": "qāḏ-še-ḵā", "traducao_palavra": "da tua santidade" }
      ]
    },
    "3": {
      "traducao_completa": "Não me arrastes com os ímpios e com os que praticam a iniquidade; que falam de paz aos seus próximos, mas têm mal nos seus corações.",
      "palavras": [
        { "hebraico": "אַל־תִּמְשְׁכֵ֣נִי", "transliteral": "ʾal-tim-šə-ḵê-nî", "traducao_palavra": "não me arrastes" },
        { "hebraico": "עִם־רְשָׁעִים֮", "transliteral": "ʿim-rə-šā-ʿîm", "traducao_palavra": "com ímpios" },
        { "hebraico": "וְעִם־פֹּ֪עֲלֵ֫י", "transliteral": "wə-ʿim-pō-ʿă-lê", "traducao_palavra": "e com praticantes de" },
        { "hebraico": "אָ֥וֶן", "transliteral": "ʾā-wen", "traducao_palavra": "iniquidade" },
        { "hebraico": "דֹּבְרֵ֤i", "transliteral": "dō-ḇə-rê", "traducao_palavra": "[os que] falam" },
        { "hebraico": "שָׁלֹ֨ום", "transliteral": "šā-lôm", "traducao_palavra": "paz" },
        { "hebraico": "עִם־רֵֽעֵיהֶ֗ם", "transliteral": "ʿim-rē-ʿê-hem", "traducao_palavra": "com seus companheiros" },
        { "hebraico": "וְרָעָ֥ה", "transliteral": "wə-rā-ʿā", "traducao_palavra": "mas maldade" },
        { "hebraico": "בִּלְבָבָֽם׃", "transliteral": "bil-ḇā-ḇām", "traducao_palavra": "no coração deles" }
      ]
    },
    "4": {
      "traducao_completa": "Dá-lhes segundo as suas obras e segundo a malícia dos seus esforços; dá-lhes conforme o que fizeram as suas mãos; retribui-lhes a sua recompensa.",
      "palavras": [
        { "hebraico": "תֶּן־לָהֶ֣ם", "transliteral": "ten-lā-hem", "traducao_palavra": "dá a eles" },
        { "hebraico": "כְּפֳָעֳלָם֮", "transliteral": "kə-p̄o-ʿo-lām", "traducao_palavra": "conforme a obra deles" },
        { "hebraico": "וּכְרֹ֪עַ", "transliteral": "ū-ḵə-rō-aʿ", "traducao_palavra": "e conforme a maldade de" },
        { "hebraico": "מַֽעַלְלֵ֫יהֶ֥ם", "transliteral": "ma-ʿal-lê-hem", "traducao_palavra": "seus feitos" },
        { "hebraico": "כְּמַעֲשֵׂ֨ה", "transliteral": "kə-ma-ʿă-śēh", "traducao_palavra": "conforme a ação de" },
        { "hebraico": "יְדֵיהֶ֜ם", "transliteral": "yə-ḏê-hem", "traducao_palavra": "mãos deles" },
        { "hebraico": "תֵּ֣ן", "transliteral": "tēn", "traducao_palavra": "dá" },
        { "hebraico": "לָהֶ֑ם", "transliteral": "lā-hem", "traducao_palavra": "a eles" },
        { "hebraico": "הָשֵׁ֖ב", "transliteral": "hā-šēḇ", "traducao_palavra": "retribui/devolve" },
        { "hebraico": "גְּמוּלָ֣ם", "transliteral": "gə-mû-lām", "traducao_palavra": "o trato/recompensa deles" },
        { "hebraico": "לָהֶֽם׃", "transliteral": "lā-hem", "traducao_palavra": "a eles" }
      ]
    },
    "5": {
      "traducao_completa": "Porquanto não atentam para as obras de YHWH, nem para o que as suas mãos fizeram, ele os derrubará e não os reedificará.",
      "palavras": [
        { "hebraico": "כִּ֤י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "לֹ֤א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "יָבִ֨ינוּ", "transliteral": "yā-ḇî-nû", "traducao_palavra": "eles entendem/atentam" },
        { "hebraico": "אֶל־פְּעֻלֹּ֣ת", "transliteral": "ʾel-pə-ʿul-lôṯ", "traducao_palavra": "para as obras de" },
        { "hebraico": "יְ֭הוָה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "וְאֶל־מַעֲשֵׂ֣ה", "transliteral": "wə-ʾel-ma-ʿă-śēh", "traducao_palavra": "e para a obra de" },
        { "hebraico": "יָדָ֑יו", "transliteral": "yā-ḏāw", "traducao_palavra": "suas mãos" },
        { "hebraico": "יֶ֝הֶרְסֵ֗ם", "transliteral": "ye-her-sêm", "traducao_palavra": "ele os derrubará" },
        { "hebraico": "וְלֹ֣א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "יִבְנֵֽם׃", "transliteral": "yiḇ-nêm", "traducao_palavra": "os edificará" }
      ]
    },
    "6": {
      "traducao_completa": "Bendito seja YHWH, porque ouviu a voz das minhas súplicas.",
      "palavras": [
        { "hebraico": "בָּר֥וּךְ", "transliteral": "bā-rûḵ", "traducao_palavra": "bendito [seja]" },
        { "hebraico": "יְהוָ֑ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "כִּי־שָׁ֝מַע", "transliteral": "kî-šā-maʿ", "traducao_palavra": "porque ouviu" },
        { "hebraico": "קֹ֣ול", "transliteral": "qôl", "traducao_palavra": "[a] voz de" },
        { "hebraico": "תַּחֲנוּנָֽי׃", "transliteral": "ta-ḥă-nû-nāy", "traducao_palavra": "minhas súplicas" }
      ]
    },
    "7": {
      "traducao_completa": "YHWH é a minha força e o meu escudo; nele confiou o meu coração, e fui socorrido; pelo que o meu coração salta de prazer, e com o meu cântico o louvarei.",
      "palavras": [
        { "hebraico": "יְהוָ֤ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "עֻזִּ֥י", "transliteral": "ʿuz-zî", "traducao_palavra": "minha força" },
        { "hebraico": "וּמָגִנִּי֮", "transliteral": "ū-mā-ḡin-nî", "traducao_palavra": "e meu escudo" },
        { "hebraico": "בֹּ֤ו", "transliteral": "bô", "traducao_palavra": "nele" },
        { "hebraico": "בָטַ֥ח", "transliteral": "ḇā-ṭaḥ", "traducao_palavra": "confiou" },
        { "hebraico": "לִבִּ֗י", "transliteral": "lib-bî", "traducao_palavra": "meu coração" },
        { "hebraico": "וְֽנֶ֫עֱזָ֥רְתִּי", "transliteral": "wə-ne-ʿĕ-zā-rə-tî", "traducao_palavra": "e fui ajudado/socorrido" },
        { "hebraico": "וַיַּעֲלֹ֥ז", "transliteral": "way-ya-ʿă-lōz", "traducao_palavra": "e exultou/saltou" },
        { "hebraico": "לִבִּ֑י", "transliteral": "lib-bî", "traducao_palavra": "meu coração" },
        { "hebraico": "וּמִשִּׁירִ֥י", "transliteral": "ū-miš-šî-rî", "traducao_palavra": "e com meu cântico" },
        { "hebraico": "אֲהֹודֶֽנּוּ׃", "transliteral": "ʾă-hô-ḏen-nû", "traducao_palavra": "eu o louvarei" }
      ]
    },
    "8": {
      "traducao_completa": "YHWH é a força do seu povo; e ele é a fortaleza salvadora do seu ungido.",
      "palavras": [
        { "hebraico": "יְהוָ֥ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "עֹֽז־לָ֑מֹו", "transliteral": "ʿōz-lā-mô", "traducao_palavra": "força para eles/seu povo" },
        { "hebraico": "וּמָ֘עֹ֤oz", "transliteral": "ū-mā-ʿôz", "traducao_palavra": "e a fortaleza de" },
        { "hebraico": "יְשׁוּעֹ֖ות", "transliteral": "yə-šû-ʿôṯ", "traducao_palavra": "salvações de" },
        { "hebraico": "מְשִׁיחֹ֣ו", "transliteral": "mə-šî-ḥô", "traducao_palavra": "seu ungido" },
        { "hebraico": "הֽוּא׃", "transliteral": "hû", "traducao_palavra": "[é] ele" }
      ]
    },
    "9": {
      "traducao_completa": "Salva o teu povo e abençoa a tua herança; e apascenta-os e exalta-os para sempre.",
      "palavras": [
        { "hebraico": "הֹושִׁ֤יעָה", "transliteral": "hô-šî-ʿā", "traducao_palavra": "salva" },
        { "hebraico": "אֶת־עַמֶּ֗ךָ", "transliteral": "ʾeṯ-ʿam-me-ḵā", "traducao_palavra": "o teu povo" },
        { "hebraico": "וּבָרֵ֥ךְ", "transliteral": "ū-ḇā-rēḵ", "traducao_palavra": "e abençoa" },
        { "hebraico": "אֶת־נַחֲלָתֶ֑ךָ", "transliteral": "ʾeṯ-na-ḥă-lā-ṯe-ḵā", "traducao_palavra": "tua herança" },
        { "hebraico": "וּרְעֵ֥ם", "transliteral": "ū-rə-ʿēm", "traducao_palavra": "e apascenta-os" },
        { "hebraico": "וְ֝נַנְּשְׂאֵ֗ם", "transliteral": "wə-naś-śə-ʾēm", "traducao_palavra": "e exalta-os/conduz-os" },
        { "hebraico": "עַד־הָעֹולָֽם׃", "transliteral": "ʿaḏ-hā-ʿô-lām", "traducao_palavra": "até a eternidade" }
      ]
    }
  }
