{
  "livro": "Salmos - תְּהִלִּים - Tə-hil-lîm",
  "capítulo": 7,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Sigaiom de Davi, que ele cantou a YHWH, sobre as palavras de Cuxe, o benjamita. YHWH, meu Deus, em ti confio; salva-me de todos os que me perseguem, e livra-me;",
      "palavras": [
        { "hebraico": "שִׁגָּיֹ֗ון", "transliteral": "šig-gā-yôn", "traducao_palavra": "Sigaiom/Poema" },
        { "hebraico": "לְדָוִ֑ד", "transliteral": "lə-ḏā-wiḏ", "traducao_palavra": "de Davi" },
        { "hebraico": "אֲשֶׁר־", "transliteral": "ʾă-šer-", "traducao_palavra": "que" },
        { "hebraico": "שָׁ֥ר", "transliteral": "šār", "traducao_palavra": "cantou" },
        { "hebraico": "לַיהוָ֑ה", "transliteral": "lay-hwā", "traducao_palavra": "a YHWH" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre" },
        { "hebraico": "דִּבְרֵי־", "transliteral": "diḇ-rê-", "traducao_palavra": "as palavras de" },
        { "hebraico": "כ֝֗וּשׁ", "transliteral": "ḵûš", "traducao_palavra": "Cuxe" },
        { "hebraico": "בֶּן־", "transliteral": "ben-", "traducao_palavra": "filho de" },
        { "hebraico": "יְמִינִֽי׃", "transliteral": "yə-mî-nî", "traducao_palavra": "um benjamita" },
        { "hebraico": "יְהוָ֣ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "אֱ֭לֹהַי", "transliteral": "ʾĕ-lō-hay", "traducao_palavra": "meu Deus" },
        { "hebraico": "בְּךָ֣", "transliteral": "bə-ḵā", "traducao_palavra": "em Ti" },
        { "hebraico": "חָסִ֑יתִי", "transliteral": "ḥā-śî-ṯî", "traducao_palavra": "confio/refugio-me" },
        { "hebraico": "הֹ֝ושִׁיעֵ֗נִי", "transliteral": "hô-w-šî-ʿê-nî", "traducao_palavra": "salva-me" },
        { "hebraico": "מִכָּל־", "transliteral": "mik-kāl-", "traducao_palavra": "de todos" },
        { "hebraico": "רֹ֝דְפַ֗י", "transliteral": "rō-ḏə-p̄ay", "traducao_palavra": "meus perseguidores" },
        { "hebraico": "וְהַצִּילֵֽנִי׃", "transliteral": "wə-haṣ-ṣî-lê-nî", "traducao_palavra": "e livra-me" }
      ]
    },
    "2": {
      "traducao_completa": "Para que ele não arrebate a minha alma, como leão, despedaçando-a, sem que haja quem a livre.",
      "palavras": [
        { "hebraico": "פֶּן־", "transliteral": "pen-", "traducao_palavra": "Para que não" },
        { "hebraico": "יִטְרֹ֣ף", "transliteral": "yiṭ-rōp̄", "traducao_palavra": "arrebate" },
        { "hebraico": "כְּאַרְיֵ֣h", "transliteral": "kə-ʾar-yêh", "traducao_palavra": "como leão" },
        { "hebraico": "נַפְשִׁ֑י", "transliteral": "nap̄-šî", "traducao_palavra": "minha alma" },
        { "hebraico": "פֹּ֝רֵ֗ק", "transliteral": "pō-rêq", "traducao_palavra": "despedaçando" },
        { "hebraico": "וְאֵ֣ין", "transliteral": "wə-ʾên", "traducao_palavra": "e não [haja]" },
        { "hebraico": "מַצִּֽיל׃", "transliteral": "maṣ-ṣîl", "traducao_palavra": "quem livre" }
      ]
    },
    "3": {
      "traducao_completa": "YHWH meu Deus, se eu fiz isto, se há iniquidade nas minhas mãos,",
      "palavras": [
        { "hebraico": "יְהוָ֣ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "אֱ֭לֹהַי", "transliteral": "ʾĕ-lō-hay", "traducao_palavra": "meu Deus" },
        { "hebraico": "אִם־", "transliteral": "ʾim-", "traducao_palavra": "se" },
        { "hebraico": "עָשִׂ֣יתִי", "transliteral": "ʿā-śî-ṯî", "traducao_palavra": "fiz" },
        { "hebraico": "זֹ֑את", "transliteral": "zōṯ", "traducao_palavra": "isto" },
        { "hebraico": "אִֽם־", "transliteral": "ʾim-", "traducao_palavra": "se" },
        { "hebraico": "יֶשׁ־", "transliteral": "yeš-", "traducao_palavra": "há" },
        { "hebraico": "עָ֥וֶל", "transliteral": "ʿā-wel", "traducao_palavra": "injustiça" },
        { "hebraico": "בְּכַפָּֽי׃", "transliteral": "bə-ḵap-pāy", "traducao_palavra": "em minhas mãos" }
      ]
    },
    "4": {
      "traducao_completa": "Se paguei com o mal àquele que tinha paz comigo (antes, livrei ao que me oprimia sem causa),",
      "palavras": [
        { "hebraico": "אִם־", "transliteral": "ʾim-", "traducao_palavra": "Se" },
        { "hebraico": "גָּ֭מַלְתִּי", "transliteral": "ɡā-mal-tî", "traducao_palavra": "paguei/recompensei" },
        { "hebraico": "שֹׁולְמִ֣i", "transliteral": "šô-w-lə-mî", "traducao_palavra": "ao que estava em paz [comigo]" },
        { "hebraico": "רָ֑ע", "transliteral": "rāʿ", "traducao_palavra": "mal" },
        { "hebraico": "וָאֲחַלְּצָ֖ה", "transliteral": "wā-ʾă-ḥal-lə-ṣā", "traducao_palavra": "antes livrei" },
        { "hebraico": "צֹורֲרִ֣i", "transliteral": "ṣô-rə-rî", "traducao_palavra": "ao meu opressor" },
        { "hebraico": "רֵיקָֽם׃", "transliteral": "rê-qām", "traducao_palavra": "vão/sem causa" }
      ]
    },
    "5": {
      "traducao_completa": "Persiga o inimigo a minha alma e alcance-a; calque aos pés a minha vida sobre a terra, e reduza a pó a minha glória. (Selá)",
      "palavras": [
        { "hebraico": "יִֽרַדֹּ֥ף", "transliteral": "yi-rad-dōp̄", "traducao_palavra": "Persiga" },
        { "hebraico": "אֹויֵ֣ḇ", "transliteral": "ʾô-w-yêḇ", "traducao_palavra": "[o] inimigo" },
        { "hebraico": "נַפְשִׁי֮", "transliteral": "nap̄-šî", "traducao_palavra": "minha alma" },
        { "hebraico": "וְיַשֵּׂ֪ג", "transliteral": "wə-yaś-śêḡ", "traducao_palavra": "e alcance" },
        { "hebraico": "וְיִרְמֹ֤ס", "transliteral": "wə-yir-mōs", "traducao_palavra": "e pisoteie/calque" },
        { "hebraico": "לָאָ֨רֶץ֙", "transliteral": "lā-ʾā-reṣ", "traducao_palavra": "na terra" },
        { "hebraico": "חַיָּ֔י", "transliteral": "ḥay-yāy", "traducao_palavra": "minha vida" },
        { "hebraico": "וּכְבֹודִ֓י ׀", "transliteral": "ū-ḵə-ḇô-ḏî", "traducao_palavra": "e minha glória" },
        { "hebraico": "לֶעָפָ֖ר", "transliteral": "le-ʿā-p̄ār", "traducao_palavra": "no pó" },
        { "hebraico": "יַשְׁכֵּ֣ן", "transliteral": "yaš-kên", "traducao_palavra": "faça habitar" },
        { "hebraico": "סֶֽלָה׃", "transliteral": "śe-lā", "traducao_palavra": "Selá" }
      ]
    },
    "6": {
      "traducao_completa": "Levanta-te, YHWH, na tua ira; exalta-te por causa do furor dos meus opressores; e desperta por mim para o juízo que ordenaste.",
      "palavras": [
        { "hebraico": "קוּמָ֤ה", "transliteral": "qû-mā", "traducao_palavra": "Levanta-te" },
        { "hebraico": "יְהוָ֨ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "בְּאַפֶּ֗ךָ", "transliteral": "bə-ʾap-pe-ḵā", "traducao_palavra": "na Tua ira" },
        { "hebraico": "הִ֭נָּשֵׂא", "transliteral": "hin-nā-śê", "traducao_palavra": "exalta-te" },
        { "hebraico": "בְּעַבְרֹ֣ות", "transliteral": "bə-ʿaḇ-rô-wṯ", "traducao_palavra": "pelo furor de" },
        { "hebraico": "צֹורֲרָ֑י", "transliteral": "ṣô-rə-rāy", "traducao_palavra": "meus opressores" },
        { "hebraico": "וְע֤וּרָה", "transliteral": "wə-ʿû-rā", "traducao_palavra": "e desperta" },
        { "hebraico": "אֵ֝לַ֗י", "transliteral": "ʾê-lay", "traducao_palavra": "por mim" },
        { "hebraico": "מִשְׁפָּ֥ט", "transliteral": "miš-pāṭ", "traducao_palavra": "[o] juízo [que]" },
        { "hebraico": "צִוִּֽיתָ׃", "transliteral": "ṣiw-wî-ṯā", "traducao_palavra": "ordenaste" }
      ]
    },
    "7": {
      "traducao_completa": "Assim te rodeará a congregação de povos; por causa deles, pois, volta-te para as alturas.",
      "palavras": [
        { "hebraico": "וַעֲדַ֣ת", "transliteral": "wa-ʿă-ḏaṯ", "traducao_palavra": "E a congregação de" },
        { "hebraico": "לְאֻ֭מִּים", "transliteral": "lə-ʾum-mîm", "traducao_palavra": "povos" },
        { "hebraico": "תְּסֹובְבֶ֑ךָּ", "transliteral": "tə-śô-ḇə-ḇek-kā", "traducao_palavra": "te rodeará" },
        { "hebraico": "וְ֝עָלֶ֗יהָ", "transliteral": "wə-ʿā-ley-hā", "traducao_palavra": "e sobre ela" },
        { "hebraico": "לַמָּרֹ֥ום", "transliteral": "lam-mā-rôm", "traducao_palavra": "no alto" },
        { "hebraico": "שֽׁוּבָה׃", "transliteral": "šû-ḇā", "traducao_palavra": "volta-te" }
      ]
    },
    "8": {
      "traducao_completa": "YHWH julgará os povos; julga-me, YHWH, conforme a minha justiça, e conforme a integridade que há em mim.",
      "palavras": [
        { "hebraico": "יְהוָה֮", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "יָדִ֪ין", "transliteral": "yā-ḏîn", "traducao_palavra": "julgará" },
        { "hebraico": "עַ֫מִּ֥ים", "transliteral": "ʿam-mîm", "traducao_palavra": "os povos" },
        { "hebraico": "שָׁפְטֵ֥נִי", "transliteral": "šā-p̄ə-ṭê-nî", "traducao_palavra": "julga-me" },
        { "hebraico": "יְהוָ֑ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "כְּצִדְקִ֖י", "transliteral": "kə-ṣiḏ-qî", "traducao_palavra": "conforme minha justiça" },
        { "hebraico": "וּכְתֻמִּ֣i", "transliteral": "ū-ḵə-ṯum-mî", "traducao_palavra": "e conforme minha integridade" },
        { "hebraico": "עָלָֽי׃", "transliteral": "ʿā-lāy", "traducao_palavra": "sobre mim" }
      ]
    },
    "9": {
      "traducao_completa": "Tenha já fim a malícia dos ímpios; mas estabelece o justo; pois tu, ó justo Deus, sondas os corações e os rins.",
      "palavras": [
        { "hebraico": "יִגְמָר־", "transliteral": "yiḡ-mār-", "traducao_palavra": "Cesse/Termine" },
        { "hebraico": "נָ֠א", "transliteral": "nā", "traducao_palavra": "agora" },
        { "hebraico": "רַ֨ע", "transliteral": "raʿ", "traducao_palavra": "a maldade de" },
        { "hebraico": "רְשָׁעִ֜ים", "transliteral": "rə-šā-ʿîm", "traducao_palavra": "ímpios" },
        { "hebraico": "וּתְכֹונֵ֣ן", "transliteral": "ū-ṯə-ḵô-nên", "traducao_palavra": "e estabelece" },
        { "hebraico": "צַדִּ֑יק", "transliteral": "ṣad-dîq", "traducao_palavra": "[ao] justo" },
        { "hebraico": "וּבֹחֵ֣ן", "transliteral": "ū-ḇō-ḥên", "traducao_palavra": "pois sonda" },
        { "hebraico": "לִבֹּ֣ות", "transliteral": "lib-bô-wṯ", "traducao_palavra": "corações" },
        { "hebraico": "וּכְלָיֹ֗ות", "transliteral": "ū-ḵə-lā-yô-wṯ", "traducao_palavra": "e rins" },
        { "hebraico": "אֱלֹהִ֥ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "Deus" },
        { "hebraico": "צַדִּֽיק׃", "transliteral": "ṣad-dîq", "traducao_palavra": "justo" }
      ]
    },
    "10": {
      "traducao_completa": "O meu escudo está em Deus, que salva os retos de coração.",
      "palavras": [
        { "hebraico": "מָֽגִנִּ֥י", "transliteral": "mā-ḡin-nî", "traducao_palavra": "O meu escudo" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "[está] em/sobre" },
        { "hebraico": "אֱלֹהִ֑ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "Deus" },
        { "hebraico": "מֹ֝ושִׁ֗יעַ", "transliteral": "mô-w-šî-aʿ", "traducao_palavra": "[Aquele que] salva" },
        { "hebraico": "יִשְׁרֵי־", "transliteral": "yiš-rê-", "traducao_palavra": "os retos de" },
        { "hebraico": "לֵֽב׃", "transliteral": "lêḇ", "traducao_palavra": "coração" }
      ]
    },
    "11": {
      "traducao_completa": "Deus é um juiz justo, um Deus que se ira todos os dias.",
      "palavras": [
        { "hebraico": "אֱ֭לֹהִים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "Deus" },
        { "hebraico": "שֹׁופֵ֣ט", "transliteral": "šô-p̄êṭ", "traducao_palavra": "[é] juiz" },
        { "hebraico": "צַדִּ֑יק", "transliteral": "ṣad-dîq", "traducao_palavra": "justo" },
        { "hebraico": "וְ֝אֵ֗ל", "transliteral": "wə-ʾêl", "traducao_palavra": "e um Deus [que]" },
        { "hebraico": "זֹעֵ֥ם", "transliteral": "zō-ʿêm", "traducao_palavra": "se ira" },
        { "hebraico": "בְּכָל־", "transliteral": "bə-ḵāl-", "traducao_palavra": "em todo" },
        { "hebraico": "יֹֽום׃", "transliteral": "yôm", "traducao_palavra": "dia" }
      ]
    },
    "12": {
      "traducao_completa": "Se o homem não se converter, ele afiará a sua espada; já tem armado o seu arco, e está aparelhado.",
      "palavras": [
        { "hebraico": "אִם־", "transliteral": "ʾim-", "traducao_palavra": "Se" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "יָ֭שׁוּב", "transliteral": "yā-šûḇ", "traducao_palavra": "se converter/voltar" },
        { "hebraico": "חַרְבֹּ֣ו", "transliteral": "ḥar-bô", "traducao_palavra": "Sua espada" },
        { "hebraico": "יִלְטֹ֑ושׁ", "transliteral": "yil-ṭô-wš", "traducao_palavra": "afiará" },
        { "hebraico": "קַשְׁתֹּ֥ו", "transliteral": "qaš-tô", "traducao_palavra": "Seu arco" },
        { "hebraico": "דָ֝רַ֗ךְ", "transliteral": "ḏā-raḵ", "traducao_palavra": "armou" },
        { "hebraico": "וַֽיְכֹונְנֶֽהָ׃", "transliteral": "way-ḵô-w-nə-neh-hā", "traducao_palavra": "e preparou-o" }
      ]
    },
    "13": {
      "traducao_completa": "E já para ele preparou armas mortais; e porá as suas setas contra os que ardem em fúria.",
      "palavras": [
        { "hebraico": "וְ֝לֹו", "transliteral": "wə-lô", "traducao_palavra": "E para ele" },
        { "hebraico": "הֵכִ֣ין", "transliteral": "hê-ḵîn", "traducao_palavra": "preparou" },
        { "hebraico": "כְּלֵי־", "transliteral": "kə-lê-", "traducao_palavra": "instrumentos/armas de" },
        { "hebraico": "מָ֑וֶת", "transliteral": "mā-weṯ", "traducao_palavra": "morte" },
        { "hebraico": "חִ֝צָּ֗יו", "transliteral": "ḥiṣ-ṣāyw", "traducao_palavra": "Suas setas" },
        { "hebraico": "לְדֹלְקִ֥ים", "transliteral": "lə-ḏō-lə-qîm", "traducao_palavra": "para os perseguidores/os que ardem" },
        { "hebraico": "יִפְעָֽל׃", "transliteral": "yip̄-ʿāl", "traducao_palavra": "prepara/faz" }
      ]
    },
    "14": {
      "traducao_completa": "Eis que ele está com dores de perversidade; concebeu trabalhos, e deu à luz mentiras.",
      "palavras": [
        { "hebraico": "הִנֵּ֥ה", "transliteral": "hin-nê", "traducao_palavra": "Eis que" },
        { "hebraico": "יְחַבֶּל־", "transliteral": "yə-ḥab-bel-", "traducao_palavra": "está com dores de" },
        { "hebraico": "אָ֑וֶן", "transliteral": "ʾā-wen", "traducao_palavra": "iniquidade" },
        { "hebraico": "וְהֳָרָ֥ה", "transliteral": "wə-hō-rā", "traducao_palavra": "e concebeu" },
        { "hebraico": "עָ֝מָ֗ל", "transliteral": "ʿā-māl", "traducao_palavra": "sofrimento/trabalho" },
        { "hebraico": "וְיָ֣לַד", "transliteral": "wə-yā-laḏ", "traducao_palavra": "e deu à luz" },
        { "hebraico": "שָֽׁקֶר׃", "transliteral": "šā-qer", "traducao_palavra": "mentira" }
      ]
    },
    "15": {
      "traducao_completa": "Cavou um poço e o fez fundo, e caiu na cova que fez.",
      "palavras": [
        { "hebraico": "בֹּ֥ור", "transliteral": "bôwr", "traducao_palavra": "Um poço" },
        { "hebraico": "כָּ֭רָה", "transliteral": "kā-rā", "traducao_palavra": "cavou" },
        { "hebraico": "וַֽיַּחְפְּרֵ֑הוּ", "transliteral": "way-yaḥ-pə-rê-hū", "traducao_palavra": "e o fez profundo" },
        { "hebraico": "וַ֝יִּפֹּ֗ל", "transliteral": "way-yip-pōl", "traducao_palavra": "e caiu" },
        { "hebraico": "בְּשַׁ֣חַת", "transliteral": "bə-ša-ḥaṯ", "traducao_palavra": "na cova" },
        { "hebraico": "יִפְעָֽל׃", "transliteral": "yip̄-ʿāl", "traducao_palavra": "[que] fez" }
      ]
