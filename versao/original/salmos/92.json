        { "hebraico": "כַּתָּמָ֣ר", "transliteral": "kat-tā-mār", "traducao_palavra": "como a palmeira" },
        { "hebraico": "יִפְרָ֑ח", "transliteral": "yip̄-rāḥ", "traducao_palavra": "florescerá" },
