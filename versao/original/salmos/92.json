        { "hebraico": "יִשְׂגֶּֽה׃", "transliteral": "yiś-geh", "traducao_palavra": "crescerá" }
      ]
    },
    "13": {
      "traducao_completa": "Os que estão plantados na casa de YHWH florescerão nos átrios do nosso Deus.",
