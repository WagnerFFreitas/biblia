        { "hebraico": "יֹאבֵ֑דוּ", "transliteral": "yō-ḇê-ḏû", "traducao_palavra": "perecerão" },
        { "hebraico": "יִ֝תְפָּרְד֗וּ", "transliteral": "yiṯ-pā-rə-ḏû", "traducao_palavra": "serão dispersos" },
        { "hebraico": "כָּל־", "transliteral": "kāl-", "traducao_palavra": "todos" },
        { "hebraico": "פֹּ֥עֲלֵי", "transliteral": "pō-ʿă-lê", "traducao_palavra": "praticantes de" },
        { "hebraico": "אָֽוֶן׃", "transliteral": "ʾā-wen", "traducao_palavra": "iniquidade" }
      ]
    },
    "10": {
      "traducao_completa": "Mas tu exaltarás a minha força, como a do boi selvagem; serei ungido com óleo fresco.",
