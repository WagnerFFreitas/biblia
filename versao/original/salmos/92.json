        { "hebraico": "תִּשְׁמַ֥עְנָה", "transliteral": "tiš-ma-ʿə-nā", "traducao_palavra": "ouvirão" },
        { "hebraico": "אָזְנָֽי׃", "transliteral": "ʾā-zə-nāy", "traducao_palavra": "meus ouvidos" }
      ]
    },
    "12": {
      "traducao_completa": "O justo florescerá como a palmeira; crescerá como o cedro no Líbano.",
