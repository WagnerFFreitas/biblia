    "11": {
      "traducao_completa": "Os meus olhos verão o meu desejo sobre os meus inimigos, e os meus ouvidos ouvirão o meu desejo sobre os malfeitores que se levantam contra mim.",
      "palavras": [
        { "hebraico": "וַתַּבֵּ֥ט", "transliteral": "wat-tab-bêṭ", "traducao_palavra": "e contemplou" },
        { "hebraico": "עֵינִ֗י", "transliteral": "ʿê-nî", "traducao_palavra": "meu olho" },
        { "hebraico": "בְּשׁ֫וּרָ֥י", "transliteral": "bə-šû-rāy", "traducao_palavra": "nos que me espreitam/inimigos" },
        { "hebraico": "בַּקָּמִ֨ים ׀", "transliteral": "baq-qā-mîm", "traducao_palavra": "nos que se levantam" },
