        { "hebraico": "בַּ֗עַר", "transliteral": "ba-ʿar", "traducao_palavra": "brutal/estúpido" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "יֵדָ֑ע", "transliteral": "yē-ḏāʿ", "traducao_palavra": "conhecerá" },
        { "hebraico": "וּ֝כְסִ֗יל", "transliteral": "ū-ḵə-śîl", "traducao_palavra": "e o tolo" },
