        { "hebraico": "כִּרְאֵ֣ים", "transliteral": "kir-ʾêm", "traducao_palavra": "como boi selvagem" },
        { "hebraico": "קַרְנִ֑י", "transliteral": "qar-nî", "traducao_palavra": "minha fronte/força" },
