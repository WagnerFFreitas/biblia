    "14": {
      "traducao_completa": "Na velhice ainda darão frutos; serão viçosos e florescentes,",
      "palavras": [
        { "hebraico": "עֹ֭וד", "transliteral": "ʿôḏ", "traducao_palavra": "ainda" },
