        { "hebraico": "יָבִ֥ין", "transliteral": "yā-ḇîn", "traducao_palavra": "entenderá" },
        { "hebraico": "אֶת־", "transliteral": "ʾeṯ-", "traducao_palavra": "[objeto]" },
        { "hebraico": "זֹֽאת׃", "transliteral": "zōṯ", "traducao_palavra": "isto" }
      ]
    },
    "7": {
      "traducao_completa": "Quando os ímpios brotam como a erva, e florescem todos os que praticam a iniquidade, é para serem destruídos perpetuamente.",
      "palavras": [
        { "hebraico": "בִּפְרֹ֤חַ", "transliteral": "bi-p̄ərō-aḥ", "traducao_palavra": "no brotar de" },
        { "hebraico": "רְשָׁעִ֨ים ׀", "transliteral": "rə-šā-ʿîm", "traducao_palavra": "ímpios" },
        { "hebraico": "כְּמֹ֬ו", "transliteral": "kə-mô", "traducao_palavra": "como" },
        { "hebraico": "עֵ֗שֶׂב", "transliteral": "ʿē-śeḇ", "traducao_palavra": "erva" },
        { "hebraico": "וַ֭יָּצִיצוּ", "transliteral": "way-yā-ṣî-ṣû", "traducao_palavra": "e florescem" },
