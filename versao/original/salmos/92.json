        { "hebraico": "עֲדֵי־", "transliteral": "ʿă-ḏê-", "traducao_palavra": "até" },
        { "hebraico": "עַֽד׃", "transliteral": "ʿaḏ", "traducao_palavra": "sempre" }
      ]
    },
    "8": {
      "traducao_completa": "Mas tu, YHWH, és o Altíssimo para sempre.",
      "palavras": [
        { "hebraico": "וְאַתָּ֥ה", "transliteral": "wə-ʾat-tā", "traducao_palavra": "mas tu" },
        { "hebraico": "מָרֹ֗ום", "transliteral": "mā-rôm", "traducao_palavra": "[estás no] alto" },
        { "hebraico": "לְעֹלָ֥ם", "transliteral": "lə-ʿô-lām", "traducao_palavra": "para sempre" },
        { "hebraico": "יְהוָֽה׃", "transliteral": "YHWH", "traducao_palavra": "YHWH" }
      ]
    },
    "9": {
      "traducao_completa": "Pois eis que os teus inimigos, YHWH, eis que os teus inimigos perecerão; serão dispersos todos os que praticam a iniquidade.",
      "palavras": [
        { "hebraico": "כִּ֤י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "הִנֵּ֪ה", "transliteral": "hin-nēh", "traducao_palavra": "eis que" },
        { "hebraico": "אֹ֫יְבֶ֥יךָ", "transliteral": "ʾō-yə-ḇey-ḵā", "traducao_palavra": "teus inimigos" },
        { "hebraico": "יְהוָ֑ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "porque" },
