{
  "livro": "Salmos - תְּהִלִּים - Tehillim",
  "capítulo": 92,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Bom é louvar a YHWH, e cantar louvores ao teu nome, ó Altíssimo;",
      "palavras": [
        { "hebraico": "טֹוב", "transliteral": "ṭôḇ", "traducao_palavra": "bom [é]" },
        { "hebraico": "לְהֹדֹות", "transliteral": "lə-hō-ḏôṯ", "traducao_palavra": "dar graças/louvar" },
        { "hebraico": "לַיהוָה", "transliteral": "lay-hwāh", "traducao_palavra": "a YHWH" },
        { "hebraico": "וּלְזַמֵּר", "transliteral": "ū-lə-zam-mēr", "traducao_palavra": "e salmodiar/cantar" },
        { "hebraico": "לְשִׁמְךָ", "transliteral": "lə-šim-ḵā", "traducao_palavra": "ao teu nome" },
        { "hebraico": "עֶלְיֹון׃", "transliteral": "ʿel-yôn", "traducao_palavra": "Altíssimo" }
      ]
    },
    "2": {
      "traducao_completa": "Para de manhã anunciar a tua benignidade, e todas as noites a tua fidelidade;",
      "palavras": [
        { "hebraico": "לְהַגִּ֣יד", "transliteral": "lə-hag-gîḏ", "traducao_palavra": "para anunciar" },
        { "hebraico": "בַּבֹּ֣קֶר", "transliteral": "bab-bō-qer", "traducao_palavra": "pela manhã" },
        { "hebraico": "חַסְדֶּ֑ךָ", "transliteral": "ḥas-de-ḵā", "traducao_palavra": "tua bondade" },
        { "hebraico": "וֶ֝אֱמֽוּנָתְךָ֗", "transliteral": "we-ʾĕ-mû-nā-ṯə-ḵā", "traducao_palavra": "e tua fidelidade" },
        { "hebraico": "בַּלֵּילֹֽות׃", "transliteral": "bal-lê-lôṯ", "traducao_palavra": "nas noites" }
      ]
    },
    "3": {
      "traducao_completa": "Sobre um instrumento de dez cordas, e sobre o saltério; sobre a harpa com som solene.",
      "palavras": [
        { "hebraico": "עֲלֵי־", "transliteral": "ʿă-lê-", "traducao_palavra": "sobre" },
        { "hebraico": "עָ֭שֹׂור", "transliteral": "ʿā-śôr", "traducao_palavra": "[instrumento de] dez" },
        { "hebraico": "וַעֲלֵי־", "transliteral": "wa-ʿă-lê-", "traducao_palavra": "e sobre" },
        { "hebraico": "נָ֑בֶל", "transliteral": "nā-ḇel", "traducao_palavra": "saltério/lira" },
        { "hebraico": "עֲלֵ֖י", "transliteral": "ʿă-lê", "traducao_palavra": "sobre" },
        { "hebraico": "הִגָּיֹ֣ון", "transliteral": "hig-gā-yôn", "traducao_palavra": "som solene/meditação" },
        { "hebraico": "בְּכִנֹּֽור׃", "transliteral": "bə-ḵin-nôr", "traducao_palavra": "com harpa" }
      ]
    },
    "4": {
      "traducao_completa": "Pois tu, YHWH, me alegraste pelos teus feitos; exultarei nas obras das tuas mãos.",
      "palavras": [
        { "hebraico": "כִּ֤י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "שִׂמַּחְתַּ֣נִי", "transliteral": "śim-maḥ-ta-nî", "traducao_palavra": "alegraste-me" },
        { "hebraico": "יְהוָ֣ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "בְּפָעֳלֶ֑ךָ", "transliteral": "bə-p̄o-ʿo-le-ḵā", "traducao_palavra": "pelo teu feito/obra" },
        { "hebraico": "בְּמַעֲשֵׂ֖י", "transliteral": "bə-ma-ʿă-śê", "traducao_palavra": "nas obras de" },
        { "hebraico": "יָדֶ֣יךָ", "transliteral": "yā-ḏey-ḵā", "traducao_palavra": "tuas mãos" },
        { "hebraico": "אֲרַנֵּֽן׃", "transliteral": "ʾă-ran-nên", "traducao_palavra": "cantarei de júbilo" }
      ]
    },
    "5": {
      "traducao_completa": "Quão grandes são, YHWH, as tuas obras! Mui profundos são os teus pensamentos.",
      "palavras": [
        { "hebraico": "מַה־", "transliteral": "mah-", "traducao_palavra": "quão" },
        { "hebraico": "גָּדְל֣וּ", "transliteral": "gāḏ-lû", "traducao_palavra": "grandes são" },
        { "hebraico": "מַעֲשֶׂ֣יךָ", "transliteral": "ma-ʿă-śey-ḵā", "traducao_palavra": "tuas obras" },
        { "hebraico": "יְהוָ֑ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "מְ֝אֹ֗ד", "transliteral": "mə-ʾōḏ", "traducao_palavra": "muito" },
        { "hebraico": "עָמְק֥וּ", "transliteral": "ʿā-mə-qû", "traducao_palavra": "profundos são" },
        { "hebraico": "מַחְשְׁבֹתֶֽיךָ׃", "transliteral": "maḥ-šə-ḇō-ṯey-ḵā", "traducao_palavra": "teus pensamentos" }
      ]
    },
    "6": {
      "traducao_completa": "O homem brutal não conhece, e o louco não entende isto.",
      "palavras": [
