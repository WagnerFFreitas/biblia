        { "hebraico": "וְרַעֲנַנִּ֣ים", "transliteral": "wə-ra-ʿă-nan-nîm", "traducao_palavra": "e verdejantes/frescos" },
        { "hebraico": "יִהְיֽוּ׃", "transliteral": "yih-yû", "traducao_palavra": "eles serão" }
