        { "hebraico": "לְעֹולָֽם׃", "transliteral": "lə-ʿô-lām", "traducao_palavra": "para sempre" }
      ]
    },
    "14": {
      "traducao_completa": "Bendito seja YHWH, Deus de Israel, de eternidade em eternidade. Amém e Amém.",
      "palavras": [
        { "hebraico": "בָּ֘ר֤וּךְ", "transliteral": "bā-rûḵ", "traducao_palavra": "bendito [seja]" },
        { "hebraico": "יְהוָ֨ה ׀", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "אֱלֹ֘הֵ֤י", "transliteral": "ĕ-lō-hê", "traducao_palavra": "Deus de" },
        { "hebraico": "יִשְׂרָאֵ֗ל", "transliteral": "yiś-rā-ʾēl", "traducao_palavra": "Israel" },
