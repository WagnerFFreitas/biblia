{
  "livro": "Salmos - תְּהִלִּים - Tehillim",
  "capítulo": 41,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Ao mestre de canto. Salmo de Davi.",
      "palavras": [
        { "hebraico": "לַמְנַצֵּ֥חַ", "transliteral": "lam-naṣ-ṣē-aḥ", "traducao_palavra": "ao mestre de canto" },
        { "hebraico": "מִזְמֹ֥ור", "transliteral": "miz-môr", "traducao_palavra": "salmo" },
        { "hebraico": "לְדָוִֽד׃", "transliteral": "lə-ḏā-wiḏ", "traducao_palavra": "de Davi" }
      ]
    },
    "2": {
      "traducao_completa": "Bem-aventurado aquele que atenta para o pobre; YHWH o livrará no dia do mal.",
      "palavras": [
        { "hebraico": "אַ֭שְׁרֵי", "transliteral": "ʾaš-rê", "traducao_palavra": "bem-aventurado" },
        { "hebraico": "מַשְׂכִּ֣יל", "transliteral": "maś-kîl", "traducao_palavra": "[o que] atenta/considera" },
        { "hebraico": "אֶל־דָּ֑ל", "transliteral": "ʾel-dāl", "traducao_palavra": "para o pobre/fraco" },
        { "hebraico": "בְּיֹ֥ום", "transliteral": "bə-yôm", "traducao_palavra": "no dia de" },
        { "hebraico": "רָ֝עָ֗ה", "transliteral": "rā-ʿā", "traducao_palavra": "mal/adversidade" },
        { "hebraico": "יְֽמַלְּטֵ֥הוּ", "transliteral": "yə-mal-lə-ṭē-hû", "traducao_palavra": "livrará ele" },
        { "hebraico": "יְהוָֽה׃", "transliteral": "YHWH", "traducao_palavra": "YHWH" }
      ]
    },
    "3": {
      "traducao_completa": "YHWH o guardará, e o manterá vivo; será abençoado na terra; tu não o entregarás à vontade dos seus inimigos.",
      "palavras": [
        { "hebraico": "יְהוָ֤ה ׀", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "יִשְׁמְרֵ֣הוּ", "transliteral": "yiš-mə-rē-hû", "traducao_palavra": "o guardará" },
        { "hebraico": "וִֽיחַיֵּ֑הוּ", "transliteral": "wî-ḥay-yê-hû", "traducao_palavra": "e o vivificará" },
        { "hebraico": "וְאֻשַּׁ֥ר", "transliteral": "wə-ʾuš-šar", "traducao_palavra": "e será feliz/abençoado" },
        { "hebraico": "בָּאָ֑רֶץ", "transliteral": "bā-ʾā-reṣ", "traducao_palavra": "na terra" },
        { "hebraico": "וְאַֽל־תִּ֝תְּנֵ֗הוּ", "transliteral": "wə-ʾal-tit-tə-nê-hû", "traducao_palavra": "e não o entregues" },
        { "hebraico": "בְּנֶ֣פֶשׁ", "transliteral": "bə-ne-p̄eš", "traducao_palavra": "à alma/desejo de" },
        { "hebraico": "אֹיְבָֽיו׃", "transliteral": "ʾō-yə-ḇāw", "traducao_palavra": "inimigos dele" }
      ]
    },
    "4": {
      "traducao_completa": "YHWH o sustentará no leito da enfermidade; tu lhe restaurarás a cama de sua doença.",
      "palavras": [
        { "hebraico": "יְֽהוָ֗ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "יִ֭סְעָדֶנּוּ", "transliteral": "yis-ʿā-ḏen-nû", "traducao_palavra": "o sustentará/apoiará" },
        { "hebraico": "עַל־עֶ֥רֶשׂ", "transliteral": "ʿal-ʿe-reś", "traducao_palavra": "sobre leito de" },
        { "hebraico": "דְּוָ֑י", "transliteral": "də-wāy", "traducao_palavra": "doença/languidez" },
        { "hebraico": "כָּל־מִ֝שְׁכָּבֹ֗ו", "transliteral": "kāl-miš-kā-ḇô", "traducao_palavra": "toda sua cama" },
        { "hebraico": "הָפַ֥כְתָּ", "transliteral": "hā-p̄aḵ-tā", "traducao_palavra": "tu mudaste/reviraste" },
        { "hebraico": "בְחָלְיֹֽו׃", "transliteral": "ḇə-ḥāl-yô", "traducao_palavra": "na sua enfermidade" }
      ]
    },
    "5": {
      "traducao_completa": "Eu disse: YHWH, tem piedade de mim; sara a minha alma, porque pequei contra ti.",
      "palavras": [
        { "hebraico": "אֲנִֽי־אָ֭מַרְתִּי", "transliteral": "ʾă-nî-ʾā-mar-tî", "traducao_palavra": "eu disse" },
        { "hebraico": "יְהוָ֣ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "חָנֵּ֑נִי", "transliteral": "ḥān-nē-nî", "traducao_palavra": "tem piedade de mim" },
        { "hebraico": "רְפָאָ֥ה", "transliteral": "rə-p̄ā-ʾā", "traducao_palavra": "sara" },
        { "hebraico": "נַ֝פְשִׁ֗י", "transliteral": "nap̄-šî", "traducao_palavra": "minha alma" },
        { "hebraico": "כִּי־חָטָ֥אתִי", "transliteral": "kî-ḥā-ṭā-ṯî", "traducao_palavra": "porque pequei" },
        { "hebraico": "לָֽךְ׃", "transliteral": "lāḵ", "traducao_palavra": "contra ti" }
      ]
    },
    "6": {
      "traducao_completa": "Os meus inimigos falam mal de mim, dizendo: Quando morrerá ele, e perecerá o seu nome?",
      "palavras": [
        { "hebraico": "אֹויְבַ֗י", "transliteral": "ʾô-yə-ḇay", "traducao_palavra": "meus inimigos" },
        { "hebraico": "יֹאמְר֣וּ", "transliteral": "yō-mə-rû", "traducao_palavra": "falam/dirão" },
        { "hebraico": "רַ֣ע", "transliteral": "raʿ", "traducao_palavra": "mal" },
        { "hebraico": "לִ֑י", "transliteral": "lî", "traducao_palavra": "de mim/para mim" },
        { "hebraico": "מָ֭תַי", "transliteral": "mā-ṯay", "traducao_palavra": "quando" },
        { "hebraico": "יָמ֗וּת", "transliteral": "yā-mûṯ", "traducao_palavra": "morrerá" },
        { "hebraico": "וְאָבַ֥ד", "transliteral": "wə-ʾā-ḇaḏ", "traducao_palavra": "e perecerá" },
        { "hebraico": "שְׁמֹֽו׃", "transliteral": "šə-mô", "traducao_palavra": "seu nome" }
      ]
    },
    "7": {
      "traducao_completa": "E, se algum deles vem ver-me, fala vaidade; no seu coração amontoa a maldade; saindo para fora, é disso que fala.",
      "palavras": [
        { "hebraico": "וְאִם־בָּ֤א", "transliteral": "wə-ʾim-bā", "traducao_palavra": "e se vem" },
        { "hebraico": "לִרְאֹ֨ות ׀", "transliteral": "lir-ʾôṯ", "traducao_palavra": "para ver" },
        { "hebraico": "שָׁ֤וְא", "transliteral": "šā-wəʾ", "traducao_palavra": "vaidade/mentira" },
        { "hebraico": "יְדַבֵּ֗ר", "transliteral": "yə-ḏab-bēr", "traducao_palavra": "fala" },
        { "hebraico": "לִבֹּ֗ו", "transliteral": "lib-bô", "traducao_palavra": "coração dele" },
        { "hebraico": "יִקְבָּץ־אָ֥וֶן", "transliteral": "yiq-baṣ-ʾā-wen", "traducao_palavra": "reúne/ajunta iniquidade" },
        { "hebraico": "לֹ֑ו", "transliteral": "lô", "traducao_palavra": "para si" },
        { "hebraico": "יֵצֵ֖א", "transliteral": "yē-ṣē", "traducao_palavra": "sai" },
        { "hebraico": "לַח֥וּץ", "transliteral": "la-ḥûṣ", "traducao_palavra": "para fora" },
        { "hebraico": "יְדַבֵּֽר׃", "transliteral": "yə-ḏab-bēr", "traducao_palavra": "fala [lá fora]" }
      ]
    },
    "8": {
      "traducao_completa": "Todos os que me odeiam murmuram à uma contra mim; contra mim maquinam o mal, dizendo:",
      "palavras": [
        { "hebraico": "יַ֧חַד", "transliteral": "ya-ḥaḏ", "traducao_palavra": "juntamente" },
        { "hebraico": "עָלַ֣י", "transliteral": "ʿā-lay", "traducao_palavra": "contra mim" },
        { "hebraico": "יִתְלַחֲשׁ֣וּ", "transliteral": "yiṯ-la-ḥă-šû", "traducao_palavra": "murmuram/cochicham" },
        { "hebraico": "כָּל־שֹׂנְאָ֑י", "transliteral": "kāl-śō-nə-ʾāy", "traducao_palavra": "todos os meus odiadores" },
        { "hebraico": "עָלַ֗י", "transliteral": "ʿā-lay", "traducao_palavra": "contra mim" },
        { "hebraico": "יַחְשְׁב֖וּ", "transliteral": "yaḥ-šə-ḇû", "traducao_palavra": "planejam/maquinam" },
        { "hebraico": "רָעָ֣ה", "transliteral": "rā-ʿā", "traducao_palavra": "mal" },
        { "hebraico": "לִֽי׃", "transliteral": "lî", "traducao_palavra": "para mim" }
      ]
    },
    "9": {
      "traducao_completa": "Uma doença má se lhe pegou; e agora que está deitado, não se levantará mais.",
      "palavras": [
        { "hebraico": "דְּבַר־בְּ֭לִיַּעַל", "transliteral": "də-ḇar-bə-liy-ya-ʿal", "traducao_palavra": "coisa de perdição/vil" },
        { "hebraico": "יָצ֣וּק", "transliteral": "yā-ṣûq", "traducao_palavra": "está derramada/fixa" },
        { "hebraico": "בֹּ֑ו", "transliteral": "bô", "traducao_palavra": "nele" },
        { "hebraico": "וַאֲשֶׁ֤ר", "transliteral": "wa-ʾă-šer", "traducao_palavra": "e agora que" },
        { "hebraico": "שָׁ֝כַ֗ב", "transliteral": "šā-ḵaḇ", "traducao_palavra": "está deitado" },
        { "hebraico": "לֹא־יֹוסִ֥יף", "transliteral": "lō-yô-sîp̄", "traducao_palavra": "não voltará a" },
        { "hebraico": "לָקֽוּם׃", "transliteral": "lā-qûm", "traducao_palavra": "levantar-se" }
      ]
    },
    "10": {
      "traducao_completa": "Até o meu próprio amigo íntimo, em quem eu confiava, que comia do meu pão, levantou contra mim o seu calcanhar.",
