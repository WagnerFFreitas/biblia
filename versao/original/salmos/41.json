        { "hebraico": "גַּם־אִ֤ישׁ", "transliteral": "gam-ʾîš", "traducao_palavra": "até o homem de" },
        { "hebraico": "שְׁלֹומִ֨י ׀", "transliteral": "šə-lô-mî", "traducao_palavra": "minha paz [amigo]" },
        { "hebraico": "אֲשֶׁר־בָּטַ֣חְתִּי", "transliteral": "ʾă-šer-bā-ṭaḥ-tî", "traducao_palavra": "em quem confiei" },
        { "hebraico": "בֹ֑ו", "transliteral": "bô", "traducao_palavra": "nele" },
        { "hebraico": "אֹוכֵ֥ל", "transliteral": "ʾô-ḵēl", "traducao_palavra": "[o que] comia" },
        { "hebraico": "לַחְמִ֗י", "transliteral": "laḥ-mî", "traducao_palavra": "meu pão" },
        { "hebraico": "הִגְדִּ֖יל", "transliteral": "hiḡ-dîl", "traducao_palavra": "engrandeceu/levantou" },
        { "hebraico": "עָלַ֣י", "transliteral": "ʿā-lay", "traducao_palavra": "contra mim" },
        { "hebraico": "עָקֵֽב׃", "transliteral": "ʿā-qēḇ", "traducao_palavra": "[o] calcanhar" }
      ]
    },
    "11": {
      "traducao_completa": "Mas tu, YHWH, tem piedade de mim e levanta-me, para que eu lhes retribua.",
      "palavras": [
        { "hebraico": "וְאַתָּ֤ה", "transliteral": "wə-ʾat-tā", "traducao_palavra": "mas tu" },
        { "hebraico": "יְהוָ֗ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "חָנֵּ֥נִי", "transliteral": "ḥān-nē-nî", "traducao_palavra": "tem piedade de mim" },
        { "hebraico": "וַהֲקִימֵ֑נִי", "transliteral": "wa-hă-qî-mê-nî", "traducao_palavra": "e levanta-me" },
        { "hebraico": "וַאֲשַׁלְּמָ֥ה", "transliteral": "wa-ʾă-šal-lə-mā", "traducao_palavra": "e eu retribuirei/pagarei" },
        { "hebraico": "לָהֶֽם׃", "transliteral": "lā-hem", "traducao_palavra": "a eles" }
      ]
    },
    "12": {
      "traducao_completa": "Por isto conheço eu que tu me favoreces: que o meu inimigo não triunfa sobre mim.",
