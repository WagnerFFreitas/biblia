        { "hebraico": "בְּזֹ֣את", "transliteral": "bə-zōṯ", "traducao_palavra": "por isto/nisto" },
        { "hebraico": "יָדַ֔עְתִּי", "transliteral": "yā-ḏaʿ-tî", "traducao_palavra": "conheço/sei" },
