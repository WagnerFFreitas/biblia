        { "hebraico": "בִּ֑י", "transliteral": "bî", "traducao_palavra": "em mim" },
        { "hebraico": "כִּ֤י", "transliteral": "kî", "traducao_palavra": "que" },
        { "hebraico": "לֹֽא־יָרִ֥יעַ", "transliteral": "lō-yā-rî-aʿ", "traducao_palavra": "não gritará vitória/triunfará" },
        { "hebraico": "אֹיְבִ֥י", "transliteral": "ʾō-yə-ḇî", "traducao_palavra": "meu inimigo" },
        { "hebraico": "עָלָֽי׃", "transliteral": "ʿā-lāy", "traducao_palavra": "sobre mim" }
      ]
    },
    "13": {
      "traducao_completa": "Quanto a mim, tu me sustentas na minha integridade, e me puseste diante da tua face para sempre.",
      "palavras": [
        { "hebraico": "וַאֲנִ֗י", "transliteral": "wa-ʾă-nî", "traducao_palavra": "e eu/quanto a mim" },
