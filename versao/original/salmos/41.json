        { "hebraico": "בִּ֑י", "transliteral": "bî", "traducao_palavra": "a mim" },
        { "hebraico": "וַתַּצִּיבֵ֖נִי", "transliteral": "wat-taṣ-ṣî-ḇê-nî", "traducao_palavra": "e me puseste/estabeleceste" },
