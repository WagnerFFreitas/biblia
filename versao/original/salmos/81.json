        { "hebraico": "אָ֥בָה", "transliteral": "ʾā-ḇā", "traducao_palavra": "consentiu/quis" },
        { "hebraico": "לִֽי׃", "transliteral": "lî", "traducao_palavra": "a mim" }
      ]
    },
    "12": {
      "traducao_completa": "Portanto eu os entreguei à dureza dos seus corações, e andaram nos seus próprios conselhos.",
      "palavras": [
        { "hebraico": "וָאֲשַׁלְּחֵהוּ", "transliteral": "wā-ʾă-šal-lə-ḥē-hû", "traducao_palavra": "e eu os enviei/entreguei" },
