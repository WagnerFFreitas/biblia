    "11": {
      "traducao_completa": "Mas o meu povo não ouviu a minha voz, e Israel não me quis.",
      "palavras": [
        { "hebraico": "וְלֹא־", "transliteral": "wə-lō-", "traducao_palavra": "mas não" },
        { "hebraico": "שָׁמַ֣ע", "transliteral": "šā-maʿ", "traducao_palavra": "ouviu" },
        { "hebraico": "עַמִּ֣י", "transliteral": "ʿam-mî", "traducao_palavra": "povo meu" },
        { "hebraico": "לְקֳֹולִ֑י", "transliteral": "lə-qô-lî", "traducao_palavra": "à minha voz" },
        { "hebraico": "וְ֝יִשְׂרָאֵ֗ל", "transliteral": "wə-yiś-rā-ʾēl", "traducao_palavra": "e Israel" },
