{
  "livro": "Salmos - תְּהִלִּים - Tehillim",
  "capítulo": 81,
  "titulos": {
    "1": "Ao mestre de canto. Sobre a Gitite. De Asafe."
  },
  "versiculos": {
    "1": {
      "traducao_completa": "Cantai de júbilo a Deus, nossa força; aclamai ao Deus de Jacó.",
      "palavras": [
        { "hebraico": "הַרְנִ֥ינוּ", "transliteral": "har-nî-nû", "traducao_palavra": "cantai de júbilo" },
        { "hebraico": "לֵאלֹהִ֪ים", "transliteral": "lē-lō-hîm", "traducao_palavra": "a Deus" },
        { "hebraico": "ע֘וּזֵּ֥נוּ", "transliteral": "ʿûz-zē-nû", "traducao_palavra": "nossa força" },
        { "hebraico": "הָרִ֝יעוּ", "transliteral": "hā-rî-ʿû", "traducao_palavra": "aclamai" },
        { "hebraico": "לֵאלֹהֵ֥י", "transliteral": "lē-lō-hê", "traducao_palavra": "ao Deus de" },
        { "hebraico": "יַעֲקֹֽב׃", "transliteral": "ya-ʿă-qōḇ", "traducao_palavra": "Jacó" }
      ]
    },
    "2": {
      "traducao_completa": "Levantai um salmo e trazei o adufe, a suave harpa com o saltério.",
      "palavras": [
        { "hebraico": "שְֽׂאוּ־", "transliteral": "śə-ʾû-", "traducao_palavra": "levantai" },
        { "hebraico": "זִ֭מְרָה", "transliteral": "zim-rā", "traducao_palavra": "[um] salmo" },
        { "hebraico": "וּתְנוּ־", "transliteral": "ū-ṯə-nû-", "traducao_palavra": "e dai/trazei" },
        { "hebraico": "תֹ֑ף", "transliteral": "ṯōp̄", "traducao_palavra": "[o] adufe/pandeiro" },
        { "hebraico": "כִּנֹּ֖ור", "transliteral": "kin-nôr", "traducao_palavra": "harpa/lira" },
        { "hebraico": "נָעִ֣ים", "transliteral": "nā-ʿîm", "traducao_palavra": "suave/agradável" },
        { "hebraico": "עִם־", "transliteral": "ʿim-", "traducao_palavra": "com" },
        { "hebraico": "נָֽבֶל׃", "transliteral": "nā-ḇel", "traducao_palavra": "saltério/alaúde" }
      ]
    },
    "3": {
      "traducao_completa": "Tocai a trombeta na lua nova, no tempo fixado, no dia da nossa festa.",
      "palavras": [
        { "hebraico": "תִּקְע֣וּ", "transliteral": "tiq-ʿû", "traducao_palavra": "tocai" },
        { "hebraico": "בַחֹ֣דֶשׁ", "transliteral": "ba-ḥō-ḏeš", "traducao_palavra": "no mês [lua nova]" },
        { "hebraico": "שֹׁופָ֑ר", "transliteral": "šô-p̄ār", "traducao_palavra": "trombeta/shofar" },
        { "hebraico": "בַּ֝כֵּ֗סֶה", "transliteral": "bak-kē-seh", "traducao_palavra": "na lua cheia/tempo fixado" },
        { "hebraico": "לְיֹ֣ום", "transliteral": "lə-yôm", "traducao_palavra": "no dia de" },
        { "hebraico": "חַגֵּֽנוּ׃", "transliteral": "ḥag-gē-nû", "traducao_palavra": "nossa festa" }
      ]
    },
    "4": {
      "traducao_completa": "Porque isto é um estatuto para Israel, e uma lei do Deus de Jacó.",
      "palavras": [
        { "hebraico": "כִּ֤י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "חֹ֣ק", "transliteral": "ḥōq", "traducao_palavra": "[um] estatuto" },
        { "hebraico": "לְיִשְׂרָאֵ֣ל", "transliteral": "lə-yiś-rā-ʾēl", "traducao_palavra": "para Israel [é] ele" },
        { "hebraico": "ה֑וּא", "transliteral": "hû", "traducao_palavra": "ele" },
        { "hebraico": "מִ֝שְׁפָּ֗ט", "transliteral": "miš-pāṭ", "traducao_palavra": "[uma] ordenança/lei de" },
        { "hebraico": "לֵאלֹהֵ֥י", "transliteral": "lē-lō-hê", "traducao_palavra": "Deus de" },
        { "hebraico": "יַעֲקֹֽב׃", "transliteral": "ya-ʿă-qōḇ", "traducao_palavra": "Jacó" }
      ]
    },
    "5": {
      "traducao_completa": "Ele o estabeleceu como testemunho em José, quando saiu contra a terra do Egito, onde ouvi uma língua que não entendia.",
      "palavras": [
        { "hebraico": "עֵד֤וּת", "transliteral": "ʿē-ḏûṯ", "traducao_palavra": "[como] testemunho" },
        { "hebraico": "בִּיהֹוסֵ֨ף ׀", "transliteral": "bî-hô-śēp̄", "traducao_palavra": "em José" },
        { "hebraico": "שָׂ֭מֹו", "transliteral": "śā-mô", "traducao_palavra": "ele o pôs" },
        { "hebraico": "בְּצֵאתֹ֗ו", "transliteral": "bə-ṣē-ṯô", "traducao_palavra": "no sair dele" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "contra/sobre" },
        { "hebraico": "אֶ֥רֶץ", "transliteral": "ʾe-reṣ", "traducao_palavra": "terra de" },
        { "hebraico": "מִצְרָ֑יִם", "transliteral": "miṣ-rā-yim", "traducao_palavra": "Egito" },
        { "hebraico": "שְׂפַ֖ת", "transliteral": "śə-p̄aṯ", "traducao_palavra": "[uma] língua" },
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "[que] não" },
        { "hebraico": "יָדַ֣עְתִּי", "transliteral": "yā-ḏa-ʿtî", "traducao_palavra": "conhecia/entendia" },
        { "hebraico": "אֶשְׁמָֽע׃", "transliteral": "ʾeš-māʿ", "traducao_palavra": "eu ouvi" }
      ]
    },
    "6": {
      "traducao_completa": "Tirei o peso de seus ombros; as suas mãos foram livres dos cestos.",
      "palavras": [
        { "hebraico": "הֲסִירֹ֣ותִי", "transliteral": "hă-śî-rô-ṯî", "traducao_palavra": "eu removi" },
        { "hebraico": "מִסֵּ֣בֶל", "transliteral": "mis-śē-ḇel", "traducao_palavra": "do fardo" },
        { "hebraico": "שִׁכְמֹ֑ו", "transliteral": "šiḵ-mô", "traducao_palavra": "o ombro dele" },
        { "hebraico": "כַּ֝פָּ֗יו", "transliteral": "kap-pāw", "traducao_palavra": "mãos dele" },
        { "hebraico": "מִדּ֥וּד", "transliteral": "mid-dûḏ", "traducao_palavra": "do cesto" },
        { "hebraico": "תַּעֲבֹֽרְנָה׃", "transliteral": "ta-ʿă-ḇō-rə-nā", "traducao_palavra": "foram livres/passaram" }
      ]
    },
    "7": {
      "traducao_completa": "Clamaste na angústia, e te livrei; respondi-te no lugar oculto do trovão; provei-te junto às águas de Meribá. (Selah)",
      "palavras": [
        { "hebraico": "בַּצָּרָ֣ה", "transliteral": "baṣ-ṣā-rā", "traducao_palavra": "na angústia" },
        { "hebraico": "קָ֭רָאתָ", "transliteral": "qā-rā-ṯā", "traducao_palavra": "clamaste" },
        { "hebraico": "וָאֲחַלְּצֶ֑ךָּ", "transliteral": "wā-ʾă-ḥal-lə-ṣek-kā", "traducao_palavra": "e te livrei" },
        { "hebraico": "אֶ֭עֶנְךָ", "transliteral": "ʾe-ʿen-ḵā", "traducao_palavra": "respondi-te" },
        { "hebraico": "בְּסֵ֣תֶר", "transliteral": "bə-śê-ṯer", "traducao_palavra": "no esconderijo de" },
        { "hebraico": "רַ֑עַם", "transliteral": "ra-ʿam", "traducao_palavra": "trovão" },
        { "hebraico": "אֶבְחָנְךָ֨", "transliteral": "ʾeḇ-ḥā-nə-ḵā", "traducao_palavra": "provei-te" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "junto a" },
        { "hebraico": "מֵ֖י", "transliteral": "mê", "traducao_palavra": "águas de" },
        { "hebraico": "מְרִיבָ֣ה", "transliteral": "mə-rî-ḇā", "traducao_palavra": "Meribá" },
        { "hebraico": "סֶֽלָה׃", "transliteral": "śe-lā", "traducao_palavra": "Selah" }
      ]
    },
    "8": {
      "traducao_completa": "Ouve, povo meu, e eu te admoestarei; ó Israel, se tu me ouvires!",
      "palavras": [
        { "hebraico": "שְׁמַ֣ע", "transliteral": "šə-maʿ", "traducao_palavra": "ouve" },
        { "hebraico": "עַ֭מִּי", "transliteral": "ʿam-mî", "traducao_palavra": "povo meu" },
        { "hebraico": "וְאָעִ֣ידָה", "transliteral": "wə-ʾā-ʿî-ḏā", "traducao_palavra": "e eu te advertirei/testemunharei" },
        { "hebraico": "בָּ֑ךְ", "transliteral": "bāḵ", "traducao_palavra": "a ti" },
        { "hebraico": "יִ֝שְׂרָאֵ֗ל", "transliteral": "yiś-rā-ʾēl", "traducao_palavra": "Israel" },
        { "hebraico": "אִם־", "transliteral": "ʾim-", "traducao_palavra": "se" },
        { "hebraico": "תִּשְׁמַֽע־", "transliteral": "tiš-maʿ-", "traducao_palavra": "tu ouvires" },
        { "hebraico": "לִֽי׃", "transliteral": "lî", "traducao_palavra": "a mim" }
      ]
    },
    "9": {
      "traducao_completa": "Não haverá em ti deus estranho, nem te prostrarás diante de um deus estrangeiro.",
      "palavras": [
        { "hebraico": "לֹֽא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "יִֽהְיֶ֣ה", "transliteral": "yih-yeh", "traducao_palavra": "haverá" },
        { "hebraico": "בְךָ֮", "transliteral": "ḇə-ḵā", "traducao_palavra": "em ti" },
        { "hebraico": "אֵ֣ל", "transliteral": "ʾēl", "traducao_palavra": "deus" },
        { "hebraico": "זָ֑ר", "transliteral": "zār", "traducao_palavra": "estranho" },
        { "hebraico": "וְלֹ֥א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "תִֽשְׁתַּחֲוֶ֗ה", "transliteral": "tiš-ta-ḥă-weh", "traducao_palavra": "te prostrarás/adorarás" },
        { "hebraico": "לְאֵ֣ל", "transliteral": "lə-ʾēl", "traducao_palavra": "a deus" },
        { "hebraico": "נֵכָֽר׃", "transliteral": "nē-ḵār", "traducao_palavra": "estrangeiro" }
      ]
    },
    "10": {
      "traducao_completa": "Eu sou YHWH, teu Deus, que te tirei da terra do Egito; abre bem a tua boca, e eu a encherei.",
