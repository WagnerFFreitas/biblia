        { "hebraico": "לִבָּ֑ם", "transliteral": "lib-bām", "traducao_palavra": "coração deles" },
        { "hebraico": "יֵ֝לְכ֗וּ", "transliteral": "yê-lə-ḵû", "traducao_palavra": "andaram" },
        { "hebraico": "בְּמֹועֲצֹותֵיהֶֽם׃", "transliteral": "bə-mô-ʿă-ṣô-ṯê-hem", "traducao_palavra": "em seus próprios conselhos" }
      ]
    },
    "13": {
      "traducao_completa": "Ah! se o meu povo me tivesse ouvido! Se Israel andasse nos meus caminhos!",
      "palavras": [
        { "hebraico": "ל֭וּ", "transliteral": "lû", "traducao_palavra": "oh/se ao menos" },
        { "hebraico": "עַ֭מִּי", "transliteral": "ʿam-mî", "traducao_palavra": "povo meu" },
        { "hebraico": "שֹׁמֵ֣עַֽ", "transliteral": "šō-mē-aʿ", "traducao_palavra": "ouvindo" },
        { "hebraico": "לִ֑י", "transliteral": "lî", "traducao_palavra": "a mim" },
        { "hebraico": "יִ֝שְׂרָאֵ֗ל", "transliteral": "yiś-rā-ʾēl", "traducao_palavra": "Israel" },
        { "hebraico": "בִּדְרָכַ֥י", "transliteral": "biḏ-rā-ḵay", "traducao_palavra": "nos meus caminhos" },
