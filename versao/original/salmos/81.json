        { "hebraico": "חִטָּ֑ה", "transliteral": "ḥiṭ-ṭā", "traducao_palavra": "trigo" },
        { "hebraico": "וּ֝מִצּ֗וּר", "transliteral": "ū-miṣ-ṣûr", "traducao_palavra": "e da rocha" },
        { "hebraico": "דְּבַ֣שׁ", "transliteral": "də-ḇaš", "traducao_palavra": "[com] mel" },
        { "hebraico": "אַשְׂבִּיעֶֽךָּ׃", "transliteral": "ʾaś-bî-ʿe-kkā", "traducao_palavra": "eu te fartaria" }
