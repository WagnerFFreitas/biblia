        { "hebraico": "מְשַׂנְאֵ֣י", "transliteral": "mə-śan-ʾê", "traducao_palavra": "[os] odiadores de" },
        { "hebraico": "יְ֭הוָה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "יְכַחֲשׁוּ־", "transliteral": "yə-ḵa-ḥă-šû-", "traducao_palavra": "se encolheriam/submeteriam" },
        { "hebraico": "לֹ֑ו", "transliteral": "lô", "traducao_palavra": "a ele" },
