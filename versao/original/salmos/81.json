        { "hebraico": "אָנֹכִ֨י ׀", "transliteral": "ʾā-nō-ḵî", "traducao_palavra": "eu [sou]" },
        { "hebraico": "יְהוָ֬ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "אֱלֹהֶ֗יךָ", "transliteral": "ʾĕ-lō-hey-ḵā", "traducao_palavra": "teu Deus" },
        { "hebraico": "הַ֭מַּֽעַלְךָ", "transliteral": "ham-ma-ʿal-ḵā", "traducao_palavra": "[o que] te fez subir" },
        { "hebraico": "מֵאֶ֣רֶץ", "transliteral": "mē-ʾe-reṣ", "traducao_palavra": "da terra de" },
        { "hebraico": "מִצְרָ֑יִם", "transliteral": "miṣ-rā-yim", "traducao_palavra": "Egito" },
        { "hebraico": "הַרְחֶב־", "transliteral": "har-ḥeḇ-", "traducao_palavra": "alarga" },
