      ]
    },
    "14": {
      "traducao_completa": "Em pouco tempo eu abateria os seus inimigos, e voltaria a minha mão contra os seus adversários.",
      "palavras": [
        { "hebraico": "כִּמְעַ֭ט", "transliteral": "kim-ʿaṭ", "traducao_palavra": "em pouco [tempo]" },
        { "hebraico": "אֹויְבֵיהֶ֣ם", "transliteral": "ʾô-yə-ḇê-hem", "traducao_palavra": "inimigos deles" },
        { "hebraico": "אַכְנִ֑יעַ", "transliteral": "ʾaḵ-nî-aʿ", "traducao_palavra": "eu subjugaria/abateria" },
        { "hebraico": "וְעַל־", "transliteral": "wə-ʿal-", "traducao_palavra": "e contra" },
