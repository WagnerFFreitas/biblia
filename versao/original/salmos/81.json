        { "hebraico": "אָשִׁ֥יב", "transliteral": "ʾā-šîḇ", "traducao_palavra": "voltaria" },
        { "hebraico": "יָדִֽי׃", "transliteral": "yā-ḏî", "traducao_palavra": "minha mão" }
      ]
    },
    "15": {
      "traducao_completa": "Os que odeiam a YHWH se lhe submeteriam, e o seu tempo seria para sempre.",
