{
  "livro": "Salmos - תְּהִלִּים - Tehillim",
  "capítulo": 11,
  "titulos": {
    "1": "Ao mestre de canto. De Davi."
  },
  "versiculos": {
    "1": {
      "traducao_completa": "Em YHWH me refugio; como dizeis à minha alma: Foge para o vosso monte como um pássaro?",
      "palavras": [
        { "hebraico": "לַמְנַצֵּ֬חַ", "transliteral": "lam-naṣ-ṣē-aḥ", "traducao_palavra": "ao mestre de canto" },
        { "hebraico": "לְדָוִ֨ד", "transliteral": "lə-ḏā-wiḏ", "traducao_palavra": "de Davi" },
        { "hebraico": "בַּֽיהוָ֨ה", "transliteral": "bay-hwāh", "traducao_palavra": "em YHWH" },
        { "hebraico": "חָסִ֗יתִי", "transliteral": "ḥā-śî-ṯî", "traducao_palavra": "me refugiei/confio" },
        { "hebraico": "אֵ֭יךְ", "transliteral": "ʾêḵ", "traducao_palavra": "como" },
        { "hebraico": "תֹּאמְר֣וּ", "transliteral": "tō-mə-rû", "traducao_palavra": "dizeis" },
        { "hebraico": "לְנַפְשִׁ֑י", "transliteral": "lə-nap̄-šî", "traducao_palavra": "à minha alma" },
        { "hebraico": "נוּדִי", "transliteral": "nû-ḏî", "traducao_palavra": "foge" },
        { "hebraico": "הַ֘רְכֶ֥ם", "transliteral": "har-ḵem", "traducao_palavra": "[para] vosso monte" },
        { "hebraico": "צִפֹּֽור׃", "transliteral": "ṣip-pôr", "traducao_palavra": "[como] pássaro" }
      ]
    },
    "2": {
      "traducao_completa": "Pois eis que os ímpios armam o arco, põem a sua flecha sobre a corda, para atirarem, às escuras, aos retos de coração.",
      "palavras": [
        { "hebraico": "כִּ֤י", "transliteral": "kî", "traducao_palavra": "pois" },
        { "hebraico": "הִנֵּ֪ה", "transliteral": "hin-nēh", "traducao_palavra": "eis que" },
        { "hebraico": "הָרְשָׁעִ֡ים", "transliteral": "hā-rə-šā-ʿîm", "traducao_palavra": "os ímpios" },
        { "hebraico": "יִדְרְכ֬וּן", "transliteral": "yiḏ-rə-ḵûn", "traducao_palavra": "eles armam/pisam" },
        { "hebraico": "קֶ֗שֶׁת", "transliteral": "qe-šeṯ", "traducao_palavra": "[o] arco" },
        { "hebraico": "כֹּונְנ֣וּ", "transliteral": "kō-wə-nə-nû", "traducao_palavra": "eles firmam/preparam" },
        { "hebraico": "חִצָּ֣ם", "transliteral": "ḥiṣ-ṣām", "traducao_palavra": "flecha deles" },
        { "hebraico": "עַל־יֶ֑תֶר", "transliteral": "ʿal-ye-ṯer", "traducao_palavra": "sobre a corda" },
        { "hebraico": "לִירֹ֥ות", "transliteral": "lî-rôṯ", "traducao_palavra": "para atirar" },
        { "hebraico": "בְּמֹו־אֹ֝פֶל", "transliteral": "bə-mô-ʾō-p̄el", "traducao_palavra": "na escuridão" },
        { "hebraico": "לְיִשְׁרֵי־לֵֽב׃", "transliteral": "lə-yiš-rê-lêḇ", "traducao_palavra": "aos retos de coração" }
      ]
    },
    "3": {
      "traducao_completa": "Se os fundamentos forem destruídos, o que pode fazer o justo?",
      "palavras": [
        { "hebraico": "כִּ֣י", "transliteral": "kî", "traducao_palavra": "quando/se" },
        { "hebraico": "הַ֭שָּׁתֹות", "transliteral": "haš-šā-ṯôṯ", "traducao_palavra": "os fundamentos/colunas" },
        { "hebraico": "יֵהָרֵס֑וּן", "transliteral": "yê-hā-rê-sûn", "traducao_palavra": "forem destruídos" },
        { "hebraico": "צַ֝דִּ֗יק", "transliteral": "ṣad-dîq", "traducao_palavra": "[o] justo" },
        { "hebraico": "מַה־פָּעָֽל׃", "transliteral": "mah-pā-ʿāl", "traducao_palavra": "o que fez/pode fazer?" }
      ]
    },
    "4": {
      "traducao_completa": "YHWH está no seu santo templo; o trono de YHWH está nos céus; os seus olhos observam, as suas pálpebras provam os filhos dos homens.",
      "palavras": [
        { "hebraico": "יְהוָ֤ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "בְּהֵ֘יכַ֤ל", "transliteral": "bə-hê-ḵal", "traducao_palavra": "no templo de" },
        { "hebraico": "קָדְשֹׁ֗ו", "transliteral": "qāḏ-šô", "traducao_palavra": "sua santidade" },
        { "hebraico": "יְהוָה֮", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "בַּשָּׁמַ֪יִם", "transliteral": "baš-šā-ma-yim", "traducao_palavra": "nos céus" },
        { "hebraico": "כִּסְאֹ֫ו", "transliteral": "kis-ʾô", "traducao_palavra": "seu trono" },
        { "hebraico": "עֵינָ֥יו", "transliteral": "ʿê-nāw", "traducao_palavra": "olhos dele" },
        { "hebraico": "יֶחֱז֑וּ", "transliteral": "ye-ḥĕ-zû", "traducao_palavra": "veem/observam" },
        { "hebraico": "עַפְעַפָּ֥יו", "transliteral": "ʿap̄-ʿap-pāw", "traducao_palavra": "pálpebras dele" },
        { "hebraico": "יִ֝בְחֲנ֗וּ", "transliteral": "yiḇ-ḥă-nû", "traducao_palavra": "provam/testam" },
        { "hebraico": "בְּנֵ֣י", "transliteral": "bə-nê", "traducao_palavra": "filhos de" },
        { "hebraico": "אָדָֽם׃", "transliteral": "ʾā-ḏām", "traducao_palavra": "homem/Adão" }
      ]
    },
    "5": {
      "traducao_completa": "YHWH prova o justo; mas a sua alma odeia o ímpio e o que ama a violência.",
      "palavras": [
        { "hebraico": "יְהוָה֮", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "צַדִּ֪יק", "transliteral": "ṣad-dîq", "traducao_palavra": "[o] justo" },
        { "hebraico": "יִ֫בְחָ֥ן", "transliteral": "yiḇ-ḥān", "traducao_palavra": "ele prova" },
        { "hebraico": "וְ֭רָשָׁע", "transliteral": "wə-rā-šāʿ", "traducao_palavra": "e o ímpio" },
        { "hebraico": "וְאֹהֵ֣ב", "transliteral": "wə-ʾō-hēḇ", "traducao_palavra": "e o que ama" },
        { "hebraico": "חָמָ֑ס", "transliteral": "ḥā-mās", "traducao_palavra": "[a] violência" },
        { "hebraico": "שָֽׂנְאָ֥ה", "transliteral": "śā-nə-ʾā", "traducao_palavra": "odeia" },
        { "hebraico": "נַפְשֹֽׁו׃", "transliteral": "nap̄-šô", "traducao_palavra": "sua alma" }
      ]
    },
    "6": {
      "traducao_completa": "Sobre os ímpios fará chover armadilhas, fogo, enxofre e vento abrasador; esta será a porção do seu cálice.",
      "palavras": [
        { "hebraico": "יַמְטֵ֧ר", "transliteral": "yam-ṭēr", "traducao_palavra": "fará chover" },
        { "hebraico": "עַל־רְשָׁעִ֗ים", "transliteral": "ʿal-rə-šā-ʿîm", "traducao_palavra": "sobre ímpios" },
        { "hebraico": "פַּ֫חִ֥ים", "transliteral": "pa-ḥîm", "traducao_palavra": "armadilhas/laços" },
        { "hebraico": "אֵ֣שׁ", "transliteral": "ʾēš", "traducao_palavra": "fogo" },
        { "hebraico": "וְ֭גָפְרִית", "transliteral": "wə-ḡā-p̄ə-rîṯ", "traducao_palavra": "e enxofre" },
        { "hebraico": "וְר֥וּחַ", "transliteral": "wə-rû-aḥ", "traducao_palavra": "e vento" },
        { "hebraico": "זִלְעָפֹ֗ות", "transliteral": "zil-ʿā-p̄ôṯ", "traducao_palavra": "abrasador/terrível" },
        { "hebraico": "מְנָ֣ת", "transliteral": "mə-nāṯ", "traducao_palavra": "porção de" },
        { "hebraico": "כֹּוסָֽם׃", "transliteral": "kô-śām", "traducao_palavra": "cálice deles" }
      ]
    },
    "7": {
      "traducao_completa": "Porque YHWH é justo, ele ama a justiça; os retos contemplarão a sua face.",
      "palavras": [
        { "hebraico": "כִּֽי־צַדִּ֣יק", "transliteral": "kî-ṣad-dîq", "traducao_palavra": "porque justo [é]" },
        { "hebraico": "יְהוָה֮", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "צְדָקֹ֪ות", "transliteral": "ṣə-ḏā-qôṯ", "traducao_palavra": "atos de justiça" },
        { "hebraico": "אָ֫הֵ֥ב", "transliteral": "ʾā-hēḇ", "traducao_palavra": "ele ama" },
        { "hebraico": "יָ֝שָׁ֗ר", "transliteral": "yā-šār", "traducao_palavra": "[o] reto" },
        { "hebraico": "יֶחֱז֥וּ", "transliteral": "ye-ḥĕ-zû", "traducao_palavra": "eles contemplarão" },
        { "hebraico": "פָנֵֽימֹו׃", "transliteral": "pā-nê-mô", "traducao_palavra": "sua face" }
      ]
    }
  }
