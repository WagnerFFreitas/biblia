{
  "livro": "Salmos - תְּהִלִּים - Tə-hil-lîm",
  "capítulo": 9,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Ao mestre de canto, sobre Mute-Labem. Salmo de Davi. Eu te louvarei, YHWH, com todo o meu coração; contarei todas as tuas maravilhas.",
      "palavras": [
        { "hebraico": "לַמְנַצֵּ֥חַ", "transliteral": "lam-naṣ-ṣê-aḥ", "traducao_palavra": "Ao mestre de canto" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre" },
        { "hebraico": "מ֥וּת", "transliteral": "mût", "traducao_palavra": "a morte de" },
        { "hebraico": "לַבֵּ֑ן", "transliteral": "lab-bên", "traducao_palavra": "o filho [Mute-Labem]" },
        { "hebraico": "מִזְמֹ֥ור", "transliteral": "miz-môr", "traducao_palavra": "salmo" },
        { "hebraico": "לְדָוִֽד׃", "transliteral": "lə-ḏā-wiḏ", "traducao_palavra": "de Davi" },
        { "hebraico": "אֹודֶ֣ה", "transliteral": "ʾô-w-ḏeh", "traducao_palavra": "Louvarei/Darei graças" },
        { "hebraico": "יְ֭הוָה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "בְּכָל־", "transliteral": "bə-ḵāl-", "traducao_palavra": "com todo" },
        { "hebraico": "לִבִּ֑י", "transliteral": "lib-bî", "traducao_palavra": "meu coração" },
        { "hebraico": "אֲ֝סַפְּרָ֗ה", "transliteral": "ʾă-śap-pə-rā", "traducao_palavra": "contarei" },
        { "hebraico": "כָּל־", "transliteral": "kāl-", "traducao_palavra": "todas" },
        { "hebraico": "נִפְלְאֹותֶֽיךָ׃", "transliteral": "nip̄-lə-ʾô-ṯey-ḵā", "traducao_palavra": "Tuas maravilhas" }
      ]
    },
    "2": {
      "traducao_completa": "Em ti me alegrarei e saltarei de prazer; cantarei louvores ao teu nome, ó Altíssimo.",
      "palavras": [
        { "hebraico": "אֶשְׂמְחָ֥ה", "transliteral": "ʾeś-mə-ḥā", "traducao_palavra": "Alegrar-me-ei" },
        { "hebraico": "וְאֶעֶלְצָ֗ה", "transliteral": "wə-ʾe-ʿel-ṣā", "traducao_palavra": "e exultarei/saltarei de prazer" },
        { "hebraico": "בָּ֑ךְ", "transliteral": "bāḵ", "traducao_palavra": "em Ti" },
        { "hebraico": "אֲזַמְּרָ֖ה", "transliteral": "ʾă-zam-mə-rā", "traducao_palavra": "cantarei louvores [ao]" },
        { "hebraico": "שִׁמְךָ֣", "transliteral": "šim-ḵā", "traducao_palavra": "Teu nome" },
        { "hebraico": "עֶלְיֹֽון׃", "transliteral": "ʿel-yô-wn", "traducao_palavra": "ó Altíssimo" }
      ]
    },
    "3": {
      "traducao_completa": "Porquanto os meus inimigos voltaram atrás, caíram e pereceram diante da tua face.",
      "palavras": [
        { "hebraico": "בְּשׁוּב־", "transliteral": "bə-šûḇ-", "traducao_palavra": "Ao voltarem" },
        { "hebraico": "אֹויְבַ֥י", "transliteral": "ʾô-yə-ḇay", "traducao_palavra": "meus inimigos" },
        { "hebraico": "אָחֹ֑ור", "transliteral": "ʾā-ḥôr", "traducao_palavra": "para trás" },
        { "hebraico": "יִכָּשְׁל֥וּ", "transliteral": "yik-kā-šə-lû", "traducao_palavra": "tropeçarão" },
        { "hebraico": "וְ֝יֹאבְד֗וּ", "transliteral": "wə-yō-w-ḇə-ḏû", "traducao_palavra": "e perecerão" },
        { "hebraico": "מִפָּנֶֽיךָ׃", "transliteral": "mip-pā-ney-ḵā", "traducao_palavra": "diante da Tua face" }
      ]
    },
    "4": {
      "traducao_completa": "Porque tu tens sustentado o meu direito e a minha causa; tu te assentaste no trono, julgando justamente.",
      "palavras": [
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "Porque" },
        { "hebraico": "עָ֭שִׂיתָ", "transliteral": "ʿā-śî-ṯā", "traducao_palavra": "fizeste/sustentaste" },
        { "hebraico": "מִשְׁפָּטִ֣י", "transliteral": "miš-pā-ṭî", "traducao_palavra": "meu direito" },
        { "hebraico": "וְדִינִ֑י", "transliteral": "wə-ḏî-nî", "traducao_palavra": "e minha causa" },
        { "hebraico": "יָשַׁ֥בְתָּ", "transliteral": "yā-šaḇ-tā", "traducao_palavra": "assentaste-te" },
        { "hebraico": "לְ֝כִסֵּ֗א", "transliteral": "lə-ḵis-śê", "traducao_palavra": "no trono" },
        { "hebraico": "שֹׁופֵ֥ט", "transliteral": "šô-p̄êṭ", "traducao_palavra": "julgando" },
        { "hebraico": "צֶֽדֶק׃", "transliteral": "ṣe-ḏeq", "traducao_palavra": "[com] justiça" }
      ]
    },
    "5": {
      "traducao_completa": "Repreendeste as nações, destruíste o ímpio; apagaste o seu nome para sempre e eternamente.",
      "palavras": [
        { "hebraico": "גָּעַ֣רְתָּ", "transliteral": "ɡā-ʿar-tā", "traducao_palavra": "Repreendeste" },
        { "hebraico": "גֹ֭ויִם", "transliteral": "ḡô-yim", "traducao_palavra": "[as] nações" },
        { "hebraico": "אִבַּ֣דְתָּ", "transliteral": "ʾib-baḏ-tā", "traducao_palavra": "destruíste" },
        { "hebraico": "רָשָׁ֑ע", "transliteral": "rā-šāʿ", "traducao_palavra": "[o] ímpio" },
        { "hebraico": "שְׁמָ֥ם", "transliteral": "šə-mām", "traducao_palavra": "o nome deles" },
        { "hebraico": "מָ֝חִ֗יתָ", "transliteral": "mā-ḥî-ṯā", "traducao_palavra": "apagaste" },
        { "hebraico": "לְעֹולָ֥ם", "transliteral": "lə-ʿô-lām", "traducao_palavra": "para sempre" },
        { "hebraico": "וָעֶֽד׃", "transliteral": "wā-ʿeḏ", "traducao_palavra": "e eternamente" }
      ]
    },
    "6": {
      "traducao_completa": "Oh inimigo! Acabaram-se as desolações para sempre; e tu arrasaste as cidades, e a sua memória pereceu com elas.",
      "palavras": [
        { "hebraico": "הָ֘אֹויֵ֤ב ׀", "transliteral": "hā-ʾô-yêḇ", "traducao_palavra": "O inimigo" },
        { "hebraico": "תַּ֥מּוּ", "transliteral": "tam-mû", "traducao_palavra": "acabaram-se" },
        { "hebraico": "חֳרָבֹ֗ות", "transliteral": "ḥo-rā-ḇō-wṯ", "traducao_palavra": "[as] ruínas/desolações" },
        { "hebraico": "לָ֫נֶ֥צַח", "transliteral": "lā-ne-ṣaḥ", "traducao_palavra": "para sempre" },
        { "hebraico": "וְעָרִ֥ים", "transliteral": "wə-ʿā-rîm", "traducao_palavra": "e as cidades" },
        { "hebraico": "נָתַ֑שְׁתָּ", "transliteral": "nā-ṯaš-tā", "traducao_palavra": "arrasaste" },
        { "hebraico": "אָבַ֥ד", "transliteral": "ʾā-ḇaḏ", "traducao_palavra": "pereceu" },
        { "hebraico": "זִכְרָ֗ם", "transliteral": "ziḵ-rām", "traducao_palavra": "a memória deles" },
        { "hebraico": "הֵֽמָּה׃", "transliteral": "hêm-mā", "traducao_palavra": "elas mesmas/com elas" }
      ]
    },
    "7": {
      "traducao_completa": "Mas YHWH está assentado para sempre; já preparou o seu trono para julgar.",
      "palavras": [
        { "hebraico": "וַֽיהוָ֗ה", "transliteral": "way-hwā", "traducao_palavra": "Mas YHWH" },
        { "hebraico": "לְעֹולָ֥ם", "transliteral": "lə-ʿô-lām", "traducao_palavra": "para sempre" },
        { "hebraico": "יֵשֵׁ֑ב", "transliteral": "yê-šêḇ", "traducao_palavra": "permanece/está assentado" },
        { "hebraico": "כֹּונֵ֖ן", "transliteral": "kô-w-nên", "traducao_palavra": "preparou/estabeleceu" },
        { "hebraico": "לַמִּשְׁפָּ֣ט", "transliteral": "lam-miš-pāṭ", "traducao_palavra": "para o juízo" },
        { "hebraico": "כִּסְאֹֽו׃", "transliteral": "kis-ʾô", "traducao_palavra": "Seu trono" }
      ]
    },
    "8": {
      "traducao_completa": "Ele mesmo julgará o mundo com justiça; exercerá juízo sobre os povos com retidão.",
      "palavras": [
        { "hebraico": "וְה֗וּא", "transliteral": "wə-hû", "traducao_palavra": "E Ele" },
        { "hebraico": "יִשְׁפֹּט־", "transliteral": "yiš-pōṭ-", "traducao_palavra": "julgará" },
        { "hebraico": "תֵּבֵ֥ל", "transliteral": "tê-ḇêl", "traducao_palavra": "[o] mundo" },
        { "hebraico": "בְּצֶ֑דֶק", "transliteral": "bə-ṣe-ḏeq", "traducao_palavra": "com justiça" },
        { "hebraico": "יָדִ֥ין", "transliteral": "yā-ḏîn", "traducao_palavra": "exercerá juízo" },
        { "hebraico": "לְ֝אֻמִּ֗ים", "transliteral": "lə-ʾum-mîm", "traducao_palavra": "[sobre os] povos" },
        { "hebraico": "בְּמֵישָׁרִֽים׃", "transliteral": "bə-mê-šā-rîm", "traducao_palavra": "com retidão/equidade" }
      ]
    },
    "9": {
      "traducao_completa": "YHWH será também um alto refúgio para o oprimido; um alto refúgio em tempos de angústia.",
      "palavras": [
        { "hebraico": "וִ֧יהִ֬י", "transliteral": "wî-hî", "traducao_palavra": "E será" },
        { "hebraico": "יְהוָ֣ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "מִשְׂגָּ֣ב", "transliteral": "miś-gāḇ", "traducao_palavra": "um alto refúgio" },
        { "hebraico": "לַדָּ֑ךְ", "transliteral": "lad-dāḵ", "traducao_palavra": "para o oprimido" },
        { "hebraico": "מִ֝שְׂגָּ֗ב", "transliteral": "miś-gāḇ", "traducao_palavra": "um alto refúgio" },
        { "hebraico": "לְעִתֹּ֥ות", "transliteral": "lə-ʿit-tô-wṯ", "traducao_palavra": "em tempos de" },
        { "hebraico": "בַּצָּרָֽה׃", "transliteral": "baṣ-ṣā-rā", "traducao_palavra": "angústia" }
      ]
    },
    "10": {
      "traducao_completa": "Em ti confiarão os que conhecem o teu nome; porque tu, YHWH, nunca desamparaste os que te buscam.",
      "palavras": [
        { "hebraico": "וְיִבְטְח֣וּ", "transliteral": "wə-yiḇ-ṭə-ḥû", "traducao_palavra": "E confiarão" },
        { "hebraico": "בְ֭ךָ", "transliteral": "ḇə-ḵā", "traducao_palavra": "em Ti" },
        { "hebraico": "יֹודְעֵ֣i", "transliteral": "yô-ḏə-ʿê", "traducao_palavra": "os conhecedores de" },
        { "hebraico": "שְׁמֶ֑ךָ", "transliteral": "šə-me-ḵā", "traducao_palavra": "Teu nome" },
        { "hebraico": "כִּ֤i", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "לֹֽא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "עָזַ֖בְתָּ", "transliteral": "ʿā-zaḇ-tā", "traducao_palavra": "abandonaste" },
        { "hebraico": "דֹרְשֶׁ֣יךָ", "transliteral": "dō-rə-šey-ḵā", "traducao_palavra": "os que Te buscam" },
        { "hebraico": "יְהוָֽה׃", "transliteral": "YHWH", "traducao_palavra": "YHWH" }
      ]
    },
    "11": {
      "traducao_completa": "Cantai louvores a YHWH, que habita em Sião; anunciai entre os povos os seus feitos.",
      "palavras": [
        { "hebraico": "זַמְּר֕וּ", "transliteral": "zam-mə-rû", "traducao_palavra": "Cantai louvores" },
        { "hebraico": "לַיהוָ֖ה", "transliteral": "lay-hwā", "traducao_palavra": "a YHWH" },
        { "hebraico": "יֹשֵׁ֣ב", "transliteral": "yô-šêḇ", "traducao_palavra": "[que] habita em" },
        { "hebraico": "צִיֹּ֑ון", "transliteral": "ṣiy-yôwn", "traducao_palavra": "Sião" },
        { "hebraico": "הַגִּ֥ידוּ", "transliteral": "haɡ-gî-ḏû", "traducao_palavra": "anunciai" },
        { "hebraico": "בָ֝עַמִּ֗ים", "transliteral": "ḇā-ʿam-mîm", "traducao_palavra": "entre os povos" },
        { "hebraico": "עֲלִילֹותָֽיו׃", "transliteral": "ʿă-lî-lô-ṯāyw", "traducao_palavra": "os Seus feitos" }
      ]
    },
    "12": {
      "traducao_completa": "Pois quando ele inquire do sangue, lembra-se deles; não se esquece do clamor dos aflitos.",
      "palavras": [
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "Porque" },
        { "hebraico": "דֹרֵ֣שׁ", "transliteral": "ḏō-rêš", "traducao_palavra": "[Aquele que] inquire de" },
        { "hebraico": "דָּ֭מִים", "transliteral": "dā-mîm", "traducao_palavra": "sangues" },
        { "hebraico": "אֹותָ֣ם", "transliteral": "ʾô-ṯām", "traducao_palavra": "deles" },
        { "hebraico": "זָכָ֑ר", "transliteral": "zā-ḵār", "traducao_palavra": "lembrou-se" },
        { "hebraico": "לֹֽא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "שָׁ֝כַח", "transliteral": "šā-ḵaḥ", "traducao_palavra": "esqueceu" },
        { "hebraico": "צַעֲקַ֥ת", "transliteral": "ṣa-ʿă-qaṯ", "traducao_palavra": "o clamor de" },
        { "hebraico": "עֲנָוִֽים׃", "transliteral": "ʿă-nā-wîm", "traducao_palavra": "aflitos/humildes" }
      ]
    },
    "13": {
      "traducao_completa": "Tem misericórdia de mim, YHWH; vê a aflição que padeço daqueles que me odeiam, tu que me levantas das portas da morte;",
      "palavras": [
        { "hebraico": "חָֽנְנֵ֬נִי", "transliteral": "ḥā-nə-nênî", "traducao_palavra": "Tem misericórdia de mim" },
        { "hebraico": "יְהוָ֗ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "רְאֵ֣ה", "transliteral": "rə-ʾēh", "traducao_palavra": "vê" },
        { "hebraico": "עָ֭נְיִי", "transliteral": "ʿā-nyî", "traducao_palavra": "minha aflição" },
        { "hebraico": "מִשֹּׂנְאָ֑י", "transliteral": "miś-śōn-ʾāy", "traducao_palavra": "causada pelos que me odeiam" },
        { "hebraico": "מְ֝רֹומְמִ֗י", "transliteral": "mə-rô-mə-mî", "traducao_palavra": "Tu que me levantas" },
        { "hebraico": "מִשַּׁ֥עֲרֵי", "transliteral": "miš-ša-ʿă-rê", "traducao_palavra": "das portas de" },
        { "hebraico": "מָֽוֶת׃", "transliteral": "mā-weṯ", "traducao_palavra": "morte" }
      ]
    },
    "14": {
      "traducao_completa": "Para que eu conte todos os teus louvores nas portas da filha de Sião, e me alegre na tua salvação.",
      "palavras": [
        { "hebraico": "לְמַ֥עַן", "transliteral": "lə-ma-ʿan", "traducao_palavra": "Para que" },
        { "hebraico": "אֲסַפְּרָ֗ה", "transliteral": "ʾă-śap-pə-rā", "traducao_palavra": "eu conte/relate" },
        { "hebraico": "כָּל־", "transliteral": "kāl-", "traducao_palavra": "todos" },
        { "hebraico": "תְּהִלָּ֫תֶ֥יךָ", "transliteral": "tə-hil-lā-ṯey-ḵā", "traducao_palavra": "Teus louvores" },
        { "hebraico": "בְּשַׁעֲרֵ֥i", "transliteral": "bə-ša-ʿă-rê", "traducao_palavra": "nas portas de" },
        { "hebraico": "בַת־", "transliteral": "baṯ-", "traducao_palavra": "a filha de" },
        { "hebraico": "צִיֹּ֑ון", "transliteral": "ṣiy-yôwn", "traducao_palavra": "Sião" },
        { "hebraico": "אָ֝גִ֗ילָה", "transliteral": "ʾā-ḡî-lā", "traducao_palavra": "me alegre" },
        { "hebraico": "בִּישׁוּעָתֶֽךָ׃", "transliteral": "bî-šû-ʿā-ṯe-ḵā", "traducao_palavra": "na Tua salvação" }
      ]
    },
    "15": {
      "traducao_completa": "As nações afundaram-se na cova que fizeram; na rede que esconderam ficou preso o seu pé.",
      "palavras": [
        { "hebraico": "טָבְע֣וּ", "transliteral": "ṭā-ḇə-ʿû", "traducao_palavra": "Afundaram-se" },
        { "hebraico": "גֹ֭ויִם", "transliteral": "ḡô-yim", "traducao_palavra": "as nações" },
        { "hebraico": "בְּשַׁ֣חַת", "transliteral": "bə-ša-ḥaṯ", "traducao_palavra": "na cova [que]" },
        { "hebraico": "עָשׂ֑וּ", "transliteral": "ʿā-śû", "traducao_palavra": "fizeram" },
        { "hebraico": "בְּרֶֽשֶׁת־", "transliteral": "bə-re-šeṯ-", "traducao_palavra": "na rede" },
        { "hebraico": "ז֥וּ", "transliteral": "zû", "traducao_palavra": "que" },
        { "hebraico": "טָ֝מָ֗נוּ", "transliteral": "ṭā-mā-nû", "traducao_palavra": "esconderam" },
        { "hebraico": "נִלְכְּדָ֥ה", "transliteral": "nil-kə-ḏā", "traducao_palavra": "foi presa" },
        { "hebraico": "רַגְלָֽם׃", "transliteral": "raḡ-lām", "traducao_palavra": "o pé deles" }
      ]
    },
    "16": {
      "traducao_completa": "YHWH é conhecido pelo juízo que executou; enlaçado ficou o ímpio nos seus próprios feitos. (Higaiom; Selá)",
      "palavras": [
