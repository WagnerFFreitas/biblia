        { "hebraico": "מְהֵרָ֣ה", "transliteral": "mə-hē-rā", "traducao_palavra": "em pressa/breve" },
        { "hebraico": "יִמָּ֑לוּ", "transliteral": "yim-mā-lû", "traducao_palavra": "eles murcharão/serão cortados" },
