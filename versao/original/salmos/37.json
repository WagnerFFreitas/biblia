        { "hebraico": "הָיִ֨יתִי", "transliteral": "hā-yî-ṯî", "traducao_palavra": "eu fui" },
        { "hebraico": "גַּם־זָקַ֗נְתִּי", "transliteral": "gam-zā-qan-tî", "traducao_palavra": "também envelheci" },
        { "hebraico": "וְֽלֹא־רָ֭אִיתִי", "transliteral": "wə-lō-rā-ʾî-ṯî", "traducao_palavra": "e não vi" },
        { "hebraico": "צַדִּ֣יק", "transliteral": "ṣad-dîq", "traducao_palavra": "[o] justo" },
        { "hebraico": "נֶעֱזָ֑ב", "transliteral": "ne-ʿĕ-zāḇ", "traducao_palavra": "abandonado" },
