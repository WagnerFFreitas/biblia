    },
    "24": {
      "traducao_completa": "Ainda que caia, não ficará prostrado, pois YHWH o sustém com a sua mão.",
      "palavras": [
        { "hebraico": "כִּֽי־יִפֹּ֥ל", "transliteral": "kî-yip-pōl", "traducao_palavra": "se cair" },
        { "hebraico": "לֹא־יֽוּטָ֑ל", "transliteral": "lō-yû-ṭāl", "traducao_palavra": "não será lançado ao chão" },
        { "hebraico": "כִּֽי־יְ֝הוָ֗ה", "transliteral": "kî-YHWH", "traducao_palavra": "porque YHWH" },
        { "hebraico": "סֹומֵ֥ךְ", "transliteral": "śô-mēḵ", "traducao_palavra": "sustenta/apoia" },
        { "hebraico": "יָדֹֽו׃", "transliteral": "yā-ḏô", "traducao_palavra": "a mão dele" }
      ]
