        { "hebraico": "אֱלֹהָ֣יו", "transliteral": "ʾĕ-lō-hāw", "traducao_palavra": "seu Deus" },
        { "hebraico": "בְּלִבֹּ֑ו", "transliteral": "bə-lib-bô", "traducao_palavra": "em seu coração" },
        { "hebraico": "לֹ֖א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "תִמְעַ֥ד", "transliteral": "ṯim-ʿaḏ", "traducao_palavra": "vacilarão/escorregarão" },
