        { "hebraico": "חָכְמָ֑ה", "transliteral": "ḥāḵ-mā", "traducao_palavra": "sabedoria" },
        { "hebraico": "וּ֝לְשֹׁונֹ֗ו", "transliteral": "ū-lə-šô-nô", "traducao_palavra": "e a sua língua" },
