        { "hebraico": "יִבֹּולֽוּן׃", "transliteral": "yib-bô-lûn", "traducao_palavra": "fenecerão/murcharão" }
      ]
    },
    "3": {
      "traducao_completa": "Confia em YHWH e faze o bem; habita na terra e alimenta-te da verdade.",
      "palavras": [
