        { "hebraico": "רְשָׁעִ֬ים", "transliteral": "rə-šā-ʿîm", "traducao_palavra": "ímpios" },
        { "hebraico": "תִּרְאֶֽה׃", "transliteral": "tir-ʾeh", "traducao_palavra": "tu verás" }
      ]
    },
    "35": {
      "traducao_completa": "Vi o ímpio com grande poder, espalhando-se como a árvore nativa luxuriante.",
