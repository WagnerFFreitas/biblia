        { "hebraico": "אֹ֘הֵ֤ב", "transliteral": "ʾō-hēḇ", "traducao_palavra": "ama" },
        { "hebraico": "מִשְׁפָּ֗ט", "transliteral": "miš-pāṭ", "traducao_palavra": "[a] justiça" },
