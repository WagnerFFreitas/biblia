        { "hebraico": "חֹונֵ֣ן", "transliteral": "ḥô-nên", "traducao_palavra": "se compadece" },
        { "hebraico": "וּמַלְוֶ֑ה", "transliteral": "ū-mal-weh", "traducao_palavra": "e empresta" },
        { "hebraico": "וְ֝זַרְעֹ֗ו", "transliteral": "wə-zar-ʿô", "traducao_palavra": "e a sua semente" },
        { "hebraico": "לִבְרָכָֽה׃", "transliteral": "li-ḇə-rā-ḵā", "traducao_palavra": "[será] para bênção" }
