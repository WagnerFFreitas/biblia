        { "hebraico": "מְ֭בֹורָכָיו", "transliteral": "mə-ḇô-rā-ḵāw", "traducao_palavra": "seus abençoados" },
        { "hebraico": "יִ֣ירְשׁוּ", "transliteral": "yî-rə-šû", "traducao_palavra": "herdarão" },
        { "hebraico": "אָ֑רֶץ", "transliteral": "ʾā-reṣ", "traducao_palavra": "[a] terra" },
        { "hebraico": "וּ֝מְקֻלָּלָ֗יו", "transliteral": "ū-mə-qul-lā-lāw", "traducao_palavra": "mas seus amaldiçoados" },
        { "hebraico": "יִכָּרֵֽתוּ׃", "transliteral": "yik-kā-rē-ṯû", "traducao_palavra": "serão cortados/exterminados" }
      ]
    },
    "23": {
      "traducao_completa": "Os passos de um homem bom são confirmados por YHWH, e ele deleita-se no seu caminho.",
