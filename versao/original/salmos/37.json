{
  "livro": "Salmos - תְּהִלִּים - Tehillim",
  "capítulo": 37,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "De Davi. Não te indignes por causa dos malfeitores, nem tenhas inveja dos que praticam a iniquidade.",
      "palavras": [
