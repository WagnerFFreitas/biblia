        { "hebraico": "יֹאבֵ֗דוּ", "transliteral": "yō-ḇê-ḏû", "traducao_palavra": "perecerão" },
        { "hebraico": "וְאֹיְבֵ֣י", "transliteral": "wə-ʾō-yə-ḇê", "traducao_palavra": "e os inimigos de" },
        { "hebraico": "יְ֭הוָה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
