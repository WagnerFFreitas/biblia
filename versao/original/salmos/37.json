        { "hebraico": "וַיַּ֭עֲבֹר", "transliteral": "way-ya-ʿă-ḇōr", "traducao_palavra": "e ele passou" },
        { "hebraico": "וְהִנֵּ֣ה", "transliteral": "wə-hin-nēh", "traducao_palavra": "e eis que" },
        { "hebraico": "אֵינֶ֑נּוּ", "transliteral": "ʾê-nen-nû", "traducao_palavra": "não [estava] ele" },
        { "hebraico": "וָֽ֝אֲבַקְשֵׁ֗הוּ", "transliteral": "wā-ʾă-ḇaq-šē-hû", "traducao_palavra": "e eu o busquei" },
        { "hebraico": "וְלֹ֣א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "נִמְצָֽא׃", "transliteral": "nim-ṣā", "traducao_palavra": "foi encontrado" }
      ]
