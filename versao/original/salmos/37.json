      ]
    },
    "34": {
      "traducao_completa": "Espera em YHWH e guarda o seu caminho, e ele te exaltará para herdares a terra; tu o verás quando os ímpios forem exterminados.",
      "palavras": [
        { "hebraico": "קַוֵּ֤ה", "transliteral": "qaw-wēh", "traducao_palavra": "espera" },
        { "hebraico": "אֶל־יְהוָ֨ה ׀", "transliteral": "ʾel-YHWH", "traducao_palavra": "em YHWH" },
        { "hebraico": "וּשְׁמֹ֬ר", "transliteral": "ū-šə-mōr", "traducao_palavra": "e guarda" },
        { "hebraico": "דַּרְכֹּ֗ו", "transliteral": "dar-kô", "traducao_palavra": "seu caminho" },
