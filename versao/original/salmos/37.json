        { "hebraico": "וַעֲשֵׂה־טֹ֑וב", "transliteral": "wa-ʿă-śēh-ṭôḇ", "traducao_palavra": "e faze o bem" },
        { "hebraico": "וּשְׁכֹ֥ן", "transliteral": "ū-šə-ḵōn", "traducao_palavra": "e habita" },
        { "hebraico": "לְעֹולָֽם׃", "transliteral": "lə-ʿô-lām", "traducao_palavra": "para sempre" }
