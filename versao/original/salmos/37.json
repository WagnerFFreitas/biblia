        { "hebraico": "אַל־תִּתְחַ֥ר", "transliteral": "ʾal-tiṯ-ḥar", "traducao_palavra": "não te indignes/esquentes" },
        { "hebraico": "בַּמְּרֵעִ֑ים", "transliteral": "bam-mə-rē-ʿîm", "traducao_palavra": "com os malfeitores" },
        { "hebraico": "אַל־תְּ֝קַנֵּ֗א", "transliteral": "ʾal-tə-qan-nē", "traducao_palavra": "não tenhas inveja" },
