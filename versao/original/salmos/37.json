        { "hebraico": "לֹֽא־יֵ֭בֹשׁוּ", "transliteral": "lō-yē-ḇō-šû", "traducao_palavra": "não serão envergonhados" },
        { "hebraico": "בְּעֵ֣ת", "transliteral": "bə-ʿêṯ", "traducao_palavra": "no tempo de" },
        { "hebraico": "רָעָ֑ה", "transliteral": "rā-ʿā", "traducao_palavra": "maldade/mal" },
        { "hebraico": "וּבִימֵ֖י", "transliteral": "ū-ḇî-mê", "traducao_palavra": "e nos dias de" },
        { "hebraico": "רְעָבֹ֣ון", "transliteral": "rə-ʿā-ḇôn", "traducao_palavra": "fome" },
