        { "hebraico": "רָ֭אִיתִי", "transliteral": "rā-ʾî-ṯî", "traducao_palavra": "vi" },
        { "hebraico": "רָשָׁ֣ע", "transliteral": "rā-šāʿ", "traducao_palavra": "ímpio" },
        { "hebraico": "עָרִ֑יץ", "transliteral": "ʿā-rîṣ", "traducao_palavra": "violento/temível" },
        { "hebraico": "וּ֝מִתְעָרֶ֗ה", "transliteral": "ū-miṯ-ʿā-reh", "traducao_palavra": "e espalhando-se/desnudando-se" },
        { "hebraico": "כְּאֶזְרָ֥ח", "transliteral": "kə-ʾez-rāḥ", "traducao_palavra": "como nativa" },
