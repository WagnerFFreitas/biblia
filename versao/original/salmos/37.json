        { "hebraico": "בֶעָשָׁ֣ן", "transliteral": "ḇe-ʿā-šān", "traducao_palavra": "em fumaça" },
        { "hebraico": "כָלֽוּ׃", "transliteral": "ḵā-lû", "traducao_palavra": "desapareceram" }
      ]
    },
    "21": {
