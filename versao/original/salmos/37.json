      "palavras": [
        { "hebraico": "לֹוֶ֣ה", "transliteral": "lô-weh", "traducao_palavra": "toma emprestado" },
        { "hebraico": "רָ֭שָׁע", "transliteral": "rā-šāʿ", "traducao_palavra": "o ímpio" },
        { "hebraico": "וְלֹ֣א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "יְשַׁלֵּ֑ם", "transliteral": "yə-šal-lēm", "traducao_palavra": "paga" },
        { "hebraico": "וְ֝צַדִּ֗יק", "transliteral": "wə-ṣad-dîq", "traducao_palavra": "mas o justo" },
