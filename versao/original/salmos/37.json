        { "hebraico": "וְזֶ֖רַע", "transliteral": "wə-ze-raʿ", "traducao_palavra": "mas a semente de" },
        { "hebraico": "רְשָׁעִ֣ים", "transliteral": "rə-šā-ʿîm", "traducao_palavra": "ímpios" },
        { "hebraico": "נִכְרָֽת׃", "transliteral": "niḵ-rāṯ", "traducao_palavra": "será cortada/exterminada" }
      ]
    },
    "29": {
      "traducao_completa": "Os justos herdarão a terra e habitarão nela para sempre.",
      "palavras": [
        { "hebraico": "צַדִּיקִ֥ים", "transliteral": "ṣad-dî-qîm", "traducao_palavra": "justos" },
