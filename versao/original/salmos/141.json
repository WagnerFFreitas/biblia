  "versiculos": {
    "1": {
      "traducao_completa": "YHWH, a ti clamo, apressa-te a vir a mim; dá ouvidos à minha voz, quando a ti clamar.",
      "palavras": [
        { "hebraico": "יְהוָ֣ה", "transliteral": "yəhwāh", "traducao_palavra": "YHWH" },
        { "hebraico": "קְרָאתִ֣יךָ", "transliteral": "qərāʾṯîḵā", "traducao_palavra": "clamei a ti" },
        { "hebraico": "ח֣וּשָׁה", "transliteral": "ḥûšā", "traducao_palavra": "apressa-te" },
        { "hebraico": "לִּ֑י", "transliteral": "llî", "traducao_palavra": "para mim" },
        { "hebraico": "הַאֲזִ֥ינָה", "transliteral": "haʾăzînā", "traducao_palavra": "dá ouvidos" },
        { "hebraico": "קֹ֝ולִ֗i", "transliteral": "qôlî", "traducao_palavra": "[à] minha voz" },
        { "hebraico": "בְּקָרְאִי־", "transliteral": "bəqāroʾî-", "traducao_palavra": "no meu clamar" },
        { "hebraico": "לָֽךְ׃", "transliteral": "lāḵ", "traducao_palavra": "a ti" }
      ]
    },
    "2": {
      "traducao_completa": "Suba a minha oração perante a tua face como incenso, e seja o levantar das minhas mãos como o sacrifício da tarde.",
