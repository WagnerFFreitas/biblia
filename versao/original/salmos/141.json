        { "hebraico": "חֶ֜סֶד", "transliteral": "ḥeseḏ", "traducao_palavra": "[será] bondade/favor" },
        { "hebraico": "וְיֹוכִיחֵ֗נִי", "transliteral": "wəyôḵîḥēnî", "traducao_palavra": "e repreenda me" },
