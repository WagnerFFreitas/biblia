    "6": {
      "traducao_completa": "Quando os seus juízes forem lançados pelos lados da rocha, ouvirão as minhas palavras, porque são agradáveis.",
      "palavras": [
        { "hebraico": "נִשְׁמְט֥וּ", "transliteral": "nišməṭû", "traducao_palavra": "forem lançados/precipitados" },
