        { "hebraico": "קְטֹ֣רֶת", "transliteral": "qəṭōreṯ", "traducao_palavra": "[como] incenso" },
        { "hebraico": "לְפָנֶ֑יךָ", "transliteral": "ləp̄āneyḵā", "traducao_palavra": "diante de ti" },
        { "hebraico": "מַשְׂאַ֥ת", "transliteral": "maśʾaṯ", "traducao_palavra": "[o] levantar de" },
        { "hebraico": "כַּ֝פַּ֗י", "transliteral": "kappay", "traducao_palavra": "minhas palmas/mãos" },
        { "hebraico": "מִנְחַת־", "transliteral": "minḥaṯ-", "traducao_palavra": "[como] oferta de" },
        { "hebraico": "עָֽרֶב׃", "transliteral": "ʿāreḇ", "traducao_palavra": "tarde" }
      ]
    },
    "3": {
      "traducao_completa": "Põe, YHWH, uma guarda à minha boca; guarda a porta dos meus lábios.",
      "palavras": [
        { "hebraico": "שִׁיתָ֣ה", "transliteral": "šîṯā", "traducao_palavra": "põe" },
        { "hebraico": "יְ֭הוָה", "transliteral": "yəhwāh", "traducao_palavra": "YHWH" },
        { "hebraico": "שָׁמְרָ֣ה", "transliteral": "šomrā", "traducao_palavra": "guarda" },
        { "hebraico": "לְפִ֑י", "transliteral": "ləp̄î", "traducao_palavra": "para minha boca" },
