        { "hebraico": "מִנְּעוּרָ֑י", "transliteral": "min-nə-ʿû-rāy", "traducao_palavra": "desde minha juventude" },
        { "hebraico": "גַּ֝ם", "transliteral": "gam", "traducao_palavra": "também/contudo" },
