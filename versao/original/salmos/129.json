        { "hebraico": "רַ֭בַּת", "transliteral": "rab-baṯ", "traducao_palavra": "muito/muitas vezes" },
        { "hebraico": "צְרָר֥וּנִי", "transliteral": "ṣə-rā-rû-nî", "traducao_palavra": "afligiram-me" },
