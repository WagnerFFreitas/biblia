    "7": {
      "traducao_completa": "Da qual o ceifeiro não enche a sua mão, nem o que atar os feixes o seu colo.",
      "palavras": [
        { "hebraico": "שֶׁלֹּ֤א", "transliteral": "šel-lō", "traducao_palavra": "que não" },
