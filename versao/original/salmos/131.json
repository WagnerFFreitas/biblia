  "versiculos": {
    "1": {
      "traducao_completa": "YHWH, não é altivo o meu coração, nem os meus olhos são elevados; não ando em coisas grandes, nem em coisas maravilhosas demais para mim.",
      "palavras": [
        { "hebraico": "יְהוָ֨ה", "transliteral": "yəhwāh", "traducao_palavra": "YHWH" },
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "גָבַ֣הּ", "transliteral": "ɡāḇah", "traducao_palavra": "foi altivo" },
        { "hebraico": "לִבִּ֗י", "transliteral": "libbî", "traducao_palavra": "meu coração" },
        { "hebraico": "וְלֹא־", "transliteral": "wəlō-", "traducao_palavra": "e não" },
        { "hebraico": "רָמ֣וּ", "transliteral": "rāmû", "traducao_palavra": "foram elevados" },
        { "hebraico": "עֵינַ֑י", "transliteral": "ʿênay", "traducao_palavra": "meus olhos" },
        { "hebraico": "וְלֹא־", "transliteral": "wəlō-", "traducao_palavra": "e não" },
        { "hebraico": "הִלַּ֬כְתִּי", "transliteral": "hillaḵtî", "traducao_palavra": "andei" },
        { "hebraico": "בִּגְדֹלֹ֖ות", "transliteral": "biḡḏōlôṯ", "traducao_palavra": "em grandes [coisas]" },
        { "hebraico": "וּבְנִפְלָאֹ֥ות", "transliteral": "ūḇənip̄lāʾôṯ", "traducao_palavra": "e em maravilhosas" },
        { "hebraico": "מִמֶּֽנִּי׃", "transliteral": "mimmennî", "traducao_palavra": "além de mim/para mim" }
      ]
    },
    "2": {
      "traducao_completa": "Certamente sosseguei e aquietei a minha alma; como a criança desmamada nos braços de sua mãe, assim é a minha alma para comigo.",
      "palavras": [
        { "hebraico": "אִם־", "transliteral": "ʾim-", "traducao_palavra": "se" },
        { "hebraico": "לֹ֤א", "transliteral": "lō", "traducao_palavra": "não [certamente]" },
        { "hebraico": "שִׁוִּ֨יתִי", "transliteral": "šiwwîṯî", "traducao_palavra": "ajustei/acalmei" },
        { "hebraico": "וְדֹומַ֗מְתִּי", "transliteral": "wəḏômamtî", "traducao_palavra": "e aquietei" },
        { "hebraico": "נַ֫פְשִׁ֥י", "transliteral": "nap̄šî", "traducao_palavra": "minha alma" },
        { "hebraico": "כְּגָמֻ֥ל", "transliteral": "kəḡāmul", "traducao_palavra": "como um desmamado" },
        { "hebraico": "עֲלֵ֣י", "transliteral": "ʿălê", "traducao_palavra": "sobre/com" },
        { "hebraico": "אִמֹּ֑ו", "transliteral": "ʾimmô", "traducao_palavra": "mãe dele" },
        { "hebraico": "כַּגָּמֻ֖ל", "transliteral": "kaggāmul", "traducao_palavra": "como o desmamado" },
        { "hebraico": "עָלַ֣י", "transliteral": "ʿālay", "traducao_palavra": "sobre mim" },
        { "hebraico": "נַפְשִֽׁי׃", "transliteral": "nap̄šî", "traducao_palavra": "minha alma" }
      ]
    },
    "3": {
      "traducao_completa": "Espere Israel em YHWH, desde agora e para sempre.",
      "palavras": [
        { "hebraico": "יַחֵ֣ל", "transliteral": "yaḥēl", "traducao_palavra": "espere" },
