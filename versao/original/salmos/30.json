{
  "livro": "Salmos - תְּהִלִּים - Tehillim",
  "capítulo": 30,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Salmo. Cântico da dedicação da Casa. De Davi.",
      "palavras": [
        { "hebraico": "מִזְמֹ֥ור", "transliteral": "miz-môr", "traducao_palavra": "salmo" },
        { "hebraico": "שִׁיר־חֲנֻכַּ֥ת", "transliteral": "šîr-ḥă-nuk-kaṯ", "traducao_palavra": "cântico de dedicação de" },
        { "hebraico": "הַבַּ֗יִת", "transliteral": "hab-ba-yiṯ", "traducao_palavra": "a casa" },
        { "hebraico": "לְדָוִֽד׃", "transliteral": "lə-ḏā-wiḏ", "traducao_palavra": "de Davi" }
      ]
    },
    "2": {
      "traducao_completa": "Exaltar-te-ei, YHWH, porque tu me levantaste e não permitiste que os meus inimigos se alegrassem sobre mim.",
      "palavras": [
        { "hebraico": "אֲרֹומִמְךָ֣", "transliteral": "ʾă-rô-mim-ḵā", "traducao_palavra": "eu te exaltarei" },
        { "hebraico": "יְהוָ֮ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "כִּ֪י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "דִלִּ֫יתָ֥נִי", "transliteral": "dil-lî-ṯā-nî", "traducao_palavra": "tu me levantaste/hauriste" },
        { "hebraico": "וְלֹא־שִׂמַּ֖חְתָּ", "transliteral": "wə-lō-śim-maḥ-tā", "traducao_palavra": "e não fizeste alegrar" },
        { "hebraico": "אֹיְבַ֣י", "transliteral": "ʾō-yə-ḇay", "traducao_palavra": "meus inimigos" },
        { "hebraico": "לִֽי׃", "transliteral": "lî", "traducao_palavra": "sobre mim/por minha causa" }
      ]
    },
    "3": {
      "traducao_completa": "YHWH, meu Deus, a ti clamei, e tu me saraste.",
      "palavras": [
        { "hebraico": "יְהוָ֥ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "אֱלֹהָ֑י", "transliteral": "ʾĕ-lō-hāy", "traducao_palavra": "meu Deus" },
        { "hebraico": "שִׁוַּ֥עְתִּי", "transliteral": "šiw-waʿ-tî", "traducao_palavra": "eu clamei por socorro" },
        { "hebraico": "אֵ֝לֶ֗יךָ", "transliteral": "ʾê-le-ḵā", "traducao_palavra": "a ti" },
        { "hebraico": "וַתִּרְפָּאֵֽנִי׃", "transliteral": "wat-tir-pā-ʾē-nî", "traducao_palavra": "e tu me saraste" }
      ]
    },
    "4": {
      "traducao_completa": "YHWH, fizeste subir a minha alma do Sheol; preservaste-me a vida para que não descesse à cova.",
      "palavras": [
        { "hebraico": "יְהוָ֗ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "הֶעֱלִ֣יתָ", "transliteral": "he-ʿĕ-lî-ṯā", "traducao_palavra": "tu fizeste subir" },
        { "hebraico": "מִן־שְׁאֹ֣ול", "transliteral": "min-šə-ʾôl", "traducao_palavra": "do Sheol" },
        { "hebraico": "נַפְשִׁ֑י", "transliteral": "nap̄-šî", "traducao_palavra": "minha alma" },
        { "hebraico": "חִיִּיתַ֓נִי", "transliteral": "ḥiy-yî-ṯa-nî", "traducao_palavra": "tu me deste vida/preservaste" },
        { "hebraico": "מִיֹּֽורְדֵי־בֹֽור׃", "transliteral": "miy-yôr-ḏê-ḇôr", "traducao_palavra": "de entre os que descem à cova" }
      ]
    },
    "5": {
      "traducao_completa": "Cantai louvores a YHWH, vós que sois seus santos, e dai graças à memória da sua santidade.",
      "palavras": [
        { "hebraico": "זַמְּר֣וּ", "transliteral": "zam-mə-rû", "traducao_palavra": "cantai louvores/salmodiai" },
        { "hebraico": "לַיהוָ֣ה", "transliteral": "lay-hwāh", "traducao_palavra": "a YHWH" },
        { "hebraico": "חֲסִידָ֑יו", "transliteral": "ḥă-śî-ḏāw", "traducao_palavra": "seus santos/fiéis" },
        { "hebraico": "וְ֝הֹוד֗וּ", "transliteral": "wə-hô-ḏû", "traducao_palavra": "e dai graças/louvai" },
        { "hebraico": "לְזֵ֣כֶר", "transliteral": "lə-zê-ḵer", "traducao_palavra": "à memória de/menção de" },
        { "hebraico": "קָדְשֹֽׁו׃", "transliteral": "qāḏ-šô", "traducao_palavra": "sua santidade" }
      ]
    },
    "6": {
      "traducao_completa": "Porque a sua ira dura só um momento; no seu favor está a vida. O choro pode durar uma noite, mas a alegria vem pela manhã.",
      "palavras": [
        { "hebraico": "כִּ֤י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "רֶ֨גַע", "transliteral": "re-ḡaʿ", "traducao_palavra": "[há] um momento" },
        { "hebraico": "בְּאַפֹּו֮", "transliteral": "bə-ʾap-pô", "traducao_palavra": "na sua ira" },
        { "hebraico": "חַיִּ֪ים", "transliteral": "ḥay-yîm", "traducao_palavra": "vida" },
        { "hebraico": "בִּרְצֹ֫ונֹ֥ו", "transliteral": "bir-ṣô-nô", "traducao_palavra": "no seu favor/vontade" },
        { "hebraico": "בָּ֭עֶרֶב", "transliteral": "bā-ʿe-reḇ", "traducao_palavra": "à tarde/anoitecer" },
        { "hebraico": "יָלִ֥ין", "transliteral": "yā-lîn", "traducao_palavra": "pernoita/pousa" },
        { "hebraico": "בֶּ֗כִי", "transliteral": "be-ḵî", "traducao_palavra": "[o] choro" },
        { "hebraico": "וְלַבֹּ֥קֶר", "transliteral": "wə-lab-bō-qer", "traducao_palavra": "e ao amanhecer" },
        { "hebraico": "רִנָּֽה׃", "transliteral": "rin-nā", "traducao_palavra": "[vem o] grito de alegria" }
      ]
    },
    "7": {
      "traducao_completa": "Eu dizia na minha prosperidade: Jamais serei abalado.",
      "palavras": [
        { "hebraico": "וַ֭אֲנִי", "transliteral": "wa-ʾă-nî", "traducao_palavra": "e eu" },
        { "hebraico": "אָמַ֣רְתִּי", "transliteral": "ʾā-mar-tî", "traducao_palavra": "disse" },
        { "hebraico": "בְשַׁלְוִ֑י", "transliteral": "ḇə-šal-wî", "traducao_palavra": "na minha tranquilidade/prosperidade" },
        { "hebraico": "בַּל־אֶמֹּ֥וט", "transliteral": "bal-ʾem-môṭ", "traducao_palavra": "não serei abalado" },
        { "hebraico": "לְעֹולָֽם׃", "transliteral": "lə-ʿô-lām", "traducao_palavra": "para sempre" }
      ]
    },
    "8": {
      "traducao_completa": "YHWH, pelo teu favor fizeste que o meu monte permanecesse forte; escondeste o teu rosto, e fiquei perturbado.",
      "palavras": [
        { "hebraico": "יְהוָה֮", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "בִּרְצֹונְךָ֮", "transliteral": "bir-ṣô-nə-ḵā", "traducao_palavra": "no teu favor" },
        { "hebraico": "הֶעֱמַ֪דְתָּה", "transliteral": "he-ʿĕ-maḏ-tā", "traducao_palavra": "tu fizeste estar de pé" },
        { "hebraico": "לְֽהַרְרִ֫י", "transliteral": "lə-har-rî", "traducao_palavra": "para meu monte" },
        { "hebraico": "עֹ֥ז", "transliteral": "ʿōz", "traducao_palavra": "força" },
        { "hebraico": "הִסְתַּ֥רְתָּ", "transliteral": "his-tar-tā", "traducao_palavra": "escondeste" },
        { "hebraico": "פָנֶ֗יךָ", "transliteral": "p̄ā-ne-ḵā", "traducao_palavra": "tua face" },
        { "hebraico": "הָיִ֥יתִי", "transliteral": "hā-yî-ṯî", "traducao_palavra": "eu estive/fiquei" },
        { "hebraico": "נִבְהָֽל׃", "transliteral": "niḇ-hāl", "traducao_palavra": "perturbado/aterrorizado" }
      ]
    },
    "9": {
      "traducao_completa": "A ti, YHWH, clamei, e ao Senhor supliquei.",
      "palavras": [
        { "hebraico": "אֵלֶ֣יךָ", "transliteral": "ʾê-le-ḵā", "traducao_palavra": "a ti" },
        { "hebraico": "יְהוָ֣ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "אֶקְרָ֑א", "transliteral": "ʾeq-rā", "traducao_palavra": "clamarei" },
        { "hebraico": "וְאֶל־אֲ֝דֹנָ֗י", "transliteral": "wə-ʾel-ʾă-ḏō-nāy", "traducao_palavra": "e ao Senhor" },
        { "hebraico": "אֶתְחַנָּֽן׃", "transliteral": "ʾeṯ-ḥan-nān", "traducao_palavra": "suplicarei" }
      ]
    },
    "10": {
      "traducao_completa": "Que proveito há no meu sangue, quando eu descer à cova? Porventura te louvará o pó? Anunciará ele a tua verdade?",
      "palavras": [
        { "hebraico": "מַה־בֶּ֥צַע", "transliteral": "mah-be-ṣaʿ", "traducao_palavra": "que ganho/proveito" },
        { "hebraico": "בְּדָמִי֮", "transliteral": "bə-ḏā-mî", "traducao_palavra": "no meu sangue" },
        { "hebraico": "בְּרִדְתִּ֪י", "transliteral": "bə-riḏ-tî", "traducao_palavra": "no meu descer" },
        { "hebraico": "אֶ֫ל", "transliteral": "ʾel", "traducao_palavra": "a" },
        { "hebraico": "שָׁ֥חַת", "transliteral": "šā-ḥaṯ", "traducao_palavra": "[a] cova/corrupção" },
        { "hebraico": "הֲיֹ֫ודְךָ֥", "transliteral": "hă-yô-ḏə-ḵā", "traducao_palavra": "acaso te louvará" },
        { "hebraico": "עָפָ֑ר", "transliteral": "ʿā-p̄ār", "traducao_palavra": "[o] pó" },
        { "hebraico": "הֲיַגִּ֥יד", "transliteral": "hă-yag-gîḏ", "traducao_palavra": "anunciará ele" },
        { "hebraico": "אֲמִתֶּֽךָ׃", "transliteral": "ʾă-mit-te-ḵā", "traducao_palavra": "tua verdade" }
      ]
    },
    "11": {
      "traducao_completa": "Ouve, YHWH, e tem piedade de mim; YHWH, sê o meu ajudador.",
      "palavras": [
        { "hebraico": "שְׁמַע־יְהוָ֥ה", "transliteral": "šə-maʿ-YHWH", "traducao_palavra": "ouve YHWH" },
        { "hebraico": "וְחָנֵּ֑נִי", "transliteral": "wə-ḥān-nê-nî", "traducao_palavra": "e tem piedade de mim" },
        { "hebraico": "יְ֝הוָ֗ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "הֱיֵֽה־עֹזֵ֥ר", "transliteral": "hĕ-yê-ʿō-zēr", "traducao_palavra": "sê ajudador" },
        { "hebraico": "לִֽי׃", "transliteral": "lî", "traducao_palavra": "para mim" }
      ]
    },
    "12": {
      "traducao_completa": "Mudaste o meu pranto em dança; folgaste o meu cilício e cingiste-me de alegria;",
      "palavras": [
        { "hebraico": "הָפַ֣כְתָּ", "transliteral": "hā-p̄aḵ-tā", "traducao_palavra": "tu mudaste/reverteste" },
        { "hebraico": "מִסְפְּדִי֮", "transliteral": "mis-pə-ḏî", "traducao_palavra": "meu lamento/pranto" },
        { "hebraico": "לְמָחֹ֪ול", "transliteral": "lə-mā-ḥôl", "traducao_palavra": "em dança" },
        { "hebraico": "לִ֥י", "transliteral": "lî", "traducao_palavra": "para mim" },
        { "hebraico": "פִּתַּ֪חְתָּ", "transliteral": "pit-taḥ-tā", "traducao_palavra": "soltaste/abrirste" },
        { "hebraico": "שַׂקִּ֑י", "transliteral": "śaq-qî", "traducao_palavra": "meu saco/cilício" },
        { "hebraico": "וַֽתְּאַזְּרֵ֥נִי", "transliteral": "wat-tə-ʾaz-zə-rē-nî", "traducao_palavra": "e cingiste-me" },
        { "hebraico": "שִׂמְחָֽה׃", "transliteral": "śim-ḥā", "traducao_palavra": "[com] alegria" }
      ]
    },
    "13": {
      "traducao_completa": "Para que a minha glória te cante louvores e não se cale. YHWH, meu Deus, eu te louvarei para sempre.",
      "palavras": [
        { "hebraico": "לְמַ֤עַן ׀", "transliteral": "lə-ma-ʿan", "traducao_palavra": "para que" },
        { "hebraico": "יְזַמֶּרְךָ֣", "transliteral": "yə-zam-mer-ḵā", "traducao_palavra": "cante louvores a ti" },
        { "hebraico": "כָ֭בֹוד", "transliteral": "kā-ḇôḏ", "traducao_palavra": "glória [alma]" },
        { "hebraico": "וְלֹ֣א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "יִדֹּ֑ם", "transliteral": "yid-dōm", "traducao_palavra": "se cale" },
        { "hebraico": "יְהוָ֥ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "אֱ֝לֹהַ֗י", "transliteral": "ʾĕ-lō-hay", "traducao_palavra": "meu Deus" },
        { "hebraico": "לְעֹולָ֥ם", "transliteral": "lə-ʿô-lām", "traducao_palavra": "para sempre" },
        { "hebraico": "אֹודֶֽךָּ׃", "transliteral": "ʾô-ḏek-kā", "traducao_palavra": "eu te louvarei/renderei graças" }
      ]
    }
  }
}