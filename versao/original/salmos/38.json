    "13": {
      "traducao_completa": "Mas eu, como um surdo, não ouvia; e era como um mudo que não abre a sua boca.",
      "palavras": [
        { "hebraico": "וַאֲנִ֣י", "transliteral": "wa-ʾă-nî", "traducao_palavra": "mas eu" },
