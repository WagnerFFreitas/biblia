        { "hebraico": "כִּ֣י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "עֲוֹ֭נֹתַי", "transliteral": "ʿă-wō-nō-ṯay", "traducao_palavra": "minhas iniquidades" },
