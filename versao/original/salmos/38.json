        { "hebraico": "זַעְמֶ֑ךָ", "transliteral": "za-ʿə-me-ḵā", "traducao_palavra": "tua indignação" },
        { "hebraico": "אֵין־שָׁלֹ֥ום", "transliteral": "ʾên-šā-lôm", "traducao_palavra": "não há paz/saúde" },
