    "7": {
      "traducao_completa": "Estou encurvado, estou muito abatido, ando lamentando todo o dia.",
      "palavras": [
        { "hebraico": "נַעֲוֵ֣יתִי", "transliteral": "na-ʿă-wê-ṯî", "traducao_palavra": "estou retorcido/encurvado" },
