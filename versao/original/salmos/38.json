{
  "livro": "Salmos - תְּהִלִּים - Tehillim",
  "capítulo": 38,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Salmo de Davi, para trazer à memória.",
      "palavras": [
        { "hebraico": "מִזְמֹ֥ור", "transliteral": "miz-môr", "traducao_palavra": "salmo" },
        { "hebraico": "לְדָוִ֗ד", "transliteral": "lə-ḏā-wiḏ", "traducao_palavra": "de Davi" },
        { "hebraico": "לְהַזְכִּֽיר׃", "transliteral": "lə-haz-kîr", "traducao_palavra": "para lembrar/fazer menção" }
      ]
    },
    "2": {
      "traducao_completa": "YHWH, não me repreendas na tua ira, nem me castigues no teu furor.",
      "palavras": [
        { "hebraico": "יְֽהוָ֗ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "אַל־בְּקֶצְפְּךָ֥", "transliteral": "ʾal-bə-qeṣ-pə-ḵā", "traducao_palavra": "não em tua ira" },
        { "hebraico": "תֹ֝וכִיחֵ֗נִי", "transliteral": "ṯô-ḵî-ḥē-nî", "traducao_palavra": "repreendas-me" },
        { "hebraico": "וּֽבַחֲמָתְךָ֥", "transliteral": "ū-ḇa-ḥă-mā-ṯə-ḵā", "traducao_palavra": "e em teu calor/furor" },
        { "hebraico": "תְיַסְּרֵֽנִי׃", "transliteral": "ṯə-yas-śə-rē-nî", "traducao_palavra": "disciplines-me/corrijas-me" }
      ]
    },
    "3": {
      "traducao_completa": "Porque as tuas setas se cravaram em mim, e a tua mão pesou sobre mim.",
