        { "hebraico": "בִ֑י", "transliteral": "ḇî", "traducao_palavra": "em mim" },
        { "hebraico": "וַתִּנְחַ֖ת", "transliteral": "wat-tin-ḥaṯ", "traducao_palavra": "e desceu/pesou" },
        { "hebraico": "עָלַ֣י", "transliteral": "ʿā-lay", "traducao_palavra": "sobre mim" },
        { "hebraico": "יָדֶֽךָ׃", "transliteral": "yā-ḏe-ḵā", "traducao_palavra": "tua mão" }
      ]
    },
    "4": {
