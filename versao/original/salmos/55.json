        { "hebraico": "וְלֹא־יָמִ֧ישׁ", "transliteral": "wə-lō-yā-mîš", "traducao_palavra": "e não se afasta" },
        { "hebraico": "מֵרְחֹבָ֗הּ", "transliteral": "mê-rə-ḥō-ḇāh", "traducao_palavra": "da praça/rua dela" },
        { "hebraico": "תֹּ֥ךְ", "transliteral": "tōḵ", "traducao_palavra": "opressão/fraude" },
        { "hebraico": "וּמִרְמָֽה׃", "transliteral": "ū-mir-mā", "traducao_palavra": "e engano" }
      ]
    },
    "12": {
      "traducao_completa": "Pois não era um inimigo que me afrontava; então eu o teria suportado; nem era um que me odiava que se exaltava contra mim, porque dele me teria escondido.",
