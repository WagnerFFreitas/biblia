{
  "livro": "Salmos - תְּהִלִּים - Tehillim",
  "capítulo": 55,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Dá ouvidos, ó Deus, à minha oração, e não te escondas da minha súplica.",
      "palavras": [
        { "hebraico": "הַאֲזִ֣ינָה", "transliteral": "ha-ʾă-zî-nā", "traducao_palavra": "dá ouvidos" },
        { "hebraico": "אֱ֭לֹהִים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "ó Deus" },
        { "hebraico": "תְּפִלָּתִ֑י", "transliteral": "tə-p̄il-lā-ṯî", "traducao_palavra": "minha oração" },
        { "hebraico": "וְאַל־תִּתְעַלַּ֥ם", "transliteral": "wə-ʾal-tiṯ-ʿal-lam", "traducao_palavra": "e não te escondas/te furtes" },
        { "hebraico": "מִתְּחִנָּתִֽי׃", "transliteral": "mit-tə-ḥin-nā-ṯî", "traducao_palavra": "da minha súplica" }
      ]
    },
    "2": {
      "traducao_completa": "Atende-me e responde-me; lamento na minha queixa e me agito,",
      "palavras": [
        { "hebraico": "הַקְשִׁ֣יבָה", "transliteral": "haq-šî-ḇā", "traducao_palavra": "atende" },
        { "hebraico": "לִּ֣י", "transliteral": "lî", "traducao_palavra": "para mim" },
        { "hebraico": "וַעֲנֵ֑נִי", "transliteral": "wa-ʿă-nê-nî", "traducao_palavra": "e responde-me" },
        { "hebraico": "אָרִ֖יד", "transliteral": "ʾā-rîḏ", "traducao_palavra": "eu vagueio/lamento" },
        { "hebraico": "בְּשִׂיחִ֣י", "transliteral": "bə-śî-ḥî", "traducao_palavra": "na minha queixa/meditação" },
        { "hebraico": "וְאָהִֽימָה׃", "transliteral": "wə-ʾā-hî-mā", "traducao_palavra": "e me agito/faço barulho" }
      ]
    },
    "3": {
      "traducao_completa": "Por causa do clamor do inimigo e da opressão do ímpio; pois lançam sobre mim a iniquidade e com ira me perseguem.",
      "palavras": [
        { "hebraico": "מִקֹּ֥ול", "transliteral": "miq-qôl", "traducao_palavra": "pela voz de" },
        { "hebraico": "אֹויֵ֗ב", "transliteral": "ʾô-yēḇ", "traducao_palavra": "inimigo" },
        { "hebraico": "מִפְּנֵ֣י", "transliteral": "mip-pə-nê", "traducao_palavra": "diante da face de" },
        { "hebraico": "עָקַ֣ת", "transliteral": "ʿā-qaṯ", "traducao_palavra": "pressão/opressão de" },
        { "hebraico": "רָשָׁ֑ע", "transliteral": "rā-šāʿ", "traducao_palavra": "ímpio" },
        { "hebraico": "כִּי־יָמִ֨יטוּ", "transliteral": "kî-yā-mî-ṭû", "traducao_palavra": "pois lançam/fazem recair" },
        { "hebraico": "עָלַ֥י", "transliteral": "ʿā-lay", "traducao_palavra": "sobre mim" },
        { "hebraico": "אָ֗וֶן", "transliteral": "ʾā-wen", "traducao_palavra": "iniquidade" },
        { "hebraico": "וּבְאַ֥ף", "transliteral": "ū-ḇə-ʾap̄", "traducao_palavra": "e com ira" },
        { "hebraico": "יִשְׂטְמֽוּנִי׃", "transliteral": "yiś-ṭə-mû-nî", "traducao_palavra": "eles me odeiam/perseguem" }
      ]
    },
    "4": {
      "traducao_completa": "O meu coração estremece dentro de mim, e os terrores da morte caíram sobre mim.",
      "palavras": [
        { "hebraico": "לִ֭בִּי", "transliteral": "lib-bî", "traducao_palavra": "meu coração" },
        { "hebraico": "יָחִ֣יל", "transliteral": "yā-ḥîl", "traducao_palavra": "estremece/contorce-se" },
        { "hebraico": "בְּקִרְבִּ֑י", "transliteral": "bə-qir-bî", "traducao_palavra": "dentro de mim" },
        { "hebraico": "וְאֵימֹ֥ות", "transliteral": "wə-ʾê-môṯ", "traducao_palavra": "e os pavores de" },
        { "hebraico": "מָ֝֗וֶת", "transliteral": "mā-weṯ", "traducao_palavra": "morte" },
        { "hebraico": "נָפְל֥וּ", "transliteral": "nā-p̄ə-lû", "traducao_palavra": "caíram" },
        { "hebraico": "עָלָֽי׃", "transliteral": "ʿā-lāy", "traducao_palavra": "sobre mim" }
      ]
    },
    "5": {
      "traducao_completa": "Temor e tremor vieram sobre mim, e o horror me cobriu.",
      "palavras": [
        { "hebraico": "יִרְאָ֣ה", "transliteral": "yir-ʾā", "traducao_palavra": "temor" },
        { "hebraico": "וָ֭רַעַד", "transliteral": "wā-ra-ʿaḏ", "traducao_palavra": "e tremor" },
        { "hebraico": "יָ֣בֹא", "transliteral": "yā-ḇō", "traducao_palavra": "entrou/veio" },
        { "hebraico": "בִ֑י", "transliteral": "ḇî", "traducao_palavra": "em mim" },
        { "hebraico": "וַתְּכַסֵּ֥נִי", "transliteral": "wat-tə-ḵas-śē-nî", "traducao_palavra": "e me cobriu" },
        { "hebraico": "פַּלָּצֽוּת׃", "transliteral": "pal-lā-ṣûṯ", "traducao_palavra": "[o] horror/tremor" }
      ]
    },
    "6": {
      "traducao_completa": "Pelo que disse: Ah! quem me dera asas como de pomba! Pois voaria e encontraria repouso.",
      "palavras": [
        { "hebraico": "וָאֹמַ֗ר", "transliteral": "wā-ʾō-mar", "traducao_palavra": "e disse" },
        { "hebraico": "מִֽי־יִתֶּן־", "transliteral": "mî-yit-ten-", "traducao_palavra": "quem dera/dará" },
        { "hebraico": "לִּ֣י", "transliteral": "lî", "traducao_palavra": "para mim" },
        { "hebraico": "אֵ֭בֶר", "transliteral": "ʾē-ḇer", "traducao_palavra": "asa" },
        { "hebraico": "כַּיֹּונָ֑ה", "transliteral": "kay-yô-nā", "traducao_palavra": "como de pomba" },
        { "hebraico": "אָעִ֥ופָה", "transliteral": "ʾā-ʿî-p̄ā", "traducao_palavra": "eu voaria" },
        { "hebraico": "וְאֶשְׁכֹּֽנָה׃", "transliteral": "wə-ʾeš-kō-nā", "traducao_palavra": "e habitaria/repousaria" }
      ]
    },
    "7": {
      "traducao_completa": "Eis que me afastaria para longe e pernoitaria no deserto. (Selah)",
      "palavras": [
        { "hebraico": "הִ֭נֵּה", "transliteral": "hin-nēh", "traducao_palavra": "eis que" },
        { "hebraico": "אַרְחִ֣יק", "transliteral": "ʾar-ḥîq", "traducao_palavra": "eu faria longe" },
        { "hebraico": "נְדֹ֑ד", "transliteral": "nə-ḏōḏ", "traducao_palavra": "[o] vaguear" },
        { "hebraico": "אָלִ֖ין", "transliteral": "ʾā-lîn", "traducao_palavra": "eu pernoitaria" },
        { "hebraico": "בַּמִּדְבָּ֣ר", "transliteral": "bam-miḏ-bār", "traducao_palavra": "no deserto" },
        { "hebraico": "סֶֽלָה׃", "transliteral": "śe-lā", "traducao_palavra": "Selah [pausa]" }
      ]
    },
    "8": {
      "traducao_completa": "Apressar-me-ia a encontrar um refúgio contra o vento tempestuoso e a tormenta.",
      "palavras": [
        { "hebraico": "אָחִ֣ישָׁה", "transliteral": "ʾā-ḥî-šā", "traducao_palavra": "eu apressaria" },
        { "hebraico": "מִפְלָ֣ט", "transliteral": "mip̄-lāṭ", "traducao_palavra": "refúgio/escape" },
        { "hebraico": "לִ֑י", "transliteral": "lî", "traducao_palavra": "para mim" },
        { "hebraico": "מֵר֥וּחַ", "transliteral": "mē-rû-aḥ", "traducao_palavra": "de vento" },
        { "hebraico": "סֹ֝ועָה", "transliteral": "śô-ʿā", "traducao_palavra": "tempestuoso" },
        { "hebraico": "מִסָּֽעַר׃", "transliteral": "mis-sā-ʿar", "traducao_palavra": "da tormenta" }
      ]
    },
    "9": {
      "traducao_completa": "Destrói, Senhor, e divide as suas línguas, pois tenho visto violência e contenda na cidade.",
      "palavras": [
        { "hebraico": "בַּלַּ֧ע", "transliteral": "bal-laʿ", "traducao_palavra": "destrói/engole" },
        { "hebraico": "אֲדֹנָ֗י", "transliteral": "ʾă-ḏō-nāy", "traducao_palavra": "Senhor" },
        { "hebraico": "פַּלַּ֥ג", "transliteral": "pal-laḡ", "traducao_palavra": "divide" },
        { "hebraico": "לְשֹׁונָ֑ם", "transliteral": "lə-šô-nām", "traducao_palavra": "língua deles" },
        { "hebraico": "כִּֽי־רָאִ֨יתִי", "transliteral": "kî-rā-ʾî-ṯî", "traducao_palavra": "pois vi" },
        { "hebraico": "חָמָ֖ס", "transliteral": "ḥā-mās", "traducao_palavra": "violência" },
        { "hebraico": "וְרִ֣יב", "transliteral": "wə-rîḇ", "traducao_palavra": "e contenda" },
        { "hebraico": "בָּעִֽיר׃", "transliteral": "bā-ʿîr", "traducao_palavra": "na cidade" }
      ]
    },
    "10": {
      "traducao_completa": "Dia e noite a cercam sobre os seus muros; também iniquidade e malícia estão no meio dela.",
      "palavras": [
        { "hebraico": "יֹ֘ומָ֤ם", "transliteral": "yôm-mām", "traducao_palavra": "dia" },
        { "hebraico": "וָלַ֗יְלָה", "transliteral": "wā-lay-lā", "traducao_palavra": "e noite" },
        { "hebraico": "יְסֹובְבֻ֥הָ", "transliteral": "yə-śô-ḇə-ḇu-hā", "traducao_palavra": "eles a cercam" },
        { "hebraico": "עַל־חֹומֹתֶ֑יהָ", "transliteral": "ʿal-ḥô-mô-ṯe-hā", "traducao_palavra": "sobre seus muros" },
        { "hebraico": "וְאָ֖וֶן", "transliteral": "wə-ʾā-wen", "traducao_palavra": "e iniquidade" },
        { "hebraico": "וְעָמָ֣ל", "transliteral": "wə-ʿā-māl", "traducao_palavra": "e malícia/sofrimento" },
        { "hebraico": "בְּקִרְבָּֽהּ׃", "transliteral": "bə-qir-bāh", "traducao_palavra": "no meio dela" }
      ]
    },
    "11": {
      "traducao_completa": "Maldade está no meio dela; opressão e engano não se apartam das suas ruas.",
      "palavras": [
        { "hebraico": "הַוֹּ֥ות", "transliteral": "haw-wôṯ", "traducao_palavra": "maldade/destruição" },
