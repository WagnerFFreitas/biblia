      ]
    },
    "13": {
      "traducao_completa": "Mas eras tu, homem meu igual, meu guia e meu amigo íntimo.",
      "palavras": [
        { "hebraico": "וְאַתָּ֥ה", "transliteral": "wə-ʾat-tā", "traducao_palavra": "mas tu" },
        { "hebraico": "אֱנֹ֥ושׁ", "transliteral": "ʾĕ-nôš", "traducao_palavra": "homem" },
        { "hebraico": "כְּעֶרְכִּ֑י", "transliteral": "kə-ʿer-kî", "traducao_palavra": "conforme minha avaliação/igual" },
        { "hebraico": "אַ֝לּוּפִ֗י", "transliteral": "ʾal-lû-p̄î", "traducao_palavra": "meu guia/líder" },
        { "hebraico": "וּמְיֻדָּעִֽי׃", "transliteral": "ū-mə-yud-dā-ʿî", "traducao_palavra": "e meu amigo íntimo" }
      ]
    },
    "14": {
      "traducao_completa": "Passávamos juntos suavemente os segredos e andávamos na casa de Deus com a multidão.",
      "palavras": [
        { "hebraico": "אֲשֶׁ֣ר", "transliteral": "ʾă-šer", "traducao_palavra": "que" },
        { "hebraico": "יַ֭חְדָּו", "transliteral": "yaḥ-dāw", "traducao_palavra": "juntamente" },
