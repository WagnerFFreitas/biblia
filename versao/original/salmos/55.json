        { "hebraico": "סֹ֑וד", "transliteral": "śôḏ", "traducao_palavra": "[o] segredo/conselho" },
        { "hebraico": "בְּבֵ֥ית", "transliteral": "bə-ḇêṯ", "traducao_palavra": "na casa de" },
        { "hebraico": "אֱ֝לֹהִ֗ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "Deus" },
        { "hebraico": "נְהַלֵּ֥ךְ", "transliteral": "nə-hal-lēḵ", "traducao_palavra": "andávamos" },
        { "hebraico": "בְּרָֽגֶשׁ׃", "transliteral": "bə-rā-ḡeš", "traducao_palavra": "com a multidão/emoção" }
      ]
    },
    "15": {
      "traducao_completa": "A morte os assalte, e vivos desçam ao Sheol; porque há maldade nas suas moradas e no seu íntimo.",
      "palavras": [
        { "hebraico": "יַשִּׁ֤י", "transliteral": "yaš-šî", "traducao_palavra": "assalte/enganará" },
        { "hebraico": "מָ֨וֶת ׀", "transliteral": "mā-weṯ", "traducao_palavra": "a morte" },
        { "hebraico": "עָלֵימֹו֮", "transliteral": "ʿā-lê-mô", "traducao_palavra": "sobre eles" },
        { "hebraico": "יֵרְד֖וּ", "transliteral": "yē-rə-ḏû", "traducao_palavra": "desçam" },
        { "hebraico": "שְׁאֹ֣ול", "transliteral": "šə-ʾôl", "traducao_palavra": "[ao] Sheol" },
        { "hebraico": "חַיִּ֑ים", "transliteral": "ḥay-yîm", "traducao_palavra": "vivos" },
        { "hebraico": "כִּֽי־רָעֹ֥ות", "transliteral": "kî-rā-ʿôṯ", "traducao_palavra": "pois maldades" },
        { "hebraico": "בִּמְגוּרָ֓ם", "transliteral": "bim-ḡû-rām", "traducao_palavra": "na morada deles" },
        { "hebraico": "בְּקִרְבָּֽם׃", "transliteral": "bə-qir-bām", "traducao_palavra": "no meio/íntimo deles" }
      ]
    },
    "16": {
      "traducao_completa": "Eu, porém, invocarei a Deus, e YHWH me salvará.",
      "palavras": [
        { "hebraico": "אֲ֭נִי", "transliteral": "ʾă-nî", "traducao_palavra": "eu" },
        { "hebraico": "אֶל־אֱלֹהִ֣ים", "transliteral": "ʾel-ʾĕ-lō-hîm", "traducao_palavra": "a Deus" },
