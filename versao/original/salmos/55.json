        { "hebraico": "כִּ֤י", "transliteral": "kî", "traducao_palavra": "pois" },
        { "hebraico": "לֹא־אֹויֵ֥ב", "transliteral": "lō-ʾô-yēḇ", "traducao_palavra": "não [um] inimigo" },
        { "hebraico": "יְחָרְפֵ֗נִי", "transliteral": "yə-ḥā-rə-p̄ē-nî", "traducao_palavra": "[que] me afrontava" },
        { "hebraico": "וְאֶשָּׂ֑א", "transliteral": "wə-ʾeś-śā", "traducao_palavra": "que [eu] suportaria" },
        { "hebraico": "לֹא־מְשַׂנְאִ֪י", "transliteral": "lō-mə-śan-ʾî", "traducao_palavra": "não [um] que me odeia" },
        { "hebraico": "עָלַ֥י", "transliteral": "ʿā-lay", "traducao_palavra": "contra mim" },
        { "hebraico": "הִגְדִּ֑יל", "transliteral": "hiḡ-dîl", "traducao_palavra": "se engrandeceu" },
        { "hebraico": "וְאֶסָּתֵ֥ר", "transliteral": "wə-ʾes-śā-ṯēr", "traducao_palavra": "que [eu] me esconderia" },
