        { "hebraico": "יֹושִׁיעֵֽנִי׃", "transliteral": "yô-šî-ʿē-nî", "traducao_palavra": "me salvará" }
      ]
    },
    "17": {
      "traducao_completa": "De tarde, de manhã e ao meio-dia orarei e gemerei; e ele ouvirá a minha voz.",
      "palavras": [
        { "hebraico": "עֶ֤רֶב", "transliteral": "ʿe-reḇ", "traducao_palavra": "tarde" },
        { "hebraico": "וָבֹ֨קֶר", "transliteral": "wā-ḇō-qer", "traducao_palavra": "e manhã" },
        { "hebraico": "וְצָהֳרַ֗יִם", "transliteral": "wə-ṣā-ho-ra-yim", "traducao_palavra": "e meio-dia" },
        { "hebraico": "אָשִׂ֥יחָה", "transliteral": "ʾā-śî-ḥā", "traducao_palavra": "meditarei/orarei" },
        { "hebraico": "וְאֶהֱמֶ֑ה", "transliteral": "wə-ʾe-hĕ-meh", "traducao_palavra": "e gemerei" },
        { "hebraico": "וַיִּשְׁמַ֥ע", "transliteral": "way-yiš-maʿ", "traducao_palavra": "e ele ouviu" },
        { "hebraico": "קֹולִֽי׃", "transliteral": "qô-lî", "traducao_palavra": "minha voz" }
      ]
    },
    "18": {
      "traducao_completa": "Livrou em paz a minha alma da peleja que havia contra mim; pois eram muitos os que me combatiam.",
      "palavras": [
        { "hebraico": "פָּדָ֨ה", "transliteral": "pā-ḏā", "traducao_palavra": "remiu/livrou" },
