        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "que" },
        { "hebraico": "אֱ֭לֹהִים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "Deus" },
        { "hebraico": "מֹשֵׁ֣ל", "transliteral": "mō-šēl", "traducao_palavra": "governa" },
        { "hebraico": "בְּיַעֲקֹ֑ב", "transliteral": "bə-ya-ʿă-qōḇ", "traducao_palavra": "em Jacó" },
        { "hebraico": "לְאַפְסֵ֖י", "transliteral": "lə-ʾap̄-śê", "traducao_palavra": "até os confins de" },
        { "hebraico": "הָאָ֣רֶץ", "transliteral": "hā-ʾā-reṣ", "traducao_palavra": "a terra" },
        { "hebraico": "סֶֽלָה׃", "transliteral": "se-lā", "traducao_palavra": "Selah" }
      ]
    },
    "14": {
      "traducao_completa": "E tornem a vir à tarde, e uivem como cães, e rodeiem a cidade.",
      "palavras": [
        { "hebraico": "וְיָשׁ֣וּבוּ", "transliteral": "wə-yā-šû-ḇû", "traducao_palavra": "e eles voltam" },
