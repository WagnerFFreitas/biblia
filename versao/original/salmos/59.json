      ]
    },
    "12": {
      "traducao_completa": "Pelo pecado da sua boca e pelas palavras dos seus lábios, fiquem presos na sua soberba, e pelas maldições e mentiras que proferem.",
      "palavras": [
        { "hebraico": "חַטַּאת־", "transliteral": "ḥaṭ-ṭaṯ-", "traducao_palavra": "pecado de" },
