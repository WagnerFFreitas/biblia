        { "hebraico": "דְּבַר־", "transliteral": "də-ḇar-", "traducao_palavra": "palavra de" },
        { "hebraico": "שְׂפָתֵ֪ימֹו", "transliteral": "śə-p̄ā-ṯê-mô", "traducao_palavra": "lábios deles" },
