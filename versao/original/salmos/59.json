{
  "livro": "Salmos - תְּהִלִּים - Tehillim",
  "capítulo": 59,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Livra-me dos meus inimigos, ó Deus meu; defende-me daqueles que se levantam contra mim.",
