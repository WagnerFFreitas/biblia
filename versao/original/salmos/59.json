        { "hebraico": "עֻ֭זֹּו", "transliteral": "ʿuz-zô", "traducao_palavra": "sua força" },
        { "hebraico": "אֵלֶ֣יךָ", "transliteral": "ʾê-le-ḵā", "traducao_palavra": "para ti" },
        { "hebraico": "אֶשְׁמֹ֑רָה", "transliteral": "ʾeš-mō-rā", "traducao_palavra": "eu aguardarei/vigiarei" },
