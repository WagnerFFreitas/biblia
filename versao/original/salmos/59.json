        { "hebraico": "חֲ֭רָבֹות", "transliteral": "ḥă-rā-ḇôṯ", "traducao_palavra": "espadas [estão]" },
        { "hebraico": "בְּשִׂפְתֹותֵיהֶ֑ם", "transliteral": "bə-śip̄-ṯô-ṯê-hem", "traducao_palavra": "em seus lábios" },
        { "hebraico": "כִּ֖י", "transliteral": "kî", "traducao_palavra": "porque [dizem]" },
        { "hebraico": "מִ֣י", "transliteral": "mî", "traducao_palavra": "quem" },
        { "hebraico": "שֹׁמֵֽעַ׃", "transliteral": "šō-mē-aʿ", "traducao_palavra": "ouve?" }
