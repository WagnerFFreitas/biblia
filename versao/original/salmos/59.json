        { "hebraico": "בִגְאֹונָ֑ם", "transliteral": "ḇiḡ-ʾô-nām", "traducao_palavra": "na soberba deles" },
        { "hebraico": "וּמֵאָלָ֖ה", "transliteral": "ū-mē-ʾā-lā", "traducao_palavra": "e pela maldição" },
        { "hebraico": "וּמִכַּ֣חַשׁ", "transliteral": "ū-mik-ka-ḥaš", "traducao_palavra": "e pela mentira" },
        { "hebraico": "יְסַפֵּֽרוּ׃", "transliteral": "yə-sap-pē-rû", "traducao_palavra": "que proferem" }
      ]
    },
    "13": {
      "traducao_completa": "Consome-os na tua indignação, consome-os, para que não existam mais; e saibam que Deus governa em Jacó até aos confins da terra. (Selah)",
      "palavras": [
        { "hebraico": "כַּלֵּ֥ה", "transliteral": "kal-lē", "traducao_palavra": "consome" },
        { "hebraico": "בְחֵמָה֮", "transliteral": "ḇə-ḥê-mā", "traducao_palavra": "em furor" },
        { "hebraico": "כַּלֵּ֪ה", "transliteral": "kal-lē", "traducao_palavra": "consome" },
        { "hebraico": "וְאֵ֫ינֵ֥מֹו", "transliteral": "wə-ʾê-nê-mô", "traducao_palavra": "e não [existam] mais" },
