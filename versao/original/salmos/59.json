      ]
    },
    "10": {
      "traducao_completa": "O meu Deus virá ao meu encontro com a sua misericórdia; Deus me fará ver o meu desejo sobre os meus inimigos.",
      "palavras": [
        { "hebraico": "אֱלֹהֵ֥י", "transliteral": "ʾĕ-lō-hê", "traducao_palavra": "Deus de" },
        { "hebraico": "חַסְדִּ֗י", "transliteral": "ḥaś-dî", "traducao_palavra": "minha misericórdia" },
        { "hebraico": "יְקַדְּמֵ֑נִי", "transliteral": "yə-qad-də-mē-nî", "traducao_palavra": "virá ao meu encontro" },
        { "hebraico": "אֱ֝לֹהִ֗ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "Deus" },
