        { "hebraico": "אֱלֹהָ֑י", "transliteral": "ʾĕ-lō-hāy", "traducao_palavra": "Deus meu" },
        { "hebraico": "מִמִּתְקֹומְמַ֥י", "transliteral": "mim-miṯ-qô-mə-may", "traducao_palavra": "daqueles que se levantam contra mim" },
        { "hebraico": "תְּשַׂגְּבֵֽנִי׃", "transliteral": "tə-śag-gə-ḇē-nî", "traducao_palavra": "põe-me no alto/defende-me" }
      ]
    },
    "2": {
      "traducao_completa": "Livra-me dos que praticam a iniquidade, e salva-me dos homens sanguinários.",
      "palavras": [
        { "hebraico": "הַ֭צִּילֵנִי", "transliteral": "haṣ-ṣî-lē-nî", "traducao_palavra": "livra-me" },
        { "hebraico": "מִפֹּ֣עֲלֵי", "transliteral": "mip-pō-ʿă-lê", "traducao_palavra": "dos praticantes de" },
        { "hebraico": "אָ֑וֶן", "transliteral": "ʾā-wen", "traducao_palavra": "iniquidade" },
        { "hebraico": "וּמֵאַנְשֵׁ֥י", "transliteral": "ū-mē-ʾan-šê", "traducao_palavra": "e de homens de" },
