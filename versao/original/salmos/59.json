        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "não [por]" },
        { "hebraico": "פִשְׁעִ֖י", "transliteral": "p̄iš-ʿî", "traducao_palavra": "minha transgressão" },
        { "hebraico": "וְלֹא־", "transliteral": "wə-lō-", "traducao_palavra": "e não [por]" },
        { "hebraico": "חַטָּאתִ֣י", "transliteral": "ḥaṭ-ṭā-ṯî", "traducao_palavra": "meu pecado" },
        { "hebraico": "יְהוָֽה׃", "transliteral": "YHWH", "traducao_palavra": "YHWH" }
      ]
    },
    "4": {
      "traducao_completa": "Eles correm, e se preparam, sem culpa minha; desperta para me ajudares, e olha.",
      "palavras": [
        { "hebraico": "בְּלִי־", "transliteral": "bə-lî-", "traducao_palavra": "sem" },
