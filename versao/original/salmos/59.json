    "3": {
      "traducao_completa": "Pois eis que armam ciladas à minha alma; os fortes se ajuntam contra mim, não por transgressão minha nem por pecado meu, YHWH.",
      "palavras": [
        { "hebraico": "כִּ֤י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "הִנֵּ֪ה", "transliteral": "hin-nēh", "traducao_palavra": "eis que" },
        { "hebraico": "אָרְב֨וּ", "transliteral": "ʾā-rə-ḇû", "traducao_palavra": "armaram ciladas" },
        { "hebraico": "לְנַפְשִׁ֗י", "transliteral": "lə-nap̄-šî", "traducao_palavra": "à minha alma" },
        { "hebraico": "יָג֭וּרוּ", "transliteral": "yā-ḡû-rû", "traducao_palavra": "ajuntam-se/conspiram" },
