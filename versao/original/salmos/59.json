        { "hebraico": "בְשֹׁרְרָֽי׃", "transliteral": "ḇə-šō-rə-rāy", "traducao_palavra": "nos meus inimigos" }
      ]
    },
    "11": {
      "traducao_completa": "Não os mates, para que o meu povo não se esqueça; espalha-os pelo teu poder e derruba-os, ó Senhor, escudo nosso.",
      "palavras": [
        { "hebraico": "אַל־", "transliteral": "ʾal-", "traducao_palavra": "não" },
        { "hebraico": "תַּהֲרְגֵ֬ם", "transliteral": "ta-hă-rə-ḡēm", "traducao_palavra": "mates eles" },
        { "hebraico": "פֶּן־", "transliteral": "pen-", "traducao_palavra": "para que não" },
        { "hebraico": "יִשְׁכְּח֪וּ", "transliteral": "yiš-kə-ḥû", "traducao_palavra": "esqueçam" },
        { "hebraico": "עַמִּ֡י", "transliteral": "ʿam-mî", "traducao_palavra": "meu povo" },
