        { "hebraico": "חֶ֝֗סֶד", "transliteral": "ḥe-seḏ", "traducao_palavra": "misericórdia" },
        { "hebraico": "יְסֹובְבֶֽנּוּ׃", "transliteral": "yə-śô-ḇə-ḇen-nû", "traducao_palavra": "o cercará" }
      ]
