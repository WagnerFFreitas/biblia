{
  "livro": "Salmos - תְּהִלִּים - Tehillim",
  "capítulo": 32,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "De Davi. Masquil. Bem-aventurado aquele cuja transgressão é perdoada, cujo pecado é coberto.",
      "palavras": [
        { "hebraico": "לְדָוִ֨ד", "transliteral": "lə-ḏā-wiḏ", "traducao_palavra": "de Davi" },
        { "hebraico": "מַשְׂכִּ֗יל", "transliteral": "maś-kîl", "traducao_palavra": "masquil [instrução]" },
        { "hebraico": "אַשְׁרֵ֥י", "transliteral": "ʾaš-rê", "traducao_palavra": "bem-aventurado" },
        { "hebraico": "נְשֽׁוּי־פֶּ֗שַׁע", "transliteral": "nə-śûy-pe-šaʿ", "traducao_palavra": "perdoado [de] transgressão" },
        { "hebraico": "כְּס֣וּי", "transliteral": "kə-śûy", "traducao_palavra": "coberto" },
        { "hebraico": "חֲטָאָֽה׃", "transliteral": "ḥă-ṭā-ʾā", "traducao_palavra": "[de] pecado" }
      ]
    },
    "2": {
      "traducao_completa": "Bem-aventurado o homem a quem YHWH não imputa iniquidade, e em cujo espírito não há engano.",
      "palavras": [
        { "hebraico": "אַ֥שְׁרֵי", "transliteral": "ʾaš-rê", "traducao_palavra": "bem-aventurado" },
        { "hebraico": "אָדָ֗ם", "transliteral": "ʾā-ḏām", "traducao_palavra": "[o] homem" },
        { "hebraico": "לֹ֤א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "יַחְשֹׁ֬ב", "transliteral": "yaḥ-šōḇ", "traducao_palavra": "imputa/calcula" },
        { "hebraico": "יְהוָ֣ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "לֹ֣ו", "transliteral": "lô", "traducao_palavra": "a ele" },
        { "hebraico": "עָוֹ֑ן", "transliteral": "ʿā-wōn", "traducao_palavra": "iniquidade" },
        { "hebraico": "וְאֵ֖ין", "transliteral": "wə-ʾên", "traducao_palavra": "e não há" },
        { "hebraico": "בְּרוּחֹ֣ו", "transliteral": "bə-rû-ḥô", "traducao_palavra": "no seu espírito" },
        { "hebraico": "רְמִיָּֽה׃", "transliteral": "rə-miy-yā", "traducao_palavra": "engano/fraude" }
      ]
    },
    "3": {
      "traducao_completa": "Enquanto guardei silêncio, consumiram-se os meus ossos pelo meu bramido todo o dia.",
      "palavras": [
        { "hebraico": "כִּֽי־הֶ֭חֱרַשְׁתִּי", "transliteral": "kî-he-ḥĕ-raš-tî", "traducao_palavra": "porque eu me calei" },
        { "hebraico": "בָּל֣וּ", "transliteral": "bā-lû", "traducao_palavra": "envelheceram/gastaram-se" },
        { "hebraico": "עֲצָמָ֑י", "transliteral": "ʿă-ṣā-may", "traducao_palavra": "meus ossos" },
        { "hebraico": "בְּ֝שַׁאֲגָתִ֗י", "transliteral": "bə-ša-ʾă-ḡā-ṯî", "traducao_palavra": "no meu bramido/rugido" },
        { "hebraico": "כָּל־הַיֹּֽום׃", "transliteral": "kāl-hay-yôm", "traducao_palavra": "todo o dia" }
      ]
    },
    "4": {
      "traducao_completa": "Porque de dia e de noite a tua mão pesava sobre mim; o meu vigor se tornou em sequidão de estio. (Selah)",
      "palavras": [
        { "hebraico": "כִּ֤י ׀", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "יֹומָ֣ם", "transliteral": "yôm-mām", "traducao_palavra": "de dia" },
        { "hebraico": "וָלַיְלָה֮", "transliteral": "wā-lay-lā", "traducao_palavra": "e de noite" },
        { "hebraico": "תִּכְבַּ֥ד", "transliteral": "tiḵ-baḏ", "traducao_palavra": "pesava" },
        { "hebraico": "עָלַ֗י", "transliteral": "ʿā-lay", "traducao_palavra": "sobre mim" },
        { "hebraico": "יָ֫דֶ֥ךָ", "transliteral": "yā-ḏe-ḵā", "traducao_palavra": "tua mão" },
        { "hebraico": "נֶהְפַּ֥ךְ", "transliteral": "neh-paḵ", "traducao_palavra": "foi virado/mudado" },
        { "hebraico": "לְשַׁדִּ֑י", "transliteral": "lə-šad-dî", "traducao_palavra": "meu vigor/suco" },
        { "hebraico": "בְּחַרְבֹֹנֵ֖י", "transliteral": "bə-ḥar-ḇō-nê", "traducao_palavra": "na secura de" },
        { "hebraico": "קַ֣יִץ", "transliteral": "qa-yiṣ", "traducao_palavra": "verão/estio" },
        { "hebraico": "סֶֽלָה׃", "transliteral": "se-lā", "traducao_palavra": "Selah [pausa]" }
      ]
    },
    "5": {
      "traducao_completa": "Confessei-te o meu pecado, e a minha iniquidade não encobri; disse: Confessarei a YHWH as minhas transgressões; e tu perdoaste a culpa do meu pecado. (Selah)",
      "palavras": [
        { "hebraico": "חַטָּאתִ֨י", "transliteral": "ḥaṭ-ṭā-ṯî", "traducao_palavra": "meu pecado" },
        { "hebraico": "אֹודִֽיעֲךָ֮", "transliteral": "ʾô-ḏî-ʿă-ḵā", "traducao_palavra": "fizeste saber/confessei" },
        { "hebraico": "וַעֲוֹ֘נִ֤י", "transliteral": "wa-ʿă-wō-nî", "traducao_palavra": "e minha iniquidade" },
        { "hebraico": "לֹֽא־כִסִּ֗יתִי", "transliteral": "lō-ḵis-śî-ṯî", "traducao_palavra": "não cobri" },
        { "hebraico": "אָמַ֗רְתִּי", "transliteral": "ʾā-mar-tî", "traducao_palavra": "disse" },
        { "hebraico": "אֹ֘ודֶ֤ה", "transliteral": "ʾô-ḏeh", "traducao_palavra": "confessarei" },
        { "hebraico": "עֲלֵ֣י", "transliteral": "ʿă-lê", "traducao_palavra": "sobre" },
        { "hebraico": "פְ֭שָׁעַי", "transliteral": "p̄ə-šā-ʿay", "traducao_palavra": "minhas transgressões" },
        { "hebraico": "לַיהוָ֑ה", "transliteral": "lay-hwāh", "traducao_palavra": "a YHWH" },
        { "hebraico": "וְאַתָּ֨ה", "transliteral": "wə-ʾat-tā", "traducao_palavra": "e tu" },
        { "hebraico": "נָ֘שָׂ֤אתָ", "transliteral": "nā-śā-ṯā", "traducao_palavra": "perdoaste/levantaste" },
        { "hebraico": "עֲוֹ֖ן", "transliteral": "ʿă-wōn", "traducao_palavra": "[a] iniquidade de" },
        { "hebraico": "חַטָּאתִ֣י", "transliteral": "ḥaṭ-ṭā-ṯî", "traducao_palavra": "meu pecado" },
        { "hebraico": "סֶֽלָה׃", "transliteral": "se-lā", "traducao_palavra": "Selah" }
      ]
    },
    "6": {
      "traducao_completa": "Pelo que todo aquele que é piedoso orará a ti, a tempo de te poder achar; certamente, no trasbordar de muitas águas, estas não o atingirão.",
      "palavras": [
        { "hebraico": "עַל־זֹ֡את", "transliteral": "ʿal-zōṯ", "traducao_palavra": "por isso" },
        { "hebraico": "יִתְפַּלֵּ֬ל", "transliteral": "yiṯ-pal-lēl", "traducao_palavra": "orará" },
        { "hebraico": "כָּל־חָסִ֨יד ׀", "transliteral": "kāl-ḥā-śîḏ", "traducao_palavra": "todo piedoso/santo" },
        { "hebraico": "אֵלֶיךָ֮", "transliteral": "ʾē-le-ḵā", "traducao_palavra": "a ti" },
        { "hebraico": "לְעֵ֪ת", "transliteral": "lə-ʿēṯ", "traducao_palavra": "no tempo de" },
        { "hebraico": "מְ֫צֹ֥א", "transliteral": "mə-ṣō", "traducao_palavra": "achar" },
        { "hebraico": "רַק֮", "transliteral": "raq", "traducao_palavra": "somente/certamente" },
        { "hebraico": "לְשֵׁ֨טֶף ׀", "transliteral": "lə-šē-ṭep̄", "traducao_palavra": "no transbordar de" },
        { "hebraico": "מַ֥יִם", "transliteral": "ma-yim", "traducao_palavra": "águas" },
        { "hebraico": "רַבִּ֗ים", "transliteral": "rab-bîm", "traducao_palavra": "muitas" },
        { "hebraico": "אֵלָ֥יו", "transliteral": "ʾē-lāw", "traducao_palavra": "a ele" },
        { "hebraico": "לֹא־יַגִּֽיעוּ׃", "transliteral": "lō-yag-gî-ʿû", "traducao_palavra": "não atingirão" }
      ]
    },
    "7": {
      "traducao_completa": "Tu és o meu esconderijo; tu me preservas da angústia; tu me cercas de cânticos de livramento. (Selah)",
      "palavras": [
        { "hebraico": "אַתָּ֤ה ׀", "transliteral": "ʾat-tā", "traducao_palavra": "tu [és]" },
        { "hebraico": "סֵ֣תֶר", "transliteral": "śê-ṯer", "traducao_palavra": "[o] esconderijo" },
        { "hebraico": "לִ֭י", "transliteral": "lî", "traducao_palavra": "para mim" },
        { "hebraico": "מִצַּ֣ר", "transliteral": "miṣ-ṣar", "traducao_palavra": "da angústia" },
        { "hebraico": "תִּצְּרֵ֑נִי", "transliteral": "tiṣ-ṣə-rē-nî", "traducao_palavra": "tu me guardarás/preservarás" },
        { "hebraico": "רָנֵּ֥י", "transliteral": "ron-nê", "traducao_palavra": "cânticos de" },
        { "hebraico": "פַ֝לֵּ֗ט", "transliteral": "pal-lēṭ", "traducao_palavra": "livramento" },
        { "hebraico": "תְּסֹובְבֵ֥נִי", "transliteral": "tə-śô-ḇə-ḇē-nî", "traducao_palavra": "tu me cercarás" },
        { "hebraico": "סֶֽלָה׃", "transliteral": "se-lā", "traducao_palavra": "Selah" }
      ]
    },
    "8": {
      "traducao_completa": "Instruir-te-ei e ensinar-te-ei o caminho que deves seguir; guiar-te-ei com os meus olhos.",
      "palavras": [
        { "hebraico": "אַשְׂכִּֽילְךָ֨ ׀", "transliteral": "ʾaś-kî-lə-ḵā", "traducao_palavra": "eu te instruirei" },
        { "hebraico": "וְאֹורְךָ֮", "transliteral": "wə-ʾô-rə-ḵā", "traducao_palavra": "e te ensinarei" },
        { "hebraico": "בְּדֶֽרֶךְ־ז֪וּ", "transliteral": "bə-ḏe-reḵ-zû", "traducao_palavra": "no caminho que" },
        { "hebraico": "תֵ֫לֵ֥ךְ", "transliteral": "tê-lēḵ", "traducao_palavra": "tu andarás" },
        { "hebraico": "אִֽיעֲצָ֖ה", "transliteral": "ʾî-ʿă-ṣā", "traducao_palavra": "aconselharei" },
        { "hebraico": "עָלֶ֣יךָ", "transliteral": "ʿā-le-ḵā", "traducao_palavra": "sobre ti" },
        { "hebraico": "עֵינִֽי׃", "transliteral": "ʿê-nî", "traducao_palavra": "[com] meu olho" }
      ]
    },
    "9": {
      "traducao_completa": "Não sejais como o cavalo, nem como a mula, que não têm entendimento, cuja boca precisa de cabresto e freio para que não se cheguem a ti.",
      "palavras": [
        { "hebraico": "אַל־תִּהְי֤וּ ׀", "transliteral": "ʾal-tih-yû", "traducao_palavra": "não sejais" },
        { "hebraico": "כְּס֥וּס", "transliteral": "kə-śûś", "traducao_palavra": "como cavalo" },
        { "hebraico": "כְּפֶרֶד֮", "transliteral": "kə-p̄e-reḏ", "traducao_palavra": "[ou] como mula" },
        { "hebraico": "אֵ֤ין", "transliteral": "ʾên", "traducao_palavra": "[que] não há [neles]" },
        { "hebraico": "הָ֫ב֥ין", "transliteral": "hā-ḇîn", "traducao_palavra": "entendimento" },
        { "hebraico": "בְּמֶֽתֶג־וָרֶ֭סֶן", "transliteral": "bə-me-ṯeḡ-wā-re-sen", "traducao_palavra": "com freio e rédea" },
        { "hebraico": "עֶדְיֹ֣ו", "transliteral": "ʿeḏ-yô", "traducao_palavra": "seu ornamento/equipamento" },
        { "hebraico": "לִבְלֹ֑ום", "transliteral": "li-ḇəlôm", "traducao_palavra": "para frear" },
        { "hebraico": "בַּ֝ל", "transliteral": "bal", "traducao_palavra": "para não" },
        { "hebraico": "קְרֹ֥ב", "transliteral": "qə-rōḇ", "traducao_palavra": "se aproximar" },
        { "hebraico": "אֵלֶֽיךָ׃", "transliteral": "ʾē-le-ḵā", "traducao_palavra": "a ti" }
      ]
    },
    "10": {
      "traducao_completa": "Muitos sofrimentos terá o ímpio, mas aquele que confia em YHWH, a misericórdia o cercará.",
      "palavras": [
        { "hebraico": "רַבִּ֥ים", "transliteral": "rab-bîm", "traducao_palavra": "muitos" },
        { "hebraico": "מַכְאֹובִ֗ים", "transliteral": "maḵ-ʾô-ḇîm", "traducao_palavra": "sofrimentos/dores" },
        { "hebraico": "לָרָ֫שָׁ֥ע", "transliteral": "lā-rā-šāʿ", "traducao_palavra": "para o ímpio" },
        { "hebraico": "וְהַבֹּוטֵ֥חַ", "transliteral": "wə-hab-bô-ṭē-aḥ", "traducao_palavra": "mas o que confia" },
