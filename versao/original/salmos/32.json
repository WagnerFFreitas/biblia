    "11": {
      "traducao_completa": "Alegrai-vos em YHWH e regozijai-vos, vós justos; e cantai de júbilo, todos vós que sois retos de coração.",
      "palavras": [
        { "hebraico": "שִׂמְח֧וּ", "transliteral": "śim-ḥû", "traducao_palavra": "alegrai-vos" },
        { "hebraico": "בַיהוָ֣ה", "transliteral": "bay-hwāh", "traducao_palavra": "em YHWH" },
        { "hebraico": "וְ֝גִילוּ", "transliteral": "wə-ḡî-lû", "traducao_palavra": "e exultai/regozijai-vos" },
        { "hebraico": "צַדִּיקִ֑ים", "transliteral": "ṣad-dî-qîm", "traducao_palavra": "ó justos" },
        { "hebraico": "וְ֝הַרְנִ֗ינוּ", "transliteral": "wə-har-nî-nû", "traducao_palavra": "e gritai de alegria" },
        { "hebraico": "כָּל־יִשְׁרֵי־לֵֽב׃", "transliteral": "kāl-yiš-rê-lêḇ", "traducao_palavra": "todos retos de coração" }
