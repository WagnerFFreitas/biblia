  "versiculos": {
    "1": {
      "traducao_completa": "Ao mestre de canto. Salmo de Davi. Até quando, YHWH, te esquecerás de mim para sempre? Até quando esconderás de mim a tua face?",
      "palavras": [
        { "hebraico": "לַמְנַצֵּ֗חַ", "transliteral": "lam-naṣ-ṣē-aḥ", "traducao_palavra": "ao mestre de canto" },
        { "hebraico": "מִזְמֹ֥ור", "transliteral": "miz-môr", "traducao_palavra": "salmo" },
        { "hebraico": "לְדָוִֽד", "transliteral": "lə-ḏā-wiḏ", "traducao_palavra": "de Davi" },
        { "hebraico": "עַד־אָ֣נָה", "transliteral": "ʿaḏ-ʾā-nā", "traducao_palavra": "até quando" },
        { "hebraico": "יְהוָה֮", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "תִּשְׁכָּחֵ֪נִי", "transliteral": "tiš-kā-ḥê-nî", "traducao_palavra": "esquecer-me-ás" },
        { "hebraico": "נֶ֥צַח", "transliteral": "ne-ṣaḥ", "traducao_palavra": "para sempre" },
        { "hebraico": "עַד־אָ֓נָה", "transliteral": "ʿaḏ-ʾā-nā", "traducao_palavra": "até quando" },
        { "hebraico": "תַּסְתִּ֖יר", "transliteral": "tas-tîr", "traducao_palavra": "esconderás" },
        { "hebraico": "אֶת־פָּנֶ֣יךָ", "transliteral": "ʾeṯ-pā-ne-ḵā", "traducao_palavra": "tua face" },
        { "hebraico": "מִמֶּֽנִּי׃", "transliteral": "mim-men-nî", "traducao_palavra": "de mim" }
      ]
    },
    "2": {
      "traducao_completa": "Até quando terei inquietações em minha alma, com tristeza no meu coração cada dia? Até quando se exaltará o meu inimigo sobre mim?",
      "palavras": [
        { "hebraico": "עַד־אָ֨נָה", "transliteral": "ʿaḏ-ʾā-nā", "traducao_palavra": "até quando" },
        { "hebraico": "אָשִׁ֪ית", "transliteral": "ʾā-šîṯ", "traducao_palavra": "porei/terei" },
        { "hebraico": "עֵצֹ֡ות", "transliteral": "ʿê-ṣôṯ", "traducao_palavra": "conselhos/inquietações" },
        { "hebraico": "בְּנַפְשִׁ֗י", "transliteral": "bə-nap̄-šî", "traducao_palavra": "em minha alma" },
        { "hebraico": "יָגֹ֣ון", "transliteral": "yā-ḡôn", "traducao_palavra": "[com] tristeza" },
        { "hebraico": "בִּלְבָבִ֣i", "transliteral": "bil-ḇā-ḇî", "traducao_palavra": "em meu coração" },
        { "hebraico": "יֹומָ֑ם", "transliteral": "yô-mām", "traducao_palavra": "de dia/diariamente" },
        { "hebraico": "עַד־אָ֓נָה", "transliteral": "ʿaḏ-ʾā-nā", "traducao_palavra": "até quando" },
        { "hebraico": "יָר֖וּם", "transliteral": "yā-rûm", "traducao_palavra": "se exaltará" },
        { "hebraico": "אֹיְבִ֣י", "transliteral": "ʾō-yə-ḇî", "traducao_palavra": "meu inimigo" },
        { "hebraico": "עָלָֽי׃", "transliteral": "ʿā-lāy", "traducao_palavra": "sobre mim" }
      ]
    },
    "3": {
      "traducao_completa": "Olha, responde-me, YHWH, meu Deus; ilumina os meus olhos, para que eu não durma o sono da morte;",
      "palavras": [
        { "hebraico": "הַבִּ֨יטָה", "transliteral": "hab-bî-ṭā", "traducao_palavra": "olha/atenta" },
