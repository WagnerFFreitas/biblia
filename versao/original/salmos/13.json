        { "hebraico": "כִּ֣י", "transliteral": "kî", "traducao_palavra": "quando" },
        { "hebraico": "אֶמֹּֽוט׃", "transliteral": "ʾem-môṭ", "traducao_palavra": "eu for abalado/vacilar" }
