    "4": {
      "traducao_completa": "Para que o meu inimigo não diga: Prevaleci contra ele; e os meus adversários não se alegrem, vindo eu a vacilar.",
      "palavras": [
        { "hebraico": "פֶּן־יֹאמַ֣ר", "transliteral": "pen-yō-mar", "traducao_palavra": "para que não diga" },
        { "hebraico": "אֹיְבִ֣י", "transliteral": "ʾō-yə-ḇî", "traducao_palavra": "meu inimigo" },
        { "hebraico": "יְכָלְתִּ֑יו", "transliteral": "yə-ḵā-lə-tîw", "traducao_palavra": "prevaleci contra ele" },
        { "hebraico": "צָרַ֥י", "transliteral": "ṣā-ray", "traducao_palavra": "meus adversários" },
