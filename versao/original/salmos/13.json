        { "hebraico": "יְהוָ֪ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "אֱלֹ֫הָ֥י", "transliteral": "ʾĕ-lō-hāy", "traducao_palavra": "meu Deus" },
        { "hebraico": "הָאִ֥ירָה", "transliteral": "hā-ʾî-rā", "traducao_palavra": "ilumina" },
        { "hebraico": "עֵינַ֑י", "transliteral": "ʿê-nay", "traducao_palavra": "meus olhos" },
        { "hebraico": "פֶּן־אִישַׁ֥ן", "transliteral": "pen-ʾî-šan", "traducao_palavra": "para que não durma" },
