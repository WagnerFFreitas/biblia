    "5": {
      "traducao_completa": "Mas eu confio na tua misericórdia; o meu coração se regozijará na tua salvação.",
      "palavras": [
        { "hebraico": "וַאֲנִ֤י", "transliteral": "wa-ʾă-nî", "traducao_palavra": "mas eu" },
        { "hebraico": "בְּחַסְדְּךָ֣", "transliteral": "bə-ḥas-də-ḵā", "traducao_palavra": "na tua misericórdia/bondade" },
        { "hebraico": "בָטַחְתִּי֮", "transliteral": "ḇā-ṭaḥ-tî", "traducao_palavra": "confio/confiei" },
        { "hebraico": "יָ֤גֵ֥ל", "transliteral": "yā-ḡēl", "traducao_palavra": "se regozijará" },
        { "hebraico": "לִבִּ֗י", "transliteral": "lib-bî", "traducao_palavra": "meu coração" },
        { "hebraico": "בִּֽישׁוּעָ֫תֶ֥ךָ", "transliteral": "bî-šû-ʿā-ṯe-ḵā", "traducao_palavra": "na tua salvação" }
      ]
    },
    "6": {
      "traducao_completa": "Cantarei a YHWH, porquanto me tem feito muito bem.",
