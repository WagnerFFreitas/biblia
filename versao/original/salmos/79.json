{
  "livro": "Salmos - תְּהִלִּים - Tehillim",
  "capítulo": 79,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Salmo de Asafe. Ó Deus, as nações entraram na tua herança; contaminaram o teu santo templo; reduziram Jerusalém a montões de pedras.",
