        { "hebraico": "תֶּאֱנַ֣ף", "transliteral": "te-ʾĕ-nap̄", "traducao_palavra": "te irarás" },
        { "hebraico": "לָנֶ֑צַח", "transliteral": "lā-ne-ṣaḥ", "traducao_palavra": "para sempre" },
        { "hebraico": "תִּבְעַ֥ר", "transliteral": "tiḇ-ʿar", "traducao_palavra": "arderá" },
