        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "יְדָ֫ע֥וּךָ", "transliteral": "yə-ḏā-ʿû-ḵā", "traducao_palavra": "conhecem te" },
