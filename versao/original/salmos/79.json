        { "hebraico": "אֵ֝שׁ", "transliteral": "ʾēš", "traducao_palavra": "fogo" },
        { "hebraico": "קִנְאָתֶֽךָ׃", "transliteral": "qin-ʾā-ṯe-ḵā", "traducao_palavra": "teu zelo/ciúme" }
      ]
    },
    "6": {
      "traducao_completa": "Derrama a tua indignação sobre as nações que te não conhecem, e sobre os reinos que não invocam o teu nome.",
      "palavras": [
        { "hebraico": "שְׁפֹ֬ךְ", "transliteral": "šə-p̄ōḵ", "traducao_palavra": "derrama" },
