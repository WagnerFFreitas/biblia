    "9": {
      "traducao_completa": "Ajuda-nos, ó Deus da nossa salvação, pela glória do teu nome; e livra-nos, e expia os nossos pecados por amor do teu nome.",
      "palavras": [
        { "hebraico": "עָזְרֵ֤נוּ", "transliteral": "ʿā-zə-rē-nû", "traducao_palavra": "ajuda-nos" },
        { "hebraico": "אֱלֹהֵ֬י", "transliteral": "ʾĕ-lō-hê", "traducao_palavra": "ó Deus de" },
        { "hebraico": "יִשְׁעֵ֗נוּ", "transliteral": "yiš-ʿē-nû", "traducao_palavra": "nossa salvação" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "por causa de/sobre" },
        { "hebraico": "דְּבַ֥ר", "transliteral": "də-ḇar", "traducao_palavra": "assunto/causa de" },
        { "hebraico": "כְּבֹוד־", "transliteral": "kə-ḇôḏ-", "traducao_palavra": "a glória de" },
        { "hebraico": "שְׁמֶ֑ךָ", "transliteral": "šə-me-ḵā", "traducao_palavra": "teu nome" },
        { "hebraico": "וְהַצִּילֵ֥נוּ", "transliteral": "wə-haṣ-ṣî-lē-nû", "traducao_palavra": "e livra-nos" },
