        { "hebraico": "תִּזְכָּר־", "transliteral": "tiz-kār-", "traducao_palavra": "te lembres" },
        { "hebraico": "לָנוּ֮", "transliteral": "lā-nû", "traducao_palavra": "contra nós" },
        { "hebraico": "עֲוֹנֹ֪ת", "transliteral": "ʿă-wō-nōṯ", "traducao_palavra": "iniquidades de" },
        { "hebraico": "רִאשֹׁ֫נִ֥ים", "transliteral": "ri-šō-nîm", "traducao_palavra": "antepassados/primeiros" },
