        { "hebraico": "הֵיכַ֣ל", "transliteral": "hê-ḵal", "traducao_palavra": "[o] templo de" },
        { "hebraico": "קָדְשֶׁ֑ךָ", "transliteral": "qāḏ-še-ḵā", "traducao_palavra": "tua santidade" },
        { "hebraico": "שָׂ֖מוּ", "transliteral": "śā-mû", "traducao_palavra": "puseram/reduziram" },
        { "hebraico": "אֶת־", "transliteral": "ʾeṯ-", "traducao_palavra": "[objeto]" },
        { "hebraico": "יְרוּשָׁלִַ֣ם", "transliteral": "yə-rû-šā-la-im", "traducao_palavra": "Jerusalém" },
