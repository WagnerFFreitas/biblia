    "3": {
      "traducao_completa": "Derramaram o sangue deles como água ao redor de Jerusalém, e não houve quem os enterrasse.",
      "palavras": [
        { "hebraico": "שָׁפְכ֬וּ", "transliteral": "šā-p̄ə-ḵû", "traducao_palavra": "derramaram" },
