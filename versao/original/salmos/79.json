        { "hebraico": "אֲשֶׁ֥ר", "transliteral": "ʾă-šer", "traducao_palavra": "que" },
        { "hebraico": "בְּ֝שִׁמְךָ֗", "transliteral": "bə-šim-ḵā", "traducao_palavra": "no teu nome" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "קָרָֽאוּ׃", "transliteral": "qā-rā-ʾû", "traducao_palavra": "invocaram" }
