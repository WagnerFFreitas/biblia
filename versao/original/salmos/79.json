    "4": {
      "traducao_completa": "Tornamo-nos o opróbrio dos nossos vizinhos, o escárnio e a zombaria dos que estão ao redor de nós.",
      "palavras": [
        { "hebraico": "הָיִ֣ינוּ", "transliteral": "hā-yî-nû", "traducao_palavra": "fomos/tornamo-nos" },
        { "hebraico": "חֶ֭רְפָּה", "transliteral": "ḥer-pā", "traducao_palavra": "opróbrio" },
        { "hebraico": "לִשְׁכֵנֵ֑ינוּ", "transliteral": "liš-ḵê-nê-nû", "traducao_palavra": "para nossos vizinhos" },
