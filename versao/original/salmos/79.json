        { "hebraico": "חַטֹּאתֵ֗ינוּ", "transliteral": "ḥaṭ-ṭō-ṯê-nû", "traducao_palavra": "nossos pecados" },
        { "hebraico": "לְמַ֣עַן", "transliteral": "lə-ma-ʿan", "traducao_palavra": "por amor de/por causa de" },
        { "hebraico": "שְׁמֶֽךָ׃", "transliteral": "šə-me-ḵā", "traducao_palavra": "teu nome" }
      ]
    },
    "10": {
      "traducao_completa": "Por que diriam as nações: Onde está o seu Deus? Torne-se notória entre as nações, à nossa vista, a vingança do sangue derramado dos teus servos.",
      "palavras": [
        { "hebraico": "לָ֤מָּה", "transliteral": "lām-mā", "traducao_palavra": "por que" },
        { "hebraico": "יֹ֘אמְר֤וּ", "transliteral": "yō-mə-rû", "traducao_palavra": "diriam" },
        { "hebraico": "הַגֹּויִם֮", "transliteral": "hag-gô-yim", "traducao_palavra": "as nações" },
        { "hebraico": "אַיֵּ֪ה", "transliteral": "ʾay-yēh", "traducao_palavra": "onde [está]" },
        { "hebraico": "אֱלֹהֵ֫יהֶ֥ם", "transliteral": "ʾĕ-lō-hê-hem", "traducao_palavra": "Deus deles" },
        { "hebraico": "יִוָּדַ֣ע", "transliteral": "yiw-wā-ḏaʿ", "traducao_palavra": "seja conhecido" },
        { "hebraico": "בַּגֹּויִ֣ם", "transliteral": "bag-gô-yim", "traducao_palavra": "nas nações" },
        { "hebraico": "לְעֵינֵ֑ינוּ", "transliteral": "lə-ʿê-nê-nû", "traducao_palavra": "aos nossos olhos" },
        { "hebraico": "נִ֝קְמַ֗ת", "transliteral": "niq-maṯ", "traducao_palavra": "[a] vingança de" },
        { "hebraico": "דַּם־", "transliteral": "dam-", "traducao_palavra": "sangue de" },
        { "hebraico": "עֲבָדֶ֥יךָ", "transliteral": "ʿă-ḇā-ḏey-ḵā", "traducao_palavra": "teus servos" },
        { "hebraico": "הַשָּׁפֽוּךְ׃", "transliteral": "haš-šā-p̄ûḵ", "traducao_palavra": "que foi derramado" }
      ]
    },
    "11": {
      "traducao_completa": "Venha perante a tua face o gemido dos presos; segundo a grandeza do teu braço, preserva os que estão sentenciados à morte.",
      "palavras": [
        { "hebraico": "תָּ֤בֹ֣וא", "transliteral": "tā-ḇô", "traducao_palavra": "venha" },
        { "hebraico": "לְפָנֶיךָ֮", "transliteral": "lə-p̄ā-ne-ḵā", "traducao_palavra": "perante ti" },
        { "hebraico": "אֶנְקַ֪ת", "transliteral": "ʾen-qaṯ", "traducao_palavra": "[o] gemido de" },
        { "hebraico": "אָ֫סִ֥יר", "transliteral": "ʾā-śîr", "traducao_palavra": "[o] preso" },
        { "hebraico": "כְּגֹ֣דֶל", "transliteral": "kə-ḡō-ḏel", "traducao_palavra": "segundo a grandeza de" },
        { "hebraico": "זְרֹועֲךָ֑", "transliteral": "zə-rô-ʿă-ḵā", "traducao_palavra": "teu braço" },
        { "hebraico": "הֹ֝ותֵ֗ר", "transliteral": "hô-ṯēr", "traducao_palavra": "preserva/deixa sobrar" },
        { "hebraico": "בְּנֵ֣י", "transliteral": "bə-nê", "traducao_palavra": "filhos de" },
        { "hebraico": "תְמוּתָֽה׃", "transliteral": "ṯə-mû-ṯā", "traducao_palavra": "morte" }
      ]
    },
    "12": {
      "traducao_completa": "E retribui aos nossos vizinhos, sete vezes tanto no seu seio, a afronta com que te afrontaram, Senhor.",
      "palavras": [
        { "hebraico": "וְהָ֘שֵׁ֤ב", "transliteral": "wə-hā-šēḇ", "traducao_palavra": "e retribui/devolve" },
        { "hebraico": "לִשְׁכֵנֵ֤ינוּ", "transliteral": "liš-ḵē-nê-nû", "traducao_palavra": "aos nossos vizinhos" },
        { "hebraico": "שִׁבְעָתַ֨יִם", "transliteral": "šiḇ-ʿā-ṯa-yim", "traducao_palavra": "sete vezes" },
        { "hebraico": "אֶל־", "transliteral": "ʾel-", "traducao_palavra": "para/em" },
        { "hebraico": "חֵיקָ֑ם", "transliteral": "ḥê-qām", "traducao_palavra": "seio deles" },
        { "hebraico": "חֶרְפָּתָ֨ם", "transliteral": "ḥer-pā-ṯām", "traducao_palavra": "a afronta deles" },
        { "hebraico": "אֲשֶׁ֫ר", "transliteral": "ʾă-šer", "traducao_palavra": "que" },
        { "hebraico": "חֵרֲפ֥וּךָ", "transliteral": "ḥê-ră-p̄û-ḵā", "traducao_palavra": "afrontaram te" },
        { "hebraico": "אֲדֹנָֽי׃", "transliteral": "ʾă-ḏō-nāy", "traducao_palavra": "Senhor" }
      ]
    },
    "13": {
      "traducao_completa": "Assim nós, teu povo e ovelhas do teu pasto, te louvaremos eternamente; de geração em geração cantaremos os teus louvores.",
      "palavras": [
        { "hebraico": "וַאֲנַ֤חְנוּ", "transliteral": "wa-ʾă-naḥ-nû", "traducao_palavra": "e nós" },
        { "hebraico": "עַמְּךָ֨", "transliteral": "ʿam-mə-ḵā", "traducao_palavra": "teu povo" },
        { "hebraico": "וְצֹ֥אן", "transliteral": "wə-ṣōn", "traducao_palavra": "e ovelhas de" },
        { "hebraico": "מַרְעִיתֶךָ֮", "transliteral": "mar-ʿî-ṯe-ḵā", "traducao_palavra": "teu pasto" },
