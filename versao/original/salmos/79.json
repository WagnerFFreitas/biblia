        { "hebraico": "אֶת־", "transliteral": "ʾeṯ-", "traducao_palavra": "[objeto]" },
        { "hebraico": "נִבְלַ֬ת", "transliteral": "niḇ-laṯ", "traducao_palavra": "[o] cadáver de" },
        { "hebraico": "עֲבָדֶ֗יךָ", "transliteral": "ʿă-ḇā-ḏey-ḵā", "traducao_palavra": "teus servos" },
