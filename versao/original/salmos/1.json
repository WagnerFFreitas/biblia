        { "hebraico": "צַדִּיקִ֑ים", "transliteral": "ṣad-dî-qîm", "traducao_palavra": "justos" },
        { "hebraico": "וְדֶ֖רֶךְ", "transliteral": "wə-ḏe-reḵ", "traducao_palavra": "mas o caminho de" },
