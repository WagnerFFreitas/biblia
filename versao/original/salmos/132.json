    "9": {
      "traducao_completa": "Vistam-se os teus sacerdotes de justiça, e os teus santos jubilem.",
      "palavras": [
        { "hebraico": "כֹּהֲנֶ֥יךָ", "transliteral": "kōhăneyḵā", "traducao_palavra": "teus sacerdotes" },
