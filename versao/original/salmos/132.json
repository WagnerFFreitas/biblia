    "2": {
      "traducao_completa": "Como jurou a YHWH, e fez votos ao Poderoso de Jacó,",
      "palavras": [
        { "hebraico": "אֲשֶׁ֣ר", "transliteral": "ʾăšer", "traducao_palavra": "que" },
        { "hebraico": "נִ֭שְׁבַּע", "transliteral": "nišbaʿ", "traducao_palavra": "jurou" },
        { "hebraico": "לַֽיהוָ֑ה", "transliteral": "layhwāh", "traducao_palavra": "a YHWH" },
        { "hebraico": "נָ֝דַ֗ר", "transliteral": "nāḏar", "traducao_palavra": "fez voto" },
        { "hebraico": "לַאֲבִ֥יר", "transliteral": "laʾăḇîr", "traducao_palavra": "ao Poderoso de" },
        { "hebraico": "יַעֲקֹֽב׃", "transliteral": "yaʿăqōḇ", "traducao_palavra": "Jacó" }
      ]
    },
    "3": {
      "traducao_completa": "Não entrarei na tenda da minha casa, nem subirei ao leito do meu repouso;",
      "palavras": [
