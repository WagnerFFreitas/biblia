    "12": {
      "traducao_completa": "Se os teus filhos guardarem a minha aliança e os meus testemunhos, que eu lhes hei de ensinar, também os seus filhos se assentarão para sempre no teu trono.",
      "palavras": [
        { "hebraico": "אִֽם־", "transliteral": "ʾim-", "traducao_palavra": "se" },
        { "hebraico": "יִשְׁמְר֧וּ", "transliteral": "yiš-mə-rû", "traducao_palavra": "guardarem" },
        { "hebraico": "בָנֶ֨יךָ", "transliteral": "ḇā-ne-ḵā", "traducao_palavra": "filhos teus" },
        { "hebraico": "בְּרִיתִ֗י", "transliteral": "bə-rî-ṯî", "traducao_palavra": "minha aliança" },
