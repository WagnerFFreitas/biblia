        { "hebraico": "אַל־", "transliteral": "ʾal-", "traducao_palavra": "não" },
        { "hebraico": "תָּ֝שֵׁ֗ב", "transliteral": "tā-šēḇ", "traducao_palavra": "vires/rejeites" },
