        { "hebraico": "צֶ֑דֶק", "transliteral": "ṣedeq", "traducao_palavra": "justiça" },
        { "hebraico": "וַחֲסִידֶ֥יךָ", "transliteral": "waḥăśîḏeyḵā", "traducao_palavra": "e teus santos" },
        { "hebraico": "יְרַנֵּֽנוּ׃", "transliteral": "yərannēnû", "traducao_palavra": "cantem de júbilo" }
