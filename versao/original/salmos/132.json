        { "hebraico": "מְ֝צָאנ֗וּהָ", "transliteral": "məṣāʾnûhā", "traducao_palavra": "achamos ela" },
        { "hebraico": "בִּשְׂדֵי־", "transliteral": "biśḏê-", "traducao_palavra": "nos campos de" },
