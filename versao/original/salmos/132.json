    },
    "10": {
      "traducao_completa": "Por amor de Davi, teu servo, não vires o rosto do teu ungido.",
      "palavras": [
        { "hebraico": "בַּ֝עֲב֗וּר", "transliteral": "ba-ʿă-ḇûr", "traducao_palavra": "por causa de/amor de" },
