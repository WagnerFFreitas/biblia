        { "hebraico": "נִ֝שְׁתַּחֲוֶ֗ה", "transliteral": "ništaḥăweh", "traducao_palavra": "adoraremos" },
        { "hebraico": "לַהֲדֹ֥ם", "transliteral": "lahăḏōm", "traducao_palavra": "ao estrado/escabelo de" },
        { "hebraico": "רַגְלָֽיו׃", "transliteral": "raḡlāyw", "traducao_palavra": "pés dele" }
      ]
    },
    "8": {
      "traducao_completa": "Levanta-te, YHWH, para o teu repouso; tu e a arca da tua força.",
      "palavras": [
        { "hebraico": "ק֘וּמָ֤ה", "transliteral": "qûmā", "traducao_palavra": "levanta-te" },
        { "hebraico": "יְהוָ֨ה", "transliteral": "yəhwāh", "traducao_palavra": "YHWH" },
        { "hebraico": "לִמְנוּחָתֶ֗ךָ", "transliteral": "limnûḥāṯeḵā", "traducao_palavra": "para o teu descanso" },
        { "hebraico": "אַ֝תָּה", "transliteral": "ʾattā", "traducao_palavra": "tu" },
        { "hebraico": "וַאֲרֹ֥ון", "transliteral": "waʾărôn", "traducao_palavra": "e a arca de" },
