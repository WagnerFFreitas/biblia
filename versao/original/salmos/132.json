        { "hebraico": "יַעֲקֹֽב׃", "transliteral": "yaʿăqōḇ", "traducao_palavra": "Jacó" }
      ]
    },
    "6": {
      "traducao_completa": "Eis que ouvimos falar dela em Efrata; achamo-la nos campos do bosque.",
