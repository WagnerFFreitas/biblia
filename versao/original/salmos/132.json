{
  "livro": "Salmos - תְּהִלִּים - Tehillim",
  "capítulo": 132,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Lembra-te, YHWH, de Davi e de todas as suas aflições.",
      "palavras": [
        { "hebraico": "זְכֹור־", "transliteral": "zəḵôr-", "traducao_palavra": "lembra-te" },
        { "hebraico": "יְהוָ֥ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "לְדָוִ֑ד", "transliteral": "ləḏāwiḏ", "traducao_palavra": "de Davi" },
        { "hebraico": "אֵ֝ת", "transliteral": "ʾēṯ", "traducao_palavra": "[objeto]" },
        { "hebraico": "כָּל־", "transliteral": "kāl-", "traducao_palavra": "toda" },
        { "hebraico": "עֻנֹּותֹֽו׃", "transliteral": "ʿunnôṯô", "traducao_palavra": "aflição dele" }
