    "13": {
      "traducao_completa": "Porque YHWH escolheu a Sião; desejou-a para sua habitação.",
      "palavras": [
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "porque" },
        { "hebraico": "בָחַ֥ר", "transliteral": "ḇā-ḥar", "traducao_palavra": "escolheu" },
