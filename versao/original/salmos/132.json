        { "hebraico": "לֹֽא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "יָשׁ֪וּב", "transliteral": "yā-šûḇ", "traducao_palavra": "voltará atrás/desviará" },
        { "hebraico": "מִ֫מֶּ֥נָּה", "transliteral": "mim-men-nā", "traducao_palavra": "dela" },
