        { "hebraico": "אָ֭בֹא", "transliteral": "ʾāḇō", "traducao_palavra": "entrarei" },
        { "hebraico": "בְּאֹ֣הֶל", "transliteral": "bəʾōhel", "traducao_palavra": "na tenda de" },
        { "hebraico": "בֵּיתִ֑י", "transliteral": "bêṯî", "traducao_palavra": "minha casa" },
        { "hebraico": "אִם־", "transliteral": "ʾim-", "traducao_palavra": "se [não]" },
        { "hebraico": "אֶ֝עֱלֶ֗ה", "transliteral": "ʾeʿĕleh", "traducao_palavra": "subirei" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre" },
        { "hebraico": "עֶ֥רֶשׂ", "transliteral": "ʿereś", "traducao_palavra": "[o] leito de" },
        { "hebraico": "יְצוּעָֽי׃", "transliteral": "yəṣûʿāy", "traducao_palavra": "minha cama/repouso" }
      ]
    },
    "4": {
      "traducao_completa": "Não darei sono aos meus olhos, nem dormitar aos meus olhos,",
      "palavras": [
        { "hebraico": "אִם־", "transliteral": "ʾim-", "traducao_palavra": "se [não]" },
        { "hebraico": "אֶתֵּ֣ן", "transliteral": "ʾettēn", "traducao_palavra": "darei" },
        { "hebraico": "שֵׁנָ֣ת", "transliteral": "šēnāṯ", "traducao_palavra": "sono" },
        { "hebraico": "לְעֵינָ֑י", "transliteral": "ləʿênāy", "traducao_palavra": "aos meus olhos" },
        { "hebraico": "לְֽעַפְעַפַּ֥י", "transliteral": "ləʿap̄ʿappay", "traducao_palavra": "às minhas pálpebras" },
        { "hebraico": "תְּנוּמָֽה׃", "transliteral": "ṯənûmā", "traducao_palavra": "dormitar" }
      ]
    },
    "5": {
      "traducao_completa": "Até que eu ache um lugar para YHWH, uma morada para o Poderoso de Jacó.",
      "palavras": [
        { "hebraico": "עַד־", "transliteral": "ʿaḏ-", "traducao_palavra": "até" },
        { "hebraico": "אֶמְצָ֣א", "transliteral": "ʾemṣā", "traducao_palavra": "eu achar" },
        { "hebraico": "מָ֭קֹום", "transliteral": "māqôm", "traducao_palavra": "lugar" },
        { "hebraico": "לַיהוָ֑ה", "transliteral": "layhwāh", "traducao_palavra": "para YHWH" },
        { "hebraico": "מִ֝שְׁכָּנֹ֗ות", "transliteral": "miškānôṯ", "traducao_palavra": "tabernáculos/moradas" },
