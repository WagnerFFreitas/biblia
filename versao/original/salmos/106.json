        { "hebraico": "וַ֝יִּגְאָלֵ֗ם", "transliteral": "way-yiḡ-ʾā-lēm", "traducao_palavra": "e remiu-os" },
        { "hebraico": "מִיַּ֥ד", "transliteral": "mi-yaḏ", "traducao_palavra": "da mão de" },
