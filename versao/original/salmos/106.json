        { "hebraico": "דַּם־", "transliteral": "dam-", "traducao_palavra": "sangue de" },
        { "hebraico": "בְּנֵיהֶ֨ם", "transliteral": "bə-nê-hem", "traducao_palavra": "seus filhos" },
        { "hebraico": "וּבְנֹותֵיהֶ֗ם", "transliteral": "ū-ḇə-nô-ṯê-hem", "traducao_palavra": "e suas filhas" },
