        { "hebraico": "בִּרְצֹ֣ון", "transliteral": "bir-ṣôn", "traducao_palavra": "na aceitação/favor de" },
        { "hebraico": "עַמֶּ֑ךָ", "transliteral": "ʿam-me-ḵā", "traducao_palavra": "teu povo" },
