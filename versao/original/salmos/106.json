    "4": {
      "traducao_completa": "Lembra-te de mim, YHWH, segundo a tua boa vontade para com o teu povo; visita-me com a tua salvação;",
      "palavras": [
        { "hebraico": "זָכְרֵ֣נִי", "transliteral": "zā-ḵə-rē-nî", "traducao_palavra": "lembra-te de mim" },
