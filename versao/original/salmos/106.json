        { "hebraico": "אֵ֥שׁ", "transliteral": "ʾēš", "traducao_palavra": "fogo" },
        { "hebraico": "בַּעֲדָתָ֑ם", "transliteral": "ba-ʿă-ḏā-ṯām", "traducao_palavra": "na assembleia deles" },
        { "hebraico": "לֶ֝הָבָ֗ה", "transliteral": "le-hā-ḇā", "traducao_palavra": "[a] chama" },
        { "hebraico": "תְּלַהֵ֥ט", "transliteral": "tə-la-hēṭ", "traducao_palavra": "consumiu/abrasou" },
        { "hebraico": "רְשָׁעִֽים", "transliteral": "rə-šā-ʿîm", "traducao_palavra": "ímpios" }
      ]
    },
    "19": {
      "traducao_completa": "Fizeram um bezerro em Horebe e prostraram-se perante uma imagem de fundição.",
      "palavras": [
        { "hebraico": "יַעֲשׂוּ־", "transliteral": "ya-ʿă-śû-", "traducao_palavra": "fizeram" },
        { "hebraico": "עֵ֥גֶל", "transliteral": "ʿē-ḡel", "traducao_palavra": "[um] bezerro" },
        { "hebraico": "בְּחֹרֵ֑ב", "transliteral": "bə-ḥō-rēḇ", "traducao_palavra": "em Horebe" },
        { "hebraico": "וַיִּשְׁתַּחֲוּ֖וּ", "transliteral": "way-yiš-ta-ḥă-wû", "traducao_palavra": "e prostraram-se" },
        { "hebraico": "לְמַסֵּכָֽה", "transliteral": "lə-mas-śē-ḵā", "traducao_palavra": "perante [uma] imagem de fundição" }
      ]
    },
    "20": {
      "traducao_completa": "E trocaram a sua glória pela semelhança de um boi que come erva.",
      "palavras": [
        { "hebraico": "וַיָּמִ֥ירוּ", "transliteral": "way-yā-mî-rû", "traducao_palavra": "e trocaram" },
        { "hebraico": "אֶת־", "transliteral": "ʾeṯ-", "traducao_palavra": "[objeto]" },
        { "hebraico": "כְּבֹודָ֑ם", "transliteral": "kə-ḇô-ḏām", "traducao_palavra": "a glória deles" },
        { "hebraico": "בְּתַבְנִ֥ית", "transliteral": "bə-ṯaḇ-nîṯ", "traducao_palavra": "pela semelhança de" },
        { "hebraico": "שֹׁ֝ור", "transliteral": "šôr", "traducao_palavra": "boi" },
        { "hebraico": "אֹכֵ֥ל", "transliteral": "ʾō-ḵēl", "traducao_palavra": "[que] come" },
        { "hebraico": "עֵֽשֶׂב", "transliteral": "ʿē-śeḇ", "traducao_palavra": "erva" }
      ]
    },
    "21": {
      "traducao_completa": "Esqueceram-se de Deus, seu Salvador, que fizera grandezas no Egito,",
      "palavras": [
        { "hebraico": "שָׁכְח֥וּ", "transliteral": "šā-ḵə-ḥû", "traducao_palavra": "esqueceram" },
        { "hebraico": "אֵ֣ל", "transliteral": "ʾēl", "traducao_palavra": "Deus" },
        { "hebraico": "מֹושִׁיעָ֑ם", "transliteral": "mô-šî-ʿām", "traducao_palavra": "salvador deles" },
        { "hebraico": "עֹשֶׂ֖ה", "transliteral": "ʿō-śeh", "traducao_palavra": "fazedor de" },
        { "hebraico": "גְדֹלֹ֣ות", "transliteral": "ḡə-ḏō-lôṯ", "traducao_palavra": "grandezas" },
        { "hebraico": "בְּמִצְרָֽיִם", "transliteral": "bə-miṣ-ra-yim", "traducao_palavra": "no Egito" }
      ]
    },
    "22": {
      "traducao_completa": "Maravilhas na terra de Cam, coisas tremendas junto ao Mar Vermelho.",
      "palavras": [
        { "hebraico": "נִ֭פְלָאֹות", "transliteral": "nip̄-lā-ʾôṯ", "traducao_palavra": "maravilhas" },
        { "hebraico": "בְּאֶ֣רֶץ", "transliteral": "bə-ʾe-reṣ", "traducao_palavra": "na terra de" },
        { "hebraico": "חָ֑ם", "transliteral": "ḥām", "traducao_palavra": "Cam" },
        { "hebraico": "נֹ֝ורָאֹ֗ות", "transliteral": "nô-rā-ʾôṯ", "traducao_palavra": "coisas tremendas" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "junto ao/sobre" },
        { "hebraico": "יַם־", "transliteral": "yam-", "traducao_palavra": "mar de" },
        { "hebraico": "סֽוּף׃", "transliteral": "sûp̄", "traducao_palavra": "juncos [Vermelho]" }
      ]
    },
    "23": {
      "traducao_completa": "Pelo que disse que os destruiria, se Moisés, seu escolhido, não se pusesse na brecha diante dele, para desviar a sua ira, a fim de que não os destruísse.",
      "palavras": [
        { "hebraico": "וַיֹּ֨אמֶר֮", "transliteral": "way-yō-mer", "traducao_palavra": "e ele disse" },
        { "hebraico": "לְֽהַשְׁמִ֫ידָ֥ם", "transliteral": "lə-haš-mî-ḏām", "traducao_palavra": "para destruí-los" },
        { "hebraico": "לוּלֵ֡י", "transliteral": "lû-lê", "traducao_palavra": "se não fosse" },
        { "hebraico": "מֹ֘שֶׁ֤ה", "transliteral": "mō-šeh", "traducao_palavra": "Moisés" },
        { "hebraico": "בְחִירֹ֗ו", "traducao_palavra": "seu escolhido", "transliteral": "ḇə-ḥî-rô" },
        { "hebraico": "עָמַ֣ד", "transliteral": "ʿā-maḏ", "traducao_palavra": "[que] se pôs" },
        { "hebraico": "בַּפֶּ֣רֶץ", "transliteral": "bap-pe-reṣ", "traducao_palavra": "na brecha" },
        { "hebraico": "לְפָנָ֑יו", "transliteral": "lə-p̄ā-nāw", "traducao_palavra": "diante dele" },
        { "hebraico": "לְהָשִׁ֥יᇀ", "transliteral": "lə-hā-šîᇀ", "traducao_palavra": "para desviar" },
        { "hebraico": "חֲ֝מָתֹ֗ו", "transliteral": "ḥă-mā-ṯô", "traducao_palavra": "sua ira" },
        { "hebraico": "מֵֽהַשְׁחִֽית׃", "transliteral": "mê-haš-ḥît", "traducao_palavra": "de destruir" }
      ]
    },
    "24": {
      "traducao_completa": "Também desprezaram a terra aprazível; não creram na sua palavra.",
      "palavras": [
        { "hebraico": "וַֽיִּמְאֲס֬וּ", "transliteral": "way-yim-ʾă-śû", "traducao_palavra": "e desprezaram" },
        { "hebraico": "בְּאֶ֣רֶץ", "transliteral": "bə-ʾe-reṣ", "traducao_palavra": "a terra" },
        { "hebraico": "חֶמְדָּ֑ה", "transliteral": "ḥem-dā", "traducao_palavra": "de desejo/aprazível" },
        { "hebraico": "לֹֽא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "הֶ֝אֱמִ֗ינוּ", "transliteral": "he-ʾĕ-mî-nû", "traducao_palavra": "creram" },
        { "hebraico": "לִדְבָרֹֽו׃", "transliteral": "liḏ-ḇā-rô", "traducao_palavra": "na palavra dele" }
      ]
    },
    "25": {
      "traducao_completa": "Antes, murmuraram nas suas tendas, e não deram ouvidos à voz de YHWH.",
      "palavras": [
        { "hebraico": "וַיֵּרָגְנ֥וּ", "transliteral": "way-yē-rā-ḡə-nû", "traducao_palavra": "e murmuraram" },
        { "hebraico": "בְאָהֳלֵיהֶ֑ם", "transliteral": "ḇə-ʾā-ho-lê-hem", "traducao_palavra": "em suas tendas" },
        { "hebraico": "לֹ֥א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "שָׁ֝מְעוּ", "transliteral": "šā-mə-ʿû", "traducao_palavra": "ouviram" },
        { "hebraico": "בְּקֹ֣ול", "transliteral": "bə-qôl", "traducao_palavra": "à voz de" },
        { "hebraico": "יְהוָֽה׃", "transliteral": "YHWH", "traducao_palavra": "YHWH" }
      ]
    },
    "26": {
      "traducao_completa": "Pelo que levantou a sua mão contra eles, para os derrubar no deserto;",
      "palavras": [
        { "hebraico": "וַיִּשָּׂ֣א", "transliteral": "way-yiś-śā", "traducao_palavra": "e levantou" },
        { "hebraico": "יָדֹ֣ו", "transliteral": "yā-ḏô", "traducao_palavra": "sua mão" },
        { "hebraico": "לָהֶ֑ם", "transliteral": "lā-hem", "traducao_palavra": "contra eles" },
        { "hebraico": "לְהַפִּ֥יל", "transliteral": "lə-hap-pîl", "traducao_palavra": "para fazer cair" },
        { "hebraico": "אֹ֝ותָם", "transliteral": "ʾô-ṯām", "traducao_palavra": "eles" },
        { "hebraico": "בַּמִּדְבָּֽר׃", "transliteral": "bam-miḏ-bār", "traducao_palavra": "no deserto" }
      ]
    },
    "27": {
      "traducao_completa": "Para derrubar também a sua descendência entre as nações, e espalhá-los pelas terras.",
      "palavras": [
        { "hebraico": "וּלְהַפִּ֣יל", "transliteral": "ū-lə-hap-pîl", "traducao_palavra": "e para fazer cair" },
        { "hebraico": "זַ֭רְעָם", "transliteral": "zar-ʿām", "traducao_palavra": "a semente deles" },
        { "hebraico": "בַּגֹּויִ֑ם", "transliteral": "bag-gô-yim", "traducao_palavra": "entre as nações" },
        { "hebraico": "וּ֝לְזָרֹותָ֗ם", "transliteral": "ū-lə-zā-rô-ṯām", "traducao_palavra": "e para espalhá-los" },
        { "hebraico": "בָּאֲרָצֹֽות׃", "transliteral": "bā-ʾă-rā-ṣôṯ", "traducao_palavra": "pelas terras" }
      ]
    },
    "28": {
      "traducao_completa": "Também se apegaram a Baal-Peor, e comeram os sacrifícios dos mortos.",
      "palavras": [
        { "hebraico": "וַיִּצָּ֣מְדוּ", "transliteral": "way-yiṣ-ṣā-mə-ḏû", "traducao_palavra": "e apegaram-se" },
        { "hebraico": "לְבַ֣עַל", "transliteral": "lə-ḇa-ʿal", "traducao_palavra": "a Baal" },
        { "hebraico": "פְּעֹ֑ור", "transliteral": "pə-ʿôr", "traducao_palavra": "Peor" },
        { "hebraico": "וַ֝יֹּאכְל֗וּ", "transliteral": "way-yō-ḵə-lû", "traducao_palavra": "e comeram" },
        { "hebraico": "זִבְחֵ֥י", "transliteral": "ziḇ-ḥê", "traducao_palavra": "sacrifícios de" },
        { "hebraico": "מֵתִֽים׃", "transliteral": "mē-ṯîm", "traducao_palavra": "mortos" }
      ]
    },
    "29": {
      "traducao_completa": "Assim o provocaram à ira com os seus feitos; e a peste irrompeu entre eles.",
      "palavras": [
        { "hebraico": "וַיַּכְעִ֭יסוּ", "transliteral": "way-yaḵ-ʿî-śû", "traducao_palavra": "e provocaram a ira" },
        { "hebraico": "בְּמַֽעַלְלֵיהֶ֑ם", "transliteral": "bə-ma-ʿal-lê-hem", "traducao_palavra": "com seus feitos" },
        { "hebraico": "וַתִּפְרָץ־", "transliteral": "wat-tip̄-raṣ-", "traducao_palavra": "e irrompeu" },
        { "hebraico": "בָּ֝ם", "transliteral": "bām", "traducao_palavra": "neles" },
        { "hebraico": "מַגֵּפָֽה׃", "transliteral": "mag-gē-p̄ā", "traducao_palavra": "[uma] praga" }
      ]
    },
    "30": {
      "traducao_completa": "Então se levantou Fineias, e executou juízo, e cessou aquela peste.",
      "palavras": [
        { "hebraico": "וַיַּעֲמֹ֤ד", "transliteral": "way-ya-ʿă-mōḏ", "traducao_palavra": "e levantou-se" },
        { "hebraico": "פִּֽינְחָ֨ס", "transliteral": "pî-nə-ḥās", "traducao_palavra": "Fineias" },
        { "hebraico": "וַיְפַלֵּ֑ל", "transliteral": "way-p̄al-lēl", "traducao_palavra": "e interveio/executou juízo" },
        { "hebraico": "וַתֵּעָצַ֖ר", "transliteral": "wat-tē-ʿā-ṣar", "traducao_palavra": "e foi detida/cessou" },
        { "hebraico": "הַמַּגֵּפָֽה׃", "transliteral": "ham-mag-gē-p̄ā", "traducao_palavra": "a praga" }
      ]
    },
    "31": {
      "traducao_completa": "E isto lhe foi imputado como justiça, de geração em geração, para sempre.",
      "palavras": [
        { "hebraico": "וַתֵּחָ֥שֶׁב", "transliteral": "wat-tē-ḥā-šēḇ", "traducao_palavra": "e foi contada/imputada" },
        { "hebraico": "לֹ֖ו", "transliteral": "lô", "traducao_palavra": "a ele" },
        { "hebraico": "לִצְדָקָ֑ה", "transliteral": "liṣ-ḏā-qā", "traducao_palavra": "por justiça" },
        { "hebraico": "לְדֹ֥ר", "transliteral": "lə-ḏōr", "traducao_palavra": "para geração" },
        { "hebraico": "וָדֹ֖ר", "transliteral": "wā-ḏōr", "traducao_palavra": "e geração" },
        { "hebraico": "עַד־", "transliteral": "ʿaḏ-", "traducao_palavra": "até" },
        { "hebraico": "עֹולָֽם׃", "transliteral": "ʿô-lām", "traducao_palavra": "sempre" }
      ]
    },
    "32": {
      "traducao_completa": "Indignaram-no também junto às águas de Meribá, de sorte que sucedeu mal a Moisés por causa deles.",
      "palavras": [
        { "hebraico": "וַ֭יַּקְצִיפוּ", "transliteral": "way-yaq-ṣî-p̄û", "traducao_palavra": "e indignaram" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "junto a" },
        { "hebraico": "מֵ֣י", "transliteral": "mê", "traducao_palavra": "águas de" },
        { "hebraico": "מְרִיבָ֑ה", "transliteral": "mə-rî-ḇā", "traducao_palavra": "Meribá" },
        { "hebraico": "וַיֵּ֥רַע", "transliteral": "way-yē-raʿ", "traducao_palavra": "e foi mal" },
        { "hebraico": "לְ֝מֹשֶׁ֗ה", "transliteral": "lə-mō-šeh", "traducao_palavra": "para Moisés" },
        { "hebraico": "בַּעֲבוּרָֽם׃", "transliteral": "ba-ʿă-ḇû-rām", "traducao_palavra": "por causa deles" }
      ]
    },
    "33": {
      "traducao_completa": "Porque irritaram o seu espírito, de modo que falou imprudentemente com seus lábios.",
      "palavras": [
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "porque" },
        { "hebraico": "הִמְר֥וּ", "transliteral": "him-rû", "traducao_palavra": "irritaram/rebelaram" },
        { "hebraico": "אֶת־", "transliteral": "ʾeṯ-", "traducao_palavra": "[objeto]" },
        { "hebraico": "רוּחֹ֑ו", "transliteral": "rû-ḥô", "traducao_palavra": "espírito dele" },
        { "hebraico": "וַ֝יְבַטֵּ֗א", "transliteral": "way-ḇaṭ-ṭē", "traducao_palavra": "e falou [temerariamente]" },
        { "hebraico": "בִּשְׂפָתָֽיו׃", "transliteral": "biś-p̄ā-ṯāw", "traducao_palavra": "com seus lábios" }
      ]
    },
    "34": {
      "traducao_completa": "Não destruíram os povos, como YHWH lhes dissera.",
      "palavras": [
        { "hebraico": "לֹֽא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "הִשְׁמִ֥ידוּ", "transliteral": "hiš-mî-ḏû", "traducao_palavra": "destruíram" },
        { "hebraico": "אֶת־", "transliteral": "ʾeṯ-", "traducao_palavra": "[objeto]" },
        { "hebraico": "הָֽעַמִּ֑ים", "transliteral": "hā-ʿam-mîm", "traducao_palavra": "os povos" },
        { "hebraico": "אֲשֶׁ֤ר", "transliteral": "ʾă-šer", "traducao_palavra": "que" },
        { "hebraico": "אָמַ֖ר", "transliteral": "ʾā-mar", "traducao_palavra": "disse" },
        { "hebraico": "יְהוָ֣ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "לָהֶֽם׃", "transliteral": "lā-hem", "traducao_palavra": "a eles" }
      ]
    },
    "35": {
      "traducao_completa": "Antes, misturaram-se com as nações e aprenderam as suas obras.",
      "palavras": [
        { "hebraico": "וַיִּתְעָרְב֥וּ", "transliteral": "way-yiṯ-ʿā-rə-ḇû", "traducao_palavra": "e misturaram-se" },
        { "hebraico": "בַגֹּויִ֑ם", "transliteral": "ḇag-gô-yim", "traducao_palavra": "nas nações" },
        { "hebraico": "וַֽיִּלְמְד֖וּ", "transliteral": "way-yil-mə-ḏû", "traducao_palavra": "e aprenderam" },
        { "hebraico": "מַעֲשֵׂיהֶֽם׃", "transliteral": "ma-ʿă-śê-hem", "traducao_palavra": "as obras delas" }
      ]
    },
    "36": {
      "traducao_completa": "E serviram os seus ídolos, que vieram a ser-lhes um laço.",
      "palavras": [
        { "hebraico": "וַיַּעַבְד֥וּ", "transliteral": "way-ya-ʿaḇ-ḏû", "traducao_palavra": "e serviram" },
        { "hebraico": "אֶת־", "transliteral": "ʾeṯ-", "traducao_palavra": "[objeto]" },
        { "hebraico": "עֲצַבֵּיהֶ֑ם", "transliteral": "ʿă-ṣab-bê-hem", "traducao_palavra": "os ídolos delas" },
        { "hebraico": "וַיִּהְי֖וּ", "transliteral": "way-yih-yû", "traducao_palavra": "e foram/tornaram-se" },
        { "hebraico": "לָהֶ֥ם", "transliteral": "lā-hem", "traducao_palavra": "para eles" },
        { "hebraico": "לְמֹוקֵֽשׁ׃", "transliteral": "lə-mô-qēš", "traducao_palavra": "em laço/armadilha" }
      ]
    },
    "37": {
      "traducao_completa": "Pois sacrificaram seus filhos e suas filhas aos demônios.",
      "palavras": [
        { "hebraico": "וַיִּזְבְּח֥וּ", "transliteral": "way-yiz-bə-ḥû", "traducao_palavra": "e sacrificaram" },
        { "hebraico": "אֶת־", "transliteral": "ʾeṯ-", "traducao_palavra": "[objeto]" },
        { "hebraico": "בְּנֵיהֶ֑ם", "transliteral": "bə-nê-hem", "traducao_palavra": "seus filhos" },
        { "hebraico": "וְאֶת־", "transliteral": "wə-ʾeṯ-", "traducao_palavra": "e" },
        { "hebraico": "בְּנֹותֵיהֶ֗ם", "transliteral": "bə-nô-ṯê-hem", "traducao_palavra": "suas filhas" },
        { "hebraico": "לַשֵּׁדִֽים׃", "transliteral": "laš-šê-ḏîm", "traducao_palavra": "aos demônios/ídolos" }
      ]
    },
    "38": {
      "traducao_completa": "E derramaram sangue inocente, o sangue de seus filhos e de suas filhas que sacrificaram aos ídolos de Canaã; e a terra foi contaminada com sangue.",
      "palavras": [
