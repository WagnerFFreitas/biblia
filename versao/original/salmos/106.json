      ]
    },
    "6": {
      "traducao_completa": "Pecamos como nossos pais; cometemos iniquidade, procedemos impiamente.",
      "palavras": [
        { "hebraico": "חָטָ֥אנוּ", "transliteral": "ḥā-ṭā-nû", "traducao_palavra": "pecamos" },
