        { "hebraico": "יְהוָ֑ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "יַ֝שְׁמִ֗יעַ", "transliteral": "yaš-mî-aʿ", "traducao_palavra": "fará ouvir/anunciará" },
