        { "hebraico": "אֶת־יְהוָ֗ה", "transliteral": "ʾeṯ-YHWH", "traducao_palavra": "a YHWH" },
        { "hebraico": "כָּֽל־חֲסִ֫ידָ֥יו", "transliteral": "kāl-ḥă-śî-ḏāw", "traducao_palavra": "todos os seus santos/fiéis" },
        { "hebraico": "אֱ֭מוּנִים", "transliteral": "ʾĕ-mû-nîm", "traducao_palavra": "[os] fiéis" },
