        { "hebraico": "אָ֘מַ֤רְתִּי", "transliteral": "ʾā-mar-tî", "traducao_palavra": "disse" },
        { "hebraico": "בְחָפְזִ֗י", "transliteral": "ḇə-ḥā-p̄ə-zî", "traducao_palavra": "na minha pressa/alarme" },
        { "hebraico": "נִגְרַ֥זְתִּי", "transliteral": "niḡ-raz-tî", "traducao_palavra": "fui cortado/excluído" },
        { "hebraico": "מִנֶּ֫גֶד", "transliteral": "min-ne-ḡeḏ", "traducao_palavra": "de diante de" },
        { "hebraico": "עֵינֶ֑יךָ", "transliteral": "ʿê-ne-ḵā", "traducao_palavra": "teus olhos" },
