    "20": {
      "traducao_completa": "Quão grande é a tua bondade, que reservaste para os que te temem, e que preparaste para os que em ti se refugiam, à vista dos filhos dos homens!",
      "palavras": [
        { "hebraico": "מָ֘ה", "transliteral": "mā", "traducao_palavra": "quão/o quê" },
        { "hebraico": "רַ֤ב", "transliteral": "raḇ", "traducao_palavra": "grande [é]" },
        { "hebraico": "טוּבְךָ֨", "transliteral": "ṭû-ḇə-ḵā", "traducao_palavra": "tua bondade" },
        { "hebraico": "אֲשֶׁר־צָפַ֪נְתָּ", "transliteral": "ʾă-šer-ṣā-p̄an-tā", "traducao_palavra": "que reservaste/entesouraste" },
        { "hebraico": "לִּֽירֵאֶ֫יךָ", "transliteral": "lî-rē-ʾe-ḵā", "traducao_palavra": "para os teus tementes" },
        { "hebraico": "פָּ֭עַלְתָּ", "transliteral": "pā-ʿal-tā", "traducao_palavra": "realizaste/preparaste" },
