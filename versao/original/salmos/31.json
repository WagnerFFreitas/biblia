        { "hebraico": "בָּ֑ךְ", "transliteral": "bāḵ", "traducao_palavra": "em ti" },
        { "hebraico": "נֶ֝֗גֶד", "transliteral": "ne-ḡeḏ", "traducao_palavra": "diante de" },
        { "hebraico": "בְּנֵ֣י", "transliteral": "bə-nê", "traducao_palavra": "filhos de" },
        { "hebraico": "אָדָֽם׃", "transliteral": "ʾā-ḏām", "traducao_palavra": "homem/Adão" }
      ]
    },
    "21": {
      "traducao_completa": "Tu os escondes no sigilo da tua presença das conspirações dos homens; tu os proteges em um pavilhão da contenda das línguas.",
      "palavras": [
        { "hebraico": "תַּסְתִּירֵ֨ם ׀", "transliteral": "tas-tî-rēm", "traducao_palavra": "tu os escondes" },
        { "hebraico": "בְּסֵ֥תֶר", "transliteral": "bə-śê-ṯer", "traducao_palavra": "no esconderijo de" },
        { "hebraico": "פָּנֶיךָ֮", "transliteral": "p̄ā-ne-ḵā", "traducao_palavra": "tua face/presença" },
        { "hebraico": "מֵרֻכְסֵ֫י", "transliteral": "mê-ruḵ-śê", "traducao_palavra": "das tramas/conspirações de" },
        { "hebraico": "אִ֥ישׁ", "transliteral": "ʾîš", "traducao_palavra": "homem" },
        { "hebraico": "תִּצְפְּנֵ֥ם", "transliteral": "tiṣ-pə-nêm", "traducao_palavra": "tu os ocultas/proteges" },
