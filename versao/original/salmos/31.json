    "17": {
      "traducao_completa": "Faze resplandecer o teu rosto sobre o teu servo; salva-me por tua misericórdia.",
      "palavras": [
        { "hebraico": "הָאִ֣ירָה", "transliteral": "hā-ʾî-rā", "traducao_palavra": "faze resplandecer" },
        { "hebraico": "פָ֭נֶיךָ", "transliteral": "p̄ā-ne-ḵā", "traducao_palavra": "teu rosto" },
        { "hebraico": "עַל־עַבְדֶּ֑ךָ", "transliteral": "ʿal-ʿaḇ-de-ḵā", "traducao_palavra": "sobre teu servo" },
        { "hebraico": "הֹושִׁ֖иעֵנִי", "transliteral": "hô-šî-ʿē-nî", "traducao_palavra": "salva-me" },
        { "hebraico": "בְחַסְדֶּֽךָ׃", "transliteral": "ḇə-ḥas-de-ḵā", "traducao_palavra": "na tua misericórdia" }
