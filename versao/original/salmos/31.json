        { "hebraico": "תֵּאֳָלַ֗מְנָה", "transliteral": "tē-ʾŏ-lam-nā", "traducao_palavra": "fiquem mudos" },
        { "hebraico": "שִׂפְתֵ֫י", "transliteral": "śip̄-ṯê", "traducao_palavra": "lábios de" },
