        { "hebraico": "הַדֹּבְרֹ֖ות", "transliteral": "had-dō-ḇə-rôṯ", "traducao_palavra": "que falam" },
        { "hebraico": "עַל־צַדִּ֥יק", "transliteral": "ʿal-ṣad-dîq", "traducao_palavra": "contra o justo" },
