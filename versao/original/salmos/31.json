    "22": {
      "traducao_completa": "Bendito seja YHWH, pois maravilhou a sua misericórdia para comigo em uma cidade sitiada.",
      "palavras": [
        { "hebraico": "בָּר֥וּךְ", "transliteral": "bā-rûḵ", "traducao_palavra": "bendito [seja]" },
        { "hebraico": "יְהוָ֑ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "כִּ֤י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "הִפְלִ֘יא", "transliteral": "hip̄-lî", "traducao_palavra": "maravilhou/fez maravilhosa" },
        { "hebraico": "חַסְדֹּ֥ו", "transliteral": "ḥas-dô", "traducao_palavra": "sua misericórdia" },
