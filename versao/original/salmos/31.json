        { "hebraico": "יְֽהוָ֗ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "אַל־אֵ֭בֹושָׁה", "transliteral": "ʾal-ʾē-ḇô-šā", "traducao_palavra": "não seja eu envergonhado" },
        { "hebraico": "כִּ֣י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "קְרָאתִ֑יךָ", "transliteral": "qə-rā-ṯî-ḵā", "traducao_palavra": "eu te invoquei" },
        { "hebraico": "יֵבֹ֥שׁוּ", "transliteral": "yē-ḇō-šû", "traducao_palavra": "sejam envergonhados" },
        { "hebraico": "רְ֝שָׁעִ֗ים", "transliteral": "rə-šā-ʿîm", "traducao_palavra": "ímpios" },
        { "hebraico": "יִדְּמ֥וּ", "transliteral": "yid-də-mû", "traducao_palavra": "emudeçam/fiquem silenciosos" },
        { "hebraico": "לִשְׁאֹֽול׃", "transliteral": "liš-ʾôl", "traducao_palavra": "para o Sheol" }
      ]
