        { "hebraico": "שָׁמַ֥עְתָּ", "transliteral": "šā-maʿ-tā", "traducao_palavra": "tu ouviste" },
        { "hebraico": "קֹ֥ול", "transliteral": "qôl", "traducao_palavra": "[a] voz de" },
        { "hebraico": "תַּ֝חֲנוּנַ֗י", "transliteral": "ta-ḥă-nû-nay", "traducao_palavra": "minhas súplicas" },
        { "hebraico": "בְּשַׁוְּעִ֥י", "transliteral": "bə-šaw-wə-ʿî", "traducao_palavra": "no meu clamar" },
