        { "hebraico": "אֲדֹנָ֪י", "transliteral": "ʾă-ḏō-nāy", "traducao_palavra": "[ao] Senhor" },
        { "hebraico": "דָּ֫רָ֥שְׁתִּי", "transliteral": "dā-rāš-tî", "traducao_palavra": "busquei" },
