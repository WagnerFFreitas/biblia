        { "hebraico": "אֱלֹהִים֙", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "Deus" },
        { "hebraico": "וְאֶצְעָ֔קָה", "transliteral": "wə-ʾeṣ-ʿā-qā", "traducao_palavra": "e clamei" },
