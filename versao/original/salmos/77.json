        { "hebraico": "וְאֶהֱמָ֑יָה", "transliteral": "wə-ʾe-hĕ-mā-yā", "traducao_palavra": "e me perturbava/gemia" },
        { "hebraico": "אָשִׂ֓יחָה ׀", "transliteral": "ʾā-śî-ḥā", "traducao_palavra": "meditava/queixava" },
