    "8": {
      "traducao_completa": "Não endureçais o vosso coração, como em Meribá e como no dia de Massá no deserto,",
      "palavras": [
        { "hebraico": "אַל־", "transliteral": "ʾal-", "traducao_palavra": "não" },
