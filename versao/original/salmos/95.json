        { "hebraico": "שָׁנָ֨ה", "transliteral": "šānā", "traducao_palavra": "ano" },
        { "hebraico": "׀", "transliteral": "|", "traducao_palavra": "" },
        { "hebraico": "אָ֘ק֤וּט", "transliteral": "ʾāqûṭ", "traducao_palavra": "enfadei-me/desgostei-me" },
        { "hebraico": "בְּדֹ֗ור", "transliteral": "bəḏôr", "traducao_palavra": "com [aquela] geração" },
