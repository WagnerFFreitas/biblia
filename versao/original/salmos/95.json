        { "hebraico": "אֲבֹותֵיכֶ֑ם", "transliteral": "ʾăḇôṯêḵem", "traducao_palavra": "vossos pais" },
        { "hebraico": "בְּ֝חָנ֗וּנִי", "transliteral": "bəḥānûnî", "traducao_palavra": "provaram me" },
        { "hebraico": "גַּם־", "transliteral": "gam-", "traducao_palavra": "também" },
        { "hebraico": "רָ֥אוּ", "transliteral": "rāʾû", "traducao_palavra": "viram" },
        { "hebraico": "פָעֳלִֽי׃", "transliteral": "p̄oʿŏlî", "traducao_palavra": "minha obra" }
      ]
    },
    "10": {
      "traducao_completa": "Quarenta anos estive desgostado com esta geração e disse: É um povo que erra de coração, e não tem conhecido os meus caminhos.",
      "palavras": [
