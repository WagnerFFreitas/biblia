        { "hebraico": "בְּקֹלֹ֥ו", "transliteral": "bəqōlô", "traducao_palavra": "à voz dele" },
        { "hebraico": "תִשְׁמָֽעוּ׃", "transliteral": "tišmāʿû", "traducao_palavra": "ouvirdes" }
      ]
