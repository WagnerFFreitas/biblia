        { "hebraico": "לֹֽו׃", "transliteral": "lô", "traducao_palavra": "[são] dele" }
      ]
    },
    "5": {
      "traducao_completa": "Dele é o mar, pois ele o fez, e as suas mãos formaram a terra seca.",
      "palavras": [
        { "hebraico": "אֲשֶׁר־", "transliteral": "ʾăšer-", "traducao_palavra": "que" },
        { "hebraico": "לֹ֣ו", "transliteral": "lô", "traducao_palavra": "dele [é]" },
        { "hebraico": "הַ֭יָּם", "transliteral": "hayyām", "traducao_palavra": "o mar" },
        { "hebraico": "וְה֣וּא", "transliteral": "wəhû", "traducao_palavra": "e ele" },
        { "hebraico": "עָשָׂ֑הוּ", "transliteral": "ʿāśāhû", "traducao_palavra": "fez o" },
        { "hebraico": "וְ֝יַבֶּ֗שֶׁת", "transliteral": "wəyabbešeṯ", "traducao_palavra": "e a terra seca" },
        { "hebraico": "יָדָ֥יו", "transliteral": "yāḏāw", "traducao_palavra": "mãos dele" },
        { "hebraico": "יָצָֽרוּ׃", "transliteral": "yāṣārû", "traducao_palavra": "formaram" }
      ]
    },
    "6": {
      "traducao_completa": "Vinde, adoremos e prostrememo-nos; ajoelhemos diante de YHWH, que nos criou.",
      "palavras": [
        { "hebraico": "בֹּ֭אוּ", "transliteral": "bōʾû", "traducao_palavra": "vinde" },
