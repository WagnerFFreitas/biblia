{
  "livro": "Salmos - תְּהִלִּים - Tehillim",
  "capítulo": 95,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Vinde, cantemos com júbilo a YHWH; aclamemos a rocha da nossa salvação.",
      "palavras": [
        { "hebraico": "לְכ֭וּ", "transliteral": "ləḵû", "traducao_palavra": "vinde" },
        { "hebraico": "נְרַנְּנָ֣ה", "transliteral": "nərannənā", "traducao_palavra": "cantemos com júbilo" },
        { "hebraico": "לַיהוָ֑ה", "transliteral": "layhwāh", "traducao_palavra": "a YHWH" },
        { "hebraico": "נָ֝רִ֗יעָה", "transliteral": "nārîʿā", "traducao_palavra": "aclamemos" },
        { "hebraico": "לְצ֣וּר", "transliteral": "ləṣûr", "traducao_palavra": "à rocha de" },
        { "hebraico": "יִשְׁעֵֽנוּ׃", "transliteral": "yišʿēnû", "traducao_palavra": "nossa salvação" }
      ]
    },
    "2": {
      "traducao_completa": "Apresentemo-nos diante da sua face com ações de graças; celebremo-lo com salmos.",
      "palavras": [
        { "hebraico": "נְקַדְּמָ֣ה", "transliteral": "nəqaddəmā", "traducao_palavra": "adiantemo-nos/apresentemo-nos" },
        { "hebraico": "פָנָ֣יו", "transliteral": "pānāw", "traducao_palavra": "[ante] a face dele" },
        { "hebraico": "בְּתֹודָ֑ה", "transliteral": "bəṯôḏā", "traducao_palavra": "com ação de graças" },
        { "hebraico": "בִּ֝זְמִרֹ֗ות", "transliteral": "bizmirôṯ", "traducao_palavra": "com salmos/cânticos" },
        { "hebraico": "נָרִ֥יעַֽ", "transliteral": "nārîaʿ", "traducao_palavra": "aclamemos" },
        { "hebraico": "לֹֽו׃", "transliteral": "lô", "traducao_palavra": "a ele" }
      ]
    },
    "3": {
      "traducao_completa": "Porque YHWH é Deus grande, e Rei grande acima de todos os deuses.",
