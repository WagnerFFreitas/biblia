    "7": {
      "traducao_completa": "Porque ele é o nosso Deus, e nós povo do seu pasto e ovelhas da sua mão. Hoje, se ouvirdes a sua voz,",
      "palavras": [
        { "hebraico": "כִּ֘י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "ה֤וּא", "transliteral": "hû", "traducao_palavra": "ele [é]" },
        { "hebraico": "אֱלֹהֵ֗ינוּ", "transliteral": "ʾĕlōhênû", "traducao_palavra": "Deus nosso" },
        { "hebraico": "וַאֲנַ֤חְנוּ", "transliteral": "waʾănaḥnû", "traducao_palavra": "e nós" },
        { "hebraico": "עַ֣ם", "transliteral": "ʿam", "traducao_palavra": "povo de" },
        { "hebraico": "מַ֭רְעִיתֹו", "transliteral": "marʿîṯô", "traducao_palavra": "pasto dele" },
        { "hebraico": "וְצֹ֣אן", "transliteral": "wəṣōn", "traducao_palavra": "e ovelhas de" },
        { "hebraico": "יָדֹ֑ו", "transliteral": "yāḏô", "traducao_palavra": "mão dele" },
        { "hebraico": "הַ֝יֹּ֗ום", "transliteral": "hayyôm", "traducao_palavra": "hoje" },
