        { "hebraico": "לְ֭בַבְכֶם", "transliteral": "ləḇaḇkem", "traducao_palavra": "vosso coração" },
        { "hebraico": "כִּמְרִיבָ֑ה", "transliteral": "kimrîḇā", "traducao_palavra": "como em Meribá" },
        { "hebraico": "כְּיֹ֥ום", "transliteral": "kəyôm", "traducao_palavra": "como [no] dia de" },
        { "hebraico": "מַ֝סָּ֗ה", "transliteral": "massā", "traducao_palavra": "Massá" },
        { "hebraico": "בַּמִּדְבָּֽר׃", "transliteral": "bammiḏbār", "traducao_palavra": "no deserto" }
      ]
    },
    "9": {
      "traducao_completa": "Onde vossos pais me tentaram, me provaram e viram a minha obra.",
      "palavras": [
        { "hebraico": "אֲשֶׁ֣ר", "transliteral": "ʾăšer", "traducao_palavra": "onde" },
