        { "hebraico": "כִּ֤י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "אֵ֣ל", "transliteral": "ʾēl", "traducao_palavra": "Deus" },
        { "hebraico": "גָּדֹ֣ול", "transliteral": "gāḏôl", "traducao_palavra": "grande [é]" },
        { "hebraico": "יְהוָ֑ה", "transliteral": "yəhwāh", "traducao_palavra": "YHWH" },
        { "hebraico": "וּמֶ֥לֶךְ", "transliteral": "ūmeleḵ", "traducao_palavra": "e Rei" },
        { "hebraico": "גָּ֝דֹ֗ול", "transliteral": "gāḏôl", "traducao_palavra": "grande" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre" },
        { "hebraico": "כָּל־", "transliteral": "kāl-", "traducao_palavra": "todos" },
        { "hebraico": "אֱלֹהִֽים׃", "transliteral": "ʾĕlōhîm", "traducao_palavra": "deuses" }
      ]
    },
    "4": {
      "traducao_completa": "Em cuja mão estão as profundezas da terra, e as alturas dos montes são suas.",
      "palavras": [
        { "hebraico": "אֲשֶׁר֮", "transliteral": "ʾăšer", "traducao_palavra": "que/em cujas" },
        { "hebraico": "בְּיָדֹ֪ו", "transliteral": "bəyāḏô", "traducao_palavra": "na mão dele" },
        { "hebraico": "מֶחְקְרֵי־", "transliteral": "meḥqərê-", "traducao_palavra": "lugares profundos de" },
        { "hebraico": "אָ֥רֶץ", "transliteral": "ʾāreṣ", "traducao_palavra": "terra" },
        { "hebraico": "וְתֹועֲפֹ֨ות", "transliteral": "wəṯôʿăp̄ôṯ", "traducao_palavra": "e as alturas/picos de" },
