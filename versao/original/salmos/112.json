{
  "livro": "Salmos - תְּהִלִּים - Tehillim",
  "capítulo": 112,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Louvai a YHWH! Bem-aventurado o homem que teme a YHWH, que em seus mandamentos tem grande prazer.",
      "palavras": [
        { "hebraico": "הַ֥לְלוּיָ֨הּ", "transliteral": "hal-lû-yāh", "traducao_palavra": "louvai a YAH" },
        { "hebraico": "אַשְׁרֵי־", "transliteral": "ʾaš-rê-", "traducao_palavra": "bem-aventurado" },
        { "hebraico": "אִ֭ישׁ", "transliteral": "ʾîš", "traducao_palavra": "[o] homem" },
        { "hebraico": "יָרֵ֣א", "transliteral": "yā-rē", "traducao_palavra": "[que] teme" },
        { "hebraico": "אֶת־", "transliteral": "ʾeṯ-", "traducao_palavra": "[objeto]" },
        { "hebraico": "יְהוָ֑ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "בְּ֝מִצְוֹתָ֗יו", "transliteral": "bə-miṣ-wō-ṯāyw", "traducao_palavra": "em seus mandamentos" },
        { "hebraico": "חָפֵ֥ץ", "transliteral": "ḥā-p̄êṣ", "traducao_palavra": "tem prazer" },
        { "hebraico": "מְאֹֽד׃", "transliteral": "mə-ʾōḏ", "traducao_palavra": "muito" }
      ]
    },
    "2": {
      "traducao_completa": "A sua descendência será poderosa na terra; a geração dos retos será abençoada.",
      "palavras": [
        { "hebraico": "גִּבֹּ֣ור", "transliteral": "gib-bôr", "traducao_palavra": "poderosa" },
        { "hebraico": "בָּאָ֭רֶץ", "transliteral": "bā-ʾā-reṣ", "traducao_palavra": "na terra" },
        { "hebraico": "יִהְיֶ֣ה", "transliteral": "yih-yeh", "traducao_palavra": "será" },
        { "hebraico": "זַרְעֹ֑ו", "transliteral": "zar-ʿô", "traducao_palavra": "descendência dele" },
        { "hebraico": "דֹּ֭ור", "transliteral": "dôr", "traducao_palavra": "[a] geração de" },
        { "hebraico": "יְשָׁרִ֣ים", "transliteral": "yə-šā-rîm", "traducao_palavra": "retos" },
        { "hebraico": "יְבֹרָֽךְ׃", "transliteral": "yə-ḇō-rāḵ", "traducao_palavra": "será abençoada" }
      ]
    },
    "3": {
      "traducao_completa": "Bens e riquezas haverá na sua casa, e a sua justiça permanece para sempre.",
      "palavras": [
        { "hebraico": "הֹון־", "transliteral": "hôn-", "traducao_palavra": "bens" },
        { "hebraico": "וָעֹ֥שֶׁר", "transliteral": "wā-ʿō-šer", "traducao_palavra": "e riqueza" },
        { "hebraico": "בְּבֵיתֹ֑ו", "transliteral": "bə-ḇê-ṯô", "traducao_palavra": "na casa dele" },
        { "hebraico": "וְ֝צִדְקָתֹ֗ו", "transliteral": "wə-ṣiḏ-qā-ṯô", "traducao_palavra": "e a justiça dele" },
        { "hebraico": "עֹמֶ֥דֶת", "transliteral": "ʿō-me-ḏeṯ", "traducao_palavra": "permanece/está de pé" },
        { "hebraico": "לָעַֽד׃", "transliteral": "lā-ʿaḏ", "traducao_palavra": "para sempre" }
      ]
    },
    "4": {
      "traducao_completa": "A luz nasce nas trevas para os retos; ele é piedoso, misericordioso e justo.",
      "palavras": [
        { "hebraico": "זָ֘רַ֤ח", "transliteral": "zā-raḥ", "traducao_palavra": "nasceu/brilhou" },
