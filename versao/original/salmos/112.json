        { "hebraico": "יִמֹּ֑וט", "transliteral": "yim-môṭ", "traducao_palavra": "será abalado" },
        { "hebraico": "לְזֵ֥כֶר", "transliteral": "lə-zê-ḵer", "traducao_palavra": "para memória" },
