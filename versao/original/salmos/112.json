        { "hebraico": "אֹ֭ور", "transliteral": "ʾôr", "traducao_palavra": "[a] luz" },
        { "hebraico": "לַיְשָׁרִ֑ים", "transliteral": "lay-šā-rîm", "traducao_palavra": "para os retos" },
        { "hebraico": "חַנּ֥וּן", "transliteral": "ḥan-nûn", "traducao_palavra": "piedoso/gracioso" },
        { "hebraico": "וְרַחּ֗וּם", "transliteral": "wə-ra-ḥûm", "traducao_palavra": "e misericordioso" },
        { "hebraico": "וְצַדִּֽיק׃", "transliteral": "wə-ṣad-dîq", "traducao_palavra": "e justo" }
      ]
    },
    "5": {
      "traducao_completa": "O homem bom se compadece e empresta; ele sustenta as suas causas com juízo.",
