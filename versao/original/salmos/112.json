        { "hebraico": "צַדִּֽיק׃", "transliteral": "ṣad-dîq", "traducao_palavra": "[o] justo" }
      ]
    },
    "7": {
      "traducao_completa": "Não temerá más notícias; o seu coração está firme, confiando em YHWH.",
