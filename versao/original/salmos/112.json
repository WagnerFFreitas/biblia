    "8": {
      "traducao_completa": "O seu coração, bem firmado, não temerá, até que veja o seu desejo sobre os seus adversários.",
      "palavras": [
        { "hebraico": "סָמ֣וּךְ", "transliteral": "śā-mûḵ", "traducao_palavra": "sustentado/apoiado" },
        { "hebraico": "לִ֭בֹּו", "transliteral": "lib-bô", "traducao_palavra": "coração dele" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "יִירָ֑א", "transliteral": "yî-rā", "traducao_palavra": "temerá" },
        { "hebraico": "עַ֖ד", "transliteral": "ʿaḏ", "traducao_palavra": "até" },
        { "hebraico": "אֲשֶׁר־", "transliteral": "ʾă-šer-", "traducao_palavra": "que" },
