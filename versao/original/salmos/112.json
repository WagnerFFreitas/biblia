        { "hebraico": "רָ֭עָה", "transliteral": "rā-ʿā", "traducao_palavra": "má" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "יִירָ֑א", "transliteral": "yî-rā", "traducao_palavra": "temerá" },
        { "hebraico": "נָכֹ֥ון", "transliteral": "nā-ḵôn", "traducao_palavra": "firmado [está]" },
        { "hebraico": "לִ֝בֹּ֗ו", "transliteral": "lib-bô", "traducao_palavra": "coração dele" },
