        { "hebraico": "וּמַלְוֶ֑ה", "transliteral": "ū-mal-weh", "traducao_palavra": "e empresta" },
        { "hebraico": "יְכַלְכֵּ֖ל", "transliteral": "yə-ḵal-kēl", "traducao_palavra": "[que] sustenta/guia" },
