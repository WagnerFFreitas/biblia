        { "hebraico": "פִּזַּ֤ר", "transliteral": "piz-zar", "traducao_palavra": "espalhou" },
        { "hebraico": "נָתַ֨ן", "transliteral": "nā-ṯan", "traducao_palavra": "deu" },
        { "hebraico": "לָאֶבְיֹונִ֗ים", "transliteral": "lā-ʾeḇ-yô-nîm", "traducao_palavra": "aos necessitados" },
        { "hebraico": "צִ֭דְקָתֹו", "transliteral": "ṣiḏ-qā-ṯô", "traducao_palavra": "justiça dele" },
        { "hebraico": "עֹמֶ֥דֶת", "transliteral": "ʿō-me-ḏeṯ", "traducao_palavra": "permanece" },
        { "hebraico": "לָעַ֑ד", "transliteral": "lā-ʿaḏ", "traducao_palavra": "para sempre" },
        { "hebraico": "קַ֝רְנֹ֗ו", "transliteral": "qar-nô", "traducao_palavra": "chifre/fronte dele" },
        { "hebraico": "תָּר֥וּם", "transliteral": "tā-rûm", "traducao_palavra": "será exaltada" },
