        { "hebraico": "בְצָרָֽיו׃", "transliteral": "ḇə-ṣā-rāyw", "traducao_palavra": "nos seus adversários" }
      ]
    },
    "9": {
      "traducao_completa": "Espalhou, deu aos necessitados; a sua justiça permanece para sempre; a sua fronte se exaltará em glória.",
