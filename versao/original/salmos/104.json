    "26": {
      "traducao_completa": "Ali andam os navios; e o leviatã que formaste para nele folgar.",
      "palavras": [
        { "hebraico": "שָׁ֭ם", "transliteral": "šām", "traducao_palavra": "ali" },
        { "hebraico": "אֳנִיֹּ֣ות", "transliteral": "ʾo-niy-yôṯ", "traducao_palavra": "navios" },
