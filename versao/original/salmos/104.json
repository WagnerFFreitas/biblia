        { "hebraico": "אֵלֶ֣יךָ", "transliteral": "ʾê-ley-ḵā", "traducao_palavra": "em ti/para ti" },
        { "hebraico": "יְשַׂבֵּר֑וּן", "transliteral": "yə-śab-bē-rûn", "traducao_palavra": "esperam" },
        { "hebraico": "לָתֵ֖ת", "transliteral": "lā-ṯēṯ", "traducao_palavra": "para dar" },
        { "hebraico": "אָכְלָ֣ם", "transliteral": "ʾoḵ-lām", "traducao_palavra": "o alimento deles" },
