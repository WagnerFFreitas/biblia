        { "hebraico": "מַעֲשֶׂ֨יךָ ׀", "transliteral": "ma-ʿă-śey-ḵā", "traducao_palavra": "tuas obras" },
        { "hebraico": "יְהוָ֗ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "כֻּ֭לָּם", "transliteral": "kul-lām", "traducao_palavra": "todas elas" },
        { "hebraico": "בְּחָכְמָ֣ה", "transliteral": "bə-ḥāḵ-mā", "traducao_palavra": "com sabedoria" },
        { "hebraico": "עָשִׂ֑יתָ", "transliteral": "ʿā-śî-ṯā", "traducao_palavra": "tu fizeste" },
        { "hebraico": "מָלְאָ֥ה", "transliteral": "mā-lə-ʾā", "traducao_palavra": "está cheia" },
        { "hebraico": "הָ֝אָ֗רֶץ", "transliteral": "hā-ʾā-reṣ", "traducao_palavra": "a terra" },
        { "hebraico": "קִנְיָנֶֽךָ׃", "transliteral": "qin-yā-ne-ḵā", "traducao_palavra": "tuas posses/riquezas" }
      ]
    },
    "25": {
      "traducao_completa": "Eis o mar, grande e de largos espaços, onde há seres sem número, animais pequenos e grandes.",
      "palavras": [
        { "hebraico": "זֶ֤ה", "transliteral": "zeh", "traducao_palavra": "este/eis" },
        { "hebraico": "הַיָּ֨ם", "transliteral": "hay-yām", "traducao_palavra": "o mar" },
        { "hebraico": "גָּדֹ֪ול", "transliteral": "gā-ḏôl", "traducao_palavra": "grande" },
        { "hebraico": "וּרְחַ֪ב", "transliteral": "ū-rə-ḥaḇ", "traducao_palavra": "e largo de" },
        { "hebraico": "יָ֫דָ֥יִם", "transliteral": "yā-ḏā-yim", "traducao_palavra": "mãos/espaços" },
        { "hebraico": "שָֽׁם־", "transliteral": "šām-", "traducao_palavra": "ali" },
        { "hebraico": "רֶ֭מֶשׂ", "transliteral": "re-meś", "traducao_palavra": "[há] rastejantes/seres" },
        { "hebraico": "וְאֵ֣ין", "transliteral": "wə-ʾên", "traducao_palavra": "e não [há]" },
        { "hebraico": "מִסְפָּ֑ר", "transliteral": "mis-pār", "traducao_palavra": "número/limite" },
