        { "hebraico": "קְ֝טַנֹּ֗ות", "transliteral": "qə-ṭan-nôṯ", "traducao_palavra": "pequenos" },
        { "hebraico": "עִם־", "transliteral": "ʿim-", "traducao_palavra": "com/e" },
        { "hebraico": "גְּדֹלֹֽות׃", "transliteral": "gə-ḏō-lôṯ", "traducao_palavra": "grandes" }
