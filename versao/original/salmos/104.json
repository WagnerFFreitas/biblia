        { "hebraico": "לְפָעֳלֹ֑ו", "transliteral": "lə-p̄o-ʿo-lô", "traducao_palavra": "para seu trabalho/lida" },
        { "hebraico": "וְֽלַעֲבֳֹדָתֹ֝ו", "transliteral": "wə-la-ʿă-ḇō-ḏā-ṯô", "traducao_palavra": "e para seu serviço" },
        { "hebraico": "עֲדֵי־", "transliteral": "ʿă-ḏê-", "traducao_palavra": "até" },
