        { "hebraico": "הַ֭כְּפִירִים", "transliteral": "hak-kə-p̄î-rîm", "traducao_palavra": "os leõezinhos" },
        { "hebraico": "שֹׁאֲגִ֣ים", "transliteral": "šō-ʾă-ḡîm", "traducao_palavra": "rugindo" },
        { "hebraico": "לַטָּ֑רֶף", "transliteral": "la-ṭā-rep̄", "traducao_palavra": "pela presa" },
        { "hebraico": "וּלְבַקֵּ֖שׁ", "transliteral": "ū-lə-ḇaq-qēš", "traducao_palavra": "e para buscar" },
