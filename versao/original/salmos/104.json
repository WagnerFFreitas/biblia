        { "hebraico": "לִ֝וְיָתָ֗ן", "transliteral": "liw-yā-ṯān", "traducao_palavra": "Leviatã" },
        { "hebraico": "זֶה־", "transliteral": "zeh-", "traducao_palavra": "este" },
        { "hebraico": "יָצַ֥רְתָּ", "transliteral": "yā-ṣar-tā", "traducao_palavra": "[que] tu formaste" },
        { "hebraico": "לְשַׂחֶק־", "transliteral": "lə-śa-ḥeq-", "traducao_palavra": "para brincar/folgar" },
