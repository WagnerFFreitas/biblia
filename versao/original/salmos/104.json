        { "hebraico": "יֵאָסֵפ֑וּן", "transliteral": "yê-ʾā-śê-p̄ûn", "traducao_palavra": "eles se recolhem" },
        { "hebraico": "וְאֶל־", "transliteral": "wə-ʾel-", "traducao_palavra": "e em/para" },
        { "hebraico": "מְ֝עֹונֹתָ֗ם", "transliteral": "mə-ʿô-nô-ṯām", "traducao_palavra": "suas moradas/covis" },
