        { "hebraico": "לְמֹועֲדִ֑ים", "transliteral": "lə-mô-ʿă-ḏîm", "traducao_palavra": "para tempos fixados/estações" },
        { "hebraico": "שֶׁ֝֗מֶשׁ", "transliteral": "še-meš", "traducao_palavra": "[o] sol" },
