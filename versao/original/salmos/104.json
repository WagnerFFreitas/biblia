        { "hebraico": "חֹ֭שֶׁךְ", "transliteral": "ḥō-šeḵ", "traducao_palavra": "trevas" },
        { "hebraico": "וִ֣יהִי", "transliteral": "wî-hî", "traducao_palavra": "e torna-se/é" },
        { "hebraico": "לָ֑יְלָה", "transliteral": "lā-yə-lā", "traducao_palavra": "noite" },
        { "hebraico": "בֹּֽו־", "transliteral": "bô-", "traducao_palavra": "nela" },
        { "hebraico": "תִ֝רְמֹ֗שׂ", "transliteral": "ṯir-mōś", "traducao_palavra": "rastejam/saem" },
        { "hebraico": "כָּל־", "transliteral": "kāl-", "traducao_palavra": "todos" },
        { "hebraico": "חַיְתֹו־", "transliteral": "ḥay-ṯô-", "traducao_palavra": "animal de" },
