        { "hebraico": "בְקָעֹ֑ות", "transliteral": "ḇə-qā-ʿôṯ", "traducao_palavra": "vales" },
        { "hebraico": "אֶל־", "transliteral": "ʾel-", "traducao_palavra": "para" },
        { "hebraico": "מְ֝קֹ֗ום", "transliteral": "mə-qôm", "traducao_palavra": "o lugar" },
        { "hebraico": "זֶ֤ה", "transliteral": "zeh", "traducao_palavra": "[que]" },
        { "hebraico": "יָסַ֥דְתָּ", "transliteral": "yā-śad-tā", "traducao_palavra": "fundaste" },
        { "hebraico": "לָהֶֽם׃", "transliteral": "lā-hem", "traducao_palavra": "para eles/elas" }
      ]
    },
    "9": {
      "traducao_completa": "Puseste-lhes um limite, que não ultrapassarão, para que não tornem a cobrir a terra.",
      "palavras": [
        { "hebraico": "גְּבוּל־", "transliteral": "gə-ḇûl-", "traducao_palavra": "limite" },
        { "hebraico": "שַׂ֭מְתָּ", "transliteral": "śam-tā", "traducao_palavra": "puseste" },
        { "hebraico": "בַּל־", "transliteral": "bal-", "traducao_palavra": "não" },
        { "hebraico": "יַעֲבֹר֑וּן", "transliteral": "ya-ʿă-ḇō-rûn", "traducao_palavra": "passarão/ultrapassarão" },
        { "hebraico": "בַּל־", "transliteral": "bal-", "traducao_palavra": "não" },
        { "hebraico": "יְ֝שֻׁב֗וּן", "transliteral": "yə-šu-ḇûn", "traducao_palavra": "voltarão" },
        { "hebraico": "לְכַסֹּ֥ות", "transliteral": "lə-ḵas-śôṯ", "traducao_palavra": "para cobrir" },
        { "hebraico": "הָאָֽרֶץ׃", "transliteral": "hā-ʾā-reṣ", "traducao_palavra": "a terra" }
      ]
    },
    "10": {
      "traducao_completa": "Tu és o que envias as fontes aos vales, que correm entre os montes.",
      "palavras": [
        { "hebraico": "הַֽמְשַׁלֵּ֣חַ", "transliteral": "ham-šal-lē-aḥ", "traducao_palavra": "o que envia" },
        { "hebraico": "מַ֭עְיָנִים", "transliteral": "maʿ-yā-nîm", "traducao_palavra": "fontes" },
        { "hebraico": "בַּנְּחָלִ֑ים", "transliteral": "ban-nə-ḥā-lîm", "traducao_palavra": "nos ribeiros/vales" },
        { "hebraico": "בֵּ֥ין", "transliteral": "bên", "traducao_palavra": "entre" },
        { "hebraico": "הָ֝רִ֗ים", "transliteral": "hā-rîm", "traducao_palavra": "montes" },
        { "hebraico": "יְהַלֵּכֽוּן׃", "transliteral": "yə-hal-lē-ḵûn", "traducao_palavra": "elas correm/vão" }
      ]
    },
    "11": {
      "traducao_completa": "Dão de beber a todos os animais do campo; os asnos selvagens matam a sua sede.",
      "palavras": [
        { "hebraico": "יַ֭שְׁקוּ", "transliteral": "yaš-qû", "traducao_palavra": "elas dão de beber" },
        { "hebraico": "כָּל־", "transliteral": "kāl-", "traducao_palavra": "a todo" },
        { "hebraico": "חַיְתֹ֣ו", "transliteral": "ḥay-ṯô", "traducao_palavra": "animal de" },
        { "hebraico": "שָׂדָ֑י", "transliteral": "śā-ḏāy", "traducao_palavra": "campo" },
        { "hebraico": "יִשְׁבְּר֥וּ", "transliteral": "yiš-bə-rû", "traducao_palavra": "quebram/saciam" },
        { "hebraico": "פְרָאִ֗ים", "transliteral": "p̄ə-rā-ʾîm", "traducao_palavra": "[os] asnos selvagens" },
        { "hebraico": "צְמָאָֽם׃", "transliteral": "ṣə-mā-ʾām", "traducao_palavra": "sede deles" }
      ]
    },
    "12": {
      "traducao_completa": "Junto delas as aves do céu habitam; cantam entre os ramos.",
      "palavras": [
        { "hebraico": "עֲ֭לֵיהֶם", "transliteral": "ʿă-lê-hem", "traducao_palavra": "sobre/junto a elas" },
        { "hebraico": "עֹוף־", "transliteral": "ʿôp̄-", "traducao_palavra": "ave de" },
        { "hebraico": "הַשָּׁמַ֣יִם", "transliteral": "ha-šā-ma-yim", "traducao_palavra": "os céus" },
        { "hebraico": "יִשְׁכֹּ֑ון", "transliteral": "yiš-kōn", "traducao_palavra": "habita" },
        { "hebraico": "מִבֵּ֥ין", "transliteral": "mib-bên", "traducao_palavra": "de entre" },
        { "hebraico": "עֳ֝פָאיִ֗ם", "transliteral": "ʿo-p̄ā-yim", "traducao_palavra": "folhagens/ramos" },
        { "hebraico": "יִתְּנוּ־", "transliteral": "yit-tə-nû-", "traducao_palavra": "elas dão/emitem" },
