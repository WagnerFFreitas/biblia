      ]
    },
    "13": {
      "traducao_completa": "Ele rega os montes desde as suas câmaras; a terra se farta do fruto das tuas obras.",
      "palavras": [
        { "hebraico": "מַשְׁקֶ֣ה", "transliteral": "maš-qeh", "traducao_palavra": "[ele] rega" },
        { "hebraico": "הָ֭רִים", "transliteral": "hā-rîm", "traducao_palavra": "[os] montes" },
        { "hebraico": "מֵעֲלִיֹּותָ֑יו", "transliteral": "mê-ʿă-li-yyô-ṯāw", "traducao_palavra": "desde as suas câmaras" },
        { "hebraico": "מִפְּרִ֥י", "transliteral": "mip-pə-rî", "traducao_palavra": "do fruto de" },
        { "hebraico": "מַ֝עֲשֶׂ֗יךָ", "transliteral": "ma-ʿă-śey-ḵā", "traducao_palavra": "tuas obras" },
        { "hebraico": "תִּשְׂבַּ֥ע", "transliteral": "tiś-baʿ", "traducao_palavra": "farta-se" },
        { "hebraico": "הָאָֽרֶץ׃", "transliteral": "hā-ʾā-reṣ", "traducao_palavra": "a terra" }
      ]
    },
    "14": {
      "traducao_completa": "Faz crescer a erva para o gado, e a verdura para o serviço do homem, para fazer sair da terra o pão,",
      "palavras": [
        { "hebraico": "מַצְמִ֤יחַ", "transliteral": "maṣ-mî-aḥ", "traducao_palavra": "[o que] faz brotar" },
        { "hebraico": "חָצִ֨יר", "transliteral": "ḥā-ṣîr", "traducao_palavra": "erva" },
        { "hebraico": "לַבְּהֵמָ֗ה", "transliteral": "lab-bə-hē-mā", "traducao_palavra": "para o gado" },
        { "hebraico": "וְ֭עֵשֶׂב", "transliteral": "wə-ʿē-śeḇ", "traducao_palavra": "e erva/planta" },
        { "hebraico": "לַעֲבֹדַ֣ת", "transliteral": "la-ʿă-ḇō-ḏaṯ", "traducao_palavra": "para o serviço de" },
        { "hebraico": "הָאָדָ֑ם", "transliteral": "hā-ʾā-ḏām", "traducao_palavra": "o homem" },
        { "hebraico": "לְהֹוצִ֥יא", "transliteral": "lə-hô-ṣî", "traducao_palavra": "para fazer sair" },
        { "hebraico": "לֶ֝חֶם", "transliteral": "le-ḥem", "traducao_palavra": "pão" },
        { "hebraico": "מִן־", "transliteral": "min-", "traducao_palavra": "da/desde" },
        { "hebraico": "הָאָֽרֶץ׃", "transliteral": "hā-ʾā-reṣ", "traducao_palavra": "a terra" }
      ]
    },
    "15": {
      "traducao_completa": "E o vinho que alegra o coração do homem, e o azeite que faz reluzir o seu rosto, e o pão que fortalece o coração do homem.",
      "palavras": [
        { "hebraico": "וְיַ֤יִן", "transliteral": "wə-ya-yin", "traducao_palavra": "e vinho" },
        { "hebraico": "יְשַׂמַּ֬ח", "transliteral": "yə-śam-maḥ", "traducao_palavra": "[que] alegra" },
        { "hebraico": "לְבַב־", "transliteral": "lə-ḇaḇ-", "traducao_palavra": "coração de" },
        { "hebraico": "אֱנֹ֗ושׁ", "transliteral": "ʾĕ-nôš", "traducao_palavra": "homem" },
        { "hebraico": "לְהַצְהִ֣יל", "transliteral": "lə-haṣ-hîl", "traducao_palavra": "para fazer brilhar" },
        { "hebraico": "פָּנִ֣ים", "transliteral": "pā-nîm", "traducao_palavra": "face/rosto" },
        { "hebraico": "מִשָּׁ֑מֶן", "transliteral": "miš-šā-men", "traducao_palavra": "com azeite" },
        { "hebraico": "וְ֝לֶ֗חֶם", "transliteral": "wə-le-ḥem", "traducao_palavra": "e pão" },
        { "hebraico": "לְבַב־", "transliteral": "lə-ḇaḇ-", "traducao_palavra": "coração de" },
        { "hebraico": "אֱנֹ֥ושׁ", "transliteral": "ʾĕ-nôš", "traducao_palavra": "homem" },
        { "hebraico": "יִסְעָֽד׃", "transliteral": "yiś-ʿāḏ", "traducao_palavra": "sustenta/fortalece" }
      ]
    },
    "16": {
      "traducao_completa": "Fartam-se de seiva as árvores de YHWH, os cedros do Líbano que ele plantou,",
      "palavras": [
        { "hebraico": "יִ֭שְׂבְּעוּ", "transliteral": "yiś-bə-ʿû", "traducao_palavra": "fartam-se/saciam-se" },
