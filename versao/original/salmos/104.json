{
  "livro": "Salmos - תְּהִלִּים - Tehillim",
  "capítulo": 104,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Bendize, ó minha alma, a YHWH! YHWH, Deus meu, tu és magnífico; estás vestido de glória e majestade.",
      "palavras": [
        { "hebraico": "בָּרֲכִ֣י", "transliteral": "bā-ră-ḵî", "traducao_palavra": "bendize" },
        { "hebraico": "נַ֭פְשִׁי", "transliteral": "nap̄-šî", "traducao_palavra": "minha alma" },
        { "hebraico": "אֶת־", "transliteral": "ʾeṯ-", "traducao_palavra": "[objeto]" },
        { "hebraico": "יְהוָ֑ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "יְהוָ֤ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "אֱלֹהַ֨י", "transliteral": "ʾĕ-lō-hay", "traducao_palavra": "Deus meu" },
        { "hebraico": "גָּדַ֪לְתָּ", "transliteral": "gā-ḏal-tā", "traducao_palavra": "tu engrandeceste/foste magnífico" },
        { "hebraico": "מְּאֹ֫ד", "transliteral": "mə-ʾōḏ", "traducao_palavra": "muito" },
        { "hebraico": "הֹוד", "transliteral": "hôḏ", "traducao_palavra": "esplendor" },
        { "hebraico": "וְהָדָ֥ר", "transliteral": "wə-hā-ḏār", "traducao_palavra": "e majestade" },
        { "hebraico": "לָבָֽשְׁתָּ׃", "transliteral": "lā-ḇāš-tā", "traducao_palavra": "tu te vestiste" }
      ]
    },
    "2": {
      "traducao_completa": "Ele se cobre de luz como de um manto; estende os céus como uma cortina.",
      "palavras": [
        { "hebraico": "עֹֽטֶה־", "transliteral": "ʿō-ṭeh-", "traducao_palavra": "cobrindo-se" },
        { "hebraico": "אֹ֭ור", "transliteral": "ʾôr", "traducao_palavra": "[com] luz" },
        { "hebraico": "כַּשַּׂלְמָ֑ה", "transliteral": "kaś-śal-mā", "traducao_palavra": "como um manto" },
        { "hebraico": "נֹוטֶ֥ה", "transliteral": "nô-ṭeh", "traducao_palavra": "[o que] estende" },
        { "hebraico": "שָׁ֝מַ֗יִם", "transliteral": "šā-ma-yim", "traducao_palavra": "[os] céus" },
        { "hebraico": "כַּיְרִיעָֽה׃", "transliteral": "kay-rî-ʿā", "traducao_palavra": "como cortina" }
      ]
    },
    "3": {
      "traducao_completa": "Põe nas águas as vigas das suas câmaras; faz das nuvens o seu carro e anda sobre as asas do vento.",
      "palavras": [
        { "hebraico": "הַ֥מְקָרֶ֥ה", "transliteral": "ham-qā-reh", "traducao_palavra": "[o que] põe as vigas" },
        { "hebraico": "בַמַּ֗יִם", "transliteral": "ḇam-ma-yim", "traducao_palavra": "nas águas" },
        { "hebraico": "עֲלִיֹּ֫ותָ֥יו", "transliteral": "ʿă-li-yyô-ṯāw", "traducao_palavra": "suas câmaras/cenáculos" },
        { "hebraico": "הַשָּׂם־", "transliteral": "haś-śām-", "traducao_palavra": "[o que] põe" },
        { "hebraico": "עָבִ֥ים", "transliteral": "ʿā-ḇîm", "traducao_palavra": "nuvens" },
        { "hebraico": "רְכוּבֹ֑ו", "transliteral": "rə-ḵû-ḇô", "traducao_palavra": "seu carro" },
        { "hebraico": "הַֽ֝מְהַלֵּ֗ךְ", "transliteral": "ham-hal-lēḵ", "traducao_palavra": "[o que] caminha" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre" },
        { "hebraico": "כַּנְפֵי־", "transliteral": "kan-p̄ê-", "traducao_palavra": "as asas de" },
        { "hebraico": "רֽוּחַ׃", "transliteral": "rû-aḥ", "traducao_palavra": "vento" }
      ]
    },
    "4": {
      "traducao_completa": "Faz dos seus anjos espíritos, dos seus ministros um fogo labaredante.",
      "palavras": [
        { "hebraico": "עֹשֶׂ֣ה", "transliteral": "ʿō-śeh", "traducao_palavra": "[o que] faz" },
        { "hebraico": "מַלְאָכָ֣יו", "transliteral": "mal-ʾā-ḵāw", "traducao_palavra": "seus anjos" },
        { "hebraico": "רוּחֹ֑ות", "transliteral": "rû-ḥôṯ", "traducao_palavra": "espíritos/ventos" },
        { "hebraico": "מְ֝שָׁרְתָ֗יו", "transliteral": "mə-šā-rə-ṯāw", "traducao_palavra": "seus ministros" },
        { "hebraico": "אֵ֣שׁ", "transliteral": "ʾēš", "traducao_palavra": "fogo" },
        { "hebraico": "לֹהֵֽט׃", "transliteral": "lō-hēṭ", "traducao_palavra": "labaredante/flamejante" }
      ]
    },
    "5": {
      "traducao_completa": "Lançou os fundamentos da terra, para que não vacile em tempo algum.",
      "palavras": [
        { "hebraico": "יָֽסַד־", "transliteral": "yā-śad-", "traducao_palavra": "fundou" },
        { "hebraico": "אֶ֥רֶץ", "transliteral": "ʾe-reṣ", "traducao_palavra": "[a] terra" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre" },
        { "hebraico": "מְכֹונֶ֑יהָ", "transliteral": "mə-ḵô-ne-hā", "traducao_palavra": "suas bases/fundações" },
        { "hebraico": "בַּל־", "transliteral": "bal-", "traducao_palavra": "para que não" },
        { "hebraico": "תִּ֝מֹּוט", "transliteral": "tim-môṭ", "traducao_palavra": "vacile/seja abalada" },
        { "hebraico": "עֹולָ֥ם", "transliteral": "ʿô-lām", "traducao_palavra": "sempre" },
        { "hebraico": "וָעֶֽד׃", "transliteral": "wā-ʿeḏ", "traducao_palavra": "e eternamente" }
      ]
    },
    "6": {
      "traducao_completa": "Com o abismo a cobriste como com uma veste; as águas pararam sobre os montes.",
      "palavras": [
        { "hebraico": "תְּ֭הֹום", "transliteral": "tə-hôm", "traducao_palavra": "[o] abismo" },
        { "hebraico": "כַּלְּב֥וּשׁ", "transliteral": "kal-lə-ḇûš", "traducao_palavra": "como veste" },
        { "hebraico": "כִּסִּיתֹ֑ו", "transliteral": "kis-śî-ṯô", "traducao_palavra": "tu a cobriste" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre" },
        { "hebraico": "הָ֝רִ֗ים", "transliteral": "hā-rîm", "traducao_palavra": "montes" },
        { "hebraico": "יֳַעַמְדוּ־", "transliteral": "ya-ʿam-ḏû-", "traducao_palavra": "pararam" },
        { "hebraico": "מָֽיִם׃", "transliteral": "mā-yim", "traducao_palavra": "águas" }
      ]
    },
    "7": {
      "traducao_completa": "À tua repreensão fugiram; à voz do teu trovão se apressaram.",
      "palavras": [
        { "hebraico": "מִן־", "transliteral": "min-", "traducao_palavra": "de/por causa de" },
        { "hebraico": "גַּעֲרָתְךָ֥", "transliteral": "ga-ʿă-rā-ṯə-ḵā", "traducao_palavra": "tua repreensão" },
        { "hebraico": "יְנוּס֑וּן", "transliteral": "yə-nû-śûn", "traducao_palavra": "eles fugiram" },
        { "hebraico": "מִן־", "transliteral": "min-", "traducao_palavra": "de/por causa de" },
        { "hebraico": "קֹ֥ול", "transliteral": "qôl", "traducao_palavra": "voz de" },
        { "hebraico": "רַֽ֝עַמְךָ֗", "transliteral": "ra-ʿam-ḵā", "traducao_palavra": "teu trovão" },
        { "hebraico": "יֵחָפֵזֽוּן׃", "transliteral": "yē-ḥā-p̄ē-zûn", "traducao_palavra": "eles se apressaram" }
      ]
    },
    "8": {
      "traducao_completa": "Subiram aos montes, desceram aos vales, até ao lugar que para elas fundaste.",
      "palavras": [
        { "hebraico": "יַעֲל֣וּ", "transliteral": "ya-ʿă-lû", "traducao_palavra": "subiram" },
