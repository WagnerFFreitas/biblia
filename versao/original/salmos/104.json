        { "hebraico": "תִּתֵּ֣ן", "transliteral": "tit-tên", "traducao_palavra": "tu dás" },
        { "hebraico": "לָ֭הֶם", "transliteral": "lā-hem", "traducao_palavra": "a eles" },
        { "hebraico": "יִלְקֹט֑וּן", "transliteral": "yil-qō-ṭûn", "traducao_palavra": "eles colhem" },
        { "hebraico": "תִּפְתַּ֥ח", "transliteral": "tip̄-taḥ", "traducao_palavra": "tu abres" },
        { "hebraico": "יָ֝דְךָ֗", "transliteral": "yā-ḏə-ḵā", "traducao_palavra": "tua mão" },
        { "hebraico": "יִשְׂבְּע֥וּן", "transliteral": "yiś-bə-ʿûn", "traducao_palavra": "eles se fartam/saciam" },
        { "hebraico": "טֹֽוב׃", "transliteral": "ṭôḇ", "traducao_palavra": "[com o] bem" }
      ]
    },
    "29": {
      "traducao_completa": "Escondes o teu rosto, e ficam perturbados; se lhes tiras o fôlego, morrem, e voltam para o seu pó.",
