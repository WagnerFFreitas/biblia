        { "hebraico": "פָּנֶיךָ֮", "transliteral": "pā-ne-ḵā", "traducao_palavra": "teu rosto" },
        { "hebraico": "יִבָּהֵ֫ל֥וּן", "transliteral": "yib-bā-hê-lûn", "traducao_palavra": "ficam perturbados" },
        { "hebraico": "תֹּוסֵ֣ף", "transliteral": "tô-śēp̄", "traducao_palavra": "tu recolhes/tiras" },
        { "hebraico": "רוּחָ֭ם", "transliteral": "rû-ḥām", "traducao_palavra": "o fôlego/espírito deles" },
        { "hebraico": "יִגְוָע֑וּן", "transliteral": "yiḡ-wā-ʿûn", "traducao_palavra": "eles expiram/morrem" },
        { "hebraico": "וְֽאֶל־", "transliteral": "wə-ʾel-", "traducao_palavra": "e para" },
        { "hebraico": "עֲפָרָ֥ם", "transliteral": "ʿă-p̄ā-rām", "traducao_palavra": "o pó deles" },
        { "hebraico": "יְשֻׁבֽוּן׃", "transliteral": "yə-šū-ḇûn", "traducao_palavra": "retornam" }
      ]
    },
    "30": {
      "traducao_completa": "Envias o teu Espírito, e são criados, e assim renovas a face da terra.",
      "palavras": [
        { "hebraico": "תְּשַׁלַּ֣ח", "transliteral": "tə-šal-laḥ", "traducao_palavra": "tu envias" },
        { "hebraico": "רוּחֲךָ֮", "transliteral": "rû-ḥă-ḵā", "traducao_palavra": "teu espírito" },
        { "hebraico": "יִבָּרֵ֫א֥וּן", "transliteral": "yib-bā-rê-ʾûn", "traducao_palavra": "eles são criados" },
        { "hebraico": "וּ֝תְחַדֵּ֗שׁ", "transliteral": "ū-ṯə-ḥad-dēš", "traducao_palavra": "e renovas" },
        { "hebraico": "פְּנֵ֣י", "transliteral": "pə-nê", "traducao_palavra": "[a] face de" },
        { "hebraico": "אֲדָמָֽה׃", "transliteral": "ʾă-ḏā-mā", "traducao_palavra": "terra" }
      ]
    },
    "31": {
      "traducao_completa": "A glória de YHWH durará para sempre; YHWH se alegrará nas suas obras.",
      "palavras": [
        { "hebraico": "יְהִ֤י", "transliteral": "yə-hî", "traducao_palavra": "seja/será" },
        { "hebraico": "כְḇֹ֣וד", "transliteral": "ḵə-ḇôḏ", "traducao_palavra": "[a] glória de" },
        { "hebraico": "יְהוָ֣ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "לְעֹולָ֑ם", "transliteral": "lə-ʿô-lām", "traducao_palavra": "para sempre" },
        { "hebraico": "יִשְׂמַ֖ח", "transliteral": "yiś-maḥ", "traducao_palavra": "alegrar-se-á" },
        { "hebraico": "יְהוָ֣ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "בְּמַעֲשָֽׂיו׃", "transliteral": "bə-ma-ʿă-śāyw", "traducao_palavra": "em suas obras" }
      ]
    },
    "32": {
      "traducao_completa": "Ele olha para a terra, e ela treme; toca nos montes, e eles fumegam.",
      "palavras": [
        { "hebraico": "הַמַּבִּ֣יט", "transliteral": "ham-mab-bîṭ", "traducao_palavra": "[o que] olha" },
        { "hebraico": "לָ֭אָרֶץ", "transliteral": "lā-ʾā-reṣ", "traducao_palavra": "para a terra" },
        { "hebraico": "וַתִּרְעָ֑ד", "transliteral": "wat-tir-ʿāḏ", "traducao_palavra": "e ela treme" },
        { "hebraico": "יִגַּ֖ע", "transliteral": "yig-gaʿ", "traducao_palavra": "[o que] toca" },
        { "hebraico": "בֶּהָרִ֣ים", "transliteral": "be-hā-rîm", "traducao_palavra": "nos montes" },
        { "hebraico": "וְיֶעֱשָֽׁנוּ׃", "transliteral": "wə-ye-ʿĕ-šā-nû", "traducao_palavra": "e eles fumegam" }
      ]
    },
    "33": {
      "traducao_completa": "Cantarei a YHWH enquanto eu viver; cantarei louvores ao meu Deus enquanto eu existir.",
      "palavras": [
        { "hebraico": "אָשִׁ֣ירָה", "transliteral": "ʾā-šî-rā", "traducao_palavra": "cantarei" },
        { "hebraico": "לַיהוָ֣ה", "transliteral": "lay-hwāh", "traducao_palavra": "a YHWH" },
        { "hebraico": "בְּחַיָּ֑י", "transliteral": "bə-ḥay-yāy", "traducao_palavra": "em minha vida" },
        { "hebraico": "אֲזַמְּרָ֖ה", "transliteral": "ʾă-zam-mə-rā", "traducao_palavra": "salmodiarei/cantarei" },
        { "hebraico": "לֵאלֹהַ֣י", "transliteral": "lê-lō-hay", "traducao_palavra": "a meu Deus" },
        { "hebraico": "בְּעֹודִֽי׃", "transliteral": "bə-ʿô-ḏî", "traducao_palavra": "enquanto eu existir" }
      ]
    },
    "34": {
