        { "hebraico": "יְהוָ֑ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "אַרְזֵ֥י", "transliteral": "ʾar-zê", "traducao_palavra": "cedros de" },
