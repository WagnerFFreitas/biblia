    "17": {
      "traducao_completa": "Onde as aves fazem os seus ninhos; quanto à cegonha, a sua casa é nos ciprestes.",
      "palavras": [
        { "hebraico": "אֲשֶׁר־", "transliteral": "ʾă-šer-", "traducao_palavra": "onde" },
        { "hebraico": "שָׁ֭ם", "transliteral": "šām", "traducao_palavra": "ali" },
        { "hebraico": "צִפֳּרִ֣ים", "transliteral": "ṣip-pŏ-rîm", "traducao_palavra": "aves/pássaros" },
        { "hebraico": "יְקַנֵּ֑נוּ", "transliteral": "yə-qan-nē-nû", "traducao_palavra": "fazem ninhos" },
        { "hebraico": "חֲ֝סִידָ֗ה", "transliteral": "ḥă-śî-ḏā", "traducao_palavra": "[a] cegonha" },
        { "hebraico": "בְּרֹושִׁ֥ים", "transliteral": "bə-rô-šîm", "traducao_palavra": "[nos] ciprestes/pinheiros" },
