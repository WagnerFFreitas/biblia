        { "hebraico": "הַ֭גְּבֹהִים", "transliteral": "hag-gə-ḇō-hîm", "traducao_palavra": "altos" },
        { "hebraico": "לַיְּעֵלִ֑ים", "transliteral": "lay-yə-ʿê-lîm", "traducao_palavra": "para as cabras montesas" },
