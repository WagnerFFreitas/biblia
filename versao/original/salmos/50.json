        { "hebraico": "לָ֑ךְ", "transliteral": "lāḵ", "traducao_palavra": "a ti" },
        { "hebraico": "כִּֽי־לִ֥י", "transliteral": "kî-lî", "traducao_palavra": "pois meu [é]" },
        { "hebraico": "תֵ֝ḇֵ֗ל", "transliteral": "tē-ḇēl", "traducao_palavra": "[o] mundo" },
        { "hebraico": "וּמְלֹאָֽהּ׃", "transliteral": "ū-mə-lô-ʾāh", "traducao_palavra": "e a sua plenitude" }
      ]
    },
    "13": {
      "traducao_completa": "Comerei eu carne de touros? Ou beberei sangue de bodes?",
