      ]
    },
    "15": {
      "traducao_completa": "E invoca-me no dia da angústia; eu te livrarei, e tu me glorificarás.",
      "palavras": [
        { "hebraico": "וּ֭קְרָאֵנִי", "transliteral": "ū-qə-rā-ʾē-nî", "traducao_palavra": "e invoca-me" },
