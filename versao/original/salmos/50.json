        { "hebraico": "בְּהַרְרֵי־אָֽלֶף׃", "transliteral": "bə-har-rê-ʾā-lep̄", "traducao_palavra": "em milhares de montanhas" }
      ]
    },
    "11": {
      "traducao_completa": "Conheço todas as aves dos montes; e as feras do campo são minhas.",
      "palavras": [
        { "hebraico": "יָ֭דַעְתִּי", "transliteral": "yā-ḏaʿ-tî", "traducao_palavra": "conheço" },
