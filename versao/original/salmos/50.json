      ]
    },
    "17": {
      "traducao_completa": "Visto que odeias a disciplina e lanças as minhas palavras para trás de ti.",
      "palavras": [
        { "hebraico": "וְ֭אַתָּה", "transliteral": "wə-ʾat-tā", "traducao_palavra": "visto que tu" },
