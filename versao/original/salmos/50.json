    "14": {
      "traducao_completa": "Oferece a Deus sacrifício de louvor e paga os teus votos ao Altíssimo.",
      "palavras": [
        { "hebraico": "זְבַ֣ח", "transliteral": "zə-ḇaḥ", "traducao_palavra": "sacrifica/oferece" },
        { "hebraico": "לֵאלֹהִ֣ים", "transliteral": "lē-lō-hîm", "traducao_palavra": "a Deus" },
        { "hebraico": "תֹּודָ֑ה", "transliteral": "tô-ḏā", "traducao_palavra": "[sacrifício de] louvor/gratidão" },
        { "hebraico": "וְשַׁלֵּ֥ם", "transliteral": "wə-šal-lēm", "traducao_palavra": "e paga/cumpre" },
