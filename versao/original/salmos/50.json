{
  "livro": "Salmos - תְּהִלִּים - Tehillim",
  "capítulo": 50,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Salmo de Asafe. O Poderoso, Deus, YHWH, falou e chamou a terra desde o nascimento do sol até ao seu ocaso.",
      "palavras": [
        { "hebraico": "מִזְמֹ֥ור", "transliteral": "miz-môr", "traducao_palavra": "salmo" },
        { "hebraico": "לְאָסָ֑ף", "transliteral": "lə-ʾā-sāp̄", "traducao_palavra": "de Asafe" },
        { "hebraico": "אֵ֤ל ׀", "transliteral": "ʾēl", "traducao_palavra": "[O] Poderoso/Deus" },
        { "hebraico": "אֱלֹהִ֣ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "Deus" },
        { "hebraico": "יְהוָה֮", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "דִּבֶּ֥ר", "transliteral": "dib-bēr", "traducao_palavra": "falou" },
        { "hebraico": "וַיִּקְרָא־אָ֑רֶץ", "transliteral": "way-yiq-rā-ʾā-reṣ", "traducao_palavra": "e chamou a terra" },
        { "hebraico": "מִמִּזְרַח־שֶׁ֝מֶשׁ", "transliteral": "mim-miz-raḥ-še-meš", "traducao_palavra": "desde o nascente do sol" },
        { "hebraico": "עַד־מְבֹאֹֽו׃", "transliteral": "ʿaḏ-mə-ḇō-ʾô", "traducao_palavra": "até o seu ocaso/entrada" }
      ]
    },
    "2": {
      "traducao_completa": "Desde Sião, a perfeição da beleza, Deus resplandeceu.",
      "palavras": [
        { "hebraico": "מִצִּיֹּ֥ון", "transliteral": "miṣ-ṣiy-yôn", "traducao_palavra": "desde Sião" },
        { "hebraico": "מִכְלַל־יֹ֗פִי", "transliteral": "miḵ-lal-yō-p̄î", "traducao_palavra": "[a] perfeição de beleza" },
        { "hebraico": "אֱלֹהִ֥ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "Deus" },
        { "hebraico": "הֹופִֽיעַ׃", "transliteral": "hô-p̄î-aʿ", "traducao_palavra": "resplandeceu" }
      ]
    },
    "3": {
      "traducao_completa": "Virá o nosso Deus e não se calará; um fogo devorador irá adiante dele, e haverá grande tormenta ao seu redor.",
      "palavras": [
        { "hebraico": "יָ֘בֹ֤א", "transliteral": "yā-ḇō", "traducao_palavra": "virá" },
        { "hebraico": "אֱלֹהֵ֨ינוּ ׀", "transliteral": "ʾĕ-lō-hê-nû", "traducao_palavra": "nosso Deus" },
        { "hebraico": "וְאַֽל־יֶחֱרַשׁ", "transliteral": "wə-ʾal-ye-ḥĕ-raš", "traducao_palavra": "e não se calará" },
        { "hebraico": "אֵשׁ־לְפָנָ֥יו", "transliteral": "ʾēš-lə-p̄ā-nāw", "traducao_palavra": "fogo diante dele" },
        { "hebraico": "תֹּאכֵ֑ל", "transliteral": "tō-ḵēl", "traducao_palavra": "devorará" },
        { "hebraico": "וּ֝סְבִיבָ֗יו", "transliteral": "ū-śə-ḇî-ḇāw", "traducao_palavra": "e ao redor dele" },
        { "hebraico": "נִשְׂעֲרָ֥ה", "transliteral": "niś-ʿă-rā", "traducao_palavra": "[haverá] tempestade" },
        { "hebraico": "מְאֹֽד׃", "transliteral": "mə-ʾōḏ", "traducao_palavra": "muito/grande" }
      ]
    },
    "4": {
      "traducao_completa": "Chamará os céus lá do alto e a terra, para julgar o seu povo.",
      "palavras": [
        { "hebraico": "יִקְרָ֣א", "transliteral": "yiq-rā", "traducao_palavra": "chamará" },
        { "hebraico": "אֶל־הַשָּׁמַ֣יִם", "transliteral": "ʾel-haš-šā-ma-yim", "traducao_palavra": "aos céus" },
        { "hebraico": "מֵעָ֑ל", "transliteral": "mē-ʿāl", "traducao_palavra": "lá do alto" },
        { "hebraico": "וְאֶל־הָ֝אָ֗רֶץ", "transliteral": "wə-ʾel-hā-ʾā-reṣ", "traducao_palavra": "e à terra" },
        { "hebraico": "לָדִ֥ין", "transliteral": "lā-ḏîn", "traducao_palavra": "para julgar" },
        { "hebraico": "עַמֹּֽו׃", "transliteral": "ʿam-mô", "traducao_palavra": "seu povo" }
      ]
    },
    "5": {
      "traducao_completa": "Ajuntai-me os meus santos, aqueles que fizeram comigo uma aliança com sacrifícios.",
      "palavras": [
        { "hebraico": "אִסְפוּ־לִ֥י", "transliteral": "ʾis-p̄û-lî", "traducao_palavra": "ajuntai para mim" },
        { "hebraico": "חֲסִידָ֑י", "transliteral": "ḥă-śî-ḏāy", "traducao_palavra": "meus santos/fiéis" },
        { "hebraico": "כֹּרְתֵ֖י", "transliteral": "kō-rə-ṯê", "traducao_palavra": "fazedores de" },
        { "hebraico": "בְרִיתִ֣י", "transliteral": "ḇə-rî-ṯî", "traducao_palavra": "minha aliança" },
        { "hebraico": "עֲלֵי־זָֽבַח׃", "transliteral": "ʿă-lê-zā-ḇaḥ", "traducao_palavra": "sobre/com sacrifício" }
      ]
    },
    "6": {
      "traducao_completa": "E os céus anunciarão a sua justiça; pois Deus mesmo é o Juiz. (Selah)",
      "palavras": [
        { "hebraico": "וַיַּגִּ֣ידוּ", "transliteral": "way-yag-gî-ḏû", "traducao_palavra": "e anunciarão" },
        { "hebraico": "שָׁמַ֣יִם", "transliteral": "šā-ma-yim", "traducao_palavra": "os céus" },
        { "hebraico": "צִדְקֹ֑ו", "transliteral": "ṣiḏ-qô", "traducao_palavra": "sua justiça" },
        { "hebraico": "כִּֽי־אֱלֹהִ֓ים ׀", "transliteral": "kî-ʾĕ-lō-hîm", "traducao_palavra": "porque Deus" },
        { "hebraico": "שֹׁפֵ֖ט", "transliteral": "šō-p̄ēṭ", "traducao_palavra": "[é] Juiz" },
