        { "hebraico": "וַתִּ֣רֶץ", "transliteral": "wat-ti-reṣ", "traducao_palavra": "então te agradaste" },
        { "hebraico": "עִמֹּ֑ו", "transliteral": "ʿim-mô", "traducao_palavra": "com ele" },
