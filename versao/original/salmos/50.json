        { "hebraico": "סֶֽלָה׃", "transliteral": "se-lā", "traducao_palavra": "Selah [pausa]" }
      ]
    },
    "7": {
      "traducao_completa": "Ouve, povo meu, e eu falarei; ó Israel, e eu protestarei contra ti; eu sou Deus, o teu Deus.",
      "palavras": [
        { "hebraico": "שִׁמְעָ֤ה", "transliteral": "šim-ʿā", "traducao_palavra": "ouve" },
        { "hebraico": "עַמִּ֨י ׀", "transliteral": "ʿam-mî", "traducao_palavra": "povo meu" },
        { "hebraico": "וַאֲדַבֵּ֗רָה", "transliteral": "wa-ʾă-ḏab-bē-rā", "traducao_palavra": "e eu falarei" },
        { "hebraico": "יִשְׂרָאֵ֭ל", "transliteral": "yiś-rā-ʾēl", "traducao_palavra": "Israel" },
        { "hebraico": "וְאָעִ֣ידָה", "transliteral": "wə-ʾā-ʿî-ḏā", "traducao_palavra": "e eu protestarei/testemunharei" },
        { "hebraico": "בָּ֑ךְ", "transliteral": "bāḵ", "traducao_palavra": "contra ti" },
        { "hebraico": "אֱלֹהִ֖ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "Deus" },
        { "hebraico": "אֱלֹהֶ֣יךָ", "transliteral": "ʾĕ-lō-he-ḵā", "traducao_palavra": "teu Deus" },
        { "hebraico": "אָֽנִי׃", "transliteral": "ʾā-nî", "traducao_palavra": "[sou] eu" }
      ]
    },
    "8": {
      "traducao_completa": "Não te repreendo pelos teus sacrifícios, nem pelos teus holocaustos, que estão continuamente perante mim.",
      "palavras": [
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "עַל־זְ֭בָחֶיךָ", "transliteral": "ʿal-zə-ḇā-ḥey-ḵā", "traducao_palavra": "pelos teus sacrifícios" },
        { "hebraico": "אֹוכִיחֶ֑ךָ", "transliteral": "ʾô-ḵî-ḥe-ḵā", "traducao_palavra": "repreenderei a ti" },
        { "hebraico": "וְעֹולֹתֶ֖יךָ", "transliteral": "wə-ʿô-lō-ṯey-ḵā", "traducao_palavra": "e teus holocaustos" },
        { "hebraico": "לְנֶגְדִּ֣י", "transliteral": "lə-neḡ-dî", "traducao_palavra": "diante de mim" },
        { "hebraico": "תָמִֽיד׃", "transliteral": "ṯā-mîḏ", "traducao_palavra": "continuamente" }
