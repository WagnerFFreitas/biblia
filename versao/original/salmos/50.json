        { "hebraico": "צָרָ֑ה", "transliteral": "ṣā-rā", "traducao_palavra": "angústia" },
        { "hebraico": "אֲ֝חַלֶּצְךָ֗", "transliteral": "ʾă-ḥal-leṣ-ḵā", "traducao_palavra": "eu te livrarei" },
