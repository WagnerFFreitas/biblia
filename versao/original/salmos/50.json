        { "hebraico": "אַבִּירִ֑ים", "transliteral": "ʾab-bî-rîm", "traducao_palavra": "touros/fortes" },
        { "hebraico": "וְדַ֖ם", "transliteral": "wə-ḏam", "traducao_palavra": "e sangue de" },
        { "hebraico": "עַתּוּדִ֣ים", "transliteral": "ʿat-tû-ḏîm", "traducao_palavra": "bodes" },
