      ]
    },
    "19": {
      "traducao_completa": "Soltas a tua boca para o mal, e a tua língua trama enganos.",
      "palavras": [
        { "hebraico": "פִּ֭יךָ", "transliteral": "pî-ḵā", "traducao_palavra": "tua boca" },
        { "hebraico": "שִׁלַּ֣חְתָּ", "transliteral": "šil-laḥ-tā", "traducao_palavra": "soltaste/enviaste" },
        { "hebraico": "בְרָעָ֑ה", "transliteral": "ḇə-rā-ʿā", "traducao_palavra": "no mal" },
        { "hebraico": "וּ֝לְשֹׁונְךָ֗", "transliteral": "ū-lə-šô-nə-ḵā", "traducao_palavra": "e tua língua" },
        { "hebraico": "תַּצְמִ֥יד", "transliteral": "taṣ-mîḏ", "traducao_palavra": "prende/trama" },
        { "hebraico": "מִרְמָֽה׃", "transliteral": "mir-mā", "traducao_palavra": "engano" }
      ]
    },
    "20": {
      "traducao_completa": "Assentas-te a falar contra o teu irmão; difamas o filho de tua mãe.",
      "palavras": [
        { "hebraico": "תֵּ֭שֵׁב", "transliteral": "tē-šēḇ", "traducao_palavra": "assentas-te" },
        { "hebraico": "בְּאָחִ֣יךָ", "transliteral": "bə-ʾā-ḥî-ḵā", "traducao_palavra": "contra teu irmão" },
        { "hebraico": "תְדַבֵּ֑ר", "transliteral": "ṯə-ḏab-bēr", "traducao_palavra": "falas" },
        { "hebraico": "בְּבֶן־אִ֝מְּךָ֗", "transliteral": "bə-ḇen-ʾim-mə-ḵā", "traducao_palavra": "contra o filho de tua mãe" },
        { "hebraico": "תִּתֶּן־דֹּֽפִי׃", "transliteral": "tit-ten-dō-p̄î", "traducao_palavra": "pões mancha/difamas" }
      ]
    },
    "21": {
      "traducao_completa": "Estas coisas tens feito, e eu me calei; pensavas que eu era tal como tu; mas eu te repreenderei, e as porei em ordem diante dos teus olhos.",
      "palavras": [
        { "hebraico": "אֵ֤לֶּה", "transliteral": "ʾēl-leh", "traducao_palavra": "estas [coisas]" },
        { "hebraico": "עָשִׂ֨יתָ", "transliteral": "ʿā-śî-ṯā", "traducao_palavra": "fizeste" },
        { "hebraico": "וְהֶחֱרַ֗שְׁתִּי", "transliteral": "wə-he-ḥĕ-raš-tî", "traducao_palavra": "e eu me calei" },
        { "hebraico": "דִּמִּ֥יתָ", "transliteral": "dim-mî-ṯā", "traducao_palavra": "pensaste/imaginaste" },
        { "hebraico": "הֱיֹֽות־אֶהְיֶ֪ה", "transliteral": "hĕ-yôṯ-ʾeh-yeh", "traducao_palavra": "que eu seria" },
        { "hebraico": "כָ֫מֹ֥וכָה", "transliteral": "ḵā-mô-ḵā", "traducao_palavra": "como tu" },
        { "hebraico": "אֹוכִיחֲךָ֥", "transliteral": "ʾô-ḵî-ḥă-ḵā", "traducao_palavra": "repreenderei a ti" },
        { "hebraico": "ו_אֶעֶרְכָ֖ה", "transliteral": "wə-ʾe-ʿer-ḵā", "traducao_palavra": "e porei em ordem" },
        { "hebraico": "לְעֵינֶֽיךָ׃", "transliteral": "lə-ʿê-ne-ḵā", "traducao_palavra": "diante de teus olhos" }
      ]
    },
    "22": {
      "traducao_completa": "Considerai, pois, isto, vós que vos esqueceis de Deus; para que eu não vos despedace, sem que haja quem vos livre.",
      "palavras": [
        { "hebraico": "בִּֽינוּ־נָ֣א", "transliteral": "bî-nû-nā", "traducao_palavra": "entendei/considerai agora" },
        { "hebraico": "זֹ֭את", "transliteral": "zōṯ", "traducao_palavra": "isto" },
        { "hebraico": "שֹׁכְחֵ֣י", "transliteral": "šō-ḵə-ḥê", "traducao_palavra": "ó esquecidos de" },
        { "hebraico": "אֱלֹ֑והַּ", "transliteral": "ʾĕ-lô-ah", "traducao_palavra": "Deus" },
        { "hebraico": "פֶּן־אֶ֝טְרֹ֗ף", "transliteral": "pen-ʾeṭ-rōp̄", "traducao_palavra": "para que [eu] não despedace" },
        { "hebraico": "וְאֵ֣ין", "transliteral": "wə-ʾên", "traducao_palavra": "e não [haja]" },
        { "hebraico": "מַצִּֽיל׃", "transliteral": "maṣ-ṣîl", "traducao_palavra": "quem livre/salve" }
      ]
    },
    "23": {
      "traducao_completa": "Aquele que oferece sacrifício de louvor me glorificará; e àquele que ordena o seu caminho eu mostrarei a salvação de Deus.",
      "palavras": [
        { "hebraico": "זֹבֵ֥חַ", "transliteral": "zō-ḇē-aḥ", "traducao_palavra": "o que sacrifica" },
        { "hebraico": "תֹּודָ֗ה", "transliteral": "tô-ḏā", "traducao_palavra": "[com] ação de graças" },
        { "hebraico": "יְֽכַבְּדָ֫נְנִי", "transliteral": "yə-ḵab-bə-ḏā-nə-nî", "traducao_palavra": "me glorificará" },
        { "hebraico": "וְשָׂ֥ם", "transliteral": "wə-śām", "traducao_palavra": "e o que prepara/põe" },
        { "hebraico": "דֶּ֑רֶךְ", "transliteral": "de-reḵ", "traducao_palavra": "[seu] caminho" },
        { "hebraico": "אַ֝רְאֶ֗נּוּ", "transliteral": "ʾar-ʾen-nû", "traducao_palavra": "mostrarei a ele" },
        { "hebraico": "בְּיֵ֣שַׁע", "transliteral": "bə-yē-šaʿ", "traducao_palavra": "[a] salvação de" },
        { "hebraico": "אֱלֹהִֽים׃", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "Deus" }
      ]
    }
  }
