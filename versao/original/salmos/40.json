        { "hebraico": "שִׁ֥יר", "transliteral": "šîr", "traducao_palavra": "cântico" },
        { "hebraico": "חָדָשׁ֮", "transliteral": "ḥā-ḏāš", "traducao_palavra": "novo" },
        { "hebraico": "תְּהִלָּ֪ה", "transliteral": "tə-hil-lā", "traducao_palavra": "louvor/hino" },
