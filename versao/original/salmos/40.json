      ]
    },
    "3": {
      "traducao_completa": "Tirou-me de um poço de perdição, de um lodaçal de lama; colocou os meus pés sobre uma rocha e firmou os meus passos.",
      "palavras": [
        { "hebraico": "וַיַּעֲלֵ֤נִי", "transliteral": "way-ya-ʿă-lē-nî", "traducao_palavra": "e ele me subiu/tirou" },
