    "6": {
      "traducao_completa": "Muitas são, YHWH Deus meu, as tuas maravilhas que tens feito, e os teus pensamentos para conosco; ninguém há que se possa comparar a ti; se eu os quisesse anunciar e falar deles, seriam mais do que se podem contar.",
      "palavras": [
        { "hebraico": "רַבֹּ֤ות", "transliteral": "rab-bôṯ", "traducao_palavra": "muitas" },
        { "hebraico": "עָשִׂ֨יתָ", "transliteral": "ʿā-śî-ṯā", "traducao_palavra": "fizeste" },
        { "hebraico": "אַתָּ֤ה", "transliteral": "ʾat-tā", "traducao_palavra": "tu" },
        { "hebraico": "יְהוָ֣ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "אֱלֹהַי֮", "transliteral": "ʾĕ-lō-hay", "traducao_palavra": "Deus meu" },
        { "hebraico": "נִפְלְאֹתֶ֥יךָ", "transliteral": "nip̄-lə-ʾō-ṯê-ḵā", "traducao_palavra": "tuas maravilhas" },
        { "hebraico": "וּמַחְשְׁבֹתֶ֗יךָ", "transliteral": "ū-maḥ-šə-ḇō-ṯê-ḵā", "traducao_palavra": "e teus pensamentos" },
