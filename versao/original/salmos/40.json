        { "hebraico": "בִּמְגִלַּת־סֵ֝֗פֶר", "transliteral": "bim-ḡil-laṯ-śē-p̄er", "traducao_palavra": "no rolo do livro" },
        { "hebraico": "כָּ֥תּוּב", "transliteral": "kā-ṯûḇ", "traducao_palavra": "está escrito" },
