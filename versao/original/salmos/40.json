        { "hebraico": "הַגֶּ֗בֶר", "transliteral": "hag-ge-ḇer", "traducao_palavra": "o homem" },
        { "hebraico": "אֲשֶׁר־שָׂ֣ם", "transliteral": "ʾă-šer-śām", "traducao_palavra": "que pôs" },
        { "hebraico": "יְהֹוָ֣ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
