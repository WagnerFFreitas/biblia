        { "hebraico": "וּמִנְחָ֨ה", "transliteral": "ū-min-ḥā", "traducao_palavra": "e oferta de manjares" },
        { "hebraico": "לֹֽא־חָפַ֗צְתָּ", "transliteral": "lō-ḥā-p̄aṣ-tā", "traducao_palavra": "não desejaste" },
