    "11": {
      "traducao_completa": "Não escondi a tua justiça dentro do meu coração; apregoei a tua fidelidade e a tua salvação; não ocultei a tua benignidade e a tua verdade da grande congregação.",
      "palavras": [
        { "hebraico": "צִדְקָתְךָ֨", "transliteral": "ṣiḏ-qā-ṯə-ḵā", "traducao_palavra": "tua justiça" },
