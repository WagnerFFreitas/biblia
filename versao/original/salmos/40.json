        { "hebraico": "יְהוָ֑ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "וַיֵּ֥ט", "transliteral": "way-yēṭ", "traducao_palavra": "e ele inclinou" },
        { "hebraico": "אֵ֝לַי", "transliteral": "ʾē-lay", "traducao_palavra": "para mim" },
