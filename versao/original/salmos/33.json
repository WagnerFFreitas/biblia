        { "hebraico": "הַ֭גֹּוי", "transliteral": "hag-gôy", "traducao_palavra": "a nação" },
        { "hebraico": "אֲשֶׁר־יְהוָ֣ה", "transliteral": "ʾă-šer-YHWH", "traducao_palavra": "que YHWH [é]" },
