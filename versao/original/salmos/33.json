        { "hebraico": "כָּל־יֹשְׁבֵ֣י", "transliteral": "kāl-yō-šə-ḇê", "traducao_palavra": "todos os moradores de" },
        { "hebraico": "הָאָֽרֶץ׃", "transliteral": "hā-ʾā-reṣ", "traducao_palavra": "a terra" }
