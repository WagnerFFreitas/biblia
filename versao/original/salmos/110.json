        { "hebraico": "יִשְׁלַ֣ח", "transliteral": "yišlaḥ", "traducao_palavra": "enviará" },
        { "hebraico": "יְ֭הוָה", "transliteral": "yəhwāh", "traducao_palavra": "YHWH" },
        { "hebraico": "מִצִּיֹּ֑ון", "transliteral": "miṣṣiyyôn", "traducao_palavra": "de Sião" },
