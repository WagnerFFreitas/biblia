        { "hebraico": "אָשִׁ֥ית", "transliteral": "ʾāšîṯ", "traducao_palavra": "eu ponha" },
        { "hebraico": "אֹ֝יְבֶ֗יךָ", "transliteral": "ʾōyəḇeyḵā", "traducao_palavra": "teus inimigos" },
        { "hebraico": "הֲדֹ֥ם", "transliteral": "hăḏōm", "traducao_palavra": "[por] estrado de" },
        { "hebraico": "לְרַגְלֶֽיךָ׃", "transliteral": "ləraḡleyḵā", "traducao_palavra": "teus pés" }
