        { "hebraico": "נְאֻ֧ם", "transliteral": "nəʾum", "traducao_palavra": "declaração/disse" },
        { "hebraico": "יְהוָ֨ה", "transliteral": "yəhwāh", "traducao_palavra": "YHWH" },
        { "hebraico": "לַאדֹנִ֗י", "transliteral": "laʾḏōnî", "traducao_palavra": "ao meu Senhor" },
        { "hebraico": "שֵׁ֥ב", "transliteral": "šēḇ", "traducao_palavra": "assenta-te" },
