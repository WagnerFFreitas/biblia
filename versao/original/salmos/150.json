        { "hebraico": "הַֽלְלוּ־", "transliteral": "hal-lû-", "traducao_palavra": "louvai" },
        { "hebraico": "אֵ֥ל", "transliteral": "ʾēl", "traducao_palavra": "[a] Deus" },
        { "hebraico": "בְּקָדְשֹׁ֑ו", "transliteral": "bə-qāḏ-šô", "traducao_palavra": "no seu santuário/santidade" },
        { "hebraico": "הַֽ֝לְלוּהוּ", "transliteral": "hal-lû-hû", "traducao_palavra": "louvai-o" },
