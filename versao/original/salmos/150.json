        { "hebraico": "הַֽ֝לְלוּהוּ", "transliteral": "hal-lû-hû", "traducao_palavra": "louvai-o" },
        { "hebraico": "כְּרֹ֥ב", "transliteral": "kə-rōḇ", "traducao_palavra": "conforme a abundância de" },
