        { "hebraico": "יְּדִידֹ֥ות", "transliteral": "yəḏîḏôṯ", "traducao_palavra": "amáveis/amados" },
        { "hebraico": "מִשְׁכְּנֹותֶ֗יךָ", "transliteral": "miškənôṯeyḵā", "traducao_palavra": "teus tabernáculos/moradas" },
