    "10": {
      "traducao_completa": "Envergonhem-se e perturbem-se muito todos os meus inimigos; tornem atrás e envergonhem-se num momento.",
      "palavras": [
        { "hebraico": "יֵבֹ֤שׁוּ", "transliteral": "yê-ḇō-šû", "traducao_palavra": "Envergonhem-se" },
