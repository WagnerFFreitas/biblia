{
  "livro": "Salmos - תְּהִלִּים - Tə-hil-lîm",
  "capítulo": 6,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Ao mestre de canto, com instrumentos de cordas, sobre a oitava. Salmo de Davi. YHWH, não me repreendas na tua ira, nem me castigues no teu furor.",
      "palavras": [
        { "hebraico": "לַמְנַצֵּ֣חַ", "transliteral": "lam-naṣ-ṣê-aḥ", "traducao_palavra": "Ao mestre de canto" },
        { "hebraico": "בִּנְגִינֹ֭ות", "transliteral": "bin-ḡî-nô-wṯ", "traducao_palavra": "com instrumentos de cordas" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre" },
        { "hebraico": "הַשְּׁמִינִ֗ית", "transliteral": "haš-šə-mî-nîṯ", "traducao_palavra": "a oitava [instrumento ou tom]" },
        { "hebraico": "מִזְמֹ֥ור", "transliteral": "miz-môr", "traducao_palavra": "salmo" },
        { "hebraico": "לְדָוִֽד", "transliteral": "lə-ḏā-wiḏ", "traducao_palavra": "de Davi" },
        { "hebraico": "יְהוָ֗ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "אַל־", "transliteral": "ʾal-", "traducao_palavra": "não" },
        { "hebraico": "בְּאַפְּךָ֥", "transliteral": "bə-ʾap-pə-ḵā", "traducao_palavra": "na Tua ira" },
        { "hebraico": "תֹוכִיחֵ֑נִי", "transliteral": "ṯô-ḵî-ḥê-nî", "traducao_palavra": "me repreendas" },
        { "hebraico": "וְֽאַל־", "transliteral": "wə-ʾal-", "traducao_palavra": "e não" },
        { "hebraico": "בַּחֲמָתְךָ֥", "transliteral": "ba-ḥă-mā-ṯə-ḵā", "traducao_palavra": "no Teu furor" },
        { "hebraico": "תְּיַסְּרֵֽנִי", "transliteral": "tə-yas-śə-rê-nî", "traducao_palavra": "me castigues" }
      ]
    },
    "2": {
      "traducao_completa": "Tem misericórdia de mim, YHWH, porque sou fraco; sara-me, YHWH, porque os meus ossos estão perturbados.",
      "palavras": [
        { "hebraico": "חָנֵּ֥נִי", "transliteral": "ḥān-nê-nî", "traducao_palavra": "Tem misericórdia de mim" },
        { "hebraico": "יְהוָה֮", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "כִּ֤י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "אֻמְלַ֫ל", "transliteral": "ʾum-lal", "traducao_palavra": "fraco/murcho" },
        { "hebraico": "אָ֥נִי", "transliteral": "ʾā-nî", "traducao_palavra": "eu [sou]" },
        { "hebraico": "רְפָאֵ֥נִי", "transliteral": "rə-p̄ā-ʾê-nî", "traducao_palavra": "sara-me" },
        { "hebraico": "יְהוָ֑ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "כִּ֖י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "נִבְהֲל֣וּ", "transliteral": "niḇ-hă-lû", "traducao_palavra": "estão perturbados/estremecidos" },
        { "hebraico": "עֲצָמָֽי׃", "transliteral": "ʿă-ṣā-māy", "traducao_palavra": "meus ossos" }
      ]
    },
    "3": {
      "traducao_completa": "Até a minha alma está mui perturbada; mas tu, YHWH, até quando?",
      "palavras": [
        { "hebraico": "וְ֝נַפְשִׁ֗י", "transliteral": "wə-nap̄-šî", "traducao_palavra": "E minha alma" },
        { "hebraico": "נִבְהֲלָ֥ה", "transliteral": "niḇ-hă-lā", "traducao_palavra": "está perturbada" },
        { "hebraico": "מְאֹ֑ד", "transliteral": "mə-ʾōḏ", "traducao_palavra": "muito" },
        { "hebraico": "וְאַתָּ֣ה", "transliteral": "wə-ʾat-tā", "traducao_palavra": "e Tu" },
        { "hebraico": "יְ֝הוָה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "עַד־", "transliteral": "ʿaḏ-", "traducao_palavra": "até" },
        { "hebraico": "מָתָֽי׃", "transliteral": "mā-ṯāy", "traducao_palavra": "quando?" }
      ]
    },
    "4": {
      "traducao_completa": "Volta-te, YHWH, livra a minha alma; salva-me por tua benignidade.",
      "palavras": [
        { "hebraico": "שׁוּבָ֣ה", "transliteral": "šû-ḇā", "traducao_palavra": "Volta-te" },
        { "hebraico": "יְ֭הוָה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
