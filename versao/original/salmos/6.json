        { "hebraico": "אַמְסֶֽה׃", "transliteral": "ʾam-śeh", "traducao_palavra": "molho/dissolvo" }
      ]
    },
    "7": {
      "traducao_completa": "Já os meus olhos estão consumidos pela mágoa, e envelhecem por causa de todos os meus inimigos.",
      "palavras": [
        { "hebraico": "עָשְׁשָׁ֣ה", "transliteral": "ʿā-šə-šā", "traducao_palavra": "Consumiu-se/Enfraqueceu" },
        { "hebraico": "מִכַּ֣עַס", "transliteral": "mik-ka-ʿaś", "traducao_palavra": "de mágoa/ira" },
        { "hebraico": "עֵינִ֑י", "transliteral": "ʿê-nî", "traducao_palavra": "meu olho" },
        { "hebraico": "עָ֝תְקָ֗ה", "transliteral": "ʿā-ṯə-qā", "traducao_palavra": "envelheceu" },
        { "hebraico": "בְּכָל־", "transliteral": "bə-ḵāl-", "traducao_palavra": "por causa de todos" },
        { "hebraico": "צֹורֲרָֽי׃", "transliteral": "ṣô-rə-rāy", "traducao_palavra": "meus inimigos/opressores" }
      ]
    },
    "8": {
      "traducao_completa": "Apartai-vos de mim todos os que praticais a iniquidade; porque YHWH ouviu a voz do meu choro.",
      "palavras": [
        { "hebraico": "ס֣וּרוּ", "transliteral": "śû-rû", "traducao_palavra": "Apartai-vos" },
        { "hebraico": "מִ֭מֶּנִּי", "transliteral": "mim-men-nî", "traducao_palavra": "de mim" },
        { "hebraico": "כָּל־", "transliteral": "kāl-", "traducao_palavra": "todos" },
        { "hebraico": "פֹּ֣עֲלֵי", "transliteral": "pō-ʿă-lê", "traducao_palavra": "[os] praticantes de" },
        { "hebraico": "אָ֑וֶן", "transliteral": "ʾā-wen", "traducao_palavra": "iniquidade" },
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "porque" },
        { "hebraico": "שָׁמַ֥ע", "transliteral": "šā-maʿ", "traducao_palavra": "ouviu" },
        { "hebraico": "יְ֝הוָה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "קֹ֣ול", "transliteral": "qôl", "traducao_palavra": "[a] voz de" },
        { "hebraico": "בִּכְיִֽי׃", "transliteral": "biḵ-yî", "traducao_palavra": "meu choro" }
      ]
