        { "hebraico": "יָ֝שֻׁ֗בוּ", "transliteral": "yā-šu-ḇû", "traducao_palavra": "voltem atrás" },
        { "hebraico": "יֵבֹ֥שׁוּ", "transliteral": "yê-ḇō-šû", "traducao_palavra": "envergonhem-se" },
