        { "hebraico": "נַפְשִׁ֑י", "transliteral": "nap̄-šî", "traducao_palavra": "minha alma" },
        { "hebraico": "הֹ֝ושִׁיעֵ֗נִי", "transliteral": "hô-w-šî-ʿê-nî", "traducao_palavra": "salva-me" },
        { "hebraico": "לְמַ֣עַן", "transliteral": "lə-ma-ʿan", "traducao_palavra": "por causa de/por amor de" },
        { "hebraico": "חַסְדֶּֽךָ׃", "transliteral": "ḥas-de-ḵā", "traducao_palavra": "Tua benignidade" }
      ]
    },
    "5": {
      "traducao_completa": "Porque na morte não há lembrança de ti; no sepulcro quem te louvará?",
      "palavras": [
        { "hebraico": "כִּ֤י", "transliteral": "kî", "traducao_palavra": "Porque" },
        { "hebraico": "אֵ֣ין", "transliteral": "ʾên", "traducao_palavra": "não há" },
        { "hebraico": "בַּמָּ֣וֶת", "transliteral": "bam-mā-weṯ", "traducao_palavra": "na morte" },
        { "hebraico": "זִכְרֶ֑ךָ", "transliteral": "ziḵ-re-ḵā", "traducao_palavra": "Tua lembrança" },
        { "hebraico": "בִּ֝שְׁאֹ֗ול", "transliteral": "biš-ʾô-wl", "traducao_palavra": "no Seol [sepultura]" },
        { "hebraico": "מִ֣י", "transliteral": "mî", "traducao_palavra": "quem" },
        { "hebraico": "יֹודֶה־", "transliteral": "yô-ḏeh-", "traducao_palavra": "louvará/dará graças" },
        { "hebraico": "לָּֽךְ׃", "transliteral": "lāḵ", "traducao_palavra": "a Ti" }
      ]
    },
    "6": {
      "traducao_completa": "Já estou cansado do meu gemido; toda a noite faço nadar a minha cama; molho o meu leito com as minhas lágrimas.",
      "palavras": [
        { "hebraico": "יָגַ֤עְתִּי", "transliteral": "yā-ḡaʿ-tî", "traducao_palavra": "Estou cansado" },
        { "hebraico": "בְּאַנְחָתִ֗י", "transliteral": "bə-ʾan-ḥā-ṯî", "traducao_palavra": "com meu gemido" },
        { "hebraico": "אַשְׂחֶּ֣ה", "transliteral": "ʾaś-ḥeh", "traducao_palavra": "faço nadar" },
        { "hebraico": "בְֳכָל־", "transliteral": "ḇə-ḵāl-", "traducao_palavra": "em toda" },
        { "hebraico": "לַ֭יְלָה", "transliteral": "lay-lā", "traducao_palavra": "noite" },
        { "hebraico": "מִטָּתִ֑י", "transliteral": "miṭ-ṭā-ṯî", "traducao_palavra": "minha cama" },
        { "hebraico": "בְּ֝דִמְעָתִ֗י", "transliteral": "bə-ḏim-ʿā-ṯî", "traducao_palavra": "com minha lágrima" },
