    "9": {
      "traducao_completa": "YHWH ouviu a minha súplica; YHWH aceitou a minha oração.",
      "palavras": [
        { "hebraico": "שָׁמַ֣ע", "transliteral": "šā-maʿ", "traducao_palavra": "Ouviu" },
        { "hebraico": "יְ֭הוָה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "תְּחִנָּתִ֑י", "transliteral": "tə-ḥin-nā-ṯî", "traducao_palavra": "minha súplica" },
        { "hebraico": "יְ֝הוָה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
