        { "hebraico": "וְכָل־", "transliteral": "wə-ḵāl-", "traducao_palavra": "e todos" },
        { "hebraico": "יֹשְׁבֶ֑יהָ", "transliteral": "yō-šə-ḇey-hā", "traducao_palavra": "habitantes dela" },
        { "hebraico": "אָנֹכִ֨י", "transliteral": "ʾā-nō-ḵî", "traducao_palavra": "eu" },
