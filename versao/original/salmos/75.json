        { "hebraico": "אֱ֫לֹהִ֥ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "ó Deus" },
        { "hebraico": "הֹודִ֓ינוּ", "transliteral": "hô-ḏî-nû", "traducao_palavra": "damos graças" },
        { "hebraico": "וְקָ֘רֹ֤וב", "transliteral": "wə-qā-rôḇ", "traducao_palavra": "e [está] perto" },
        { "hebraico": "שְׁמֶ֗ךָ", "transliteral": "šə-me-ḵā", "traducao_palavra": "teu nome" },
        { "hebraico": "סִ֝פְּר֗וּ", "transliteral": "sip-pə-rû", "traducao_palavra": "contam/declaram" },
