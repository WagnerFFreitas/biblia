      ]
    },
    "10": {
      "traducao_completa": "Declara-os culpados, ó Deus; caiam por seus próprios conselhos; lança-os fora por causa da multidão das suas transgressões, pois se rebelaram contra ti.",
      "palavras": [
        { "hebraico": "הַאֲשִׁ֘ימֵ֤ם", "transliteral": "ha-ʾă-šî-mêm", "traducao_palavra": "Declara-os culpados" },
        { "hebraico": "אֱלֹהִ֗ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "ó Deus" },
        { "hebraico": "יִפְּל֥וּ", "transliteral": "yip-pə-lû", "traducao_palavra": "caiam eles" },
        { "hebraico": "מִמֹּועֲצֹותֵיהֶ֑ם", "transliteral": "mi-mô-w-ʿă-ṣô-w-ṯê-hem", "traducao_palavra": "por seus conselhos" },
        { "hebraico": "בְּרֹ֤ב", "transliteral": "bə-rōᇔ", "traducao_palavra": "na multidão de" },
        { "hebraico": "פִּשְׁעֵיהֶ֨ם", "transliteral": "piš-ʿê-hem", "traducao_palavra": "suas transgressões" },
