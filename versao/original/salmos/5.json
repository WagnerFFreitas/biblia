{
  "livro": "Salmos - תְּהִלִּים - Tə-hil-lîm",
  "capítulo": 5,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Dá ouvidos às minhas palavras, ó YHWH; atende à minha meditação.",
      "palavras": [
        { "hebraico": "אֲמָרַ֖י", "transliteral": "ʾă-mā-ray", "traducao_palavra": "minhas palavras" },
        { "hebraico": "הַאֲזִ֥ינָה", "transliteral": "ha-ʾă-zî-nā", "traducao_palavra": "dá ouvidos" },
        { "hebraico": "יְהוָ֑ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "בִּ֥ינָה", "transliteral": "bî-nā", "traducao_palavra": "atende/atenta" },
        { "hebraico": "הֲגִיגִֽי׃", "transliteral": "hă-ḡî-ḡî", "traducao_palavra": "à minha meditação" }
      ]
    },
    "2": {
      "traducao_completa": "Atende à voz do meu clamor, Rei meu e Deus meu, pois a ti orarei.",
      "palavras": [
        { "hebraico": "הַקְשִׁ֤יבָה", "transliteral": "haq-šî-ḇā", "traducao_palavra": "Atende" },
        { "hebraico": "לְקֹ֧ול", "transliteral": "lə-qôl", "traducao_palavra": "à voz de" },
        { "hebraico": "שַׁוְעִ֗י", "transliteral": "šaw-ʿî", "traducao_palavra": "meu clamor" },
        { "hebraico": "מַלְכִּ֥י", "transliteral": "mal-kî", "traducao_palavra": "meu Rei" },
        { "hebraico": "וֵאלֹהָ֑י", "transliteral": "wê-lō-hāy", "traducao_palavra": "e meu Deus" },
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "pois" },
        { "hebraico": "אֵ֝לֶיךָ", "transliteral": "ʾê-le-ḵā", "traducao_palavra": "a Ti" },
        { "hebraico": "אֶתְפַּלָּֽל׃", "transliteral": "ʾeṯ-pal-lāl", "traducao_palavra": "orarei" }
      ]
    },
    "3": {
      "traducao_completa": "Pela manhã ouvirás a minha voz, ó YHWH; pela manhã apresentarei a ti a minha oração, e vigiarei.",
      "palavras": [
        { "hebraico": "יְֽהוָה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "בֹּ֭קֶר", "transliteral": "bō-qer", "traducao_palavra": "[pela] manhã" },
        { "hebraico": "תִּשְׁמַ֣ע", "transliteral": "tiš-maʿ", "traducao_palavra": "ouvirás" },
        { "hebraico": "קֹولִ֑י", "transliteral": "qô-lî", "traducao_palavra": "minha voz" },
        { "hebraico": "בֹּ֥קֶר", "transliteral": "bō-qer", "traducao_palavra": "[pela] manhã" },
        { "hebraico": "אֶֽעֱרָךְ־", "transliteral": "ʾe-ʿĕ-rāḵ-", "traducao_palavra": "apresentarei/ordenarei" },
        { "hebraico": "לְךָ֝", "transliteral": "lə-ḵā", "traducao_palavra": "para Ti" },
        { "hebraico": "וַאֲצַפֶּֽה׃", "transliteral": "wa-ʾă-ṣap-peh", "traducao_palavra": "e vigiarei/esperarei" }
      ]
    },
    "4": {
      "traducao_completa": "Porque tu não és um Deus que tenha prazer na impiedade, nem contigo habitará o mal.",
      "palavras": [
        { "hebraico": "כִּ֤י", "transliteral": "kî", "traducao_palavra": "Porque" },
        { "hebraico": "׀", "transliteral": "-", "traducao_palavra": "-" },
        { "hebraico": "לֹ֤א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "אֵֽל־", "transliteral": "ʾêl-", "traducao_palavra": "[és] Deus" },
        { "hebraico": "חָפֵ֘ץ", "transliteral": "ḥā-p̄êṣ", "traducao_palavra": "[que] se agrada" },
        { "hebraico": "רֶ֥שַׁע", "transliteral": "re-šaʿ", "traducao_palavra": "[da] impiedade" },
        { "hebraico": "אָ֑תָּה", "transliteral": "ʾat-tā", "traducao_palavra": "Tu" },
        { "hebraico": "לֹ֖א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "יְגֻרְךָ֣", "transliteral": "yə-ḡur-ḵā", "traducao_palavra": "habitará contigo" },
        { "hebraico": "רָֽc׃", "transliteral": "rāʿ", "traducao_palavra": "[o] mal" }
      ]
    },
    "5": {
      "traducao_completa": "Os loucos não pararão perante os teus olhos; odeias a todos os que praticam a iniquidade.",
      "palavras": [
        { "hebraico": "לֹֽא־", "transliteral": "lō-", "traducao_palavra": "Não" },
        { "hebraico": "יִתְיַצְּב֣וּ", "transliteral": "yiṯ-yaṣ-ṣə-ḇû", "traducao_palavra": "se apresentarão/subsistirão" },
        { "hebraico": "הֹ֭ולְלִים", "transliteral": "hô-wl-lîm", "traducao_palavra": "insensatos/arrogantes" },
        { "hebraico": "לְנֶ֣גֶד", "transliteral": "lə-ne-ḡeḏ", "traducao_palavra": "diante de" },
        { "hebraico": "עֵינֶ֑יךָ", "transliteral": "ʿê-ney-ḵā", "traducao_palavra": "Teus olhos" },
        { "hebraico": "שָׂ֝נֵ֗אתָ", "transliteral": "śā-nê-ṯā", "traducao_palavra": "odeias" },
        { "hebraico": "כָּל־", "transliteral": "kāl-", "traducao_palavra": "a todos" },
        { "hebraico": "פֹּ֥עֲלֵי", "transliteral": "p̄ō-ʿă-lê", "traducao_palavra": "praticantes de" },
        { "hebraico": "אָֽוֶן׃", "transliteral": "ʾā-wen", "traducao_palavra": "iniquidade" }
      ]
    },
    "6": {
      "traducao_completa": "Destruirás aqueles que falam a mentira; YHWH abomina o homem sanguinário e fraudulento.",
      "palavras": [
        { "hebraico": "תְּאַבֵּד֮", "transliteral": "tə-ʾab-bêḏ", "traducao_palavra": "Destruirás" },
        { "hebraico": "דֹּבְרֵ֪i", "transliteral": "dō-ḇə-rê", "traducao_palavra": "[os que] falam" },
        { "hebraico": "כָ֫זָ֥ב", "transliteral": "ḵā-zāḇ", "traducao_palavra": "mentira" },
        { "hebraico": "אִ֥ישׁ־", "transliteral": "ʾîš-", "traducao_palavra": "[ao] homem de" },
        { "hebraico": "דָּמִים", "transliteral": "dā-mîm", "traducao_palavra": "sangues" },
        { "hebraico": "וּמִרְמָ֗ה", "transliteral": "ū-mir-mā", "traducao_palavra": "e engano" },
        { "hebraico": "יְתָ֘עֵ֥ב", "transliteral": "yə-ṯā-ʿêḇ", "traducao_palavra": "abomina" },
        { "hebraico": "יְהוָֽה׃", "transliteral": "YHWH", "traducao_palavra": "YHWH" }
      ]
    },
    "7": {
      "traducao_completa": "Porém eu entrarei em tua casa pela grandeza da tua benignidade; e em teu temor me inclinarei para o teu santo templo.",
      "palavras": [
        { "hebraico": "וַאֲנִ֗י", "transliteral": "wa-ʾă-nî", "traducao_palavra": "Eu, porém" },
        { "hebraico": "בְּרֹ֣ב", "transliteral": "bə-rōᇔ", "traducao_palavra": "na multidão de" },
        { "hebraico": "חַסְדְּךָ֮", "transliteral": "ḥas-də-ḵā", "traducao_palavra": "Tua misericórdia" },
        { "hebraico": "אָבֹ֪וא", "transliteral": "ʾā-ḇô", "traducao_palavra": "entrarei em" },
        { "hebraico": "בֵ֫יתֶ֥ךָ", "transliteral": "ḇê-ṯe-ḵā", "traducao_palavra": "Tua casa" },
        { "hebraico": "אֶשְׁתַּחֲוֶ֥ה", "transliteral": "ʾeš-ta-ḥă-weh", "traducao_palavra": "me prostrarei" },
        { "hebraico": "אֶל־", "transliteral": "ʾel-", "traducao_palavra": "para/no" },
        { "hebraico": "הֵיכַל־", "transliteral": "hê-ḵal-", "traducao_palavra": "templo de" },
        { "hebraico": "קָדְשְׁךָ֗", "transliteral": "qāḏ-šə-ḵā", "traducao_palavra": "Tua santidade" },
        { "hebraico": "בְּיִרְאָתֶֽךָ׃", "transliteral": "bə-yir-ʾā-ṯe-ḵā", "traducao_palavra": "no Teu temor" }
      ]
    },
    "8": {
      "traducao_completa": "YHWH, guia-me na tua justiça, por causa dos meus inimigos; endireita diante de mim o teu caminho.",
      "palavras": [
        { "hebraico": "יְהוָ֤ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "נְחֵ֪נִי", "transliteral": "nə-ḥê-nî", "traducao_palavra": "guia-me" },
        { "hebraico": "בְצִדְקָתֶ֗ךָ", "transliteral": "ḇə-ṣiḏ-qā-ṯe-ḵā", "traducao_palavra": "na Tua justiça" },
        { "hebraico": "לְמַ֪עַן", "transliteral": "lə-ma-ʿan", "traducao_palavra": "por causa de" },
        { "hebraico": "שֹׁורְרָ֑י", "transliteral": "šô-w-rə-rāy", "traducao_palavra": "meus inimigos" },
