      ]
    },
    "11": {
      "traducao_completa": "Mas alegrem-se todos os que confiam em ti; exultem eternamente, porquanto tu os defendes; e gloriem-se em ti os que amam o teu nome.",
      "palavras": [
        { "hebraico": "וְיִשְׂמְח֨וּ", "transliteral": "wə-yiś-mə-ḥû", "traducao_palavra": "E alegrem-se" },
