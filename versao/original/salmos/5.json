        { "hebraico": "עָ֫לֵ֥ימֹו", "transliteral": "ʿā-lê-mô", "traducao_palavra": "sobre eles" },
        { "hebraico": "וְיַעְלְצ֥וּ", "transliteral": "wə-yaʿ-lə-ṣû", "traducao_palavra": "e exultem" },
        { "hebraico": "בָ֑ךְ", "transliteral": "ḇāḵ", "traducao_palavra": "em Ti" },
        { "hebraico": "אֹ֝הֲבֵ֣i", "transliteral": "ʾō-hă-ḇê", "traducao_palavra": "[os que] amam" },
