      ]
    },
    "9": {
      "traducao_completa": "Porque não há fidelidade na boca deles; as suas entranhas são verdadeiras maldades, a sua garganta é um sepulcro aberto; lisonjeiam com a sua língua.",
      "palavras": [
        { "hebraico": "כִּ֤י", "transliteral": "kî", "traducao_palavra": "Porque" },
        { "hebraico": "אֵ֪ין", "transliteral": "ʾên", "traducao_palavra": "não há" },
        { "hebraico": "בְּפִ֪יהוּ", "transliteral": "bə-p̄î-hû", "traducao_palavra": "na boca dele" },
        { "hebraico": "נְכֹונָ֫ה", "transliteral": "nə-ḵô-w-nā", "traducao_palavra": "fidelidade/retidão" },
        { "hebraico": "קִרְבָּ֥ם", "transliteral": "qir-bām", "traducao_palavra": "o íntimo deles" },
