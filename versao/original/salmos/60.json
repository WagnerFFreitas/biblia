{
  "livro": "Salmos - תְּהִלִּים - Tehillim",
  "capítulo": 60,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Ó Deus, tu nos rejeitaste, tu nos dispersaste, tu estiveste indignado; oh, restabelece-nos!",
      "palavras": [
        { "hebraico": "אֱלֹהִים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "ó Deus" },
        { "hebraico": "זְנַחְתָּנוּ", "transliteral": "zə-naḥ-tā-nû", "traducao_palavra": "rejeitaste-nos" },
        { "hebraico": "פְרַצְתָּנוּ", "transliteral": "p̄ə-raṣ-tā-nû", "traducao_palavra": "dispersaste-nos/rompeste-nos" },
        { "hebraico": "אָנַפְתָּ", "transliteral": "ʾā-nap̄-tā", "traducao_palavra": "estiveste indignado" },
        { "hebraico": "תְּשֹׁובֵב", "transliteral": "tə-šô-ḇēḇ", "traducao_palavra": "restaura/volta-te" },
        { "hebraico": "לָֽנוּ׃", "transliteral": "lā-nû", "traducao_palavra": "para nós" }
      ]
    },
    "2": {
      "traducao_completa": "Fizeste tremer a terra e a fendeste; sara as suas fendas, pois ela vacila.",
      "palavras": [
        { "hebraico": "הִרְעַשְׁתָּה", "transliteral": "hir-ʿaš-tā", "traducao_palavra": "fizeste tremer" },
        { "hebraico": "אֶרֶץ", "transliteral": "ʾe-reṣ", "traducao_palavra": "[a] terra" },
        { "hebraico": "פְּצַמְתָּהּ", "transliteral": "pə-ṣam-tāh", "traducao_palavra": "fendeste-a" },
        { "hebraico": "רְפָה", "transliteral": "rə-p̄ā", "traducao_palavra": "sara" },
        { "hebraico": "שְׁבָרֶיהָ", "transliteral": "šə-ḇā-re-hā", "traducao_palavra": "as fendas dela" },
        { "hebraico": "כִֽי־", "transliteral": "ḵî-", "traducao_palavra": "porque" },
        { "hebraico": "מָֽטָה׃", "transliteral": "mā-ṭā", "traducao_palavra": "vacila/abala-se" }
      ]
    },
    "3": {
      "traducao_completa": "Fizeste o teu povo ver coisas duras; fizeste-nos beber o vinho do atordoamento.",
      "palavras": [
        { "hebraico": "הִרְאִיתָ", "transliteral": "hir-ʾî-ṯā", "traducao_palavra": "fizeste ver" },
        { "hebraico": "עַמְּךָ", "transliteral": "ʿam-mə-ḵā", "traducao_palavra": "[ao] teu povo" },
        { "hebraico": "קָשָׁה", "transliteral": "qā-šā", "traducao_palavra": "[coisas] duras" },
        { "hebraico": "הִשְׁקִיתָנוּ", "transliteral": "hiš-qî-ṯā-nû", "traducao_palavra": "fizeste-nos beber" },
        { "hebraico": "יַיִן", "transliteral": "ya-yin", "traducao_palavra": "vinho de" },
        { "hebraico": "תַּרְעֵלָֽה׃", "transliteral": "tar-ʿē-lā", "traducao_palavra": "atordoamento/tremor" }
      ]
    },
    "4": {
      "traducao_completa": "Deste um estandarte aos que te temem, para ser hasteado por causa da verdade. (Selah)",
      "palavras": [
        { "hebraico": "נָ֘תַ֤תָּה", "transliteral": "nā-ṯat-tā", "traducao_palavra": "tu deste" },
        { "hebraico": "לִּירֵאֶ֣יךָ", "transliteral": "lî-rē-ʾe-ḵā", "traducao_palavra": "aos teus tementes" },
        { "hebraico": "נֵּ֣ס", "transliteral": "nēs", "traducao_palavra": "um estandarte/bandeira" },
        { "hebraico": "לְהִתְנֹוסֵ֑ס", "transliteral": "lə-hiṯ-nô-śēś", "traducao_palavra": "para ser exibido/hasteado" },
        { "hebraico": "מִ֝פְּנֵי", "transliteral": "mip-pə-nê", "traducao_palavra": "diante da/por causa da" },
        { "hebraico": "קֹשֶׁט", "transliteral": "qō-šeṭ", "traducao_palavra": "verdade/arco" },
        { "hebraico": "סֶֽלָה׃", "transliteral": "śe-lā", "traducao_palavra": "Selah [pausa]" }
      ]
    },
    "5": {
      "traducao_completa": "Para que os teus amados sejam livres, salva-nos com a tua destra e responde-nos.",
      "palavras": [
        { "hebraico": "לְ֭מַעַן", "transliteral": "lə-ma-ʿan", "traducao_palavra": "para que" },
        { "hebraico": "יֵחָלְצ֥וּן", "transliteral": "yē-ḥā-lə-ṣûn", "traducao_palavra": "sejam libertos/livres" },
        { "hebraico": "יְדִידֶ֑יךָ", "transliteral": "yə-ḏî-ḏe-ḵā", "traducao_palavra": "teus amados" },
        { "hebraico": "הֹושִׁ֨יעָה", "transliteral": "hô-šî-ʿā", "traducao_palavra": "salva" },
        { "hebraico": "יְמִינְךָ", "transliteral": "yə-mî-nə-ḵā", "traducao_palavra": "[com] tua destra" },
        { "hebraico": "וַעֲנֵֽנִי׃", "transliteral": "wa-ʿă-nê-nî", "traducao_palavra": "e responde-me" }
      ]
    },
    "6": {
      "traducao_completa": "Deus falou na sua santidade: Eu me regozijarei, repartirei Siquém e medirei o vale de Sucote.",
      "palavras": [
        { "hebraico": "אֱלֹהִ֤ים ׀", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "Deus" },
        { "hebraico": "דִּבֶּ֬ר", "transliteral": "dib-bēr", "traducao_palavra": "falou" },
        { "hebraico": "בְּקָדְשֹׁ֗ו", "transliteral": "bə-qāḏ-šô", "traducao_palavra": "na sua santidade" },
        { "hebraico": "אֶ֘עְלֹ֥זָה", "transliteral": "ʾe-ʿlō-zā", "traducao_palavra": "eu exultarei" },
        { "hebraico": "אֲחַלְּקָ֥ה", "transliteral": "ʾă-ḥal-lə-qā", "traducao_palavra": "repartirei" },
        { "hebraico": "שְׁכֶ֑ם", "transliteral": "šə-ḵem", "traducao_palavra": "Siquém" },
        { "hebraico": "וְעֵ֖מֶק", "transliteral": "wə-ʿē-meq", "traducao_palavra": "e o vale de" },
        { "hebraico": "סֻכֹּ֣ות", "transliteral": "suk-kôṯ", "traducao_palavra": "Sucote" },
        { "hebraico": "אֲמַדֵּֽד׃", "transliteral": "ʾă-mad-dēḏ", "traducao_palavra": "medirei" }
      ]
    },
    "7": {
      "traducao_completa": "Meu é Gileade, e meu é Manassés; Efraim é a força da minha cabeça; Judá é o meu cetro.",
      "palavras": [
        { "hebraico": "לִ֤י", "transliteral": "lî", "traducao_palavra": "meu [é]" },
        { "hebraico": "גִלְעָ֨ד ׀", "transliteral": "ḡil-ʿāḏ", "traducao_palavra": "Gileade" },
        { "hebraico": "וְלִ֬י", "transliteral": "wə-lî", "traducao_palavra": "e meu [é]" },
        { "hebraico": "מְנַשֶּׁ֗ה", "transliteral": "mə-naš-šeh", "traducao_palavra": "Manassés" },
        { "hebraico": "וְ֭אֶפְרַיִם", "transliteral": "wə-ʾep̄-ra-yim", "traducao_palavra": "e Efraim" },
        { "hebraico": "מָעֹ֣oz", "transliteral": "mā-ʿôz", "traducao_palavra": "[é a] fortaleza de" },
        { "hebraico": "רֹאשִׁ֑י", "transliteral": "rō-šî", "traducao_palavra": "minha cabeça" },
        { "hebraico": "יְ֝הוּדָ֗ה", "transliteral": "yə-hû-ḏā", "traducao_palavra": "Judá" },
        { "hebraico": "מְחֹקְקִֽי׃", "transliteral": "mə-ḥō-qə-qî", "traducao_palavra": "meu legislador/cetro" }
      ]
    },
    "8": {
      "traducao_completa": "Moabe é a minha bacia de lavar; sobre Edom lançarei o meu sapato; sobre a Filístia jubilarei.",
      "palavras": [
        { "hebraico": "מֹואָ֤ב ׀", "transliteral": "mô-ʾāḇ", "traducao_palavra": "Moabe" },
        { "hebraico": "סִ֬יר", "transliteral": "śîr", "traducao_palavra": "[é a] bacia de" },
        { "hebraico": "רַחְצִ֗י", "transliteral": "raḥ-ṣî", "traducao_palavra": "minha lavagem" },
        { "hebraico": "עַל־אֱ֭דֹום", "transliteral": "ʿal-ʾĕ-ḏôm", "traducao_palavra": "sobre Edom" },
        { "hebraico": "אַשְׁלִ֣יךְ", "transliteral": "ʾaš-lîḵ", "traducao_palavra": "lançarei" },
        { "hebraico": "נַעֲלִ֑י", "transliteral": "na-ʿă-lî", "traducao_palavra": "meu sapato" },
        { "hebraico": "עָ֝לַ֗י", "transliteral": "ʿā-lay", "traducao_palavra": "sobre mim/contra mim" },
        { "hebraico": "פְּלֶ֣שֶׁת", "transliteral": "pə-le-šeṯ", "traducao_palavra": "Filístia" },
        { "hebraico": "הִתְרֹועָֽעִי׃", "transliteral": "hiṯ-rô-ʿā-ʿî", "traducao_palavra": "jubila/clama" }
      ]
    },
    "9": {
      "traducao_completa": "Quem me conduzirá à cidade forte? Quem me guiará até Edom?",
      "palavras": [
        { "hebraico": "מִ֣י", "transliteral": "mî", "traducao_palavra": "quem" },
        { "hebraico": "יֹ֭בִילֵנִי", "transliteral": "yô-ḇî-lē-nî", "traducao_palavra": "conduzirá me" },
        { "hebraico": "עִ֣יר", "transliteral": "ʿîr", "traducao_palavra": "[à] cidade" },
        { "hebraico": "מָצֹ֑ור", "transliteral": "mā-ṣôr", "traducao_palavra": "fortificada/sitiada" },
        { "hebraico": "מִ֖י", "transliteral": "mî", "traducao_palavra": "quem" },
        { "hebraico": "נָחַ֣נִי", "transliteral": "nā-ḥa-nî", "traducao_palavra": "guiou-me/guiará-me" },
        { "hebraico": "עַד־אֱדֹֽום׃", "transliteral": "ʿaḏ-ʾĕ-ḏôm", "traducao_palavra": "até Edom" }
      ]
    },
    "10": {
      "traducao_completa": "Acaso não foste tu, ó Deus, que nos rejeitaste? E não sairás, ó Deus, com os nossos exércitos?",
      "palavras": [
        { "hebraico": "הֲלֹא־אַתָּ֣ה", "transliteral": "hă-lō-ʾat-tā", "traducao_palavra": "acaso não tu" },
        { "hebraico": "אֱלֹהִ֣ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "ó Deus" },
        { "hebraico": "זְנַחְתָּ֑נוּ", "transliteral": "zə-naḥ-tā-nû", "traducao_palavra": "rejeitaste-nos" },
        { "hebraico": "וְלֹא־תֵצֵ֥א", "transliteral": "wə-lō-ṯē-ṣē", "traducao_palavra": "e não sais" },
        { "hebraico": "אֱ֝לֹהִ֗ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "ó Deus" },
        { "hebraico": "בְּצִבְאֹותֵֽינוּ׃", "transliteral": "bə-ṣiḇ-ʾô-ṯê-nû", "traducao_palavra": "com nossos exércitos" }
      ]
    },
    "11": {
      "traducao_completa": "Dá-nos auxílio na angústia, pois vão é o socorro do homem.",
      "palavras": [
        { "hebraico": "הָבָה־לָּ֣נוּ", "transliteral": "hā-ḇā-lā-nû", "traducao_palavra": "dá-nos" },
        { "hebraico": "עֶזְרָ֣ת", "transliteral": "ʿez-rāṯ", "traducao_palavra": "auxílio" },
        { "hebraico": "מִצָּ֑ר", "transliteral": "miṣ-ṣār", "traducao_palavra": "contra o adversário/angústia" },
        { "hebraico": "וְ֝שָׁוְא", "transliteral": "wə-šā-wəʾ", "traducao_palavra": "pois vã/falsa" },
        { "hebraico": "תְּשׁוּעַ֥ת", "transliteral": "tə-šû-ʿaṯ", "traducao_palavra": "[é a] salvação/socorro de" },
        { "hebraico": "אָדָֽם׃", "transliteral": "ʾā-ḏām", "traducao_palavra": "homem" }
      ]
    },
    "12": {
      "traducao_completa": "Em Deus faremos proezas; e ele é quem pisará os nossos adversários.",
      "palavras": [
        { "hebraico": "בֵּאלֹהִ֥ים", "transliteral": "bē-lō-hîm", "traducao_palavra": "em Deus" },
        { "hebraico": "נַעֲשֶׂה־חָ֑יִל", "transliteral": "na-ʿă-śeh-ḥā-yil", "traducao_palavra": "faremos proezas/valor" },
