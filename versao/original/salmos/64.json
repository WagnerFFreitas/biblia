{
  "livro": "Salmos - תְּהִלִּים - Tehillim",
  "capítulo": 64,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Ouve, ó Deus, a minha voz na minha queixa; preserva a minha vida do pavor do inimigo.",
      "palavras": [
        { "hebraico": "שְׁמַע־", "transliteral": "šə-maʿ-", "traducao_palavra": "ouve" },
        { "hebraico": "אֱלֹהִ֥ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "ó Deus" },
        { "hebraico": "קֹולִ֖י", "transliteral": "qô-lî", "traducao_palavra": "minha voz" },
        { "hebraico": "בְשִׂיחִ֑י", "transliteral": "ḇə-śî-ḥî", "traducao_palavra": "na minha queixa/meditação" },
        { "hebraico": "מִפַּ֥חַד", "transliteral": "mip-pa-ḥaḏ", "traducao_palavra": "do pavor de" },
        { "hebraico": "אֹ֝ויֵ֗ב", "transliteral": "ʾô-yēḇ", "traducao_palavra": "inimigo" },
        { "hebraico": "תִּצֹּ֥ר", "transliteral": "tiṣ-ṣōr", "traducao_palavra": "preserva/guarda" },
        { "hebraico": "חַיָּֽי׃", "transliteral": "ḥay-yāy", "traducao_palavra": "minha vida" }
      ]
    },
    "2": {
      "traducao_completa": "Esconde-me do secreto conselho dos malfeitores e do tumulto dos que praticam a iniquidade.",
      "palavras": [
        { "hebraico": "תַּ֭סְתִּירֵנִי", "transliteral": "tas-tî-rē-nî", "traducao_palavra": "esconde-me" },
        { "hebraico": "מִסֹּ֣וד", "transliteral": "mis-sôḏ", "traducao_palavra": "do segredo/conselho de" },
        { "hebraico": "מְרֵעִ֑ים", "transliteral": "mə-rē-ʿîm", "traducao_palavra": "malfeitores" },
        { "hebraico": "מֵ֝רִגְשַׁ֗ת", "transliteral": "mē-riḡ-šaṯ", "traducao_palavra": "do tumulto/insurreição de" },
        { "hebraico": "פֹּ֣עֲלֵי", "transliteral": "pō-ʿă-lê", "traducao_palavra": "praticantes de" },
        { "hebraico": "אָֽוֶן׃", "transliteral": "ʾā-wen", "traducao_palavra": "iniquidade" }
      ]
    },
    "3": {
      "traducao_completa": "Que afiaram as suas línguas como espadas; e armaram, por suas flechas, palavras amargas,",
      "palavras": [
        { "hebraico": "אֲשֶׁר֩", "transliteral": "ʾă-šer", "traducao_palavra": "que" },
        { "hebraico": "שָׁנֲנ֨וּ", "transliteral": "šā-nă-nû", "traducao_palavra": "afiaram" },
        { "hebraico": "כַחֶ֪רֶב", "transliteral": "ḵa-ḥe-reḇ", "traducao_palavra": "como a espada" },
        { "hebraico": "לְשֹׁונָ֑ם", "transliteral": "lə-šô-nām", "traducao_palavra": "língua deles" },
        { "hebraico": "דָּרְכ֥וּ", "transliteral": "dā-rə-ḵû", "traducao_palavra": "armaram/pisaram" },
        { "hebraico": "חִ֝צָּ֗ם", "transliteral": "ḥiṣ-ṣām", "traducao_palavra": "[como] flecha deles" },
        { "hebraico": "דָּבָ֥ר", "transliteral": "dā-ḇār", "traducao_palavra": "palavra" },
        { "hebraico": "מָֽר׃", "transliteral": "mār", "traducao_palavra": "amarga" }
      ]
    },
    "4": {
      "traducao_completa": "Para atirarem em lugares ocultos ao que é íntegro; atiram-lhe de improviso e não temem.",
      "palavras": [
        { "hebraico": "לִירֹ֣ות", "transliteral": "lî-rôṯ", "traducao_palavra": "para atirar" },
        { "hebraico": "בַּמִּסְתָּרִ֣ים", "transliteral": "bam-mis-tā-rîm", "traducao_palavra": "em esconderijos" },
        { "hebraico": "תָּ֑ם", "transliteral": "tām", "traducao_palavra": "[ao] íntegro" },
        { "hebraico": "פִּתְאֹ֥ם", "transliteral": "piṯ-ʾōm", "traducao_palavra": "de repente/de improviso" },
        { "hebraico": "יֹ֝רֻ֗הוּ", "transliteral": "yō-ru-hû", "traducao_palavra": "atiram nele" },
        { "hebraico": "וְלֹ֥א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "יִירָֽאוּ׃", "transliteral": "yî-rā-ʾû", "traducao_palavra": "temem" }
      ]
    },
    "5": {
      "traducao_completa": "Firmam-se em mau desígnio; falam de armar laços ocultamente e dizem: Quem os verá?",
      "palavras": [
        { "hebraico": "יְחַזְּקוּ־", "transliteral": "yə-ḥaz-zə-qû-", "traducao_palavra": "eles fortalecem/firmam" },
        { "hebraico": "לָ֨מֹו", "transliteral": "lā-mô", "traducao_palavra": "para si" },
        { "hebraico": "דָּ֘בָ֤ר", "transliteral": "dā-ḇār", "traducao_palavra": "[um] assunto/propósito" },
        { "hebraico": "רָ֗ע", "transliteral": "rāʿ", "traducao_palavra": "mau" },
        { "hebraico": "יְֽסַפְּר֨וּ", "transliteral": "yə-sap-pə-rû", "traducao_palavra": "falam/planejam" },
        { "hebraico": "לִטְמֹ֬ון", "transliteral": "liṭ-môn", "traducao_palavra": "para esconder" },
        { "hebraico": "מֹוקְשִׁ֗ים", "transliteral": "mô-qə-šîm", "traducao_palavra": "laços/armadilhas" },
        { "hebraico": "אָ֝מְרוּ", "transliteral": "ʾā-mərû", "traducao_palavra": "disseram" },
        { "hebraico": "מִ֣י", "transliteral": "mî", "traducao_palavra": "quem" },
        { "hebraico": "יִרְאֶה־", "transliteral": "yir-ʾeh-", "traducao_palavra": "verá" },
        { "hebraico": "לָּֽמֹו׃", "transliteral": "lā-mô", "traducao_palavra": "a eles" }
      ]
    },
    "6": {
      "traducao_completa": "Maquinam iniquidades, dizem: Temos concluído um plano bem traçado; e o íntimo de cada um e o seu coração são profundos.",
      "palavras": [
        { "hebraico": "יַחְפְּשֽׂוּ־", "transliteral": "yaḥ-pə-śû-", "traducao_palavra": "eles buscam/maquinam" },
        { "hebraico": "עֹולֹ֗ת", "transliteral": "ʿô-lōṯ", "traducao_palavra": "iniquidades" },
        { "hebraico": "תַּ֭מְנוּ", "transliteral": "tam-nû", "traducao_palavra": "concluímos/terminamos" },
        { "hebraico": "חֵ֣פֶשׂ", "transliteral": "ḥê-p̄eś", "traducao_palavra": "[um] plano/busca" },
        { "hebraico": "מְחֻפָּ֑שׂ", "transliteral": "mə-ḥup-pāś", "traducao_palavra": "bem traçado" },
        { "hebraico": "וְקֶ֥רֶב", "transliteral": "wə-qe-reḇ", "traducao_palavra": "e o íntimo de" },
        { "hebraico": "אִ֝֗ישׁ", "transliteral": "ʾîš", "traducao_palavra": "um homem" },
        { "hebraico": "וְלֵ֣ב", "transliteral": "wə-lêḇ", "traducao_palavra": "e o coração" },
        { "hebraico": "עָמֹֽק׃", "transliteral": "ʿā-mōq", "traducao_palavra": "[é] profundo" }
      ]
    },
    "7": {
      "traducao_completa": "Mas Deus disparará sobre eles uma seta, e de repente ficarão feridos.",
      "palavras": [
        { "hebraico": "וַיֹּרֵ֗ם", "transliteral": "way-yō-rēm", "traducao_palavra": "mas atirará neles" },
        { "hebraico": "אֱלֹ֫הִ֥ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "Deus" },
        { "hebraico": "חֵ֥ץ", "transliteral": "ḥēṣ", "traducao_palavra": "[uma] seta" },
        { "hebraico": "פִּתְאֹ֑ום", "transliteral": "piṯ-ʾōm", "traducao_palavra": "de repente" },
        { "hebraico": "הָ֝י֗וּ", "transliteral": "hā-yû", "traducao_palavra": "foram/ficaram" },
        { "hebraico": "מַכֹּותָֽם׃", "transliteral": "mak-kô-ṯām", "traducao_palavra": "[as] feridas deles" }
      ]
    },
    "8": {
      "traducao_completa": "Assim eles farão com que as suas próprias línguas caiam sobre si mesmos; todos os que os virem fugirão.",
      "palavras": [
        { "hebraico": "וַיַּכְשִׁיל֣וּהוּ", "transliteral": "way-yaḵ-šî-lû-hû", "traducao_palavra": "e farão tropeçar" },
        { "hebraico": "עָלֵ֣ימֹו", "transliteral": "ʿā-lê-mô", "traducao_palavra": "sobre si mesmos" },
        { "hebraico": "לְשֹׁונָ֑ם", "transliteral": "lə-šô-nām", "traducao_palavra": "a língua deles" },
        { "hebraico": "יִ֝תְנֹדֲד֗וּ", "transliteral": "yiṯ-nō-ḏă-ḏû", "traducao_palavra": "vaguearão/fugirão" },
        { "hebraico": "כָּל־", "transliteral": "kāl-", "traducao_palavra": "todos" },
        { "hebraico": "רֹ֥אֵה", "transliteral": "rō-ʾēh", "traducao_palavra": "[que] virem" },
        { "hebraico": "בָֽם׃", "transliteral": "ḇām", "traducao_palavra": "neles" }
      ]
    },
    "9": {
      "traducao_completa": "E todos os homens temerão, e anunciarão a obra de Deus, e considerarão sabiamente os seus feitos.",
      "palavras": [
        { "hebraico": "וַיִּירְא֗וּ", "transliteral": "way-yî-rə-ʾû", "traducao_palavra": "e temerão" },
        { "hebraico": "כָּל־", "transliteral": "kāl-", "traducao_palavra": "todos" },
        { "hebraico": "אָ֫דָ֥ם", "transliteral": "ʾā-ḏām", "traducao_palavra": "homens" },
        { "hebraico": "וַ֭יַּגִּידוּ", "transliteral": "way-yag-gî-ḏû", "traducao_palavra": "e anunciarão" },
        { "hebraico": "פֹּ֣עַל", "transliteral": "pō-ʿal", "traducao_palavra": "[a] obra de" },
        { "hebraico": "אֱלֹהִ֑ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "Deus" },
        { "hebraico": "וּֽמַעֲשֵׂ֗הוּ", "transliteral": "ū-ma-ʿă-śē-hû", "traducao_palavra": "e o feito dele" },
        { "hebraico": "הִשְׂכִּֽילוּ׃", "transliteral": "hiś-kî-lû", "traducao_palavra": "considerarão sabiamente" }
      ]
    },
    "10": {
      "traducao_completa": "O justo se alegrará em YHWH e confiará nele; e todos os retos de coração se gloriarão.",
      "palavras": [
        { "hebraico": "יִשְׂמַ֬ח", "transliteral": "yiś-maḥ", "traducao_palavra": "se alegrará" },
        { "hebraico": "צַדִּ֣יק", "transliteral": "ṣad-dîq", "traducao_palavra": "[o] justo" },
        { "hebraico": "בַּיהוָה֮", "transliteral": "bay-hwāh", "traducao_palavra": "em YHWH" },
        { "hebraico": "וְחָ֪סָה", "transliteral": "wə-ḥā-śā", "traducao_palavra": "e se refugiará/confiará" },
        { "hebraico": "בֹ֑ו", "transliteral": "bô", "traducao_palavra": "nele" },
        { "hebraico": "וְ֝יִתְהַלְל֗וּ", "transliteral": "wə-yiṯ-hal-lə-lû", "traducao_palavra": "e se gloriarão" },
        { "hebraico": "כָּל־", "transliteral": "kāl-", "traducao_palavra": "todos" },
        { "hebraico": "יִשְׁרֵי־", "transliteral": "yiš-rê-", "traducao_palavra": "[os] retos de" },
        { "hebraico": "לֵֽב׃", "transliteral": "lēḇ", "traducao_palavra": "coração" }
      ]
    }
  }
