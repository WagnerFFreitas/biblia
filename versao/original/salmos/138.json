        { "hebraico": "אֹודְךָ֥", "transliteral": "ʾô-ḏə-ḵā", "traducao_palavra": "louvar-te-ei/renderei graças" },
        { "hebraico": "בְכָל־", "transliteral": "ḇə-ḵāl-", "traducao_palavra": "com todo" },
        { "hebraico": "לִבִּ֑י", "transliteral": "lib-bî", "traducao_palavra": "meu coração" },
        { "hebraico": "נֶ֖גֶד", "transliteral": "ne-ḡeḏ", "traducao_palavra": "diante de/na presença de" },
        { "hebraico": "אֱלֹהִ֣ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "deuses/juízes" },
        { "hebraico": "אֲזַמְּרֶֽךָּ׃", "transliteral": "ʾă-zam-mə-re-kkā", "traducao_palavra": "salmodiarei a ti" }
      ]
    },
    "2": {
      "traducao_completa": "Prostrar-me-ei para o teu santo templo, e louvarei o teu nome por causa da tua benignidade e da tua verdade; pois engrandeceste a tua palavra acima de todo o teu nome.",
      "palavras": [
        { "hebraico": "אֶשְׁתַּחֲוֶ֨ה", "transliteral": "ʾeš-ta-ḥă-weh", "traducao_palavra": "prostrar-me-ei" },
