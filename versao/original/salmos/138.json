        { "hebraico": "הֵיכַ֪ל", "transliteral": "hê-ḵal", "traducao_palavra": "[o] templo de" },
        { "hebraico": "קָדְשְׁךָ֡", "transliteral": "qāḏ-šə-ḵā", "traducao_palavra": "tua santidade" },
        { "hebraico": "וְאֹ֘ודֶ֤ה", "transliteral": "wə-ʾô-ḏeh", "traducao_palavra": "e louvarei" },
        { "hebraico": "אֶת־", "transliteral": "ʾeṯ-", "traducao_palavra": "[objeto]" },
        { "hebraico": "שְׁמֶ֗ךָ", "transliteral": "šə-me-ḵā", "traducao_palavra": "teu nome" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "por causa de" },
        { "hebraico": "חַסְדְּךָ֥", "transliteral": "ḥas-də-ḵā", "traducao_palavra": "tua bondade" },
        { "hebraico": "וְעַל־", "transliteral": "wə-ʿal-", "traducao_palavra": "e por causa de" },
        { "hebraico": "אֲמִתֶּ֑ךָ", "transliteral": "ʾă-mit-te-ḵā", "traducao_palavra": "tua verdade" },
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "porque" },
        { "hebraico": "הִגְדַּ֥לְתָּ", "transliteral": "hiḡ-dal-tā", "traducao_palavra": "engrandeceste" },
