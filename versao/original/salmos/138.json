        { "hebraico": "כָּל־", "transliteral": "kāl-", "traducao_palavra": "todo" },
        { "hebraico": "שִׁ֝מְךָ֗", "transliteral": "šim-ḵā", "traducao_palavra": "teu nome" },
        { "hebraico": "אִמְרָתֶֽךָ׃", "transliteral": "ʾim-rā-ṯe-ḵā", "traducao_palavra": "tua palavra" }
      ]
