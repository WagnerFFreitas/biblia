        { "hebraico": "קָ֭רָאתִי", "transliteral": "qā-rā-ṯî", "traducao_palavra": "eu clamei" },
        { "hebraico": "וַֽתַּעֲנֵ֑נִי", "transliteral": "wat-ta-ʿă-nē-nî", "traducao_palavra": "e tu me respondeste" },
        { "hebraico": "תַּרְהִבֵ֖נִי", "transliteral": "tar-hî-ḇē-nî", "traducao_palavra": "encorajaste-me" },
