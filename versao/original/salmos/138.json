        { "hebraico": "מַלְכֵי־", "transliteral": "mal-ḵê-", "traducao_palavra": "reis de" },
        { "hebraico": "אָ֑רֶץ", "transliteral": "ʾā-reṣ", "traducao_palavra": "terra" },
