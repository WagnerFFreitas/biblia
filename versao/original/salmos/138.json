    "7": {
      "traducao_completa": "Andando eu no meio da angústia, tu me vivificarás; estenderás a tua mão contra a ira dos meus inimigos, e a tua destra me salvará.",
      "palavras": [
        { "hebraico": "אִם־", "transliteral": "ʾim-", "traducao_palavra": "se" },
        { "hebraico": "אֵלֵ֨ךְ", "transliteral": "ʾē-lēḵ", "traducao_palavra": "eu andar" },
        { "hebraico": "בְּקֶ֥רֶב", "transliteral": "bə-qe-reḇ", "traducao_palavra": "no meio de" },
        { "hebraico": "צָרָ֗ה", "transliteral": "ṣā-rā", "traducao_palavra": "angústia" },
        { "hebraico": "תְּחַ֫יֵּ֥נִי", "transliteral": "tə-ḥay-yê-nî", "traducao_palavra": "tu me vivificarás" },
