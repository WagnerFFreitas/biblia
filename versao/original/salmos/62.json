        { "hebraico": "וִֽישׁוּעָתִ֗י", "transliteral": "wî-šû-ʿā-ṯî", "traducao_palavra": "e minha salvação" },
        { "hebraico": "מִ֭שְׂגַּבִּֽי", "transliteral": "miś-gab-bî", "traducao_palavra": "minha fortaleza/alto refúgio" },
