  "versiculos": {
    "1": {
      "traducao_completa": "Somente em Deus a minha alma espera silenciosa; dele vem a minha salvação.",
      "palavras": [
        { "hebraico": "אַ֤ךְ", "transliteral": "ʾaḵ", "traducao_palavra": "somente/certamente" },
        { "hebraico": "אֶל־", "transliteral": "ʾel-", "traducao_palavra": "em/para" },
        { "hebraico": "אֱלֹהִ֗ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "Deus" },
        { "hebraico": "דּֽוּמִיָּ֥ה", "transliteral": "dû-miy-yā", "traducao_palavra": "silenciosa [está]" },
        { "hebraico": "נַפְשִׁ֑י", "transliteral": "nap̄-šî", "traducao_palavra": "minha alma" },
        { "hebraico": "מִ֝מֶּ֗נּוּ", "transliteral": "mim-men-nû", "traducao_palavra": "dele" },
        { "hebraico": "יְשׁוּעָתִֽי׃", "transliteral": "yə-šû-ʿā-ṯî", "traducao_palavra": "minha salvação" }
      ]
    },
    "2": {
      "traducao_completa": "Só ele é a minha rocha e a minha salvação; é a minha defesa; não serei muito abalado.",
