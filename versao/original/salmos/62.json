    "5": {
      "traducao_completa": "Ó minha alma, espera silenciosa somente em Deus, porque dele vem a minha esperança.",
      "palavras": [
        { "hebraico": "אַ֤ךְ", "transliteral": "ʾaḵ", "traducao_palavra": "somente" },
        { "hebraico": "לֵאלֹהִ֗ים", "transliteral": "lê-lō-hîm", "traducao_palavra": "em Deus" },
        { "hebraico": "דֹּ֣ומִּי", "transliteral": "dôm-mî", "traducao_palavra": "espera silenciosa/sê quieta" },
