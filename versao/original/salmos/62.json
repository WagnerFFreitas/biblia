        { "hebraico": "כָזָ֑ב", "transliteral": "ḵā-zāḇ", "traducao_palavra": "mentira" },
        { "hebraico": "בְּפִ֥יו", "transliteral": "bə-p̄îw", "traducao_palavra": "com a sua boca" },
