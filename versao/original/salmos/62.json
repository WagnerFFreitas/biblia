        { "hebraico": "אָ֨נָה", "transliteral": "ʾā-nā", "traducao_palavra": "quando" },
        { "hebraico": "תְּהֹותְת֣וּ", "transliteral": "tə-hô-ṯə-ṯû", "traducao_palavra": "atacareis/gritareis" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "contra" },
