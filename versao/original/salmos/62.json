        { "hebraico": "אֶמֹּ֥וט", "transliteral": "ʾem-môṭ", "traducao_palavra": "serei abalado" },
        { "hebraico": "רַבָּֽה׃", "transliteral": "rab-bā", "traducao_palavra": "muito/grandemente" }
