        { "hebraico": "מִשְּׂאֵתֹ֨ו", "transliteral": "miś-śə-ʾē-ṯô", "traducao_palavra": "da sua dignidade/exaltação" },
        { "hebraico": "יָעֲצ֣וּ", "transliteral": "yā-ʿă-ṣû", "traducao_palavra": "consultaram/planejaram" },
        { "hebraico": "לְהַדִּ֓יחַ", "transliteral": "lə-had-dî-aḥ", "traducao_palavra": "para derrubar" },
