        { "hebraico": "דִ֭כִּיתָנוּ", "transliteral": "dik-kî-ṯā-nû", "traducao_palavra": "tu nos esmagaste" },
        { "hebraico": "בִּמְקֹ֣ום", "transliteral": "bim-qôm", "traducao_palavra": "num lugar de" },
        { "hebraico": "תַּנִּ֑ים", "transliteral": "tan-nîm", "traducao_palavra": "chacais" },
        { "hebraico": "וַתְּכַ֖ס", "transliteral": "wat-tə-ḵas", "traducao_palavra": "e cobriste" },
        { "hebraico": "עָלֵ֣ינוּ", "transliteral": "ʿā-lê-nû", "traducao_palavra": "sobre nós" },
