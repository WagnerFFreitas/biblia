        { "hebraico": "אֲדֹנָ֑י", "transliteral": "ʾă-ḏō-nāy", "traducao_palavra": "Senhor" },
        { "hebraico": "הָ֝קִ֗יצָה", "transliteral": "hā-qî-ṣā", "traducao_palavra": "acorda" },
        { "hebraico": "אַל־תִּזְנַ֥ח", "transliteral": "ʾal-tiz-naḥ", "traducao_palavra": "não rejeites" },
