        { "hebraico": "יַחֲקָר־זֹ֑את", "transliteral": "ya-ḥă-qar-zōṯ", "traducao_palavra": "esquadrinhará isto" },
        { "hebraico": "כִּי־ה֝וּא", "transliteral": "kî-hû", "traducao_palavra": "pois ele" },
