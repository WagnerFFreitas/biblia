    "20": {
      "traducao_completa": "Se nos esquecemos do nome do nosso Deus, ou estendemos as nossas mãos a um deus estranho,",
      "palavras": [
        { "hebraico": "אִם־שָׁ֭כַחֲנוּ", "transliteral": "ʾim-šā-ḵa-ḥă-nû", "traducao_palavra": "se esquecemos" },
        { "hebraico": "שֵׁ֣ם", "transliteral": "šēm", "traducao_palavra": "[o] nome de" },
        { "hebraico": "אֱלֹהֵ֑ינוּ", "transliteral": "ʾĕ-lō-hê-nû", "traducao_palavra": "nosso Deus" },
        { "hebraico": "וַנִּפְרֹ֥שׂ", "transliteral": "wan-nip̄-rōś", "traducao_palavra": "e estendemos" },
        { "hebraico": "כַּ֝פֵּ֗ינוּ", "transliteral": "kap-pê-nû", "traducao_palavra": "nossas palmas/mãos" },
