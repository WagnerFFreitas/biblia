    "22": {
      "traducao_completa": "Sim, por amor de ti, somos entregues à morte todo o dia; somos reputados como ovelhas para o matadouro.",
      "palavras": [
        { "hebraico": "כִּֽי־עָלֶ֭יךָ", "transliteral": "kî-ʿā-le-ḵā", "traducao_palavra": "pois por ti" },
