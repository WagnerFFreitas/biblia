        { "hebraico": "תַסְתִּ֪יר", "transliteral": "tas-tîr", "traducao_palavra": "escondes" },
        { "hebraico": "תִּשְׁכַּ֖ח", "transliteral": "tiš-kaḥ", "traducao_palavra": "esqueces" },
        { "hebraico": "עָנְיֵ֣נוּ", "transliteral": "ʿā-nyê-nû", "traducao_palavra": "nossa aflição" },
        { "hebraico": "וְלַחֲצֵֽנוּ׃", "transliteral": "wə-la-ḥă-ṣê-nû", "traducao_palavra": "e nossa opressão" }
