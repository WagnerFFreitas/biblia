        { "hebraico": "לֶֽעָפָ֣ר", "transliteral": "le-ʿā-p̄ār", "traducao_palavra": "até ao pó" },
        { "hebraico": "נַפְשֵׁ֑נוּ", "transliteral": "nap̄-šê-nû", "traducao_palavra": "nossa alma" },
        { "hebraico": "דָּבְקָ֖ה", "transliteral": "dā-ḇə-qā", "traducao_palavra": "está apegada" },
