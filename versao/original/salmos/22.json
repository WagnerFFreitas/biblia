        { "hebraico": "יַֽעַבְדֶ֑נּוּ", "transliteral": "ya-ʿaḇ-ḏen-nû", "traducao_palavra": "o servirá" },
        { "hebraico": "יְסֻפַּ֖ר", "transliteral": "yə-sup-par", "traducao_palavra": "será contada/declarada" },
        { "hebraico": "לַֽאדֹנָ֣י", "transliteral": "la-ḏō-nāy", "traducao_palavra": "ao Senhor" },
        { "hebraico": "לַדֹּֽור׃", "transliteral": "lad-dôr", "traducao_palavra": "à geração [seguinte]" }
      ]
    },
    "31": {
      "traducao_completa": "Eles virão e anunciarão a sua justiça a um povo que há de nascer, pois ele fez isto.",
