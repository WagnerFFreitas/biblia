        { "hebraico": "וּ֝מֹשֵׁ֗ל", "transliteral": "ū-mō-šēl", "traducao_palavra": "e [ele] governa" },
        { "hebraico": "בַּגֹּויִֽם׃", "transliteral": "bag-gô-yim", "traducao_palavra": "entre as nações" }
      ]
    },
    "29": {
      "traducao_completa": "Todos os grandes da terra comerão e adorarão; perante ele se prostrarão todos os que descem ao pó e os que não podem reter a vida em suas almas.",
      "palavras": [
        { "hebraico": "אָכְל֬וּ", "transliteral": "ʾā-ḵə-lû", "traducao_palavra": "comerão" },
        { "hebraico": "וַיִּֽשְׁתַּחֲוּ֨וּ", "transliteral": "way-yiš-ta-ḥă-wû", "traducao_palavra": "e adorarão" },
        { "hebraico": "כָּל־דִּשְׁנֵי־אָ֑רֶץ", "transliteral": "kāl-diš-nê-ʾā-reṣ", "traducao_palavra": "todos os gordos/prósperos da terra" },
        { "hebraico": "לְפָנָ֣יו", "transliteral": "lə-p̄ā-nāw", "traducao_palavra": "diante dele" },
        { "hebraico": "יִ֭כְרְעוּ", "transliteral": "yiḵ-rə-ʿû", "traducao_palavra": "se curvarão" },
        { "hebraico": "כָּל־יֹורְדֵ֣י", "transliteral": "kāl-yô-rə-ḏê", "traducao_palavra": "todos os que descem ao" },
        { "hebraico": "עָפָ֑ר", "transliteral": "ʿā-p̄ār", "traducao_palavra": "pó" },
        { "hebraico": "וְ֝נַפְשֹׁ֗ו", "transliteral": "wə-nap̄-šô", "traducao_palavra": "e sua alma" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "חִיָּֽה׃", "transliteral": "ḥiy-yā", "traducao_palavra": "reteve a vida" }
      ]
