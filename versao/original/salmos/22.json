        { "hebraico": "יְחַלְּק֣וּ", "transliteral": "yə-ḥal-lə-qû", "traducao_palavra": "repartem" },
        { "hebraico": "בְגָדַ֣י", "transliteral": "ḇə-ḡā-ḏay", "traducao_palavra": "minhas vestes" },
        { "hebraico": "לָהֶ֑ם", "transliteral": "lā-hem", "traducao_palavra": "para eles" },
        { "hebraico": "וְעַל־לְ֝בוּשִׁ֗י", "transliteral": "wə-ʿal-lə-ḇû-šî", "traducao_palavra": "e sobre minha túnica/veste" },
