      ]
    },
    "22": {
      "traducao_completa": "Anunciarei o teu nome aos meus irmãos; louvar-te-ei no meio da congregação.",
      "palavras": [
        { "hebraico": "אֲסַפְּרָ֣ה", "transliteral": "ʾă-sap-pə-rā", "traducao_palavra": "anunciarei/contarei" },
        { "hebraico": "שִׁמְךָ֣", "transliteral": "šim-ḵā", "traducao_palavra": "teu nome" },
        { "hebraico": "לְאֶחָ֑י", "transliteral": "lə-ʾe-ḥāy", "traducao_palavra": "aos meus irmãos" },
        { "hebraico": "בְּתֹ֖וךְ", "transliteral": "bə-ṯôḵ", "traducao_palavra": "no meio de" },
        { "hebraico": "קָהָ֣ל", "transliteral": "qā-hāl", "traducao_palavra": "[a] congregação" },
        { "hebraico": "אֲהַלְלֶֽךָּ׃", "transliteral": "ʾă-hal-le-kā", "traducao_palavra": "louvar-te-ei" }
      ]
    },
    "23": {
      "traducao_completa": "Vós, que temeis a YHWH, louvai-o; todos vós, descendência de Jacó, glorificai-o; e temei-o todos vós, descendência de Israel.",
      "palavras": [
