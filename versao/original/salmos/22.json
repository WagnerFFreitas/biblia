        { "hebraico": "לֹא־בָזָ֨ה", "transliteral": "lō-ḇā-zā", "traducao_palavra": "não desprezou" },
        { "hebraico": "וְלֹ֪א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "שִׁקַּ֡ץ", "transliteral": "šiq-qaṣ", "traducao_palavra": "abominou" },
        { "hebraico": "עֱנ֬וּת", "transliteral": "ʿĕ-nûṯ", "traducao_palavra": "[a] aflição de" },
        { "hebraico": "עָנִ֗י", "transliteral": "ʿā-nî", "traducao_palavra": "[o] aflito" },
        { "hebraico": "וְלֹא־הִסְתִּ֣יר", "transliteral": "wə-lō-his-tîr", "traducao_palavra": "e não escondeu" },
        { "hebraico": "פָּנָ֣יו", "transliteral": "pā-nāw", "traducao_palavra": "rosto dele" },
        { "hebraico": "מִמֶּ֑נּוּ", "transliteral": "mim-men-nû", "traducao_palavra": "dele" },
        { "hebraico": "וּֽבְשַׁוְּעֹ֖ו", "transliteral": "ū-ḇə-šaw-wə-ʿô", "traducao_palavra": "e no seu clamar" },
        { "hebraico": "אֵלָ֣יו", "transliteral": "ʾē-lāw", "traducao_palavra": "a ele" },
        { "hebraico": "שָׁמֵֽעַ׃", "transliteral": "šā-mē-aʿ", "traducao_palavra": "ouviu" }
      ]
    },
    "25": {
      "traducao_completa": "O meu louvor virá de ti na grande congregação; pagarei os meus votos na presença dos que o temem.",
      "palavras": [
        { "hebraico": "מֵֽאִתְּךָ֥", "transliteral": "mē-ʾit-tə-ḵā", "traducao_palavra": "de ti [vem]" },
        { "hebraico": "תְהִלָּתִ֗i", "transliteral": "tə-hil-lā-ṯî", "traducao_palavra": "meu louvor" },
        { "hebraico": "בְּקָהָ֥ל", "transliteral": "bə-qā-hāl", "traducao_palavra": "na congregação" },
