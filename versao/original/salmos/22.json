        { "hebraico": "צִדְקָתֹ֑ו", "transliteral": "ṣiḏ-qā-ṯô", "traducao_palavra": "sua justiça" },
        { "hebraico": "לְעַ֥ם", "transliteral": "lə-ʿam", "traducao_palavra": "a um povo" },
        { "hebraico": "נֹ֝ולָ֗ד", "transliteral": "nô-lāḏ", "traducao_palavra": "[que] nascerá" },
        { "hebraico": "כִּ֣י", "transliteral": "kî", "traducao_palavra": "que" },
        { "hebraico": "עָשָֽׂה׃", "transliteral": "ʿā-śā", "traducao_palavra": "ele fez/realizou" }
