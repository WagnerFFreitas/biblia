        { "hebraico": "עֲנָוִ֨ים", "transliteral": "ʿă-nā-wîm", "traducao_palavra": "mansos/humildes" },
        { "hebraico": "וְיִשְׂבָּ֗עוּ", "transliteral": "wə-yiś-bā-ʿû", "traducao_palavra": "e se fartarão" },
        { "hebraico": "יְהַֽלְל֣וּ", "transliteral": "yə-hal-lû", "traducao_palavra": "louvarão" },
