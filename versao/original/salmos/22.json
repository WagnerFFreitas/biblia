{
  "livro": "Salmos - תְּהִלִּים - Tehillim",
  "capítulo": 22,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Ao mestre de canto, segundo 'A Corça da Manhã'. Salmo de Davi. Deus meu, Deus meu, por que me desamparaste? Por que estás longe de me salvar e das palavras do meu bramido?",
      "palavras": [
        { "hebraico": "לַמְנַצֵּ֗חַ", "transliteral": "lam-naṣ-ṣē-aḥ", "traducao_palavra": "ao mestre de canto" },
        { "hebraico": "עַל־אַיֶּ֥לֶת", "transliteral": "ʿal-ʾay-ye-leṯ", "traducao_palavra": "sobre/segundo a corça de" },
        { "hebraico": "הַשַּׁ֖חַר", "transliteral": "ha-ša-ḥar", "traducao_palavra": "a manhã" },
        { "hebraico": "מִזְמֹ֥ור", "transliteral": "miz-môr", "traducao_palavra": "salmo" },
        { "hebraico": "לְדָוִֽד", "transliteral": "lə-ḏā-wiḏ", "traducao_palavra": "de Davi" },
        { "hebraico": "אֵלִ֣י", "transliteral": "ʾē-lî", "traducao_palavra": "Deus meu" },
        { "hebraico": "אֵ֭לִי", "transliteral": "ʾē-lî", "traducao_palavra": "Deus meu" },
        { "hebraico": "לָמָ֣ה", "transliteral": "lā-mā", "traducao_palavra": "por que" },
        { "hebraico": "עֲזַבְתָּ֑נִי", "transliteral": "ʿă-zaḇ-tā-nî", "traducao_palavra": "me desamparaste/abandonaste" },
        { "hebraico": "רָחֹ֥וק", "transliteral": "rā-ḥôq", "traducao_palavra": "[estás] longe" },
        { "hebraico": "מִֽ֝ישׁוּעָתִ֗י", "transliteral": "mî-šû-ʿā-ṯî", "traducao_palavra": "da minha salvação" },
        { "hebraico": "דִּבְרֵ֥י", "transliteral": "diḇ-rê", "traducao_palavra": "[das] palavras de" },
        { "hebraico": "שַׁאֲגָתִֽי׃", "transliteral": "ša-ʾă-ḡā-ṯî", "traducao_palavra": "meu bramido/rugido" }
      ]
    },
    "2": {
      "traducao_completa": "Deus meu, eu clamo de dia, e tu não me ouves; e de noite, e não tenho sossego.",
      "palavras": [
        { "hebraico": "אֱלֹהַ֗י", "transliteral": "ʾĕ-lō-hay", "traducao_palavra": "Deus meu" },
        { "hebraico": "אֶקְרָ֣א", "transliteral": "ʾeq-rā", "traducao_palavra": "eu clamo/invoco" },
        { "hebraico": "יֹ֭ומָם", "transliteral": "yô-mām", "traducao_palavra": "de dia" },
        { "hebraico": "וְלֹ֣א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "תַעֲנֶ֑ה", "transliteral": "ta-ʿă-neh", "traducao_palavra": "respondes/ouves" },
        { "hebraico": "וְ֝לַ֗יְלָה", "transliteral": "wə-lay-lā", "traducao_palavra": "e de noite" },
        { "hebraico": "וְלֹא־דוּמִיָּ֥ה", "transliteral": "wə-lō-ḏû-miy-yā", "traducao_palavra": "e não [há] silêncio/descanso" },
        { "hebraico": "לִֽי׃", "transliteral": "lî", "traducao_palavra": "para mim" }
      ]
    },
    "3": {
      "traducao_completa": "Contudo tu és santo, entronizado entre os louvores de Israel.",
      "palavras": [
        { "hebraico": "וְאַתָּ֥ה", "transliteral": "wə-ʾat-tā", "traducao_palavra": "contudo tu" },
        { "hebraico": "קָדֹ֑ושׁ", "transliteral": "qā-ḏôš", "traducao_palavra": "[és] santo" },
        { "hebraico": "יֹ֝ושֵׁ֗ב", "transliteral": "yô-šēḇ", "traducao_palavra": "habitando/sentado" },
        { "hebraico": "תְּהִלֹּ֥ות", "transliteral": "tə-hil-lôṯ", "traducao_palavra": "[nos] louvores de" },
        { "hebraico": "יִשְׂרָאֵֽל׃", "transliteral": "yiś-rā-ʾēl", "traducao_palavra": "Israel" }
      ]
    },
    "4": {
      "traducao_completa": "Em ti confiaram nossos pais; confiaram, e tu os livraste.",
      "palavras": [
        { "hebraico": "בְּ֭ךָ", "transliteral": "bə-ḵā", "traducao_palavra": "em ti" },
        { "hebraico": "בָּטְח֣וּ", "transliteral": "bā-ṭə-ḥû", "traducao_palavra": "confiaram" },
        { "hebraico": "אֲבֹתֵ֑ינוּ", "transliteral": "ʾă-ḇō-ṯê-nû", "traducao_palavra": "nossos pais" },
        { "hebraico": "בָּ֝טְח֗וּ", "transliteral": "bā-ṭə-ḥû", "traducao_palavra": "confiaram" },
        { "hebraico": "וַֽתְּפַלְּטֵֽמֹו׃", "transliteral": "wat-tə-p̄al-lə-ṭê-mô", "traducao_palavra": "e tu os livraste" }
      ]
    },
    "5": {
      "traducao_completa": "A ti clamaram e escaparam; em ti confiaram e não foram envergonhados.",
      "palavras": [
        { "hebraico": "אֵלֶ֣יךָ", "transliteral": "ʾē-ley-ḵā", "traducao_palavra": "a ti" },
        { "hebraico": "זָעֲק֣וּ", "transliteral": "zā-ʿă-qû", "traducao_palavra": "clamaram" },
        { "hebraico": "וְנִמְלָ֑טוּ", "transliteral": "wə-nim-lā-ṭû", "traducao_palavra": "e escaparam/foram salvos" },
        { "hebraico": "בְּךָתָ֖ בָטְח֥וּ", "transliteral": "bə-ḵā ḇā-ṭə-ḥû", "traducao_palavra": "em ti confiaram" },
        { "hebraico": "וְלֹא־בֹֽושׁוּ׃", "transliteral": "wə-lō-ḇô-šû", "traducao_palavra": "e não foram envergonhados" }
      ]
    },
    "6": {
      "traducao_completa": "Mas eu sou verme, e não homem; opróbrio dos homens e desprezado do povo.",
      "palavras": [
        { "hebraico": "וְאָנֹכִ֣י", "transliteral": "wə-ʾā-nō-ḵî", "traducao_palavra": "mas eu" },
        { "hebraico": "תֹולַ֣עַת", "transliteral": "ṯô-la-ʿaṯ", "traducao_palavra": "[sou] verme" },
        { "hebraico": "וְלֹא־אִ֑ישׁ", "transliteral": "wə-lō-ʾîš", "traducao_palavra": "e não homem" },
        { "hebraico": "חֶרְפַּ֥ת", "transliteral": "ḥer-paṯ", "traducao_palavra": "opróbrio de" },
        { "hebraico": "אָ֝דָ֗ם", "transliteral": "ʾā-ḏām", "traducao_palavra": "homens" },
        { "hebraico": "וּבְז֥וּי", "transliteral": "ū-ḇə-zûy", "traducao_palavra": "e desprezado de" },
        { "hebraico": "עָֽם׃", "transliteral": "ʿām", "traducao_palavra": "povo" }
      ]
    },
    "7": {
      "traducao_completa": "Todos os que me veem zombam de mim; estendem os lábios e meneiam a cabeça, dizendo:",
      "palavras": [
        { "hebraico": "כָּל־רֹ֭אַי", "transliteral": "kāl-rō-ʾay", "traducao_palavra": "todos que me veem" },
        { "hebraico": "יַלְעִ֣גוּ", "transliteral": "yal-ʿi-ḡû", "traducao_palavra": "zombam" },
        { "hebraico": "לִ֑י", "transliteral": "lî", "traducao_palavra": "de mim" },
        { "hebraico": "יַפְטִ֥ירוּ", "transliteral": "yap̄-ṭî-rû", "traducao_palavra": "eles abrem/escancaram" },
        { "hebraico": "בְשָׂפָ֗ה", "transliteral": "ḇə-śā-p̄ā", "traducao_palavra": "com o lábio" },
        { "hebraico": "יָנִ֥יעוּ", "transliteral": "yā-nî-ʿû", "traducao_palavra": "eles balançam/meneiam" },
        { "hebraico": "רֹֽאשׁ׃", "transliteral": "rōš", "traducao_palavra": "[a] cabeça" }
      ]
    },
    "8": {
      "traducao_completa": "Confiou em YHWH, livra-o; salve-o, pois nele tem prazer.",
      "palavras": [
        { "hebraico": "גֹּ֣ל", "transliteral": "gōl", "traducao_palavra": "confia/entrega" },
        { "hebraico": "אֶל־יְהוָ֣ה", "transliteral": "ʾel-YHWH", "traducao_palavra": "a YHWH" },
        { "hebraico": "יְפַלְּטֵ֑הוּ", "transliteral": "yə-p̄al-lə-ṭē-hû", "traducao_palavra": "ele o livrará" },
        { "hebraico": "יַ֝צִּילֵ֗הוּ", "transliteral": "yaṣ-ṣî-lê-hû", "traducao_palavra": "ele o salve" },
        { "hebraico": "כִּ֘י", "transliteral": "kî", "traducao_palavra": "pois" },
        { "hebraico": "חָ֥פֵֽץ", "transliteral": "ḥā-p̄ēṣ", "traducao_palavra": "tem prazer/deseja" },
        { "hebraico": "בֹּֽו׃", "transliteral": "bô", "traducao_palavra": "nele" }
      ]
    },
    "9": {
      "traducao_completa": "Mas tu és o que me tiraste do ventre; fizeste-me confiar, estando ainda aos seios de minha mãe.",
      "palavras": [
        { "hebraico": "כִּֽי־אַתָּ֣ה", "transliteral": "kî-ʾat-tā", "traducao_palavra": "pois tu" },
        { "hebraico": "גֹ֭חִי", "transliteral": "ḡō-ḥî", "traducao_palavra": "[o que] me tiraste" },
        { "hebraico": "מִבָּ֑טֶן", "transliteral": "mib-bā-ṭen", "traducao_palavra": "do ventre" },
        { "hebraico": "מַ֝בְטִיחִ֗י", "transliteral": "maḇ-ṭî-ḥî", "traducao_palavra": "[o que] me fez confiar" },
        { "hebraico": "עַל־שְׁדֵ֥י", "transliteral": "ʿal-šə-ḏê", "traducao_palavra": "sobre os seios de" },
        { "hebraico": "אִמִּֽי׃", "transliteral": "ʾim-mî", "traducao_palavra": "minha mãe" }
      ]
    },
    "10": {
      "traducao_completa": "Sobre ti fui lançado desde a madre; tu és o meu Deus desde o ventre de minha mãe.",
      "palavras": [
        { "hebraico": "עָ֭לֶיךָ", "transliteral": "ʿā-ley-ḵā", "traducao_palavra": "sobre ti" },
        { "hebraico": "הָשְׁלַ֣כְתִּי", "transliteral": "hāš-laḵ-tî", "traducao_palavra": "fui lançado" },
        { "hebraico": "מֵרָ֑חֶם", "transliteral": "mē-rā-ḥem", "traducao_palavra": "desde o útero" },
        { "hebraico": "מִבֶּ֥טֶן", "transliteral": "mib-be-ṭen", "traducao_palavra": "desde o ventre de" },
        { "hebraico": "אִ֝מִּ֗י", "transliteral": "ʾim-mî", "traducao_palavra": "minha mãe" },
        { "hebraico": "אֵלִ֥י", "transliteral": "ʾē-lî", "traducao_palavra": "meu Deus" },
        { "hebraico": "אָֽתָּה׃", "transliteral": "ʾāt-tā", "traducao_palavra": "[és] tu" }
      ]
    },
    "11": {
      "traducao_completa": "Não te alongues de mim, pois a angústia está perto, e não há quem ajude.",
      "palavras": [
        { "hebraico": "אַל־תִּרְחַ֣ק", "transliteral": "ʾal-tir-ḥaq", "traducao_palavra": "não te alongues/afastes" },
        { "hebraico": "מִ֭מֶּנִּי", "transliteral": "mim-men-nî", "traducao_palavra": "de mim" },
        { "hebraico": "כִּי־צָרָ֣ה", "transliteral": "kî-ṣā-rā", "traducao_palavra": "pois a angústia" },
        { "hebraico": "קְרֹובָ֑ה", "transliteral": "qə-rô-ḇā", "traducao_palavra": "[está] perto" },
        { "hebraico": "כִּי־אֵ֥ין", "transliteral": "kî-ʾên", "traducao_palavra": "pois não há" },
        { "hebraico": "עֹוזֵֽר׃", "transliteral": "ʿô-zēr", "traducao_palavra": "ajudador/auxiliador" }
      ]
    },
    "12": {
      "traducao_completa": "Muitos touros me cercaram; fortes touros de Basã me rodearam.",
      "palavras": [
        { "hebraico": "סְבָב֭וּנִי", "transliteral": "sə-ḇā-ḇû-nî", "traducao_palavra": "cercaram-me" },
        { "hebraico": "פָּרִ֣ים", "transliteral": "pā-rîm", "traducao_palavra": "touros" },
        { "hebraico": "רַבִּ֑ים", "transliteral": "rab-bîm", "traducao_palavra": "muitos" },
        { "hebraico": "אַבִּירֵ֥י", "transliteral": "ʾab-bî-rê", "traducao_palavra": "fortes de/poderosos de" },
        { "hebraico": "בָ֝שָׁ֗ן", "transliteral": "ḇā-šān", "traducao_palavra": "Basã" },
        { "hebraico": "כִּתְּרֽוּנִי׃", "transliteral": "kit-tə-rû-nî", "traducao_palavra": "rodearam-me/sitiaram-me" }
      ]
    },
    "13": {
      "traducao_completa": "Abriram contra mim as suas bocas, como um leão que despedaça e que ruge.",
      "palavras": [
        { "hebraico": "פָּ֥צּוּ", "transliteral": "pā-ṣû", "traducao_palavra": "abriram/escancararam" },
        { "hebraico": "עָלַ֪י", "transliteral": "ʿā-lay", "traducao_palavra": "sobre mim/contra mim" },
        { "hebraico": "פִּיהֶ֑ם", "transliteral": "pî-hem", "traducao_palavra": "boca deles" },
        { "hebraico": "אַ֝רְיֵ֗ה", "transliteral": "ʾar-yēh", "traducao_palavra": "[como] leão" },
        { "hebraico": "טֹרֵ֥ף", "transliteral": "ṭō-rēp̄", "traducao_palavra": "[que] despedaça/arrebata" },
        { "hebraico": "וְשֹׁאֵֽג׃", "transliteral": "wə-šō-ʾēḡ", "traducao_palavra": "e ruge" }
      ]
    },
    "14": {
      "traducao_completa": "Como água me derramei, e todos os meus ossos se desconjuntaram; o meu coração é como cera, derreteu-se no meio das minhas entranhas.",
      "palavras": [
        { "hebraico": "כַּמַּ֥יִם", "transliteral": "kam-ma-yim", "traducao_palavra": "como água" },
        { "hebraico": "נִשְׁפַּ֫כְתִּי", "transliteral": "niš-pak-tî", "traducao_palavra": "derramei-me" },
        { "hebraico": "וְֽהִתְפָּרְד֗וּ", "transliteral": "wə-hiṯ-pā-rə-ḏû", "traducao_palavra": "e se separaram/desconjuntaram" },
        { "hebraico": "כָּֽל־עַצְמֹ֫ותָ֥י", "transliteral": "kāl-ʿaṣ-mô-ṯāy", "traducao_palavra": "todos os meus ossos" },
        { "hebraico": "הָיָ֣ה", "transliteral": "hā-yā", "traducao_palavra": "tornou-se" },
        { "hebraico": "לִ֭בִּי", "transliteral": "lib-bî", "traducao_palavra": "meu coração" },
        { "hebraico": "כַּדֹּונָ֑ג", "transliteral": "kad-dô-nāḡ", "traducao_palavra": "como a cera" },
        { "hebraico": "נָ֝מֵ֗ס", "transliteral": "nā-mēs", "traducao_palavra": "derretido" },
        { "hebraico": "בְּתֹ֣וךְ", "transliteral": "bə-ṯôḵ", "traducao_palavra": "no meio de" },
        { "hebraico": "מֵעָֽי׃", "transliteral": "mē-ʿāy", "traducao_palavra": "minhas entranhas" }
      ]
    },
    "15": {
      "traducao_completa": "A minha força secou-se como um caco de barro, e a minha língua se apega ao meu paladar; e me puseste no pó da morte.",
      "palavras": [
        { "hebraico": "יָ֘בֵ֤שׁ", "transliteral": "yā-ḇēš", "traducao_palavra": "secou-se" },
        { "hebraico": "כַּחֶ֨רֶשׂ", "transliteral": "ka-ḥe-reś", "traducao_palavra": "como caco de barro" },
        { "hebraico": "כֹּחִ֗י", "transliteral": "kō-ḥî", "traducao_palavra": "minha força" },
        { "hebraico": "וּ֭לְשֹׁונִי", "transliteral": "ū-lə-šô-nî", "traducao_palavra": "e minha língua" },
        { "hebraico": "מֻדְבָּ֣ק", "transliteral": "muḏ-bāq", "traducao_palavra": "apegada/colada" },
        { "hebraico": "מַלְקֹוחָ֑י", "transliteral": "mal-qô-ḥāy", "traducao_palavra": "meu paladar/mandíbulas" },
        { "hebraico": "וְלַעֲפַר־מָ֥וֶת", "transliteral": "wə-la-ʿă-p̄ar-mā-weṯ", "traducao_palavra": "e ao pó da morte" },
        { "hebraico": "תִּשְׁפְּתֵֽנִי׃", "transliteral": "tiš-pə-ṯē-nî", "traducao_palavra": "tu me puseste/assestaste" }
      ]
    },
    "16": {
      "traducao_completa": "Pois cães me cercaram; a assembleia de malfeitores me rodeou; traspassaram as minhas mãos e os meus pés.",
      "palavras": [
        { "hebraico": "כִּ֥י", "transliteral": "kî", "traducao_palavra": "pois" },
        { "hebraico": "סְבָב֭וּנִי", "transliteral": "sə-ḇā-ḇû-nî", "traducao_palavra": "cercaram-me" },
        { "hebraico": "כְּלָבִ֑ים", "transliteral": "kə-lā-ḇîm", "traducao_palavra": "cães" },
        { "hebraico": "עֲדַ֣ת", "transliteral": "ʿă-ḏaṯ", "traducao_palavra": "[a] assembleia de" },
        { "hebraico": "מְ֭רֵעִים", "transliteral": "mə-rē-ʿîm", "traducao_palavra": "malfeitores" },
        { "hebraico": "הִקִּיפ֭וּנִי", "transliteral": "hiq-qî-p̄û-nî", "traducao_palavra": "rodearam-me" },
        { "hebraico": "כָּ֝אֲרִ֗י", "transliteral": "kā-ʾă-rî", "traducao_palavra": "como leão [ou: traspassaram]" },
        { "hebraico": "יָדַ֥י", "transliteral": "yā-ḏay", "traducao_palavra": "minhas mãos" },
        { "hebraico": "וְרַגְלָֽי׃", "transliteral": "wə-raḡ-lāy", "traducao_palavra": "e meus pés" }
      ]
    },
    "17": {
      "traducao_completa": "Poderia contar todos os meus ossos; eles olham e me contemplam.",
      "palavras": [
        { "hebraico": "אֲסַפֵּ֥ר", "transliteral": "ʾă-sap-pēr", "traducao_palavra": "contaria/enumeraria" },
        { "hebraico": "כָּל־עַצְמֹותָ֑י", "transliteral": "kāl-ʿaṣ-mô-ṯāy", "traducao_palavra": "todos os meus ossos" },
        { "hebraico": "הֵ֥מָּה", "transliteral": "hēm-mā", "traducao_palavra": "eles" },
