        { "hebraico": "לְבַבְכֶ֗ם", "transliteral": "lə-ḇaḇ-ḵem", "traducao_palavra": "vosso coração" },
        { "hebraico": "לָעַֽד׃", "transliteral": "lā-ʿaḏ", "traducao_palavra": "para sempre" }
      ]
    },
    "27": {
      "traducao_completa": "Todos os limites da terra se lembrarão e se converterão a YHWH; e todas as famílias das nações adorarão perante a tua face.",
