        { "hebraico": "יְ֭הוָה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "הַֽלְל֑וּהוּ", "transliteral": "hal-lû-hû", "traducao_palavra": "louvai-o" },
        { "hebraico": "כָּל־זֶ֤רַע", "transliteral": "kāl-ze-raʿ", "traducao_palavra": "toda semente/descendência de" },
        { "hebraico": "יַעֲקֹ֨ב", "transliteral": "ya-ʿă-qōḇ", "traducao_palavra": "Jacó" },
        { "hebraico": "כַּבְּדֹ֗והוּ", "transliteral": "kab-bə-ḏô-hû", "traducao_palavra": "glorificai-o" },
        { "hebraico": "וְג֥וּרוּ", "transliteral": "wə-ḡû-rû", "traducao_palavra": "e temei-o/reverenciai-o" },
        { "hebraico": "מִ֝מֶּ֗נּוּ", "transliteral": "mim-men-nû", "traducao_palavra": "dele" },
        { "hebraico": "כָּל־זֶ֥רַע", "transliteral": "kāl-ze-raʿ", "traducao_palavra": "toda semente de" },
        { "hebraico": "יִשְׂרָאֵֽל׃", "transliteral": "yiś-rā-ʾēl", "traducao_palavra": "Israel" }
      ]
    },
    "24": {
      "traducao_completa": "Porque não desprezou nem abominou a aflição do aflito, nem escondeu dele o seu rosto; antes, quando ele clamou, o ouviu.",
