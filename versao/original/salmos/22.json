        { "hebraico": "וְיָשֻׁ֣בוּ", "transliteral": "wə-yā-šu-ḇû", "traducao_palavra": "e se converterão/voltarão" },
        { "hebraico": "אֶל־יְהוָ֭ה", "transliteral": "ʾel-YHWH", "traducao_palavra": "a YHWH" },
        { "hebraico": "כָּל־אַפְסֵי־אָ֑רֶץ", "transliteral": "kāl-ʾap̄-śê-ʾā-reṣ", "traducao_palavra": "todos os confins da terra" },
