    "19": {
      "traducao_completa": "Mas tu, YHWH, não te alongues; força minha, apressa-te em socorrer-me.",
      "palavras": [
        { "hebraico": "וְאַתָּ֣ה", "transliteral": "wə-ʾat-tā", "traducao_palavra": "mas tu" },
