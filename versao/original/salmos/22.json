        { "hebraico": "אַל־תִּרְḥָ֑ק", "transliteral": "ʾal-tir-ḥāq", "traducao_palavra": "não te alongues" },
        { "hebraico": "אֱ֝יָלוּתִ֗י", "transliteral": "ʾĕ-yā-lû-ṯî", "traducao_palavra": "minha força/auxílio" },
        { "hebraico": "לְעֶזְרָ֥תִי", "transliteral": "lə-ʿez-rā-ṯî", "traducao_palavra": "para meu socorro" },
        { "hebraico": "ח֪וּשָׁה׃", "transliteral": "ḥû-šā", "traducao_palavra": "apressa-te" }
      ]
    },
    "20": {
      "traducao_completa": "Livra a minha alma da espada, e a minha única das garras do cão.",
      "palavras": [
        { "hebraico": "הַצִּילָ֣ה", "transliteral": "haṣ-ṣî-lā", "traducao_palavra": "livra" },
        { "hebraico": "מֵחֶ֣רֶב", "transliteral": "mē-ḥe-reḇ", "traducao_palavra": "da espada" },
        { "hebraico": "נַפְשִׁ֑י", "transliteral": "nap̄-šî", "traducao_palavra": "minha alma" },
        { "hebraico": "מִיַּד־כֶּ֝֗לֶב", "transliteral": "miy-yaḏ-ke-leḇ", "traducao_palavra": "da mão/garra do cão" },
        { "hebraico": "יְחִידָתִֽי׃", "transliteral": "yə-ḥî-ḏā-ṯî", "traducao_palavra": "minha única [vida]" }
      ]
