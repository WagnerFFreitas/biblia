        { "hebraico": "גֹּויִֽם׃", "transliteral": "ḡô-yim", "traducao_palavra": "nações" }
      ]
    },
    "28": {
      "traducao_completa": "Porque o reino é de YHWH, e ele domina entre as nações.",
      "palavras": [
        { "hebraico": "כִּ֣י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "לַֽיהוָ֣ה", "transliteral": "lay-hwāh", "traducao_palavra": "de YHWH [é]" },
