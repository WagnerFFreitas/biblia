    "21": {
      "traducao_completa": "Salva-me da boca do leão; sim, tu me respondeste dos chifres dos bois selvagens.",
      "palavras": [
        { "hebraico": "הֹ֭ושִׁיעֵנִי", "transliteral": "hô-šî-ʿē-nî", "traducao_palavra": "salva-me" },
        { "hebraico": "מִפִּ֣י", "transliteral": "mip-pî", "traducao_palavra": "da boca de" },
        { "hebraico": "אַרְיֵ֑ה", "transliteral": "ʾar-yēh", "traducao_palavra": "leão" },
        { "hebraico": "וּמִקַּרְנֵ֨י", "transliteral": "ū-miq-qar-nê", "traducao_palavra": "e dos chifres de" },
        { "hebraico": "רֵמִ֖ים", "transliteral": "rê-mîm", "traducao_palavra": "bois selvagens/unicórnios" },
