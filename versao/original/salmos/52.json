  "versiculos": {
    "1": {
      "traducao_completa": "Ao regente. Um Masquil de Davi.",
      "palavras": [
        { "hebraico": "לַמְנַצֵּ֗חַ", "transliteral": "lam-naṣ-ṣē-aḥ", "traducao_palavra": "Ao regente" },
        { "hebraico": "מַשְׂכִּ֥יל", "transliteral": "maś-kîl", "traducao_palavra": "Um Masquil (poema instrutivo)" },
        { "hebraico": "לְדָוִֽד׃", "transliteral": "lĕ-ḏā-wiḏ", "traducao_palavra": "de Davi" }
      ]
    },
    "2": {
      "traducao_completa": "Em vindo Doeg, o edomita, e contou a Saul e disse a ele: Veio Davi à casa de Aimeleque.",
      "palavras": [
        { "hebraico": "בְּבֹ֤וא", "transliteral": "bĕ-ḇôʾ", "traducao_palavra": "Em vindo" },
        { "hebraico": "דֹּואֵ֣ג", "transliteral": "dō-ʾēḡ", "traducao_palavra": "Doeg" },
        { "hebraico": "הָאֲדֹמִ֔י", "transliteral": "hā-ʾă-ḏō-mî", "traducao_palavra": "o edomita" },
        { "hebraico": "וַיַּגֵּ֥ד", "transliteral": "way-yag-gêḏ", "traducao_palavra": "e contou" },
        { "hebraico": "לְשָׁא֖וּל", "transliteral": "lĕ-šā-ʾûl", "traducao_palavra": "a Saul" },
        { "hebraico": "וַיֹּ֣אמֶר", "transliteral": "way-yō-mer", "traducao_palavra": "e disse" },
        { "hebraico": "לֹ֑ו", "transliteral": "lô", "traducao_palavra": "a ele" },
        { "hebraico": "בָּ֥א", "transliteral": "bāʾ", "traducao_palavra": "veio" },
        { "hebraico": "דָ֝וִ֗ד", "transliteral": "ḏā-wiḏ", "traducao_palavra": "Davi" },
        { "hebraico": "אֶל־", "transliteral": "ʾel-", "traducao_palavra": "à" },
        { "hebraico": "בֵּ֥ית", "transliteral": "bêṯ", "traducao_palavra": "casa de" },
        { "hebraico": "אֲחִימֶֽלֶךְ׃", "transliteral": "ʾă-ḥî-me-leḵ", "traducao_palavra": "Aimeleque" }
      ]
    },
    "3": {
      "traducao_completa": "Por que te glorias na maldade, ó herói? A benevolência de Deus é todo o dia.",
      "palavras": [
        { "hebraico": "מַה־", "transliteral": "mah-", "traducao_palavra": "Por que" },
        { "hebraico": "תִּתְהַלֵּ֣ל", "transliteral": "tiṯ-hal-lēl", "traducao_palavra": "te glorias" },
        { "hebraico": "בְּ֭רָעָה", "transliteral": "bĕ-rā-ʿāh", "traducao_palavra": "na maldade" },
        { "hebraico": "הַגִּבֹּ֑ור", "transliteral": "hag-gib-bôr", "traducao_palavra": "ó herói" },
        { "hebraico": "חֶ֥סֶד", "transliteral": "ḥe-seḏ", "traducao_palavra": "a benevolência de" },
        { "hebraico": "אֵ֝֗ל", "transliteral": "ʾēl", "traducao_palavra": "Deus" },
        { "hebraico": "כָּל־", "transliteral": "kol-", "traducao_palavra": "todo" },
        { "hebraico": "הַיֹּֽום׃", "transliteral": "hay-yôm", "traducao_palavra": "o dia" }
      ]
    },
    "4": {
      "traducao_completa": "Destruições planeja a tua língua, como navalha afiada, operando engano.",
      "palavras": [
        { "hebraico": "הַ֭וֹּות", "transliteral": "haw-wôṯ", "traducao_palavra": "destruições" },
        { "hebraico": "תַּחְשֹׁ֣ב", "transliteral": "taḥ-šōḇ", "traducao_palavra": "planeja" },
