    "9": {
      "traducao_completa": "Eis o homem que não pôs a Deus como sua fortaleza, mas confiou na abundância de sua riqueza, fortaleceu-se em sua destruição.",
      "palavras": [
        { "hebraico": "הִנֵּ֣ה", "transliteral": "hin-nēh", "traducao_palavra": "Eis" },
        { "hebraico": "הַ֭גֶּבֶר", "transliteral": "hag-ge-ḇer", "traducao_palavra": "o homem" },
        { "hebraico": "לֹ֣א", "transliteral": "lōʾ", "traducao_palavra": "não" },
        { "hebraico": "יָשִׂים֩", "transliteral": "yā-śîm", "traducao_palavra": "pôs" },
        { "hebraico": "אֱלֹהִ֨ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "Deus" },
        { "hebraico": "מָ֪עוּזֹּ֥ו", "transliteral": "mā-ʿûz-zô", "traducao_palavra": "sua fortaleza" },
        { "hebraico": "וַ֝יִּבְטַ֗ח", "transliteral": "way-yiḇ-ṭaḥ", "traducao_palavra": "e confiou" },
