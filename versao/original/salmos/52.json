      ]
    },
    "10": {
      "traducao_completa": "Mas eu sou como oliveira florescente na casa de Deus; confio na benevolência de Deus para sempre e eternamente.",
      "palavras": [
        { "hebraico": "וַאֲנִ֤י", "transliteral": "wa-ʾă-nî", "traducao_palavra": "Mas eu" },
        { "hebraico": "כְּזַ֣יִת", "transliteral": "kĕ-za-yiṯ", "traducao_palavra": "como oliveira" },
        { "hebraico": "רַ֭עֲנָן", "transliteral": "ra-ʿă-nān", "traducao_palavra": "florescente" },
        { "hebraico": "בְּבֵ֣ית", "transliteral": "bĕ-ḇêṯ", "traducao_palavra": "na casa de" },
        { "hebraico": "אֱלֹהִ֑ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "Deus" },
        { "hebraico": "בָּטַ֥חְתִּי", "transliteral": "bā-ṭaḥ-tî", "traducao_palavra": "confio" },
        { "hebraico": "בְחֶֽסֶד־", "transliteral": "ḇĕ-ḥe-seḏ-", "traducao_palavra": "na benevolência de" },
