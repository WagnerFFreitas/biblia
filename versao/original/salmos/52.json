    "7": {
      "traducao_completa": "Também Deus te destruirá para sempre; Ele te apanhará e te arrancará da tenda e te desarraigará da terra dos viventes. Selá.",
      "palavras": [
        { "hebraico": "גַּם־", "transliteral": "gam-", "traducao_palavra": "Também" },
        { "hebraico": "אֵל֮", "transliteral": "ʾēl", "traducao_palavra": "Deus" },
        { "hebraico": "יִתָּצְךָ֪", "transliteral": "yit-tā-ṣĕ-ḵā", "traducao_palavra": "te destruirá" },
        { "hebraico": "לָ֫נֶ֥צַח", "transliteral": "lā-ne-ṣaḥ", "traducao_palavra": "para sempre" },
        { "hebraico": "יַחְתְּךָ֣", "transliteral": "yaḥ-tĕ-ḵā", "traducao_palavra": "Ele te apanhará" },
        { "hebraico": "וְיִסָּחֲךָ֣", "transliteral": "wĕ-yis-sā-ḥă-ḵā", "traducao_palavra": "e te arrancará" },
        { "hebraico": "מֵאֹ֑הֶל", "transliteral": "mē-ʾō-hel", "traducao_palavra": "da tenda" },
        { "hebraico": "וְשֵׁרֶשְׁךָ֨", "transliteral": "wĕ-šē-reš-ḵā", "traducao_palavra": "e te desarraigará" },
        { "hebraico": "מֵאֶ֖רֶץ", "transliteral": "mē-ʾe-reṣ", "traducao_palavra": "da terra de" },
        { "hebraico": "חַיִּ֣ים", "transliteral": "ḥay-yîm", "traducao_palavra": "viventes" },
        { "hebraico": "סֶֽלָה׃", "transliteral": "se-lāh", "traducao_palavra": "Selá" }
      ]
    },
    "8": {
      "traducao_completa": "E os justos verão e temerão; e sobre ele se rirão:",
      "palavras": [
        { "hebraico": "וְיִרְא֥וּ", "transliteral": "wĕ-yir-ʾû", "traducao_palavra": "E verão" },
