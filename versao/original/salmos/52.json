    "11": {
      "traducao_completa": "Louvar-Te-ei para sempre, porque o fizeste; e esperarei no Teu nome, porque é bom, na presença dos Teus santos.",
      "palavras": [
        { "hebraico": "אֹודְךָ֣", "transliteral": "ʾô-ḏĕ-ḵā", "traducao_palavra": "Louvar-Te-ei" },
