        { "hebraico": "כְּתַ֥עַר", "transliteral": "kĕ-ṯa-ʿar", "traducao_palavra": "como navalha" },
        { "hebraico": "מְ֝לֻטָּ֗שׁ", "transliteral": "mĕ-luṭ-ṭāš", "traducao_palavra": "afiada" },
        { "hebraico": "עֹשֵׂ֥ה", "transliteral": "ʿō-śēh", "traducao_palavra": "operando" },
        { "hebraico": "רְמִיָּֽה׃", "transliteral": "rĕ-miy-yāh", "traducao_palavra": "engano" }
      ]
    },
    "5": {
      "traducao_completa": "Amaste o mal mais que o bem; a mentira mais que o falar a justiça. Selá.",
      "palavras": [
        { "hebraico": "אָהַ֣בְתָּ", "transliteral": "ʾā-haḇ-tā", "traducao_palavra": "Amaste" },
        { "hebraico": "רָּ֣ע", "transliteral": "rāʿ", "traducao_palavra": "o mal" },
        { "hebraico": "מִטֹּ֑וב", "transliteral": "miṭ-ṭôḇ", "traducao_palavra": "mais que o bem" },
        { "hebraico": "שֶׁ֝֗קֶר", "transliteral": "še-qer", "traducao_palavra": "mentira" },
        { "hebraico": "מִדַּבֵּ֥ר", "transliteral": "mid-dab-bēr", "traducao_palavra": "mais que o falar" },
        { "hebraico": "צֶֽדֶק", "transliteral": "ṣe-ḏeq", "traducao_palavra": "justiça" },
        { "hebraico": "סֶֽלָה׃", "transliteral": "se-lāh", "traducao_palavra": "Selá" }
      ]
    },
    "6": {
      "traducao_completa": "Amaste todas as palavras devoradoras, língua de engano.",
      "palavras": [
        { "hebraico": "אָהַ֥בְתָּ", "transliteral": "ʾā-haḇ-tā", "traducao_palavra": "Amaste" },
        { "hebraico": "כָל־", "transliteral": "ḵol-", "traducao_palavra": "todas as" },
        { "hebraico": "דִּבְרֵי־", "transliteral": "ḏiḇ-rê-", "traducao_palavra": "palavras de" },
        { "hebraico": "בָ֑לַע", "transliteral": "ḇā-laʿ", "traducao_palavra": "devorar" },
        { "hebraico": "לְשֹׁ֣ון", "transliteral": "lĕ-šôn", "traducao_palavra": "língua de" },
