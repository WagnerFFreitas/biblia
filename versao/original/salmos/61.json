{
  "livro": "Salmos - תְּהִלִּים - Tehillim",
  "capítulo": 61,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Ouve, ó Deus, o meu clamor; atende à minha oração.",
      "palavras": [
        { "hebraico": "שִׁמְעָה", "transliteral": "šim-ʿā", "traducao_palavra": "ouve" },
        { "hebraico": "אֱלֹהִים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "ó Deus" },
        { "hebraico": "רִנָּתִי", "transliteral": "rin-nā-ṯî", "traducao_palavra": "meu clamor" },
        { "hebraico": "הַקְשִׁיבָה", "transliteral": "haq-šî-ḇā", "traducao_palavra": "atende/inclina" },
        { "hebraico": "תְּפִלָּתִי׃", "transliteral": "tə-p̄il-lā-ṯî", "traducao_palavra": "minha oração" }
      ]
    },
    "2": {
      "traducao_completa": "Desde o fim da terra clamarei a ti, quando o meu coração desfalecer; leva-me para a rocha que é mais alta do que eu.",
      "palavras": [
        { "hebraico": "מִקְצֵה", "transliteral": "miq-ṣēh", "traducao_palavra": "desde a extremidade de" },
        { "hebraico": "הָאָרֶץ", "transliteral": "hā-ʾā-reṣ", "traducao_palavra": "a terra" },
        { "hebraico": "אֵלֶיךָ", "transliteral": "ʾê-le-ḵā", "traducao_palavra": "a ti" },
        { "hebraico": "אֶקְרָא", "transliteral": "ʾeq-rā", "traducao_palavra": "clamarei" },
        { "hebraico": "בַּעֲטֹף", "transliteral": "ba-ʿă-ṭōp̄", "traducao_palavra": "no desfalecer de" },
        { "hebraico": "לִבִּי", "transliteral": "lib-bî", "traducao_palavra": "meu coração" },
        { "hebraico": "בְּצוּר", "transliteral": "bə-ṣûr", "traducao_palavra": "na rocha" },
        { "hebraico": "יָרוּם", "transliteral": "yā-rûm", "traducao_palavra": "[que] é alta" },
        { "hebraico": "מִמֶּנִּי", "transliteral": "mim-men-nî", "traducao_palavra": "mais que eu" },
        { "hebraico": "תַנְחֵנִי׃", "transliteral": "ṯan-ḥē-nî", "traducao_palavra": "tu me guiarás" }
      ]
    },
    "3": {
      "traducao_completa": "Pois tu tens sido o meu refúgio e uma torre forte contra o inimigo.",
      "palavras": [
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "porque" },
        { "hebraico": "הָיִיתָ", "transliteral": "hā-yî-ṯā", "traducao_palavra": "tu tens sido" },
        { "hebraico": "מַחְסֶה", "transliteral": "maḥ-śeh", "traducao_palavra": "um refúgio" },
        { "hebraico": "לִ֑י", "transliteral": "lî", "traducao_palavra": "para mim" },
        { "hebraico": "מִגְדַּל־", "transliteral": "miḡ-dal-", "traducao_palavra": "torne de" },
        { "hebraico": "עֹז", "transliteral": "ʿōz", "traducao_palavra": "força" },
        { "hebraico": "מִפְּנֵי", "transliteral": "mip-pə-nê", "traducao_palavra": "diante da face de" },
        { "hebraico": "אֹויֵב׃", "transliteral": "ʾô-yēḇ", "traducao_palavra": "inimigo" }
      ]
    },
    "4": {
      "traducao_completa": "Habitarei no teu tabernáculo para sempre; refugiar-me-ei no esconderijo das tuas asas. (Selah)",
      "palavras": [
        { "hebraico": "אָגוּרָה", "transliteral": "ʾā-ḡû-rā", "traducao_palavra": "habitarei/peregrinarei" },
        { "hebraico": "בְאָהָלְךָ", "transliteral": "ḇə-ʾā-ho-lə-ḵā", "traducao_palavra": "em tua tenda/tabernáculo" },
        { "hebraico": "עֹולָמִים", "transliteral": "ʿô-lā-mîm", "traducao_palavra": "eternamente" },
        { "hebraico": "אֶחֱסֶה", "transliteral": "ʾe-ḥĕ-seh", "traducao_palavra": "me refugiarei" },
        { "hebraico": "בְסֵתֶר", "transliteral": "bə-śē-ṯer", "traducao_palavra": "no esconderijo de" },
        { "hebraico": "כְּנָפֶיךָ", "transliteral": "kə-nā-p̄ê-ḵā", "traducao_palavra": "tuas asas" },
        { "hebraico": "סֶּלָה׃", "transliteral": "se-lā", "traducao_palavra": "Selah [pausa]" }
      ]
    },
    "5": {
      "traducao_completa": "Pois tu, ó Deus, ouviste os meus votos; deste-me a herança dos que temem o teu nome.",
      "palavras": [
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "porque" },
        { "hebraico": "אַתָּה", "transliteral": "ʾat-tā", "traducao_palavra": "tu" },
        { "hebraico": "אֱלֹהִים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "ó Deus" },
        { "hebraico": "שָׁמַעְתָּ", "transliteral": "šā-maʿ-tā", "traducao_palavra": "ouviste" },
        { "hebraico": "לִנְדָרָ֑י", "transliteral": "lin-ḏā-rāy", "traducao_palavra": "os meus votos" },
        { "hebraico": "נָתַתָּ", "transliteral": "nā-ṯat-tā", "traducao_palavra": "deste" },
        { "hebraico": "יְרֻשַּׁת", "transliteral": "yə-ruš-šaṯ", "traducao_palavra": "[a] herança de" },
        { "hebraico": "יִרְאֵי", "transliteral": "yir-ʾê", "traducao_palavra": "[os que] temem" },
        { "hebraico": "שְׁמֶךָ׃", "transliteral": "šə-me-ḵā", "traducao_palavra": "teu nome" }
      ]
    },
    "6": {
      "traducao_completa": "Prolongarás os dias do rei; e os seus anos serão como muitas gerações.",
      "palavras": [
        { "hebraico": "יָמִים", "transliteral": "yā-mîm", "traducao_palavra": "dias" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre" },
        { "hebraico": "יְמֵי־", "transliteral": "yə-mê-", "traducao_palavra": "dias de" },
        { "hebraico": "מֶלֶךְ", "transliteral": "me-leḵ", "traducao_palavra": "[o] rei" },
        { "hebraico": "תֹּוסִ֑יף", "transliteral": "tô-śîp̄", "traducao_palavra": "acrescentarás/prolongarás" },
        { "hebraico": "שְׁנֹותָיו", "transliteral": "šə-nô-ṯāw", "traducao_palavra": "anos dele" },
        { "hebraico": "כְּמֹו־", "transliteral": "kə-mô-", "traducao_palavra": "como" },
        { "hebraico": "דֹר", "transliteral": "ḏōr", "traducao_palavra": "geração" },
        { "hebraico": "וָדֹר׃", "transliteral": "wā-ḏōr", "traducao_palavra": "e geração" }
      ]
    },
    "7": {
      "traducao_completa": "Ele permanecerá diante de Deus para sempre; prepara a tua misericórdia e a tua verdade para que o preservem.",
      "palavras": [
        { "hebraico": "יֵשֵׁב", "transliteral": "yē-šēḇ", "traducao_palavra": "habitará/permanecerá" },
        { "hebraico": "עֹולָם", "transliteral": "ʿô-lām", "traducao_palavra": "para sempre" },
        { "hebraico": "לִפְנֵי", "transliteral": "lip̄-nê", "traducao_palavra": "diante de" },
        { "hebraico": "אֱלֹהִ֑ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "Deus" },
        { "hebraico": "חֶסֶד", "transliteral": "ḥe-seḏ", "traducao_palavra": "misericórdia" },
        { "hebraico": "וֶאֱמֶת", "transliteral": "wə-ʾĕ-meṯ", "traducao_palavra": "e verdade" },
        { "hebraico": "מַן", "transliteral": "man", "traducao_palavra": "prepara/designa" },
        { "hebraico": "יִנְצְרֻהוּ׃", "transliteral": "yin-ṣə-ru-hû", "traducao_palavra": "[que] o guardem/preservem" }
      ]
    },
    "8": {
      "traducao_completa": "Assim cantarei louvores ao teu nome para sempre, para pagar os meus votos cada dia.",
      "palavras": [
        { "hebraico": "כֵּן", "transliteral": "kên", "traducao_palavra": "assim" },
        { "hebraico": "אֲזַמְּרָה", "transliteral": "ʾă-zam-mə-rā", "traducao_palavra": "cantarei louvores" },
        { "hebraico": "שִׁמְךָ", "transliteral": "šim-ḵā", "traducao_palavra": "[ao] teu nome" },
        { "hebraico": "לָעַ֑ד", "transliteral": "lā-ʿaḏ", "traducao_palavra": "eternamente" },
        { "hebraico": "לְשַׁלְּמִי", "transliteral": "lə-šal-lə-mî", "traducao_palavra": "para pagar/cumprir eu" },
        { "hebraico": "נְדָרַי", "transliteral": "nə-ḏā-ray", "traducao_palavra": "meus votos" },
        { "hebraico": "יֹום", "transliteral": "yôm", "traducao_palavra": "dia" },
        { "hebraico": "׀", "transliteral": "|", "traducao_palavra": "" },
        { "hebraico": "יֹום׃", "transliteral": "yôm", "traducao_palavra": "dia" }
      ]
    }
  }
