{
  "livro": "Salmos - תְּהִלִּים - Tehillim",
  "capítulo": 45,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Ao mestre de canto, sobre 'As Lírios'. Masquil para os filhos de Corá. Cântico de amores.",
      "palavras": [
        { "hebraico": "לַמְנַצֵּ֣חַ", "transliteral": "lam-naṣ-ṣē-aḥ", "traducao_palavra": "ao mestre de canto" },
        { "hebraico": "עַל־שֹׁ֭שַׁנִּים", "transliteral": "ʿal-šō-šan-nîm", "traducao_palavra": "sobre [a melodia] as lírios" },
        { "hebraico": "לִבְנֵי־קֹ֑רַח", "transliteral": "liḇ-nê-qō-raḥ", "traducao_palavra": "para os filhos de Corá" },
        { "hebraico": "מַ֝שְׂכִּ֗יל", "transliteral": "maś-kîl", "traducao_palavra": "masquil [instrução]" },
        { "hebraico": "שִׁ֣יר", "transliteral": "šîr", "traducao_palavra": "cântico de" },
        { "hebraico": "יְדִידֹֽת׃", "transliteral": "yə-ḏî-ḏōṯ", "traducao_palavra": "amores" }
      ]
    },
    "2": {
      "traducao_completa": "O meu coração ferve com palavras boas; falo do que tenho composto a respeito do Rei; a minha língua é a pena de um destro escritor.",
      "palavras": [
        { "hebraico": "רָ֘חַ֤שׁ", "transliteral": "rā-ḥaš", "traducao_palavra": "transbordou/ferveu" },
        { "hebraico": "לִבִּ֨י", "transliteral": "lib-bî", "traducao_palavra": "meu coração" },
        { "hebraico": "דָּ֘בָ֤ר", "transliteral": "dā-ḇār", "traducao_palavra": "[com] assunto/palavra" },
        { "hebraico": "טֹ֗וב", "transliteral": "ṭôḇ", "traducao_palavra": "boa" },
        { "hebraico": "אֹ֘מֵ֤ר", "transliteral": "ʾō-mēr", "traducao_palavra": "digo" },
        { "hebraico": "אָ֬נִי", "transliteral": "ʾā-nî", "traducao_palavra": "eu" },
        { "hebraico": "מַעֲשַׂ֨י", "transliteral": "ma-ʿă-śay", "traducao_palavra": "minhas obras/versos" },
        { "hebraico": "לְמֶ֑לֶךְ", "transliteral": "lə-me-leḵ", "traducao_palavra": "ao rei" },
        { "hebraico": "לְ֝שֹׁונִ֗י", "transliteral": "lə-šô-nî", "traducao_palavra": "minha língua [é]" },
        { "hebraico": "עֵ֤ט", "transliteral": "ʿēṭ", "traducao_palavra": "[a] pena de" },
        { "hebraico": "סֹופֵ֬ר", "transliteral": "śô-p̄ēr", "traducao_palavra": "escritor/escriba" },
        { "hebraico": "מָהִֽיר׃", "transliteral": "mā-hîr", "traducao_palavra": "veloz/destro" }
      ]
    },
    "3": {
      "traducao_completa": "Tu és o mais formoso dos filhos dos homens; a graça se derramou em teus lábios; por isso Deus te abençoou para sempre.",
      "palavras": [
        { "hebraico": "יָפְיָפִ֡יתָ", "transliteral": "yā-p̄ə-yā-p̄î-ṯā", "traducao_palavra": "tu és muito belo" },
        { "hebraico": "מִבְּנֵ֬י", "transliteral": "mib-bə-nê", "traducao_palavra": "mais que os filhos de" },
        { "hebraico": "אָדָ֗ם", "transliteral": "ʾā-ḏām", "traducao_palavra": "homem/Adão" },
        { "hebraico": "הוּצַ֣ק", "transliteral": "hû-ṣaq", "traducao_palavra": "foi derramada" },
        { "hebraico": "חֵ֭ן", "transliteral": "ḥēn", "traducao_palavra": "graça" },
        { "hebraico": "בְּשְׂפָתֹותֶ֑יךָ", "transliteral": "bə-śə-p̄ā-ṯô-ṯe-ḵā", "traducao_palavra": "em teus lábios" },
        { "hebraico": "עַל־כֵּ֤ן", "transliteral": "ʿal-kēn", "traducao_palavra": "por isso" },
        { "hebraico": "בֵּרַכְךָ֖", "transliteral": "bē-raḵ-ḵā", "traducao_palavra": "abençoou-te" },
        { "hebraico": "אֱלֹהִ֣ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "Deus" },
        { "hebraico": "לְעֹולָֽם׃", "transliteral": "lə-ʿô-lām", "traducao_palavra": "para sempre" }
      ]
    },
    "4": {
      "traducao_completa": "Cinge a tua espada à coxa, ó valente, com a tua glória e a tua majestade.",
      "palavras": [
        { "hebraico": "חֲגֹור־חַרְבְּךָ֥", "transliteral": "ḥă-ḡôr-ḥar-bə-ḵā", "traducao_palavra": "cinge tua espada" },
        { "hebraico": "עַל־יָרֵ֗ךְ", "transliteral": "ʿal-yā-rēḵ", "traducao_palavra": "sobre a coxa" },
        { "hebraico": "גִּבֹּ֥ור", "transliteral": "gib-bôr", "traducao_palavra": "[ó] valente" },
        { "hebraico": "הֹודְךָ֗", "transliteral": "hô-ḏə-ḵā", "traducao_palavra": "tua glória/esplendor" },
        { "hebraico": "וַהֲדָרֶֽךָ׃", "transliteral": "wa-hă-ḏā-re-ḵā", "traducao_palavra": "e tua majestade" }
      ]
    },
    "5": {
      "traducao_completa": "E na tua majestade cavalga prosperamente pela causa da verdade, da mansidão e da justiça; e a tua destra te ensinará coisas terríveis.",
      "palavras": [
        { "hebraico": "וַהֲדָ֬רְךָ ׀", "transliteral": "wa-hă-ḏā-rə-ḵā", "traducao_palavra": "e em tua majestade" },
        { "hebraico": "צְלַ֬ח", "transliteral": "ṣə-laḥ", "traducao_palavra": "prospera" },
        { "hebraico": "רְכַ֡ב", "transliteral": "rə-ḵaḇ", "traducao_palavra": "cavalga" },
        { "hebraico": "עַל־דְּבַר־אֱ֭מֶת", "transliteral": "ʿal-də-ḇar-ʾĕ-meṯ", "traducao_palavra": "pela causa da verdade" },
        { "hebraico": "וְעַנְוָה־צֶ֑דֶק", "transliteral": "wə-ʿan-wā-ṣe-ḏeq", "traducao_palavra": "e mansidão de justiça" },
        { "hebraico": "וְתֹורְךָ֖", "transliteral": "wə-ṯô-rə-ḵā", "traducao_palavra": "e te ensinará" },
        { "hebraico": "נֹורָאֹ֣ות", "transliteral": "nô-rā-ʾôṯ", "traducao_palavra": "coisas terríveis" },
        { "hebraico": "יְמִינֶֽךָ׃", "transliteral": "yə-mî-ne-ḵā", "traducao_palavra": "tua destra" }
      ]
    },
    "6": {
      "traducao_completa": "As tuas setas são agudas no coração dos inimigos do Rei, e por elas os povos caem debaixo de ti.",
      "palavras": [
        { "hebraico": "חִצֶּ֗יךָ", "transliteral": "ḥiṣ-ṣê-ḵā", "traducao_palavra": "tuas setas" },
        { "hebraico": "שְׁנ֫וּנִ֥ים", "transliteral": "šə-nû-nîm", "traducao_palavra": "[são] agudas" },
        { "hebraico": "עַ֭מִּים", "transliteral": "ʿam-mîm", "traducao_palavra": "povos" },
        { "hebraico": "תַּחְתֶּ֣יךָ", "transliteral": "ta-ḥə-tey-ḵā", "traducao_palavra": "debaixo de ti" },
        { "hebraico": "יִפְּל֑וּ", "transliteral": "yip-pə-lû", "traducao_palavra": "cairão" },
        { "hebraico": "בְּ֝לֵ֗ב", "transliteral": "bə-lēḇ", "traducao_palavra": "no coração de" },
        { "hebraico": "אֹויְבֵ֥י", "transliteral": "ʾô-yə-ḇê", "traducao_palavra": "inimigos de" },
        { "hebraico": "הַמֶּֽלֶךְ׃", "transliteral": "ham-me-leḵ", "traducao_palavra": "o rei" }
      ]
    },
    "7": {
      "traducao_completa": "O teu trono, ó Deus, é eterno e perpétuo; o cetro do teu reino é um cetro de equidade.",
      "palavras": [
        { "hebraico": "כִּסְאֲךָ֣", "transliteral": "kis-ʾă-ḵā", "traducao_palavra": "teu trono" },
        { "hebraico": "אֱ֭לֹהִים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "[ó] Deus" },
        { "hebraico": "עֹולָ֣ם", "transliteral": "ʿô-lām", "traducao_palavra": "[é] para sempre" },
        { "hebraico": "וָעֶ֑ד", "transliteral": "wā-ʿeḏ", "traducao_palavra": "e eternamente" },
        { "hebraico": "שֵׁ֥בֶט", "transliteral": "šē-ḇeṭ", "traducao_palavra": "[o] cetro de" },
        { "hebraico": "מִישֹׁ֓ר", "transliteral": "mî-šōr", "traducao_palavra": "equidade/retidão" },
        { "hebraico": "שֵׁ֥בֶט", "transliteral": "šē-ḇeṭ", "traducao_palavra": "[é o] cetro de" },
        { "hebraico": "מַלְכוּתֶֽךָ׃", "transliteral": "mal-ḵû-ṯe-ḵā", "traducao_palavra": "teu reino" }
      ]
    },
    "8": {
      "traducao_completa": "Tu amas a justiça e odeias a impiedade; por isso Deus, o teu Deus, te ungiu com óleo de alegria mais do que a teus companheiros.",
      "palavras": [
        { "hebraico": "אָהַ֣בְתָּ", "transliteral": "ʾā-haḇ-tā", "traducao_palavra": "amaste" },
        { "hebraico": "צֶּ֭דֶק", "transliteral": "ṣe-ḏeq", "traducao_palavra": "justiça" },
        { "hebraico": "וַתִּשְׂנָא־רֶ֑שַׁע", "transliteral": "wat-tiś-nā-re-šaʿ", "traducao_palavra": "e odiaste maldade" },
        { "hebraico": "עַל־כֵּ֤ן ׀", "transliteral": "ʿal-kēn", "traducao_palavra": "por isso" },
        { "hebraico": "מְשָׁחֲךָ֡", "transliteral": "mə-šā-ḥă-ḵā", "traducao_palavra": "ungiu-te" },
        { "hebraico": "אֱלֹהִ֣ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "Deus" },
        { "hebraico": "אֱלֹהֶיךָ֮", "transliteral": "ʾĕ-lō-hey-ḵā", "traducao_palavra": "teu Deus" },
        { "hebraico": "שֶׁ֤מֶן", "transliteral": "še-men", "traducao_palavra": "[com] óleo de" },
        { "hebraico": "śָ֝שֹׂון", "transliteral": "śā-śôn", "traducao_palavra": "alegria" },
        { "hebraico": "מֵֽחֲבֵרֶֽיךָ׃", "transliteral": "mē-ḥă-ḇê-rey-ḵā", "traducao_palavra": "mais que teus companheiros" }
      ]
    },
    "9": {
      "traducao_completa": "Todas as tuas vestes cheiram a mirra, a aloés e a cássia, desde os palácios de marfim de onde te alegram.",
      "palavras": [
        { "hebraico": "מֹר־וַאֲהָלֹ֣ות", "transliteral": "mōr-wa-ʾă-hā-lôṯ", "traducao_palavra": "mirra e aloés" },
        { "hebraico": "קְ֭צִיעֹות", "transliteral": "qə-ṣî-ʿôṯ", "traducao_palavra": "cássia" },
        { "hebraico": "כָּל־בִּגְדֹתֶ֑יךָ", "transliteral": "kāl-biḡ-ḏō-ṯe-ḵā", "traducao_palavra": "todas as tuas vestes" },
        { "hebraico": "מִֽן־הֵיכְלֵ֥י", "transliteral": "min-hê-ḵəlê", "traducao_palavra": "desde palácios de" },
        { "hebraico": "שֵׁ֗ן", "transliteral": "šēn", "traducao_palavra": "marfim" },
        { "hebraico": "מִ֝נִּ֗י", "transliteral": "min-nî", "traducao_palavra": "de onde" },
        { "hebraico": "שִׂמְּחֽוּךָ׃", "transliteral": "śim-mə-ḥû-ḵā", "traducao_palavra": "alegraram-te" }
      ]
    },
    "10": {
      "traducao_completa": "Filhas de reis estão entre as tuas damas de honra; à tua direita está a rainha adornada com ouro finíssimo de Ofir.",
      "palavras": [
        { "hebraico": "בְּנֹ֣ות", "transliteral": "bə-nôṯ", "traducao_palavra": "filhas de" },
        { "hebraico": "מְ֭לָכִים", "transliteral": "mə-lā-ḵîm", "traducao_palavra": "reis" },
        { "hebraico": "בִּיקְּרֹותֶ֑יךָ", "transliteral": "bî-qqə-rô-ṯe-ḵā", "traducao_palavra": "entre tuas preciosas/damas" },
        { "hebraico": "נִצְּבָ֥ה", "transliteral": "niṣ-ṣə-ḇā", "traducao_palavra": "está posta/colocada" },
        { "hebraico": "שֵׁגַ֨ל", "transliteral": "šē-ḡal", "traducao_palavra": "a rainha/consorte" },
        { "hebraico": "לִֽ֝ימִינְךָ֗", "transliteral": "lî-mî-nə-ḵā", "traducao_palavra": "à tua direita" },
        { "hebraico": "בְּכֶ֣תֶם", "transliteral": "bə-ḵe-ṯem", "traducao_palavra": "em/com ouro de" },
        { "hebraico": "אֹופִֽיר׃", "transliteral": "ʾô-p̄îr", "traducao_palavra": "Ofir" }
      ]
    },
    "11": {
      "traducao_completa": "Ouve, filha, e olha, e inclina os teus ouvidos; esquece-te do teu povo e da casa do teu pai.",
      "palavras": [
        { "hebraico": "שִׁמְעִי־בַת֮", "transliteral": "šim-ʿî-ḇaṯ", "traducao_palavra": "ouve, filha" },
        { "hebraico": "וּ֭רְאִי", "transliteral": "ū-rə-ʾî", "traducao_palavra": "e vê/olha" },
        { "hebraico": "וְהַטִּ֣י", "transliteral": "wə-haṭ-ṭî", "traducao_palavra": "e inclina" },
        { "hebraico": "אָ֫זְנֵ֥ךְ", "transliteral": "ʾāz-nēḵ", "traducao_palavra": "teu ouvido" },
        { "hebraico": "וְשִׁכְחִ֥י", "transliteral": "wə-šiḵ-ḥî", "traducao_palavra": "e esquece" },
        { "hebraico": "עַמֵּ֗ךְ", "transliteral": "ʿam-mēḵ", "traducao_palavra": "teu povo" },
        { "hebraico": "וּבֵ֥ית", "transliteral": "ū-ḇêṯ", "traducao_palavra": "e a casa de" },
        { "hebraico": "אָבִֽיךְ׃", "transliteral": "ʾā-ḇîḵ", "traducao_palavra": "teu pai" }
      ]
    },
    "12": {
      "traducao_completa": "Então o Rei se encantará com a tua formosura, pois ele é o teu Senhor; adora-o.",
      "palavras": [
        { "hebraico": "וְיִתְאָ֣ו", "transliteral": "wə-yiṯ-ʾāw", "traducao_palavra": "e desejará/se encantará" },
        { "hebraico": "הַמֶּ֣לֶךְ", "transliteral": "ham-me-leḵ", "traducao_palavra": "o Rei" },
        { "hebraico": "יָפְיֵ֑ךְ", "transliteral": "yā-p̄ə-yēḵ", "traducao_palavra": "tua beleza" },
        { "hebraico": "כִּי־ה֥וּא", "transliteral": "kî-hû", "traducao_palavra": "pois ele [é]" },
        { "hebraico": "אֲ֝דֹנַ֗יִךְ", "transliteral": "ʾă-ḏō-na-yiḵ", "traducao_palavra": "teu Senhor" },
        { "hebraico": "וְהִשְׁתַּחֲוִי־לֹֽו׃", "transliteral": "wə-hiš-ta-ḥă-wî-lô", "traducao_palavra": "e inclina-te/adora-o" }
      ]
    },
    "13": {
      "traducao_completa": "E a filha de Tiro estará ali com presentes; os ricos do povo suplicarão o teu favor.",
      "palavras": [
        { "hebraico": "וּבַת־צֹ֨ר", "transliteral": "ū-ḇaṯ-ṣōr", "traducao_palavra": "e a filha de Tiro" },
        { "hebraico": "בְּ֭מִנְחָה", "transliteral": "bə-min-ḥā", "traducao_palavra": "com oferta/presente" },
        { "hebraico": "פָּנַ֥יִךְ", "transliteral": "pā-na-yiḵ", "traducao_palavra": "tua face" },
        { "hebraico": "יְחַלּ֗וּ", "transliteral": "yə-ḥal-lû", "traducao_palavra": "suplicarão/abrandarão" },
        { "hebraico": "עֲשִׁ֥ירֵי", "transliteral": "ʿă-šî-rê", "traducao_palavra": "[os] ricos de" },
        { "hebraico": "עָֽם׃", "transliteral": "ʿām", "traducao_palavra": "[o] povo" }
      ]
    },
    "14": {
      "traducao_completa": "A filha do Rei é toda esplendorosa no interior do palácio; as suas vestes são tecidas de ouro.",
      "palavras": [
        { "hebraico": "כָּל־כְּבוּדָּ֣ה", "transliteral": "kāl-kə-ḇûd-dā", "traducao_palavra": "toda glória/esplendor" },
        { "hebraico": "בַת־מֶ֥לֶךְ", "transliteral": "ḇaṯ-me-leḵ", "traducao_palavra": "[da] filha do rei" },
        { "hebraico": "פְּנִ֑ימָה", "transliteral": "pə-nî-mā", "traducao_palavra": "no interior" },
        { "hebraico": "מִמִּשְׁבְּצֹ֖ות", "transliteral": "mim-miš-bə-ṣôṯ", "traducao_palavra": "de engastes/tecidos de" },
        { "hebraico": "זָהָ֣ב", "transliteral": "zā-hāḇ", "traducao_palavra": "ouro" },
        { "hebraico": "לְבוּשָֽׁהּ׃", "transliteral": "lə-ḇû-šāh", "traducao_palavra": "sua veste" }
      ]
    },
    "15": {
      "traducao_completa": "Em vestes bordadas será conduzida ao Rei; as virgens, suas companheiras que a seguem, serão trazidas a ti.",
      "palavras": [
        { "hebraico": "לִרְקָמֹות֮", "transliteral": "lir-qā-môṯ", "traducao_palavra": "em bordados" },
        { "hebraico": "תּוּבַ֪ל", "transliteral": "tû-ḇal", "traducao_palavra": "será conduzida" },
        { "hebraico": "לַ֫מֶּ֥לֶךְ", "transliteral": "lam-me-leḵ", "traducao_palavra": "ao Rei" },
        { "hebraico": "בְּתוּלֹ֣ות", "transliteral": "bə-ṯû-lôṯ", "traducao_palavra": "[as] virgens" },
        { "hebraico": "אַ֭חֲרֶיהָ", "transliteral": "ʾa-ḥă-re-hā", "traducao_palavra": "depois dela/que a seguem" },
        { "hebraico": "רֵעֹותֶ֑יהָ", "transliteral": "rē-ʿô-ṯe-hā", "traducao_palavra": "suas companheiras" },
        { "hebraico": "מ֝וּבָאֹ֗ות", "transliteral": "mû-ḇā-ʾôṯ", "traducao_palavra": "[serão] trazidas" },
