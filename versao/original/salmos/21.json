{
  "livro": "Salmos - תְּהִלִּים - Tehillim",
  "capítulo": 21,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Ao mestre de canto. Salmo de Davi.",
      "palavras": [
        { "hebraico": "לַמְנַצֵּ֗חַ", "transliteral": "lam-naṣ-ṣē-aḥ", "traducao_palavra": "ao mestre de canto" },
        { "hebraico": "מִזְמֹ֥ור", "transliteral": "miz-môr", "traducao_palavra": "salmo" },
        { "hebraico": "לְדָוִֽד׃", "transliteral": "lə-ḏā-wiḏ", "traducao_palavra": "de Davi" }
      ]
    },
    "2": {
      "traducao_completa": "YHWH, na tua força o rei se alegra; e na tua salvação quanto se regozija!",
      "palavras": [
        { "hebraico": "יְֽהוָ֗ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "בְּעָזְּךָ֥", "transliteral": "bə-ʿāz-zə-ḵā", "traducao_palavra": "em tua força" },
        { "hebraico": "יִשְׂמַח־מֶ֑לֶךְ", "transliteral": "yiś-maḥ-me-leḵ", "traducao_palavra": "se alegrará o rei" },
        { "hebraico": "וּבִישׁוּעָתְךָ֗", "transliteral": "ū-ḇî-šû-ʿā-ṯə-ḵā", "traducao_palavra": "e em tua salvação" },
        { "hebraico": "מַה־יָּגֶ֥יל", "transliteral": "mah-yā-ḡêl", "traducao_palavra": "quanto se regozija" },
        { "hebraico": "מְאֹֽד׃", "transliteral": "mə-ʾōḏ", "traducao_palavra": "muito" }
      ]
    },
    "3": {
      "traducao_completa": "Deste-lhe o desejo do seu coração e não lhe negaste o pedido dos seus lábios. (Selah)",
      "palavras": [
        { "hebraico": "תַּאֲוַ֣ת", "transliteral": "ta-ʾă-waṯ", "traducao_palavra": "o desejo de" },
        { "hebraico": "לִ֭בֹּו", "transliteral": "lib-bô", "traducao_palavra": "seu coração" },
        { "hebraico": "נָתַ֣תָּה", "transliteral": "nā-ṯat-tā", "traducao_palavra": "deste" },
        { "hebraico": "לֹּ֑ו", "transliteral": "lô", "traducao_palavra": "a ele" },
        { "hebraico": "וַאֲרֶ֥שֶׁת", "transliteral": "wa-ʾă-re-šeṯ", "traducao_palavra": "e o pedido de" },
        { "hebraico": "שְׂ֝פָתָ֗יו", "transliteral": "śə-p̄ā-ṯāw", "traducao_palavra": "seus lábios" },
        { "hebraico": "בַּל־מָנַ֥עְתָּ", "transliteral": "bal-mā-na-ʿtā", "traducao_palavra": "não negaste" },
        { "hebraico": "סֶּֽלָה׃", "transliteral": "se-lā", "traducao_palavra": "Selah [pausa]" }
      ]
    },
    "4": {
      "traducao_completa": "Pois o encontras com bênçãos de bondade; pões na sua cabeça uma coroa de ouro fino.",
      "palavras": [
        { "hebraico": "כִּֽי־תְ֭קַדְּמֶנּוּ", "transliteral": "kî-ṯə-qad-də-men-nû", "traducao_palavra": "pois o antecipas/encontras" },
        { "hebraico": "בִּרְכֹ֣ות", "transliteral": "bir-ḵôṯ", "traducao_palavra": "bênçãos de" },
        { "hebraico": "טֹ֑וב", "transliteral": "ṭôḇ", "traducao_palavra": "bem/bondade" },
        { "hebraico": "תָּשִׁ֥ית", "transliteral": "tā-šîṯ", "traducao_palavra": "pões" },
        { "hebraico": "לְ֝רֹאשֹׁ֗ו", "transliteral": "lə-rō-šô", "traducao_palavra": "na sua cabeça" },
        { "hebraico": "עֲטֶ֣רֶת", "transliteral": "ʿă-ṭe-reṯ", "traducao_palavra": "uma coroa de" },
        { "hebraico": "פָּֽז׃", "transliteral": "pāz", "traducao_palavra": "ouro fino" }
      ]
    },
    "5": {
      "traducao_completa": "Vida te pediu, e lha deste; vida longa para todo o sempre.",
      "palavras": [
        { "hebraico": "חַיִּ֤ים ׀", "transliteral": "ḥay-yîm", "traducao_palavra": "vida" },
        { "hebraico": "שָׁאַ֣ל", "transliteral": "šā-ʾal", "traducao_palavra": "pediu" },
        { "hebraico": "מִמֶּךָ", "transliteral": "mim-me-ḵā", "traducao_palavra": "de ti" },
        { "hebraico": "נָתַ֣תָּה", "transliteral": "nā-ṯat-tā", "traducao_palavra": "deste" },
        { "hebraico": "לֹּ֑ו", "transliteral": "lô", "traducao_palavra": "a ele" },
        { "hebraico": "אֹ֥רֶךְ", "transliteral": "ʾō-reḵ", "traducao_palavra": "comprimento de" },
        { "hebraico": "יָ֝מִ֗ים", "transliteral": "yā-mîm", "traducao_palavra": "dias" },
        { "hebraico": "עֹולָ֥ם", "transliteral": "ʿô-lām", "traducao_palavra": "sempre" },
        { "hebraico": "וָעֶֽד׃", "transliteral": "wā-ʿeḏ", "traducao_palavra": "e eternamente" }
      ]
    },
    "6": {
      "traducao_completa": "Grande é a sua glória pela tua salvação; honra e majestade puseste sobre ele.",
      "palavras": [
        { "hebraico": "גָּדֹ֣ול", "transliteral": "gā-ḏôl", "traducao_palavra": "grande" },
        { "hebraico": "כְּ֭ḇֹודֹו", "transliteral": "kə-ḇô-ḏô", "traducao_palavra": "sua glória" },
        { "hebraico": "בִּֽישׁוּעָתֶ֑ךָ", "transliteral": "bî-šû-ʿā-ṯe-ḵā", "traducao_palavra": "em tua salvação" },
        { "hebraico": "הֹ֥וד", "transliteral": "hôḏ", "traducao_palavra": "esplendor/honra" },
        { "hebraico": "וְ֝הָדָ֗ר", "transliteral": "wə-hā-ḏār", "traducao_palavra": "e majestade" },
        { "hebraico": "תְּשַׁוֶּ֥ה", "transliteral": "tə-šaw-weh", "traducao_palavra": "puseste/atribuíste" },
        { "hebraico": "עָלָֽיו׃", "transliteral": "ʿā-lāw", "traducao_palavra": "sobre ele" }
      ]
    },
    "7": {
      "traducao_completa": "Pois o puseste por bênção para sempre; tu o enches de alegria com a tua presença.",
      "palavras": [
        { "hebraico": "כִּֽי־תְשִׁיתֵ֣הוּ", "transliteral": "kî-ṯə-šî-ṯê-hû", "traducao_palavra": "pois tu o puseste" },
        { "hebraico": "בְרָכֹ֣ות", "transliteral": "ḇə-rā-ḵôṯ", "traducao_palavra": "bênçãos" },
        { "hebraico": "לָעַ֑ד", "transliteral": "lā-ʿaḏ", "traducao_palavra": "para sempre" },
        { "hebraico": "תְּחַדֵּ֥הוּ", "transliteral": "tə-ḥad-dê-hû", "traducao_palavra": "tu o alegras" },
        { "hebraico": "בְ֝שִׂמְחָ֗ה", "transliteral": "ḇə-śim-ḥā", "traducao_palavra": "com alegria" },
        { "hebraico": "אֶת־פָּנֶֽיךָ׃", "transliteral": "ʾeṯ-pā-ne-ḵā", "traducao_palavra": "com tua face/presença" }
      ]
    },
    "8": {
      "traducao_completa": "Porque o rei confia em YHWH e, pela misericórdia do Altíssimo, não será abalado.",
      "palavras": [
        { "hebraico": "כִּֽי־הַ֭מֶּלֶךְ", "transliteral": "kî-ham-me-leḵ", "traducao_palavra": "porque o rei" },
        { "hebraico": "בֹּטֵ֣חַ", "transliteral": "bō-ṭē-aḥ", "traducao_palavra": "confia" },
        { "hebraico": "בַּיהוָ֑ה", "transliteral": "bay-hwāh", "traducao_palavra": "em YHWH" },
        { "hebraico": "וּבְחֶ֥סֶד", "transliteral": "ū-ḇə-ḥe-seḏ", "traducao_palavra": "e pela misericórdia de" },
        { "hebraico": "עֶ֝לְיֹ֗ון", "transliteral": "ʿel-yôn", "traducao_palavra": "[o] Altíssimo" },
        { "hebraico": "בַּל־יִמֹּֽוט׃", "transliteral": "bal-yim-môṭ", "traducao_palavra": "não será abalado" }
      ]
    },
    "9": {
      "traducao_completa": "A tua mão alcançará todos os teus inimigos; a tua destra alcançará os que te odeiam.",
      "palavras": [
        { "hebraico": "תִּמְצָ֣א", "transliteral": "tim-ṣā", "traducao_palavra": "alcançará/achará" },
        { "hebraico": "יָ֭דְךָ", "transliteral": "yā-ḏə-ḵā", "traducao_palavra": "tua mão" },
        { "hebraico": "לְכָל־אֹיְבֶ֑יךָ", "transliteral": "lə-ḵāl-ʾō-yə-ḇe-ḵā", "traducao_palavra": "a todos os teus inimigos" },
        { "hebraico": "יְ֝מִינְךָ֗", "transliteral": "yə-mî-nə-ḵā", "traducao_palavra": "tua destra" },
        { "hebraico": "תִּמְצָ֥א", "transliteral": "tim-ṣā", "traducao_palavra": "alcançará" },
        { "hebraico": "שֹׂנְאֶֽיךָ׃", "transliteral": "śō-nə-ʾe-ḵā", "traducao_palavra": "teus odiadores" }
      ]
    },
    "10": {
      "traducao_completa": "Tu os porás como um forno de fogo no tempo da tua ira; YHWH os consumirá na sua indignação, e o fogo os devorará.",
      "palavras": [
        { "hebraico": "תְּשִׁיתֵ֨מֹו ׀", "transliteral": "tə-šî-ṯê-mô", "traducao_palavra": "tu os porás" },
        { "hebraico": "כְּתַנּ֧וּר", "transliteral": "kə-ṯan-nûr", "traducao_palavra": "como forno de" },
        { "hebraico": "אֵשׁ֮", "transliteral": "ʾēš", "traducao_palavra": "fogo" },
        { "hebraico": "לְעֵ֪ת", "transliteral": "lə-ʿēṯ", "traducao_palavra": "no tempo de" },
        { "hebraico": "פָּ֫נֶ֥יךָ", "transliteral": "pā-ne-ḵā", "traducao_palavra": "tua face/ira" },
        { "hebraico": "יְהוָ֗ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "בְּאַפֹּ֥ו", "transliteral": "bə-ʾap-pô", "traducao_palavra": "na sua ira" },
        { "hebraico": "יְבַלְּעֵ֑ם", "transliteral": "yə-ḇal-lə-ʿēm", "traducao_palavra": "os consumirá" },
        { "hebraico": "וְתֹאכְלֵ֥ם", "transliteral": "wə-ṯō-ḵə-lêm", "traducao_palavra": "e os devorará" },
        { "hebraico": "אֵֽשׁ׃", "transliteral": "ʾēš", "traducao_palavra": "fogo" }
      ]
    },
    "11": {
      "traducao_completa": "Destruirás da terra o seu fruto, e a sua descendência de entre os filhos dos homens.",
      "palavras": [
        { "hebraico": "פִּ֭רְיָמֹו", "transliteral": "pir-yā-mô", "traducao_palavra": "fruto deles" },
        { "hebraico": "מֵאֶ֣רֶץ", "transliteral": "mê-ʾe-reṣ", "traducao_palavra": "da terra" },
        { "hebraico": "תְּאַבֵּ֑ד", "transliteral": "tə-ʾab-bēḏ", "traducao_palavra": "tu destruirás" },
        { "hebraico": "וְ֝זַרְעָ֗ם", "transliteral": "wə-zar-ʿām", "traducao_palavra": "e a semente deles" },
        { "hebraico": "מִבְּנֵ֥י", "transliteral": "mib-bə-nê", "traducao_palavra": "de entre os filhos de" },
        { "hebraico": "אָדָֽם׃", "transliteral": "ʾā-ḏām", "traducao_palavra": "homem/Adão" }
      ]
    },
    "12": {
      "traducao_completa": "Porque intentaram o mal contra ti; maquinaram um ardil, mas não prevalecerão.",
      "palavras": [
        { "hebraico": "כִּֽי־נָט֧וּ", "transliteral": "kî-nā-ṭû", "traducao_palavra": "porque intentaram/estenderam" },
        { "hebraico": "עָלֶ֣יךָ", "transliteral": "ʿā-le-ḵā", "traducao_palavra": "contra ti" },
        { "hebraico": "רָעָ֑ה", "transliteral": "rā-ʿā", "traducao_palavra": "mal" },
        { "hebraico": "חָשְׁב֥וּ", "transliteral": "ḥā-šə-ḇû", "traducao_palavra": "maquinaram" },
        { "hebraico": "מְ֝זִמָּ֗ה", "transliteral": "mə-zim-mā", "traducao_palavra": "ardil/trama" },
        { "hebraico": "בַּל־יוּכָֽלוּ׃", "transliteral": "bal-yû-ḵā-lû", "traducao_palavra": "[o qual] não puderam [prevalecer]" }
      ]
    },
    "13": {
      "traducao_completa": "Pois tu lhes farás voltar as costas; apontarás as tuas setas contra os seus rostos.",
      "palavras": [
        { "hebraico": "כִּ֭י", "transliteral": "kî", "traducao_palavra": "pois" },
        { "hebraico": "תְּשִׁיתֵ֣מֹו", "transliteral": "tə-šî-ṯê-mô", "traducao_palavra": "tu os porás" },
        { "hebraico": "שֶׁ֑כֶם", "transliteral": "še-ḵem", "traducao_palavra": "[as] costas/ombro" },
        { "hebraico": "בְּ֝מֵיתָרֶ֗יךָ", "transliteral": "bə-mê-ṯā-re-ḵā", "traducao_palavra": "com tuas cordas [de arco]" },
        { "hebraico": "תְּכֹונֵ֥ן", "transliteral": "tə-ḵô-nēn", "traducao_palavra": "firmarás/apontarás" },
        { "hebraico": "עַל־פְּנֵיהֶֽם׃", "transliteral": "ʿal-pə-nê-hem", "traducao_palavra": "contra a face deles" }
      ]
    },
    "14": {
      "traducao_completa": "Exalta-te, YHWH, na tua força; então cantaremos e louvaremos o teu poder.",
      "palavras": [
        { "hebraico": "ר֨וּמָה", "transliteral": "rû-mā", "traducao_palavra": "exalta-te" },
        { "hebraico": "יְהוָ֥ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "בְּעֻזֶּ֑ךָ", "transliteral": "bə-ʿuz-ze-ḵā", "traducao_palavra": "em tua força" },
        { "hebraico": "נָשִׁ֥ירָה", "transliteral": "nā-šî-rā", "traducao_palavra": "cantaremos" },
        { "hebraico": "וּֽנְזַמְּרָ֥ה", "transliteral": "ū-nə-zam-mə-rā", "traducao_palavra": "e louvaremos/salmodiaremos" },
        { "hebraico": "גְּבוּרָתֶֽךָ׃", "transliteral": "gə-ḇû-rā-ṯe-ḵā", "traducao_palavra": "teu poder" }
      ]
    }
  }
