    "7": {
      "traducao_completa": "As obras das suas mãos são verdade e juízo; fiéis são todos os seus preceitos.",
      "palavras": [
        { "hebraico": "מַעֲשֵׂ֣י", "transliteral": "ma-ʿă-śê", "traducao_palavra": "[as] obras de" },
        { "hebraico": "יָ֭דָיו", "transliteral": "yā-ḏāyw", "traducao_palavra": "mãos dele" },
        { "hebraico": "אֱמֶ֣ת", "transliteral": "ʾĕ-meṯ", "traducao_palavra": "[são] verdade" },
        { "hebraico": "וּמִשְׁפָּ֑ט", "transliteral": "ū-miš-pāṭ", "traducao_palavra": "e juízo" },
        { "hebraico": "נֶ֝אֱמָנִ֗ים", "transliteral": "ne-ʾĕ-mā-nîm", "traducao_palavra": "confiáveis/fiéis [são]" },
        { "hebraico": "כָּל־", "transliteral": "kāl-", "traducao_palavra": "todos" },
        { "hebraico": "פִּקּוּדָֽיו׃", "transliteral": "piq-qû-ḏāyw", "traducao_palavra": "seus preceitos" }
      ]
    },
    "8": {
      "traducao_completa": "Permanecem firmes para todo o sempre; são feitos em verdade e retidão.",
      "palavras": [
