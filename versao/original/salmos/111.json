        { "hebraico": "לְעַמֹּ֗ו", "transliteral": "lə-ʿam-mô", "traducao_palavra": "a seu povo" },
        { "hebraico": "צִוָּֽה־", "transliteral": "ṣiw-wā-", "traducao_palavra": "ele ordenou" },
