      ]
    },
    "5": {
      "traducao_completa": "Deu mantimento aos que o temem; lembrar-se-á sempre da sua aliança.",
      "palavras": [
        { "hebraico": "טֶ֭רֶף", "transliteral": "ṭe-rep̄", "traducao_palavra": "presa/alimento" },
        { "hebraico": "נָתַ֣ן", "transliteral": "nā-ṯan", "traducao_palavra": "ele deu" },
        { "hebraico": "לִֽירֵאָ֑יו", "transliteral": "lî-rē-ʾāyw", "traducao_palavra": "para os seus tementes" },
        { "hebraico": "יִזְכֹּ֖ר", "transliteral": "yiz-kōr", "traducao_palavra": "ele lembrará" },
        { "hebraico": "לְעֹולָ֣ם", "transliteral": "lə-ʿô-lām", "traducao_palavra": "para sempre" },
        { "hebraico": "בְּרִיתֹֽו׃", "transliteral": "bə-rî-ṯô", "traducao_palavra": "sua aliança" }
      ]
