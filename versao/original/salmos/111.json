        { "hebraico": "לְעֹולָ֑ם", "transliteral": "lə-ʿô-lām", "traducao_palavra": "eternamente" },
        { "hebraico": "עֲ֝שׂוּיִ֗ם", "transliteral": "ʿă-śû-yim", "traducao_palavra": "feitos" },
        { "hebraico": "בֶּאֱמֶ֥ת", "transliteral": "be-ʾĕ-meṯ", "traducao_palavra": "em verdade" },
        { "hebraico": "וְיָשָֽׁר׃", "transliteral": "wə-yā-šār", "traducao_palavra": "e retidão" }
      ]
