        { "hebraico": "אֹודֶ֣ה", "transliteral": "ʾô-ḏeh", "traducao_palavra": "louvarei/renderei graças" },
        { "hebraico": "יְ֭הוָה", "transliteral": "YHWH", "traducao_palavra": "a YHWH" },
        { "hebraico": "בְּכָל־", "transliteral": "bə-ḵāl-", "traducao_palavra": "com todo" },
        { "hebraico": "לֵבָ֑ב", "transliteral": "lē-ḇāḇ", "traducao_palavra": "[o] coração" },
        { "hebraico": "בְּסֹ֖וד", "transliteral": "bə-śôḏ", "traducao_palavra": "no conselho/assembleia de" },
        { "hebraico": "יְשָׁרִ֣ים", "transliteral": "yə-šā-rîm", "traducao_palavra": "retos" },
        { "hebraico": "וְעֵדָֽה׃", "transliteral": "wə-ʿē-ḏā", "traducao_palavra": "e congregação" }
      ]
    },
    "2": {
      "traducao_completa": "Grandes são as obras de YHWH, procuradas por todos os que nelas se deleitam.",
      "palavras": [
