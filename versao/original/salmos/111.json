{
  "livro": "Salmos - תְּהִלִּים - Tehillim",
  "capítulo": 111,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Louvai a YHWH! Louvarei a YHWH de todo o meu coração, na assembleia dos retos e na congregação.",
      "palavras": [
