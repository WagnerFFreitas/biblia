        { "hebraico": "נַחֲלַ֥ת", "transliteral": "na-ḥă-laṯ", "traducao_palavra": "[a] herança de" },
        { "hebraico": "גֹּויִֽם׃", "transliteral": "gô-yim", "traducao_palavra": "nações" }
      ]
