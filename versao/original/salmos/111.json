    "10": {
      "traducao_completa": "O temor de YHWH é o princípio da sabedoria; bom entendimento têm todos os que cumprem os seus preceitos; o seu louvor permanece para sempre.",
      "palavras": [
        { "hebraico": "רֵ֘אשִׁ֤ית", "transliteral": "rē-šîṯ", "traducao_palavra": "[o] princípio de" },
        { "hebraico": "חָכְמָ֨ה ׀", "transliteral": "ḥāḵ-mā", "traducao_palavra": "sabedoria" },
        { "hebraico": "יִרְאַ֬ת", "transliteral": "yir-ʾaṯ", "traducao_palavra": "[é o] temor de" },
