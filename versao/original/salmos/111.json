        { "hebraico": "מַעֲשֵׂ֣י", "transliteral": "ma-ʿă-śê", "traducao_palavra": "[as] obras de" },
        { "hebraico": "יְהוָ֑ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "דְּ֝רוּשִׁ֗ים", "transliteral": "də-rû-šîm", "traducao_palavra": "buscadas/estudadas" },
        { "hebraico": "לְכָל־", "transliteral": "lə-ḵāl-", "traducao_palavra": "por todos" },
        { "hebraico": "חֶפְצֵיהֶֽם׃", "transliteral": "ḥep̄-ṣê-hem", "traducao_palavra": "[que nelas têm] seus prazeres" }
      ]
    },
    "3": {
      "traducao_completa": "Glória e majestade são a sua obra, e a sua justiça permanece para sempre.",
      "palavras": [
        { "hebraico": "הֹוד־", "transliteral": "hôḏ-", "traducao_palavra": "esplendor" },
        { "hebraico": "וְהָדָ֥ר", "transliteral": "wə-hā-ḏār", "traducao_palavra": "e majestade [é]" },
        { "hebraico": "פֳָּעֳלֹ֑ו", "transliteral": "pā-ʿŏ-lô", "traducao_palavra": "obra dele" },
        { "hebraico": "וְ֝צִדְקָתֹ֗ו", "transliteral": "wə-ṣiḏ-qā-ṯô", "traducao_palavra": "e a justiça dele" },
        { "hebraico": "עֹמֶ֥דֶת", "transliteral": "ʿō-me-ḏeṯ", "traducao_palavra": "permanece/está de pé" },
        { "hebraico": "לָעַֽד׃", "transliteral": "lā-ʿaḏ", "traducao_palavra": "para sempre" }
      ]
    },
    "4": {
      "traducao_completa": "Fez memoráveis as suas maravilhas; piedoso e misericordioso é YHWH.",
      "palavras": [
        { "hebraico": "זֵ֣כֶר", "transliteral": "zē-ḵer", "traducao_palavra": "memorial/lembrança" },
        { "hebraico": "עָ֭שָׂה", "transliteral": "ʿā-śā", "traducao_palavra": "ele fez" },
        { "hebraico": "לְנִפְלְאֳֹתָ֑יו", "transliteral": "lə-nip̄-lə-ʾô-ṯāyw", "traducao_palavra": "para suas maravilhas" },
        { "hebraico": "חַנּ֖וּן", "transliteral": "ḥan-nûn", "traducao_palavra": "gracioso/piedoso" },
