        { "hebraico": "קַוָּ֗ם", "transliteral": "qaw-wām", "traducao_palavra": "a linha deles" },
        { "hebraico": "וּבִקְצֵ֣ה", "transliteral": "ū-ḇiq-ṣēh", "traducao_palavra": "e na extremidade de" },
