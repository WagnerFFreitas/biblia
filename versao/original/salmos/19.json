    "1": {
      "traducao_completa": "Ao mestre de canto. Salmo de Davi.",
      "palavras": [
        { "hebraico": "לַמְנַצֵּ֗חַ", "transliteral": "lam-naṣ-ṣē-aḥ", "traducao_palavra": "ao mestre de canto" },
