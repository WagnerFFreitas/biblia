        { "hebraico": "גַּ֤ם", "transliteral": "gam", "traducao_palavra": "também" },
        { "hebraico": "מִזֵּ֘דִ֤ים ׀", "transliteral": "miz-zē-ḏîm", "traducao_palavra": "de soberbos/presunçosos" },
