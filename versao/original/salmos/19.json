      ]
    },
    "4": {
      "traducao_completa": "Não há fala, nem há palavras; não se ouve a sua voz.",
      "palavras": [
        { "hebraico": "אֵֽין־אֹ֭מֶר", "transliteral": "ʾên-ʾō-mer", "traducao_palavra": "não há fala" },
        { "hebraico": "וְאֵ֣ין", "transliteral": "wə-ʾên", "traducao_palavra": "e não há" },
        { "hebraico": "דְּבָרִ֑ים", "transliteral": "də-ḇā-rîm", "traducao_palavra": "palavras" },
        { "hebraico": "בְּ֝לִ֗י", "transliteral": "bə-lî", "traducao_palavra": "sem [que]" },
        { "hebraico": "נִשְׁמָ֥ע", "transliteral": "niš-māʿ", "traducao_palavra": "seja ouvido" },
