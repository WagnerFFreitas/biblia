    "5": {
      "traducao_completa": "A sua linha de medir estendeu-se por toda a terra, e as suas palavras até ao fim do mundo. Neles pôs uma tenda para o sol,",
      "palavras": [
        { "hebraico": "בְּכָל־הָאָ֨רֶץ ׀", "transliteral": "bə-ḵāl-hā-ʾā-reṣ", "traducao_palavra": "por toda a terra" },
