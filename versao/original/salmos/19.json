        { "hebraico": "יַבִּ֣יעַ", "transliteral": "yab-bî-aʿ", "traducao_palavra": "jorra/profere" },
        { "hebraico": "אֹ֑מֶר", "transliteral": "ʾō-mer", "traducao_palavra": "fala/palavra" },
        { "hebraico": "וְלַ֥יְלָה", "transliteral": "wə-lay-lā", "traducao_palavra": "e noite" },
