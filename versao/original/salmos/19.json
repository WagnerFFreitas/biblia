    "11": {
      "traducao_completa": "Mais desejáveis são do que o ouro, sim, do que muito ouro fino; e mais doces do que o mel e o destilar dos favos.",
      "palavras": [
        { "hebraico": "הַֽנֶּחֱמָדִ֗ים", "transliteral": "han-ne-ḥĕ-mā-ḏîm", "traducao_palavra": "[os que são] desejáveis" },
