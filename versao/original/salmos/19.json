    },
    "6": {
      "traducao_completa": "O qual é como um noivo que sai do seu tálamo, e se alegra como um herói a correr o seu caminho.",
      "palavras": [
        { "hebraico": "וְה֗וּא", "transliteral": "wə-hû", "traducao_palavra": "e ele" },
