{
  "livro": "Salmos - תְּהִלִּים - Tehillim",
  "capítulo": 65,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "A ti, ó Deus, o silêncio é louvor em Sião; e a ti se pagará o voto.",
      "palavras": [
        { "hebraico": "לְךָ֤", "transliteral": "lə-ḵā", "traducao_palavra": "para ti" },
        { "hebraico": "דֻֽמִיָּ֬ה", "transliteral": "ḏu-miy-yā", "traducao_palavra": "silêncio/espera" },
        { "hebraico": "תְהִלָּ֓ה", "transliteral": "ṯə-hil-lā", "traducao_palavra": "[é] louvor" },
        { "hebraico": "אֱלֹ֘הִ֤ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "ó Deus" },
        { "hebraico": "בְּצִיֹּ֑ון", "transliteral": "bə-ṣiy-yôn", "traducao_palavra": "em Sião" },
        { "hebraico": "וּ֝לְךָ֗", "transliteral": "ū-lə-ḵā", "traducao_palavra": "e a ti" },
        { "hebraico": "יְשֻׁלַּם־", "transliteral": "yə-šul-lam-", "traducao_palavra": "será pago" },
        { "hebraico": "נֶֽדֶר׃", "transliteral": "ne-ḏer", "traducao_palavra": "[o] voto" }
      ]
    },
    "2": {
