      "traducao_completa": "Prevalecem as iniquidades contra mim; mas tu expias as nossas transgressões.",
      "palavras": [
        { "hebraico": "דִּבְרֵ֣י", "transliteral": "diḇ-rê", "traducao_palavra": "atos/palavras de" },
        { "hebraico": "עֲ֭וֹנֹת", "transliteral": "ʿă-wō-nōṯ", "traducao_palavra": "iniquidades" },
        { "hebraico": "גָּ֣בְרוּ", "transliteral": "ḡā-ḇə-rû", "traducao_palavra": "prevaleceram" },
        { "hebraico": "מֶ֑נִּי", "transliteral": "men-nî", "traducao_palavra": "contra mim" },
        { "hebraico": "פְּ֝שָׁעֵ֗ינוּ", "transliteral": "p̄ə-šā-ʿê-nû", "traducao_palavra": "nossas transgressões" },
        { "hebraico": "אַתָּ֥ה", "transliteral": "ʾat-tā", "traducao_palavra": "tu" },
