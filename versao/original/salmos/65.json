        { "hebraico": "נִ֭שְׂבְּעָה", "transliteral": "niś-bə-ʿā", "traducao_palavra": "seremos fartos" },
        { "hebraico": "בְּט֣וּב", "transliteral": "bə-ṭûᇀ", "traducao_palavra": "da bondade de" },
