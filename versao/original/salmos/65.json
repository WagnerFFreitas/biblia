        { "hebraico": "בְּכֹחֹ֑ו", "transliteral": "bə-ḵō-ḥô", "traducao_palavra": "com sua força" },
        { "hebraico": "נֶ֝אְזָ֗ר", "transliteral": "ne-ʾzār", "traducao_palavra": "[estando] cingido" },
