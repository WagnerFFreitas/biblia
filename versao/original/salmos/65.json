        { "hebraico": "גַּלֵּיהֶ֗ם", "transliteral": "gal-lê-hem", "traducao_palavra": "ondas deles" },
        { "hebraico": "וַהֲמֹ֥ון", "transliteral": "wa-hă-môn", "traducao_palavra": "e o tumulto de" },
