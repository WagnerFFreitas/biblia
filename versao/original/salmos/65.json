        { "hebraico": "עָ֝דֶ֗יךָ", "transliteral": "ʿā-ḏey-ḵā", "traducao_palavra": "até ti" },
        { "hebraico": "כָּל־", "transliteral": "kāl-", "traducao_palavra": "toda" },
        { "hebraico": "בָּשָׂ֥ר", "transliteral": "bā-śār", "traducao_palavra": "carne" },
        { "hebraico": "יָבֹֽאוּ׃", "transliteral": "yā-ḇō-ʾû", "traducao_palavra": "virão" }
      ]
    },
