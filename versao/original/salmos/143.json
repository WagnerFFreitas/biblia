        { "hebraico": "וְאַל־", "transliteral": "wəʾal-", "traducao_palavra": "e não" },
        { "hebraico": "תָּבֹ֣וא", "transliteral": "tāḇô", "traducao_palavra": "entres" },
        { "hebraico": "בְ֭מִשְׁפָּט", "transliteral": "bəmišpāṭ", "traducao_palavra": "em juízo" },
        { "hebraico": "אֶת־", "transliteral": "ʾeṯ-", "traducao_palavra": "com" },
        { "hebraico": "עַבְדֶּ֑ךָ", "transliteral": "ʿaḇdeḵā", "traducao_palavra": "teu servo" },
        { "hebraico": "כִּ֤י", "transliteral": "kî", "traducao_palavra": "pois" },
        { "hebraico": "לֹֽא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "יִצְדַּ֖ק", "transliteral": "yiṣdaq", "traducao_palavra": "será justo" },
        { "hebraico": "לְפָנֶ֣יךָ", "transliteral": "ləp̄āneyḵā", "traducao_palavra": "diante de ti" },
        { "hebraico": "כָל־", "transliteral": "ḵāl-", "traducao_palavra": "todo" },
        { "hebraico": "חָֽי׃", "transliteral": "ḥāy", "traducao_palavra": "vivente" }
      ]
    },
    "3": {
      "traducao_completa": "Pois o inimigo perseguiu a minha alma; esmagou a minha vida contra o chão; fez-me habitar em trevas, como os que morreram há muito.",
      "palavras": [
        { "hebraico": "כִּ֥י", "transliteral": "kî", "traducao_palavra": "pois" },
        { "hebraico": "רָ֘דַ֤ף", "transliteral": "rāḏap̄", "traducao_palavra": "perseguiu" },
        { "hebraico": "אֹויֵ֨ב", "transliteral": "ʾôyēḇ", "traducao_palavra": "[o] inimigo" },
        { "hebraico": "נַפְשִׁ֗י", "transliteral": "nap̄šî", "traducao_palavra": "minha alma" },
        { "hebraico": "דִּכָּ֣א", "transliteral": "dikkāʾ", "traducao_palavra": "esmagou" },
