  "versiculos": {
    "1": {
      "traducao_completa": "YHWH, ouve a minha oração, dá ouvidos às minhas súplicas; responde-me por tua fidelidade e por tua justiça.",
      "palavras": [
        { "hebraico": "יְהוָה֮", "transliteral": "yəhwāh", "traducao_palavra": "YHWH" },
        { "hebraico": "שְׁמַ֪ע", "transliteral": "šəmaʿ", "traducao_palavra": "ouve" },
        { "hebraico": "תְּפִלָּתִ֗י", "transliteral": "ṯəp̄illāṯî", "traducao_palavra": "minha oração" },
        { "hebraico": "הַאֲזִ֥ינָה", "transliteral": "haʾăzînā", "traducao_palavra": "inclina os ouvidos" },
        { "hebraico": "אֶל־", "transliteral": "ʾel-", "traducao_palavra": "para" },
        { "hebraico": "תַּחֲנוּנַ֑י", "transliteral": "taḥănûnay", "traducao_palavra": "minhas súplicas" },
        { "hebraico": "בֶּאֱמֻנָתְךָ֥", "transliteral": "beʾĕmunāṯəḵā", "traducao_palavra": "na tua fidelidade" },
        { "hebraico": "עֲ֝נֵ֗נִי", "transliteral": "ʿănēnî", "traducao_palavra": "responde-me" },
        { "hebraico": "בְּצִדְקָתֶֽךָ׃", "transliteral": "bəṣiḏqāṯeḵā", "traducao_palavra": "na tua justiça" }
      ]
    },
    "2": {
