        { "hebraico": "רוּחִ֑י", "transliteral": "rûḥî", "traducao_palavra": "meu espírito" },
        { "hebraico": "בְּ֝תֹוכִ֗י", "transliteral": "bəṯôḵî", "traducao_palavra": "no meu meio/íntimo" },
