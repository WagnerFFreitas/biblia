    "4": {
      "traducao_completa": "Pelo que o meu espírito desfalecia em mim; o meu coração em meu íntimo estava desolado.",
      "palavras": [
        { "hebraico": "וַתִּתְעַטֵּ֣ף", "transliteral": "wattit̄ʿaṭṭēp̄", "traducao_palavra": "e desfalecia" },
