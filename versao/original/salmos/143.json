        { "hebraico": "חַיָּתִ֑י", "transliteral": "ḥayyāṯî", "traducao_palavra": "minha vida" },
        { "hebraico": "הֹושִׁיבַ֥נִי", "transliteral": "hôšîḇanî", "traducao_palavra": "fez-me habitar" },
        { "hebraico": "בְ֝מַחֲשַׁכִּ֗ים", "transliteral": "bəmaḥăšakkîm", "traducao_palavra": "em trevas" },
        { "hebraico": "כְּמֵתֵ֥i", "transliteral": "kəmēṯê", "traducao_palavra": "como os mortos de" },
