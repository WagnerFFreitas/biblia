        { "hebraico": "הָגִ֥יתִי", "transliteral": "hāḡîṯî", "traducao_palavra": "meditei" },
        { "hebraico": "בְכָל־", "transliteral": "bəḵāl-", "traducao_palavra": "em todos" },
