    "8": {
      "traducao_completa": "Meu é Gileade, e meu é Manassés; Efraim é a força da minha cabeça; Judá é o meu cetro.",
      "palavras": [
        { "hebraico": "לִ֣י", "transliteral": "lî", "traducao_palavra": "meu [é]" },
        { "hebraico": "גִלְעָ֧ד", "transliteral": "ḡil-ʿāḏ", "traducao_palavra": "Gileade" },
