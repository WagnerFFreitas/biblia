      ]
    },
    "4": {
      "traducao_completa": "Porque a tua misericórdia é grande, acima dos céus, e a tua fidelidade chega até às nuvens.",
      "palavras": [
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "porque" },
        { "hebraico": "גָדֹ֣ול", "transliteral": "gā-ḏôl", "traducao_palavra": "grande [é]" },
        { "hebraico": "מֵעַל־", "transliteral": "mē-ʿal-", "traducao_palavra": "acima de" },
        { "hebraico": "שָׁמַ֣יִם", "transliteral": "šā-ma-yim", "traducao_palavra": "céus" },
        { "hebraico": "חַסְדֶּ֑ךָ", "transliteral": "ḥas-de-ḵā", "traducao_palavra": "tua misericórdia" },
