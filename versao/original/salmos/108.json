  "versiculos": {
    "1": {
      "traducao_completa": "Preparado está o meu coração, ó Deus; cantarei e salmodiarei com toda a minha glória.",
      "palavras": [
        { "hebraico": "נָכֹ֣ון", "transliteral": "nā-ḵôn", "traducao_palavra": "firmado/preparado" },
        { "hebraico": "לִבִּ֣י", "transliteral": "lib-bî", "traducao_palavra": "meu coração" },
        { "hebraico": "אֱלֹהִ֑ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "ó Deus" },
        { "hebraico": "אָ֝שִׁ֗ירָה", "transliteral": "ʾā-šî-rā", "traducao_palavra": "cantarei" },
        { "hebraico": "וַאֲזַמְּרָ֥ה", "transliteral": "wa-ʾă-zam-mə-rā", "traducao_palavra": "e salmodiarei" },
        { "hebraico": "אַף־", "transliteral": "ʾap̄-", "traducao_palavra": "também/até" },
