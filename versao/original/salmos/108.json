        { "hebraico": "בָעַמִּ֨ים", "transliteral": "ḇā-ʿam-mîm", "traducao_palavra": "entre os povos" },
        { "hebraico": "יְהוָ֑ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "וַ֝אֲזַמֶּרְךָ֗", "transliteral": "wa-ʾă-zam-mer-ḵā", "traducao_palavra": "e salmodiarei a ti" },
        { "hebraico": "בַּל־", "transliteral": "bal-", "traducao_palavra": "entre" },
