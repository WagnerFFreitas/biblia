{
  "livro": "Salmos - תְּהִלִּים - Tehillim",
  "capítulo": 26,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "De Davi. Julga-me, YHWH, pois tenho andado na minha integridade; e em YHWH confio, sem vacilar.",
      "palavras": [
        { "hebraico": "לְדָוִ֨ד", "transliteral": "lə-ḏā-wiḏ", "traducao_palavra": "de Davi" },
        { "hebraico": "שָׁפְטֵ֤נִי", "transliteral": "šā-p̄ə-ṭē-nî", "traducao_palavra": "julga-me" },
        { "hebraico": "יְהוָ֗", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "כִּֽי־אֲ֭נִי", "transliteral": "kî-ʾă-nî", "traducao_palavra": "pois eu" },
        { "hebraico": "בְּתֻמִּ֣י", "transliteral": "bə-ṯum-mî", "traducao_palavra": "na minha integridade" },
        { "hebraico": "הָלַ֑כְתִּי", "transliteral": "hā-laḵ-tî", "traducao_palavra": "tenho andado" },
        { "hebraico": "וּבַיהוָ֥ה", "transliteral": "ū-ḇay-hwāh", "traducao_palavra": "e em YHWH" },
        { "hebraico": "בָּ֝טַ֗חְתִּי", "transliteral": "bā-ṭaḥ-tî", "traducao_palavra": "confiei" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "אֶמְעָֽד׃", "transliteral": "ʾem-ʿāḏ", "traducao_palavra": "vacilarei/resvalarei" }
      ]
    },
    "2": {
      "traducao_completa": "Sonda-me, YHWH, e prova-me; refina os meus rins e o meu coração.",
      "palavras": [
        { "hebraico": "בְּחָנֵ֣נִי", "transliteral": "bə-ḥā-nê-nî", "traducao_palavra": "sonda-me/examina-me" },
        { "hebraico": "יְהוָ֣ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "וְנַסֵּ֑נִי", "transliteral": "wə-nas-sê-nî", "traducao_palavra": "e prova-me" },
        { "hebraico": "צָרְפָ֖ה", "transliteral": "ṣā-rə-p̄ā", "traducao_palavra": "refina/purifica [Qere: ṣārəp̄āh]" },
        { "hebraico": "כִלְיֹותַ֣י", "transliteral": "ḵil-yô-ṯay", "traducao_palavra": "meus rins [íntimo]" },
        { "hebraico": "וְלִבִּֽי׃", "transliteral": "wə-lib-bî", "traducao_palavra": "e meu coração" }
      ]
    },
    "3": {
      "traducao_completa": "Porque a tua misericórdia está diante dos meus olhos; e tenho andado na tua verdade.",
      "palavras": [
        { "hebraico": "כִּֽי־חַ֭סְדְּךָ", "transliteral": "kî-ḥas-də-ḵā", "traducao_palavra": "porque tua misericórdia" },
        { "hebraico": "לְנֶ֣גֶד", "transliteral": "lə-ne-ḡeḏ", "traducao_palavra": "[está] diante de" },
        { "hebraico": "עֵינָ֑י", "transliteral": "ʿê-nāy", "traducao_palavra": "meus olhos" },
        { "hebraico": "וְ֝הִתְהַלַּ֗כְתִּי", "transliteral": "wə-hiṯ-hal-laḵ-tî", "traducao_palavra": "e tenho andado" },
        { "hebraico": "בַּאֲמִתֶּֽךָ׃", "transliteral": "ba-ʾă-mit-te-ḵā", "traducao_palavra": "na tua verdade" }
      ]
    },
    "4": {
      "traducao_completa": "Não me tenho assentado com homens vãos, nem converso com os homens dissimulados.",
      "palavras": [
        { "hebraico": "לֹא־יָ֭שַׁבְתִּי", "transliteral": "lō-yā-šaḇ-tî", "traducao_palavra": "não me assentei" },
        { "hebraico": "עִם־מְתֵי־שָׁ֑וְא", "transliteral": "ʿim-mə-ṯê-šā-wəʾ", "traducao_palavra": "com homens de vaidade/falsidade" },
        { "hebraico": "וְעִם־נַ֝עֲלָמִ֗ים", "transliteral": "wə-ʿim-na-ʿă-lā-mîm", "traducao_palavra": "e com dissimulados/ocultos" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "אָבֹֽוא׃", "transliteral": "ʾā-ḇô", "traducao_palavra": "entrarei/irei" }
      ]
    },
    "5": {
      "traducao_completa": "Odeio a congregação de malfeitores; e não me assentarei com os ímpios.",
      "palavras": [
        { "hebraico": "שָׂ֭נֵאתִי", "transliteral": "śā-nē-ṯî", "traducao_palavra": "odiei" },
        { "hebraico": "קְהַ֣ל", "transliteral": "qə-hal", "traducao_palavra": "[a] congregação de" },
        { "hebraico": "מְרֵעִ֑ים", "transliteral": "mə-rē-ʿîm", "traducao_palavra": "malfeitores" },
        { "hebraico": "וְעִם־רְ֝שָׁעִ֗ים", "transliteral": "wə-ʿim-rə-šā-ʿîm", "traducao_palavra": "e com ímpios" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "אֵשֵֽׁב׃", "transliteral": "ʾē-šēḇ", "traducao_palavra": "me assentarei" }
      ]
    },
    "6": {
      "traducao_completa": "Lavo as minhas mãos na inocência; e assim andarei em volta do teu altar, YHWH.",
      "palavras": [
        { "hebraico": "אֶרְחַ֥ץ", "transliteral": "ʾer-ḥaṣ", "traducao_palavra": "lavarei" },
        { "hebraico": "בְּנִקָּיֹ֥ון", "transliteral": "bə-niq-qā-yôn", "traducao_palavra": "na inocência/limpeza" },
        { "hebraico": "כַּפָּ֑י", "transliteral": "kap-pāy", "traducao_palavra": "minhas mãos" },
        { "hebraico": "וַאֲסֹבְבָ֥ה", "transliteral": "wa-ʾă-sō-ḇə-ḇā", "traducao_palavra": "e andarei em volta" },
        { "hebraico": "אֶת־מִזְבַּחֲךָ֬", "transliteral": "ʾeṯ-miz-ba-ḥă-ḵā", "traducao_palavra": "[do] teu altar" },
        { "hebraico": "יְהוָֽה׃", "transliteral": "YHWH", "traducao_palavra": "YHWH" }
      ]
    },
    "7": {
      "traducao_completa": "Para fazer ouvir a voz de louvor, e contar todas as tuas maravilhas.",
      "palavras": [
        { "hebraico": "לַ֭שְׁמִעַ", "transliteral": "laš-mi-aʿ", "traducao_palavra": "para fazer ouvir" },
        { "hebraico": "בְּקֹ֣ול", "transliteral": "bə-qôl", "traducao_palavra": "com a voz de" },
        { "hebraico": "תֹּודָ֑ה", "transliteral": "tô-ḏā", "traducao_palavra": "louvor/gratidão" },
        { "hebraico": "וּ֝לְסַפֵּ֗ר", "transliteral": "ū-lə-sap-pēr", "traducao_palavra": "e para contar" },
        { "hebraico": "כָּל־נִפְלְאֹותֶֽיךָ׃", "transliteral": "kāl-nip̄-lə-ʾô-ṯê-ḵā", "traducao_palavra": "todas as tuas maravilhas" }
      ]
    },
    "8": {
      "traducao_completa": "YHWH, eu amo a habitação da tua casa e o lugar onde permanece a tua glória.",
      "palavras": [
        { "hebraico": "יְֽהוָ֗ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "אָ֭הַבְתִּי", "transliteral": "ʾā-haḇ-tî", "traducao_palavra": "amei" },
        { "hebraico": "מְעֹ֣ון", "transliteral": "mə-ʿôn", "traducao_palavra": "[a] habitação de" },
        { "hebraico": "בֵּיתֶ֑ךָ", "transliteral": "bê-ṯe-ḵā", "traducao_palavra": "tua casa" },
        { "hebraico": "וּ֝מְקֹ֗ום", "transliteral": "ū-mə-qôm", "traducao_palavra": "e [o] lugar de" },
        { "hebraico": "מִשְׁכַּ֥ן", "transliteral": "miš-kan", "traducao_palavra": "tabernáculo/morada de" },
        { "hebraico": "כְּḇֹודֶֽךָ׃", "transliteral": "kə-ḇô-ḏe-ḵā", "traducao_palavra": "tua glória" }
      ]
    },
    "9": {
      "traducao_completa": "Não colhas a minha alma com os pecadores, nem a minha vida com os homens sanguinários,",
      "palavras": [
        { "hebraico": "אַל־תֶּאֱסֹ֥ף", "transliteral": "ʾal-te-ʾĕ-śōp̄", "traducao_palavra": "não colhas/arrebtes" },
        { "hebraico": "עִם־חַטָּאִ֗ים", "transliteral": "ʿim-ḥaṭ-ṭā-ʾîm", "traducao_palavra": "com pecadores" },
        { "hebraico": "נַפְשִׁ֑י", "transliteral": "nap̄-šî", "traducao_palavra": "minha alma" },
        { "hebraico": "וְעִם־אַנְשֵׁ֖י", "transliteral": "wə-ʿim-ʾan-šê", "traducao_palavra": "e com homens de" },
        { "hebraico": "דָמִ֣ים", "transliteral": "ḏā-mîm", "traducao_palavra": "sangues/sanguinários" },
        { "hebraico": "חַיָּֽי׃", "transliteral": "ḥay-yāy", "traducao_palavra": "minha vida" }
      ]
    },
    "10": {
      "traducao_completa": "Em cujas mãos há malefício, e cuja destra está cheia de subornos.",
      "palavras": [
        { "hebraico": "אֲשֶׁר־בִּידֵיהֶ֣ם", "transliteral": "ʾă-šer-bî-ḏê-hem", "traducao_palavra": "em cujas mãos [deles]" },
        { "hebraico": "זִמָּ֑ה", "transliteral": "zim-mā", "traducao_palavra": "malefício/trama maligna" },
        { "hebraico": "וִֽ֝ימִינָ֗ם", "transliteral": "wî-mî-nām", "traducao_palavra": "e a destra deles" },
        { "hebraico": "מָלְאָ֥ה", "transliteral": "mā-lə-ʾā", "traducao_palavra": "[está] cheia de" },
        { "hebraico": "שֹּֽׁחַד׃", "transliteral": "šō-ḥaḏ", "traducao_palavra": "suborno" }
      ]
    },
    "11": {
      "traducao_completa": "Mas quanto a mim, ando na minha integridade; livra-me e tem piedade de mim.",
      "palavras": [
        { "hebraico": "וַאֲנִ֭י", "transliteral": "wa-ʾă-nî", "traducao_palavra": "mas eu" },
        { "hebraico": "בְּתֻmִּ֥י", "transliteral": "bə-ṯum-mî", "traducao_palavra": "na minha integridade" },
        { "hebraico": "אֵלֵ֗ךְ", "transliteral": "ʾê-lēḵ", "traducao_palavra": "andarei" },
        { "hebraico": "פְּדֵ֣נִי", "transliteral": "pə-ḏē-nî", "traducao_palavra": "redime-me/livra-me" },
        { "hebraico": "וְחָנֵּֽנִי׃", "transliteral": "wə-ḥān-nē-nî", "traducao_palavra": "e tem piedade de mim" }
      ]
    },
    "12": {
      "traducao_completa": "O meu pé está posto em caminho plano; nas congregações bendirei a YHWH.",
      "palavras": [
        { "hebraico": "רַ֭גְלִי", "transliteral": "raḡ-lî", "traducao_palavra": "meu pé" },
        { "hebraico": "עָמְדָ֣ה", "transliteral": "ʿā-mə-ḏā", "traducao_palavra": "está posto/ficou de pé" },
        { "hebraico": "בְמִישֹׁ֑ור", "transliteral": "ḇə-mî-šôr", "traducao_palavra": "em lugar plano/retidão" },
        { "hebraico": "בְּ֝מַקְהֵלִ֗ים", "transliteral": "bə-maq-hē-lîm", "traducao_palavra": "nas congregações" },
        { "hebraico": "אֲבָרֵ֥ךְ", "transliteral": "ʾă-ḇā-rēḵ", "traducao_palavra": "bendirei" },
        { "hebraico": "יְהוָֽה׃", "transliteral": "YHWH", "traducao_palavra": "YHWH" }
      ]
    }
  }
