    "7": {
      "traducao_completa": "As palavras de YHWH são palavras puras, como prata refinada em cadinho de barro, purificada sete vezes.",
      "palavras": [
        { "hebraico": "אִֽמֲרֹ֣ות", "transliteral": "ʾi-mă-rôṯ", "traducao_palavra": "palavras de" },
        { "hebraico": "יְהוָה֮", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "אִמֲרֹ֪ות", "transliteral": "ʾim-rôṯ", "traducao_palavra": "palavras" },
        { "hebraico": "טְהֹ֫ורֹ֥ות", "transliteral": "ṭə-hō-rôṯ", "traducao_palavra": "puras" },
