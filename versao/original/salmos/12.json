        { "hebraico": "בְּלֵ֪ב", "transliteral": "bə-lēḇ", "traducao_palavra": "com coração" },
        { "hebraico": "וָ֫לֵ֥ב", "transliteral": "wā-lēḇ", "traducao_palavra": "e coração [dobre]" },
        { "hebraico": "יְדַבֵּֽרוּ׃", "transliteral": "yə-ḏab-bê-rû", "traducao_palavra": "eles falam" }
      ]
    },
    "4": {
      "traducao_completa": "Corte YHWH todos os lábios lisonjeiros, a língua que fala grandezas,",
      "palavras": [
        { "hebraico": "יַכְרֵ֣ת", "transliteral": "ya-ḵrēṯ", "traducao_palavra": "que corte/extermine" },
