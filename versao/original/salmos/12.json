        { "hebraico": "מְדַבֶּ֥רֶת", "transliteral": "mə-ḏab-be-reṯ", "traducao_palavra": "que fala" },
        { "hebraico": "גְּדֹלֹֽות׃", "transliteral": "ḡə-ḏō-lôṯ", "traducao_palavra": "grandezas/arrogâncias" }
      ]
    },
    "5": {
      "traducao_completa": "Os que dizem: Com a nossa língua prevaleceremos; os nossos lábios estão conosco; quem é senhor sobre nós?",
