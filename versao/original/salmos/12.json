      ]
    },
    "8": {
      "traducao_completa": "Tu os guardarás, YHWH; tu nos livrarás desta geração para sempre.",
      "palavras": [
        { "hebraico": "אַתָּֽה־יְהוָ֥ה", "transliteral": "ʾat-tā-YHWH", "traducao_palavra": "tu YHWH" },
