        { "hebraico": "מֵאַנְקַ֪ת", "transliteral": "mē-ʾan-qaṯ", "traducao_palavra": "pelo gemido de" },
        { "hebraico": "אֶבְיֹ֫ונִ֥ים", "transliteral": "ʾeḇ-yô-nîm", "traducao_palavra": "necessitados" },
        { "hebraico": "עַתָּ֣ה", "transliteral": "ʿat-tā", "traducao_palavra": "agora" },
        { "hebraico": "אָ֭קוּם", "transliteral": "ʾā-qûm", "traducao_palavra": "me levantarei" },
        { "hebraico": "יֹאמַ֣ר", "transliteral": "yō-mar", "traducao_palavra": "dirá/diz" },
        { "hebraico": "יְהוָ֑ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
