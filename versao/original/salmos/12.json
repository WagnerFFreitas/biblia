  "versiculos": {
    "1": {
      "traducao_completa": "Ao mestre de canto, sobre a oitava. Salmo de Davi.",
      "palavras": [
        { "hebraico": "לַמְנַצֵּ֥חַ", "transliteral": "lam-naṣ-ṣē-aḥ", "traducao_palavra": "ao mestre de canto" },
        { "hebraico": "עַֽל־הַשְּׁמִינִ֗ית", "transliteral": "ʿal-haš-šə-mî-nîṯ", "traducao_palavra": "sobre a oitava [lira de 8 cordas]" },
        { "hebraico": "מִזְמֹ֥ור", "transliteral": "miz-môr", "traducao_palavra": "salmo" },
        { "hebraico": "לְדָוִֽד׃", "transliteral": "lə-ḏā-wiḏ", "traducao_palavra": "de Davi" }
      ]
    },
    "2": {
      "traducao_completa": "Salva, YHWH, pois o piedoso desaparece; pois os fiéis cessam entre os filhos dos homens.",
      "palavras": [
        { "hebraico": "הֹושִׁ֣יעָה", "transliteral": "hô-šî-ʿā", "traducao_palavra": "salva/socorre" },
        { "hebraico": "יְ֭הוָה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "כִּֽי־גָמַ֣ר", "transliteral": "kî-ḡā-mar", "traducao_palavra": "pois cessou/acabou" },
        { "hebraico": "חָסִ֑יד", "transliteral": "ḥā-śîḏ", "traducao_palavra": "[o] piedoso" },
        { "hebraico": "כִּֽי־פַ֥סּוּ", "transliteral": "kî-p̄as-sû", "traducao_palavra": "pois desapareceram" },
        { "hebraico": "אֱ֝מוּנִ֗ים", "transliteral": "ʾĕ-mû-nîm", "traducao_palavra": "[os] fiéis" },
        { "hebraico": "מִבְּנֵ֥י", "transliteral": "mib-bə-nê", "traducao_palavra": "de entre filhos de" },
        { "hebraico": "אָדָֽם׃", "transliteral": "ʾā-ḏām", "traducao_palavra": "homem/Adão" }
      ]
    },
    "3": {
      "traducao_completa": "Cada um fala falsidade ao seu próximo; falam com lábios lisonjeiros e coração dobre.",
      "palavras": [
        { "hebraico": "שָׁ֤וְא", "transliteral": "šā-wəʾ", "traducao_palavra": "falsidade/vaidade" },
        { "hebraico": "יְדַבְּר֡וּ", "transliteral": "yə-ḏab-bə-rû", "traducao_palavra": "eles falam" },
        { "hebraico": "אִ֤ישׁ", "transliteral": "ʾîš", "traducao_palavra": "cada um" },
        { "hebraico": "אֶת־רֵ֬עֵהוּ", "transliteral": "ʾeṯ-rē-ʿê-hû", "traducao_palavra": "com seu próximo" },
        { "hebraico": "שְׂפַ֨ת", "transliteral": "śə-p̄aṯ", "traducao_palavra": "lábio de" },
