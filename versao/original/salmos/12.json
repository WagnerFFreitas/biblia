        { "hebraico": "אֲשֶׁ֤ר", "transliteral": "ʾă-šer", "traducao_palavra": "os que" },
        { "hebraico": "אָמְר֨וּ", "transliteral": "ʾā-mə-rû", "traducao_palavra": "disseram" },
        { "hebraico": "לִלְשֹׁנֵ֣נוּ", "transliteral": "lil-šō-nê-nû", "traducao_palavra": "com nossa língua" },
        { "hebraico": "נַ֭גְבִּיר", "transliteral": "naḡ-bîr", "traducao_palavra": "prevaleceremos" },
        { "hebraico": "שְׂפָתֵ֣ינוּ", "transliteral": "śə-p̄ā-ṯê-nû", "traducao_palavra": "nossos lábios" },
