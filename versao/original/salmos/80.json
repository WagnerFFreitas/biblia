        { "hebraico": "וְ֝אָר֗וּהָ", "transliteral": "wə-ʾā-rû-hā", "traducao_palavra": "e colhem/arrancam dela" },
        { "hebraico": "כָּל־", "transliteral": "kāl-", "traducao_palavra": "todos" },
        { "hebraico": "עֹ֥בְרֵי", "transliteral": "ʿō-ḇə-rê", "traducao_palavra": "[os que] passam por" },
        { "hebraico": "דָֽרֶךְ׃", "transliteral": "ḏā-reḵ", "traducao_palavra": "caminho" }
      ]
    },
    "13": {
      "traducao_completa": "O javali da selva a devora, e as feras do campo se alimentam dela.",
      "palavras": [
        { "hebraico": "יְכַרְסְמֶ֣נָּה", "transliteral": "yə-ḵar-śə-men-nā", "traducao_palavra": "devora-a/roi-a" },
        { "hebraico": "חֲזִ֣יר", "transliteral": "ḥă-zîr", "traducao_palavra": "[o] porco/javali" },
        { "hebraico": "מִיָּ֑עַר", "transliteral": "miy-yā-ʿar", "traducao_palavra": "da floresta/selva" },
        { "hebraico": "וְזִ֥יז", "transliteral": "wə-zîz", "traducao_palavra": "e o que se move/fera" },
        { "hebraico": "שָׂ֝דַ֗י", "transliteral": "śā-ḏay", "traducao_palavra": "do campo" },
        { "hebraico": "יִרְעֶֽנָּה׃", "transliteral": "yir-ʿen-nā", "traducao_palavra": "pasta dela/consome-a" }
      ]
    },
    "14": {
      "traducao_completa": "Oh Deus dos Exércitos, volta-te, nós te rogamos; olha lá dos céus, e vê, e visita esta vinha;",
      "palavras": [
        { "hebraico": "אֱלֹהִ֣ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "ó Deus" },
        { "hebraico": "צְבָאֹות֮", "transliteral": "ṣə-ḇā-ʾôṯ", "traducao_palavra": "[dos] exércitos" },
        { "hebraico": "שׁ֣וּב־", "transliteral": "šûᇀ-", "traducao_palavra": "volta-te" },
        { "hebraico": "נָ֑א", "transliteral": "nā", "traducao_palavra": "agora/por favor" },
        { "hebraico": "הַבֵּ֤ט", "transliteral": "hab-bêṭ", "traducao_palavra": "olha" },
        { "hebraico": "מִשָּׁמַ֨יִם", "transliteral": "miš-šā-ma-yim", "traducao_palavra": "desde os céus" },
        { "hebraico": "וּרְאֵ֕ה", "transliteral": "ū-rə-ʾēh", "traducao_palavra": "e vê" },
        { "hebraico": "וּפְקֹ֖ד", "transliteral": "ū-p̄ə-qōḏ", "traducao_palavra": "e visita" },
        { "hebraico": "גֶּ֥פֶן", "transliteral": "ge-p̄en", "traducao_palavra": "[a] vinha" },
        { "hebraico": "זֹֽאת׃", "transliteral": "zōṯ", "traducao_palavra": "esta" }
      ]
    },
    "15": {
      "traducao_completa": "E a videira que a tua destra plantou, e o renovo que fortaleceste para ti.",
      "palavras": [
        { "hebraico": "וְכַנָּ֕ה", "transliteral": "wə-ḵan-nā", "traducao_palavra": "e o rebento/estaca" },
        { "hebraico": "אֲשֶׁר־", "transliteral": "ʾă-šer-", "traducao_palavra": "que" },
        { "hebraico": "נָטְעָ֥ה", "transliteral": "nā-ṭə-ʿā", "traducao_palavra": "plantou" },
        { "hebraico": "יְמִינֶ֑ךָ", "transliteral": "yə-mî-ne-ḵā", "traducao_palavra": "tua destra" },
        { "hebraico": "וְעַל־", "transliteral": "wə-ʿal-", "traducao_palavra": "e sobre" },
        { "hebraico": "בֵּ֝֗ן", "transliteral": "bēn", "traducao_palavra": "[o] filho/renovo" },
        { "hebraico": "אִמַּ֥צְתָּה", "transliteral": "ʾim-maṣ-tā", "traducao_palavra": "[que] fortaleceste" },
        { "hebraico": "לָּֽךְ׃", "transliteral": "lāḵ", "traducao_palavra": "para ti" }
      ]
    },
    "16": {
      "traducao_completa": "Está queimada pelo fogo, está cortada; perecem pela repreensão do teu rosto.",
      "palavras": [
        { "hebraico": "שְׂרֻפָ֥ה", "transliteral": "śə-ru-p̄ā", "traducao_palavra": "queimada" },
        { "hebraico": "בָאֵ֖שׁ", "transliteral": "ḇā-ʾēš", "traducao_palavra": "no fogo" },
        { "hebraico": "כְסוּחָ֑ה", "transliteral": "ḵə-śû-ḥā", "traducao_palavra": "cortada" },
        { "hebraico": "מִגַּעֲרַ֥ת", "transliteral": "mig-ga-ʿă-raṯ", "traducao_palavra": "pela repreensão de" },
