{
  "livro": "Salmos - תְּהִלִּים - Tehillim",
  "capítulo": 80,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Dá ouvidos, ó Pastor de Israel, tu que guias a José como a um rebanho; tu que te assentas entre os querubins, resplandece.",
      "palavras": [
        { "hebraico": "רֹ֘עֵ֤ה", "transliteral": "rō-ʿēh", "traducao_palavra": "pastor de" },
        { "hebraico": "יִשְׂרָאֵ֨ל ׀", "transliteral": "yiś-rā-ʾēl", "traducao_palavra": "Israel" },
        { "hebraico": "הַאֲזִ֗ינָה", "transliteral": "ha-ʾă-zî-nā", "traducao_palavra": "dá ouvidos" },
        { "hebraico": "נֹהֵ֣ג", "transliteral": "nō-hēḡ", "traducao_palavra": "[o que] guia" },
        { "hebraico": "כַצֹּ֣אן", "transliteral": "ḵaṣ-ṣōn", "traducao_palavra": "como rebanho" },
        { "hebraico": "יֹוסֵ֑ף", "transliteral": "yô-śēp̄", "traducao_palavra": "José" },
        { "hebraico": "יֹשֵׁ֖ב", "transliteral": "yō-šēḇ", "traducao_palavra": "[o que] habita" },
        { "hebraico": "הַכְּרוּבִ֣ים", "transliteral": "hak-kə-rû-ḇîm", "traducao_palavra": "[entre os] querubins" },
        { "hebraico": "הֹופִֽיעָה׃", "transliteral": "hô-p̄î-ʿā", "traducao_palavra": "resplandece" }
      ]
    },
    "2": {
      "traducao_completa": "Perante Efraim, Benjamim e Manassés, desperta o teu poder e vem salvar-nos.",
      "palavras": [
        { "hebraico": "לִפְנֵ֤י", "transliteral": "lip̄-nê", "traducao_palavra": "diante de" },
        { "hebraico": "אֶפְרַ֨יִם ׀", "transliteral": "ʾep̄-ra-yim", "traducao_palavra": "Efraim" },
        { "hebraico": "וּבִנְיָ֘מִ֤ן", "transliteral": "ū-ḇin-yā-min", "traducao_palavra": "e Benjamim" },
        { "hebraico": "וּמְנַשֶּׁ֗ה", "transliteral": "ū-mə-naš-šeh", "traducao_palavra": "e Manassés" },
        { "hebraico": "עֹורְרָ֥ה", "transliteral": "ʿô-rə-rā", "traducao_palavra": "desperta" },
        { "hebraico": "אֶת־", "transliteral": "ʾeṯ-", "traducao_palavra": "[objeto]" },
        { "hebraico": "גְּבֽוּרָתֶ֑ךָ", "transliteral": "gə-ḇû-rā-ṯe-ḵā", "traducao_palavra": "teu poder" },
        { "hebraico": "וּלְכָ֖ה", "transliteral": "ū-lə-ḵā", "traducao_palavra": "e vem" },
        { "hebraico": "לִֽישֻׁעָ֣תָה", "transliteral": "lî-šu-ʿā-ṯā", "traducao_palavra": "para salvação" },
        { "hebraico": "לָּֽנוּ׃", "transliteral": "lā-nû", "traducao_palavra": "para nós" }
      ]
    },
    "3": {
      "traducao_completa": "Faze-nos voltar, ó Deus; e faze resplandecer o teu rosto, e seremos salvos.",
      "palavras": [
        { "hebraico": "אֱלֹהִ֥ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "ó Deus" },
        { "hebraico": "הֲשִׁ֓יבֵ֑נוּ", "transliteral": "hă-šî-ḇē-nû", "traducao_palavra": "restaura-nos/faz-nos voltar" },
        { "hebraico": "וְהָאֵ֥ר", "transliteral": "wə-hā-ʾēr", "traducao_palavra": "e faze brilhar" },
        { "hebraico": "פָּנֶ֗יךָ", "transliteral": "pā-ne-ḵā", "traducao_palavra": "tua face" },
        { "hebraico": "וְנִוָּשֵֽׁעָה׃", "transliteral": "wə-niw-wā-šê-ʿā", "traducao_palavra": "e seremos salvos" }
      ]
    },
    "4": {
      "traducao_completa": "Ó YHWH, Deus dos Exércitos, até quando estarás indignado contra a oração do teu povo?",
      "palavras": [
        { "hebraico": "יְהוָ֣ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "אֱלֹהִ֣ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "Deus" },
        { "hebraico": "צְבָאֹ֑ות", "transliteral": "ṣə-ḇā-ʾôṯ", "traducao_palavra": "[dos] exércitos" },
        { "hebraico": "עַד־", "transliteral": "ʿaḏ-", "traducao_palavra": "até" },
        { "hebraico": "מָתַ֥י", "transliteral": "mā-ṯay", "traducao_palavra": "quando" },
        { "hebraico": "עָ֝שַׁ֗נְתָּ", "transliteral": "ʿā-šan-tā", "traducao_palavra": "fumegarás/estarás indignado" },
        { "hebraico": "בִּתְפִלַּ֥ת", "transliteral": "biṯ-p̄il-laṯ", "traducao_palavra": "com a oração de" },
        { "hebraico": "עַמֶּֽךָ׃", "transliteral": "ʿam-me-ḵā", "traducao_palavra": "teu povo" }
      ]
    },
    "5": {
      "traducao_completa": "Tu os alimentas com pão de lágrimas, e lhes dás a beber lágrimas em abundância.",
      "palavras": [
        { "hebraico": "הֶ֭אֱכַלְתָּם", "transliteral": "he-ʾĕ-ḵal-tām", "traducao_palavra": "alimentaste-os" },
        { "hebraico": "לֶ֣חֶם", "transliteral": "le-ḥem", "traducao_palavra": "[com] pão de" },
        { "hebraico": "דִּמְעָ֑ה", "transliteral": "ḏim-ʿā", "traducao_palavra": "lágrima" },
        { "hebraico": "וַתַּשְׁקֵ֥מֹו", "transliteral": "wat-taš-qē-mô", "traducao_palavra": "e deste a beber a eles" },
        { "hebraico": "בִּדְמָעֹ֗ות", "transliteral": "biḏ-mā-ʿôṯ", "traducao_palavra": "em lágrimas" },
        { "hebraico": "שָׁלִֽישׁ׃", "transliteral": "šā-lîš", "traducao_palavra": "triplicadamente/em abundância" }
      ]
    },
    "6": {
      "traducao_completa": "Tu nos pões por objeto de contenda entre os nossos vizinhos, e os nossos inimigos riem-se de nós entre si.",
      "palavras": [
        { "hebraico": "תְּשִׂימֵ֣נוּ", "transliteral": "tə-śî-mē-nû", "traducao_palavra": "puseste-nos" },
        { "hebraico": "מָ֭דֹון", "transliteral": "mā-ḏôn", "traducao_palavra": "[como] contenda" },
        { "hebraico": "לִשְׁכֵנֵ֑ינוּ", "transliteral": "liš-ḵē-nê-nû", "traducao_palavra": "para nossos vizinhos" },
        { "hebraico": "וְ֝אֹיְבֵ֗ינוּ", "transliteral": "wə-ʾō-yə-ḇê-nû", "traducao_palavra": "e nossos inimigos" },
        { "hebraico": "יִלְעֲגוּ־", "transliteral": "yil-ʿă-ḡû-", "traducao_palavra": "zombam" },
        { "hebraico": "לָֽמֹו׃", "transliteral": "lā-mô", "traducao_palavra": "para si" }
      ]
    },
    "7": {
      "traducao_completa": "Faze-nos voltar, ó Deus dos Exércitos; e faze resplandecer o teu rosto, e seremos salvos.",
      "palavras": [
        { "hebraico": "אֱלֹהִ֣ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "Deus" },
        { "hebraico": "צְבָאֹ֣ות", "transliteral": "ṣə-ḇā-ʾôṯ", "traducao_palavra": "[dos] exércitos" },
        { "hebraico": "הֲשִׁ֓יבֵ֑נוּ", "transliteral": "hă-šî-ḇē-nû", "traducao_palavra": "restaura-nos" },
        { "hebraico": "וְהָאֵ֥ר", "transliteral": "wə-hā-ʾēr", "traducao_palavra": "e faze brilhar" },
        { "hebraico": "פָּנֶ֗יךָ", "transliteral": "pā-ne-ḵā", "traducao_palavra": "tua face" },
        { "hebraico": "וְנִוָּשֵֽׁעָה׃", "transliteral": "wə-niw-wā-šê-ʿā", "traducao_palavra": "e seremos salvos" }
      ]
    },
    "8": {
      "traducao_completa": "Trouxeste uma videira do Egito; expulsaste as nações e a plantaste.",
      "palavras": [
        { "hebraico": "גֶּ֭פֶן", "transliteral": "ge-p̄en", "traducao_palavra": "[uma] videira" },
        { "hebraico": "מִמִּצְרַ֣יִם", "transliteral": "mim-miṣ-ra-yim", "traducao_palavra": "do Egito" },
        { "hebraico": "תַּסִּ֑יעַ", "transliteral": "tas-śî-aʿ", "traducao_palavra": "tu arrancaste/fizeste partir" },
        { "hebraico": "תְּגָרֵ֥שׁ", "transliteral": "tə-ḡā-rēš", "traducao_palavra": "expulsaste" },
        { "hebraico": "גֹּ֝ויִם", "transliteral": "ḡô-yim", "traducao_palavra": "nações" },
        { "hebraico": "וַתִּטָּעֶֽהָ׃", "transliteral": "wat-tiṭ-ṭā-ʿe-hā", "traducao_palavra": "e a plantaste" }
      ]
    },
    "9": {
      "traducao_completa": "Preparaste-lhe o lugar, e ela deitou profundas raízes e encheu a terra.",
      "palavras": [
        { "hebraico": "פִּנִּ֥יתָ", "transliteral": "pin-nî-ṯā", "traducao_palavra": "limpaste/preparaste" },
        { "hebraico": "לְפָנֶ֑יהָ", "transliteral": "lə-p̄ā-ne-hā", "traducao_palavra": "diante dela" },
        { "hebraico": "וַתַּשְׁרֵ֥שׁ", "transliteral": "wat-taš-rēš", "traducao_palavra": "e deitou" },
        { "hebraico": "שָׁ֝רָשֶׁ֗יהָ", "transliteral": "šā-rā-šey-hā", "traducao_palavra": "raízes dela" },
        { "hebraico": "וַתְּמַלֵּא־", "transliteral": "wat-tə-mal-lē-", "traducao_palavra": "e encheu" },
        { "hebraico": "אָֽרֶץ׃", "transliteral": "ʾā-reṣ", "traducao_palavra": "[a] terra" }
      ]
    },
    "10": {
      "traducao_completa": "Os montes foram cobertos com a sua sombra, e os seus ramos tornaram-se como os bons cedros.",
      "palavras": [
        { "hebraico": "כָּסּ֣וּ", "transliteral": "kāś-śû", "traducao_palavra": "foram cobertos" },
        { "hebraico": "הָרִ֣ים", "transliteral": "hā-rîm", "traducao_palavra": "[os] montes" },
        { "hebraico": "צִלָּ֑הּ", "transliteral": "ṣil-lāh", "traducao_palavra": "[pela] sombra dela" },
        { "hebraico": "וַ֝עֲנָפֶ֗יהָ", "transliteral": "wa-ʿă-nā-p̄ey-hā", "traducao_palavra": "e os ramos dela" },
        { "hebraico": "אַרְזֵי־", "transliteral": "ʾar-zê-", "traducao_palavra": "[como] cedros de" },
        { "hebraico": "אֵֽל׃", "transliteral": "ʾēl", "traducao_palavra": "Deus/grandiosos" }
      ]
    },
    "11": {
      "traducao_completa": "Estendeu os seus ramos até ao mar, e os seus rebentos até ao rio.",
      "palavras": [
        { "hebraico": "תְּשַׁלַּ֣ח", "transliteral": "tə-šal-laḥ", "traducao_palavra": "estendeu/enviou" },
        { "hebraico": "קְ֭צִירֶהָ", "transliteral": "qə-ṣî-re-hā", "traducao_palavra": "ramos dela" },
        { "hebraico": "עַד־", "transliteral": "ʿaḏ-", "traducao_palavra": "até" },
        { "hebraico": "יָ֑ם", "transliteral": "yām", "traducao_palavra": "[o] mar" },
        { "hebraico": "וְאֶל־", "transliteral": "wə-ʾel-", "traducao_palavra": "e até" },
        { "hebraico": "נָ֝הָ֗ר", "transliteral": "nā-hār", "traducao_palavra": "[o] rio" },
        { "hebraico": "יֹונְקֹותֶֽיהָ׃", "transliteral": "yô-nə-qô-ṯe-hā", "traducao_palavra": "os rebentos/brotos dela" }
      ]
    },
    "12": {
      "traducao_completa": "Por que rompeste os seus muros, de modo que todos os que passam pelo caminho a vindimam?",
      "palavras": [
        { "hebraico": "לָ֭מָּה", "transliteral": "lām-mā", "traducao_palavra": "por que" },
        { "hebraico": "פָּרַ֣צְתָּ", "transliteral": "pā-raṣ-tā", "traducao_palavra": "rompeste/derribaste" },
