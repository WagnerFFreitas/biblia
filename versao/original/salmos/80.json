        { "hebraico": "תְּהִי־", "transliteral": "tə-hî-", "traducao_palavra": "seja" },
        { "hebraico": "יָדְךָ", "transliteral": "yā-ḏə-ḵā", "traducao_palavra": "tua mão" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre" },
        { "hebraico": "אִ֣ישׁ", "transliteral": "ʾîš", "traducao_palavra": "[o] homem de" },
        { "hebraico": "יְמִינֶ֑ךָ", "transliteral": "yə-mî-ne-ḵā", "traducao_palavra": "tua destra" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre" },
