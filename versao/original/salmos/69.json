    "2": {
      "traducao_completa": "Atolado estou em profundo lamaçal, onde não se pode estar em pé; entrei na profundeza das águas, onde a corrente me submerge.",
      "palavras": [
        { "hebraico": "טָבַ֤עְתִּי", "transliteral": "ṭā-ḇaʿ-tî", "traducao_palavra": "afundei/atolei" },
        { "hebraico": "בִּיוֵ֣ן", "transliteral": "bi-ywēn", "traducao_palavra": "em lama de" },
        { "hebraico": "מְ֭צוּלָה", "transliteral": "mə-ṣû-lā", "traducao_palavra": "profundeza" },
        { "hebraico": "וְאֵ֣ין", "transliteral": "wə-ʾên", "traducao_palavra": "e não há" },
