        { "hebraico": "פָנָֽי׃", "transliteral": "p̄ā-nāy", "traducao_palavra": "minha face" }
      ]
    },
    "8": {
      "traducao_completa": "Tenho-me tornado um estranho para com os meus irmãos, e um desconhecido para com os filhos de minha mãe.",
