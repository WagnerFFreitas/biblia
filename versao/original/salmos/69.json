    "4": {
      "traducao_completa": "Aqueles que me odeiam sem causa são mais do que os cabelos da minha cabeça; aqueles que me querem destruir, sendo injustamente meus inimigos, são poderosos; então restituí o que não roubei.",
      "palavras": [
        { "hebraico": "רַבּ֤וּ", "transliteral": "rab-bû", "traducao_palavra": "são mais numerosos" },
        { "hebraico": "מִשַּׂעֲרֹ֪ות", "transliteral": "miś-śa-ʿă-rôṯ", "traducao_palavra": "do que os cabelos de" },
        { "hebraico": "רֹ֫אשִׁ֥י", "transliteral": "rō-šî", "traducao_palavra": "minha cabeça" },
