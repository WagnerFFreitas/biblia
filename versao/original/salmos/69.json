  "versiculos": {
    "1": {
      "traducao_completa": "Salva-me, ó Deus, pois as águas entraram até à minha alma.",
      "palavras": [
        { "hebraico": "הֹושִׁ֘יעֵ֤נִי", "transliteral": "hô-šî-ʿē-nî", "traducao_palavra": "salva-me" },
        { "hebraico": "אֱלֹהִ֗ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "ó Deus" },
        { "hebraico": "כִּ֤י", "transliteral": "kî", "traducao_palavra": "porque/pois" },
        { "hebraico": "בָ֭אוּ", "transliteral": "ḇā-ʾû", "traducao_palavra": "entraram/vieram" },
        { "hebraico": "מַ֣יִם", "transliteral": "ma-yim", "traducao_palavra": "águas" },
