        { "hebraico": "נָפְל֥וּ", "transliteral": "nā-p̄ə-lû", "traducao_palavra": "caíram" },
        { "hebraico": "עָלָֽי׃", "transliteral": "ʿā-lāy", "traducao_palavra": "sobre mim" }
      ]
    },
    "10": {
      "traducao_completa": "E chorei, e castiguei com jejum a minha alma, e isto se me tornou em afronta.",
      "palavras": [
        { "hebraico": "וָאֶבְכֶּ֣ה", "transliteral": "wā-ʾeḇ-keh", "traducao_palavra": "e chorei" },
        { "hebraico": "בַצֹּ֣ום", "transliteral": "baṣ-ṣôm", "traducao_palavra": "com o jejum" },
        { "hebraico": "נַפְשִׁ֑י", "transliteral": "nap̄-šî", "traducao_palavra": "minha alma" },
