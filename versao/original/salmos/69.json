    "17": {
      "traducao_completa": "E não escondas o teu rosto do teu servo, pois estou angustiado; ouve-me depressa.",
      "palavras": [
        { "hebraico": "וְאַל־", "transliteral": "wə-ʾal-", "traducao_palavra": "e não" },
        { "hebraico": "תַּסְתֵּ֣ר", "transliteral": "tas-tēr", "traducao_palavra": "escondas" },
        { "hebraico": "פָּנֶ֣יךָ", "transliteral": "pā-ne-ḵā", "traducao_palavra": "tua face" },
        { "hebraico": "מֵֽעַבְדֶּ֑ךָ", "transliteral": "mê-ʿaḇ-de-ḵā", "traducao_palavra": "do teu servo" },
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "porque" },
