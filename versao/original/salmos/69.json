    "6": {
      "traducao_completa": "Não sejam envergonhados por minha causa os que esperam em ti, ó Senhor, YHWH dos Exércitos; não sejam confundidos por minha causa os que te buscam, ó Deus de Israel.",
      "palavras": [
        { "hebraico": "אַל־", "transliteral": "ʾal-", "traducao_palavra": "não" },
        { "hebraico": "יֵ֘בֹ֤שׁוּ", "transliteral": "yē-ḇō-šû", "traducao_palavra": "sejam envergonhados" },
