        { "hebraico": "שֶׁ֗קֶר", "transliteral": "še-qer", "traducao_palavra": "[de] mentira/falsamente" },
        { "hebraico": "אֲשֶׁ֣ר", "transliteral": "ʾă-šer", "traducao_palavra": "o que" },
