        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "porque" },
        { "hebraico": "קִנְאַ֣ת", "transliteral": "qin-ʾaṯ", "traducao_palavra": "[o] zelo de" },
        { "hebraico": "בֵּיתְךָ֣", "transliteral": "bê-ṯə-ḵā", "traducao_palavra": "tua casa" },
        { "hebraico": "אֲכָלָ֑תְנִי", "transliteral": "ʾă-ḵā-lā-ṯə-nî", "traducao_palavra": "devorou-me" },
        { "hebraico": "וְחֶרְפֹּ֥ות", "transliteral": "wə-ḥer-pôṯ", "traducao_palavra": "e as afrontas de" },
