      ]
    },
    "19": {
      "traducao_completa": "Tu conheces a minha afronta, a minha vergonha e a minha ignomínia; todos os meus adversários estão diante de ti.",
      "palavras": [
        { "hebraico": "אַתָּ֤ה", "transliteral": "ʾat-tā", "traducao_palavra": "tu" },
        { "hebraico": "יָדַ֗עְתָּ", "transliteral": "yā-ḏaʿ-tā", "traducao_palavra": "conheceste" },
        { "hebraico": "חֶרְפָּתִ֥י", "transliteral": "ḥer-pā-ṯî", "traducao_palavra": "minha afronta" },
        { "hebraico": "וּבָשְׁתִּ֗י", "transliteral": "ū-ḇoš-tî", "traducao_palavra": "e minha vergonha" },
        { "hebraico": "וּכְלִמָּ֫תִ֥י", "transliteral": "ū-ḵə-lim-mā-ṯî", "traducao_palavra": "e minha ignomínia" },
        { "hebraico": "נֶגְדְּךָ֥", "transliteral": "neḡ-də-ḵā", "traducao_palavra": "diante de ti" },
