    "5": {
      "traducao_completa": "Tu, ó Deus, bem conheces a minha estultícia; e as minhas culpas não te são ocultas.",
      "palavras": [
        { "hebraico": "אֱ֭לֹהִים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "ó Deus" },
        { "hebraico": "אַתָּ֣ה", "transliteral": "ʾat-tā", "traducao_palavra": "tu" },
        { "hebraico": "יָ֭דַעְתָּ", "transliteral": "yā-ḏa-ʿtā", "traducao_palavra": "conheces" },
        { "hebraico": "לְאִוַּלְתִּ֑י", "transliteral": "lə-ʾiw-wal-tî", "traducao_palavra": "a minha estultícia" },
        { "hebraico": "וְ֝אַשְׁמֹותַ֗י", "transliteral": "wə-ʾaš-mô-ṯay", "traducao_palavra": "e minhas culpas" },
        { "hebraico": "מִמְּךָ֥", "transliteral": "mim-mə-ḵā", "traducao_palavra": "de ti" },
