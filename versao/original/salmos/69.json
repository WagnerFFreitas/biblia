    "7": {
      "traducao_completa": "Porque por amor de ti tenho suportado afrontas; a confusão cobriu o meu rosto.",
      "palavras": [
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "porque" },
        { "hebraico": "עָ֭לֶיךָ", "transliteral": "ʿā-le-ḵā", "traducao_palavra": "por causa de ti" },
        { "hebraico": "נָשָׂ֣אתִי", "transliteral": "nā-śā-ṯî", "traducao_palavra": "suportei" },
        { "hebraico": "חֶרְפָּ֑ה", "transliteral": "ḥer-pā", "traducao_palavra": "afronta" },
        { "hebraico": "כִּסְּתָ֥ה", "transliteral": "kis-śə-ṯā", "traducao_palavra": "cobriu" },
