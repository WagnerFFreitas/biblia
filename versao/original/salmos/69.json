        { "hebraico": "לִפְנֵיהֶ֣ם", "transliteral": "lip̄-nê-hem", "traducao_palavra": "diante deles" },
        { "hebraico": "לְפָ֑ח", "transliteral": "lə-p̄āḥ", "traducao_palavra": "em laço" },
        { "hebraico": "וְלִשְׁלֹומִ֥ים", "transliteral": "wə-liš-lô-mîm", "traducao_palavra": "e para os seguros/em paz" },
