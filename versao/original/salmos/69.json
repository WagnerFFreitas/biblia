        { "hebraico": "לִֽי׃", "transliteral": "lî", "traducao_palavra": "para mim" }
      ]
    },
    "11": {
      "traducao_completa": "Fiz do cilício a minha veste, e lhes servi de provérbio.",
      "palavras": [
        { "hebraico": "וָאֶתְּנָ֣ה", "transliteral": "wā-ʾet-tə-nā", "traducao_palavra": "e pus/fiz" },
        { "hebraico": "לְבוּשִׁ֣י", "transliteral": "lə-ḇû-šî", "traducao_palavra": "minha veste" },
        { "hebraico": "שָׂ֑ק", "transliteral": "śāq", "traducao_palavra": "cilício/saco" },
        { "hebraico": "וָאֱהִ֥י", "transliteral": "wā-ʾĕ-hî", "traducao_palavra": "e eu fui/tornei-me" },
        { "hebraico": "לָהֶ֗ם", "transliteral": "lā-hem", "traducao_palavra": "para eles" },
        { "hebraico": "לְמָשָֽׁל׃", "transliteral": "lə-mā-šāl", "traducao_palavra": "um provérbio/exemplo" }
      ]
    },
    "12": {
      "traducao_completa": "Os que se assentam à porta falam contra mim; e os que bebem bebida forte fazem canções sobre mim.",
      "palavras": [
        { "hebraico": "יָשִׂ֣יחוּ", "transliteral": "yā-śî-ḥû", "traducao_palavra": "falam/conversam" },
        { "hebraico": "בִ֭י", "transliteral": "ḇî", "traducao_palavra": "de mim" },
        { "hebraico": "יֹ֣שְׁבֵי", "transliteral": "yō-šə-ḇê", "traducao_palavra": "[os que] sentam" },
        { "hebraico": "שָׁ֑עַר", "transliteral": "šā-ʿar", "traducao_palavra": "[à] porta" },
        { "hebraico": "וּ֝נְגִינֹ֗ות", "transliteral": "ū-nə-ḡî-nôṯ", "traducao_palavra": "e canções [fazem]" },
