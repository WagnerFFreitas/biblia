        { "hebraico": "מַ֗יִם", "transliteral": "ma-yim", "traducao_palavra": "águas" },
        { "hebraico": "וְשִׁבֹּ֥לֶת", "transliteral": "wə-šib-bō-leṯ", "traducao_palavra": "e a corrente/fluxo" },
        { "hebraico": "שְׁטָפָֽתְנִי׃", "transliteral": "šə-ṭā-p̄ā-ṯə-nî", "traducao_palavra": "submergiu-me" }
      ]
    },
    "3": {
      "traducao_completa": "Cansado estou de clamar; a minha garganta se secou; os meus olhos desfalecem esperando o meu Deus.",
      "palavras": [
        { "hebraico": "יָגַ֣עְתִּי", "transliteral": "yā-ḡa-ʿtî", "traducao_palavra": "cansei-me" },
        { "hebraico": "בְקָרְאִ֗י", "transliteral": "ḇə-qā-rə-ʾî", "traducao_palavra": "no meu clamar" },
        { "hebraico": "נִחַ֥ר", "transliteral": "ni-ḥar", "traducao_palavra": "queimou-se/secou" },
        { "hebraico": "גְּרֹונִ֑י", "transliteral": "gə-rô-nî", "traducao_palavra": "minha garganta" },
