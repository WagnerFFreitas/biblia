        { "hebraico": "עֵינַ֗י", "transliteral": "ʿê-nay", "traducao_palavra": "meus olhos" },
        { "hebraico": "מְ֝יַחֵ֗ל", "transliteral": "mə-ya-ḥēl", "traducao_palavra": "esperando" },
