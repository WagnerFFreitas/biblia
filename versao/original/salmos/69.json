        { "hebraico": "חַיִּ֑ים", "transliteral": "ḥay-yîm", "traducao_palavra": "viventes" },
        { "hebraico": "וְעִ֥ם", "transliteral": "wə-ʿim", "traducao_palavra": "e com" },
        { "hebraico": "צַ֝דִּיקִ֗ים", "transliteral": "ṣad-dî-qîm", "traducao_palavra": "justos" },
        { "hebraico": "אַל־", "transliteral": "ʾal-", "traducao_palavra": "não" },
        { "hebraico": "יִכָּתֵֽבוּ׃", "transliteral": "yik-kā-ṯê-ḇû", "traducao_palavra": "sejam escritos" }
      ]
    },
    "29": {
      "traducao_completa": "Eu, porém, sou pobre e sofredor; que a tua salvação, ó Deus, me ponha em segurança.",
      "palavras": [
        { "hebraico": "וַאֲנִ֗י", "transliteral": "wa-ʾă-nî", "traducao_palavra": "e eu" },
        { "hebraico": "עָנִ֥י", "transliteral": "ʿā-nî", "traducao_palavra": "pobre" },
        { "hebraico": "וְכֹואֵ֑ב", "transliteral": "wə-ḵô-ʾēḇ", "traducao_palavra": "e sofredor" },
        { "hebraico": "יְשׁוּעָתְךָ֖", "transliteral": "yə-šû-ʿā-ṯə-ḵā", "traducao_palavra": "tua salvação" },
        { "hebraico": "אֱלֹהִ֣ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "ó Deus" },
        { "hebraico": "תְּשַׂגְּבֵֽנִי׃", "transliteral": "tə-śag-gə-ḇē-nî", "traducao_palavra": "ponha-me no alto/segurança" }
      ]
    },
    "30": {
      "traducao_completa": "Louvarei o nome de Deus com um cântico, e engrandecê-lo-ei com ações de graças.",
      "palavras": [
        { "hebraico": "אֲהַֽלְלָ֣ה", "transliteral": "ʾă-hal-lə-lā", "traducao_palavra": "louvarei" },
        { "hebraico": "שֵׁם־", "transliteral": "šēm-", "traducao_palavra": "[o] nome de" },
        { "hebraico": "אֱלֹהִ֣ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "Deus" },
        { "hebraico": "בְּשִׁ֑יר", "transliteral": "bə-šîr", "traducao_palavra": "com cântico" },
        { "hebraico": "וַאֲגַדְּלֶ֥נּוּ", "transliteral": "wa-ʾă-ḡad-də-len-nû", "traducao_palavra": "e engrandecê-lo-ei" },
        { "hebraico": "בְתֹודָֽה׃", "transliteral": "ḇə-ṯô-ḏā", "traducao_palavra": "com gratidão" }
      ]
    },
    "31": {
      "traducao_completa": "E isto será mais agradável a YHWH do que o boi, ou bezerro que tem chifres e unhas.",
      "palavras": [
        { "hebraico": "וְתִיטַ֣ב", "transliteral": "wə-ṯî-ṭaḇ", "traducao_palavra": "e será melhor/mais agradável" },
        { "hebraico": "לַֽיהוָה", "transliteral": "lay-hwāh", "traducao_palavra": "para YHWH" },
        { "hebraico": "מִשֹּׁ֥ור", "transliteral": "miš-šôr", "traducao_palavra": "do que boi" },
        { "hebraico": "פָּ֗ר", "transliteral": "p̄ār", "traducao_palavra": "novilho" },
        { "hebraico": "מַקְרִ֥ן", "transliteral": "maq-rin", "traducao_palavra": "[que tem] chifres" },
        { "hebraico": "מַפְרִֽיס׃", "transliteral": "map̄-rîs", "traducao_palavra": "[e] cascos/unhas" }
      ]
