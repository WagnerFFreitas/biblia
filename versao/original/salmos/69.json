        { "hebraico": "יִשְׁעֶֽךָ׃", "transliteral": "yiš-ʿe-ḵā", "traducao_palavra": "tua salvação" }
      ]
    },
    "14": {
      "traducao_completa": "Tira-me do lamaçal, e não me deixes afundar; seja eu livre dos que me odeiam e das profundezas das águas.",
      "palavras": [
        { "hebraico": "הַצִּילֵ֥נִי", "transliteral": "haṣ-ṣî-lē-nî", "traducao_palavra": "livra-me" },
        { "hebraico": "מִ֝טִּ֗יט", "transliteral": "miṭ-ṭîṭ", "traducao_palavra": "do lamaçal" },
        { "hebraico": "וְאַל־", "transliteral": "wə-ʾal-", "traducao_palavra": "e não" },
        { "hebraico": "אֶטְבָּ֑עָה", "transliteral": "ʾeṭ-bā-ʿā", "traducao_palavra": "que eu afunde" },
        { "hebraico": "אִנָּצְלָ֥ה", "transliteral": "ʾin-nā-ṣə-lā", "traducao_palavra": "seja eu liberto" },
