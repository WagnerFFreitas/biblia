        { "hebraico": "וּמִמַּֽעֲמַקֵּי־", "transliteral": "ū-mim-ma-ʿă-maq-qê-", "traducao_palavra": "e das profundezas de" },
        { "hebraico": "מָֽיִם׃", "transliteral": "mā-yim", "traducao_palavra": "águas" }
