        { "hebraico": "יְ֭הוָה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "כִּי־", "transliteral": "kî-", "traducao_palavra": "porque" },
        { "hebraico": "טֹ֣וב", "transliteral": "ṭôḇ", "traducao_palavra": "boa [é]" },
