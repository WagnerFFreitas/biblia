        { "hebraico": "אַל־", "transliteral": "ʾal-", "traducao_palavra": "não" },
        { "hebraico": "תִּשְׁטְפֵ֤נִי ׀", "transliteral": "tiš-ṭə-p̄ē-nî", "traducao_palavra": "submerja-me" },
