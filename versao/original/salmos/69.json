        { "hebraico": "וּ֝מָתְנֵיהֶ֗ם", "transliteral": "ū-māṯ-nê-hem", "traducao_palavra": "e lombos deles" },
        { "hebraico": "תָּמִ֥יד", "transliteral": "tā-mîḏ", "traducao_palavra": "sempre" },
