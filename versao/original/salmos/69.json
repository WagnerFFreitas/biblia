      ]
    },
    "20": {
      "traducao_completa": "A afronta quebrou o meu coração, e estou definhando; esperei por alguém que tivesse piedade, mas não houve nenhum; e por consoladores, mas não os achei.",
      "palavras": [
        { "hebraico": "חֶרְפָּ֤ה", "transliteral": "ḥer-pā", "traducao_palavra": "[a] afronta" },
        { "hebraico": "שָׁבְרָ֥ה", "transliteral": "šā-ḇə-rā", "traducao_palavra": "quebrou" },
        { "hebraico": "לִבִּ֗י", "transliteral": "lib-bî", "traducao_palavra": "meu coração" },
        { "hebraico": "וָאָ֫נוּשָׁה", "transliteral": "wā-ʾā-nû-šā", "traducao_palavra": "e estou enfermo/desesperançado" },
        { "hebraico": "וָאֲקַוֶּה", "transliteral": "wā-ʾă-qaw-weh", "traducao_palavra": "e esperei" },
        { "hebraico": "לָנ֥וּד", "transliteral": "lā-nûḏ", "traducao_palavra": "por compaixão/lamento" },
        { "hebraico": "וָאַ֑יִן", "transliteral": "wā-ʾā-yin", "traducao_palavra": "e não [houve]" },
        { "hebraico": "וְלַמְנַחֲמִ֗ים", "transliteral": "wə-lam-na-ḥă-mîm", "traducao_palavra": "e por consoladores" },
        { "hebraico": "וְלֹ֣א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "מָצָֽאתִי׃", "transliteral": "mā-ṣā-ṯî", "traducao_palavra": "achei" }
      ]
    },
    "21": {
      "traducao_completa": "Deram-me fel por mantimento, e na minha sede me deram a beber vinagre.",
      "palavras": [
        { "hebraico": "וַיִּתְּנ֣וּ", "transliteral": "way-yit-tə-nû", "traducao_palavra": "e deram" },
        { "hebraico": "בְּבָרוּתִ֣י", "transliteral": "bə-ḇā-rû-ṯî", "traducao_palavra": "em minha comida" },
        { "hebraico": "רֹ֑אשׁ", "transliteral": "rōš", "traducao_palavra": "veneno/fel" },
        { "hebraico": "וּ֝לְצִמְאָאִ֗י", "transliteral": "ū-lə-ṣim-ʾā-ʾî", "traducao_palavra": "e para minha sede" },
