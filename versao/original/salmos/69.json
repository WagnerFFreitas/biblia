        { "hebraico": "קָרְבָ֥ה", "transliteral": "qā-rə-ḇā", "traducao_palavra": "aproxima-te" },
        { "hebraico": "אֶל־", "transliteral": "ʾel-", "traducao_palavra": "a" },
        { "hebraico": "נַפְשִׁ֗י", "transliteral": "nap̄-šî", "traducao_palavra": "minha alma" },
        { "hebraico": "גְאָ֫לָ֥הּ", "transliteral": "ḡə-ʾā-lāh", "traducao_palavra": "redime-a" },
