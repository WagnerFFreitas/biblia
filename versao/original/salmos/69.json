        { "hebraico": "זַעְמֶ֑ךָ", "transliteral": "za-ʿə-me-ḵā", "traducao_palavra": "tua indignação" },
        { "hebraico": "וַחֲרֹ֥ון", "transliteral": "wa-ḥă-rôn", "traducao_palavra": "e o ardor de" },
        { "hebraico": "אַ֝פְּךָ֗", "transliteral": "ʾap-pə-ḵā", "traducao_palavra": "tua ira" },
        { "hebraico": "יַשִּׂיגֵֽם׃", "transliteral": "yaś-śî-ḡêm", "traducao_palavra": "alcance eles" }
      ]
    },
    "25": {
      "traducao_completa": "Fique desolado o seu acampamento; não haja quem habite nas suas tendas.",
