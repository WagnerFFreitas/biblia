        { "hebraico": "מוּזָר֮", "transliteral": "mû-zār", "traducao_palavra": "estranho/alienado" },
        { "hebraico": "הָיִ֪יתִי", "transliteral": "hā-yî-ṯî", "traducao_palavra": "eu fui/tornei-me" },
        { "hebraico": "לְאֶ֫חָ֥י", "transliteral": "lə-ʾe-ḥāy", "traducao_palavra": "para meus irmãos" },
        { "hebraico": "וְ֝נָכְרִ֗י", "transliteral": "wə-nāḵ-rî", "traducao_palavra": "e um estrangeiro" },
