        { "hebraico": "טִירָתָ֥ם", "transliteral": "ṭî-rā-ṯām", "traducao_palavra": "acampamento deles" },
        { "hebraico": "נְשַׁמָּ֑ה", "transliteral": "nə-šam-mā", "traducao_palavra": "desolado" },
        { "hebraico": "בְּ֝אָהֳלֵיהֶ֗ם", "transliteral": "bə-ʾā-ho-lê-hem", "traducao_palavra": "em suas tendas" },
        { "hebraico": "אַל־", "transliteral": "ʾal-", "traducao_palavra": "não" },
        { "hebraico": "יְהִ֥י", "transliteral": "yə-hî", "traducao_palavra": "haja" },
        { "hebraico": "יֹשֵֽׁב׃", "transliteral": "yō-šēḇ", "traducao_palavra": "[quem] habite" }
      ]
    },
    "26": {
      "traducao_completa": "Pois perseguem aquele a quem tu feriste, e falam do sofrimento daqueles a quem tu chagaste.",
