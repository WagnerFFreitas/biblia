        { "hebraico": "אַתָּ֣ה", "transliteral": "ʾat-tā", "traducao_palavra": "tu" },
        { "hebraico": "אֲשֶׁר־", "transliteral": "ʾă-šer-", "traducao_palavra": "que" },
        { "hebraico": "הִכִּ֣יתָ", "transliteral": "hik-kî-ṯā", "traducao_palavra": "feriste" },
        { "hebraico": "רָדָ֑פוּ", "transliteral": "rā-ḏā-p̄û", "traducao_palavra": "eles perseguiram" },
        { "hebraico": "וְאֶל־", "transliteral": "wə-ʾel-", "traducao_palavra": "e sobre" },
        { "hebraico": "מַכְאֹ֖וב", "transliteral": "maḵ-ʾôḇ", "traducao_palavra": "[o] sofrimento de" },
        { "hebraico": "חֲלָלֶ֣יךָ", "transliteral": "ḥălā-ley-ḵā", "traducao_palavra": "teus feridos" },
