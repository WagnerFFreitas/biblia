        { "hebraico": "שֵׁכָֽר׃", "transliteral": "šē-ḵār", "traducao_palavra": "bebida forte" }
      ]
    },
    "13": {
      "traducao_completa": "Eu, porém, faço a minha oração a ti, YHWH, em tempo aceitável; ó Deus, ouve-me segundo a multidão da tua misericórdia, segundo a verdade da tua salvação.",
      "palavras": [
        { "hebraico": "וַאֲנִ֤י", "transliteral": "wa-ʾă-nî", "traducao_palavra": "e eu" },
        { "hebraico": "תְפִלָּתִֽי־", "transliteral": "ṯə-p̄il-lā-ṯî-", "traducao_palavra": "minha oração" },
        { "hebraico": "לְךָ֨ ׀", "transliteral": "lə-ḵā", "traducao_palavra": "a ti" },
        { "hebraico": "יְהוָ֡ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "עֵ֤ת", "transliteral": "ʿēt", "traducao_palavra": "em tempo de" },
        { "hebraico": "רָצֹ֗ון", "transliteral": "rā-ṣôn", "traducao_palavra": "favor/aceitável" },
        { "hebraico": "אֱלֹהִ֥ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "ó Deus" },
        { "hebraico": "בְּרָב־", "transliteral": "bə-rāḇ-", "traducao_palavra": "na multidão de" },
        { "hebraico": "חַסְדֶּ֑ךָ", "transliteral": "ḥas-de-ḵā", "traducao_palavra": "tua misericórdia" },
