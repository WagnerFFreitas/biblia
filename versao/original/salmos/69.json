        { "hebraico": "בִ֣י", "transliteral": "ḇî", "traducao_palavra": "em mim" },
        { "hebraico": "מְבַקְשֶׁ֑יךָ", "transliteral": "mə-ḇaq-šey-ḵā", "traducao_palavra": "os que te buscam" },
