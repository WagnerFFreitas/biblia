        { "hebraico": "תְּנָֽה־", "transliteral": "tə-nā-", "traducao_palavra": "põe/acrescenta" },
        { "hebraico": "עָ֭וֹן", "transliteral": "ʿā-wōn", "traducao_palavra": "iniquidade" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre" },
        { "hebraico": "עֲוֹנָ֑ם", "transliteral": "ʿă-wō-nām", "traducao_palavra": "iniquidade deles" },
        { "hebraico": "וְאַל־", "transliteral": "wə-ʾal-", "traducao_palavra": "e não" },
        { "hebraico": "יָ֝ḇֹ֗אוּ", "transliteral": "yā-ḇō-ʾû", "traducao_palavra": "venham/entrem" },
        { "hebraico": "בְּצִדְקָתֶֽךָ׃", "transliteral": "bə-ṣiḏ-qā-ṯe-ḵā", "traducao_palavra": "em tua justiça" }
      ]
    },
    "28": {
      "traducao_completa": "Sejam riscados do livro dos viventes, e não sejam escritos com os justos.",
