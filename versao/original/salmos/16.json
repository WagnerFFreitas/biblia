{
  "livro": "Salmos - תְּהִלִּים - Tehillim",
  "capítulo": 16,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Mictão de Davi. Guarda-me, ó Deus, porque em ti me refugio.",
      "palavras": [
        { "hebraico": "מִכְתָּ֥ם", "transliteral": "miḵ-tām", "traducao_palavra": "mictão [poema/hino]" },
        { "hebraico": "לְדָוִ֑ד", "transliteral": "lə-ḏā-wiḏ", "traducao_palavra": "de Davi" },
        { "hebraico": "שָׁמְרֵ֥נִי", "transliteral": "šā-mə-rē-nî", "traducao_palavra": "guarda-me" },
        { "hebraico": "אֵ֝֗ל", "transliteral": "ʾēl", "traducao_palavra": "Deus" },
        { "hebraico": "כִּֽי־חָסִ֥יתִי", "transliteral": "kî-ḥā-śî-ṯî", "traducao_palavra": "porque me refugio" },
        { "hebraico": "בָֽךְ׃", "transliteral": "bāḵ", "traducao_palavra": "em ti" }
      ]
    },
    "2": {
      "traducao_completa": "Digo a YHWH: Tu és o meu Senhor; não tenho outro bem além de ti.",
      "palavras": [
        { "hebraico": "אָמַ֣רְתְּ", "transliteral": "ʾā-mar-tə", "traducao_palavra": "disseste [minha alma] / eu disse" },
        { "hebraico": "לַֽיהוָה֮", "transliteral": "lay-hwāh", "traducao_palavra": "a YHWH" },
        { "hebraico": "אֲדֹנָ֪י", "transliteral": "ʾă-ḏō-nāy", "traducao_palavra": "Senhor meu" },
        { "hebraico": "אָ֥תָּה", "transliteral": "ʾāt-tā", "traducao_palavra": "[és] tu" },
        { "hebraico": "טֹובָתִ֗י", "transliteral": "ṭô-ḇā-ṯî", "traducao_palavra": "meu bem/felicidade" },
        { "hebraico": "בַּל־עָלֶֽיךָ׃", "transliteral": "bal-ʿā-le-ḵā", "traducao_palavra": "não [há] além de ti" }
      ]
    },
    "3": {
      "traducao_completa": "Quanto aos santos que estão na terra, eles são os ilustres nos quais está todo o meu prazer.",
      "palavras": [
        { "hebraico": "לִ֭קְדֹoshִים", "transliteral": "liq-ḏô-šîm", "traducao_palavra": "aos santos" },
        { "hebraico": "אֲשֶׁר־בָּאָ֥רֶץ", "transliteral": "ʾă-šer-bā-ʾā-reṣ", "traducao_palavra": "que [estão] na terra" },
        { "hebraico": "הֵ֑מָּה", "transliteral": "hēm-mā", "traducao_palavra": "eles" },
        { "hebraico": "וְאַדִּירֵ֗י", "transliteral": "wə-ʾad-dî-rê", "traducao_palavra": "e os ilustres/nobres" },
        { "hebraico": "כָּל־חֶפְצִי־בָֽם׃", "transliteral": "kāl-ḥep̄-ṣî-ḇām", "traducao_palavra": "todo meu prazer [está] neles" }
      ]
    },
    "4": {
      "traducao_completa": "As dores daqueles que correm após outro deus se multiplicarão; não oferecerei as suas libações de sangue, nem tomarei os seus nomes nos meus lábios.",
      "palavras": [
        { "hebraico": "יִרְבּ֥וּ", "transliteral": "yir-bû", "traducao_palavra": "se multiplicarão" },
        { "hebraico": "עַצְּבֹותָם֮", "transliteral": "ʿaṣ-ṣə-ḇô-ṯām", "traducao_palavra": "as dores deles" },
        { "hebraico": "אַחֵ֪ר", "transliteral": "ʾa-ḥēr", "traducao_palavra": "[após] outro" },
        { "hebraico": "מָ֫הָ֥רוּ", "transliteral": "mā-hā-rû", "traducao_palavra": "correram/deram dotes" },
        { "hebraico": "בַּל־אַסִּ֣יךְ", "transliteral": "bal-ʾas-sîḵ", "traducao_palavra": "não derramarei" },
        { "hebraico": "נִסְכֵּיהֶ֣ם", "transliteral": "nis-kê-hem", "traducao_palavra": "libações deles" },
        { "hebraico": "מִדָּ֑ם", "transliteral": "mid-dām", "traducao_palavra": "de sangue" },
        { "hebraico": "וּבַל־אֶשָּׂ֥א", "transliteral": "ū-ḇal-ʾeś-śā", "traducao_palavra": "e não tomarei/levarei" },
        { "hebraico": "אֶת־שְׁמֹותָ֗ם", "transliteral": "ʾeṯ-šə-mô-ṯām", "traducao_palavra": "os nomes deles" },
        { "hebraico": "עַל־שְׂפָתָֽי׃", "transliteral": "ʿal-śə-p̄ā-ṯāy", "traducao_palavra": "sobre meus lábios" }
      ]
    },
    "5": {
      "traducao_completa": "YHWH é a porção da minha herança e do meu cálice; tu sustentas a minha sorte.",
      "palavras": [
        { "hebraico": "יְהוָ֗ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "מְנָת־חֶלְקִ֥י", "transliteral": "mə-nāṯ-ḥel-qî", "traducao_palavra": "porção da minha parte/herança" },
        { "hebraico": "וְכֹוסִ֑י", "transliteral": "wə-ḵô-śî", "traducao_palavra": "e meu cálice" },
        { "hebraico": "אַ֝תָּה", "transliteral": "ʾat-tā", "traducao_palavra": "tu" },
        { "hebraico": "תֹּומִ֥יךְ", "transliteral": "tô-mîḵ", "traducao_palavra": "sustentas/seguras" },
        { "hebraico": "גֹּורָלִֽי׃", "transliteral": "ḡô-rā-lî", "traducao_palavra": "minha sorte/lote" }
      ]
    },
    "6": {
      "traducao_completa": "As linhas caíram para mim em lugares amenos; sim, uma bela herança me coube.",
      "palavras": [
        { "hebraico": "חֲבָלִ֣ים", "transliteral": "ḥă-ḇā-lîm", "traducao_palavra": "as linhas [de medir]" },
        { "hebraico": "נָֽפְלוּ־לִ֭י", "transliteral": "nā-p̄ə-lû-lî", "traducao_palavra": "caíram para mim" },
        { "hebraico": "בַּנְּעִמִ֑ים", "transliteral": "ban-nə-ʿi-mîm", "traducao_palavra": "em lugares amenos/deliciosos" },
        { "hebraico": "אַף־נַ֝חֲלָ֗ת", "transliteral": "ʾap̄-na-ḥă-lāṯ", "traducao_palavra": "também [a] herança" },
        { "hebraico": "שָֽׁפְרָ֥ה", "transliteral": "šā-p̄ə-rā", "traducao_palavra": "é agradável/bela" },
        { "hebraico": "עָלָֽי׃", "transliteral": "ʿā-lāy", "traducao_palavra": "sobre mim/para mim" }
      ]
    },
    "7": {
      "traducao_completa": "Bendirei a YHWH que me aconselha; até de noite o meu íntimo me instrui.",
      "palavras": [
        { "hebraico": "אֲבָרֵ֗ךְ", "transliteral": "ʾă-ḇā-rēḵ", "traducao_palavra": "bendirei" },
        { "hebraico": "אֶת־יְהוָ֥ה", "transliteral": "ʾeṯ-YHWH", "traducao_palavra": "a YHWH" },
        { "hebraico": "אֲשֶׁ֣ר", "transliteral": "ʾă-šer", "traducao_palavra": "que" },
        { "hebraico": "יְעָצָ֑נִי", "transliteral": "yə-ʿā-ṣā-nî", "traducao_palavra": "me aconselhou" },
        { "hebraico": "אַף־לֵ֝ילֹ֗ות", "transliteral": "ʾap̄-lê-lôṯ", "traducao_palavra": "também [nas] noites" },
        { "hebraico": "יִסְּר֥וּנִי", "transliteral": "yis-sə-rû-nî", "traducao_palavra": "me instruem/corrigem" },
        { "hebraico": "כִלְיֹותָֽי׃", "transliteral": "ḵil-yô-ṯāy", "traducao_palavra": "meus rins [o íntimo]" }
      ]
    },
    "8": {
      "traducao_completa": "Tenho posto YHWH continuamente diante de mim; por ele estar à minha direita, não serei abalado.",
      "palavras": [
        { "hebraico": "שִׁוִּ֬יתִי", "transliteral": "šiw-wî-ṯî", "traducao_palavra": "pus/ajustei" },
        { "hebraico": "יְהוָ֣ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "לְנֶגְדִּ֣י", "transliteral": "lə-neḡ-dî", "traducao_palavra": "diante de mim" },
        { "hebraico": "תָמִ֑id", "transliteral": "ṯā-mîḏ", "traducao_palavra": "continuamente" },
        { "hebraico": "כִּ֥י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "מִֽ֝ימִינִ֗י", "transliteral": "mî-mî-nî", "traducao_palavra": "[está] à minha direita" },
        { "hebraico": "בַּל־אֶמֹּֽוט׃", "transliteral": "bal-ʾem-môṭ", "traducao_palavra": "não serei abalado" }
      ]
    },
    "9": {
      "traducao_completa": "Portanto, o meu coração se alegra e a minha glória se regozija; também a minha carne habitará em segurança.",
      "palavras": [
        { "hebraico": "לָכֵן֮", "transliteral": "lā-ḵēn", "traducao_palavra": "portanto" },
        { "hebraico": "שָׂמַ֪ח", "transliteral": "śā-maḥ", "traducao_palavra": "alegrou-se" },
        { "hebraico": "לִבִּ֫י", "transliteral": "lib-bî", "traducao_palavra": "meu coração" },
        { "hebraico": "וַיָּ֥גֶל", "transliteral": "way-yā-ḡel", "traducao_palavra": "e regozijou-se" },
        { "hebraico": "כְּבֹודִ֑י", "transliteral": "kə-ḇô-ḏî", "traducao_palavra": "minha glória/alma" },
        { "hebraico": "אַף־בְּ֝שָׂרִ֗י", "transliteral": "ʾap̄-bə-śā-rî", "traducao_palavra": "também minha carne" },
        { "hebraico": "יִשְׁכֹּ֥ן", "transliteral": "yiš-kōn", "traducao_palavra": "habitará/descansará" },
        { "hebraico": "לָבֶֽטַח׃", "transliteral": "lā-ḇe-ṭaḥ", "traducao_palavra": "em segurança/confiança" }
      ]
    },
    "10": {
      "traducao_completa": "Pois não deixarás a minha alma no Sheol, nem permitirás que o teu santo veja a corrupção.",
      "palavras": [
        { "hebraico": "כִּ֤י ׀", "transliteral": "kî", "traducao_palavra": "pois" },
        { "hebraico": "לֹא־תַעֲזֹ֣ב", "transliteral": "lō-ṯa-ʿă-zōḇ", "traducao_palavra": "não abandonarás/deixarás" },
        { "hebraico": "נַפְשִׁ֣י", "transliteral": "nap̄-šî", "traducao_palavra": "minha alma" },
        { "hebraico": "לִשְׁאֹ֑ול", "transliteral": "liš-ʾôl", "traducao_palavra": "ao Sheol [mundo dos mortos]" },
        { "hebraico": "לֹֽא־תִתֵּ֥ן", "transliteral": "lō-ṯit-tēn", "traducao_palavra": "não permitirás/darás" },
        { "hebraico": "חֲ֝סִידְךָ֗", "transliteral": "ḥă-śî-ḏə-ḵā", "traducao_palavra": "[a] teu fiel/santo" },
        { "hebraico": "לִרְאֹ֥ות", "transliteral": "lir-ʾôṯ", "traducao_palavra": "ver" },
        { "hebraico": "שָֽׁחַת׃", "transliteral": "šā-ḥaṯ", "traducao_palavra": "a cova/corrupção" }
      ]
    },
    "11": {
      "traducao_completa": "Tu me farás conhecer o caminho da vida; na tua presença há plenitude de alegria; à tua direita há delícias para sempre.",
      "palavras": [
        { "hebraico": "תֹּ֘ודִיעֵנִי֮", "transliteral": "tô-ḏî-ʿē-nî", "traducao_palavra": "tu me farás conhecer" },
        { "hebraico": "אֹ֤רַח", "transliteral": "ʾō-raḥ", "traducao_palavra": "[o] caminho/vereda de" },
        { "hebraico": "חַ֫יִּ֥ים", "transliteral": "ḥay-yîm", "traducao_palavra": "vida" },
        { "hebraico": "שֹׂ֣בַע", "transliteral": "śō-ḇaʿ", "traducao_palavra": "fartura/plenitude de" },
        { "hebraico": "שְׂ֭מָחֹות", "transliteral": "śə-mā-ḥôṯ", "traducao_palavra": "alegrias" },
        { "hebraico": "אֶת־פָּנֶ֑יךָ", "transliteral": "ʾeṯ-pā-ne-ḵā", "traducao_palavra": "com tua face/presença" },
        { "hebraico": "נְעִמֹ֖ות", "transliteral": "nə-ʿi-môṯ", "traducao_palavra": "delícias/prazeres" },
        { "hebraico": "בִּימִינְךָ֣", "transliteral": "bî-mî-nə-ḵā", "traducao_palavra": "na tua direita" },
        { "hebraico": "נֶֽצַח׃", "transliteral": "ne-ṣaḥ", "traducao_palavra": "eternamente" }
      ]
    }
  }
}