        { "hebraico": "לֵבָ֬ב", "transliteral": "lē-ḇāḇ", "traducao_palavra": "coração" },
        { "hebraico": "לְמֹותֵֽת", "transliteral": "lə-mô-ṯēṯ", "traducao_palavra": "para matar" }
