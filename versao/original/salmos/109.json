      ]
    },
    "5": {
      "traducao_completa": "Retribuíram-me o mal pelo bem, e o ódio pelo meu amor.",
      "palavras": [
        { "hebraico": "וַיָּ֘שִׂ֤ימוּ", "transliteral": "way-yā-śî-mû", "traducao_palavra": "e puseram/retribuíram" },
        { "hebraico": "עָלַי", "transliteral": "ʿā-lay", "traducao_palavra": "sobre mim" },
        { "hebraico": "רָ֭עָה", "transliteral": "rā-ʿā", "traducao_palavra": "mal" },
        { "hebraico": "תַּ֣חַת", "transliteral": "ta-ḥaṯ", "traducao_palavra": "em lugar de" },
        { "hebraico": "טֹובָ֑ה", "transliteral": "ṭô-ḇā", "traducao_palavra": "bem" },
        { "hebraico": "וְ֝שִׂנְאָ֗ה", "transliteral": "wə-śin-ʾā", "traducao_palavra": "e ódio" },
        { "hebraico": "תַּ֣חַת", "transliteral": "ta-ḥaṯ", "traducao_palavra": "em lugar de" },
        { "hebraico": "אַהֲבָתִֽי׃", "transliteral": "ʾa-hă-ḇā-ṯî", "traducao_palavra": "meu amor" }
      ]
    },
    "6": {
      "traducao_completa": "Põe sobre ele um ímpio, e que o adversário esteja à sua direita.",
      "palavras": [
        { "hebraico": "הַפְקֵ֣ד", "transliteral": "hap̄-qēḏ", "traducao_palavra": "põe/constitui" },
