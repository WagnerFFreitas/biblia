      "traducao_completa": "Vestiu-se de maldição como de uma túnica, e ela entrou como água nas suas entranhas e como azeite nos seus ossos.",
      "palavras": [
        { "hebraico": "וַיִּלְבַּ֥שׁ", "transliteral": "way-yil-baš", "traducao_palavra": "e vestiu" },
        { "hebraico": "קְלָלָ֗ה", "transliteral": "qə-lā-lā", "traducao_palavra": "maldição" },
        { "hebraico": "כְּמַדֹּ֑ו", "transliteral": "kə-mad-dô", "traducao_palavra": "como sua veste/túnica" },
        { "hebraico": "וַתָּבֹ֣א", "transliteral": "wat-tā-ḇō", "traducao_palavra": "e entrou" },
        { "hebraico": "כַמַּ֣יִם", "transliteral": "ḵam-ma-yim", "traducao_palavra": "como água" },
        { "hebraico": "בְּקִרְבֹּ֑ו", "transliteral": "bə-qir-bô", "traducao_palavra": "no íntimo dele" },
        { "hebraico": "וְ֝כַשֶּׁ֗מֶן", "transliteral": "wə-ḵaš-še-men", "traducao_palavra": "e como azeite" },
        { "hebraico": "בְּעַצְמֹותָֽיו׃", "transliteral": "bə-ʿaṣ-mô-ṯāyw", "traducao_palavra": "em seus ossos" }
      ]
    },
    "19": {
      "traducao_completa": "Seja-lhe como a veste que o cobre e como o cinto com que sempre se cinge.",
      "palavras": [
        { "hebraico": "תְּהִי־", "transliteral": "tə-hî-", "traducao_palavra": "seja" },
        { "hebraico": "לֹ֭ו", "transliteral": "lô", "traducao_palavra": "a ele" },
        { "hebraico": "כְּבֶ֣גֶד", "transliteral": "kə-ḇe-ḡeḏ", "traducao_palavra": "como veste" },
        { "hebraico": "יַעְטֶ֑ה", "transliteral": "ya-ʿə-ṭeh", "traducao_palavra": "[que] ele cobre-se" },
        { "hebraico": "וּ֝לְמֵ֗זַח", "transliteral": "ū-lə-mē-zaḥ", "traducao_palavra": "e por cinto" },
        { "hebraico": "תָּמִ֥יד", "transliteral": "tā-mîḏ", "traducao_palavra": "sempre" },
        { "hebraico": "יַחְגְּרֶֽהָ׃", "transliteral": "yaḥ-gə-re-hā", "traducao_palavra": "se cinge com ele" }
      ]
    },
    "20": {
      "traducao_completa": "Tal seja, da parte de YHWH, o galardão dos meus adversários e dos que falam mal contra a minha alma.",
      "palavras": [
        { "hebraico": "זֹאת", "transliteral": "zōṯ", "traducao_palavra": "esta [seja]" },
        { "hebraico": "פְּעֻלַּ֬ת", "transliteral": "pə-ʿul-laṯ", "traducao_palavra": "a recompensa/obra de" },
        { "hebraico": "שֹׂטְנַ֫י", "transliteral": "śō-ṭə-nay", "traducao_palavra": "meus adversários" },
        { "hebraico": "מֵאֵ֣ת", "transliteral": "mē-ʾēṯ", "traducao_palavra": "da parte de" },
        { "hebraico": "יְהוָ֑ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "וְהַדֹּבְרִ֥ים", "transliteral": "wə-had-dō-ḇə-rîm", "traducao_palavra": "e dos que falam" },
        { "hebraico": "רָ֝֗ע", "transliteral": "rāʿ", "traducao_palavra": "mal" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "contra" },
        { "hebraico": "נַפְשִֽׁי׃", "transliteral": "nap̄-šî", "traducao_palavra": "minha alma" }
      ]
    },
    "21": {
      "traducao_completa": "Mas tu, ó DEUS Senhor, age por mim, por amor do teu nome; porque a tua misericórdia é boa, livra-me.",
      "palavras": [
        { "hebraico": "וְאַתָּ֤ה", "transliteral": "wə-ʾat-tā", "traducao_palavra": "mas tu" },
        { "hebraico": "יְהוִ֨ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "אֲדֹנָי֮", "transliteral": "ʾă-ḏō-nāy", "traducao_palavra": "Senhor" },
        { "hebraico": "עֲשֵׂה־", "transliteral": "ʿă-śēh-", "traducao_palavra": "age/trata" },
        { "hebraico": "אִ֭תִּי", "transliteral": "ʾit-tî", "traducao_palavra": "comigo" },
        { "hebraico": "לְמַ֣עַen", "transliteral": "lə-ma-ʿan", "traducao_palavra": "por causa de" },
        { "hebraico": "שְׁמֶ֑ךָ", "transliteral": "šə-me-ḵā", "traducao_palavra": "teu nome" },
        { "hebraico": "כִּי־", "transliteral": "kî-", "traducao_palavra": "porque" },
        { "hebraico": "טֹ֥וב", "transliteral": "ṭôᇀ", "traducao_palavra": "boa [é]" },
        { "hebraico": "חַ֝סְדְּךָ֗", "transliteral": "ḥas-də-ḵā", "traducao_palavra": "tua misericórdia" },
        { "hebraico": "הַצִּילֵֽנִי׃", "transliteral": "haṣ-ṣî-lê-nî", "traducao_palavra": "livra-me" }
      ]
    },
    "22": {
      "traducao_completa": "Porque estou pobre e necessitado, e o meu coração está ferido dentro de mim.",
      "palavras": [
        { "hebraico": "כִּי־", "transliteral": "kî-", "traducao_palavra": "porque" },
        { "hebraico": "עָנִ֣י", "transliteral": "ʿā-nî", "traducao_palavra": "pobre" },
        { "hebraico": "וְאֶבְיֹ֣ון", "transliteral": "wə-ʾeḇ-yôn", "traducao_palavra": "e necessitado" },
        { "hebraico": "אֳָנֹ֑כִי", "transliteral": "ʾā-nō-ḵî", "traducao_palavra": "[sou] eu" },
        { "hebraico": "וְ֝לִבִּ֗י", "transliteral": "wə-lib-bî", "traducao_palavra": "e meu coração" },
        { "hebraico": "חָלַ֥ל", "transliteral": "ḥā-lal", "traducao_palavra": "está ferido/atravessado" },
        { "hebraico": "בְּקִרְבִּֽי׃", "transliteral": "bə-qir-bî", "traducao_palavra": "dentro de mim" }
      ]
    },
    "23": {
      "traducao_completa": "Vou-me como a sombra que declina; sou sacudido como o gafanhoto.",
      "palavras": [
        { "hebraico": "כְּצֵל־", "transliteral": "kə-ṣēl-", "traducao_palavra": "como sombra" },
        { "hebraico": "כִּנְטֹותֹ֥ו", "transliteral": "kin-ṭô-ṯô", "traducao_palavra": "quando declina" },
        { "hebraico": "נֶהֱלָ֑כְתִּי", "transliteral": "ne-hĕ-lāḵ-tî", "traducao_palavra": "fui me/passo" },
        { "hebraico": "נִ֝נְעַarrayְתִּי", "transliteral": "nin-ʿar-tî", "traducao_palavra": "fui sacudido" },
        { "hebraico": "כָּאַרְבֶּֽה׃", "transliteral": "kā-ʾar-beh", "traducao_palavra": "como gafanhoto" }
      ]
    },
    "24": {
      "traducao_completa": "Os meus joelhos estão enfraquecidos pelo jejum, e a minha carne desfalecida de gordura.",
      "palavras": [
        { "hebraico": "בִּ֭רְכַּי", "transliteral": "bir-kay", "traducao_palavra": "meus joelhos" },
        { "hebraico": "כָּשְׁל֣וּ", "transliteral": "kā-šə-lû", "traducao_palavra": "vacilaram/tropeçaram" },
        { "hebraico": "מִצֹּ֑ום", "transliteral": "miṣ-ṣôm", "traducao_palavra": "pelo jejum" },
        { "hebraico": "וּ֝בְשָׂרִ֗י", "transliteral": "ū-ḇə-śā-rî", "traducao_palavra": "e minha carne" },
        { "hebraico": "כָּחַ֥שׁ", "transliteral": "kā-ḥaš", "traducao_palavra": "definhou/falhou" },
        { "hebraico": "מִשָּֽׁמֶן׃", "transliteral": "miš-šā-men", "traducao_palavra": "de gordura" }
      ]
    },
    "25": {
      "traducao_completa": "Tornei-me para eles um opróbrio; quando me viram, menearam a cabeça.",
      "palavras": [
        { "hebraico": "וַאֲנִ֤י ׀", "transliteral": "wa-ʾă-nî", "traducao_palavra": "e eu" },
        { "hebraico": "הָיִ֣יתִי", "transliteral": "hā-yî-ṯî", "traducao_palavra": "tornei-me" },
        { "hebraico": "חֶרְפָּ֣ה", "transliteral": "ḥer-pā", "traducao_palavra": "[um] opróbrio" },
        { "hebraico": "לָהֶ֑ם", "transliteral": "lā-hem", "traducao_palavra": "para eles" },
        { "hebraico": "יִ֝רְא֗וּנִי", "transliteral": "yir-ʾû-nî", "traducao_palavra": "viram me" },
        { "hebraico": "יְנִיע֥וּן", "transliteral": "yə-nî-ʿûn", "traducao_palavra": "balançaram/menearam" },
        { "hebraico": "רֹאשָֽׁם׃", "transliteral": "rō-šām", "traducao_palavra": "cabeça deles" }
      ]
    },
    "26": {
      "traducao_completa": "Ajuda-me, YHWH Deus meu, salva-me segundo a tua misericórdia.",
      "palavras": [
        { "hebraico": "עָ֭זְרֵנִי", "transliteral": "ʿā-zə-rē-nî", "traducao_palavra": "ajuda-me" },
        { "hebraico": "יְהוָ֣ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "אֱלֹהָ֑י", "transliteral": "ʾĕ-lō-hāy", "traducao_palavra": "Deus meu" },
        { "hebraico": "הֹושִׁיאֵ֣נִי", "transliteral": "hô-šî-ʿē-nî", "traducao_palavra": "salva-me" },
        { "hebraico": "כְחַסְדֶּֽךָ׃", "transliteral": "ḵə-ḥas-de-ḵā", "traducao_palavra": "conforme tua misericórdia" }
      ]
    },
    "27": {
      "traducao_completa": "Para que saibam que esta é a tua mão, e que tu, YHWH, o fizeste.",
      "palavras": [
        { "hebraico": "וְ֭יֵֽדְעוּ", "transliteral": "wə-yē-ḏə-ʿû", "traducao_palavra": "e saibam" },
        { "hebraico": "כִּי־", "transliteral": "kî-", "traducao_palavra": "que" },
        { "hebraico": "יָ֣דְךָ", "transliteral": "yā-ḏə-ḵā", "traducao_palavra": "tua mão" },
        { "hebraico": "זֹּ֑את", "transliteral": "zōṯ", "traducao_palavra": "[é] esta" },
        { "hebraico": "אַתָּ֖ה", "transliteral": "ʾat-tā", "traducao_palavra": "tu" },
        { "hebraico": "יְהוָ֣ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "עֲשִׂיתָֽהּ׃", "transliteral": "ʿă-śî-ṯāh", "traducao_palavra": "fizeste-a" }
      ]
    },
    "28": {
      "traducao_completa": "Amaldiçoem eles, mas abençoa tu; quando se levantarem, sejam envergonhados; mas alegre-se o teu servo.",
      "palavras": [
        { "hebraico": "יְקַֽלְלוּ־", "transliteral": "yə-qal-lû-", "traducao_palavra": "amaldiçoem" },
        { "hebraico": "הֵמָּה֮", "transliteral": "hēm-mā", "traducao_palavra": "eles" },
        { "hebraico": "וְאַתָּ֪ה", "transliteral": "wə-ʾat-tā", "traducao_palavra": "mas tu" },
        { "hebraico": "תְבָ֫רֵ֥ךְ", "transliteral": "ṯə-ḇā-rēḵ", "traducao_palavra": "abençoa" },
        { "hebraico": "קָ֤מוּ", "transliteral": "qā-mû", "traducao_palavra": "[se] levantarem" },
        { "hebraico": "וַיֵּבֹ֗שׁוּ", "transliteral": "way-yē-ḇō-šû", "traducao_palavra": "e sejam envergonhados" },
        { "hebraico": "וְעַבְדְּךָ֥", "transliteral": "wə-ʿaḇ-də-ḵā", "traducao_palavra": "mas teu servo" },
        { "hebraico": "יִשְׂמָֽח׃", "transliteral": "yiś-māḥ", "traducao_palavra": "alegrar-se-á" }
      ]
    },
    "29": {
      "traducao_completa": "Vistam-se os meus adversários de ignomínia, e cubram-se com a sua própria vergonha como com uma túnica.",
      "palavras": [
        { "hebraico": "יִלְבְּשׁ֣וּ", "transliteral": "yil-bə-šû", "traducao_palavra": "vistam-se" },
        { "hebraico": "שֹׂוטְנַ֣י", "transliteral": "śô-ṭə-nay", "traducao_palavra": "meus adversários" },
        { "hebraico": "כְּלִמָּ֑ה", "transliteral": "ḵə-lim-mā", "traducao_palavra": "[de] ignomínia" },
        { "hebraico": "וְיַעֲט֨וּ", "transliteral": "wə-ya-ʿă-ṭû", "traducao_palavra": "e cubram-se" },
        { "hebraico": "כַמְעִ֖יל", "transliteral": "ḵam-ʿîl", "traducao_palavra": "como capa/túnica" },
        { "hebraico": "בָּשְׁתָּֽם׃", "transliteral": "bāš-tām", "traducao_palavra": "[de] vergonha deles" }
      ]
    },
    "30": {
      "traducao_completa": "Muitas graças darei a YHWH com a minha boca; louvá-lo-ei no meio da multidão.",
      "palavras": [
        { "hebraico": "אֹודֶ֣ה", "transliteral": "ʾô-ḏeh", "traducao_palavra": "agradecerei" },
        { "hebraico": "יְהוָ֣ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "מְאֹ֣ד", "transliteral": "mə-ʾōḏ", "traducao_palavra": "muito" },
        { "hebraico": "בְּפִ֑י", "transliteral": "bə-p̄î", "traducao_palavra": "com minha boca" },
        { "hebraico": "וּבְתֹ֖וךְ", "transliteral": "ū-ḇə-ṯôḵ", "traducao_palavra": "e no meio de" },
        { "hebraico": "רַבִּ֣ים", "transliteral": "rab-bîm", "traducao_palavra": "muitos" },
        { "hebraico": "אֲהַלְלֶֽנּוּ׃", "transliteral": "ʾă-hal-le-nû", "traducao_palavra": "louvarei ele" }
      ]
    },
    "31": {
      "traducao_completa": "Pois ele se porá à direita do pobre, para o salvar dos que condenam a sua alma.",
      "palavras": [
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "porque" },
        { "hebraico": "יַ֭עֲמֹד", "transliteral": "ya-ʿă-mōḏ", "traducao_palavra": "ele se porá" },
        { "hebraico": "לִימִ֣ין", "transliteral": "lî-mîn", "traducao_palavra": "à direita de" },
        { "hebraico": "אֶבְיֹ֑ון", "transliteral": "ʾeḇ-yôn", "traducao_palavra": "[do] necessitado" },
        { "hebraico": "לְ֝הֹושִׁ֗יעַ", "transliteral": "lə-hô-šî-aʿ", "traducao_palavra": "para salvar" },
        { "hebraico": "מִשֹּׁפְטֵ֥י", "transliteral": "miš-šō-p̄ə-ṭê", "traducao_palavra": "dos juízes/condenadores de" },
        { "hebraico": "נַפְשֹֽׁו׃", "transliteral": "nap̄-šô", "traducao_palavra": "alma dele" }
      ]
    }
