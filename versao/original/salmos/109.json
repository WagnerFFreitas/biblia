      ]
    },
    "7": {
      "traducao_completa": "Quando for julgado, saia condenado; e a sua oração se lhe torne em pecado.",
      "palavras": [
        { "hebraico": "בְּ֭הִשָּׁפְטֹו", "transliteral": "bə-hiš-šā-p̄ə-ṭô", "traducao_palavra": "no ser ele julgado" },
        { "hebraico": "יֵצֵ֣א", "transliteral": "yē-ṣē", "traducao_palavra": "saia" },
        { "hebraico": "רָשָׁ֑ע", "transliteral": "rā-šāʿ", "traducao_palavra": "[como] culpado" },
        { "hebraico": "וּ֝תְפִלָּתֹ֗ו", "transliteral": "ū-ṯə-p̄il-lā-ṯô", "traducao_palavra": "e a oração dele" },
        { "hebraico": "תִּהְיֶ֥ה", "transliteral": "tih-yeh", "traducao_palavra": "torne-se/seja" },
        { "hebraico": "לַחֲטָאָֽה׃", "transliteral": "la-ḥă-ṭā-ʾā", "traducao_palavra": "em pecado" }
      ]
    },
    "8": {
      "traducao_completa": "Sejam poucos os seus dias, e outro tome o seu encargo.",
      "palavras": [
        { "hebraico": "יִֽהְיוּ־", "transliteral": "yih-yû-", "traducao_palavra": "sejam" },
        { "hebraico": "יָמָ֥יו", "transliteral": "yā-māyw", "traducao_palavra": "dias dele" },
        { "hebraico": "מְעַטִּ֑ים", "transliteral": "mə-ʿaṭ-ṭîm", "traducao_palavra": "poucos" },
        { "hebraico": "פְּקֻדָּתֹ֗ו", "transliteral": "pə-qud-dā-ṯô", "traducao_palavra": "o encargo dele/ofício" },
        { "hebraico": "יִקַּ֥ח", "transliteral": "yiq-qaḥ", "traducao_palavra": "tome" },
