{
  "livro": "Salmos - תְּהִלִּים - Tehillim",
  "capítulo": 109,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Ó Deus do meu louvor, não te cales;",
      "palavras": [
        { "hebraico": "אֱלֹהֵ֥י", "transliteral": "ʾĕ-lō-hê", "traducao_palavra": "Deus de" },
        { "hebraico": "תְ֝הִלָּתִ֗י", "transliteral": "ṯə-hil-lā-ṯî", "traducao_palavra": "meu louvor" },
        { "hebraico": "אַֽל־", "transliteral": "ʾal-", "traducao_palavra": "não" },
        { "hebraico": "תֶּחֱרַֽשׁ׃", "transliteral": "te-ḥĕ-raš", "traducao_palavra": "te cales" }
      ]
    },
    "2": {
      "traducao_completa": "Pois a boca do ímpio e a boca do enganador se abriram contra mim; falaram contra mim com uma língua mentirosa.",
      "palavras": [
        { "hebraico": "כִּ֤י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "פִ֘י", "transliteral": "p̄î", "traducao_palavra": "boca de" },
        { "hebraico": "רָשָׁ֨ע", "transliteral": "rā-šāʿ", "traducao_palavra": "ímpio" },
        { "hebraico": "וּֽפִי־", "transliteral": "ū-p̄î-", "traducao_palavra": "e boca de" },
        { "hebraico": "מִ֭רְמָה", "transliteral": "mir-mā", "traducao_palavra": "engano" },
        { "hebraico": "עָלַ֣י", "transliteral": "ʿā-lay", "traducao_palavra": "contra mim" },
        { "hebraico": "פָּתָ֑חוּ", "transliteral": "pā-ṯā-ḥû", "traducao_palavra": "abriram" },
        { "hebraico": "דִּבְּר֥וּ", "transliteral": "dib-bə-rû", "traducao_palavra": "falaram" },
        { "hebraico": "אִ֝תִּ֗י", "transliteral": "ʾit-tî", "traducao_palavra": "comigo" },
        { "hebraico": "לְשֹׁ֣ון", "transliteral": "lə-šôn", "traducao_palavra": "[com] língua de" },
        { "hebraico": "שָֽׁקֶר׃", "transliteral": "šā-qer", "traducao_palavra": "mentira" }
      ]
    },
    "3": {
      "traducao_completa": "Cercaram-me com palavras de ódio e pelejaram contra mim sem causa.",
      "palavras": [
        { "hebraico": "וְדִבְרֵי", "transliteral": "wə-ḏiḇ-rê", "traducao_palavra": "e [com] palavras de" },
        { "hebraico": "שִׂנְאָ֥ה", "transliteral": "śin-ʾā", "traducao_palavra": "ódio" },
        { "hebraico": "סְבָב֑וּנִי", "transliteral": "śə-ḇā-ḇû-nî", "traducao_palavra": "cercaram-me" },
        { "hebraico": "וַיִּֽלָּחֲמ֥וּ", "transliteral": "way-yil-lā-ḥă-mû", "traducao_palavra": "e pelejaram" },
        { "hebraico": "עִמִּ֥י", "transliteral": "ʿim-mî", "traducao_palavra": "comigo" },
        { "hebraico": "חִנָּֽם׃", "transliteral": "ḥin-nām", "traducao_palavra": "sem causa" }
      ]
    },
    "4": {
      "traducao_completa": "Em recompensa do meu amor, são meus adversários; mas eu entrego-me à oração.",
      "palavras": [
        { "hebraico": "תַּחַת־", "transliteral": "ta-ḥaṯ-", "traducao_palavra": "em lugar de/em troca de" },
        { "hebraico": "אַהֲבָתִ֥י", "transliteral": "ʾa-hă-ḇā-ṯî", "traducao_palavra": "meu amor" },
        { "hebraico": "יִשְׂטְנ֥וּנִי", "transliteral": "yiś-ṭə-nû-nî", "traducao_palavra": "eles me acusam/são adversários" },
        { "hebraico": "וַאֲנִ֥י", "transliteral": "wa-ʾă-nî", "traducao_palavra": "mas eu [sou]" },
