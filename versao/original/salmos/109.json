        { "hebraico": "בָנָ֥יו", "transliteral": "ḇā-nāyw", "traducao_palavra": "filhos dele" },
        { "hebraico": "יְתֹומִ֑ים", "transliteral": "yə-ṯô-mîm", "traducao_palavra": "órfãos" },
        { "hebraico": "וְ֝אִשְׁתֹּ֗ו", "transliteral": "wə-ʾiš-tô", "traducao_palavra": "e mulher dele" },
        { "hebraico": "אַלְמָנָֽה׃", "transliteral": "ʾal-mā-nā", "traducao_palavra": "viúva" }
      ]
    },
    "10": {
      "traducao_completa": "Andem errantes os seus filhos e mendiguem; e busquem o seu pão longe das suas casas assoladas.",
