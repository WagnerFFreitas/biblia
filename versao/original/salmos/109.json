    "12": {
      "traducao_completa": "Não haja ninguém que se compadeça dele, nem haja quem favoreça os seus órfãos.",
      "palavras": [
        { "hebraico": "אַל־", "transliteral": "ʾal-", "traducao_palavra": "não" },
        { "hebraico": "יְהִי־", "transliteral": "yə-hî-", "traducao_palavra": "haja" },
        { "hebraico": "לֹ֭ו", "transliteral": "lô", "traducao_palavra": "para ele" },
