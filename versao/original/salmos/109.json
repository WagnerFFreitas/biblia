        { "hebraico": "חָ֥סֶד", "transliteral": "ḥā-śeḏ", "traducao_palavra": "misericórdia" },
        { "hebraico": "וַיִּרְדֹּ֡ף", "transliteral": "way-yir-dōp̄", "traducao_palavra": "e perseguiu" },
