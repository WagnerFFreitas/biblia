        { "hebraico": "וַיֶּאֱהַ֣ב", "transliteral": "way-ye-ʾĕ-haḇ", "traducao_palavra": "e amou" },
        { "hebraico": "קְ֭לָלָה", "transliteral": "qə-lā-lā", "traducao_palavra": "[a] maldição" },
        { "hebraico": "וַתְּבֹואֵ֑הוּ", "transliteral": "wat-tə-ḇô-ʾê-hû", "traducao_palavra": "e veio a ele" },
        { "hebraico": "וְֽלֹא־", "transliteral": "wə-lō-", "traducao_palavra": "e não" },
        { "hebraico": "חָפֵ֥ץ", "transliteral": "ḥā-p̄ēṣ", "traducao_palavra": "desejou" },
        { "hebraico": "בִּ֝בְרָכָ֗ה", "transliteral": "biḇ-rā-ḵā", "traducao_palavra": "a bênção" },
