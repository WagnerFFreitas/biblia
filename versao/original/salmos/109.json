        { "hebraico": "חֹ֝ונֵ֗ן", "transliteral": "ḥô-nên", "traducao_palavra": "favorecendo/tendo graça" },
        { "hebraico": "לִיתֹומָֽיו׃", "transliteral": "lî-ṯô-māyw", "traducao_palavra": "aos seus órfãos" }
      ]
    },
    "13": {
      "traducao_completa": "Seja a sua posteridade exterminada; na geração seguinte se apague o seu nome.",
