        { "hebraico": "תַּסְתֵּר", "transliteral": "tas-tēr", "traducao_palavra": "escondas" },
        { "hebraico": "פָּנֶיךָ", "transliteral": "pā-ne-ḵā", "traducao_palavra": "tua face" },
        { "hebraico": "מִמֶּנִּי", "transliteral": "mim-men-nî", "traducao_palavra": "de mim" },
        { "hebraico": "בְּיֹום", "transliteral": "bə-yôm", "traducao_palavra": "no dia de" },
        { "hebraico": "צַר", "transliteral": "ṣar", "traducao_palavra": "angústia" },
        { "hebraico": "לִ֑י", "transliteral": "lî", "traducao_palavra": "para mim" },
        { "hebraico": "הַטֵּה־", "transliteral": "haṭ-ṭēh-", "traducao_palavra": "inclina" },
        { "hebraico": "אֵלַי", "transliteral": "ʾē-lay", "traducao_palavra": "para mim" },
        { "hebraico": "אָזְנְךָ", "transliteral": "ʾāz-nə-ḵā", "traducao_palavra": "teu ouvido" },
        { "hebraico": "בְּיֹום", "transliteral": "bə-yôm", "traducao_palavra": "no dia [em que]" },
        { "hebraico": "אֶקְרָא", "transliteral": "ʾeq-rā", "traducao_palavra": "eu clamar" },
        { "hebraico": "מַ֝הֵר", "transliteral": "ma-hēr", "traducao_palavra": "depressa" },
        { "hebraico": "עֲנֵֽנִי׃", "transliteral": "ʿă-nē-nî", "traducao_palavra": "responde-me" }
      ]
    },
    "3": {
      "traducao_completa": "Porque os meus dias se consumiram como fumaça, e os meus ossos ardem como um tição.",
      "palavras": [
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "porque" },
        { "hebraico": "כָל֬וּ", "transliteral": "ḵā-lû", "traducao_palavra": "consumiram-se" },
        { "hebraico": "בְעָשָׁ֣ן", "transliteral": "ḇə-ʿā-šān", "traducao_palavra": "em fumaça" },
        { "hebraico": "יָמָ֑י", "transliteral": "yā-māy", "traducao_palavra": "meus dias" },
        { "hebraico": "וְ֝עַצְמֹותַ֗י", "transliteral": "wə-ʿaṣ-mô-ṯay", "traducao_palavra": "e meus ossos" },
        { "hebraico": "כְּמֹוקֵ֥ד", "transliteral": "kə-mô-qēḏ", "traducao_palavra": "como um braseiro/tição" },
