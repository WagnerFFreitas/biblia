        { "hebraico": "לְפָנֶ֥יךָ", "transliteral": "ləp̄āneyḵā", "traducao_palavra": "diante de ti" },
        { "hebraico": "יִכֹּֽון׃", "transliteral": "yikkôn", "traducao_palavra": "será estabelecida" }
