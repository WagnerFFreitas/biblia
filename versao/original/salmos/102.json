        { "hebraico": "כַּלֶּ֣חֶם", "transliteral": "kal-le-ḥem", "traducao_palavra": "como pão" },
        { "hebraico": "אָכָ֑לְתִּי", "transliteral": "ʾā-ḵāl-tî", "traducao_palavra": "comi" },
        { "hebraico": "וְ֝שִׁקֻּוַ֗י", "transliteral": "wə-šiq-qu-way", "traducao_palavra": "e minha bebida" },
        { "hebraico": "בִּבְכִ֥י", "transliteral": "biḇ-ḵî", "traducao_palavra": "com choro" },
        { "hebraico": "מָסָֽכְתִּי׃", "transliteral": "mā-śāḵ-tî", "traducao_palavra": "misturei" }
      ]
