        { "hebraico": "מִדְבָּ֑ר", "transliteral": "miḏ-bār", "traducao_palavra": "deserto" },
        { "hebraico": "הָ֝יִ֗יתִי", "transliteral": "hā-yî-ṯî", "traducao_palavra": "eu fui/tornei-me" },
        { "hebraico": "כְּכֹ֣וס", "transliteral": "kə-ḵôś", "traducao_palavra": "como a coruja de" },
