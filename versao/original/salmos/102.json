        { "hebraico": "לְדֹ֣ור", "transliteral": "ləḏôr", "traducao_palavra": "para geração" },
        { "hebraico": "אַחֲרֹ֑ון", "transliteral": "ʾaḥărôn", "traducao_palavra": "posterior/futura" },
        { "hebraico": "וְעַ֥ם", "transliteral": "wəʿam", "traducao_palavra": "e povo" },
