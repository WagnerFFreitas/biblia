    "8": {
      "traducao_completa": "Os meus inimigos me afrontam todo o dia; os que se enfurecem contra mim, juram contra mim.",
      "palavras": [
        { "hebraico": "כָּל־", "transliteral": "kāl-", "traducao_palavra": "todo" },
        { "hebraico": "הַ֭יֹּום", "transliteral": "hay-yôm", "traducao_palavra": "o dia" },
        { "hebraico": "חֵרֲפ֣וּנִי", "transliteral": "ḥē-ră-p̄û-nî", "traducao_palavra": "afrontaram me" },
        { "hebraico": "אֹויְבָ֑י", "transliteral": "ʾô-yə-ḇāy", "traducao_palavra": "meus inimigos" },
        { "hebraico": "מְהֹולָלַי", "transliteral": "mə-hô-lā-lay", "traducao_palavra": "os que me ridicularizam/enfurecem" },
