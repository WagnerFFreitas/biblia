        { "hebraico": "מֵאֲכֹ֥ל", "transliteral": "mē-ʾă-ḵōl", "traducao_palavra": "de comer" },
        { "hebraico": "לַחְמִֽי׃", "transliteral": "laḥ-mî", "traducao_palavra": "meu pão" }
      ]
    },
    "5": {
      "traducao_completa": "Por causa da voz do meu gemido, os meus ossos se pegam à minha pele.",
      "palavras": [
        { "hebraico": "מִקֹּ֥ול", "transliteral": "miq-qôl", "traducao_palavra": "pela voz de" },
        { "hebraico": "אַנְחָתִ֑י", "transliteral": "ʾan-ḥā-ṯî", "traducao_palavra": "meu gemido" },
