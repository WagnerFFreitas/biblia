        { "hebraico": "יֹאבֵדוּ֮", "transliteral": "yōʾḇēḏû", "traducao_palavra": "perecerão" },
        { "hebraico": "וְאַתָּ֪ה", "transliteral": "wəʾattā", "traducao_palavra": "mas tu" },
        { "hebraico": "תַ֫עֲמֹ֥ד", "transliteral": "ṯaʿămōḏ", "traducao_palavra": "permanecerás" },
        { "hebraico": "וְ֝כֻלָּ֗ם", "transliteral": "wəḵullām", "traducao_palavra": "e todos eles" },
        { "hebraico": "כַּבֶּ֥גֶד", "transliteral": "kabbeḡeḏ", "traducao_palavra": "como a veste" },
        { "hebraico": "יִבְל֑וּ", "transliteral": "yiḇlû", "traducao_palavra": "envelhecerão" },
