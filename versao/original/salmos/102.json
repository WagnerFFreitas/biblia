{
  "livro": "Salmos - תְּהִלִּים - Tehillim",
  "capítulo": 102,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "YHWH, ouve a minha oração, e chegue a ti o meu clamor.",
      "palavras": [
        { "hebraico": "יְהוָה", "transliteral": "yəhwāh", "traducao_palavra": "YHWH" },
        { "hebraico": "שִׁמְעָה", "transliteral": "šim-ʿā", "traducao_palavra": "ouve" },
        { "hebraico": "תְפִלָּתִי", "transliteral": "ṯə-p̄il-lā-ṯî", "traducao_palavra": "minha oração" },
        { "hebraico": "וְשַׁוְעָתִי", "transliteral": "wə-šaw-ʿā-ṯî", "traducao_palavra": "e meu clamor" },
        { "hebraico": "אֵלֶיךָ", "transliteral": "ʾê-le-ḵā", "traducao_palavra": "a ti" },
        { "hebraico": "תָבֹוא׃", "transliteral": "ṯā-ḇô", "traducao_palavra": "venha/chegue" }
      ]
    },
    "2": {
      "traducao_completa": "Não escondas de mim o teu rosto no dia da minha angústia; inclina para mim o teu ouvido; no dia em que eu clamar, responde-me depressa.",
