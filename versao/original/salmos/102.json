      ]
    },
    "7": {
      "traducao_completa": "Vigio, e sou como o passarinho solitário no telhado.",
      "palavras": [
        { "hebraico": "שָׁקַ֥דְתִּי", "transliteral": "šā-qaḏ-tî", "traducao_palavra": "vigiei" },
