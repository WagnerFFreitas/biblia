        { "hebraico": "תַּחֲלִיפֵ֣ם", "transliteral": "ṯaḥălîp̄ēm", "traducao_palavra": "tu os mudarás" },
        { "hebraico": "וְֽיַחֲלֹֽפוּ׃", "transliteral": "wəyaḥălōp̄û", "traducao_palavra": "e eles passarão/serão mudados" }
      ]
    },
    "27": {
      "traducao_completa": "Mas tu és o mesmo, e os teus anos não findarão.",
