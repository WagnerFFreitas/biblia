      ]
    },
    "4": {
      "traducao_completa": "O meu coração está ferido e seco como a erva, pelo que até me esqueço de comer o meu pão.",
      "palavras": [
        { "hebraico": "הוּכָּֽה־", "transliteral": "hû-kā-", "traducao_palavra": "foi ferido" },
        { "hebraico": "כָ֭עֵשֶׂב", "transliteral": "ḵā-ʿē-śeḇ", "traducao_palavra": "como a erva" },
        { "hebraico": "וַיִּיבַ֣שׁ", "transliteral": "way-yî-ḇaš", "traducao_palavra": "e secou" },
