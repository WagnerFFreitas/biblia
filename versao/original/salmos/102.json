      ]
    },
    "6": {
      "traducao_completa": "Sou semelhante ao pelicano no deserto; sou como a coruja das ruínas.",
      "palavras": [
        { "hebraico": "דָּ֭מִיתִי", "transliteral": "dā-mî-ṯî", "traducao_palavra": "assemelhei-me" },
