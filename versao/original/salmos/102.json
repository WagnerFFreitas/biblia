        { "hebraico": "וְקֶצְפֶּ֑ךָ", "transliteral": "wə-qeṣ-pe-ḵā", "traducao_palavra": "e tua ira" },
        { "hebraico": "כִּ֥י", "transliteral": "kî", "traducao_palavra": "pois" },
        { "hebraico": "נְ֝שָׂאתַ֗נִי", "transliteral": "nə-śā-ṯa-nî", "traducao_palavra": "tu me levantaste" },
        { "hebraico": "וַתַּשְׁלִיכֵֽנִי׃", "transliteral": "wat-taš-lî-ḵê-nî", "traducao_palavra": "e me arremessaste" }
      ]
