        { "hebraico": "נִשְׁבָּֽעוּ׃", "transliteral": "niš-bā-ʿû", "traducao_palavra": "juraram" }
      ]
    },
    "9": {
      "traducao_completa": "Pois tenho comido cinza como pão, e misturado com lágrimas a minha bebida,",
      "palavras": [
        { "hebraico": "כִּי־", "transliteral": "kî-", "traducao_palavra": "porque" },
