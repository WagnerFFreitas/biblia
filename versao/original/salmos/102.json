        { "hebraico": "אַתָּ֣ה", "transliteral": "ʾat-tā", "traducao_palavra": "tu" },
        { "hebraico": "תָ֭קוּם", "transliteral": "tā-qûm", "traducao_palavra": "levantarás" },
