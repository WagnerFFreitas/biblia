        { "hebraico": "הָאָ֣רֶץ", "transliteral": "hāʾāreṣ", "traducao_palavra": "[a] terra" },
        { "hebraico": "יָ֓סַדְתָּ", "transliteral": "yāśaḏtā", "traducao_palavra": "fundaste" },
