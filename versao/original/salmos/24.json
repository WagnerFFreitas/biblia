    "4": {
      "traducao_completa": "Aquele que é limpo de mãos e puro de coração, que não entrega a sua alma à vaidade, nem jura enganosamente.",
      "palavras": [
        { "hebraico": "נְקִ֨י", "transliteral": "nə-qî", "traducao_palavra": "limpo de" },
        { "hebraico": "כַפַּ֜יִם", "transliteral": "ḵap-pa-yim", "traducao_palavra": "mãos" },
        { "hebraico": "וּבַר־לֵבָ֗ב", "transliteral": "ū-ḇar-lē-ḇāḇ", "traducao_palavra": "e puro de coração" },
        { "hebraico": "אֲשֶׁ֤ר ׀", "transliteral": "ʾă-šer", "traducao_palavra": "que" },
        { "hebraico": "לֹא־נָשָׂ֣א", "transliteral": "lō-nā-śā", "traducao_palavra": "não levantou/entregou" },
