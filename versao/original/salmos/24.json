        { "hebraico": "מִזְמֹ֥ור", "transliteral": "miz-môr", "traducao_palavra": "salmo" },
        { "hebraico": "לַֽ֭יהוָה", "transliteral": "lay-hwāh", "traducao_palavra": "de/pertence a YHWH" },
        { "hebraico": "הָאָ֣רֶץ", "transliteral": "hā-ʾā-reṣ", "traducao_palavra": "a terra" },
        { "hebraico": "וּמְלֹואָ֑הּ", "transliteral": "ū-mə-lô-ʾāh", "traducao_palavra": "e a sua plenitude" },
        { "hebraico": "תֵּ֝בֵ֗ל", "transliteral": "tē-ḇēl", "traducao_palavra": "[o] mundo" },
        { "hebraico": "וְיֹ֣שְׁבֵי", "transliteral": "wə-yō-šə-ḇê", "traducao_palavra": "e os habitantes de" },
        { "hebraico": "בָֽהּ׃", "transliteral": "ḇāh", "traducao_palavra": "nele" }
      ]
    },
    "2": {
      "traducao_completa": "Porque ele a fundou sobre os mares e a estabeleceu sobre os rios.",
