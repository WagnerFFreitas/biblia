        { "hebraico": "עַל־יַמִּ֣ים", "transliteral": "ʿal-yam-mîm", "traducao_palavra": "sobre mares" },
        { "hebraico": "יְסָדָ֑הּ", "transliteral": "yə-śā-ḏāh", "traducao_palavra": "a fundou" },
        { "hebraico": "וְעַל־נְ֝הָרֹ֗ות", "transliteral": "wə-ʿal-nə-hā-rôṯ", "traducao_palavra": "e sobre rios" },
        { "hebraico": "יְכֹונְנֶֽהָ׃", "transliteral": "yə-ḵô-nə-ne-hā", "traducao_palavra": "a estabeleceu/firmou" }
      ]
    },
    "3": {
      "traducao_completa": "Quem subirá ao monte de YHWH? E quem estará no seu santo lugar?",
      "palavras": [
        { "hebraico": "מִֽי־יַעֲלֶ֥ה", "transliteral": "mî-ya-ʿă-leh", "traducao_palavra": "quem subirá" },
        { "hebraico": "בְהַר־יְהוָ֑ה", "transliteral": "ḇə-har-YHWH", "traducao_palavra": "no monte de YHWH" },
        { "hebraico": "וּמִי־יָ֝ק֗וּם", "transliteral": "ū-mî-yā-qûm", "traducao_palavra": "e quem se levantará/estará" },
        { "hebraico": "בִּמְקֹ֥ום", "transliteral": "bim-qôm", "traducao_palavra": "no lugar de" },
