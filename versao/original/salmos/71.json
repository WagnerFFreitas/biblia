        { "hebraico": "וּמִתְּהֹמֹ֥ות", "transliteral": "ū-mit-tə-hō-môṯ", "traducao_palavra": "e das profundezas de" },
        { "hebraico": "הָאָ֗רֶץ", "transliteral": "hā-ʾā-reṣ", "traducao_palavra": "a terra" },
        { "hebraico": "תָּשׁ֥וּב", "transliteral": "tā-šûḇ", "traducao_palavra": "voltarás" },
        { "hebraico": "תַּעֲלֵֽנִי׃", "transliteral": "ta-ʿă-lē-nî", "traducao_palavra": "subirás me" }
