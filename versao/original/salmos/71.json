        { "hebraico": "בִכְלִי־", "transliteral": "ḇiḵ-lî-", "traducao_palavra": "com instrumento de" },
        { "hebraico": "נֶבֶל֮", "transliteral": "ne-ḇel", "traducao_palavra": "saltério/lira" },
        { "hebraico": "אֲמִתְּךָ֪", "transliteral": "ʾă-mit-tə-ḵā", "traducao_palavra": "tua verdade" },
        { "hebraico": "אֱלֹ֫הָ֥י", "transliteral": "ʾĕ-lō-hāy", "traducao_palavra": "Deus meu" },
