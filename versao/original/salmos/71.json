        { "hebraico": "אַגִּ֥יד", "transliteral": "ʾag-gîḏ", "traducao_palavra": "anuncio" },
        { "hebraico": "נִפְלְאֹותֶֽיךָ׃", "transliteral": "nip̄-lə-ʾô-ṯe-ḵā", "traducao_palavra": "tuas maravilhas" }
