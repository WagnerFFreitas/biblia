        { "hebraico": "תַּעַזְבֵ֫נִי", "transliteral": "ta-ʿaz-ḇê-nî", "traducao_palavra": "abandones me" },
        { "hebraico": "עַד־", "transliteral": "ʿaḏ-", "traducao_palavra": "até que" },
        { "hebraico": "אַגִּ֖יד", "transliteral": "ʾag-gîḏ", "traducao_palavra": "eu anuncie" },
        { "hebraico": "זְרֹועֲךָ֣", "transliteral": "zə-rô-ʿă-ḵā", "traducao_palavra": "tua força/braço" },
        { "hebraico": "לְדֹ֑ור", "transliteral": "lə-ḏôr", "traducao_palavra": "a [esta] geração" },
        { "hebraico": "לְכָל־", "transliteral": "lə-ḵāl-", "traducao_palavra": "a todo" },
        { "hebraico": "יָ֝בֹ֗וא", "transliteral": "yā-ḇô", "traducao_palavra": "[que] virá" },
        { "hebraico": "גְּבוּרָתֶֽךָ׃", "transliteral": "gə-ḇû-rā-ṯe-ḵā", "traducao_palavra": "teu poder" }
      ]
