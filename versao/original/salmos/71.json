        { "hebraico": "רַבֹּ֗ות", "transliteral": "rab-bôṯ", "traducao_palavra": "muitas" },
        { "hebraico": "וְרָ֫עֹ֥ות", "transliteral": "wə-rā-ʿôṯ", "traducao_palavra": "e más/graves" },
        { "hebraico": "תָּשׁ֥וּב", "transliteral": "tā-šûḇ", "traducao_palavra": "voltarás" },
