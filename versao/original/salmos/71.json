    "19": {
      "traducao_completa": "A tua justiça, ó Deus, está muito no alto, pois fizeste grandes coisas. Ó Deus, quem é semelhante a ti?",
      "palavras": [
        { "hebraico": "וְצִדְקָתְךָ֥", "transliteral": "wə-ṣiḏ-qā-ṯə-ḵā", "traducao_palavra": "e tua justiça" },
        { "hebraico": "אֱלֹהִ֗ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "ó Deus" },
        { "hebraico": "עַד־", "transliteral": "ʿaḏ-", "traducao_palavra": "até" },
        { "hebraico": "מָ֫רֹ֥ום", "transliteral": "mā-rôm", "traducao_palavra": "[o] alto" },
        { "hebraico": "אֲשֶׁר־", "transliteral": "ʾă-šer-", "traducao_palavra": "que" },
        { "hebraico": "עָשִׂ֥יתָ", "transliteral": "ʿā-śî-ṯā", "traducao_palavra": "fizeste" },
        { "hebraico": "גְדֹלֹ֑ות", "transliteral": "ḡə-ḏō-lôṯ", "traducao_palavra": "grandezas" },
        { "hebraico": "אֱ֝לֹהִ֗ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "ó Deus" },
