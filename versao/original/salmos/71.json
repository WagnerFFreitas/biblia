        { "hebraico": "זִקְנָ֨ה ׀", "transliteral": "ziq-nā", "traducao_palavra": "velhice" },
        { "hebraico": "וְשֵׂיבָה֮", "transliteral": "wə-śê-ḇā", "traducao_palavra": "e cabelos brancos" },
