{
  "livro": "Salmos - תְּהִלִּים - Tehillim",
  "capítulo": 43,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Julga-me, ó Deus, e pleiteia a minha causa contra uma nação ímpia; livra-me do homem fraudulento e injusto.",
      "palavras": [
        { "hebraico": "שָׁפְטֵ֤נִי", "transliteral": "šā-p̄ə-ṭē-nî", "traducao_palavra": "julga-me" },
        { "hebraico": "אֱלֹהִ֨ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "ó Deus" },
        { "hebraico": "וְרִ֘יבָ֤ה", "transliteral": "wə-rî-ḇā", "traducao_palavra": "e pleiteia/defende" },
        { "hebraico": "רִיבִ֗י", "transliteral": "rî-ḇî", "traducao_palavra": "minha causa" },
        { "hebraico": "מִגֹּ֥וי", "transliteral": "mig-gôy", "traducao_palavra": "de/contra nação" },
        { "hebraico": "לֹא־חָסִ֑יד", "transliteral": "lō-ḥā-śîḏ", "traducao_palavra": "não piedosa/ímpia" },
        { "hebraico": "מֵאִישׁ־מִרְמָ֖ה", "transliteral": "mē-ʾîš-mir-mā", "traducao_palavra": "do homem de engano" },
        { "hebraico": "וְעַוְלָ֣ה", "transliteral": "wə-ʿaw-lā", "traducao_palavra": "e perversidade/injustiça" },
        { "hebraico": "תְפַלְּטֵֽנִי׃", "transliteral": "tə-p̄al-lə-ṭē-nî", "traducao_palavra": "livra-me" }
      ]
    },
    "2": {
      "traducao_completa": "Pois tu és o Deus da minha fortaleza; por que me rejeitaste? Por que ando lamentando sob a opressão do inimigo?",
      "palavras": [
        { "hebraico": "כִּֽי־אַתָּה֮", "transliteral": "kî-ʾat-tā", "traducao_palavra": "pois tu [és]" },
        { "hebraico": "אֱלֹהֵ֪י", "transliteral": "ʾĕ-lō-hê", "traducao_palavra": "o Deus de" },
        { "hebraico": "מָֽעֳזִּ֥י", "transliteral": "mā-ʿo-zî", "traducao_palavra": "minha fortaleza/força" },
        { "hebraico": "לָמָ֪ה", "transliteral": "lā-mā", "traducao_palavra": "por que" },
        { "hebraico": "זְנַ֫חְתָּ֥נִי", "transliteral": "zə-naḥ-tā-nî", "traducao_palavra": "me rejeitaste/abandonaste" },
        { "hebraico": "לָֽמָּה־קֹדֵ֥ר", "transliteral": "lām-mā-qō-ḏēr", "traducao_palavra": "por que sombrio/em luto" },
        { "hebraico": "אֶתְהַלֵּ֗ךְ", "transliteral": "ʾeṯ-hal-lēḵ", "traducao_palavra": "andarei eu" },
        { "hebraico": "בְּלַ֣חַץ", "transliteral": "bə-la-ḥaṣ", "traducao_palavra": "pela opressão de" },
        { "hebraico": "אֹויֵֽב׃", "transliteral": "ʾô-yēḇ", "traducao_palavra": "inimigo" }
      ]
    },
    "3": {
      "traducao_completa": "Envia a tua luz e a tua verdade, para que me guiem e me levem ao teu santo monte, e às tuas moradas.",
      "palavras": [
        { "hebraico": "שְׁלַח־אֹורְךָ֣", "transliteral": "šə-laḥ-ʾôr-ḵā", "traducao_palavra": "envia tua luz" },
        { "hebraico": "וַ֭אֲמִתְּךָ", "transliteral": "wa-ʾă-mit-tə-ḵā", "traducao_palavra": "e tua verdade" },
        { "hebraico": "הֵ֣מָּה", "transliteral": "hēm-mā", "traducao_palavra": "elas" },
        { "hebraico": "יַנְח֑וּנִי", "transliteral": "yan-ḥû-nî", "traducao_palavra": "me guiarão" },
        { "hebraico": "יְבִיא֥וּנִי", "transliteral": "yə-ḇî-ʾû-nî", "traducao_palavra": "me levarão" },
        { "hebraico": "אֶל־הַר־קָ֝דְשְׁךָ֗", "transliteral": "ʾel-har-qā-ḏə-šə-ḵā", "traducao_palavra": "ao monte da tua santidade" },
        { "hebraico": "וְאֶל־מִשְׁכְּנֹותֶֽיךָ׃", "transliteral": "wə-ʾel-miš-kə-nô-ṯe-ḵā", "traducao_palavra": "e às tuas moradas/tabernáculos" }
      ]
    },
    "4": {
      "traducao_completa": "Então irei ao altar de Deus, a Deus, que é a minha grande alegria; e com harpa te louvarei, ó Deus, Deus meu.",
      "palavras": [
        { "hebraico": "וְאָבֹ֤ואָה", "transliteral": "wə-ʾā-ḇô-ʾā", "traducao_palavra": "e entrarei/irei" },
        { "hebraico": "אֶל־מִזְבַּ֬ח", "transliteral": "ʾel-miz-baḥ", "traducao_palavra": "ao altar de" },
        { "hebraico": "אֱלֹהִ֗ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "Deus" },
        { "hebraico": "אֶל־אֵ֥ל", "transliteral": "ʾel-ʾēl", "traducao_palavra": "ao Deus [de]" },
        { "hebraico": "שִׂמְחַ֣ת", "transliteral": "śim-ḥaṯ", "traducao_palavra": "alegria de" },
        { "hebraico": "גִּילִ֑י", "transliteral": "gî-lî", "traducao_palavra": "meu júbilo/exultação" },
        { "hebraico": "וְאֹודְךָ֥", "transliteral": "wə-ʾô-ḏə-ḵā", "traducao_palavra": "e te louvarei" },
        { "hebraico": "בְכִנֹּ֗ור", "transliteral": "bə-ḵin-nôr", "traducao_palavra": "com harpa/lira" },
        { "hebraico": "אֱלֹהִ֥ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "Deus" },
        { "hebraico": "אֱלֹהָֽי׃", "transliteral": "ʾĕ-lō-hāy", "traducao_palavra": "meu Deus" }
      ]
    },
    "5": {
      "traducao_completa": "Por que estás abatida, ó minha alma? E por que te perturbas dentro de mim? Espera em Deus, pois ainda o louvarei; ele é a salvação da minha face e o meu Deus.",
      "palavras": [
        { "hebraico": "מַה־תִּשְׁתֹּ֬וחֲחִי", "transliteral": "mah-tiš-tô-ḥă-ḥî", "traducao_palavra": "por que te abates" },
        { "hebraico": "נַפְשִׁי֮", "transliteral": "nap̄-šî", "traducao_palavra": "minha alma" },
        { "hebraico": "וּֽמַה־תֶּהֱמִ֪i", "transliteral": "ū-mah-te-hĕ-mî", "traducao_palavra": "e por que te inquietas" },
        { "hebraico": "עָ֫לָ֥י", "transliteral": "ʿā-lāy", "traducao_palavra": "dentro de mim" },
        { "hebraico": "הֹוחִ֣ילִי", "transliteral": "hô-ḥî-lî", "traducao_palavra": "espera" },
        { "hebraico": "לֵ֭אלֹהִים", "transliteral": "lê-lō-hîm", "traducao_palavra": "em Deus" },
        { "hebraico": "כִּy־עֹ֥וד", "transliteral": "kî-ʿôḏ", "traducao_palavra": "pois ainda" },
        { "hebraico": "אֹ֝ודֶ֗נּוּ", "transliteral": "ʾô-ḏen-nû", "traducao_palavra": "eu o louvarei" },
        { "hebraico": "יְשׁוּעֹ֥ת", "transliteral": "yə-šû-ʿōṯ", "traducao_palavra": "[a] salvação de" },
        { "hebraico": "פָּ֝נַ֗י", "transliteral": "pā-nay", "traducao_palavra": "minha face" },
        { "hebraico": "וֵֽאלֹהָֽי׃", "transliteral": "wê-lō-hāy", "traducao_palavra": "e meu Deus" }
      ]
    }
  }
}