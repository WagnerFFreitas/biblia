        { "hebraico": "אֵ֪ין", "transliteral": "ʾên", "traducao_palavra": "não há" },
        { "hebraico": "אֱלֹ֫הִ֥ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "Deus" },
        { "hebraico": "הִֽשְׁחִ֡יתוּ", "transliteral": "hiš-ḥî-ṯû", "traducao_palavra": "corromperam-se" },
