        { "hebraico": "עָ֗וֶל", "transliteral": "ʿā-wel", "traducao_palavra": "a iniquidade/injustiça" },
        { "hebraico": "אֵ֣ין", "transliteral": "ʾên", "traducao_palavra": "não há" },
        { "hebraico": "עֹֽשֵׂה־טֹֽוב׃", "transliteral": "ʿō-śēh-ṭôḇ", "traducao_palavra": "quem faça o bem" }
