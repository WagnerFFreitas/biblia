  "versiculos": {
    "1": {
      "traducao_completa": "De Davi. A ti, YHWH, levanto a minha alma.",
      "palavras": [
        { "hebraico": "לְדָוִ֨ד", "transliteral": "lə-ḏā-wiḏ", "traducao_palavra": "de Davi" },
