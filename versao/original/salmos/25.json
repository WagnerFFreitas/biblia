        { "hebraico": "כָּל־קֹ֭וֶיךָ", "transliteral": "kāl-qô-we-ḵā", "traducao_palavra": "todos os que esperam em ti" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "יֵבֹ֑שׁוּ", "transliteral": "yē-ḇō-šû", "traducao_palavra": "serão envergonhados" },
        { "hebraico": "יֵ֝בֹ֗שׁוּ", "transliteral": "yē-ḇō-šû", "traducao_palavra": "serão envergonhados" },
