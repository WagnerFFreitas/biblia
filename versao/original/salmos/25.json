    "2": {
      "traducao_completa": "Deus meu, em ti confio; não me deixes ser envergonhado, não se alegrem os meus inimigos sobre mim.",
      "palavras": [
        { "hebraico": "אֱלֹהַי֮", "transliteral": "ʾĕ-lō-hay", "traducao_palavra": "Deus meu" },
        { "hebraico": "בְּךָ֥", "transliteral": "bə-ḵā", "traducao_palavra": "em ti" },
        { "hebraico": "בָטַ֗חְתִּי", "transliteral": "ḇā-ṭaḥ-tî", "traducao_palavra": "confiei" },
