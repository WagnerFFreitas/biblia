{
  "livro": "Salmos - תְּהִלִּים - Tehillim",
  "capítulo": 63,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Ó Deus, tu és o meu Deus, de madrugada te buscarei; a minha alma tem sede de ti; a minha carne te deseja muito, em uma terra seca e cansada, onde não há água.",
      "palavras": [
        { "hebraico": "אֱלֹהִ֤ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "ó Deus" },
        { "hebraico": "אֵלִ֣י", "transliteral": "ʾē-lî", "traducao_palavra": "Deus meu" },
        { "hebraico": "אַ֭תָּה", "transliteral": "ʾāt-tā", "traducao_palavra": "[és] tu" },
        { "hebraico": "אֲשַׁחֲרֶ֗ךָּ", "transliteral": "ʾă-ša-ḥă-rek-kā", "traducao_palavra": "buscar-te-ei cedo" },
        { "hebraico": "צָמְאָ֨ה", "transliteral": "ṣā-mə-ʾā", "traducao_palavra": "tem sede" },
        { "hebraico": "לְךָ֜", "transliteral": "lə-ḵā", "traducao_palavra": "de ti" },
        { "hebraico": "נַפְשִׁ֗י", "transliteral": "nap̄-šî", "traducao_palavra": "minha alma" },
        { "hebraico": "כָּמַ֣הּ", "transliteral": "kā-mah", "traducao_palavra": "anseia/desfalece" },
        { "hebraico": "לְךָ֥", "transliteral": "lə-ḵā", "traducao_palavra": "por ti" },
        { "hebraico": "בְשָׂרִ֑י", "transliteral": "ḇə-śā-rî", "traducao_palavra": "minha carne" },
        { "hebraico": "בְּאֶֽרֶץ־", "transliteral": "bə-ʾe-reṣ-", "traducao_palavra": "em terra" },
        { "hebraico": "צִיָּ֖ה", "transliteral": "ṣiy-yā", "traducao_palavra": "seca" },
        { "hebraico": "וְעָיֵ֣ף", "transliteral": "wə-ʿā-yēp̄", "traducao_palavra": "e exausta" },
        { "hebraico": "בְּלִי־", "transliteral": "bə-lî-", "traducao_palavra": "sem" },
        { "hebraico": "מָֽיִם׃", "transliteral": "mā-yim", "traducao_palavra": "água" }
      ]
    },
    "2": {
      "traducao_completa": "Para ver a tua força e a tua glória, como te vi no santuário.",
      "palavras": [
        { "hebraico": "כֵּ֭ן", "transliteral": "kên", "traducao_palavra": "assim" },
        { "hebraico": "בַּקֹּ֣odeשׁ", "transliteral": "baq-qō-ḏeš", "traducao_palavra": "no santuário" },
        { "hebraico": "חֲזִיתִ֑יךָ", "transliteral": "ḥă-zî-ṯî-ḵā", "traducao_palavra": "contemplei-te" },
        { "hebraico": "לִרְאֹ֥ות", "transliteral": "lir-ʾôṯ", "traducao_palavra": "para ver" },
        { "hebraico": "עֻ֝זְּךָ֗", "transliteral": "uz-zə-ḵā", "traducao_palavra": "tua força" },
        { "hebraico": "וּכְבֹודֶֽךָ׃", "transliteral": "ū-ḵə-ḇô-ḏe-ḵā", "traducao_palavra": "e tua glória" }
      ]
    },
    "3": {
      "traducao_completa": "Porque a tua misericórdia é melhor do que a vida, os meus lábios te louvarão.",
      "palavras": [
        { "hebraico": "כִּי־", "transliteral": "kî-", "traducao_palavra": "porque" },
        { "hebraico": "טֹ֣וב", "transliteral": "ṭôḇ", "traducao_palavra": "melhor [é]" },
        { "hebraico": "חַ֭סְדְּךָ", "transliteral": "ḥas-də-ḵā", "traducao_palavra": "tua misericórdia" },
        { "hebraico": "מֵחַיִּ֑ים", "transliteral": "mê-ḥay-yîm", "traducao_palavra": "do que a vida" },
        { "hebraico": "שְׂפָתַ֥י", "transliteral": "śə-p̄ā-ṯay", "traducao_palavra": "meus lábios" },
        { "hebraico": "יְשַׁבְּחֽוּנְךָ׃", "transliteral": "yə-šab-bə-ḥûn-ḵā", "traducao_palavra": "louvar-te-ão" }
      ]
    },
    "4": {
      "traducao_completa": "Assim te bendirei enquanto eu viver; em teu nome levantarei as minhas mãos.",
      "palavras": [
        { "hebraico": "כֵּ֣ן", "transliteral": "kên", "traducao_palavra": "assim" },
        { "hebraico": "אֲבָרֶכְךָ֣", "transliteral": "ʾă-ḇā-re-ḵə-ḵā", "traducao_palavra": "bendizer-te-ei" },
        { "hebraico": "בְחַיָּ֑י", "transliteral": "ḇə-ḥay-yāy", "traducao_palavra": "em minha vida" },
        { "hebraico": "בְּ֝שִׁמְךָ֗", "transliteral": "bə-šim-ḵā", "traducao_palavra": "em teu nome" },
        { "hebraico": "אֶשָּׂ֥א", "transliteral": "ʾeś-śā", "traducao_palavra": "levantarei" },
        { "hebraico": "כַפָּֽי׃", "transliteral": "ḵap-pāy", "traducao_palavra": "minhas mãos" }
      ]
    },
    "5": {
      "traducao_completa": "A minha alma se fartará, como de medula e de gordura; e a minha boca te louvará com alegres lábios,",
      "palavras": [
        { "hebraico": "כְּמֹ֤ו", "transliteral": "kə-mô", "traducao_palavra": "como [de]" },
        { "hebraico": "חֵ֣לֶב", "transliteral": "ḥē-leḇ", "traducao_palavra": "gordura" },
        { "hebraico": "וָ֭דֶשֶׁן", "transliteral": "wā-ḏe-šen", "traducao_palavra": "e medula/fartura" },
        { "hebraico": "תִּשְׂבַּ֣ע", "transliteral": "tiś-baʿ", "traducao_palavra": "fartar-se-á" },
        { "hebraico": "נַפְשִׁ֑י", "transliteral": "nap̄-šî", "traducao_palavra": "minha alma" },
        { "hebraico": "וְשִׂפְתֵ֥י", "transliteral": "wə-śip̄-ṯê", "traducao_palavra": "e [com] lábios de" },
        { "hebraico": "רְ֝נָנֹ֗ות", "transliteral": "rə-nā-nôṯ", "traducao_palavra": "júbilo/canto" },
        { "hebraico": "יְהַלֶּל־", "transliteral": "yə-hal-lel-", "traducao_palavra": "louvará" },
        { "hebraico": "פִּֽי׃", "transliteral": "pî", "traducao_palavra": "minha boca" }
      ]
    },
    "6": {
      "traducao_completa": "Quando me lembrar de ti na minha cama, e meditar em ti nas vigílias da noite.",
      "palavras": [
        { "hebraico": "אִם־", "transliteral": "ʾim-", "traducao_palavra": "quando/se" },
        { "hebraico": "זְכַרְתִּ֥יךָ", "transliteral": "zə-ḵar-tî-ḵā", "traducao_palavra": "lembro-me de ti" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre" },
        { "hebraico": "יְצוּ֭עָי", "transliteral": "yə-ṣû-ʿāy", "traducao_palavra": "minha cama" },
        { "hebraico": "בְּ֝אַשְׁמֻרֹ֗ות", "transliteral": "bə-ʾaš-mu-rôṯ", "traducao_palavra": "nas vigílias" },
        { "hebraico": "אֶהְגֶּה־", "transliteral": "ʾeh-geh-", "traducao_palavra": "medito" },
        { "hebraico": "בָּֽךְ׃", "transliteral": "bāḵ", "traducao_palavra": "em ti" }
      ]
    },
    "7": {
      "traducao_completa": "Porque tu tens sido o meu auxílio; então, à sombra das tuas asas me regozijarei.",
      "palavras": [
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "porque" },
        { "hebraico": "הָיִ֣יתָ", "transliteral": "hā-yî-ṯā", "traducao_palavra": "tens sido" },
        { "hebraico": "עֶזְרָ֣תָה", "transliteral": "ʿez-rā-ṯā", "traducao_palavra": "ajuda" },
        { "hebraico": "לִּ֑י", "transliteral": "lî", "traducao_palavra": "para mim" },
        { "hebraico": "וּבְצֵ֥ל", "transliteral": "ū-ḇə-ṣēl", "traducao_palavra": "e na sombra de" },
        { "hebraico": "כְּ֝נָפֶ֗יךָ", "transliteral": "kə-nā-p̄ê-ḵā", "traducao_palavra": "tuas asas" },
        { "hebraico": "אֲרַנֵּֽן׃", "transliteral": "ʾă-ran-nên", "traducao_palavra": "cantarei de júbilo" }
      ]
    },
    "8": {
      "traducao_completa": "A minha alma está apegada a ti; a tua destra me sustenta.",
      "palavras": [
        { "hebraico": "דָּבְקָ֥ה", "transliteral": "dā-ḇə-qā", "traducao_palavra": "apegou-se" },
        { "hebraico": "נַפְשִׁ֗י", "transliteral": "nap̄-šî", "traducao_palavra": "minha alma" },
        { "hebraico": "אַחֲרֶ֑יךָ", "transliteral": "ʾa-ḥă-rê-ḵā", "traducao_palavra": "atrás de ti" },
        { "hebraico": "בִּ֝֗י", "transliteral": "bî", "traducao_palavra": "em mim" },
        { "hebraico": "תָּמְכָ֥ה", "transliteral": "tā-mə-ḵā", "traducao_palavra": "sustentou" },
        { "hebraico": "יְמִינֶֽךָ׃", "transliteral": "yə-mî-ne-ḵā", "traducao_palavra": "tua destra" }
      ]
    },
    "9": {
      "traducao_completa": "Mas aqueles que buscam a minha vida para a destruir, entrarão nas profundezas da terra.",
      "palavras": [
        { "hebraico": "וְהֵ֗מָּה", "transliteral": "wə-hēm-mā", "traducao_palavra": "mas eles" },
        { "hebraico": "לְ֭שֹׁואָה", "transliteral": "lə-šô-ʾā", "traducao_palavra": "para destruição" },
        { "hebraico": "יְבַקְשׁ֣וּ", "transliteral": "yə-ḇaq-šû", "traducao_palavra": "buscam" },
        { "hebraico": "נַפְשִׁ֑י", "transliteral": "nap̄-šî", "traducao_palavra": "minha alma" },
        { "hebraico": "יָ֝בֹ֗אוּ", "transliteral": "yā-ḇō-ʾû", "traducao_palavra": "entrarão" },
        { "hebraico": "בְּתַחְתִּיֹּ֥ות", "transliteral": "bə-ṯaḥ-tiy-yôṯ", "traducao_palavra": "nas profundezas de" },
        { "hebraico": "הָאָֽרֶץ׃", "transliteral": "hā-ʾā-reṣ", "traducao_palavra": "a terra" }
      ]
    },
    "10": {
      "traducao_completa": "Serão entregues ao poder da espada; serão uma porção para as raposas.",
      "palavras": [
        { "hebraico": "יַגִּירֻ֥הוּ", "transliteral": "yag-gî-ru-hû", "traducao_palavra": "eles serão derramados/entregues" },
        { "hebraico": "עַל־יְדֵי־", "transliteral": "ʿal-yə-ḏê-", "traducao_palavra": "pelas mãos de/poder de" },
        { "hebraico": "חָ֑רֶב", "transliteral": "ḥā-reḇ", "traducao_palavra": "espada" },
        { "hebraico": "מְנָ֥ת", "transliteral": "mə-nāṯ", "traducao_palavra": "porção de" },
        { "hebraico": "שֻׁעָלִ֝ים", "transliteral": "šu-ʿā-lîm", "traducao_palavra": "raposas/chacais" },
        { "hebraico": "יִהְיֽוּ׃", "transliteral": "yih-yû", "traducao_palavra": "eles serão" }
      ]
    },
    "11": {
      "traducao_completa": "Mas o rei se alegrará em Deus; gloriar-se-á todo aquele que por ele jura; pois se tapará a boca dos que falam a mentira.",
      "palavras": [
        { "hebraico": "וְהַמֶּ֨לֶךְ ׀", "transliteral": "wə-ham-me-leḵ", "traducao_palavra": "mas o rei" },
        { "hebraico": "יִשְׂמַ֣ח", "transliteral": "yiś-maḥ", "traducao_palavra": "se alegrará" },
        { "hebraico": "בֵּאלֹהִ֑ים", "transliteral": "bē-lō-hîm", "traducao_palavra": "em Deus" },
        { "hebraico": "יִתְהַלֵּ֗ל", "transliteral": "yiṯ-hal-lēl", "traducao_palavra": "gloriar-se-á" },
        { "hebraico": "כָּל־", "transliteral": "kāl-", "traducao_palavra": "todo" },
        { "hebraico": "הַנִּשְׁבָּ֥ע", "transliteral": "han-niš-bāʿ", "traducao_palavra": "o que jura" },
        { "hebraico": "בֹּ֑ו", "transliteral": "bô", "traducao_palavra": "por ele" },
        { "hebraico": "כִּ֥י", "transliteral": "kî", "traducao_palavra": "pois" },
        { "hebraico": "יִ֝סָּכֵ֗ר", "transliteral": "yis-śā-ḵēr", "traducao_palavra": "será fechada" },
        { "hebraico": "פִּ֣י", "transliteral": "pî", "traducao_palavra": "a boca de" },
        { "hebraico": "דֹבְרֵי־", "transliteral": "dō-ḇə-rê-", "traducao_palavra": "faladores de" },
        { "hebraico": "שָֽׁקֶר׃", "transliteral": "šā-qer", "traducao_palavra": "mentira" }
      ]
    }
  }
}