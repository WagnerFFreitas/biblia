        { "hebraico": "הָרִ֥יעוּ", "transliteral": "hā-rî-ʿû", "traducao_palavra": "aclamai" },
        { "hebraico": "לַֽיהוָ֥ה", "transliteral": "lay-hwāh", "traducao_palavra": "a YHWH" },
        { "hebraico": "כָּל־", "transliteral": "kāl-", "traducao_palavra": "toda" },
