        { "hebraico": "אֲ֭שֻׁרַי", "transliteral": "ʾă-šu-ray", "traducao_palavra": "meus passos" },
        { "hebraico": "בְּמַעְגְּלֹותֶ֑יךָ", "transliteral": "bə-maʿ-gə-lô-ṯe-ḵā", "traducao_palavra": "nas tuas veredas/trilhas" },
        { "hebraico": "בַּל־נָמֹ֥וטּוּ", "transliteral": "bal-nā-môṭ-ṭû", "traducao_palavra": "não vacilaram" },
        { "hebraico": "פְעָמָֽי׃", "transliteral": "p̄ə-ʿā-māy", "traducao_palavra": "meus pés/pegadas" }
      ]
    },
    "6": {
      "traducao_completa": "Eu te invoquei, pois me ouvirás, ó Deus; inclina para mim os teus ouvidos e ouve a minha fala.",
      "palavras": [
        { "hebraico": "אֲנִֽי־קְרָאתִ֣יךָ", "transliteral": "ʾă-nî-qə-rā-ṯî-ḵā", "traducao_palavra": "eu te invoquei" },
        { "hebraico": "כִֽי־תַעֲנֵ֣נִי", "transliteral": "ḵî-ṯa-ʿă-nê-nî", "traducao_palavra": "pois me responderás" },
        { "hebraico": "אֵ֑ל", "transliteral": "ʾēl", "traducao_palavra": "Deus" },
        { "hebraico": "הַט־אָזְנְךָ֥", "transliteral": "haṭ-ʾā-zə-nə-ḵā", "traducao_palavra": "inclina teu ouvido" },
