        { "hebraico": "בִּֽימִינֶֽךָ׃", "transliteral": "bî-mî-ne-ḵā", "traducao_palavra": "pela tua destra" }
      ]
    },
    "8": {
      "traducao_completa": "Guarda-me como à menina do olho; esconde-me debaixo da sombra das tuas asas,",
      "palavras": [
        { "hebraico": "שָׁ֭מְרֵנִי", "transliteral": "šā-mə-rē-nî", "traducao_palavra": "guarda-me" },
        { "hebraico": "כְּאִישֹׁ֥ון", "transliteral": "kə-ʾî-šôn", "traducao_palavra": "como pupila/menina" },
        { "hebraico": "בַּת־עָ֑יִן", "transliteral": "baṯ-ʿā-yin", "traducao_palavra": "filha do olho" },
        { "hebraico": "בְּצֵ֥ל", "transliteral": "bə-ṣēl", "traducao_palavra": "na sombra de" },
        { "hebraico": "כְּ֝נָפֶ֗יךָ", "transliteral": "kə-nā-p̄e-ḵā", "traducao_palavra": "tuas asas" },
        { "hebraico": "תַּסְתִּירֵֽנִי׃", "transliteral": "tas-tî-rē-nî", "traducao_palavra": "esconder-me-ás" }
      ]
    },
    "9": {
