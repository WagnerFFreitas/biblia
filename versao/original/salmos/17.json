        { "hebraico": "בִּדְבַ֥ר", "transliteral": "biḏ-ḇar", "traducao_palavra": "pela palavra de" },
        { "hebraico": "שְׂפָתֶ֑יךָ", "transliteral": "śə-p̄ā-ṯe-ḵā", "traducao_palavra": "teus lábios" },
        { "hebraico": "אֲנִ֥י", "transliteral": "ʾă-nî", "traducao_palavra": "eu" },
