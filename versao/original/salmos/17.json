        { "hebraico": "זַ֝מֹּתִ֗י", "transliteral": "zam-mō-ṯî", "traducao_palavra": "planejei/propus" },
        { "hebraico": "בַּל־יַעֲבָר־פִּֽי׃", "transliteral": "bal-ya-ʿă-ḇār-pî", "traducao_palavra": "não transgredirá minha boca" }
      ]
    },
    "4": {
      "traducao_completa": "Quanto às obras dos homens, pela palavra dos teus lábios me guardei das veredas do destruidor.",
      "palavras": [
        { "hebraico": "לִפְעֻלֹּ֥ות", "transliteral": "lip̄-ʿul-lôṯ", "traducao_palavra": "quanto às obras de" },
