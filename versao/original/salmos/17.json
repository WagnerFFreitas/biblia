{
  "livro": "Salmos - תְּהִלִּים - Tehillim",
  "capítulo": 17,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Oração de Davi. Ouve, YHWH, a justiça; atende ao meu clamor; dá ouvidos à minha oração, que não é feita com lábios enganosos.",
