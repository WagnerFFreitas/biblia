        { "hebraico": "פָּ֘קַ֤דְתָּ", "transliteral": "pā-qaḏ-tā", "traducao_palavra": "visitaste" },
        { "hebraico": "לַּ֗יְלָה", "transliteral": "lay-lā", "traducao_palavra": "[de] noite" },
        { "hebraico": "צְרַפְתַּ֥נִי", "transliteral": "ṣə-rap̄-ta-nî", "traducao_palavra": "refinaste-me" },
