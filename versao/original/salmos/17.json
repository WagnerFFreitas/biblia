        { "hebraico": "תְפִלָּתִ֑י", "transliteral": "tə-p̄il-lā-ṯî", "traducao_palavra": "[à] minha oração" },
        { "hebraico": "בְּ֝לֹ֗א", "transliteral": "bə-lō", "traducao_palavra": "sem [não em]" },
        { "hebraico": "שִׂפְתֵ֥י", "transliteral": "śip̄-ṯê", "traducao_palavra": "lábios de" },
        { "hebraico": "מִרְמָֽה׃", "transliteral": "mir-mā", "traducao_palavra": "engano/fraude" }
      ]
    },
    "2": {
      "traducao_completa": "Venha a minha sentença de diante do teu rosto; olhem os teus olhos para a equidade.",
      "palavras": [
        { "hebraico": "מִ֭לְּפָנֶיךָ", "transliteral": "mil-lə-p̄ā-ne-ḵā", "traducao_palavra": "de diante de ti" },
        { "hebraico": "מִשְׁפָּטִ֣י", "transliteral": "miš-pā-ṭî", "traducao_palavra": "meu julgamento/sentença" },
        { "hebraico": "יֵצֵ֑א", "transliteral": "yē-ṣē", "traducao_palavra": "saia" },
        { "hebraico": "עֵ֝ינֶ֗יךָ", "transliteral": "ʿê-ne-ḵā", "traducao_palavra": "teus olhos" },
        { "hebraico": "תֶּחֱזֶ֥ינָה", "transliteral": "te-ḥĕ-ze-nā", "traducao_palavra": "contemplem" },
        { "hebraico": "מֵישָׁרִֽים׃", "transliteral": "mê-šā-rîm", "traducao_palavra": "equidade/retidão" }
      ]
    },
    "3": {
      "traducao_completa": "Sondaste o meu coração; visitaste-me de noite; provaste-me e não achaste nada; propus que a minha boca não transgredirá.",
      "palavras": [
