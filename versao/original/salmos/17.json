        { "hebraico": "לְדָ֫וִ֥ד", "transliteral": "lə-ḏā-wiḏ", "traducao_palavra": "de Davi" },
        { "hebraico": "שִׁמְעָ֤ה", "transliteral": "šim-ʿā", "traducao_palavra": "ouve" },
        { "hebraico": "יְהוָ֨ה ׀", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "צֶ֗דֶק", "transliteral": "ṣe-ḏeq", "traducao_palavra": "[a] justiça" },
        { "hebraico": "הַקְשִׁ֥יבָה", "transliteral": "haq-šî-ḇā", "traducao_palavra": "atende/inclina" },
        { "hebraico": "רִנָּתִ֗י", "transliteral": "rin-nā-ṯî", "traducao_palavra": "ao meu clamor" },
