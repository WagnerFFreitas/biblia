{
  "livro": "Salmos - תְּהִלִּים - Tehillim",
  "capítulo": 139,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "YHWH, tu me sondaste e me conheces.",
      "palavras": [
        { "hebraico": "יְהוָ֥ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "חֲקַרְתַּ֗נִי", "transliteral": "ḥă-qar-ta-nî", "traducao_palavra": "tu me sondaste" },
        { "hebraico": "וַתֵּדָֽע׃", "transliteral": "wat-tê-ḏāʿ", "traducao_palavra": "e tu conheces" }
      ]
    },
    "2": {
      "traducao_completa": "Tu conheces o meu assentar e o meu levantar; de longe entendes o meu pensamento.",
      "palavras": [
        { "hebraico": "אַתָּ֣ה", "transliteral": "ʾat-tā", "traducao_palavra": "tu" },
        { "hebraico": "יָ֭דַעְתָּ", "transliteral": "yā-ḏa-ʿtā", "traducao_palavra": "conheces" },
        { "hebraico": "שִׁבְתִּ֣י", "transliteral": "šiḇ-tî", "traducao_palavra": "meu assentar" },
        { "hebraico": "וְקוּמִ֑י", "transliteral": "wə-qû-mî", "traducao_palavra": "e meu levantar" },
        { "hebraico": "בַּ֥נְתָּה", "transliteral": "ban-tā", "traducao_palavra": "tu entendes" },
        { "hebraico": "לְ֝רֵעִ֗י", "transliteral": "lə-rē-ʿî", "traducao_palavra": "meu pensamento/propósito" },
        { "hebraico": "מֵרָחֹֽוק׃", "transliteral": "mê-rā-ḥôq", "traducao_palavra": "de longe" }
      ]
    },
    "3": {
      "traducao_completa": "Cercas o meu andar e o meu deitar; e conheces todos os meus caminhos.",
      "palavras": [
        { "hebraico": "אָרְחִ֣י", "transliteral": "ʾor-ḥî", "traducao_palavra": "meu caminho/andar" },
        { "hebraico": "וְרִבְעִ֣י", "transliteral": "wə-riḇ-ʿî", "traducao_palavra": "e meu deitar" },
        { "hebraico": "זֵרִ֑יתָ", "transliteral": "zē-rî-ṯā", "traducao_palavra": "peneiraste/cercaste" },
        { "hebraico": "וְכָל־", "transliteral": "wə-ḵāl-", "traducao_palavra": "e todos" },
        { "hebraico": "דְּרָכַ֥י", "transliteral": "də-rā-ḵay", "traducao_palavra": "caminhos meus" },
        { "hebraico": "הִסְכַּֽנְתָּה׃", "transliteral": "his-kan-tā", "traducao_palavra": "tu conheces bem/estás familiarizado" }
      ]
    },
    "4": {
      "traducao_completa": "Sem que haja uma palavra na minha língua, eis que, ó YHWH, tudo conheces.",
      "palavras": [
        { "hebraico": "כִּ֤י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "אֵ֣ין", "transliteral": "ʾên", "traducao_palavra": "não [há]" },
        { "hebraico": "מִ֭לָּה", "transliteral": "mil-lā", "traducao_palavra": "palavra" },
        { "hebraico": "בִּלְשֹׁונִ֑י", "transliteral": "bil-šô-nî", "traducao_palavra": "na minha língua" },
        { "hebraico": "הֵ֥ן", "transliteral": "hên", "traducao_palavra": "eis" },
        { "hebraico": "יְ֝הוָ֗ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "יָדַ֥עְתָּ", "transliteral": "yā-ḏa-ʿtā", "traducao_palavra": "tu conheces" },
        { "hebraico": "כֻלָּֽהּ׃", "transliteral": "ḵul-lāh", "traducao_palavra": "toda ela" }
      ]
    },
    "5": {
      "traducao_completa": "Tu me cercaste por trás e por diante, e puseste sobre mim a tua mão.",
      "palavras": [
        { "hebraico": "אָחֹ֣ור", "transliteral": "ʾā-ḥôr", "traducao_palavra": "atrás" },
        { "hebraico": "וָקֶ֣דֶם", "transliteral": "wā-qe-ḏem", "traducao_palavra": "e adiante" },
        { "hebraico": "צַרְתָּ֑נִי", "transliteral": "ṣar-ta-nî", "traducao_palavra": "tu me cercaste" },
        { "hebraico": "וַתָּ֨שֶׁת", "transliteral": "wat-tā-šet", "traducao_palavra": "e puseste" },
        { "hebraico": "עָלַ֥י", "transliteral": "ʿā-lay", "traducao_palavra": "sobre mim" },
        { "hebraico": "כַּפֶּֽךָ׃", "transliteral": "kap-pe-ḵā", "traducao_palavra": "tua mão/palma" }
      ]
    },
    "6": {
      "traducao_completa": "Tal conhecimento é maravilhoso demais para mim; é elevado, não o posso atingir.",
      "palavras": [
        { "hebraico": "פְּלִ֘יאָה", "transliteral": "pə-lî-ʾā", "traducao_palavra": "maravilhosa" },
        { "hebraico": "דַ֥עַת", "transliteral": "da-ʿaṯ", "traducao_palavra": "[tal] conhecimento" },
        { "hebraico": "מִמֶּ֑נִּי", "transliteral": "mi-mmen-nî", "traducao_palavra": "além de mim/para mim" },
        { "hebraico": "נִ֝שְׂגְּבָ֗ה", "transliteral": "niś-gə-ḇā", "traducao_palavra": "[é] elevada" },
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "א֘וּכַ֥ל", "transliteral": "ʾû-ḵāl", "traducao_palavra": "posso/atingirei" },
        { "hebraico": "לָֽהּ׃", "transliteral": "lāh", "traducao_palavra": "a ela" }
      ]
    },
    "7": {
      "traducao_completa": "Para onde me irei do teu Espírito, ou para onde fugirei da tua face?",
      "palavras": [
        { "hebraico": "אָ֭נָה", "transliteral": "ʾā-nā", "traducao_palavra": "para onde" },
        { "hebraico": "אֵלֵ֣ךְ", "transliteral": "ʾē-lēḵ", "traducao_palavra": "irei" },
        { "hebraico": "מֵרוּחֶ֑ךָ", "transliteral": "mê-rû-ḥe-ḵā", "traducao_palavra": "do teu Espírito" },
        { "hebraico": "וְ֝אָ֗נָה", "transliteral": "wə-ʾā-nā", "traducao_palavra": "e para onde" },
        { "hebraico": "מִפָּנֶ֥יךָ", "transliteral": "mi-pā-ney-ḵā", "traducao_palavra": "da tua face" },
        { "hebraico": "אֶבְרָֽח׃", "transliteral": "ʾeḇ-rāḥ", "traducao_palavra": "fugirei" }
      ]
    },
    "8": {
      "traducao_completa": "Se subir ao céu, lá tu estás; se fizer no Sheol a minha cama, eis que tu ali estás também.",
      "palavras": [
        { "hebraico": "אִם־", "transliteral": "ʾim-", "traducao_palavra": "se" },
        { "hebraico": "אֶסַּ֣ק", "transliteral": "ʾeś-śaq", "traducao_palavra": "eu subir" },
        { "hebraico": "שָׁ֭מַיִם", "transliteral": "šā-ma-yim", "traducao_palavra": "[ao] céu" },
        { "hebraico": "שָׁ֣ם", "transliteral": "šām", "traducao_palavra": "lá" },
        { "hebraico": "אָ֑תָּה", "transliteral": "ʾāt-tā", "traducao_palavra": "[estás] tu" },
        { "hebraico": "וְאַצִּ֥יעָה", "transliteral": "wə-ʾaṣ-ṣî-ʿā", "traducao_palavra": "e se eu estender [cama]" },
        { "hebraico": "שְּׁ֝אֹ֗ול", "transliteral": "šə-ʾôl", "traducao_palavra": "[no] Sheol" },
        { "hebraico": "הִנֶּֽךָּ׃", "transliteral": "hin-ne-kkā", "traducao_palavra": "eis que tu [estás ali]" }
      ]
    },
    "9": {
      "traducao_completa": "Se tomar as asas da alvorada, se habitar nas extremidades do mar,",
      "palavras": [
        { "hebraico": "אֶשָּׂ֥א", "transliteral": "ʾeś-śā", "traducao_palavra": "eu tomar" },
        { "hebraico": "כַנְפֵי־", "transliteral": "ḵan-p̄ê-", "traducao_palavra": "asas de" },
        { "hebraico": "שָׁ֑חַר", "transliteral": "šā-ḥar", "traducao_palavra": "alvorada" },
        { "hebraico": "אֶ֝שְׁכְּנָ֗ה", "transliteral": "ʾeš-kə-nā", "traducao_palavra": "habitarei" },
        { "hebraico": "בְּאַחֲרִ֥ית", "transliteral": "bə-ʾa-ḥă-rîṯ", "traducao_palavra": "na extremidade de" },
        { "hebraico": "יָֽם׃", "transliteral": "yām", "traducao_palavra": "[o] mar" }
      ]
    },
    "10": {
      "traducao_completa": "Ainda ali a tua mão me guiará e a tua destra me susterá.",
      "palavras": [
        { "hebraico": "גַּם־", "transliteral": "gam-", "traducao_palavra": "também" },
        { "hebraico": "שָׁ֭ם", "transliteral": "šām", "traducao_palavra": "ali" },
        { "hebraico": "יָדְךָ֣", "transliteral": "yā-ḏə-ḵā", "traducao_palavra": "tua mão" },
        { "hebraico": "תַנְחֵ֑נִי", "transliteral": "ṯan-ḥē-nî", "traducao_palavra": "guiará me" },
        { "hebraico": "וְֽתֹאחֲזֵ֥נִי", "transliteral": "wə-ṯō-ḥă-zē-nî", "traducao_palavra": "e segurará me" },
        { "hebraico": "יְמִינֶֽךָ׃", "transliteral": "yə-mî-ne-ḵā", "traducao_palavra": "tua destra" }
      ]
    },
    "11": {
      "traducao_completa": "Se eu disser: Certamente as trevas me encobrirão; então a noite será luz ao redor de mim.",
      "palavras": [
        { "hebraico": "וָ֭אֹמַר", "transliteral": "wā-ʾō-mar", "traducao_palavra": "e eu disse" },
        { "hebraico": "אַךְ־", "transliteral": "ʾaḵ-", "traducao_palavra": "apenas/certamente" },
        { "hebraico": "חֹ֣שֶׁךְ", "transliteral": "ḥō-šeḵ", "traducao_palavra": "trevas" },
        { "hebraico": "יְשׁוּפֵ֑נִי", "transliteral": "yə-šû-p̄ê-nî", "traducao_palavra": "cobrirão me" },
        { "hebraico": "וְ֝לַ֗יְלָה", "transliteral": "wə-lay-lā", "traducao_palavra": "e a noite" },
        { "hebraico": "אֹ֥ור", "transliteral": "ʾôr", "traducao_palavra": "[será] luz" },
        { "hebraico": "בַּעֲדֵֽנִי׃", "transliteral": "ba-ʿă-ḏē-nî", "traducao_palavra": "ao meu redor" }
      ]
    },
    "12": {
      "traducao_completa": "Nem ainda as trevas me escondem de ti; mas a noite resplandece como o dia; as trevas e a luz são para ti a mesma coisa.",
      "palavras": [
        { "hebraico": "גַּם־", "transliteral": "gam-", "traducao_palavra": "também" },
        { "hebraico": "חֹשֶׁךְ֮", "transliteral": "ḥō-šeḵ", "traducao_palavra": "[as] trevas" },
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "יַחְשִׁ֪יךְ", "transliteral": "ya-ḥə-šîḵ", "traducao_palavra": "escondem/escurecem" },
        { "hebraico": "מִ֫מֶּ֥ךָ", "transliteral": "mi-mme-ḵā", "traducao_palavra": "de ti" },
        { "hebraico": "וְ֝לַ֗יְלָה", "transliteral": "wə-lay-lā", "traducao_palavra": "e a noite" },
        { "hebraico": "כַּיֹּ֥ום", "transliteral": "kay-yôm", "traducao_palavra": "como o dia" },
        { "hebraico": "יָאִ֑יר", "transliteral": "yā-ʾîr", "traducao_palavra": "resplandece" },
        { "hebraico": "כַּ֝חֲשֵׁיכָ֗ה", "transliteral": "ka-ḥă-šê-ḵā", "traducao_palavra": "como a treva" },
        { "hebraico": "כָּאֹורָֽה׃", "transliteral": "kā-ʾô-rā", "traducao_palavra": "como a luz" }
      ]
    },
    "13": {
      "traducao_completa": "Pois tu possuíste os meus rins; teceste-me no ventre de minha mãe.",
      "palavras": [
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "porque/pois" },
        { "hebraico": "אַתָּה", "transliteral": "ʾat-tā", "traducao_palavra": "tu" },
        { "hebraico": "קָנִ֣יתָ", "transliteral": "qā-nî-ṯā", "traducao_palavra": "possuíste/formaste" },
        { "hebraico": "כִלְיֹתָ֑י", "transliteral": "ḵil-yō-ṯāy", "traducao_palavra": "meus rins/íntimo" },
        { "hebraico": "תְּ֝סֻכֵּ֗נִי", "transliteral": "tə-śu-kkē-nî", "traducao_palavra": "teceste-me/cobriste-me" },
        { "hebraico": "בְּבֶ֣טֶן", "transliteral": "bə-ḇe-ṭen", "traducao_palavra": "no ventre de" },
        { "hebraico": "אִמִּֽי׃", "transliteral": "ʾim-mî", "traducao_palavra": "minha mãe" }
      ]
    },
    "14": {
      "traducao_completa": "Louvar-te-ei, pois de modo tremendo e maravilhoso fui feito; maravilhosas são as tuas obras, e a minha alma o sabe muito bem.",
      "palavras": [
        { "hebraico": "אֹ֘ודְךָ֗", "transliteral": "ʾô-ḏə-ḵā", "traducao_palavra": "louvar-te-ei" },
        { "hebraico": "עַ֤ל", "transliteral": "ʿal", "traducao_palavra": "por causa de" },
        { "hebraico": "כִּ֥י", "transliteral": "kî", "traducao_palavra": "que" },
        { "hebraico": "נֹורָאֹ֗ות", "transliteral": "nô-rā-ʾôṯ", "traducao_palavra": "[de modo] tremendo" },
        { "hebraico": "נִ֫פְלֵ֥יתִי", "transliteral": "nip̄-lê-ṯî", "traducao_palavra": "fui feito maravilhosamente" },
        { "hebraico": "נִפְלָאִ֥ים", "transliteral": "nip̄-lā-ʾîm", "traducao_palavra": "maravilhosas [são]" },
        { "hebraico": "מַעֲשֶׂ֑יךָ", "transliteral": "ma-ʿă-śey-ḵā", "traducao_palavra": "tuas obras" },
        { "hebraico": "וְ֝נַפְשִׁ֗י", "transliteral": "wə-nap̄-šî", "traducao_palavra": "e minha alma" },
        { "hebraico": "יֹדַ֥עַת", "transliteral": "yō-ḏa-ʿat", "traducao_palavra": "conhece" },
        { "hebraico": "מְאֹֽד׃", "transliteral": "mə-ʾōḏ", "traducao_palavra": "muito" }
      ]
    },
    "15": {
      "traducao_completa": "Os meus ossos não te foram ocultos, quando em secreto fui feito, e entretecido nas profundezas da terra.",
      "palavras": [
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "נִכְחַ֥ד", "transliteral": "niḵ-ḥaḏ", "traducao_palavra": "foi oculto" },
        { "hebraico": "עָצְמִ֗י", "transliteral": "ʿāṣ-mî", "traducao_palavra": "meu osso/corpo" },
        { "hebraico": "מִ֫מֶּ֥ךָּ", "transliteral": "mi-mme-kkā", "traducao_palavra": "de ti" },
        { "hebraico": "אֲשֶׁר־", "transliteral": "ʾă-šer-", "traducao_palavra": "quando" },
        { "hebraico": "עֻשֵּׂ֥יתִי", "transliteral": "ʿuś-śê-ṯî", "traducao_palavra": "fui feito" },
        { "hebraico": "בַסֵּ֑תֶר", "transliteral": "ḇa-śśê-ṯer", "traducao_palavra": "no secreto" },
        { "hebraico": "רֻ֝קַּ֗מְתִּי", "transliteral": "ruq-qam-tî", "traducao_palavra": "fui entretecido/bordado" },
        { "hebraico": "בְּתַחְתִּיֹּ֥ות", "transliteral": "bə-ṯaḥ-tiy-yôṯ", "traducao_palavra": "nas profundezas de" },
        { "hebraico": "אָֽרֶץ", "transliteral": "ʾā-reṣ", "traducao_palavra": "terra" }
      ]
    },
    "16": {
      "traducao_completa": "Os teus olhos viram a minha substância ainda informe; e no teu livro todas estas coisas foram escritas; as quais iam sendo dia a dia formadas, quando nem ainda uma delas havia.",
      "palavras": [
        { "hebraico": "גָּלְמִ֤י", "transliteral": "ḡol-mî", "traducao_palavra": "minha substância informe/embrião" },
        { "hebraico": "׀", "transliteral": "|", "traducao_palavra": "" },
        { "hebraico": "רָ֘א֤וּ", "transliteral": "rā-ʾû", "traducao_palavra": "viram" },
        { "hebraico": "עֵינֶ֗יךָ", "transliteral": "ê-ney-ḵā", "traducao_palavra": "teus olhos" },
        { "hebraico": "וְעַֽל־", "transliteral": "wə-ʿal-", "traducao_palavra": "e sobre" },
        { "hebraico": "סִפְרְךָ֮", "transliteral": "śip̄-rə-ḵā", "traducao_palavra": "teu livro" },
        { "hebraico": "כֻּלָּ֪ם", "transliteral": "kul-lām", "traducao_palavra": "todos eles" },
        { "hebraico": "יִכָּ֫תֵ֥בוּ", "transliteral": "yik-kā-ṯē-ḇû", "traducao_palavra": "foram escritos" },
        { "hebraico": "יָמִ֥ים", "transliteral": "yā-mîm", "traducao_palavra": "[os] dias" },
        { "hebraico": "יֻצָּ֑רוּ", "transliteral": "yuṣ-ṣā-rû", "traducao_palavra": "[que] foram formados" },
        { "hebraico": "וְלֹ֖א", "transliteral": "wə-lō", "traducao_palavra": "e não [havia]" },
        { "hebraico": "אֶחָ֣ד", "transliteral": "ʾe-ḥāḏ", "traducao_palavra": "um só" },
        { "hebraico": "בָּהֶֽם׃", "transliteral": "bā-hem", "traducao_palavra": "entre eles" }
      ]
    },
    "17": {
      "traducao_completa": "E quão preciosos me são, ó Deus, os teus pensamentos! Quão grande é a soma deles!",
      "palavras": [
        { "hebraico": "וְלִ֗י", "transliteral": "wə-lî", "traducao_palavra": "e para mim" },
        { "hebraico": "מַה־", "transliteral": "mah-", "traducao_palavra": "quão" },
        { "hebraico": "יָּקְר֣וּ", "transliteral": "yā-qə-rû", "traducao_palavra": "preciosos são" },
        { "hebraico": "רֵעֶ֣יךָ", "transliteral": "rē-ʿey-ḵā", "traducao_palavra": "teus pensamentos" },
