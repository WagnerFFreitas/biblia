{
  "livro": "Salmos - תְּהִלִּים - Tə-hil-lîm",
  "capítulo": 4,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Ao mestre de canto, com instrumentos de cordas. Salmo de Davi. Ouve-me quando eu clamo, ó Deus da minha justiça; na angústia me deste largueza; tem misericórdia de mim e ouve a minha oração.",
      "palavras": [
        { "hebraico": "לַמְנַצֵּ֗חַ", "transliteral": "lam-naṣ-ṣê-aḥ", "traducao_palavra": "Ao mestre de canto" },
        { "hebraico": "בִּנְגִינֹ֥ות", "transliteral": "bin-ḡî-nō-wṯ", "traducao_palavra": "com instrumentos de cordas" },
        { "hebraico": "מִזְמֹ֥ור", "transliteral": "miz-môr", "traducao_palavra": "salmo" },
        { "hebraico": "לְדָוִ֑ד", "transliteral": "lə-ḏā-wiḏ", "traducao_palavra": "de Davi" },
        { "hebraico": "בְּקָרְאִ֡י", "transliteral": "bə-qā-rə-ʾî", "traducao_palavra": "Ao clamar eu" },
        { "hebraico": "עֲנֵנִי֮", "transliteral": "ʿă-nê-nî", "traducao_palavra": "responde-me" },
        { "hebraico": "אֱלֹ֘הֵ֤י", "transliteral": "ʾĕ-lō-hê", "traducao_palavra": "ó Deus de" },
        { "hebraico": "צִדְקִ֗י", "transliteral": "ṣiḏ-qî", "traducao_palavra": "minha justiça" },
        { "hebraico": "בַּ֭צָּר", "transliteral": "ba-ṣār", "traducao_palavra": "na angústia" },
        { "hebraico": "הִרְחַ֣בְתָּ", "transliteral": "hir-ḥaḇ-tā", "traducao_palavra": "deste-me alívio/largueza" },
        { "hebraico": "לִּ֑י", "transliteral": "lî", "traducao_palavra": "para mim" },
        { "hebraico": "חָ֝נֵּ֗נִי", "transliteral": "ḥān-nê-nî", "traducao_palavra": "tem misericórdia de mim" },
        { "hebraico": "וּשְׁמַ֥ע", "transliteral": "ū-šə-maʿ", "traducao_palavra": "e ouve" },
        { "hebraico": "תְּפִלָּתִֽי׃", "transliteral": "tə-p̄il-lā-ṯî", "traducao_palavra": "minha oração" }
      ]
    },
    "2": {
      "traducao_completa": "Filhos dos homens, até quando convertereis a minha glória em infâmia? Até quando amareis a vaidade e buscareis a mentira? (Selá)",
      "palavras": [
        { "hebraico": "בְּנֵ֥i", "transliteral": "bə-nê", "traducao_palavra": "Filhos de" },
        { "hebraico": "אִ֓ישׁ", "transliteral": "ʾîš", "traducao_palavra": "homens" },
        { "hebraico": "עַד־", "transliteral": "ʿaḏ-", "traducao_palavra": "até" },
        { "hebraico": "מֶ֬ה", "transliteral": "meh", "traducao_palavra": "quando" },
        { "hebraico": "כְבֹודִ֣י", "transliteral": "ḵə-ḇô-ḏî", "traducao_palavra": "minha glória" },
        { "hebraico": "לִ֭כְלִמָּה", "transliteral": "li-ḵə-lim-mā", "traducao_palavra": "em infâmia/vergonha" },
        { "hebraico": "תֶּאֱהָב֣וּן", "transliteral": "te-ʾĕ-hā-ḇûn", "traducao_palavra": "amareis" },
        { "hebraico": "רִ֑יק", "transliteral": "rîq", "traducao_palavra": "vaidade/vazio" },
        { "hebraico": "תְּבַקְשׁוּ־", "transliteral": "tə-ḇaq-šû-", "traducao_palavra": "buscareis" },
        { "hebraico": "כָזָ֥ב", "transliteral": "ḵā-zāḇ", "traducao_palavra": "mentira" },
        { "hebraico": "סֶֽלָה׃", "transliteral": "śe-lā", "traducao_palavra": "Selá" }
      ]
    },
    "3": {
      "traducao_completa": "Sabei, pois, que YHWH separou para si aquele que é piedoso; YHWH ouvirá quando eu clamar a ele.",
      "palavras": [
        { "hebraico": "וּדְע֗וּ", "transliteral": "ū-ḏə-ʿû", "traducao_palavra": "Sabei pois" },
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "que" },
        { "hebraico": "הִפְלָ֣ה", "transliteral": "hip̄-lā", "traducao_palavra": "separou/distinguiu" },
        { "hebraico": "יְ֭הוָה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "חָסִ֣יד", "transliteral": "ḥā-śîḏ", "traducao_palavra": "[o] piedoso" },
        { "hebraico": "לֹ֑ו", "transliteral": "lô", "traducao_palavra": "para Si" },
        { "hebraico": "יְהוָ֥ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "יִ֝שְׁמַ֗ע", "transliteral": "yiš-maʿ", "traducao_palavra": "ouvirá" },
        { "hebraico": "בְּקָרְאִ֥י", "transliteral": "bə-qā-rə-ʾî", "traducao_palavra": "ao clamar eu" },
        { "hebraico": "אֵלָֽיו׃", "transliteral": "ʾê-lāyw", "traducao_palavra": "a Ele" }
      ]
    },
    "4": {
      "traducao_completa": "Perturbai-vos e não pequeis; falai com o vosso coração sobre a vossa cama, e calai-vos. (Selá)",
      "palavras": [
        { "hebraico": "רִגְז֗וּ", "transliteral": "riḡ-zû", "traducao_palavra": "Perturbai-vos/Irai-vos" },
        { "hebraico": "וְאַל־", "transliteral": "wə-ʾal-", "traducao_palavra": "e não" },
        { "hebraico": "תֶּחֱטָ֑אוּ", "transliteral": "te-ḥĕ-ṭā-ʾû", "traducao_palavra": "pequeis" },
        { "hebraico": "אִמְר֣וּ", "transliteral": "ʾim-rû", "traducao_palavra": "falai" },
        { "hebraico": "בִ֭לְבַבְכֶם", "transliteral": "ḇil-ḇaḇ-ḵem", "traducao_palavra": "com vosso coração" },
        { "hebraico": "עַֽל־", "transliteral": "ʿal-", "traducao_palavra": "sobre" },
        { "hebraico": "מִשְׁכַּבְכֶ֗ם", "transliteral": "miš-kaḇ-ḵem", "traducao_palavra": "vosso leito" },
        { "hebraico": "וְדֹ֣מּוּ", "transliteral": "wə-ḏōm-mû", "traducao_palavra": "e silenciai" },
        { "hebraico": "סֶֽלָה׃", "transliteral": "śe-lā", "traducao_palavra": "Selá" }
      ]
    },
    "5": {
      "traducao_completa": "Oferecei sacrifícios de justiça, e confiai em YHWH.",
      "palavras": [
        { "hebraico": "זִבְח֥וּ", "transliteral": "ziḇ-ḥû", "traducao_palavra": "Oferecei" },
        { "hebraico": "זִבְחֵי־", "transliteral": "ziḇ-ḥê-", "traducao_palavra": "sacrifícios de" },
        { "hebraico": "צֶ֑דֶק", "transliteral": "ṣe-ḏeq", "traducao_palavra": "justiça" },
        { "hebraico": "וּ֝בִטְח֗וּ", "transliteral": "ū-ḇiṭ-ḥû", "traducao_palavra": "e confiai" },
        { "hebraico": "אֶל־", "transliteral": "ʾel-", "traducao_palavra": "em" },
        { "hebraico": "יְהוָֽה׃", "transliteral": "YHWH", "traducao_palavra": "YHWH" }
      ]
    },
    "6": {
      "traducao_completa": "Muitos dizem: Quem nos mostrará o bem? YHWH, levanta sobre nós a luz do teu rosto.",
      "palavras": [
        { "hebraico": "רַבִּ֥ים", "transliteral": "rab-bîm", "traducao_palavra": "Muitos" },
        { "hebraico": "אֹמְרִים֮", "transliteral": "ʾō-mə-rîm", "traducao_palavra": "dizem" },
        { "hebraico": "מִֽי־", "transliteral": "mî-", "traducao_palavra": "Quem" },
        { "hebraico": "יַרְאֵ֪נוּ", "transliteral": "yar-ʾê-nû", "traducao_palavra": "mostrará a nós" },
        { "hebraico": "טֹ֫וב", "transliteral": "ṭôḇ", "traducao_palavra": "[o] bem?" },
        { "hebraico": "נְסָה־", "transliteral": "nə-śā-", "traducao_palavra": "Levanta" },
        { "hebraico": "עָ֭לֵינוּ", "transliteral": "ʿā-lê-nû", "traducao_palavra": "sobre nós" },
        { "hebraico": "אֹ֣ור", "transliteral": "ʾôr", "traducao_palavra": "a luz de" },
        { "hebraico": "פָּנֶ֣יךָ", "transliteral": "pā-ney-ḵā", "traducao_palavra": "Teu rosto" },
        { "hebraico": "יְהוָֽה׃", "transliteral": "YHWH", "traducao_palavra": "YHWH" }
      ]
    },
    "7": {
      "traducao_completa": "Puseste alegria no meu coração, mais do que no tempo em que se multiplicaram o seu trigo e o seu mosto.",
      "palavras": [
        { "hebraico": "נָתַ֖תָּה", "transliteral": "nā-ṯat-tā", "traducao_palavra": "Puseste" },
        { "hebraico": "שִׂמְחָ֣ה", "transliteral": "śim-ḥā", "traducao_palavra": "alegria" },
        { "hebraico": "בְלִבִּ֑י", "transliteral": "ḇə-lib-bî", "traducao_palavra": "no meu coração" },
        { "hebraico": "מֵעֵ֬ת", "transliteral": "mê-ʿêṯ", "traducao_palavra": "mais que no tempo [em que]" },
        { "hebraico": "דְּגָנָ֖ם", "transliteral": "də-ḡā-nām", "traducao_palavra": "o trigo deles" },
        { "hebraico": "וְתִירֹושָׁ֣ם", "transliteral": "wə-ṯî-rō-w-šām", "traducao_palavra": "e o mosto deles" },
        { "hebraico": "רָֽבּוּ׃", "transliteral": "rāb-bû", "traducao_palavra": "multiplicaram-se" }
      ]
    },
    "8": {
      "traducao_completa": "Em paz também me deitarei e dormirei, porque só tu, YHWH, me fazes habitar em segurança.",
      "palavras": [
        { "hebraico": "בְּשָׁלֹ֣ום", "transliteral": "bə-šā-lôm", "traducao_palavra": "Em paz" },
        { "hebraico": "יַחְדָּ֭ו", "transliteral": "yaḥ-dāw", "traducao_palavra": "juntamente" },
        { "hebraico": "אֶשְׁכְּבָ֣ה", "transliteral": "ʾeš-kə-ḇā", "traducao_palavra": "me deitarei" },
        { "hebraico": "וְאִישָׁ֑ן", "transliteral": "wə-ʾî-šān", "traducao_palavra": "e dormirei" },
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "porque" },
        { "hebraico": "אַתָּ֧ה", "transliteral": "ʾat-tā", "traducao_palavra": "Tu" },
        { "hebraico": "יְהוָ֛ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "לְבָדָ֥ד", "transliteral": "lə-ḇā-ḏāḏ", "traducao_palavra": "só/em particular" },
        { "hebraico": "לָבֶ֝֗טַח", "transliteral": "lā-ḇe-ṭaḥ", "traducao_palavra": "em segurança" },
        { "hebraico": "תֹּושִׁיבֵֽנִי׃", "transliteral": "tô-w-šî-ḇê-nî", "traducao_palavra": "fazes-me habitar" }
      ]
    }
  }
