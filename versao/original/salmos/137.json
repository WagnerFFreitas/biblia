        { "hebraico": "אֶת־", "transliteral": "ʾeṯ-", "traducao_palavra": "[objeto]" },
        { "hebraico": "צִיֹּֽון׃", "transliteral": "ṣiy-yôn", "traducao_palavra": "Sião" }
