        { "hebraico": "בָּבֶ֗ל", "transliteral": "bā-ḇel", "traducao_palavra": "Babilônia" },
        { "hebraico": "שָׁ֣ם", "transliteral": "šām", "traducao_palavra": "ali" },
        { "hebraico": "יָ֭שַׁבְנוּ", "transliteral": "yā-šaḇ-nû", "traducao_palavra": "nos assentamos" },
