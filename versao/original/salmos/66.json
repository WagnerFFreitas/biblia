        { "hebraico": "לֵ֭אלֹהִים", "transliteral": "lê-lō-hîm", "traducao_palavra": "a Deus" },
        { "hebraico": "מַה־", "transliteral": "mah-", "traducao_palavra": "quão" },
        { "hebraico": "נֹּורָ֣א", "transliteral": "nô-rā", "traducao_palavra": "tremendo" },
        { "hebraico": "מַעֲשֶׂ֑יךָ", "transliteral": "ma-ʿă-śey-ḵā", "traducao_palavra": "[nas] tuas obras" },
        { "hebraico": "בְּרֹ֥ב", "transliteral": "bə-rōḇ", "traducao_palavra": "pela abundância de" },
        { "hebraico": "עֻ֝זְּךָ֗", "transliteral": "uz-zə-ḵā", "traducao_palavra": "tua força" },
