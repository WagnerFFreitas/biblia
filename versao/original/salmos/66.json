        { "hebraico": "פָּצ֥וּ", "transliteral": "pā-ṣû", "traducao_palavra": "abriram/proferiram" },
        { "hebraico": "שְׂפָתָ֑י", "transliteral": "śə-p̄ā-ṯāy", "traducao_palavra": "meus lábios" },
        { "hebraico": "וְדִבֶּר־", "transliteral": "wə-ḏib-ber-", "traducao_palavra": "e falou" },
        { "hebraico": "פִּ֝י", "transliteral": "pî", "traducao_palavra": "minha boca" },
        { "hebraico": "בַּצַּר־", "transliteral": "baṣ-ṣar-", "traducao_palavra": "na angústia" },
