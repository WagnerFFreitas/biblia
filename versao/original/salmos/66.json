        { "hebraico": "בִּגְבוּרָתֹ֨ו ׀", "transliteral": "biḡ-ḇû-rā-ṯô", "traducao_palavra": "pelo seu poder" },
        { "hebraico": "עֹולָ֗ם", "transliteral": "ʿô-lām", "traducao_palavra": "eternamente" },
