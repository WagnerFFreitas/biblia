        { "hebraico": "אֱלֹהֵ֑ינוּ", "transliteral": "ʾĕ-lō-hê-nû", "traducao_palavra": "nosso Deus" },
        { "hebraico": "וְ֝הַשְׁמִ֗יעוּ", "transliteral": "wə-haš-mî-ʿû", "traducao_palavra": "e fazei ouvir" },
