        { "hebraico": "בֵיתְךָ֣", "transliteral": "ḇê-ṯə-ḵā", "traducao_palavra": "[em] tua casa" },
        { "hebraico": "בְעֹולֹ֑ות", "transliteral": "ḇə-ʿô-lôṯ", "traducao_palavra": "com holocaustos" },
