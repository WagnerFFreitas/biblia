        { "hebraico": "נְדָרָֽי׃", "transliteral": "nə-ḏā-rāy", "traducao_palavra": "meus votos" }
      ]
    },
    "14": {
      "traducao_completa": "Os quais proferiram os meus lábios, e falou a minha boca, quando estava na angústia.",
