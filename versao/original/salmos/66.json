        { "hebraico": "הַשָּׂ֣ם", "transliteral": "haś-śām", "traducao_palavra": "[o que] pôs/manteve" },
        { "hebraico": "נַ֭פְשֵׁנוּ", "transliteral": "nap̄-šê-nû", "traducao_palavra": "nossa alma" },
        { "hebraico": "בַּֽחַיִּ֑ים", "transliteral": "ba-ḥay-yîm", "traducao_palavra": "na vida" },
        { "hebraico": "וְלֹא־", "transliteral": "wə-lō-", "traducao_palavra": "e não" },
        { "hebraico": "נָתַ֖ן", "transliteral": "nā-ṯan", "traducao_palavra": "permitiu/deu" },
