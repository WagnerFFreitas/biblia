        { "hebraico": "לְךָ֥", "transliteral": "lə-ḵā", "traducao_palavra": "a ti" },
        { "hebraico": "אֹיְבֶֽיךָ׃", "transliteral": "ʾō-yə-ḇey-ḵā", "traducao_palavra": "teus inimigos" }
      ]
    },
    "4": {
      "traducao_completa": "Toda a terra te adorará e te salmodiará; salmodiarão o teu nome. (Selah)",
      "palavras": [
        { "hebraico": "כָּל־", "transliteral": "kāl-", "traducao_palavra": "toda" },
        { "hebraico": "הָאָ֤רֶץ ׀", "transliteral": "hā-ʾā-reṣ", "traducao_palavra": "a terra" },
        { "hebraico": "יִשְׁתַּחֲוּ֣וּ", "transliteral": "yiš-ta-ḥă-wû", "traducao_palavra": "adorarão" },
        { "hebraico": "לְ֭ךָ", "transliteral": "lə-ḵā", "traducao_palavra": "a ti" },
        { "hebraico": "וִֽיזַמְּרוּ־", "transliteral": "wî-zam-mə-rû-", "traducao_palavra": "e salmodiarão" },
