        { "hebraico": "הָ֤פַךְ", "transliteral": "hā-p̄aḵ", "traducao_palavra": "converteu/mudou" },
        { "hebraico": "יָ֨ם ׀", "transliteral": "yām", "traducao_palavra": "[o] mar" },
