        { "hebraico": "לְכֽוּ־", "transliteral": "lə-ḵû-", "traducao_palavra": "vinde" },
        { "hebraico": "שִׁמְע֣וּ", "transliteral": "šim-ʿû", "traducao_palavra": "ouvi" },
        { "hebraico": "וַ֭אֲסַפְּרָה", "transliteral": "wa-ʾă-sap-pə-rā", "traducao_palavra": "e eu contarei" },
