      "palavras": [
        { "hebraico": "לְכ֣וּ", "transliteral": "lə-ḵû", "traducao_palavra": "vinde" },
        { "hebraico": "וּ֭רְאוּ", "transliteral": "ū-rə-ʾû", "traducao_palavra": "e vede" },
        { "hebraico": "מִפְעֲלֹ֣ות", "transliteral": "mip̄-ʿă-lôṯ", "traducao_palavra": "as obras de" },
        { "hebraico": "אֱלֹהִ֑ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "Deus" },
