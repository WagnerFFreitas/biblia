      ]
    },
    "8": {
      "traducao_completa": "Bendizei, povos, ao nosso Deus, e fazei ouvir a voz do seu louvor;",
      "palavras": [
        { "hebraico": "בָּרֲכ֖וּ", "transliteral": "bā-ră-ḵû", "traducao_palavra": "bendizei" },
