        { "hebraico": "הָאָֽרֶץ׃", "transliteral": "hā-ʾā-reṣ", "traducao_palavra": "a terra" }
      ]
    },
    "2": {
      "traducao_completa": "Salmodiai a glória do seu nome; dai glória ao seu louvor.",
