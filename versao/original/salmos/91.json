{
  "livro": "Salmos - תְּהִלִּים - Tehillim",
  "capítulo": 91,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Aquele que habita no esconderijo do Altíssimo, à sombra do Onipotente descansará.",
      "palavras": [
        { "hebraico": "יֹ֭שֵׁב", "transliteral": "yō-šēḇ", "traducao_palavra": "[o que] habita" },
        { "hebraico": "בְּסֵ֣תֶר", "transliteral": "bə-śê-ṯer", "traducao_palavra": "no esconderijo de" },
        { "hebraico": "עֶלְיֹ֑ון", "transliteral": "ʿel-yôn", "traducao_palavra": "Altíssimo" },
        { "hebraico": "בְּצֵ֥ל", "transliteral": "bə-ṣēl", "traducao_palavra": "na sombra de" },
        { "hebraico": "שַׁ֝דַּ֗י", "transliteral": "šad-day", "traducao_palavra": "Onipotente" },
        { "hebraico": "יִתְלֹונָֽן׃", "transliteral": "yiṯ-lô-nān", "traducao_palavra": "pernoitará/descansará" }
      ]
    },
    "2": {
      "traducao_completa": "Direi de YHWH: Ele é o meu refúgio e a minha fortaleza; o meu Deus, em quem confio.",
      "palavras": [
        { "hebraico": "אֹמַ֗ר", "transliteral": "ʾō-mar", "traducao_palavra": "direi" },
        { "hebraico": "לַֽיהוָ֗ה", "transliteral": "lay-hwāh", "traducao_palavra": "a YHWH" },
        { "hebraico": "מַחְסִ֥י", "transliteral": "maḥ-śî", "traducao_palavra": "meu refúgio" },
        { "hebraico": "וּמְצוּדָתִ֑י", "transliteral": "ū-mə-ṣû-ḏā-ṯî", "traducao_palavra": "e minha fortaleza" },
        { "hebraico": "אֱ֝לֹהַ֗י", "transliteral": "ʾĕ-lō-hay", "traducao_palavra": "Deus meu" },
        { "hebraico": "אֶבְטַח־", "transliteral": "ʾeḇ-ṭaḥ-", "traducao_palavra": "confiarei" },
        { "hebraico": "בֹּֽו׃", "transliteral": "bô", "traducao_palavra": "nele" }
      ]
    },
    "3": {
      "traducao_completa": "Porque ele te livrará do laço do passarinheiro e da peste perniciosa.",
      "palavras": [
        { "hebraico": "כִּ֤י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "ה֣וּא", "transliteral": "hû", "traducao_palavra": "ele" },
        { "hebraico": "יַ֭צִּילְךָ", "transliteral": "yaṣ-ṣî-lə-ḵā", "traducao_palavra": "livrará te" },
        { "hebraico": "מִפַּ֥ח", "transliteral": "mip-paḥ", "traducao_palavra": "do laço de" },
        { "hebraico": "יָק֑וּשׁ", "transliteral": "yā-qûš", "traducao_palavra": "passarinheiro/caçador" },
        { "hebraico": "מִ֝דֶּ֗בֶר", "transliteral": "mid-de-ḇer", "traducao_palavra": "da peste de" },
        { "hebraico": "הַוֹּֽות׃", "transliteral": "haw-wôṯ", "traducao_palavra": "destruições/perniciosa" }
      ]
    },
    "4": {
      "traducao_completa": "Ele te cobrirá com as suas penas, e debaixo das suas asas te refugiarás; a sua verdade é escudo e broquel.",
      "palavras": [
        { "hebraico": "בְּאֶבְרָתֹ֨ו ׀", "transliteral": "bə-ʾeḇ-rā-ṯô", "traducao_palavra": "com a pena/asa dele" },
        { "hebraico": "יָ֤סֶךְ", "transliteral": "yā-seḵ", "traducao_palavra": "cobrirá" },
        { "hebraico": "לָ֗ךְ", "transliteral": "lāk", "traducao_palavra": "a ti" },
        { "hebraico": "וְתַֽחַת־", "transliteral": "wə-ṯa-ḥaṯ-", "traducao_palavra": "e debaixo de" },
        { "hebraico": "כְּנָפָ֥יו", "transliteral": "kə-nā-p̄āw", "traducao_palavra": "asas dele" },
        { "hebraico": "תֶּחְסֶ֑ה", "transliteral": "teḥ-seh", "traducao_palavra": "te refugiarás" },
        { "hebraico": "צִנָּ֖ה", "transliteral": "ṣin-nā", "traducao_palavra": "escudo grande" },
        { "hebraico": "וְֽסֹחֵרָ֗ה", "transliteral": "wə-śō-ḥē-rā", "traducao_palavra": "e broquel/muro" },
        { "hebraico": "אֲמִתֹּֽו׃", "transliteral": "ʾă-mit-tô", "traducao_palavra": "a verdade dele" }
      ]
    },
    "5": {
      "traducao_completa": "Não temerás o espanto noturno, nem a seta que voa de dia,",
      "palavras": [
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "תִ֭ירָא", "transliteral": "tî-rā", "traducao_palavra": "temerás" },
        { "hebraico": "מִפַּ֣חַד", "transliteral": "mip-pa-ḥaḏ", "traducao_palavra": "do pavor/terror" },
        { "hebraico": "לָ֑יְלָה", "transliteral": "lā-yə-lā", "traducao_palavra": "noturno" },
        { "hebraico": "מֵ֝חֵ֗ץ", "transliteral": "mē-ḥēṣ", "traducao_palavra": "da seta" },
        { "hebraico": "יָע֥וּד", "transliteral": "yā-ʿûḏ", "traducao_palavra": "[que] voa" },
        { "hebraico": "יֹומָֽם׃", "transliteral": "yô-mām", "traducao_palavra": "de dia" }
      ]
    },
    "6": {
      "traducao_completa": "Nem a peste que anda na escuridão, nem a mortandade que assola ao meio-dia.",
      "palavras": [
        { "hebraico": "מִ֭דֶּבֶר", "transliteral": "mid-de-ḇer", "traducao_palavra": "da peste" },
        { "hebraico": "בָּאֹ֣פֶל", "transliteral": "bā-ʾō-p̄el", "traducao_palavra": "na escuridão" },
        { "hebraico": "יַהֲלֹ֑ךְ", "transliteral": "ya-hă-lōḵ", "traducao_palavra": "[que] anda" },
        { "hebraico": "מִ֝קֶּ֗טֶב", "transliteral": "miq-qe-ṭeḇ", "traducao_palavra": "da destruição" },
        { "hebraico": "יָשׁ֥וּד", "transliteral": "yā-šûḏ", "traducao_palavra": "[que] devasta" },
        { "hebraico": "צָהֳרָֽיִם׃", "transliteral": "ṣā-ho-rā-yim", "traducao_palavra": "ao meio-dia" }
      ]
    },
    "7": {
      "traducao_completa": "Mil cairão ao teu lado, e dez mil à tua direita, mas não chegará a ti.",
      "palavras": [
        { "hebraico": "יִפֹּ֤ל", "transliteral": "yip-pōl", "traducao_palavra": "cairá" },
        { "hebraico": "מִצִּדְּךָ֨ ׀", "transliteral": "miṣ-ṣid-də-ḵā", "traducao_palavra": "ao teu lado" },
        { "hebraico": "אֶ֗לֶף", "transliteral": "ʾe-lep̄", "traducao_palavra": "mil" },
        { "hebraico": "וּרְבָבָ֥ה", "transliteral": "ū-rə-ḇā-ḇā", "traducao_palavra": "e dez mil/miríade" },
        { "hebraico": "מִימִינֶ֑ךָ", "transliteral": "mî-mî-ne-ḵā", "traducao_palavra": "à tua direita" },
        { "hebraico": "אֵ֝לֶיךָ", "transliteral": "ʾê-ley-ḵā", "traducao_palavra": "a ti" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "יִגָּֽשׁ׃", "transliteral": "yig-gāš", "traducao_palavra": "chegará" }
      ]
    },
    "8": {
      "traducao_completa": "Somente com os teus olhos contemplarás, e verás a recompensa dos ímpios.",
      "palavras": [
        { "hebraico": "רַ֭ק", "transliteral": "raq", "traducao_palavra": "somente" },
        { "hebraico": "בְּעֵינֶ֣יךָ", "transliteral": "bə-ʿê-ney-ḵā", "traducao_palavra": "com teus olhos" },
        { "hebraico": "תַבִּ֑יט", "transliteral": "ṯab-bîṭ", "traducao_palavra": "olharás/contemplarás" },
        { "hebraico": "וְשִׁלֻּמַ֖ת", "transliteral": "wə-šil-lu-maṯ", "traducao_palavra": "e a recompensa de" },
        { "hebraico": "רְשָׁעִ֣ים", "transliteral": "rə-šā-ʿîm", "traducao_palavra": "ímpios" },
        { "hebraico": "תִּרְאֶֽה׃", "transliteral": "tir-ʾeh", "traducao_palavra": "verás" }
      ]
    },
    "9": {
      "traducao_completa": "Porque tu, YHWH, és o meu refúgio. No Altíssimo fizeste a tua habitação.",
      "palavras": [
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "porque" },
        { "hebraico": "אַתָּ֣ה", "transliteral": "ʾat-tā", "traducao_palavra": "tu" },
        { "hebraico": "יְהוָ֣ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "מַחְסִ֑י", "transliteral": "maḥ-śî", "traducao_palavra": "meu refúgio" },
        { "hebraico": "עֶ֝לְיֹ֗ון", "transliteral": "ʿel-yôn", "traducao_palavra": "[no] Altíssimo" },
        { "hebraico": "שַׂ֣מְתָּ", "transliteral": "śam-tā", "traducao_palavra": "puseste/fizeste" },
        { "hebraico": "מְעֹונֶֽךָ׃", "transliteral": "mə-ʿô-ne-ḵā", "traducao_palavra": "tua habitação" }
      ]
    },
    "10": {
      "traducao_completa": "Nenhum mal te sucederá, nem praga alguma chegará à tua tenda.",
      "palavras": [
        { "hebraico": "לֹֽא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "תְאֻנֶּ֣ה", "transliteral": "ṯə-ʾun-neh", "traducao_palavra": "sucederá/ocorrerá" },
        { "hebraico": "אֵלֶ֣יךָ", "transliteral": "ʾê-ley-ḵā", "traducao_palavra": "a ti" },
        { "hebraico": "רָעָ֑ה", "transliteral": "rā-ʿā", "traducao_palavra": "mal" },
        { "hebraico": "וְ֝נֶ֗גַע", "transliteral": "wə-ne-ḡaʿ", "traducao_palavra": "e praga" },
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "יִקְרַ֥ב", "transliteral": "yiq-raḇ", "traducao_palavra": "chegará" },
        { "hebraico": "בְּאָהֳלֶֽךָ׃", "transliteral": "bə-ʾā-ho-le-ḵā", "traducao_palavra": "em tua tenda" }
      ]
    },
    "11": {
      "traducao_completa": "Porque aos seus anjos dará ordem a teu respeito, para te guardarem em todos os teus caminhos.",
      "palavras": [
        { "hebraico": "כִּ֣י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "מַ֭לְאָכָיו", "transliteral": "mal-ʾā-ḵāw", "traducao_palavra": "[aos] anjos dele" },
        { "hebraico": "יְצַוֶּה־", "transliteral": "yə-ṣaw-weh-", "traducao_palavra": "ordenará" },
        { "hebraico": "לָּ֑ךְ", "transliteral": "lāk", "traducao_palavra": "a ti" },
        { "hebraico": "לִ֝שְׁמָרְךָ֗", "transliteral": "liš-mā-rə-ḵā", "traducao_palavra": "para guardar te" },
        { "hebraico": "בְּכָל־", "transliteral": "bə-ḵāl-", "traducao_palavra": "em todos" },
        { "hebraico": "דְּרָכֶֽיךָ׃", "transliteral": "ḏə-rā-ḵey-ḵā", "traducao_palavra": "teus caminhos" }
      ]
    },
    "12": {
      "traducao_completa": "Eles te sustentarão nas suas mãos, para que não tropeces com o teu pé em pedra.",
      "palavras": [
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre" },
        { "hebraico": "כַּפַּ֥יִם", "transliteral": "kap-pa-yim", "traducao_palavra": "palmas/mãos" },
        { "hebraico": "יִשָּׂא֕וּנְךָ", "transliteral": "yiś-śā-ʾûn-ḵā", "traducao_palavra": "eles carregarão te" },
        { "hebraico": "פֶּן־", "transliteral": "pen-", "traducao_palavra": "para que não" },
        { "hebraico": "תִּגֹּ֥ף", "transliteral": "tig-gōp̄", "traducao_palavra": "tropeces/golpeies" },
        { "hebraico": "בָּאֶ֝בֶן", "transliteral": "bā-ʾe-ḇen", "traducao_palavra": "na pedra" },
        { "hebraico": "רַגְלֶֽךָ׃", "transliteral": "raḡ-le-ḵā", "traducao_palavra": "tua sola/pé" }
      ]
    },
    "13": {
      "traducao_completa": "Pisarás sobre o leão e a áspide; calcarás aos pés o filho do leão e a serpente.",
      "palavras": [
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre" },
        { "hebraico": "שַׁ֭חַל", "transliteral": "ša-ḥal", "traducao_palavra": "leão" },
        { "hebraico": "וָפֶ֣תֶן", "transliteral": "wā-p̄e-ṯen", "traducao_palavra": "e áspide/víbora" },
        { "hebraico": "תִּדְרֹ֑ךְ", "transliteral": "tiḏ-rōḵ", "traducao_palavra": "pisarás" },
        { "hebraico": "תִּרְמֹ֥ס", "transliteral": "tir-mōs", "traducao_palavra": "pisotearás" },
        { "hebraico": "כְּ֝פִיר", "transliteral": "kə-p̄îr", "traducao_palavra": "leão novo" },
        { "hebraico": "וְתַנִּֽין׃", "transliteral": "wə-ṯan-nîn", "traducao_palavra": "e serpente/monstro" }
      ]
    },
    "14": {
      "traducao_completa": "Porquanto tão encarecidamente me amou, também eu o livrarei; pô-lo-ei em retiro alto, porque conheceu o meu nome.",
      "palavras": [
        { "hebraico": "כִּ֤י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "בִ֣י", "transliteral": "ḇî", "traducao_palavra": "em mim" },
        { "hebraico": "חָ֭שַׁק", "transliteral": "ḥā-šaq", "traducao_palavra": "apegou-se/amou" },
        { "hebraico": "וַאֲפַלְּטֵ֑הוּ", "transliteral": "wa-ʾă-p̄al-lə-ṭê-hû", "traducao_palavra": "e eu o livrarei" },
        { "hebraico": "אֲ֝שַׂגְּבֵ֗הוּ", "transliteral": "ʾă-śag-gə-ḇê-hû", "traducao_palavra": "eu o porei no alto" },
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "porque" },
        { "hebraico": "יָדַ֥ע", "transliteral": "yā-ḏaʿ", "traducao_palavra": "conheceu" },
        { "hebraico": "שְׁמִֽי׃", "transliteral": "šə-mî", "traducao_palavra": "meu nome" }
      ]
    },
    "15": {
      "traducao_completa": "Ele me invocará, e eu lhe responderei; estarei com ele na angústia; dela o retirarei, e o glorificarei.",
      "palavras": [
        { "hebraico": "יִקְרָאֵ֨נִי ׀", "transliteral": "yiq-rā-ʾê-nî", "traducao_palavra": "invocará me" },
        { "hebraico": "וְאֶֽעֱנֵ֗הוּ", "transliteral": "wə-ʾe-ʿĕ-nê-hû", "traducao_palavra": "e responderei a ele" },
        { "hebraico": "עִמֹּו־", "transliteral": "ʿim-mô-", "traducao_palavra": "com ele" },
        { "hebraico": "אָנֹכִ֥י", "transliteral": "ʾā-nō-ḵî", "traducao_palavra": "eu [estarei]" },
        { "hebraico": "בְצָרָ֑ה", "transliteral": "ḇə-ṣā-rā", "traducao_palavra": "na angústia" },
        { "hebraico": "אֲ֝חַלְּצֵ֗הוּ", "transliteral": "ʾă-ḥal-lə-ṣê-hû", "traducao_palavra": "eu o livrarei" },
        { "hebraico": "וַאֲכַבְּדֵֽהוּ׃", "transliteral": "wa-ʾă-ḵab-bə-ḏê-hû", "traducao_palavra": "e o honrarei/glorificarei" }
      ]
    },
    "16": {
      "traducao_completa": "Fartá-lo-ei com longura de dias, e lhe mostrarei a minha salvação.",
      "palavras": [
        { "hebraico": "אֹ֣רֶךְ", "transliteral": "ʾō-reḵ", "traducao_palavra": "comprimento de" },
        { "hebraico": "יָ֭מִים", "transliteral": "yā-mîm", "traducao_palavra": "dias" },
        { "hebraico": "אַשְׂבִּיעֵ֑הוּ", "transliteral": "ʾaś-bî-ʿê-hû", "traducao_palavra": "fartarei ele" },
        { "hebraico": "וְ֝אַרְאֵ֗הוּ", "transliteral": "wə-ʾar-ʾê-hû", "traducao_palavra": "e mostrarei a ele" },
        { "hebraico": "בִּֽישׁוּעָתִֽי׃", "transliteral": "bî-šû-ʿā-ṯî", "traducao_palavra": "na minha salvação" }
      ]
    }
  }
}