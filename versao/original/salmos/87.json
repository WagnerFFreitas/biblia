{
  "livro": "Salmos - תְּהִלִּים - Tehillim",
  "capítulo": 87,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "O seu fundamento está nos montes santos.",
      "palavras": [
        { "hebraico": "יְסוּדָתֹו", "transliteral": "yə-śû-ḏā-ṯô", "traducao_palavra": "o seu fundamento" },
        { "hebraico": "בְּהַרְרֵי־", "transliteral": "bə-har-rê-", "traducao_palavra": "nos montes de" },
        { "hebraico": "קֹֽדֶשׁ׃", "transliteral": "qō-ḏeš", "traducao_palavra": "santidade" }
      ]
    },
    "2": {
      "traducao_completa": "YHWH ama as portas de Sião, mais do que todas as habitações de Jacó.",
      "palavras": [
        { "hebraico": "אֹ֭הֵב", "transliteral": "ʾō-hēḇ", "traducao_palavra": "ama" },
        { "hebraico": "יְהוָ֣ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "שַׁעֲרֵ֣י", "transliteral": "ša-ʿă-rê", "traducao_palavra": "as portas de" },
        { "hebraico": "צִיֹּ֑ון", "transliteral": "ṣiy-yôn", "traducao_palavra": "Sião" },
        { "hebraico": "מִ֝כֹּ֗ל", "transliteral": "mik-kōl", "traducao_palavra": "mais do que todas" },
        { "hebraico": "מִשְׁכְּנֹ֥ות", "transliteral": "miš-kə-nôṯ", "traducao_palavra": "as habitações de" },
        { "hebraico": "יַעֲקֹֽב׃", "transliteral": "ya-ʿă-qōḇ", "traducao_palavra": "Jacó" }
      ]
    },
    "3": {
      "traducao_completa": "Coisas gloriosas se dizem de ti, ó cidade de Deus. (Selah)",
      "palavras": [
        { "hebraico": "נִכְבָּדֹ֥ות", "transliteral": "niḵ-bā-ḏôṯ", "traducao_palavra": "coisas gloriosas" },
        { "hebraico": "מְדֻבָּ֣ר", "transliteral": "mə-ḏub-bār", "traducao_palavra": "são faladas" },
        { "hebraico": "בָּ֑ךְ", "transliteral": "bāḵ", "traducao_palavra": "de ti" },
        { "hebraico": "עִ֖יר", "transliteral": "ʿîr", "traducao_palavra": "ó cidade de" },
        { "hebraico": "הָאֱלֹהִ֣ים", "transliteral": "hā-ʾĕ-lō-hîm", "traducao_palavra": "Deus" },
        { "hebraico": "סֶֽלָה׃", "transliteral": "se-lā", "traducao_palavra": "Selah [pausa]" }
      ]
    },
    "4": {
      "traducao_completa": "Mencionarei Raabe e Babilônia entre os que me conhecem; eis a Filístia e Tiro, com a Etiópia; este nasceu ali.",
      "palavras": [
        { "hebraico": "אַזְכִּ֤יר", "transliteral": "ʾaz-kîr", "traducao_palavra": "mencionarei/lembrarei" },
        { "hebraico": "רַ֥הַב", "transliteral": "ra-haḇ", "traducao_palavra": "Raabe [Egito]" },
        { "hebraico": "וּבָבֶ֨ל", "transliteral": "ū-ḇā-ḇel", "traducao_palavra": "e Babilônia" },
        { "hebraico": "לְיֹ֫דְעָ֥י", "transliteral": "lə-yō-ḏə-ʿāy", "traducao_palavra": "para os que me conhecem" },
        { "hebraico": "הִנֵּ֤ה", "transliteral": "hin-nēh", "traducao_palavra": "eis" },
        { "hebraico": "פְלֶ֣שֶׁת", "transliteral": "p̄ə-le-šeṯ", "traducao_palavra": "Filístia" },
        { "hebraico": "וְצֹ֣ור", "transliteral": "wə-ṣôr", "traducao_palavra": "e Tiro" },
        { "hebraico": "עִם־", "transliteral": "ʿim-", "traducao_palavra": "com" },
        { "hebraico": "כּ֑וּשׁ", "transliteral": "kûš", "traducao_palavra": "Etiópia/Cuxe" },
        { "hebraico": "זֶ֝֗ה", "transliteral": "zeh", "traducao_palavra": "este" },
        { "hebraico": "יֻלַּד־", "transliteral": "yul-laḏ-", "traducao_palavra": "foi nado/nasceu" },
        { "hebraico": "שָֽׁם׃", "transliteral": "šām", "traducao_palavra": "ali" }
      ]
    },
    "5": {
      "traducao_completa": "E de Sião se dirá: Este e aquele nasceram nela; e o próprio Altíssimo a estabelecerá.",
      "palavras": [
        { "hebraico": "וּֽלְצִיֹּ֨ון", "transliteral": "ū-lə-ṣiy-yôn", "traducao_palavra": "e de Sião" },
        { "hebraico": "יֵאָמַ֗ר", "transliteral": "yē-ʾā-mar", "traducao_palavra": "será dito" },
        { "hebraico": "אִ֣ישׁ", "transliteral": "ʾîš", "traducao_palavra": "homem" },
        { "hebraico": "וְ֭אִישׁ", "transliteral": "wə-ʾîš", "traducao_palavra": "e homem" },
        { "hebraico": "יֻלַּד־", "transliteral": "yul-laḏ-", "traducao_palavra": "nasceu" },
        { "hebraico": "בָּ֑הּ", "transliteral": "bāh", "traducao_palavra": "nela" },
        { "hebraico": "וְה֥וּא", "transliteral": "wə-hû", "traducao_palavra": "e ele" },
        { "hebraico": "יְכֹונְנֶ֝הָ", "transliteral": "yə-ḵô-nə-ne-hā", "traducao_palavra": "estabelecerá ela" },
        { "hebraico": "עֶלְיֹֽון׃", "transliteral": "ʿel-yôn", "traducao_palavra": "[o] Altíssimo" }
      ]
    },
    "6": {
      "traducao_completa": "YHWH, ao registrar os povos, dirá: Este nasceu ali. (Selah)",
      "palavras": [
        { "hebraico": "יְֽהוָ֗ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "יִ֭סְפֹּר", "transliteral": "yis-pōr", "traducao_palavra": "contará/registrará" },
        { "hebraico": "בִּכְתֹ֣וב", "transliteral": "biḵ-ṯôḇ", "traducao_palavra": "ao inscrever" },
        { "hebraico": "עַמִּ֑ים", "transliteral": "ʿam-mîm", "traducao_palavra": "[os] povos" },
        { "hebraico": "זֶ֝֗ה", "transliteral": "zeh", "traducao_palavra": "este" },
        { "hebraico": "יֻלַּד־", "transliteral": "yul-laḏ-", "traducao_palavra": "nasceu" },
        { "hebraico": "שָׁ֥ם", "transliteral": "šām", "traducao_palavra": "ali" },
        { "hebraico": "סֶֽלָה׃", "transliteral": "se-lā", "traducao_palavra": "Selah" }
      ]
    },
    "7": {
      "traducao_completa": "Tanto os cantores como os tocadores de flauta dirão: Todas as minhas fontes estão em ti.",
      "palavras": [
        { "hebraico": "וְשָׁרִ֥ים", "transliteral": "wə-šā-rîm", "traducao_palavra": "e cantores" },
        { "hebraico": "כְּחֹלְלִ֑ים", "transliteral": "kə-ḥō-lə-lîm", "traducao_palavra": "como tocadores de instrumentos/dançarinos" },
        { "hebraico": "כָּל־", "transliteral": "kāl-", "traducao_palavra": "todas" },
        { "hebraico": "מַעְיָנַ֥י", "transliteral": "ma-ʿyā-nay", "traducao_palavra": "minhas fontes" },
        { "hebraico": "בָּֽךְ׃", "transliteral": "bāḵ", "traducao_palavra": "[estão] em ti" }
      ]
    }
  }
