        { "hebraico": "מְרֵעִים֮", "transliteral": "mə-rē-ʿîm", "traducao_palavra": "malfeitores" },
        { "hebraico": "לֶאֱכֹ֪ל", "transliteral": "le-ʾĕ-ḵōl", "traducao_palavra": "para comer" },
        { "hebraico": "אֶת־בְּשָׂ֫רִ֥י", "transliteral": "ʾeṯ-bə-śā-rî", "traducao_palavra": "a minha carne" },
        { "hebraico": "צָרַ֣י", "transliteral": "ṣā-ray", "traducao_palavra": "meus adversários" },
        { "hebraico": "וְאֹיְבַ֣י", "transliteral": "wə-ʾō-yə-ḇay", "traducao_palavra": "e meus inimigos" },
