    "10": {
      "traducao_completa": "Pois a tua misericórdia é grande até aos céus, e a tua verdade até às nuvens.",
      "palavras": [
        { "hebraico": "כִּֽי־גָדֹ֣ל", "transliteral": "kî-ḡā-ḏōl", "traducao_palavra": "pois grande [é]" },
