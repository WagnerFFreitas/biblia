{
  "livro": "Salmos - תְּהִלִּים - Tehillim",
  "capítulo": 57,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Tem misericórdia de mim, ó Deus, tem misericórdia de mim, pois a minha alma se refugia em ti; à sombra das tuas asas me refugiarei, até que passem as calamidades.",
      "palavras": [
        { "hebraico": "חָנֵּ֣נִי", "transliteral": "ḥān-nē-nî", "traducao_palavra": "tem piedade de mim" },
        { "hebraico": "אֱלֹהִ֣ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "ó Deus" },
        { "hebraico": "חָ֭נֵּנִי", "transliteral": "ḥān-nē-nî", "traducao_palavra": "tem piedade de mim" },
        { "hebraico": "כִּ֥י", "transliteral": "kî", "traducao_palavra": "pois" },
        { "hebraico": "בְךָ֮", "transliteral": "ḇə-ḵā", "traducao_palavra": "em ti" },
        { "hebraico": "חָסָ֪יָה", "transliteral": "ḥā-śā-yā", "traducao_palavra": "se refugiou" },
        { "hebraico": "נַ֫פְשִׁ֥י", "transliteral": "nap̄-šî", "traducao_palavra": "minha alma" },
        { "hebraico": "וּבְצֵל־", "transliteral": "ū-ḇə-ṣēl-", "traducao_palavra": "e na sombra de" },
        { "hebraico": "כְּנָפֶ֥יךָ", "transliteral": "kə-nā-p̄ê-ḵā", "traducao_palavra": "tuas asas" },
        { "hebraico": "אֶחְסֶ֑ה", "transliteral": "ʾeḥ-seh", "traducao_palavra": "me refugiarei" },
        { "hebraico": "עַ֝ד", "transliteral": "ʿaḏ", "traducao_palavra": "até [que]" },
        { "hebraico": "יַעֲבֹ֥ר", "transliteral": "ya-ʿă-ḇōr", "traducao_palavra": "passem" },
        { "hebraico": "הַוֹּֽות׃", "transliteral": "haw-wôṯ", "traducao_palavra": "as calamidades/maldades" }
      ]
    },
    "2": {
      "traducao_completa": "Clamarei ao Deus Altíssimo, ao Deus que por mim tudo aperfeiçoa.",
      "palavras": [
        { "hebraico": "אֶקְרָ֥א", "transliteral": "ʾeq-rā", "traducao_palavra": "clamarei" },
        { "hebraico": "לֵאלֹהִ֣ים", "transliteral": "lê-lō-hîm", "traducao_palavra": "ao Deus" },
        { "hebraico": "עֶלְיֹ֑ון", "transliteral": "ʿel-yôn", "traducao_palavra": "Altíssimo" },
        { "hebraico": "לָ֝אֵ֗ל", "transliteral": "lā-ʾēl", "traducao_palavra": "ao Deus" },
        { "hebraico": "גֹּמֵ֥ר", "transliteral": "gō-mēr", "traducao_palavra": "[que] completa/aperfeiçoa" },
        { "hebraico": "עָלָֽי׃", "transliteral": "ʿā-lāy", "traducao_palavra": "por mim" }
      ]
    },
    "3": {
      "traducao_completa": "Ele enviará dos céus e me salvará do desprezo daquele que me quer devorar. (Selah) Deus enviará a sua misericórdia e a sua verdade.",
      "palavras": [
        { "hebraico": "יִשְׁלַ֤ח", "transliteral": "yiš-laḥ", "traducao_palavra": "ele enviará" },
        { "hebraico": "מִשָּׁמַ֨יִם", "transliteral": "miš-šā-ma-yim", "traducao_palavra": "desde os céus" },
        { "hebraico": "וְיֹושִׁיאֵ֗נִי", "transliteral": "wə-yô-šî-ʿē-nî", "traducao_palavra": "e me salvará" },
        { "hebraico": "חֵרֵ֣ף", "transliteral": "ḥē-rēp̄", "traducao_palavra": "[do] desprezo de" },
        { "hebraico": "שֹׁאֲפִ֣י", "transliteral": "šō-ʾă-p̄î", "traducao_palavra": "quem me devora" },
        { "hebraico": "סֶ֑לָה", "transliteral": "śe-lā", "traducao_palavra": "Selah" },
        { "hebraico": "יִשְׁלַ֥ח", "transliteral": "yiš-laḥ", "traducao_palavra": "enviará" },
        { "hebraico": "אֱ֝לֹהִ֗ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "Deus" },
        { "hebraico": "חַסְדֹּ֥ו", "transliteral": "ḥas-dô", "traducao_palavra": "sua misericórdia" },
        { "hebraico": "וַאֲמִתֹּֽו׃", "transliteral": "wa-ʾă-mit-tô", "traducao_palavra": "e sua verdade" }
      ]
    },
    "4": {
      "traducao_completa": "A minha alma está entre leões; deito-me entre os que vertem fogo, os filhos dos homens, cujos dentes são lanças e flechas, e cuja língua é espada afiada.",
      "palavras": [
        { "hebraico": "נַפְשִׁ֨י", "transliteral": "nap̄-šî", "traducao_palavra": "minha alma" },
        { "hebraico": "בְּ֭תֹוךְ", "transliteral": "bə-ṯôḵ", "traducao_palavra": "no meio de" },
        { "hebraico": "לְבָאִם֮", "transliteral": "lə-ḇā-ʾim", "traducao_palavra": "leões" },
        { "hebraico": "אֶשְׁכְּבָ֪ה", "transliteral": "ʾeš-kə-ḇā", "traducao_palavra": "deito-me" },
        { "hebraico": "לֹ֫הֲטִ֥ים", "transliteral": "lō-hă-ṭîm", "traducao_palavra": "[entre os que] devoram/incendeiam" },
        { "hebraico": "בְּנֵי־אָדָ֗ם", "transliteral": "bə-nê-ʾā-ḏām", "traducao_palavra": "filhos de homens" },
        { "hebraico": "שִׁ֭נֵּיהֶם", "transliteral": "šin-nê-hem", "traducao_palavra": "dentes deles" },
        { "hebraico": "חֲנִ֣ית", "transliteral": "ḥă-nîṯ", "traducao_palavra": "[são] lança" },
        { "hebraico": "וְחִצִּ֑ים", "transliteral": "wə-ḥiṣ-ṣîm", "traducao_palavra": "e flechas" },
        { "hebraico": "וּ֝לְשֹׁונָ֗ם", "transliteral": "ū-lə-šô-nām", "traducao_palavra": "e a língua deles" },
        { "hebraico": "חֶ֣רֶב", "transliteral": "ḥe-reḇ", "traducao_palavra": "espada" },
        { "hebraico": "חַדָּֽה׃", "transliteral": "ḥad-dā", "traducao_palavra": "afiada" }
      ]
    },
    "5": {
      "traducao_completa": "Sê exaltado, ó Deus, sobre os céus; e seja a tua glória sobre toda a terra.",
      "palavras": [
        { "hebraico": "ר֤וּמָה", "transliteral": "rû-mā", "traducao_palavra": "exalta-te/sê exaltado" },
        { "hebraico": "עַל־הַשָּׁמַ֣יִם", "transliteral": "ʿal-haš-šā-ma-yim", "traducao_palavra": "sobre os céus" },
        { "hebraico": "אֱלֹהִ֑ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "ó Deus" },
        { "hebraico": "עַ֖ל", "transliteral": "ʿal", "traducao_palavra": "sobre" },
        { "hebraico": "כָּל־הָאָ֣רֶץ", "transliteral": "kāl-hā-ʾā-reṣ", "traducao_palavra": "toda a terra" },
        { "hebraico": "כְּḇֹודֶֽךָ׃", "transliteral": "kə-ḇô-ḏe-ḵā", "traducao_palavra": "tua glória" }
      ]
    },
    "6": {
      "traducao_completa": "Prepararam uma rede para os meus passos; a minha alma ficou abatida; cavaram uma cova diante de mim, mas eles mesmos caíram no meio dela. (Selah)",
      "palavras": [
        { "hebraico": "רֶ֤שֶׁת", "transliteral": "re-šeṯ", "traducao_palavra": "[uma] rede" },
        { "hebraico": "הֵ֘כִ֤ינוּ", "transliteral": "hē-ḵî-nû", "traducao_palavra": "prepararam" },
        { "hebraico": "לִפְעָמַ֗י", "transliteral": "lip̄-ʿā-may", "traducao_palavra": "para meus passos" },
        { "hebraico": "כָּפַ֥ף", "transliteral": "kā-p̄ap̄", "traducao_palavra": "encurvou-se/abateu-se" },
        { "hebraico": "נַפְשִׁ֑י", "transliteral": "nap̄-šî", "traducao_palavra": "minha alma" },
        { "hebraico": "כָּר֨וּ", "transliteral": "kā-rû", "traducao_palavra": "cavaram" },
        { "hebraico": "לְפָנַ֥י", "transliteral": "lə-p̄ā-nay", "traducao_palavra": "diante de mim" },
        { "hebraico": "שִׁיחָ֗ה", "transliteral": "šî-ḥā", "traducao_palavra": "[uma] cova" },
        { "hebraico": "נָפְל֥וּ", "transliteral": "nā-p̄ə-lû", "traducao_palavra": "caíram" },
        { "hebraico": "בְתֹוכָ֥הּ", "transliteral": "ḇə-ṯô-ḵāh", "traducao_palavra": "no meio dela" },
        { "hebraico": "סֶּֽלָה׃", "transliteral": "śe-lā", "traducao_palavra": "Selah" }
      ]
    },
    "7": {
      "traducao_completa": "Preparado está o meu coração, ó Deus, preparado está o meu coração; cantarei e louvarei.",
      "palavras": [
        { "hebraico": "נָ֘כֹ֤ון", "transliteral": "nā-ḵôn", "traducao_palavra": "firmado/preparado" },
        { "hebraico": "לִבִּ֨י", "transliteral": "lib-bî", "traducao_palavra": "meu coração" },
        { "hebraico": "אֱלֹהִ֗ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "ó Deus" },
        { "hebraico": "נָ֭כֹון", "transliteral": "nā-ḵôn", "traducao_palavra": "firmado" },
        { "hebraico": "לִבִּ֑י", "transliteral": "lib-bî", "traducao_palavra": "meu coração" },
        { "hebraico": "אָ֝שִׁ֗ירָה", "transliteral": "ʾā-šî-rā", "traducao_palavra": "cantarei" },
        { "hebraico": "וַאֲזַמֵּֽרָה׃", "transliteral": "wa-ʾă-zam-mē-rā", "traducao_palavra": "e salmodiarei" }
      ]
    },
    "8": {
      "traducao_completa": "Desperta, glória minha; despertai, saltério e harpa; eu mesmo despertarei a aurora.",
      "palavras": [
        { "hebraico": "ע֤וּרָה", "transliteral": "ʿû-rā", "traducao_palavra": "desperta" },
        { "hebraico": "כְḇֹודִ֗י", "transliteral": "ḵə-ḇô-ḏî", "traducao_palavra": "minha glória/alma" },
        { "hebraico": "ע֭וּרָה", "transliteral": "ʿû-rā", "traducao_palavra": "desperta" },
        { "hebraico": "הַנֵּ֥בֶל", "transliteral": "han-nē-ḇel", "traducao_palavra": "o saltério/lira" },
        { "hebraico": "וְכִנֹּ֑ור", "transliteral": "wə-ḵin-nôr", "traducao_palavra": "e harpa" },
        { "hebraico": "אָעִ֥ירָה", "transliteral": "ʾā-ʿî-rā", "traducao_palavra": "despertarei" },
        { "hebraico": "שָּֽׁחַר׃", "transliteral": "šā-ḥar", "traducao_palavra": "[a] aurora" }
      ]
    },
    "9": {
      "traducao_completa": "Louvar-te-ei, Senhor, entre os povos; cantar-te-ei louvores entre as nações.",
      "palavras": [
        { "hebraico": "אֹודְךָ֤", "transliteral": "ʾô-ḏə-ḵā", "traducao_palavra": "louvar-te-ei" },
        { "hebraico": "בָעַמִּ֨ים", "transliteral": "ḇā-ʿam-mîm", "traducao_palavra": "entre os povos" },
        { "hebraico": "אֲדֹנָ֑י", "transliteral": "ʾă-ḏō-nāy", "traducao_palavra": "Senhor" },
        { "hebraico": "אֲ֝זַמֶּרְךָ֗", "transliteral": "ʾă-zam-mer-ḵā", "traducao_palavra": "salmodiarei a ti" },
        { "hebraico": "בַּל־אֻמִּֽים׃", "transliteral": "bal-ʾum-mîm", "traducao_palavra": "entre as nações" }
