{
  "livro": "Salmos - תְּהִלִּים - Tehillim",
  "capítulo": 88,
  "titulos": {
    "1": "Cântico. Salmo para os filhos de Corá. Ao mestre de canto. Segundo Maalate Leanote. Masquil de Hemã, o ezraíta."
  },
  "versiculos": {
    "1": {
      "traducao_completa": "YHWH, Deus da minha salvação, de dia clamei e de noite perante ti.",
      "palavras": [
        { "hebraico": "יְהוָה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "אֱלֹהֵי", "transliteral": "ʾĕlōhê", "traducao_palavra": "Deus de" },
        { "hebraico": "יְשׁוּעָתִי", "transliteral": "yəšûʿāṯî", "traducao_palavra": "minha salvação" },
        { "hebraico": "יֹום־", "transliteral": "yôm-", "traducao_palavra": "de dia" },
        { "hebraico": "צָעַקְתִּי", "transliteral": "ṣāʿaqtî", "traducao_palavra": "clamei" },
        { "hebraico": "בַלַּיְלָה", "transliteral": "ballaylā", "traducao_palavra": "na noite" },
        { "hebraico": "נֶגְדֶּךָ׃", "transliteral": "neḡdeḵā", "traducao_palavra": "perante ti" }
      ]
    },
    "2": {
      "traducao_completa": "Chegue a minha oração perante a tua face; inclina o teu ouvido ao meu clamor.",
      "palavras": [
        { "hebraico": "תָּבֹוא", "transliteral": "tāḇô", "traducao_palavra": "venha/chegue" },
        { "hebraico": "לְפָנֶיךָ", "transliteral": "ləp̄āneyḵā", "traducao_palavra": "perante ti/tua face" },
        { "hebraico": "תְּפִלָּתִי", "transliteral": "ṯəp̄illāṯî", "traducao_palavra": "minha oração" },
        { "hebraico": "הַטֵּה־", "transliteral": "haṭṭēh-", "traducao_palavra": "inclina" },
        { "hebraico": "אָזְנְךָ", "transliteral": "ʾāznəḵā", "traducao_palavra": "teu ouvido" },
        { "hebraico": "לְרִנָּתִי׃", "transliteral": "lərināṯî", "traducao_palavra": "ao meu clamor" }
      ]
    },
    "3": {
      "traducao_completa": "Porque a minha alma está farta de males, e a minha vida se aproxima do Sheol.",
      "palavras": [
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "porque" },
        { "hebraico": "שָׂבְעָה", "transliteral": "śāḇəʿā", "traducao_palavra": "fartou-se" },
        { "hebraico": "בְרָעֹות", "transliteral": "ḇərāʿôṯ", "traducao_palavra": "de males" },
        { "hebraico": "נַפְשִׁי", "transliteral": "nap̄šî", "traducao_palavra": "minha alma" },
        { "hebraico": "וְחַיַּי", "transliteral": "wəḥayyay", "traducao_palavra": "e minha vida" },
        { "hebraico": "לִשְׁאֹול", "transliteral": "lišʾôl", "traducao_palavra": "ao Sheol" },
        { "hebraico": "הִגִּיעוּ׃", "transliteral": "higîʿû", "traducao_palavra": "chegaram" }
      ]
    },
    "4": {
      "traducao_completa": "Já sou contado com os que descem à cova; sou como um homem sem forças,",
      "palavras": [
        { "hebraico": "נֶחְשַׁבְתִּי", "transliteral": "neḥšaḇtî", "traducao_palavra": "fui contado/reputado" },
        { "hebraico": "עִם־", "transliteral": "ʿim-", "traducao_palavra": "com" },
        { "hebraico": "יֹורְדֵי", "transliteral": "yôrəḏê", "traducao_palavra": "[os que] descem" },
        { "hebraico": "בֹור", "transliteral": "ḇôr", "traducao_palavra": "[à] cova" },
        { "hebraico": "הָיִיתִי", "transliteral": "hāyîṯî", "traducao_palavra": "tornei-me" },
        { "hebraico": "כְּגֶבֶר", "transliteral": "kəḡeḇer", "traducao_palavra": "como homem" },
        { "hebraico": "אֵֽין־", "transliteral": "ʾên-", "traducao_palavra": "sem [que não há]" },
        { "hebraico": "אֱיָֽל׃", "transliteral": "ʾĕyāl", "traducao_palavra": "força/ajuda" }
      ]
    },
    "5": {
      "traducao_completa": "Abandonado entre os mortos, como os feridos que jazem na sepultura, dos quais não te lembras mais, e que são cortados da tua mão.",
      "palavras": [
        { "hebraico": "בַּמֵּתִים", "transliteral": "bammēṯîm", "traducao_palavra": "entre os mortos" },
        { "hebraico": "חָפְשִׁי", "transliteral": "ḥop̄šî", "traducao_palavra": "livre/abandonado" },
        { "hebraico": "כְּמֹו", "transliteral": "kəmô", "traducao_palavra": "como" },
        { "hebraico": "חֲלָלִים", "transliteral": "ḥălālîm", "traducao_palavra": "feridos/traspassados" },
        { "hebraico": "שֹׁכְבֵי", "transliteral": "šōḵəḇê", "traducao_palavra": "que jazem em" },
        { "hebraico": "קֶבֶר", "transliteral": "qeḇer", "traducao_palavra": "sepultura" },
        { "hebraico": "אֲשֶׁר", "transliteral": "ʾăšer", "traducao_palavra": "dos quais" },
        { "hebraico": "לֹא", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "זְכַרְתָּם", "transliteral": "zəḵartām", "traducao_palavra": "tu te lembras deles" },
        { "hebraico": "עֹוד", "transliteral": "ʿôḏ", "traducao_palavra": "mais" },
        { "hebraico": "וְהֵמָּה", "transliteral": "wəhēmmā", "traducao_palavra": "e eles" },
        { "hebraico": "מִיָּדְךָ", "transliteral": "miyyādəḵā", "traducao_palavra": "da tua mão" },
        { "hebraico": "נִגְזָֽרוּ׃", "transliteral": "niḡzārû", "traducao_palavra": "foram cortados" }
      ]
    },
    "6": {
      "traducao_completa": "Puseste-me na cova mais profunda, em trevas, nas profundezas.",
      "palavras": [
        { "hebraico": "שַׁתַּנִי", "transliteral": "šattanî", "traducao_palavra": "puseste-me" },
        { "hebraico": "בְּבֹור", "transliteral": "bəḇôr", "traducao_palavra": "no poço/cova de" },
        { "hebraico": "תַּחְתִּיֹּות", "transliteral": "taḥtiyyôṯ", "traducao_palavra": "profundezas" },
        { "hebraico": "בְּמַחֲשַׁכִּים", "transliteral": "bəmaḥăšakkîm", "traducao_palavra": "em trevas" },
        { "hebraico": "בִּמְצֹלֹֽות׃", "transliteral": "bimṣōlôṯ", "traducao_palavra": "nos abismos/profundezas" }
      ]
    },
    "7": {
      "traducao_completa": "Sobre mim pesa o teu furor; tu me afligiste com todas as tuas ondas. (Selah)",
      "palavras": [
        { "hebraico": "עָלַי", "transliteral": "ʿālay", "traducao_palavra": "sobre mim" },
        { "hebraico": "סָמְכָה", "transliteral": "śāməḵā", "traducao_palavra": "apoiou-se/pesou" },
        { "hebraico": "חֲמָתֶךָ", "transliteral": "ḥămāṯeḵā", "traducao_palavra": "tua fúria/ira" },
        { "hebraico": "וְכָל־", "transliteral": "wəḵāl-", "traducao_palavra": "e com todas" },
        { "hebraico": "מִשְׁבָּרֶיךָ", "transliteral": "mišbāreyḵā", "traducao_palavra": "tuas ondas/vagas" },
        { "hebraico": "עִנִּיתָ", "transliteral": "ʿinnîṯā", "traducao_palavra": "afligiste" },
        { "hebraico": "סֶּֽלָה׃", "transliteral": "selā", "traducao_palavra": "Selah" }
      ]
    },
    "8": {
      "traducao_completa": "Apartaste de mim os meus conhecidos; fizeste-me abominável para eles; estou preso, e não posso sair.",
      "palavras": [
        { "hebraico": "הִרְחַקְתָּ", "transliteral": "hirḥaqtā", "traducao_palavra": "afastaste" },
        { "hebraico": "מְיֻדָּעַי", "transliteral": "məyuddāʿay", "traducao_palavra": "meus conhecidos" },
        { "hebraico": "מִמֶּנִּי", "transliteral": "mimmennî", "traducao_palavra": "de mim" },
        { "hebraico": "שַׁתַּנִי", "transliteral": "šattanî", "traducao_palavra": "puseste-me" },
        { "hebraico": "תֹועֵבֹות", "transliteral": "ṯôʿēḇôṯ", "traducao_palavra": "[por] abominação" },
        { "hebraico": "לָ֫מֹו", "transliteral": "lāmô", "traducao_palavra": "para eles" },
        { "hebraico": "כָּלֻא", "transliteral": "kāluʾ", "traducao_palavra": "[estou] preso/encerrado" },
        { "hebraico": "וְלֹא", "transliteral": "wəlō", "traducao_palavra": "e não" },
        { "hebraico": "אֵצֵֽא׃", "transliteral": "ʾēṣē", "traducao_palavra": "sairei" }
      ]
    },
    "9": {
      "traducao_completa": "O meu olho definha por causa da aflição; YHWH, tenho clamado a ti todo o dia; tenho estendido a ti as minhas mãos.",
      "palavras": [
        { "hebraico": "עֵינִי", "transliteral": "ʿênî", "traducao_palavra": "meu olho" },
        { "hebraico": "דָאֲבָה", "transliteral": "ḏāʾăḇā", "traducao_palavra": "definhou/sofreu" },
        { "hebraico": "מִנִּי", "transliteral": "minnî", "traducao_palavra": "por causa de" },
        { "hebraico": "עֹ֑נִי", "transliteral": "ʿōnî", "traducao_palavra": "aflição" },
        { "hebraico": "קְרָאתִיךָ", "transliteral": "qərāʾṯîḵā", "traducao_palavra": "clamei a ti" },
        { "hebraico": "יְהוָה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "בְּכָל־", "transliteral": "bəḵāl-", "traducao_palavra": "em cada" },
        { "hebraico": "יֹום", "transliteral": "yôm", "traducao_palavra": "dia" },
        { "hebraico": "שִׁטַּחְתִּי", "transliteral": "šiṭṭaḥtî", "traducao_palavra": "estendi" },
        { "hebraico": "אֵלֶיךָ", "transliteral": "ʾēleyḵā", "traducao_palavra": "a ti" },
        { "hebraico": "כַפָּֽי׃", "transliteral": "ḵappāy", "traducao_palavra": "minhas mãos" }
      ]
    }
  }
}