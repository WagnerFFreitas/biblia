{
  "livro": "Salmos - תְּהִלִּים - Tə-hil-lîm",
  "capítulo": 3,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Salmo de Davi, quando fugia de diante de Absalão, seu filho. YHWH, como se têm multiplicado os meus adversários! Muitos se levantam contra mim.",
      "palavras": [
        { "hebraico": "מִזְמֹ֥ור", "transliteral": "miz-môr", "traducao_palavra": "Salmo" },
        { "hebraico": "לְדָוִ֑ד", "transliteral": "lə-ḏā-wiḏ", "traducao_palavra": "de Davi" },
        { "hebraico": "בְּבָרְחֹ֕ו", "transliteral": "bə-ḇār-ḥô", "traducao_palavra": "ao fugir ele" },
        { "hebraico": "מִפְּנֵ֖י", "transliteral": "mip-pə-nê", "traducao_palavra": "de diante de" },
        { "hebraico": "אַבְשָׁלֹ֥ום", "transliteral": "ʾaḇ-šā-lôm", "traducao_palavra": "Absalão" },
        { "hebraico": "בְּנֹֽו׃", "transliteral": "bə-nô", "traducao_palavra": "seu filho" },
        { "hebraico": "יְ֭הוָה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "מָה־", "transliteral": "māh-", "traducao_palavra": "como/quanto" },
        { "hebraico": "רַבּ֨וּ", "transliteral": "rab-bû", "traducao_palavra": "multiplicaram-se" },
        { "hebraico": "צָרָ֑י", "transliteral": "ṣā-rāy", "traducao_palavra": "meus adversários" },
        { "hebraico": "רַ֝בִּ֗ים", "transliteral": "rab-bîm", "traducao_palavra": "muitos" },
        { "hebraico": "קָמִ֥ים", "transliteral": "qā-mîm", "traducao_palavra": "levantam-se" },
        { "hebraico": "עָלָֽי׃", "transliteral": "ʿā-lāy", "traducao_palavra": "contra mim" }
      ]
    },
    "2": {
      "traducao_completa": "Muitos dizem da minha alma: Não há salvação para ele em Deus. (Selá)",
      "palavras": [
        { "hebraico": "רַבִּים֮", "transliteral": "rab-bîm", "traducao_palavra": "Muitos" },
        { "hebraico": "אֹמְרִ֪ים", "transliteral": "ʾō-mə-rîm", "traducao_palavra": "dizem" },
        { "hebraico": "לְנַ֫פְשִׁ֥י", "transliteral": "lə-nap̄-šî", "traducao_palavra": "da minha alma" },
        { "hebraico": "אֵ֨ין", "transliteral": "ʾên", "traducao_palavra": "não [há]" },
        { "hebraico": "יְשׁוּעָ֧תָה", "transliteral": "yə-šû-ʿā-ṯā", "traducao_palavra": "salvação" },
        { "hebraico": "לֹּ֛ו", "transliteral": "lô", "traducao_palavra": "para ele" },
        { "hebraico": "בֵאלֹהִ֖ים", "transliteral": "ḇê-lō-hîm", "traducao_palavra": "em Deus" },
        { "hebraico": "סֶֽלָה׃", "transliteral": "śe-lā", "traducao_palavra": "Selá" }
      ]
    },
    "3": {
      "traducao_completa": "Porém tu, YHWH, és um escudo para mim, a minha glória, e o que exalta a minha cabeça.",
      "palavras": [
        { "hebraico": "וְאַתָּ֤ה", "transliteral": "wə-ʾat-tā", "traducao_palavra": "Mas Tu" },
        { "hebraico": "יְהוָ֨ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "מָגֵ֬ן", "transliteral": "mā-ḡên", "traducao_palavra": "[és] escudo" },
        { "hebraico": "בַּעֲדִ֑י", "transliteral": "ba-ʿă-ḏî", "traducao_palavra": "por mim/ao redor de mim" },
        { "hebraico": "כְּ֝בֹודִ֗י", "transliteral": "kə-ḇô-ḏî", "traducao_palavra": "minha glória" },
        { "hebraico": "וּמֵרִ֥ים", "transliteral": "ū-mê-rîm", "traducao_palavra": "e o que levanta" },
        { "hebraico": "רֹ֠אשִֽׁי׃", "transliteral": "rō-šî", "traducao_palavra": "minha cabeça" }
      ]
    },
    "4": {
      "traducao_completa": "Com a minha voz clamei a YHWH, e ele ouviu-me desde o seu santo monte. (Selá)",
      "palavras": [
        { "hebraico": "קֹולִ֥י", "transliteral": "qô-wlî", "traducao_palavra": "[Com] minha voz" },
        { "hebraico": "אֶל־", "transliteral": "ʾel-", "traducao_palavra": "a" },
        { "hebraico": "יְהוָּ֥ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "אֶקְרָ֑א", "transliteral": "ʾeq-rā", "traducao_palavra": "clamarei/clamei" },
        { "hebraico": "וַיַּֽעֲנֵ֨נִי", "transliteral": "way-ya-ʿă-nê-nî", "traducao_palavra": "e Ele me respondeu" },
        { "hebraico": "מֵהַ֖ר", "transliteral": "mê-har", "traducao_palavra": "desde o monte de" },
        { "hebraico": "קָדְשֹׁ֣ו", "transliteral": "qāḏ-šô", "traducao_palavra": "Sua santidade" },
        { "hebraico": "סֶֽלָה׃", "transliteral": "śe-lā", "traducao_palavra": "Selá" }
      ]
    },
    "5": {
      "traducao_completa": "Eu me deitei e dormi; acordei, porque YHWH me sustentou.",
      "palavras": [
        { "hebraico": "אֲנִ֥י", "transliteral": "ʾă-nî", "traducao_palavra": "Eu" },
        { "hebraico": "שָׁכַ֗בְתִּי", "transliteral": "šā-ḵaḇ-tî", "traducao_palavra": "deitei-me" },
        { "hebraico": "וָֽאִישָׁ֥נָה", "transliteral": "wā-ʾî-šā-nā", "traducao_palavra": "e dormi" },
        { "hebraico": "הֱקִיצֹ֑ותִי", "transliteral": "hĕ-qî-ṣô-w-ṯî", "traducao_palavra": "acordei" },
        { "hebraico": "כִּ֭י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "יְהוָ֥ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "יִסְמְכֵֽנִי׃", "transliteral": "yis-mə-ḵê-nî", "traducao_palavra": "sustenta-me" }
      ]
    },
    "6": {
      "traducao_completa": "Não terei medo de dez milhares de pessoas que se puseram contra mim ao redor.",
      "palavras": [
        { "hebraico": "לֹֽא־", "transliteral": "lō-", "traducao_palavra": "Não" },
        { "hebraico": "אִ֭ירָא", "transliteral": "ʾî-rā", "traducao_palavra": "temerei" },
        { "hebraico": "מֵרִבְבֹ֥ות", "transliteral": "mê-riḇ-ḇô-wṯ", "traducao_palavra": "dez milhares de" },
        { "hebraico": "עָ֑ם", "transliteral": "ʿām", "traducao_palavra": "povo" },
        { "hebraico": "אֲשֶׁ֥ר", "transliteral": "ʾă-šer", "traducao_palavra": "que" },
        { "hebraico": "סָ֝בִ֗יב", "transliteral": "śā-ḇîḇ", "traducao_palavra": "ao redor" },
        { "hebraico": "שָׁ֣תוּ", "transliteral": "šā-ṯû", "traducao_palavra": "puseram-se" },
        { "hebraico": "עָלָֽי׃", "transliteral": "ʿā-lāy", "traducao_palavra": "contra mim" }
      ]
    },
    "7": {
      "traducao_completa": "Levanta-te, YHWH; salva-me, Deus meu; pois feriste a todos os meus inimigos nos queixos; quebraste os dentes aos ímpios.",
      "palavras": [
        { "hebraico": "ק֘וּמָ֤ה", "transliteral": "qû-mā", "traducao_palavra": "Levanta-te" },
        { "hebraico": "יְהוָ֨ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "הֹושִׁ֘יעֵ֤נִי", "transliteral": "hô-w-šî-ʿê-nî", "traducao_palavra": "salva-me" },
        { "hebraico": "אֱלֹהַ֗י", "transliteral": "ʾĕ-lō-hay", "traducao_palavra": "meu Deus" },
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "pois" },
        { "hebraico": "הִכַּ֣יְתָּ", "transliteral": "hik-kay-tā", "traducao_palavra": "feriste" },
        { "hebraico": "אֶת־", "transliteral": "ʾeṯ-", "traducao_palavra": "[objeto]" },
        { "hebraico": "כָּל־", "transliteral": "kāl-", "traducao_palavra": "todos" },
        { "hebraico": "אֹיְבַ֣י", "transliteral": "ʾō-yə-ḇay", "traducao_palavra": "meus inimigos" },
        { "hebraico": "לֶ֑חִי", "transliteral": "le-ḥî", "traducao_palavra": "[no] queixo" },
        { "hebraico": "שִׁנֵּ֖י", "transliteral": "šin-nê", "traducao_palavra": "os dentes de" },
        { "hebraico": "רְשָׁעִ֣ים", "transliteral": "rə-šā-ʿîm", "traducao_palavra": "ímpios" },
        { "hebraico": "שִׁבַּֽרְתָּ׃", "transliteral": "šib-bar-tā", "traducao_palavra": "quebraste" }
      ]
    },
    "8": {
      "traducao_completa": "A salvação vem de YHWH; sobre o teu povo seja a tua bênção. (Selá)",
      "palavras": [
        { "hebraico": "לַיהוָ֥ה", "transliteral": "lay-hwā", "traducao_palavra": "De YHWH [vem]" },
        { "hebraico": "הַיְשׁוּעָ֑ה", "transliteral": "hay-šû-ʿā", "traducao_palavra": "a salvação" },
        { "hebraico": "עַֽל־", "transliteral": "ʿal-", "traducao_palavra": "sobre" },
        { "hebraico": "עַמְּךָ֖", "transliteral": "ʿam-mə-ḵā", "traducao_palavra": "Teu povo" },
        { "hebraico": "בִרְכָתֶ֣ךָ", "transliteral": "ḇir-ḵā-ṯe-ḵā", "traducao_palavra": "[seja] Tua bênção" },
        { "hebraico": "סֶּֽלָה׃", "transliteral": "śe-lā", "traducao_palavra": "Selá" }
      ]
    }
  }
}