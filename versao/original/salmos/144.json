{
  "livro": "Salmos - תְּהִלִּים - Tehillim",
  "capítulo": 144,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "De Davi. Bendito seja YHWH, minha rocha, que adestra as minhas mãos para a peleja e os meus dedos para a guerra;",
      "palavras": [
        { "hebraico": "לְדָוִ֨ד", "transliteral": "lə-ḏā-wiḏ", "traducao_palavra": "de Davi" },
        { "hebraico": "בָּר֬וּךְ", "transliteral": "bā-rûḵ", "traducao_palavra": "bendito [seja]" },
        { "hebraico": "יְהוָ֨ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "צוּרִ֗י", "transliteral": "ṣû-rî", "traducao_palavra": "minha rocha" },
        { "hebraico": "הַֽמְלַמֵּ֣ד", "transliteral": "ham-lam-mēḏ", "traducao_palavra": "[o que] ensina/adestra" },
        { "hebraico": "יָדַ֣י", "transliteral": "yā-ḏay", "traducao_palavra": "minhas mãos" },
        { "hebraico": "לַקְרָ֑ב", "transliteral": "la-qə-rāḇ", "traducao_palavra": "para a peleja" },
        { "hebraico": "אֶ֝צְבְּעֹותַ֗י", "transliteral": "ʾeṣ-bə-ʿô-ṯay", "traducao_palavra": "meus dedos" },
        { "hebraico": "לַמִּלְחָמָֽה׃", "transliteral": "lam-mil-ḥā-mā", "traducao_palavra": "para a guerra" }
      ]
    },
    "2": {
      "traducao_completa": "Minha benignidade e minha fortaleza, meu alto refúgio e meu libertador; meu escudo, em quem me refugio; aquele que me sujeita o meu povo.",
      "palavras": [
        { "hebraico": "חַסְדִּ֨י", "transliteral": "ḥas-dî", "traducao_palavra": "minha bondade" },
        { "hebraico": "וּמְצוּדָתִ֗י", "transliteral": "ū-mə-ṣû-ḏā-ṯî", "traducao_palavra": "e minha fortaleza" },
        { "hebraico": "מִשְׂגַּבִּ֤י", "transliteral": "miś-gab-bî", "traducao_palavra": "meu alto refúgio" },
        { "hebraico": "וּמְפַלְטִ֫י", "transliteral": "ū-mə-p̄al-ṭî", "traducao_palavra": "e meu libertador" },
        { "hebraico": "לִ֥י", "transliteral": "lî", "traducao_palavra": "para mim" },
        { "hebraico": "מָ֭גִנִּי", "transliteral": "mā-ḡin-nî", "traducao_palavra": "meu escudo" },
        { "hebraico": "וּבֹ֣ו", "transliteral": "ū-ḇô", "traducao_palavra": "e nele" },
        { "hebraico": "חָסִ֑יתִי", "transliteral": "ḥā-śî-ṯî", "traducao_palavra": "me refugiei/confiei" },
        { "hebraico": "הָרֹודֵ֖ד", "transliteral": "hā-rô-ḏēḏ", "traducao_palavra": "[o que] sujeita/estende" },
        { "hebraico": "עַמִּ֣י", "transliteral": "ʿam-mî", "traducao_palavra": "povo meu [ou: povos]" },
        { "hebraico": "תַחְתָּֽי׃", "transliteral": "ṯaḥ-tāy", "traducao_palavra": "debaixo de mim" }
      ]
    },
    "3": {
      "traducao_completa": "YHWH, o que é o homem para que o conheças, ou o filho do homem para que o estimes?",
      "palavras": [
        { "hebraico": "יְֽהוָ֗ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "מָה־", "transliteral": "māh-", "traducao_palavra": "o que [é]" },
        { "hebraico": "אָ֭דָם", "transliteral": "ʾā-ḏām", "traducao_palavra": "[o] homem" },
        { "hebraico": "וַתֵּדָעֵ֑הוּ", "transliteral": "wat-tê-ḏā-ʿê-hû", "traducao_palavra": "para que o conheças" },
        { "hebraico": "בֶּן־", "transliteral": "ben-", "traducao_palavra": "filho de" },
        { "hebraico": "אֱ֝נֹ֗ושׁ", "transliteral": "ʾĕ-nôš", "traducao_palavra": "homem/mortal" },
        { "hebraico": "וַתְּחַשְּׁבֵֽהוּ׃", "transliteral": "wat-tə-ḥaš-šə-ḇê-hû", "traducao_palavra": "para que o estimes/consideres" }
      ]
    },
    "4": {
      "traducao_completa": "O homem é semelhante à vaidade; os seus dias são como a sombra que passa.",
      "palavras": [
        { "hebraico": "אָ֭דָם", "transliteral": "ʾā-ḏām", "traducao_palavra": "homem" },
        { "hebraico": "לַהֶ֣בֶל", "transliteral": "la-he-ḇel", "traducao_palavra": "à vaidade/sopro" },
        { "hebraico": "דָּמָ֑ה", "transliteral": "dā-mā", "traducao_palavra": "é semelhante" },
        { "hebraico": "יָ֝מָ֗יו", "transliteral": "yā-māyw", "traducao_palavra": "dias dele" },
        { "hebraico": "כְּצֵ֣ל", "transliteral": "kə-ṣēl", "traducao_palavra": "como sombra" },
        { "hebraico": "עֹובֵֽר׃", "transliteral": "ʿô-ḇēr", "traducao_palavra": "passageira" }
      ]
    },
    "5": {
      "traducao_completa": "Abaixa, YHWH, os teus céus e desce; toca os montes, e eles fumegarão.",
      "palavras": [
        { "hebraico": "יְ֭הוָה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "הַט־", "transliteral": "haṭ-", "traducao_palavra": "inclina/abaixa" },
        { "hebraico": "שָׁמֶ֣יךָ", "transliteral": "šā-mey-ḵā", "traducao_palavra": "teus céus" },
        { "hebraico": "וְתֵרֵ֑ד", "transliteral": "wə-ṯê-rēḏ", "traducao_palavra": "e desce" },
        { "hebraico": "גַּ֖ע", "transliteral": "gaʿ", "traducao_palavra": "toca" },
        { "hebraico": "בֶּהָרִ֣ים", "transliteral": "be-hā-rîm", "traducao_palavra": "nos montes" },
        { "hebraico": "וְֽיֶעֱשָֽׁנוּ׃", "transliteral": "wə-ye-ʿĕ-šā-nû", "traducao_palavra": "e fumegarão" }
      ]
    },
    "6": {
      "traducao_completa": "Vibra os teus raios e espalha-os; envia as tuas setas e perturba-os.",
      "palavras": [
        { "hebraico": "בְּרֹ֣וק", "transliteral": "bə-rôq", "traducao_palavra": "fulmina/lança" },
        { "hebraico": "בָּ֭רָק", "transliteral": "bā-rāq", "traducao_palavra": "raio" },
        { "hebraico": "וּתְפִיצֵ֑ם", "transliteral": "ū-ṯə-p̄î-ṣêm", "traducao_palavra": "e espalha-os" },
        { "hebraico": "שְׁלַ֥ח", "transliteral": "šə-laḥ", "traducao_palavra": "envia" },
        { "hebraico": "חִ֝צֶּ֗יךָ", "transliteral": "ḥiṣ-ṣê-ḵā", "traducao_palavra": "tuas setas" },
        { "hebraico": "וּתְהֻמֵּֽם׃", "transliteral": "ū-ṯə-hum-mêm", "traducao_palavra": "e confunde-os/aterra-os" }
      ]
    },
    "7": {
      "traducao_completa": "Estende a tua mão lá do alto; livra-me e tira-me das muitas águas, da mão dos filhos do estrangeiro,",
      "palavras": [
        { "hebraico": "שְׁלַ֥ח", "transliteral": "šə-laḥ", "traducao_palavra": "envia" },
        { "hebraico": "יָדֶ֗יךָ", "transliteral": "yā-ḏey-ḵā", "traducao_palavra": "tuas mãos" },
        { "hebraico": "מִמָּ֫רֹ֥ום", "transliteral": "mim-mā-rôm", "traducao_palavra": "do alto" },
        { "hebraico": "פְּצֵ֣נִי", "transliteral": "pə-ṣê-nî", "traducao_palavra": "resgata-me" },
        { "hebraico": "וְ֭הַצִּילֵנִי", "transliteral": "wə-haṣ-ṣî-lê-nî", "traducao_palavra": "e livra-me" },
        { "hebraico": "מִמַּ֣יִם", "transliteral": "mim-ma-yim", "traducao_palavra": "de águas" },
        { "hebraico": "רַבִּ֑ים", "transliteral": "rab-bîm", "traducao_palavra": "muitas" },
        { "hebraico": "מִיַּ֝ד", "transliteral": "mi-yaḏ", "traducao_palavra": "da mão de" },
        { "hebraico": "בְּנֵ֣י", "transliteral": "bə-nê", "traducao_palavra": "filhos de" },
        { "hebraico": "נֵכָֽר׃", "transliteral": "nē-ḵār", "traducao_palavra": "estranho" }
      ]
    },
    "8": {
      "traducao_completa": "Cuja boca fala vaidade e cuja destra é uma destra de mentira.",
      "palavras": [
        { "hebraico": "אֲשֶׁ֣ר", "transliteral": "ʾă-šer", "traducao_palavra": "que" },
        { "hebraico": "פִּ֭יהֶם", "transliteral": "pî-hem", "traducao_palavra": "boca deles" },
        { "hebraico": "דִּבֶּר־", "transliteral": "dib-ber-", "traducao_palavra": "fala" },
        { "hebraico": "שָׁ֑וְא", "transliteral": "šā-wəʾ", "traducao_palavra": "vaidade/falsidade" },
        { "hebraico": "וִ֝ימִינָ֗ם", "transliteral": "wî-mî-nām", "traducao_palavra": "e a destra deles" },
        { "hebraico": "יְמִ֣ין", "transliteral": "yə-mîn", "traducao_palavra": "[é] destra de" },
        { "hebraico": "שָֽׁקֶר׃", "transliteral": "šā-qer", "traducao_palavra": "mentira" }
      ]
    },
    "9": {
      "traducao_completa": "A ti, ó Deus, cantarei um cântico novo; com o saltério de dez cordas te salmodiarei;",
      "palavras": [
        { "hebraico": "אֱ֭לֹהִים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "ó Deus" },
        { "hebraico": "שִׁ֣יר", "transliteral": "šîr", "traducao_palavra": "[um] cântico" },
        { "hebraico": "חָדָ֣שׁ", "transliteral": "ḥā-ḏāš", "traducao_palavra": "novo" },
        { "hebraico": "אָשִׁ֣ירָה", "transliteral": "ʾā-šî-rā", "traducao_palavra": "cantarei" },
        { "hebraico": "לָּ֑ךְ", "transliteral": "llāk", "traducao_palavra": "a ti" },
        { "hebraico": "בְּנֵ֥בֶל", "transliteral": "bə-nê-ḇel", "traducao_palavra": "com saltério" },
        { "hebraico": "עָ֝שֹׂ֗ור", "transliteral": "ʿā-śôr", "traducao_palavra": "de dez [cordas]" },
        { "hebraico": "אֲזַמְּרָה־", "transliteral": "ʾă-zam-mə-rā-", "traducao_palavra": "salmodiarei" },
        { "hebraico": "לָּֽךְ׃", "transliteral": "llāḵ", "traducao_palavra": "a ti" }
      ]
    },
    "10": {
      "traducao_completa": "É ele quem dá a salvação aos reis; quem livra a Davi, seu servo, da espada maligna.",
      "palavras": [
        { "hebraico": "הַנֹּותֵ֥ן", "transliteral": "han-nô-ṯên", "traducao_palavra": "[o que] dá" },
        { "hebraico": "תְּשׁוּעָ֗ה", "transliteral": "tə-šû-ʿā", "traducao_palavra": "vitória/salvação" },
        { "hebraico": "לַמְּלָ֫כִ֥ים", "transliteral": "lam-mə-lā-ḵîm", "traducao_palavra": "aos reis" },
        { "hebraico": "הַ֝פֹּוצֶ֗ה", "transliteral": "hap-pô-ṣeh", "traducao_palavra": "[o que] resgata/livra" },
        { "hebraico": "אֶת־", "transliteral": "ʾeṯ-", "traducao_palavra": "[objeto]" },
        { "hebraico": "דָּוִ֥ד", "transliteral": "dā-wiḏ", "traducao_palavra": "Davi" },
        { "hebraico": "עַבְדֹֹּ֗ו", "transliteral": "ʿaḇ-dô", "traducao_palavra": "servo dele" },
        { "hebraico": "מֵחֶ֥רֶב", "transliteral": "mê-ḥe-reḇ", "traducao_palavra": "da espada" },
        { "hebraico": "רָעָֽה׃", "transliteral": "rā-ʿā", "traducao_palavra": "maligna/má" }
      ]
    },
    "11": {
      "traducao_completa": "Livra-me e tira-me da mão dos filhos do estrangeiro, cuja boca fala vaidade e cuja destra é uma destra de mentira.",
      "palavras": [
        { "hebraico": "פְּ֭צֵנִי", "transliteral": "pə-ṣê-nî", "traducao_palavra": "resgata me" },
        { "hebraico": "וְהַצִּילֵנִי֮", "transliteral": "wə-haṣ-ṣî-lê-nî", "traducao_palavra": "e livra-me" },
        { "hebraico": "מִיַּ֪ד", "transliteral": "mi-yaḏ", "traducao_palavra": "da mão de" },
        { "hebraico": "בְּנֵי־", "transliteral": "bə-nê-", "traducao_palavra": "filhos de" },
        { "hebraico": "נֵ֫כָ֥ר", "transliteral": "nē-ḵār", "traducao_palavra": "estrangeiro" },
