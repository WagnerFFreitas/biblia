        { "hebraico": "פִּ֭יהֶם", "transliteral": "pî-hem", "traducao_palavra": "boca deles" },
        { "hebraico": "דִּבֶּר־", "transliteral": "dib-ber-", "traducao_palavra": "fala" },
        { "hebraico": "שָׁ֑וְא", "transliteral": "šā-wəʾ", "traducao_palavra": "vaidade" },
        { "hebraico": "וִ֝ימִינָ֗ם", "transliteral": "wî-mî-nām", "traducao_palavra": "e a destra deles" },
        { "hebraico": "יְמִ֣ין", "transliteral": "yə-mîn", "traducao_palavra": "destra de" },
        { "hebraico": "שָֽׁקֶר׃", "transliteral": "šā-qer", "traducao_palavra": "mentira" }
      ]
    },
    "12": {
      "traducao_completa": "Para que os nossos filhos sejam como plantas crescidas na sua mocidade; para que as nossas filhas sejam como pedras de esquina lavradas, como colunas de palácio;",
      "palavras": [
        { "hebraico": "אֲשֶׁ֤ר", "transliteral": "ʾă-šer", "traducao_palavra": "[para] que" },
        { "hebraico": "בָּנֵ֨ינוּ", "transliteral": "bā-nê-nû", "traducao_palavra": "nossos filhos" },
        { "hebraico": "כִּנְטִעִים֮", "transliteral": "kin-ṭi-ʿîm", "traducao_palavra": "como plantas" },
        { "hebraico": "מְגֻדָּלִ֪ים", "transliteral": "mə-ḡud-dā-lîm", "traducao_palavra": "crescidas" },
        { "hebraico": "בִּנְעוּרֵ֫יהֶ֥ם", "transliteral": "bin-ʿû-rê-hem", "traducao_palavra": "na sua mocidade" },
        { "hebraico": "בְּנֹותֵ֥ינוּ", "transliteral": "bə-nô-ṯê-nû", "traducao_palavra": "nossas filhas" },
        { "hebraico": "כְזָוִיֹּ֑ת", "transliteral": "ḵə-zā-wiy-yôṯ", "traducao_palavra": "como pedras de esquina" },
        { "hebraico": "מְ֝חֻטָּבֹ֗ות", "transliteral": "mə-ḥuṭ-ṭā-ḇôṯ", "traducao_palavra": "lavradas" },
        { "hebraico": "תַּבְּנִ֥ית", "transliteral": "taḇ-nît", "traducao_palavra": "[segundo a] forma de" },
        { "hebraico": "הֵיכָֽל׃", "transliteral": "hê-ḵāl", "traducao_palavra": "palácio" }
      ]
    },
    "13": {
      "traducao_completa": "Que as nossas despensas estejam cheias, provendo toda sorte de mantimentos; que os nossos gados produzam a milhares e a dezenas de milhares nas nossas ruas;",
      "palavras": [
        { "hebraico": "מְזָוֵ֨ינוּ", "transliteral": "mə-zā-wê-nû", "traducao_palavra": "nossos celeiros/despensas" },
        { "hebraico": "מְלֵאִים֮", "transliteral": "mə-lê-ʾîm", "traducao_palavra": "cheios" },
        { "hebraico": "מְפִיקִ֪ים", "transliteral": "mə-p̄î-qîm", "traducao_palavra": "provendo/produzindo" },
        { "hebraico": "מִזַּ֫ן", "transliteral": "miz-zan", "traducao_palavra": "de espécie" },
        { "hebraico": "אֶל־", "transliteral": "ʾel-", "traducao_palavra": "para" },
        { "hebraico": "זַ֥ן", "transliteral": "zan", "traducao_palavra": "espécie [toda sorte]" },
        { "hebraico": "צֹאונֵ֣נוּ", "transliteral": "ṣô-nê-nû", "traducao_palavra": "nosso gado miúdo" },
        { "hebraico": "מַ֭אֲלִיפֹות", "transliteral": "ma-ʾă-lî-p̄ôṯ", "traducao_palavra": "multiplicando a milhares" },
        { "hebraico": "מְרֻבָּבֹ֗ות", "transliteral": "mə-rub-bā-ḇôṯ", "traducao_palavra": "a dezenas de milhares" },
        { "hebraico": "בְּחוּצֹותֵֽינוּ׃", "transliteral": "bə-ḥû-ṣô-ṯê-nû", "traducao_palavra": "nas nossas ruas/campos" }
      ]
    },
    "14": {
      "traducao_completa": "Que os nossos bois sejam fortes para o trabalho; que não haja arrombamentos, nem saídas, nem gritos nas nossas ruas.",
      "palavras": [
        { "hebraico": "אַלּוּפֵ֨ינוּ֮", "transliteral": "ʾal-lû-p̄ê-nû", "traducao_palavra": "nossos chefes/bois" },
        { "hebraico": "מְסֻבָּ֫לִ֥ים", "transliteral": "mə-śub-bā-lîm", "traducao_palavra": "carregados/fortes" },
        { "hebraico": "אֵֽין־", "transliteral": "ʾên-", "traducao_palavra": "não [haja]" },
        { "hebraico": "פֶּ֭רֶץ", "transliteral": "pe-reṣ", "traducao_palavra": "brecha/arrombamento" },
        { "hebraico": "וְאֵ֣ין", "transliteral": "wə-ʾên", "traducao_palavra": "e não" },
        { "hebraico": "יֹוצֵ֑את", "transliteral": "yô-ṣēṯ", "traducao_palavra": "saída/perda" },
        { "hebraico": "וְאֵ֥ין", "transliteral": "wə-ʾên", "traducao_palavra": "e não" },
        { "hebraico": "צְ֝וָחָ֗ה", "transliteral": "ṣə-wā-ḥā", "traducao_palavra": "grito/clamor" },
        { "hebraico": "בִּרְחֹבֹתֵֽינוּ׃", "transliteral": "bir-ḥō-ḇō-ṯê-nû", "traducao_palavra": "nas nossas ruas" }
      ]
    },
    "15": {
      "traducao_completa": "Bem-aventurado o povo a quem assim sucede! Bem-aventurado é o povo cujo Deus é YHWH.",
      "palavras": [
