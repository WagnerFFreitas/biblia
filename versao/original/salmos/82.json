        { "hebraico": "עָ֑וֶל", "transliteral": "ʿā-wel", "traducao_palavra": "injustamente" },
        { "hebraico": "וּפְנֵ֥י", "transliteral": "ū-p̄ə-nê", "traducao_palavra": "e as faces de" },
