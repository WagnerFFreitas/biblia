        { "hebraico": "וְיָתֹ֑ום", "transliteral": "wə-yā-ṯôm", "traducao_palavra": "e o órfão" },
        { "hebraico": "עָנִ֖י", "transliteral": "ʿā-nî", "traducao_palavra": "[ao] aflito" },
