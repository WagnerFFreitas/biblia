        { "hebraico": "אֲחֹתִ֣י", "transliteral": "ʾă-ḥō-ṯî", "traducao_palavra": "minha irmã" },
        { "hebraico": "כַלָּ֑ה", "transliteral": "ḵal-lā", "traducao_palavra": "[minha] noiva/esposa" },
        { "hebraico": "לִבַּבְתִּ֨ינִי֙", "transliteral": "lib-baḇ-ti-nî", "traducao_palavra": "arrebataste-me o coração" },
        { "hebraico": "בְּאַחַ֣ת", "transliteral": "bə-ʾa-ḥaṯ", "traducao_palavra": "com uma" },
        { "hebraico": "מֵעֵינַ֔יִךְ", "transliteral": "mê-ʿê-na-yiḵ", "traducao_palavra": "de tuas vistas/olhares" },
