{
  "livro": "Cantares - שִׁיר הַשִּׁירִים - Shir Hashirim",
  "capítulo": 8,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Ah, quem me dera que fosses como meu irmão, que mamou aos seios de minha mãe! Quando te encontrasse lá fora, beijar-te-ia, e não me desprezariam.",
      "palavras": [
        { "hebraico": "מִ֤י", "transliteral": "mî", "traducao_palavra": "Quem" },
        { "hebraico": "יִתֶּנְךָ֙", "transliteral": "yit-ten-ḵā", "traducao_palavra": "derá/faria a ti" },
        { "hebraico": "כְּאָ֣ח", "transliteral": "kə-ʾāḥ", "traducao_palavra": "como irmão" },
        { "hebraico": "לִ֔י", "transliteral": "lî", "traducao_palavra": "para mim" },
        { "hebraico": "יֹונֵ֖ק", "transliteral": "yô-nêq", "traducao_palavra": "mamando" },
        { "hebraico": "שְׁדֵ֣י", "transliteral": "šə-ḏê", "traducao_palavra": "[os] seios de" },
        { "hebraico": "אִמִּ֑י", "transliteral": "ʾim-mî", "traducao_palavra": "minha mãe" },
        { "hebraico": "אֶמְצָאֲךָ֤", "transliteral": "ʾem-ṣā-ʾă-ḵā", "traducao_palavra": "encontraria a ti" },
        { "hebraico": "בַחוּץ֙", "transliteral": "ḇa-ḥûṣ", "traducao_palavra": "lá fora" },
        { "hebraico": "אֶשָּׁקְךָ֔", "transliteral": "ʾeš-šā-qə-ḵā", "traducao_palavra": "beijaria a ti" },
        { "hebraico": "גַּ֖ם", "transliteral": "gam", "traducao_palavra": "também" },
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "יָב֥וּזוּ", "transliteral": "yā-ḇû-zû", "traducao_palavra": "desprezariam" },
        { "hebraico": "לִֽי׃", "transliteral": "lî", "traducao_palavra": "a mim" }
      ]
    },
    "2": {
      "traducao_completa": "Levar-te-ia e introduzir-te-ia na casa de minha mãe, e tu me ensinarias; dar-te-ia a beber vinho aromático e do mosto das minhas romãs.",
      "palavras": [
        { "hebraico": "אֶנְהָגְךָ֗", "transliteral": "ʾen-hā-ḡə-ḵā", "traducao_palavra": "Conduziria a ti" },
        { "hebraico": "אֲבִֽיאֲךָ֛", "transliteral": "ʾă-ḇî-ʾă-ḵā", "traducao_palavra": "levaria a ti" },
        { "hebraico": "אֶל־בֵּ֥ית", "transliteral": "ʾel-bêṯ", "traducao_palavra": "para a casa de" },
        { "hebraico": "אִמִּ֖י", "transliteral": "ʾim-mî", "traducao_palavra": "minha mãe" },
        { "hebraico": "תְּלַמְּדֵ֑נִי", "transliteral": "tə-lam-mə-ḏê-nî", "traducao_palavra": "tu me ensinarias" },
        { "hebraico": "אַשְׁקְךָ֙", "transliteral": "ʾaš-qə-ḵā", "traducao_palavra": "daria a beber a ti" },
        { "hebraico": "מִיַּ֣יִן", "transliteral": "miy-ya-yin", "traducao_palavra": "do vinho" },
        { "hebraico": "הָרֶ֔קַח", "transliteral": "ha-re-qaḥ", "traducao_palavra": "aromático/especiado" },
        { "hebraico": "מֵעֲסִ֖יס", "transliteral": "mē-ʿă-śîs", "traducao_palavra": "do mosto de" },
        { "hebraico": "רִמֹּנִֽי׃", "transliteral": "rim-mō-nî", "traducao_palavra": "minha romã" }
      ]
    },
    "3": {
      "traducao_completa": "A sua mão esquerda estaria debaixo da minha cabeça, e a sua mão direita me abraçaria.",
      "palavras": [
        { "hebraico": "שְׂמֹאלֹו֙", "transliteral": "śə-mō-lô", "traducao_palavra": "Sua esquerda" },
        { "hebraico": "תַּ֣חַת", "transliteral": "ta-ḥaṯ", "traducao_palavra": "debaixo de" },
        { "hebraico": "רֹאשִׁ֔י", "transliteral": "rō-šî", "traducao_palavra": "minha cabeça" },
        { "hebraico": "וִימִינֹ֖ו", "transliteral": "wî-mî-nô", "traducao_palavra": "e sua direita" },
        { "hebraico": "תְּחַבְּקֵֽנִי׃", "transliteral": "tə-ḥab-bə-qê-nî", "traducao_palavra": "me abraça/abraçaria" }
      ]
    },
    "4": {
      "traducao_completa": "Conjuro-vos, ó filhas de Jerusalém, que não desperteis, nem acordeis o amor, até que este o queira.",
      "palavras": [
        { "hebraico": "הִשְׁבַּ֥עְתִּי", "transliteral": "hiš-ba-ʿatî", "traducao_palavra": "Conjuro/faço jurar" },
        { "hebraico": "אֶתְכֶ֖ם", "transliteral": "ʾeṯ-ḵem", "traducao_palavra": "a vós" },
        { "hebraico": "בְּנֹ֣ות", "transliteral": "bə-nôṯ", "traducao_palavra": "filhas de" },
        { "hebraico": "יְרוּשָׁלִָ֑ם", "transliteral": "yə-rû-šā-la-yim", "traducao_palavra": "Jerusalém" },
        { "hebraico": "מַה־תָּעִ֧ירוּ ׀", "transliteral": "mah-tā-ʿî-rû", "traducao_palavra": "que não desperteis" },
        { "hebraico": "וּמַה־תְּעֹ֥רְרוּ", "transliteral": "ū-mah-tə-ʿō-rə-rû", "traducao_palavra": "e que não acordeis" },
        { "hebraico": "אֶת־הָאַהֲבָ֖ה", "transliteral": "ʾeṯ-hā-ʾa-hă-ḇā", "traducao_palavra": "o amor" },
        { "hebraico": "עַ֥ד", "transliteral": "ʿaḏ", "traducao_palavra": "até" },
        { "hebraico": "שֶׁתֶּחְפָּֽץ׃", "transliteral": "še-teḥ-pāṣ", "traducao_palavra": "que [ele] queira" }
      ]
    },
    "5": {
      "traducao_completa": "Quem é esta que sobe do deserto e vem encostada ao seu amado? Debaixo da macieira te despertei; ali te deu à luz tua mãe; ali te deu à luz aquela que te gerou.",
      "palavras": [
        { "hebraico": "מִ֣י", "transliteral": "mî", "traducao_palavra": "Quem [é]" },
        { "hebraico": "זֹ֗את", "transliteral": "zōṯ", "traducao_palavra": "esta" },
        { "hebraico": "עֹלָה֙", "transliteral": "ʿō-lā", "traducao_palavra": "[que] sobe" },
        { "hebraico": "מִן־", "transliteral": "min-", "traducao_palavra": "do" },
        { "hebraico": "הַמִּדְבָּ֔ר", "transliteral": "ham-miḏ-bār", "traducao_palavra": "deserto" },
        { "hebraico": "מִתְרַפֶּ֖קֶת", "transliteral": "miṯ-rap-pe-qeṯ", "traducao_palavra": "encostada/apoiada" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre" },
        { "hebraico": "דֹּודָ֑הּ", "transliteral": "dô-ḏāh", "traducao_palavra": "seu amado" },
        { "hebraico": "תַּ֤חַת", "transliteral": "ta-ḥaṯ", "traducao_palavra": "Debaixo de" },
        { "hebraico": "הַתַּפּ֨וּחַ֙", "transliteral": "hat-tap-pû-aḥ", "traducao_palavra": "a macieira" },
        { "hebraico": "עֹורַרְתִּ֔יךָ", "transliteral": "ʿô-rar-tî-ḵā", "traducao_palavra": "despertei-te" },
        { "hebraico": "שָׁ֚מָּה", "transliteral": "šām-mā", "traducao_palavra": "ali" },
        { "hebraico": "חִבְּלַ֣תְךָ", "transliteral": "ḥib-bə-laṯ-ḵā", "traducao_palavra": "te deu à luz" },
        { "hebraico": "אִמֶּ֔ךָ", "transliteral": "ʾim-me-ḵā", "traducao_palavra": "tua mãe" },
        { "hebraico": "שָׁ֥מָּה", "transliteral": "šām-mā", "traducao_palavra": "ali" },
        { "hebraico": "חִבְּלָ֖ה", "transliteral": "ḥib-bə-lā", "traducao_palavra": "sofreu dores/deu à luz" },
        { "hebraico": "יְלָדַֽתְךָ׃", "transliteral": "yə-lā-ḏaṯ-ḵā", "traducao_palavra": "quem te gerou" }
      ]
    },
    "6": {
      "traducao_completa": "Põe-me como selo sobre o teu coração, como selo sobre o teu braço, porque o amor é forte como a morte, e o ciúme duro como o Seol; as suas brasas são brasas de fogo, labaredas de YHWH.",
      "palavras": [
        { "hebraico": "שִׂ֘ימֵ֤נִי", "transliteral": "śî-mê-nî", "traducao_palavra": "Põe-me" },
        { "hebraico": "כַחֹותָ֨ם֙", "transliteral": "ḵa-ḥô-ṯām", "traducao_palavra": "como selo" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre" },
        { "hebraico": "לִבֶּ֔ךָ", "transliteral": "lib-be-ḵā", "traducao_palavra": "teu coração" },
        { "hebraico": "כַּחֹותָ֖ם", "transliteral": "ka-ḥô-ṯām", "traducao_palavra": "como selo" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre" },
        { "hebraico": "זְרֹועֶ֑ךָ", "transliteral": "zə-rô-ʿe-ḵā", "traducao_palavra": "teu braço" },
        { "hebraico": "כִּֽי־עַזָּ֤ה", "transliteral": "kî-ʿaz-zā", "traducao_palavra": "porque forte [é]" },
        { "hebraico": "כַמָּ֨וֶת֙", "transliteral": "ḵam-mā-weṯ", "traducao_palavra": "como a morte" },
        { "hebraico": "אַהֲבָ֔ה", "transliteral": "ʾa-hă-ḇā", "traducao_palavra": "[o] amor" },
        { "hebraico": "קָשָׁ֥ה", "transliteral": "qā-šā", "traducao_palavra": "dura/inexorável" },
        { "hebraico": "כִשְׁאֹ֖ול", "transliteral": "ḵi-šə-ʾôl", "traducao_palavra": "como o Seol" },
        { "hebraico": "קִנְאָ֑ה", "transliteral": "qin-ʾā", "traducao_palavra": "[é a] inveja/ciúme" },
        { "hebraico": "רְשָׁפֶ֕יהָ", "transliteral": "rə-šā-p̄e-hā", "traducao_palavra": "as brasas dela" },
        { "hebraico": "רִשְׁפֵּ֥י", "transliteral": "riš-pê", "traducao_palavra": "[são] brasas de" },
        { "hebraico": "אֵ֖שׁ", "transliteral": "ʾêš", "traducao_palavra": "fogo" },
        { "hebraico": "שַׁלְהֶ֥בֶתְיָֽה׃", "transliteral": "šal-he-ḇeṯ-yāh", "traducao_palavra": "chama de YAH/veemente" }
      ]
    },
    "7": {
      "traducao_completa": "As muitas águas não poderiam apagar este amor, nem os rios afogá-lo; ainda que alguém desse todos os bens de sua casa pelo amor, certamente o desprezariam.",
      "palavras": [
        { "hebraico": "מַ֣יִם", "transliteral": "ma-yim", "traducao_palavra": "Águas" },
        { "hebraico": "רַבִּ֗ים", "transliteral": "rab-bîm", "traducao_palavra": "muitas" },
        { "hebraico": "לֹ֤א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "יוּכְלוּ֙", "transliteral": "yû-ḵə-lû", "traducao_palavra": "poderão" },
        { "hebraico": "לְכַבֹּ֣ות", "transliteral": "lə-ḵab-bôṯ", "traducao_palavra": "apagar" },
        { "hebraico": "אֶת־הָאַהֲבָ֔ה", "transliteral": "ʾeṯ-hā-ʾa-hă-ḇā", "traducao_palavra": "o amor" },
        { "hebraico": "וּנְהָרֹ֖ות", "transliteral": "ū-nə-hā-rôṯ", "traducao_palavra": "e rios" },
        { "hebraico": "לֹ֥א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "יִשְׁטְפ֑וּהָ", "transliteral": "yiš-ṭə-p̄û-hā", "traducao_palavra": "o afogarão/arrebatarão" },
        { "hebraico": "אִם־יִתֵּ֨ן", "transliteral": "ʾim-yit-tên", "traducao_palavra": "se desse" },
        { "hebraico": "אִ֜ישׁ", "transliteral": "ʾîš", "traducao_palavra": "um homem" },
        { "hebraico": "אֶת־כָּל־", "transliteral": "ʾeṯ-kāl-", "traducao_palavra": "todos" },
        { "hebraico": "הֹ֥ון", "transliteral": "hôn", "traducao_palavra": "[os] bens de" },
        { "hebraico": "בֵּיתֹ֛ו", "transliteral": "bê-ṯô", "traducao_palavra": "sua casa" },
        { "hebraico": "בָּאַהֲבָ֖ה", "transliteral": "bā-ʾa-hă-ḇā", "traducao_palavra": "pelo amor" },
        { "hebraico": "בֹּ֥וז", "transliteral": "bôz", "traducao_palavra": "com desprezo" },
        { "hebraico": "יָב֥וּזוּ", "transliteral": "yā-ḇû-zû", "traducao_palavra": "desprezariam" },
        { "hebraico": "לֹֽו׃", "transliteral": "lô", "traducao_palavra": "a ele" }
      ]
    },
    "8": {
      "traducao_completa": "Temos uma irmã pequena, que ainda não tem seios; que faremos à nossa irmã, no dia em que dela se falar?",
      "palavras": [
        { "hebraico": "אָחֹ֥ות", "transliteral": "ʾā-ḥôṯ", "traducao_palavra": "[Uma] irmã" },
        { "hebraico": "לָ֨נוּ", "transliteral": "lā-nû", "traducao_palavra": "temos" },
        { "hebraico": "קְטַנָּ֔ה", "transliteral": "qə-ṭan-nā", "traducao_palavra": "pequena" },
        { "hebraico": "וְשָׁדַ֖יִם", "transliteral": "wə-šā-ḏa-yim", "traducao_palavra": "e seios" },
        { "hebraico": "אֵ֣ין", "transliteral": "ʾên", "traducao_palavra": "não [há]" },
        { "hebraico": "לָ֑הּ", "transliteral": "lāh", "traducao_palavra": "para ela" },
        { "hebraico": "מַֽה־נַּעֲשֶׂה֙", "transliteral": "mah-na-ʿă-śeh", "traducao_palavra": "o que faremos" },
        { "hebraico": "לַאֲחֹתֵ֔נוּ", "transliteral": "la-ʾă-ḥō-ṯê-nû", "traducao_palavra": "pela nossa irmã" },
        { "hebraico": "בַּיֹּ֖ום", "transliteral": "bay-yôm", "traducao_palavra": "no dia" },
        { "hebraico": "שֶׁיְּדֻבַּר־", "transliteral": "še-yyə-ḏub-bar-", "traducao_palavra": "que se falar" },
        { "hebraico": "בָּֽהּ׃", "transliteral": "bāh", "traducao_palavra": "dela" }
      ]
    },
    "9": {
      "traducao_completa": "Se ela for um muro, edificaremos sobre ele um palácio de prata; e, se ela for uma porta, cercá-la-emos com tábuas de cedro.",
      "palavras": [
        { "hebraico": "אִם־חֹומָ֣ה", "transliteral": "ʾim-ḥô-mā", "traducao_palavra": "Se [for] muro" },
        { "hebraico": "הִ֔יא", "transliteral": "hî", "traducao_palavra": "ela" },
        { "hebraico": "נִבְנֶ֥ה", "transliteral": "niḇ-neh", "traducao_palavra": "edificaremos" },
        { "hebraico": "עָלֶ֖יהָ", "transliteral": "ʿā-le-hā", "traducao_palavra": "sobre ela" },
        { "hebraico": "טִ֣ירַת", "transliteral": "ṭî-raṯ", "traducao_palavra": "[um] palácio/torre de" },
        { "hebraico": "כָּ֑סֶף", "transliteral": "kā-sep̄", "traducao_palavra": "prata" },
        { "hebraico": "וְאִם־דֶּ֣לֶת", "transliteral": "wə-ʾim-de-leṯ", "traducao_palavra": "e se [for] porta" },
        { "hebraico": "הִ֔יא", "transliteral": "hî", "traducao_palavra": "ela" },
        { "hebraico": "נָצ֥וּר", "transliteral": "nā-ṣûr", "traducao_palavra": "cercaremos/guarneceremos" },
        { "hebraico": "עָלֶ֖יהָ", "transliteral": "ʿā-le-hā", "traducao_palavra": "ela" },
        { "hebraico": "ל֥וּחַ", "transliteral": "lû-aḥ", "traducao_palavra": "[com] tábuas de" },
        { "hebraico": "אָֽרֶז׃", "transliteral": "ʾā-rez", "traducao_palavra": "cedro" }
      ]
    },
    "10": {
      "traducao_completa": "Eu sou um muro, e os meus seios como as suas torres; então fui eu aos seus olhos como aquela que acha a paz.",
      "palavras": [
        { "hebraico": "אֲנִ֣י", "transliteral": "ʾă-nî", "traducao_palavra": "Eu [sou]" },
        { "hebraico": "חֹומָ֔ה", "transliteral": "ḥô-mā", "traducao_palavra": "muro" },
        { "hebraico": "וְשָׁדַ֖י", "transliteral": "wə-šā-ḏay", "traducao_palavra": "e meus seios" },
        { "hebraico": "כַּמִּגְדָּלֹ֑ות", "transliteral": "kam-miḡ-dā-lôṯ", "traducao_palavra": "como as torres" },
        { "hebraico": "אָ֛ז", "transliteral": "ʾāz", "traducao_palavra": "então" },
        { "hebraico": "הָיִ֥יתִי", "transliteral": "hā-yî-ṯî", "traducao_palavra": "fui" },
        { "hebraico": "בְעֵינָ֖יו", "transliteral": "ḇə-ʿê-nāyw", "traducao_palavra": "aos olhos dele" },
        { "hebraico": "כְּמֹוצְאֵ֥ת", "transliteral": "kə-mô-ṣə-ʾêṯ", "traducao_palavra": "como aquela que acha" },
        { "hebraico": "שָׁלֹֽום׃", "transliteral": "šā-lôm", "traducao_palavra": "paz" }
      ]
    },
    "11": {
      "traducao_completa": "Teve Salomão uma vinha em Baal-Hamom; entregou esta vinha a uns guardas; cada um lhe trazia pelo seu fruto mil peças de prata.",
      "palavras": [
        { "hebraico": "כֶּ֣רֶם", "transliteral": "ke-rem", "traducao_palavra": "[Uma] vinha" },
        { "hebraico": "הָיָ֤ה", "transliteral": "hā-yā", "traducao_palavra": "havia" },
        { "hebraico": "לִשְׁלֹמֹה֙", "transliteral": "liš-lō-mōh", "traducao_palavra": "para Salomão" },
        { "hebraico": "בְּבַ֣עַל", "transliteral": "bə-ḇa-ʿal", "traducao_palavra": "em Baal-" },
