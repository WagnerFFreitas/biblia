    },
    "4": {
      "traducao_completa": "Levou-me à casa do banquete, e o seu estandarte sobre mim era o amor.",
      "palavras": [
        { "hebraico": "הֱבִיאַ֨נִי֙", "transliteral": "hĕ-ḇî-ʾa-nî", "traducao_palavra": "Levou-me" },
        { "hebraico": "אֶל־בֵּ֣ית", "transliteral": "ʾel-bêṯ", "traducao_palavra": "para a casa de" },
        { "hebraico": "הַיָּ֔יִן", "transliteral": "hay-yā-yin", "traducao_palavra": "o vinho/banquete" },
        { "hebraico": "וְדִגְלֹ֥ו", "transliteral": "wə-ḏiḡ-lô", "traducao_palavra": "e seu estandarte" },
