      ]
    },
    "5": {
      "traducao_completa": "Sustentai-me com passas, confortai-me com macãs, porque desfaleço de amor.",
      "palavras": [
        { "hebraico": "סַמְּכ֗וּנִי", "transliteral": "sam-mə-ḵû-nî", "traducao_palavra": "Sustentai-me" },
        { "hebraico": "בָּֽאֲשִׁישֹׁ֑ות", "transliteral": "bā-ʾă-šî-šôṯ", "traducao_palavra": "com bolos de passas" },
        { "hebraico": "רַפְּד֨וּנִי֙", "transliteral": "rap-pə-ḏû-nî", "traducao_palavra": "confortai-me" },
        { "hebraico": "בַּתַּפּוּחִ֔ים", "transliteral": "bat-tap-pū-ḥîm", "traducao_palavra": "com as macãs" },
        { "hebraico": "כִּי־חֹולַ֥ת", "transliteral": "kî-ḥô-laṯ", "traducao_palavra": "porque doente de" },
        { "hebraico": "אַהֲבָ֖ה", "transliteral": "ʾa-hă-ḇā", "traducao_palavra": "amor" },
        { "hebraico": "אָֽנִי׃", "transliteral": "ʾā-nî", "traducao_palavra": "[sou] eu" }
      ]
    },
    "6": {
      "traducao_completa": "A sua mão esquerda esteja debaixo da minha cabeça, e a sua mão direita me abrace.",
      "palavras": [
        { "hebraico": "שְׂמֹאלֹו֙", "transliteral": "śə-mō-lô", "traducao_palavra": "Sua esquerda" },
        { "hebraico": "תַּ֣חַת", "transliteral": "ta-ḥaṯ", "traducao_palavra": "debaixo de" },
        { "hebraico": "לְרֹאשִׁ֔י", "transliteral": "lə-rō-šî", "traducao_palavra": "minha cabeça" },
        { "hebraico": "וִימִינֹ֖ו", "transliteral": "wî-mî-nô", "traducao_palavra": "e sua direita" },
