{
  "livro": "Cantares - שִׁיר הַשִּׁירִים - Shir Hashirim",
  "capítulo": 2,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Eu sou a rosa de Sarom, o lírio dos vales.",
      "palavras": [
        { "hebraico": "אֲנִ֬י", "transliteral": "ʾă-nî", "traducao_palavra": "Eu [sou]" },
        { "hebraico": "חֲבַצֶּ֣לֶת", "transliteral": "ḥă-ḇaṣ-ṣe-leṯ", "traducao_palavra": "a rosa/flor de" },
