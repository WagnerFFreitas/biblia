        { "hebraico": "נִשְׁמַ֥ע", "transliteral": "niš-maʿ", "traducao_palavra": "ouviu-se" },
        { "hebraico": "בְּאַרְצֵֽנוּ׃", "transliteral": "bə-ʾar-ṣê-nû", "traducao_palavra": "em nossa terra" }
      ]
    },
    "13": {
      "traducao_completa": "A figueira já deu os seus figos verdes, e as vides em flor exalam o seu aroma; levanta-te, amada minha, formosa minha, e vem.",
      "palavras": [
        { "hebraico": "הַתְּאֵנָה֙", "transliteral": "hat-tə-ʾê-nā", "traducao_palavra": "A figueira" },
        { "hebraico": "חָנְטָ֣ה", "transliteral": "ḥā-nə-ṭā", "traducao_palavra": "amadureceu/pôs" },
        { "hebraico": "פַגֶּ֔יהָ", "transliteral": "p̄aḡ-ge-yā", "traducao_palavra": "seus figos temporãos" },
        { "hebraico": "וְהַגְּפָנִ֥ים ׀", "transliteral": "wə-hag-ḡə-p̄ā-nîm", "traducao_palavra": "e as videiras" },
        { "hebraico": "סְמָדַ֖ר", "transliteral": "śə-mā-ḏar", "traducao_palavra": "[em] flor" },
        { "hebraico": "נָתְנ֣וּ", "transliteral": "nā-ṯə-nû", "traducao_palavra": "deram" },
        { "hebraico": "רֵ֑יחַ", "transliteral": "rê-aḥ", "traducao_palavra": "perfume" },
        { "hebraico": "ק֧וּמִי", "transliteral": "qû-mî", "traducao_palavra": "levanta-te" },
        { "hebraico": "לָכי", "transliteral": "lā-ḵî", "traducao_palavra": "tu" },
        { "hebraico": "רַעְיָתִ֥י", "transliteral": "ra-ʿə-yā-ṯî", "traducao_palavra": "amada minha" },
        { "hebraico": "יָפָתִ֖י", "transliteral": "yā-p̄ā-ṯî", "traducao_palavra": "formosa minha" },
        { "hebraico": "וּלְכִי־לָֽךְ׃", "transliteral": "ū-lə-ḵî-lāḵ", "traducao_palavra": "e vem tu" }
      ]
    },
    "14": {
      "traducao_completa": "Pomba minha, que estás nas fendas das penhas, no esconderijo das ladeiras escabrosas, mostra-me a tua face, faze-me ouvir a tua voz, porque a tua voz é doce, e a tua face graciosa.",
      "palavras": [
        { "hebraico": "יֹונָתִ֞י", "transliteral": "yô-nā-ṯî", "traducao_palavra": "Pomba minha" },
        { "hebraico": "בְּחַגְוֵ֣י", "transliteral": "bə-ḥaḡ-wê", "traducao_palavra": "nas fendas de" },
        { "hebraico": "הַסֶּ֗לַע", "transliteral": "haś-śe-laʿ", "traducao_palavra": "a rocha" },
        { "hebraico": "בְּסֵ֨תֶר֙", "transliteral": "bə-śê-ṯer", "traducao_palavra": "no esconderijo de" },
        { "hebraico": "הַמַּדְרֵגָ֔ה", "transliteral": "ham-maḏ-rê-ḡā", "traducao_palavra": "o despenhadeiro" },
        { "hebraico": "הַרְאִ֥ינִי", "transliteral": "har-ʾî-nî", "traducao_palavra": "mostra-me" },
        { "hebraico": "אֶת־מַרְאַ֖יִךְ", "transliteral": "ʾeṯ-mar-ʾa-yiḵ", "traducao_palavra": "a tua face" },
        { "hebraico": "הַשְׁמִיעִ֣ינִי", "transliteral": "haš-mî-ʿî-nî", "traducao_palavra": "faz-me ouvir" },
        { "hebraico": "אֶת־קֹולֵ֑ךְ", "transliteral": "ʾeṯ-qô-lêḵ", "traducao_palavra": "a tua voz" },
        { "hebraico": "כִּי־קֹולֵ֥ךְ", "transliteral": "kî-qô-lêḵ", "traducao_palavra": "porque tua voz" },
