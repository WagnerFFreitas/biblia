      ]
    },
    "7": {
      "traducao_completa": "Conjuro-vos, ó filhas de Jerusalém, pelas gazelas e cervas do campo, que não desperteis nem acordeis o amor, até que este o queira.",
      "palavras": [
        { "hebraico": "הִשְׁבַּ֨עְתִּי", "transliteral": "hiš-ba-ʿatî", "traducao_palavra": "Conjuro/faço jurar" },
        { "hebraico": "אֶתְכֶ֜ם", "transliteral": "ʾeṯ-ḵem", "traducao_palavra": "a vós" },
        { "hebraico": "בְּנֹ֣ות", "transliteral": "bə-nôṯ", "traducao_palavra": "filhas de" },
        { "hebraico": "יְרוּשָׁלִָ֗ם", "transliteral": "yə-rû-šā-la-yim", "traducao_palavra": "Jerusalém" },
        { "hebraico": "בִּצְבָאֹות֙", "transliteral": "biṣ-ḇā-ʾôṯ", "traducao_palavra": "pelas gazelas" },
        { "hebraico": "אֹ֚ו", "transliteral": "ʾô", "traducao_palavra": "ou" },
        { "hebraico": "בְּאַיְלֹ֣ות", "transliteral": "bə-ʾay-lôṯ", "traducao_palavra": "pelas cervas de" },
        { "hebraico": "הַשָּׂדֶ֔ה", "transliteral": "haś-śā-ḏeh", "traducao_palavra": "o campo" },
        { "hebraico": "אִם־תָּעִ֧ירוּ", "transliteral": "ʾim-tā-ʿî-rû", "traducao_palavra": "que não desperteis" },
        { "hebraico": "וְאִם־תְּעֹורְר֛וּ", "transliteral": "wə-ʾim-tə-ʿô-rə-rû", "traducao_palavra": "e que não acordeis" },
        { "hebraico": "אֶת־הָאַהֲבָ֖ה", "transliteral": "ʾeṯ-hā-ʾa-hă-ḇā", "traducao_palavra": "o amor" },
        { "hebraico": "עַ֥ד", "transliteral": "ʿaḏ", "traducao_palavra": "até" },
        { "hebraico": "שֶׁתֶּחְפָּֽץ׃", "transliteral": "še-teḥ-pāṣ", "traducao_palavra": "que [ele] queira" }
      ]
    },
    "8": {
      "traducao_completa": "Esta é a voz do meu amado; ei-lo aí, que já vem saltando sobre os montes, pulando sobre os outeiros.",
      "palavras": [
        { "hebraico": "קֹ֣ול", "transliteral": "qôl", "traducao_palavra": "Voz de" },
        { "hebraico": "דֹּודִ֔י", "transliteral": "dô-ḏî", "traducao_palavra": "amado meu" },
        { "hebraico": "הִנֵּה־זֶ֖ה", "transliteral": "hin-nê-zeh", "traducao_palavra": "eis que este" },
        { "hebraico": "בָּ֑א", "transliteral": "bā", "traducao_palavra": "vem" },
        { "hebraico": "מְדַלֵּג֙", "transliteral": "mə-ḏal-lêḡ", "traducao_palavra": "saltando" },
        { "hebraico": "עַל־הֶהָרִ֔ים", "transliteral": "ʿal-he-hā-rîm", "traducao_palavra": "sobre os montes" },
        { "hebraico": "מְקַפֵּ֖ץ", "transliteral": "mə-qap-pêṣ", "traducao_palavra": "pulando" },
        { "hebraico": "עַל־הַגְּבָעֹֽות׃", "transliteral": "ʿal-ha-ḡə-ḇā-ʿôṯ", "traducao_palavra": "sobre os outeiros" }
      ]
    },
    "9": {
      "traducao_completa": "O meu amado é semelhante à gazela, ou ao filhote do veado; eis que está detrás da nossa parede, olhando pelas janelas, espreitando pelas frestas.",
      "palavras": [
        { "hebraico": "דֹּומֶ֤ה", "transliteral": "dô-meh", "traducao_palavra": "Semelhante [é]" },
        { "hebraico": "דֹודִי֙", "transliteral": "dô-ḏî", "traducao_palavra": "amado meu" },
        { "hebraico": "לִצְבִ֔י", "transliteral": "liṣ-ḇî", "traducao_palavra": "a uma gazela" },
        { "hebraico": "אֹ֖ו", "transliteral": "ʾô", "traducao_palavra": "ou" },
        { "hebraico": "לְעֹ֣פֶר", "transliteral": "lə-ʿō-p̄er", "traducao_palavra": "a um filhote de" },
        { "hebraico": "הָֽאַיָּלִ֑ים", "transliteral": "hā-ʾay-yā-lîm", "traducao_palavra": "cervos" },
        { "hebraico": "הִנֵּה־זֶ֤ה", "transliteral": "hin-nê-zeh", "traducao_palavra": "eis que este" },
        { "hebraico": "עֹומֵד֙", "transliteral": "ʿô-mêḏ", "traducao_palavra": "está de pé" },
        { "hebraico": "אַחַ֣ר", "transliteral": "ʾa-ḥar", "traducao_palavra": "atrás de" },
        { "hebraico": "כָּתְלֵ֔נוּ", "transliteral": "kā-ṯə-lê-nû", "traducao_palavra": "nossa parede" },
        { "hebraico": "מַשְׁגִּ֨יחַ֙", "transliteral": "maš-gî-aḥ", "traducao_palavra": "olhando" },
        { "hebraico": "מִן־הַחֲלֹּנֹ֔ות", "transliteral": "min-hā-ḥăl-lo-nôṯ", "traducao_palavra": "pelas janelas" },
        { "hebraico": "מֵצִ֖יץ", "transliteral": "mê-ṣîṣ", "traducao_palavra": "espreitando" },
        { "hebraico": "מִן־הַחֲרַכִּֽים׃", "transliteral": "min-ha-ḥă-rak-kîm", "traducao_palavra": "pelas frestas" }
      ]
    },
    "10": {
      "traducao_completa": "O meu amado fala e me diz: Levanta-te, amada minha, formosa minha, e vem.",
      "palavras": [
        { "hebraico": "עָנָ֥ה", "transliteral": "ʿā-nā", "traducao_palavra": "Falou/respondeu" },
