        { "hebraico": "לֹֽו׃", "transliteral": "lô", "traducao_palavra": "para si" }
      ]
    },
    "12": {
      "traducao_completa": "Aparecem as flores na terra, o tempo de cantar chegou, e a voz da rola ouve-se em nossa terra.",
      "palavras": [
        { "hebraico": "הַנִּצָּנִים֙", "transliteral": "han-niṣ-ṣā-nîm", "traducao_palavra": "As flores" },
        { "hebraico": "נִרְא֣וּ", "transliteral": "nir-ʾû", "traducao_palavra": "foram vistas/apareceram" },
        { "hebraico": "בָאָ֔רֶץ", "transliteral": "bā-ʾā-reṣ", "traducao_palavra": "na terra" },
        { "hebraico": "עֵ֥ת", "transliteral": "ʿēṯ", "traducao_palavra": "[o] tempo de" },
        { "hebraico": "הַזָּמִ֖יר", "transliteral": "haz-zā-mîr", "traducao_palavra": "podar/cantar" },
        { "hebraico": "הִגִּ֑יעַ", "transliteral": "hig-gî-aʿ", "traducao_palavra": "chegou" },
        { "hebraico": "וְקֹ֥ול", "transliteral": "wə-qôl", "traducao_palavra": "e a voz de" },
