        { "hebraico": "וְאָ֣מַר", "transliteral": "wə-ʾā-mar", "traducao_palavra": "e disse" },
        { "hebraico": "לִ֑י", "transliteral": "lî", "traducao_palavra": "a mim" },
        { "hebraico": "ק֧וּמִי", "transliteral": "qû-mî", "traducao_palavra": "levanta-te" },
        { "hebraico": "לָ֛ךְ", "transliteral": "lāḵ", "traducao_palavra": "tu" },
        { "hebraico": "רַעְיָתִ֥י", "transliteral": "ra-ʿə-yā-ṯî", "traducao_palavra": "amada minha" },
        { "hebraico": "יָפָתִ֖י", "transliteral": "yā-p̄ā-ṯî", "traducao_palavra": "formosa minha" },
        { "hebraico": "וּלְכִי־לָֽךְ׃", "transliteral": "ū-lə-ḵî-lāḵ", "traducao_palavra": "e vem tu" }
      ]
    },
    "11": {
      "traducao_completa": "Porque eis que passou o inverno; a chuva cessou, e se foi.",
      "palavras": [
        { "hebraico": "כִּֽי־הִנֵּ֥ה", "transliteral": "kî-hin-nēh", "traducao_palavra": "Porque eis que" },
        { "hebraico": "הַסְּתָ֖יו", "transliteral": "ha-śə-ṯāyw", "traducao_palavra": "o inverno" },
        { "hebraico": "עָבָ֑ר", "transliteral": "ʿā-ḇār", "traducao_palavra": "passou" },
        { "hebraico": "הַגֶּ֕שֶׁם", "transliteral": "hag-ge-šem", "traducao_palavra": "a chuva" },
        { "hebraico": "חָלַ֖ף", "transliteral": "ḥā-lap̄", "traducao_palavra": "passou/cessou" },
