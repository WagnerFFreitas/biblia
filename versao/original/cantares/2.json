        { "hebraico": "וּפִרְיֹ֖ו", "transliteral": "ū-p̄ir-yô", "traducao_palavra": "e seu fruto" },
        { "hebraico": "מָתֹ֥וק", "transliteral": "mā-ṯôq", "traducao_palavra": "[era] doce" },
