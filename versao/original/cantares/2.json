        { "hebraico": "שֹׁושַׁנַּ֖ת", "transliteral": "šô-šan-naṯ", "traducao_palavra": "o lírio de" },
        { "hebraico": "הָעֲמָקִֽים׃", "transliteral": "hā-ʿă-mā-qîm", "traducao_palavra": "os vales" }
      ]
    },
    "2": {
      "traducao_completa": "Como o lírio entre os espinhos, assim é a minha amada entre as filhas.",
      "palavras": [
        { "hebraico": "כְּשֹׁושַׁנָּה֙", "transliteral": "kə-šô-šan-nā", "traducao_palavra": "Como o lírio" },
        { "hebraico": "בֵּ֣ין", "transliteral": "bên", "traducao_palavra": "entre" },
        { "hebraico": "הַחֹוחִ֔ים", "transliteral": "ha-ḥô-ḥîm", "traducao_palavra": "os espinhos" },
        { "hebraico": "כֵּ֥ן", "transliteral": "kên", "traducao_palavra": "assim [é]" },
        { "hebraico": "רַעְיָתִ֖י", "transliteral": "ra-ʿə-yā-ṯî", "traducao_palavra": "amada minha" },
        { "hebraico": "בֵּ֥ין", "transliteral": "bên", "traducao_palavra": "entre" },
        { "hebraico": "הַבָּנֹֽות׃", "transliteral": "hab-bā-nôṯ", "traducao_palavra": "as filhas" }
      ]
    },
    "3": {
      "traducao_completa": "Como a macieira entre as árvores do bosque, assim é o meu amado entre os filhos; sob a sua sombra desejei assentar-me, e o seu fruto era doce ao meu paladar.",
      "palavras": [
        { "hebraico": "כְּתַפּ֨וּחַ֙", "transliteral": "kə-ṯap-pû-aḥ", "traducao_palavra": "Como a macieira" },
        { "hebraico": "בַּעֲצֵ֣י", "transliteral": "ba-ʿă-ṣê", "traducao_palavra": "entre as árvores de" },
        { "hebraico": "הַיַּ֔עַר", "transliteral": "hay-ya-ʿar", "traducao_palavra": "o bosque" },
        { "hebraico": "כֵּ֥ן", "transliteral": "kên", "traducao_palavra": "assim [é]" },
        { "hebraico": "דֹּודִ֖י", "transliteral": "dô-ḏî", "traducao_palavra": "amado meu" },
        { "hebraico": "בֵּ֣ין", "transliteral": "bên", "traducao_palavra": "entre" },
        { "hebraico": "הַבָּנִ֑ים", "transliteral": "hab-bā-nîm", "traducao_palavra": "os filhos/jovens" },
        { "hebraico": "בְּצִלֹּו֙", "transliteral": "bə-ṣil-lô", "traducao_palavra": "na sua sombra" },
        { "hebraico": "חִמַּ֣דְתִּי", "transliteral": "ḥim-maḏ-tî", "traducao_palavra": "desejei" },
