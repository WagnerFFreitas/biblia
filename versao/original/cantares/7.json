      ]
    },
    "5": {
      "traducao_completa": "Desvia de mim os teus olhos, porque eles me perturbam. O teu cabelo é como o rebanho de cabras que descem de Gileade.",
      "palavras": [
        { "hebraico": "הָסֵ֤בִּי", "transliteral": "hā-śêb-bî", "traducao_palavra": "Desvia" },
        { "hebraico": "עֵינַ֨יִךְ֙", "transliteral": "ʿê-na-yiḵ", "traducao_palavra": "teus olhos" },
        { "hebraico": "מִנֶּגְדִּ֔י", "transliteral": "min-neḡ-dî", "traducao_palavra": "de diante de mim" },
        { "hebraico": "שֶׁ֥הֵ֖ם", "transliteral": "še-hêm", "traducao_palavra": "porque eles" },
        { "hebraico": "הִרְהִיבֻ֑נִי", "transliteral": "hir-hî-ḇu-nî", "traducao_palavra": "me perturbam/vencem" },
        { "hebraico": "שַׂעְרֵךְ֙", "transliteral": "śa-ʿă-rêḵ", "traducao_palavra": "teu cabelo [é]" },
        { "hebraico": "כְּעֵ֣דֶר", "transliteral": "kə-ʿê-ḏer", "traducao_palavra": "como rebanho de" },
        { "hebraico": "הָעִזִּ֔ים", "transliteral": "hā-ʿiz-zîm", "traducao_palavra": "cabras" },
        { "hebraico": "שֶׁגָּלְשׁ֖וּ", "transliteral": "še-ḡā-lə-šû", "traducao_palavra": "que descem" },
        { "hebraico": "מִן־", "transliteral": "min-", "traducao_palavra": "de" },
        { "hebraico": "הַגִּלְעָֽד׃", "transliteral": "hag-gil-ʿāḏ", "traducao_palavra": "Gileade" }
      ]
    },
    "6": {
      "traducao_completa": "Os teus dentes são como o rebanho de ovelhas que sobem do lavadouro, e das quais todas produzem gêmeos, e não há estéril entre elas.",
      "palavras": [
        { "hebraico": "שִׁנַּ֨יִךְ֙", "transliteral": "šin-na-yiḵ", "traducao_palavra": "Teus dentes [são]" },
        { "hebraico": "כְּעֵ֣דֶר", "transliteral": "kə-ʿê-ḏer", "traducao_palavra": "como rebanho de" },
        { "hebraico": "הָֽרְחֵלִ֔ים", "transliteral": "hā-rə-ḥê-lîm", "traducao_palavra": "ovelhas" },
        { "hebraico": "שֶׁעָל֖וּ", "transliteral": "še-ʿā-lû", "traducao_palavra": "que subiram" },
        { "hebraico": "מִן־", "transliteral": "min-", "traducao_palavra": "do" },
        { "hebraico": "הָרַחְצָ֑ה", "transliteral": "ha-raḥ-ṣā", "traducao_palavra": "lavadouro" },
        { "hebraico": "שֶׁכֻּלָּם֙", "transliteral": "še-kul-lām", "traducao_palavra": "em que todas elas" },
        { "hebraico": "מַתְאִימֹ֔ות", "transliteral": "maṯ-ʾî-môṯ", "traducao_palavra": "produzem gêmeos" },
        { "hebraico": "וְשַׁכֻּלָ֖ה", "transliteral": "wə-šak-ku-lā", "traducao_palavra": "e estéril" },
        { "hebraico": "אֵ֥ין", "transliteral": "ʾên", "traducao_palavra": "não [há]" },
        { "hebraico": "בָּהֶֽם׃", "transliteral": "bā-hem", "traducao_palavra": "entre elas" }
      ]
    },
    "7": {
      "traducao_completa": "Como um pedaço de romã, assim são as tuas fontes por entre os teus cabelos.",
      "palavras": [
        { "hebraico": "כְּפֶ֤לַח", "transliteral": "kə-p̄e-laḥ", "traducao_palavra": "Como fatia/pedaço de" },
        { "hebraico": "הָרִמֹּון֙", "transliteral": "ha-rim-môn", "traducao_palavra": "a romã" },
        { "hebraico": "רַקָּתֵ֔ךְ", "transliteral": "raq-qā-ṯêḵ", "traducao_palavra": "tua fonte/têmpora" },
