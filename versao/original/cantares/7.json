        { "hebraico": "לְצַמָּתֵֽךְ׃", "transliteral": "lə-ṣam-mā-ṯêḵ", "traducao_palavra": "teu véu/cabelo" }
      ]
    },
    "8": {
      "traducao_completa": "Sessenta são as rainhas, e oitenta as concubinas, e as donzelas sem número.",
      "palavras": [
        { "hebraico": "שִׁשִּׁ֥ים", "transliteral": "šiš-šîm", "traducao_palavra": "Sessenta" },
        { "hebraico": "הֵ֨מָּה֙", "transliteral": "hêm-mā", "traducao_palavra": "são elas" },
        { "hebraico": "מְלָכֹ֔ות", "transliteral": "mə-lā-ḵôṯ", "traducao_palavra": "rainhas" },
        { "hebraico": "וּשְׁמֹנִ֖ים", "transliteral": "ū-šə-mō-nîm", "traducao_palavra": "e oitenta" },
        { "hebraico": "פִּֽילַגְשִׁ֑ים", "transliteral": "pî-laḡ-šîm", "traducao_palavra": "concubinas" },
        { "hebraico": "וַעֲלָמֹ֖ות", "transliteral": "wa-ʿă-lā-môṯ", "traducao_palavra": "e donzelas" },
