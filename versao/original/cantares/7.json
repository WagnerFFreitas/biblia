        { "hebraico": "מַרְכְּבֹ֖ות", "transliteral": "mar-kə-ḇôṯ", "traducao_palavra": "[nos] carros de" },
        { "hebraico": "עַמִּי־", "transliteral": "ʿam-mî-", "traducao_palavra": "meu povo" },
        { "hebraico": "נָדִֽיב׃", "transliteral": "nā-ḏîḇ", "traducao_palavra": "nobre/generoso" }
      ]
    },
    "13": {
      "traducao_completa": "Volta, volta, ó sulamita, volta, volta, para que te contemplemos. Por que quereis contemplar a sulamita como a dança de Maanaim?",
      "palavras": [
        { "hebraico": "שׁ֤וּבִי", "transliteral": "šû-ḇî", "traducao_palavra": "Volta" },
        { "hebraico": "שׁ֤וּבִי", "transliteral": "šû-ḇî", "traducao_palavra": "volta" },
        { "hebraico": "הַשּׁוּלַמִּית֙", "transliteral": "haš-šû-lam-mîṯ", "traducao_palavra": "ó sulamita" },
        { "hebraico": "שׁ֤וּבִי", "transliteral": "šû-ḇî", "traducao_palavra": "volta" },
        { "hebraico": "שׁ֤וּבִי", "transliteral": "šû-ḇî", "traducao_palavra": "volta" },
        { "hebraico": "וְנֶחֱזֶה־", "transliteral": "wə-ne-ḥĕ-zeh-", "traducao_palavra": "e olhemos/contemplemos" },
        { "hebraico": "בָּ֔ךְ", "transliteral": "bāḵ", "traducao_palavra": "em ti" },
