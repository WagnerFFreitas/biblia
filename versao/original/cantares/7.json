  "versiculos": {
    "1": {
      "traducao_completa": "Para onde foi o teu amado, ó mais formosa entre as mulheres? Para onde se retirou o teu amado, para que o busquemos contigo?",
      "palavras": [
        { "hebraico": "אָ֤נָה", "transliteral": "ʾā-nā", "traducao_palavra": "Para onde" },
        { "hebraico": "הָלַ֣ךְ", "transliteral": "hā-laḵ", "traducao_palavra": "foi" },
        { "hebraico": "דֹּודֵ֔ךְ", "transliteral": "dô-ḏêḵ", "traducao_palavra": "teu amado" },
        { "hebraico": "הַיָּפָ֖ה", "transliteral": "hay-yā-p̄ā", "traducao_palavra": "[ó] a formosa" },
        { "hebraico": "בַּנָּשִׁ֑ים", "transliteral": "ban-nā-šîm", "traducao_palavra": "entre as mulheres" },
        { "hebraico": "אָ֚נָה", "transliteral": "ʾā-nā", "traducao_palavra": "para onde" },
        { "hebraico": "פָּנָ֣ה", "transliteral": "pā-nā", "traducao_palavra": "se virou/retirou" },
        { "hebraico": "דֹודֵ֔ךְ", "transliteral": "dô-ḏêḵ", "traducao_palavra": "teu amado" },
        { "hebraico": "וּנְבַקְשֶׁ֖נּוּ", "transliteral": "ū-nə-ḇaq-šen-nû", "traducao_palavra": "para que o busquemos" },
        { "hebraico": "עִמָּֽךְ׃", "transliteral": "ʿim-māḵ", "traducao_palavra": "contigo" }
      ]
    },
    "2": {
      "traducao_completa": "O meu amado desceu ao seu jardim, aos canteiros de bálsamo, para apascentar nos jardins e para colher os lírios.",
      "palavras": [
        { "hebraico": "דֹּודִי֙", "transliteral": "dô-ḏî", "traducao_palavra": "Amado meu" },
        { "hebraico": "יָרַ֣ד", "transliteral": "yā-raḏ", "traducao_palavra": "desceu" },
        { "hebraico": "לְגַנֹּ֔ו", "transliteral": "lə-ḡan-nô", "traducao_palavra": "ao seu jardim" },
        { "hebraico": "לַעֲרוּגֹ֖ות", "transliteral": "la-ʿă-rû-ḡôṯ", "traducao_palavra": "aos canteiros de" },
        { "hebraico": "הַבֹּ֑שֶׁם", "transliteral": "hab-bō-śem", "traducao_palavra": "bálsamo/especiaria" },
        { "hebraico": "לִרְעֹות֙", "transliteral": "lir-ʿôṯ", "traducao_palavra": "para pastorear" },
        { "hebraico": "בַּגַּנִּ֔ים", "transliteral": "ba-gan-nîm", "traducao_palavra": "nos jardins" },
        { "hebraico": "וְלִלְקֹ֖ט", "transliteral": "wə-lil-qōṭ", "traducao_palavra": "e para colher" },
        { "hebraico": "שֹׁושַׁנִּֽים׃", "transliteral": "šô-šan-nîm", "traducao_palavra": "lírios" }
      ]
    },
    "3": {
      "traducao_completa": "Eu sou do meu amado, e o meu amado é meu; ele apascenta entre os lírios.",
      "palavras": [
        { "hebraico": "אֲנִ֤י", "transliteral": "ʾă-nî", "traducao_palavra": "Eu [sou]" },
        { "hebraico": "לְדֹודִי֙", "transliteral": "lə-ḏô-ḏî", "traducao_palavra": "do meu amado" },
        { "hebraico": "וְדֹודִ֣י", "transliteral": "wə-ḏô-ḏî", "traducao_palavra": "e o amado meu" },
        { "hebraico": "לִ֔י", "transliteral": "lî", "traducao_palavra": "[é] meu" },
        { "hebraico": "הָרֹעֶ֖ה", "transliteral": "ha-rō-ʿeh", "traducao_palavra": "que pastoreia" },
        { "hebraico": "בַּשֹּׁושַׁנִּֽים׃", "transliteral": "baš-šô-šan-nîm", "traducao_palavra": "entre os lírios" }
      ]
    },
    "4": {
      "traducao_completa": "Formosa és, amada minha, como Tirza, aprazível como Jerusalém, terrível como um exército com bandeiras.",
      "palavras": [
        { "hebraico": "יָפָ֨ה", "transliteral": "yā-p̄ā", "traducao_palavra": "Formosa" },
        { "hebraico": "אַתְּ", "transliteral": "ʾat", "traducao_palavra": "[és] tu" },
        { "hebraico": "רַעְיָתִ֜י", "transliteral": "ra-ʿə-yā-ṯî", "traducao_palavra": "amada minha" },
        { "hebraico": "כְּתִרְצָ֗ה", "transliteral": "kə-ṯir-ṣā", "traducao_palavra": "como Tirza" },
        { "hebraico": "נָאווה֙", "transliteral": "nā-wā", "traducao_palavra": "aprazível/bela" },
        { "hebraico": "כִּירוּשָׁלִָ֔ם", "transliteral": "kî-rû-šā-la-yim", "traducao_palavra": "como Jerusalém" },
        { "hebraico": "אֲיֻמָּ֖ה", "transliteral": "ʾă-yum-mā", "traducao_palavra": "terrível/majestosa" },
