        { "hebraico": "כַלְּבָנָ֔ה", "transliteral": "ḵal-lə-ḇā-nā", "traducao_palavra": "como a lua" },
        { "hebraico": "בָּרָ֖ה", "transliteral": "bā-rā", "traducao_palavra": "pura/brilhante" },
        { "hebraico": "כַּחַמָּ֑ה", "transliteral": "ka-ḥam-mā", "traducao_palavra": "como o sol" },
        { "hebraico": "אֲיֻמָּ֖ה", "transliteral": "ʾă-yum-mā", "traducao_palavra": "terrível/majestosa" },
        { "hebraico": "כַּנִּדְגָּלֹֽות׃", "transliteral": "kan-niḏ-gā-lôṯ", "traducao_palavra": "como exércitos com bandeiras" }
      ]
    },
    "11": {
      "traducao_completa": "Desci ao jardim das nogueiras, para ver os renovos do vale, para ver se floresciam as vides, se brotavam as romãs.",
      "palavras": [
        { "hebraico": "אֶל־", "transliteral": "ʾel-", "traducao_palavra": "Para" },
        { "hebraico": "גִּנַּ֤ת", "transliteral": "gin-naṯ", "traducao_palavra": "[o] jardim de" },
        { "hebraico": "אֱגֹוז֙", "transliteral": "ʾĕ-ḡôz", "traducao_palavra": "nozes" },
        { "hebraico": "יָרַ֔דְתִּי", "transliteral": "yā-raḏ-tî", "traducao_palavra": "desci" },
        { "hebraico": "לִרְאֹ֖ות", "transliteral": "lir-ʾôṯ", "traducao_palavra": "para ver" },
        { "hebraico": "בְּאִבֵּ֣י", "transliteral": "bə-ʾib-bê", "traducao_palavra": "nos renovos de" },
        { "hebraico": "הַנָּ֑חַל", "transliteral": "han-nā-ḥal", "traducao_palavra": "o vale/ribeiro" },
        { "hebraico": "לִרְאֹות֙", "transliteral": "lir-ʾôṯ", "traducao_palavra": "para ver" },
        { "hebraico": "הֲפָרְחָ֣ה", "transliteral": "hă-p̄ā-rə-ḥā", "traducao_palavra": "se floresceu" },
        { "hebraico": "הַגֶּ֔פֶן", "transliteral": "hag-ge-p̄en", "traducao_palavra": "a videira" },
        { "hebraico": "הֵנֵ֖צוּ", "transliteral": "hê-nê-ṣû", "traducao_palavra": "se brotaram" },
        { "hebraico": "הָרִמֹּונִֽים׃", "transliteral": "hā-rim-mô-nîm", "traducao_palavra": "as romãs" }
      ]
    },
    "12": {
      "traducao_completa": "Não sei como, a minha alma me pôs nos carros do meu povo generoso.",
      "palavras": [
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "Não" },
