        { "hebraico": "הִיא֙", "transliteral": "hî", "traducao_palavra": "[é] ela" },
        { "hebraico": "יֹונָתִ֣י", "transliteral": "yô-nā-ṯî", "traducao_palavra": "pomba minha" },
        { "hebraico": "תַמָּתִ֔י", "transliteral": "ṯam-mā-ṯî", "traducao_palavra": "perfeita minha" },
        { "hebraico": "אַחַ֥ת", "transliteral": "ʾa-ḥaṯ", "traducao_palavra": "única" },
        { "hebraico": "הִיא֙", "transliteral": "hî", "traducao_palavra": "ela [é]" },
        { "hebraico": "לְאִמָּ֔הּ", "transliteral": "lə-ʾim-māh", "traducao_palavra": "para sua mãe" },
        { "hebraico": "בָּרָ֥ה", "transliteral": "bā-rā", "traducao_palavra": "pura/escolhida" },
        { "hebraico": "הִ֖יא", "transliteral": "hî", "traducao_palavra": "ela [é]" },
        { "hebraico": "לְיֹולַדְתָּ֑הּ", "transliteral": "lə-yô-laḏ-tāh", "traducao_palavra": "para quem a gerou" },
        { "hebraico": "רָאָ֤וּהָ", "transliteral": "rā-ʾû-hā", "traducao_palavra": "viram-na" },
        { "hebraico": "בָנֹות֙", "transliteral": "bā-nôṯ", "traducao_palavra": "[as] filhas" },
        { "hebraico": "וַֽיְאַשְּׁר֔וּהָ", "transliteral": "way-ʾaš-šə-rû-hā", "traducao_palavra": "e chamaram-na feliz" },
