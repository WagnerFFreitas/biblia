        { "hebraico": "מִי־", "transliteral": "mî-", "traducao_palavra": "Quem [é]" },
        { "hebraico": "זֹאת֙", "transliteral": "zōṯ", "traducao_palavra": "esta" },
        { "hebraico": "הַנִּשְׁקָפָה֙", "transliteral": "han-niš-qā-p̄ā", "traducao_palavra": "que aparece/olha para fora" },
        { "hebraico": "כְּמֹו־", "transliteral": "kə-mô-", "traducao_palavra": "como" },
        { "hebraico": "שָׁ֔חַר", "transliteral": "šā-ḥar", "traducao_palavra": "[a] aurora" },
