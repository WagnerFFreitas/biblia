  "versiculos": {
    "1": {
      "traducao_completa": "Eis que és formosa, amada minha, eis que és formosa; os teus olhos são como os das pombas por entre o teu véu; o teu cabelo é como o rebanho de cabras que pastam no monte Gileade.",
      "palavras": [
        { "hebraico": "הִנָּ֨ךְ", "transliteral": "hin-nāḵ", "traducao_palavra": "Eis que tu [és]" },
