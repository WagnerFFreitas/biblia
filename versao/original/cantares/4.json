        { "hebraico": "רַעְיָתִי֙", "transliteral": "ra-ʿə-yā-ṯî", "traducao_palavra": "amada minha" },
        { "hebraico": "הִנָּ֣ךְ", "transliteral": "hin-nāḵ", "traducao_palavra": "eis que tu [és]" },
