    "2": {
      "traducao_completa": "Os teus dentes são como o rebanho das ovelhas tosquiadas, que sobem do lavadouro, e das quais todas produzem gêmeos, e nenhuma delas é estéril.",
      "palavras": [
        { "hebraico": "שִׁנַּ֨יִךְ֙", "transliteral": "šin-na-yiḵ", "traducao_palavra": "Teus dentes [são]" },
        { "hebraico": "כְּעֵ֣דֶρ", "transliteral": "kə-ʿê-ḏer", "traducao_palavra": "como rebanho de" },
        { "hebraico": "הַקְּצוּבֹ֔ות", "transliteral": "haq-qə-ṣû-ḇôṯ", "traducao_palavra": "as [ovelhas] tosquiadas" },
