    "7": {
      "traducao_completa": "Tu és toda formosa, amada minha, e em ti não há mancha.",
      "palavras": [
        { "hebraico": "כֻּלָּ֤ךְ", "transliteral": "kul-lāḵ", "traducao_palavra": "Toda tu" },
