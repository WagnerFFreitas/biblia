        { "hebraico": "שֶׁיָּפ֨וּחַ֙", "transliteral": "še-yyā-p̄û-aḥ", "traducao_palavra": "que sopre/refresque" },
        { "hebraico": "הַיֹּ֔ום", "transliteral": "hay-yôm", "traducao_palavra": "o dia" },
