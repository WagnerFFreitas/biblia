        { "hebraico": "עֵינַ֣יִךְ", "transliteral": "ʿê-na-yiḵ", "traducao_palavra": "teus olhos [são]" },
        { "hebraico": "יֹונִים", "transliteral": "yô-nîm", "traducao_palavra": "pombas" },
