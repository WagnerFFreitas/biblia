        { "hebraico": "סִ֭יגִים", "transliteral": "śî-ḡîm", "traducao_palavra": "[como] escórias" },
        { "hebraico": "מְצֻפֶּ֣ה", "transliteral": "mə-ṣup-peh", "traducao_palavra": "revestido" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre" },
        { "hebraico": "חָ֑רֶשׂ", "transliteral": "ḥā-reś", "traducao_palavra": "[um] caco de barro" },
