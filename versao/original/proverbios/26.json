        { "hebraico": "אֵלָ֥יו", "transliteral": "ʾê-lāyw", "traducao_palavra": "para ele" },
        { "hebraico": "תָּשֽׁוּב׃", "transliteral": "tā-šûḇ", "traducao_palavra": "ela voltará" }
