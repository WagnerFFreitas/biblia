        { "hebraico": "יְחַנֵּ֣ן", "transliteral": "yə-ḥan-nên", "traducao_palavra": "ele tornar graciosa" },
        { "hebraico": "קֹ֭ולֹו", "transliteral": "qô-lô", "traducao_palavra": "sua voz" },
        { "hebraico": "אַל־", "transliteral": "ʾal-", "traducao_palavra": "não" },
        { "hebraico": "תַּאֲמֶן־", "transliteral": "ta-ʾă-men-", "traducao_palavra": "creas" },
        { "hebraico": "בֹּ֑ו", "transliteral": "bô", "traducao_palavra": "nele" },
        { "hebraico": "כִּ֭י", "transliteral": "kî", "traducao_palavra": "pois" },
        { "hebraico": "שֶׁ֤בֶע", "transliteral": "še-ḇaʿ", "traducao_palavra": "sete" },
