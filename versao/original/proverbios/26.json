    "27": {
      "traducao_completa": "O que cava uma cova nela cairá; e o que revolve a pedra, esta voltará sobre ele.",
      "palavras": [
        { "hebraico": "כֹּרֶה־", "transliteral": "kō-rēh-", "traducao_palavra": "O que cava" },
