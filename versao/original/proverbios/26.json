{
  "livro": "Provérbios - מִשְׁלֵי - Mishlei",
  "capítulo": 26,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Como a neve no verão, e como a chuva na ceifa, assim a honra não convém ao tolo.",
      "palavras": [
        { "hebraico": "כַּשֶּׁ֣לֶג", "transliteral": "kaš-še-leḡ", "traducao_palavra": "Como a neve" },
        { "hebraico": "בַּ֭קַּיִץ", "transliteral": "baq-qa-yiṣ", "traducao_palavra": "no verão" },
        { "hebraico": "וְכַמָּטָ֣ר", "transliteral": "wə-ḵam-mā-ṭār", "traducao_palavra": "e como a chuva" },
        { "hebraico": "בַּקָּצִ֑יר", "transliteral": "baq-qā-ṣîr", "traducao_palavra": "na ceifa/colheita" },
        { "hebraico": "כֵּ֤ן", "transliteral": "kên", "traducao_palavra": "assim" },
        { "hebraico": "לֹא־נֳָאוֶ֖ה", "transliteral": "lō-nā-weh", "traducao_palavra": "não é apropriada/convém" },
        { "hebraico": "לִכְסִ֣יל", "transliteral": "liḵ-śîl", "traducao_palavra": "ao tolo" },
        { "hebraico": "כָּבֹֽוד׃", "transliteral": "kā-ḇôḏ", "traducao_palavra": "a honra" }
      ]
    },
    "2": {
      "traducao_completa": "Como o pássaro no seu vaguear e a andorinha no seu voo, assim a maldição sem causa não virá a pousar.",
      "palavras": [
        { "hebraico": "כַּצִּפֹּ֣ור", "transliteral": "kaṣ-ṣip-pôr", "traducao_palavra": "Como o pássaro" },
        { "hebraico": "לָ֭נוּד", "transliteral": "lā-nûḏ", "traducao_palavra": "no vaguear" },
        { "hebraico": "כַּדְּרֹ֣ור", "transliteral": "kad-də-rôr", "traducao_palavra": "como a andorinha/liberdade" },
        { "hebraico": "לָע֑וּף", "transliteral": "lā-ʿûp̄", "traducao_palavra": "no voar" },
        { "hebraico": "כֵּ֥ן", "transliteral": "kên", "traducao_palavra": "assim" },
        { "hebraico": "קִלְלַ֥ת", "transliteral": "qil-laṯ", "traducao_palavra": "a maldição de" },
        { "hebraico": "חִנָּ֗ם", "transliteral": "ḥin-nām", "traducao_palavra": "sem causa/gratuitamente" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "תָבֹֽא׃", "transliteral": "ṯā-ḇō", "traducao_palavra": "virá/pousará" }
      ]
    },
    "3": {
      "traducao_completa": "O açoite é para o cavalo, o freio para o jumento, e a vara para as costas dos tolos.",
      "palavras": [
        { "hebraico": "שֹׁ֣וט", "transliteral": "šôṭ", "traducao_palavra": "Açoite" },
        { "hebraico": "לַ֭סּוּס", "transliteral": "las-sûs", "traducao_palavra": "para o cavalo" },
        { "hebraico": "מֶ֣תֶג", "transliteral": "me-ṯeḡ", "traducao_palavra": "freio/rédea" },
        { "hebraico": "לַחֲמֹ֑ור", "transliteral": "la-ḥă-môr", "traducao_palavra": "para o jumento" },
        { "hebraico": "וְ֝שֵׁ֗בֶט", "transliteral": "wə-šê-ḇeṭ", "traducao_palavra": "e a vara" },
        { "hebraico": "לְגֵ֣ו", "transliteral": "lə-ḡêw", "traducao_palavra": "para as costas de" },
        { "hebraico": "כְּסִילִֽים׃", "transliteral": "kə-śî-lîm", "traducao_palavra": "tolos" }
      ]
    },
    "4": {
      "traducao_completa": "Não respondas ao tolo segundo a sua estultícia, para que não te faças semelhante a ele.",
      "palavras": [
        { "hebraico": "אַל־תַּ֥עַן", "transliteral": "ʾal-ta-ʿan", "traducao_palavra": "Não respondas" },
        { "hebraico": "כְּסִ֗יל", "transliteral": "kə-śîl", "traducao_palavra": "[ao] tolo" },
        { "hebraico": "כְּאִוַּלְתֹּ֥ו", "transliteral": "kə-ʾiw-wal-tô", "traducao_palavra": "segundo a estultícia dele" },
        { "hebraico": "פֶּן־תִּשְׁוֶה־", "transliteral": "pen-tiš-weh-", "traducao_palavra": "para que não te assemelhes" },
        { "hebraico": "לֹּ֥ו", "transliteral": "lô", "traducao_palavra": "a ele" },
        { "hebraico": "גַּם־אָֽתָּה׃", "transliteral": "gam-ʾāt-tā", "traducao_palavra": "também tu" }
      ]
    },
    "5": {
      "traducao_completa": "Responde ao tolo segundo a sua estultícia, para que não seja sábio aos seus próprios olhos.",
      "palavras": [
        { "hebraico": "עֲנֵ֣ה", "transliteral": "ʿă-nēh", "traducao_palavra": "Responde" },
        { "hebraico": "כְ֭סִיל", "transliteral": "ḵə-śîl", "traducao_palavra": "[ao] tolo" },
        { "hebraico": "כְּאִוַּלְתֹּ֑ו", "transliteral": "kə-ʾiw-wal-tô", "traducao_palavra": "segundo a estultícia dele" },
        { "hebraico": "פֶּן־יִהְיֶ֖ה", "transliteral": "pen-yih-yeh", "traducao_palavra": "para que não seja" },
        { "hebraico": "חָכָ֣ם", "transliteral": "ḥā-ḵām", "traducao_palavra": "sábio" },
        { "hebraico": "בְּעֵינָֽיו׃", "transliteral": "bə-ʿê-nāyw", "traducao_palavra": "em seus olhos" }
      ]
    },
    "6": {
      "traducao_completa": "Como quem corta os próprios pés e bebe a violência, assim é o que envia mensagem por mão de um tolo.",
      "palavras": [
        { "hebraico": "מְקַצֶּ֣ה", "transliteral": "mə-qaṣ-ṣeh", "traducao_palavra": "Corta" },
        { "hebraico": "רַ֭גְלַיִם", "transliteral": "raḡ-la-yim", "traducao_palavra": "pés" },
        { "hebraico": "חָמָ֣ס", "transliteral": "ḥā-mās", "traducao_palavra": "violência" },
        { "hebraico": "שֹׁתֶ֑ה", "transliteral": "šō-ṯeh", "traducao_palavra": "bebe" },
        { "hebraico": "שֹׁלֵ֥חַ", "transliteral": "šō-lê-aḥ", "traducao_palavra": "[o que] envia" },
        { "hebraico": "דְּ֝ḇָרִ֗ים", "transliteral": "də-ḇā-rîm", "traducao_palavra": "palavras/mensagem" },
        { "hebraico": "בְּיַד־", "transliteral": "bə-yaḏ-", "traducao_palavra": "pela mão de" },
        { "hebraico": "כְּסִֽיל׃", "transliteral": "kə-śîl", "traducao_palavra": "um tolo" }
      ]
    },
    "7": {
      "traducao_completa": "Como as pernas do coxo, que pendem inúteis, assim é o provérbio na boca dos tolos.",
      "palavras": [
        { "hebraico": "דַּלְי֣וּ", "transliteral": "dal-yû", "traducao_palavra": "Penderam/são fracas" },
        { "hebraico": "שֹׁ֭קַיִם", "transliteral": "šō-qa-yim", "traducao_palavra": "as pernas" },
        { "hebraico": "מִפִּסֵּ֑חַ", "transliteral": "mip-pis-sē-aḥ", "traducao_palavra": "do coxo" },
        { "hebraico": "וּ֝מָשָׁ֗ל", "transliteral": "ū-mā-šāl", "traducao_palavra": "e um provérbio" },
        { "hebraico": "בְּפִ֣י", "transliteral": "bə-p̄î", "traducao_palavra": "na boca de" },
