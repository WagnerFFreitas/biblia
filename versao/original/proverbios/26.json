        { "hebraico": "בָּ֣הּ", "transliteral": "bāh", "traducao_palavra": "nela" },
        { "hebraico": "יִפֹּ֑ול", "transliteral": "yip-pôl", "traducao_palavra": "cairá" },
        { "hebraico": "וְגֹלֵ֥ל", "transliteral": "wə-ḡō-lēl", "traducao_palavra": "e o que rola/revolve" },
