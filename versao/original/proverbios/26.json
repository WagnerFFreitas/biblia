        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre/ao" },
        { "hebraico": "קֵאֹ֑ו", "transliteral": "qê-ʾô", "traducao_palavra": "seu vômito" },
        { "hebraico": "כְּ֝סִ֗יל", "transliteral": "kə-śîl", "traducao_palavra": "[assim é o] tolo" },
        { "hebraico": "שֹׁונֶ֥ה", "transliteral": "šô-neh", "traducao_palavra": "[que] repete" },
        { "hebraico": "בְאִוַּלְתֹּֽו׃", "transliteral": "ḇə-ʾiw-wal-tô", "traducao_palavra": "em sua estultícia" }
