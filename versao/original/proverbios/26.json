    "20": {
      "traducao_completa": "Sem lenha, o fogo se apaga; e não havendo maldizente, cessa a contenda.",
      "palavras": [
        { "hebraico": "בְּאֶ֣פֶס", "transliteral": "bə-ʾe-p̄es", "traducao_palavra": "Em falta/fim de" },
        { "hebraico": "עֵ֭צִים", "transliteral": "ʿê-ṣîm", "traducao_palavra": "lenhas" },
        { "hebraico": "תִּכְבֶּה־", "transliteral": "tiḵ-beh-", "traducao_palavra": "apaga-se" },
        { "hebraico": "אֵ֑שׁ", "transliteral": "ʾêš", "traducao_palavra": "[o] fogo" },
        { "hebraico": "וּבְאֵ֥ין", "transliteral": "ū-ḇə-ʾên", "traducao_palavra": "e em não havendo" },
        { "hebraico": "נִ֝רְגָּ֗ן", "transliteral": "nir-gān", "traducao_palavra": "murmurador/maldizente" },
        { "hebraico": "יִשְׁתֹּ֥ק", "transliteral": "yiš-tōq", "traducao_palavra": "silenciará/cessará" },
        { "hebraico": "מָדֹֽון׃", "transliteral": "mā-ḏôn", "traducao_palavra": "[a] contenda" }
      ]
    },
    "21": {
      "traducao_completa": "Como o carvão para as brasas e a lenha para o fogo, assim é o homem briguento para acender contendas.",
      "palavras": [
        { "hebraico": "פֶּחָ֣ם", "transliteral": "pe-ḥām", "traducao_palavra": "Carvão" },
        { "hebraico": "לְ֭גֶחָלִים", "transliteral": "lə-ḡe-ḥā-lîm", "traducao_palavra": "para brasas" },
        { "hebraico": "וְעֵצִ֣ים", "transliteral": "wə-ʿê-ṣîm", "traducao_palavra": "e lenha" },
        { "hebraico": "לְאֵ֑שׁ", "transliteral": "lə-ʾêš", "traducao_palavra": "para fogo" },
        { "hebraico": "וְאִ֥ישׁ", "transliteral": "wə-ʾîš", "traducao_palavra": "e um homem" },
        { "hebraico": "מִ֝דְיָנִ֗ים", "transliteral": "miḏ-yā-nîm", "traducao_palavra": "de contendas" },
        { "hebraico": "לְחַרְחַר־", "transliteral": "lə-ḥar-ḥar-", "traducao_palavra": "para inflamar/acender" },
        { "hebraico": "רִֽיב׃", "transliteral": "rîḇ", "traducao_palavra": "disputa" }
      ]
    },
    "22": {
      "traducao_completa": "As palavras do caluniador são como guloseimas, e descem até o mais íntimo do ventre.",
      "palavras": [
        { "hebraico": "דִּבְרֵ֣י", "transliteral": "diḇ-rê", "traducao_palavra": "As palavras de" },
        { "hebraico": "נִ֭רְגָּן", "transliteral": "nir-gān", "traducao_palavra": "[um] caluniador" },
