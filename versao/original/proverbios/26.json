    },
    "18": {
      "traducao_completa": "Como o louco que lança fogo, flechas e morte,",
      "palavras": [
        { "hebraico": "כְּֽ֭מִתְלַהְלֵהַּ", "transliteral": "kə-miṯ-lah-lē-ha", "traducao_palavra": "Como um louco/alguém que se finge demente" },
        { "hebraico": "הַיֹּרֶ֥ה", "transliteral": "hay-yō-reh", "traducao_palavra": "que atira/lança" },
        { "hebraico": "זִקִּ֗ים", "transliteral": "ziq-qîm", "traducao_palavra": "dardos inflamados/fogo" },
        { "hebraico": "חִצִּ֥ים", "transliteral": "ḥiṣ-ṣîm", "traducao_palavra": "flechas" },
        { "hebraico": "וָמָֽוֶת׃", "transliteral": "wā-mā-weṯ", "traducao_palavra": "e morte" }
