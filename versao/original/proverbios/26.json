        { "hebraico": "שַׁ֣חַל", "transliteral": "ša-ḥal", "traducao_palavra": "[há um] leão novo/feroz" },
        { "hebraico": "בַּדָּ֑רֶךְ", "transliteral": "bad-de-reḵ", "traducao_palavra": "no caminho" },
        { "hebraico": "אֲ֝רִ֗י", "transliteral": "ʾă-rî", "traducao_palavra": "[um] leão" },
        { "hebraico": "בֵּ֣ין", "transliteral": "bên", "traducao_palavra": "entre/no meio de" },
        { "hebraico": "הָרְחֹבֹֽות׃", "transliteral": "hā-rə-ḥō-ḇôṯ", "traducao_palavra": "as ruas" }
      ]
    },
    "14": {
      "traducao_completa": "Como a porta gira nos seus gonzos, assim o preguiçoso na sua cama.",
      "palavras": [
        { "hebraico": "הַ֭דֶּלֶת", "transliteral": "had-de-leṯ", "traducao_palavra": "A porta" },
        { "hebraico": "תִּסֹּ֣וב", "transliteral": "tis-śôḇ", "traducao_palavra": "gira" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre" },
        { "hebraico": "צִירָ֑הּ", "transliteral": "ṣî-rāh", "traducao_palavra": "seu gonzo/eixo" },
        { "hebraico": "וְ֝עָצֵ֗ל", "transliteral": "wə-ʿā-ṣēl", "traducao_palavra": "e o preguiçoso" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre" },
        { "hebraico": "מִטָּתֹֽו׃", "transliteral": "miṭ-ṭā-ṯô", "traducao_palavra": "sua cama" }
      ]
    },
    "15": {
      "traducao_completa": "O preguiçoso esconde a mão no prato; e cansa-se de a tornar a levar à boca.",
      "palavras": [
        { "hebraico": "טָ֘מַ֤ן", "transliteral": "ṭā-man", "traducao_palavra": "Escondeu" },
        { "hebraico": "עָצֵ֣ל", "transliteral": "ʿā-ṣēl", "traducao_palavra": "[o] preguiçoso" },
        { "hebraico": "יָ֭דֹו", "transliteral": "yā-ḏô", "traducao_palavra": "sua mão" },
        { "hebraico": "בַּצַּלָּ֑חַת", "transliteral": "baṣ-ṣal-lā-ḥaṯ", "traducao_palavra": "no prato/tigela" },
        { "hebraico": "נִ֝לְאָ֗ה", "transliteral": "nil-ʾā", "traducao_palavra": "[ele] cansa-se" },
        { "hebraico": "לַהֲשִׁיבָ֥הּ", "transliteral": "la-hă-šî-ḇāh", "traducao_palavra": "de fazê-la voltar" },
        { "hebraico": "אֶל־", "transliteral": "ʾel-", "traducao_palavra": "para" },
        { "hebraico": "פִּֽיו׃", "transliteral": "pîw", "traducao_palavra": "sua boca" }
      ]
    },
    "16": {
      "traducao_completa": "Mais sábio é o preguiçoso aos seus próprios olhos do que sete homens que sabem responder bem.",
      "palavras": [
        { "hebraico": "חָ֘כָ֤ם", "transliteral": "ḥā-ḵām", "traducao_palavra": "Sábio [é]" },
        { "hebraico": "עָצֵ֣ל", "transliteral": "ʿā-ṣēl", "traducao_palavra": "[o] preguiçoso" },
        { "hebraico": "בְּעֵינָ֑יו", "transliteral": "bə-ʿê-nāyw", "traducao_palavra": "em seus olhos" },
        { "hebraico": "מִ֝שִּׁבְעָ֗ה", "transliteral": "miš-šiḇ-ʿā", "traducao_palavra": "do que sete" },
        { "hebraico": "מְשִׁ֥יבֵי", "transliteral": "mə-šî-ḇê", "traducao_palavra": "que respondem" },
        { "hebraico": "טָֽעַם׃", "transliteral": "ṭā-ʿam", "traducao_palavra": "[com] discrição/senso" }
      ]
    },
    "17": {
      "traducao_completa": "O que, passando, se envolve em questão alheia, é como aquele que pega um cão pelas orelhas.",
      "palavras": [
        { "hebraico": "מַחֲזִ֣יק", "transliteral": "ma-ḥă-zîq", "traducao_palavra": "Pega/segura" },
        { "hebraico": "בְּאָזְנֵי־", "transliteral": "bə-ʾāz-nê-", "traducao_palavra": "pelas orelhas de" },
        { "hebraico": "כָ֑לֶב", "transliteral": "ḵā-leḇ", "traducao_palavra": "[um] cão" },
        { "hebraico": "עֹ֝בֵ֗ר", "transliteral": "ʿō-ḇēr", "traducao_palavra": "[o que] passa" },
        { "hebraico": "מִתְעַבֵּ֥ר", "transliteral": "miṯ-ʿab-bêr", "traducao_palavra": "[e] se enfurece/envolve" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre" },
        { "hebraico": "רֲִיב", "transliteral": "rîḇ", "traducao_palavra": "contenda" },
        { "hebraico": "לֹּא־", "transliteral": "lō-", "traducao_palavra": "[que] não [é]" },
