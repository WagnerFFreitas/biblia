        { "hebraico": "חָ֘זִ֤יתָ", "transliteral": "ḥā-zî-ṯā", "traducao_palavra": "Viste" },
        { "hebraico": "אִ֗ישׁ", "transliteral": "ʾîš", "traducao_palavra": "um homem" },
        { "hebraico": "חָכָ֥ם", "transliteral": "ḥā-ḵām", "traducao_palavra": "sábio" },
        { "hebraico": "בְּעֵינָ֑יו", "transliteral": "bə-ʿê-nāyw", "traducao_palavra": "em seus olhos" },
        { "hebraico": "תִּקְוָ֖ה", "transliteral": "tiq-wā", "traducao_palavra": "esperança [há]" },
        { "hebraico": "לִכְסִ֣יל", "transliteral": "liḵ-śîl", "traducao_palavra": "para o tolo" },
