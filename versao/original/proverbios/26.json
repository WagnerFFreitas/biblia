      ]
    },
    "8": {
      "traducao_completa": "Como o que ata a pedra na funda, assim é o que dá honra ao tolo.",
      "palavras": [
        { "hebraico": "כִּצְרֹ֥ור", "transliteral": "kiṣ-rôr", "traducao_palavra": "Como o atar" },
        { "hebraico": "אֶ֝בֶן", "transliteral": "ʾe-ḇen", "traducao_palavra": "uma pedra" },
        { "hebraico": "בְּמַרְגֵּמָ֗ה", "transliteral": "bə-mar-ḡê-mā", "traducao_palavra": "na funda/monte de pedras" },
        { "hebraico": "כֵּן־נֹותֵ֖ן", "transliteral": "kên-nô-ṯên", "traducao_palavra": "assim [é o que] dá" },
        { "hebraico": "לִכְסִ֣יל", "transliteral": "liḵ-śîl", "traducao_palavra": "ao tolo" },
        { "hebraico": "כָּבֹֽוד׃", "transliteral": "kā-ḇôḏ", "traducao_palavra": "honra" }
      ]
    },
    "9": {
      "traducao_completa": "Como o espinho que entra na mão do bêbado, assim é o provérbio na boca dos tolos.",
      "palavras": [
        { "hebraico": "חֹ֭וחַ", "transliteral": "ḥô-aḥ", "traducao_palavra": "Espinho/cardo" },
        { "hebraico": "עָלָ֣ה", "transliteral": "ʿā-lā", "traducao_palavra": "subiu/entrou" },
        { "hebraico": "בְיַד־", "transliteral": "ḇə-yaḏ-", "traducao_palavra": "na mão de" },
        { "hebraico": "שִׁכֹּ֑ור", "transliteral": "šik-kôr", "traducao_palavra": "um bêbado" },
        { "hebraico": "וּ֝מָשָׁ֗ל", "transliteral": "ū-mā-šāl", "traducao_palavra": "e um provérbio" },
        { "hebraico": "בְּפִ֣י", "transliteral": "bə-p̄î", "traducao_palavra": "na boca de" },
        { "hebraico": "כְסִילִֽים׃", "transliteral": "ḵə-śî-lîm", "traducao_palavra": "tolos" }
      ]
    },
    "10": {
      "traducao_completa": "Grande é o que a tudo dá forma, mas o que aluga o tolo é como o que aluga os que passam.",
      "palavras": [
        { "hebraico": "רַ֥ב", "transliteral": "raḇ", "traducao_palavra": "Grande/mestre" },
        { "hebraico": "מְחֳֹולֵֽל־", "transliteral": "mə-ḥô-lêl-", "traducao_palavra": "que forma/fere" },
        { "hebraico": "כֹּ֑ל", "transliteral": "kōl", "traducao_palavra": "tudo" },
        { "hebraico": "וְשֹׂכֵ֤ר", "transliteral": "wə-śō-ḵêr", "traducao_palavra": "e o que aluga" },
        { "hebraico": "כְּסִ֗יל", "transliteral": "kə-śîl", "traducao_palavra": "um tolo" },
        { "hebraico": "וְשֹׂכֵ֥ר", "transliteral": "wə-śō-ḵêr", "traducao_palavra": "e aluga" },
