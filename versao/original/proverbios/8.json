        { "hebraico": "אֲדַבֵּ֑ר", "transliteral": "ʾă-ḏab-bêr", "traducao_palavra": "falarei" },
        { "hebraico": "וּמִפְתַּ֥ח", "transliteral": "ū-mip̄-taḥ", "traducao_palavra": "e o abrir de" },
