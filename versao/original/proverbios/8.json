        { "hebraico": "אֶקְרָ֑א", "transliteral": "ʾeq-rā", "traducao_palavra": "eu clamo" },
        { "hebraico": "וְ֝קֹולִ֗י", "transliteral": "wə-qô-lî", "traducao_palavra": "e minha voz [é]" },
