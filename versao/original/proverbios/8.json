      ]
    },
    "4": {
      "traducao_completa": "A vós, ó homens, eu clamo; e a minha voz se dirige aos filhos dos homens.",
      "palavras": [
        { "hebraico": "אֲלֵיכֶ֣ם", "transliteral": "ʾă-lê-ḵem", "traducao_palavra": "a vós" },
