    "6": {
      "traducao_completa": "Ouvi, porque falarei coisas excelentes; os meus lábios se abrirão para a retidão.",
      "palavras": [
        { "hebraico": "שִׁ֭מְעוּ", "transliteral": "šim-ʿû", "traducao_palavra": "ouvi" },
