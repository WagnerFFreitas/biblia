        { "hebraico": "שְׁעָרִ֥ים", "transliteral": "šə-ʿā-rîm", "traducao_palavra": "portas" },
        { "hebraico": "לְפִי־", "transliteral": "lə-p̄î-", "traducao_palavra": "à boca/entrada de" },
        { "hebraico": "קָ֑רֶת", "transliteral": "qā-reṯ", "traducao_palavra": "cidade" },
        { "hebraico": "מְבֹ֖וא", "transliteral": "mə-ḇô", "traducao_palavra": "entrada de" },
