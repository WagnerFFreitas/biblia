        { "hebraico": "חָכְמָ֥ה", "transliteral": "ḥā-ḵə-mā", "traducao_palavra": "sabedoria" },
        { "hebraico": "תִקְרָ֑א", "transliteral": "tiq-rā", "traducao_palavra": "clama" },
        { "hebraico": "וּ֝תְבוּנָ֗ה", "transliteral": "ū-ṯə-ḇû-nā", "traducao_palavra": "e o entendimento" },
        { "hebraico": "תִּתֵּ֥ן", "transliteral": "tit-tên", "traducao_palavra": "dá/emite" },
