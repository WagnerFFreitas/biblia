        { "hebraico": "עֲלֵי־", "transliteral": "ʿă-lê-", "traducao_palavra": "sobre/junto ao" },
        { "hebraico": "דָ֑רֶךְ", "transliteral": "ḏā-reḵ", "traducao_palavra": "caminho" },
        { "hebraico": "בֵּ֖ית", "transliteral": "bêṯ", "traducao_palavra": "entre/casa de" },
