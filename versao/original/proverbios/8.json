        { "hebraico": "עָרְמָ֑ה", "transliteral": "ʿā-rə-mā", "traducao_palavra": "prudência" },
        { "hebraico": "וּ֝כְסִילִ֗ים", "transliteral": "ū-ḵə-śî-lîm", "traducao_palavra": "e loucos" },
        { "hebraico": "הָבִ֥ינוּ", "transliteral": "hā-ḇî-nû", "traducao_palavra": "entendei [no]" },
