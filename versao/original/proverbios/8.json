        { "hebraico": "חִכִּ֑י", "transliteral": "ḥik-kî", "traducao_palavra": "meu paladar" },
        { "hebraico": "וְתֹועֲבַ֖ת", "transliteral": "wə-ṯô-ʿă-ḇaṯ", "traducao_palavra": "e abominação de" },
        { "hebraico": "שְׂפָתַ֣י", "transliteral": "śə-p̄ā-ṯay", "traducao_palavra": "meus lábios" },
        { "hebraico": "רֶֽשַׁע׃", "transliteral": "re-šaʿ", "traducao_palavra": "[é] a impiedade" }
