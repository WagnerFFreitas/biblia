        { "hebraico": "שָׂנֵֽאתִי׃", "transliteral": "śā-nê-ṯî", "traducao_palavra": "eu odeio" }
      ]
    },
    "14": {
      "traducao_completa": "Meu é o conselho e a verdadeira sabedoria; eu sou o entendimento, minha é a fortaleza.",
      "palavras": [
        { "hebraico": "לִֽי־", "transliteral": "lî-", "traducao_palavra": "meu [é]" },
        { "hebraico": "עֵ֭צָה", "transliteral": "ʿê-ṣā", "traducao_palavra": "conselho" },
