        { "hebraico": "בִּ֭י", "transliteral": "bî", "traducao_palavra": "por mim" },
        { "hebraico": "שָׂרִ֣ים", "transliteral": "śā-rîm", "traducao_palavra": "príncipes" },
        { "hebraico": "יָשֹׂ֑רוּ", "transliteral": "yā-śō-rû", "traducao_palavra": "governam" },
        { "hebraico": "וּ֝נְדִיבִ֗ים", "transliteral": "ū-nə-ḏî-ḇîm", "traducao_palavra": "e nobres" },
        { "hebraico": "כָּל־", "transliteral": "kāl-", "traducao_palavra": "todos" },
        { "hebraico": "שֹׁ֥פְטֵי", "transliteral": "šō-p̄ə-ṭê", "traducao_palavra": "[os] juízes de" },
