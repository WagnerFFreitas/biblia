        { "hebraico": "שְׂנֹ֫את", "transliteral": "śə-nōṯ", "traducao_palavra": "[é] odiar" },
        { "hebraico": "רָ֥ע", "transliteral": "rāʿ", "traducao_palavra": "o mal" },
