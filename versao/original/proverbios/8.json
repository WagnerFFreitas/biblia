        { "hebraico": "פִ֑י", "transliteral": "p̄î", "traducao_palavra": "minha boca" },
        { "hebraico": "אֵ֥ין", "transliteral": "ʾên", "traducao_palavra": "não há" },
        { "hebraico": "בָּ֝הֶ֗ם", "transliteral": "bā-hem", "traducao_palavra": "nelas" },
        { "hebraico": "נִפְתָּ֥ל", "transliteral": "nip̄-tāl", "traducao_palavra": "coisa tortuosa" },
        { "hebraico": "וְעִקֵּֽשׁ׃", "transliteral": "wə-ʿiq-qēš", "traducao_palavra": "e perversa" }
