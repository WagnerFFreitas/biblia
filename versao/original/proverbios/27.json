    "17": {
      "traducao_completa": "Como o ferro com o ferro se afia, assim o homem afia o rosto do seu amigo.",
      "palavras": [
        { "hebraico": "בַּרְזֶ֣ל", "transliteral": "bar-zel", "traducao_palavra": "Ferro" },
        { "hebraico": "בְּבַרְזֶ֣ל", "transliteral": "bə-bar-zel", "traducao_palavra": "com ferro" },
        { "hebraico": "יָ֑חַד", "transliteral": "yā-ḥaḏ", "traducao_palavra": "se aguça/afia" },
        { "hebraico": "וְ֝אִ֗ישׁ", "transliteral": "wə-ʾîš", "traducao_palavra": "e um homem" },
        { "hebraico": "יַ֣חַד", "transliteral": "ya-ḥaḏ", "traducao_palavra": "afia/aguça" },
        { "hebraico": "פְּנֵֽי־", "transliteral": "pə-nê-", "traducao_palavra": "a face de" },
        { "hebraico": "רֵעֵֽהוּ׃", "transliteral": "rê-ʿê-hû", "traducao_palavra": "seu amigo" }
      ]
    },
    "18": {
      "traducao_completa": "O que guarda a figueira comerá o seu fruto; e o que guarda ao seu senhor será honrado.",
      "palavras": [
        { "hebraico": "נֹצֵ֣ר", "transliteral": "nō-ṣêr", "traducao_palavra": "O que guarda" },
        { "hebraico": "תְּ֭אֵנָה", "transliteral": "tə-ʾē-nā", "traducao_palavra": "[a] figueira" },
        { "hebraico": "יֹאכַ֣ל", "transliteral": "yō-ḵal", "traducao_palavra": "comerá" },
        { "hebraico": "פִּרְיָ֑הּ", "transliteral": "pir-yāh", "traducao_palavra": "o fruto dela" },
        { "hebraico": "וְשֹׁמֵ֥ר", "transliteral": "wə-šō-mêr", "traducao_palavra": "e o que observa/guarda" },
        { "hebraico": "אֲ֝דֹנָ֗יו", "transliteral": "ʾă-ḏō-nāyw", "traducao_palavra": "seu senhor" },
        { "hebraico": "יְכֻבָּֽד׃", "transliteral": "yə-ḵub-bāḏ", "traducao_palavra": "será honrado" }
      ]
    },
    "19": {
      "traducao_completa": "Como na água o rosto corresponde ao rosto, assim o coração do homem ao homem.",
      "palavras": [
        { "hebraico": "כַּמַּ֥יִם", "transliteral": "kam-ma-yim", "traducao_palavra": "Como na água" },
        { "hebraico": "הַפָּנִ֣ים", "transliteral": "hap-pā-nîm", "traducao_palavra": "a face [corresponde]" },
        { "hebraico": "לַפָּנִ֑ים", "transliteral": "lap-pā-nîm", "traducao_palavra": "à face" },
        { "hebraico": "כֵּ֤ן", "transliteral": "kên", "traducao_palavra": "assim" },
        { "hebraico": "לֵֽב־", "transliteral": "leḇ-", "traducao_palavra": "[é o] coração de" },
        { "hebraico": "הָ֝אָדָ֗ם", "transliteral": "hā-ʾā-ḏām", "traducao_palavra": "o homem" },
        { "hebraico": "לָאָדָֽם׃", "transliteral": "lā-ʾā-ḏām", "traducao_palavra": "ao homem" }
      ]
    },
    "20": {
      "traducao_completa": "O Seol e o Abadom nunca se fartam, e os olhos do homem nunca se satisfazem.",
      "palavras": [
        { "hebraico": "שְׁאֹ֣ול", "transliteral": "šə-ʾôl", "traducao_palavra": "Seol" },
        { "hebraico": "וַ֭אֲבַדֹּוה", "transliteral": "wa-ʾă-ḇad-dōh", "traducao_palavra": "e Abadom [destruição]" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "תִשְׂבַּ֑עְנָה", "transliteral": "tiś-ba-ʿə-nā", "traducao_palavra": "se fartarão" },
        { "hebraico": "וְעֵינֵ֥י", "transliteral": "wə-ʿê-nê", "traducao_palavra": "e os olhos de" },
        { "hebraico": "הָ֝אָדָ֗ם", "transliteral": "hā-ʾā-ḏām", "traducao_palavra": "o homem" },
        { "hebraico": "לֹ֥א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "תִשְׂבַּֽעְנָה׃", "transliteral": "tiś-ba-ʿə-nā", "traducao_palavra": "se fartarão" }
      ]
    },
    "21": {
      "traducao_completa": "O crisol é para a prata e o forno para o ouro, e o homem é provado pelos louvores que recebe.",
      "palavras": [
        { "hebraico": "מַצְרֵ֣ף", "transliteral": "maṣ-rēp̄", "traducao_palavra": "Crisol" },
        { "hebraico": "לַ֭כֶּסֶף", "transliteral": "lak-ke-sep̄", "traducao_palavra": "para a prata" },
        { "hebraico": "וְכ֣וּר", "transliteral": "wə-ḵûr", "traducao_palavra": "e forno" },
        { "hebraico": "לַזָּהָ֑ב", "transliteral": "laz-zā-hāḇ", "traducao_palavra": "para o ouro" },
        { "hebraico": "וְ֝אִ֗ישׁ", "transliteral": "wə-ʾîš", "traducao_palavra": "e um homem [é provado]" },
        { "hebraico": "לְפִ֣י", "transliteral": "lə-p̄î", "traducao_palavra": "segundo" },
        { "hebraico": "מַהֲלָלֹֽו׃", "transliteral": "ma-hă-lā-lô", "traducao_palavra": "o seu louvor" }
      ]
    },
    "22": {
      "traducao_completa": "Ainda que pisasses o tolo num gral entre grãos de trigo com um pilão, não se afastaria dele a sua estultícia.",
      "palavras": [
        { "hebraico": "אִ֥ם", "transliteral": "ʾim", "traducao_palavra": "Ainda que" },
        { "hebraico": "תִּכְתֹּֽושׁ־", "transliteral": "tiḵ-tôš-", "traducao_palavra": "pisasses/esmagasses" },
        { "hebraico": "אֶת־הָאֱוִ֨יל", "transliteral": "ʾeṯ-hā-ʾĕ-wîl", "traducao_palavra": "ao tolo" },
        { "hebraico": "בַּֽמַּכְתֵּ֡שׁ", "transliteral": "bam-maḵ-tēš", "traducao_palavra": "no gral/almofariz" },
        { "hebraico": "בְּתֹ֣וךְ", "transliteral": "bə-ṯôḵ", "traducao_palavra": "no meio de" },
        { "hebraico": "הָ֭רִיפֹות", "transliteral": "hā-rî-p̄ôṯ", "traducao_palavra": "grãos de trigo" },
        { "hebraico": "בַּעֱלִ֑י", "transliteral": "ba-ʿĕ-lî", "traducao_palavra": "com o pilão" },
        { "hebraico": "לֹא־תָס֥וּר", "transliteral": "lō-ṯā-śûr", "traducao_palavra": "não se afastaria" },
        { "hebraico": "מֵ֝עָלָ֗יו", "transliteral": "mē-ʿā-lāyw", "traducao_palavra": "de cima dele" },
        { "hebraico": "אִוַּלְתֹּֽו׃", "transliteral": "ʾiw-wal-tô", "traducao_palavra": "a estultícia dele" }
      ]
    },
    "23": {
      "traducao_completa": "Procura conhecer o estado das tuas ovelhas; põe o teu coração sobre os teus rebanhos.",
      "palavras": [
        { "hebraico": "יָדֹ֣עַ", "transliteral": "yā-ḏō-aʿ", "traducao_palavra": "Conhecer" },
        { "hebraico": "תֵּ֭דַע", "transliteral": "tê-ḏaʿ", "traducao_palavra": "deves conhecer" },
        { "hebraico": "פְּנֵ֣י", "transliteral": "pə-nê", "traducao_palavra": "[a] face/estado de" },
        { "hebraico": "צֹאנֶ֑ךָ", "transliteral": "ṣō-ne-ḵā", "traducao_palavra": "tuas ovelhas" },
        { "hebraico": "שִׁ֥ית", "transliteral": "šîṯ", "traducao_palavra": "põe" },
        { "hebraico": "לִ֝בְּךָ֗", "transliteral": "lib-bə-ḵā", "traducao_palavra": "teu coração" },
        { "hebraico": "לַעֲדָרִֽים׃", "transliteral": "la-ʿă-ḏā-rîm", "traducao_palavra": "para os rebanhos" }
      ]
    },
    "24": {
      "traducao_completa": "Porque as riquezas não duram para sempre; e duraria a coroa de geração em geração?",
      "palavras": [
        { "hebraico": "כִּ֤י", "transliteral": "kî", "traducao_palavra": "Porque" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "לְעֹולָ֣ם", "transliteral": "lə-ʿô-lām", "traducao_palavra": "para sempre [é]" },
        { "hebraico": "חֹ֑סֶן", "transliteral": "ḥō-sen", "traducao_palavra": "[a] riqueza/força" },
        { "hebraico": "וְאִם־", "transliteral": "wə-ʾim-", "traducao_palavra": "e acaso" },
        { "hebraico": "נֵ֝זֶר", "transliteral": "nê-zer", "traducao_palavra": "[a] coroa/diadema" },
        { "hebraico": "לְדֹ֣ור", "transliteral": "lə-ḏôr", "traducao_palavra": "de geração" },
        { "hebraico": "וָדֹור׃", "transliteral": "wā-ḏôr", "traducao_palavra": "em geração?" }
      ]
    },
    "25": {
      "traducao_completa": "Quando aparecer o feno, e se virem as ervas verdes, então se colherão as ervas dos montes.",
      "palavras": [
        { "hebraico": "גָּלָ֣ה", "transliteral": "gā-lā", "traducao_palavra": "Aparece/revela-se" },
        { "hebraico": "חָ֭צִיר", "transliteral": "ḥā-ṣîr", "traducao_palavra": "[o] feno/capim" },
        { "hebraico": "וְנִרְאָה־", "transliteral": "wə-nir-ʾā-", "traducao_palavra": "e é vista" },
        { "hebraico": "דֶ֑שֶׁא", "transliteral": "de-še", "traducao_palavra": "[a] erva verde" },
        { "hebraico": "וְ֝נֶאֶסְפ֗וּ", "transliteral": "wə-ne-ʾĕ-śə-p̄û", "traducao_palavra": "e são colhidas" },
        { "hebraico": "עִשְּׂבֹ֥ות", "transliteral": "ʿiś-śə-ḇôṯ", "traducao_palavra": "[as] ervas de" },
        { "hebraico": "הָרִֽים׃", "transliteral": "hā-rîm", "traducao_palavra": "[os] montes" }
      ]
    },
    "26": {
      "traducao_completa": "Os cordeiros serão para o teu vestido, e os bodes para o preço do campo.",
      "palavras": [
        { "hebraico": "כְּבָשִׂ֥ים", "transliteral": "kə-ḇā-śîm", "traducao_palavra": "[Os] cordeiros" },
        { "hebraico": "לִלְבוּשֶׁ֑ךָ", "transliteral": "lil-ḇû-še-ḵā", "traducao_palavra": "para tua veste" },
        { "hebraico": "וּמְחִ֥יר", "transliteral": "ū-mə-ḥîr", "traducao_palavra": "e [como] preço de" },
        { "hebraico": "שָׂ֝דֶ֗ה", "transliteral": "śā-ḏeh", "traducao_palavra": "campo" },
        { "hebraico": "עַתּוּדִֽים׃", "transliteral": "ʿat-tū-ḏîm", "traducao_palavra": "[os] bodes" }
      ]
