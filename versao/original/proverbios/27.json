    "27": {
      "traducao_completa": "E haverá bastante leite de cabras para o teu sustento, para o sustento da tua casa e para o mantimento das tuas criadas.",
      "palavras": [
        { "hebraico": "וְדֵ֤י", "transliteral": "wə-ḏê", "traducao_palavra": "E suficiência de" },
        { "hebraico": "חֲלֵ֬ב", "transliteral": "ḥă-lêḇ", "traducao_palavra": "leite de" },
        { "hebraico": "עִזִּ֗ים", "transliteral": "ʿiz-zîm", "traducao_palavra": "cabras" },
        { "hebraico": "לְ֭לַחְמְךָ", "transliteral": "lə-laḥ-mə-ḵā", "traducao_palavra": "para teu pão/alimento" },
        { "hebraico": "לְלֶ֣חֶם", "transliteral": "lə-le-ḥem", "traducao_palavra": "para alimento de" },
        { "hebraico": "בֵּיתֶ֑ךָ", "transliteral": "bê-te-ḵā", "traducao_palavra": "tua casa" },
        { "hebraico": "וְ֝חַיִּ֗ים", "transliteral": "wə-ḥay-yîm", "traducao_palavra": "e sustento/vida para" },
        { "hebraico": "לְנַעֲרֹותֶֽיךָ׃", "transliteral": "lə-na-ʿă-rô-ṯe-y-ḵā", "traducao_palavra": "tuas criadas" }
