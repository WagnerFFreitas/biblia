{
  "livro": "Provérbios - מִשְׁלֵי - Mishlei",
  "capítulo": 7,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Filho meu, guarda as minhas palavras e esconde contigo os meus mandamentos.",
      "palavras": [
        { "hebraico": "בְּ֭נִי", "transliteral": "bə-nî", "traducao_palavra": "filho meu" },
        { "hebraico": "שְׁמֹ֣ר", "transliteral": "šə-mōr", "traducao_palavra": "guarda" },
        { "hebraico": "אֲמָרָ֑י", "transliteral": "ʾă-mā-rāy", "traducao_palavra": "minhas palavras" },
        { "hebraico": "וּ֝מִצְוֹתַ֗י", "transliteral": "ū-miṣ-wō-ṯay", "traducao_palavra": "e meus mandamentos" },
        { "hebraico": "תִּצפֹּ֥ן", "transliteral": "tiṣ-pōn", "traducao_palavra": "esconderes/guardares" },
        { "hebraico": "אִתָּֽךְ׃", "transliteral": "ʾit-tāḵ", "traducao_palavra": "contigo" }
      ]
    },
    "2": {
      "traducao_completa": "Guarda os meus mandamentos e vive; e a minha instrução, como a pupila dos teus olhos.",
      "palavras": [
        { "hebraico": "שְׁמֹֹ֣ר", "transliteral": "šə-mōr", "traducao_palavra": "guarda" },
        { "hebraico": "מִצְוֹתַ֣י", "transliteral": "miṣ-wō-ṯay", "traducao_palavra": "meus mandamentos" },
        { "hebraico": "וֶחְיֵ֑ה", "transliteral": "we-ḥə-yēh", "traducao_palavra": "e vive" },
        { "hebraico": "וְ֝תֹורָתִ֗I", "transliteral": "wə-ṯô-rā-ṯî", "traducao_palavra": "e minha instrução" },
        { "hebraico": "כְּאִישֹׁ֥ון", "transliteral": "kə-ʾî-šôn", "traducao_palavra": "como a pupila de" },
        { "hebraico": "עֵינֶֽךָ׃", "transliteral": "ʿê-ne-ḵā", "traducao_palavra": "teus olhos" }
      ]
    },
    "3": {
      "traducao_completa": "Ata-os aos teus dedos, escreve-os na tábua do teu coração.",
      "palavras": [
        { "hebraico": "קָשְׁרֵ֥ם", "transliteral": "qā-šə-rêm", "traducao_palavra": "ata-os" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre" },
        { "hebraico": "אֶצְבְּעֹתֶ֑יךָ", "transliteral": "ʾeṣ-bə-ʿō-ṯê-ḵā", "traducao_palavra": "teus dedos" },
        { "hebraico": "כָּ֝תְבֵ֗ם", "transliteral": "kā-ṯə-ḇêm", "traducao_palavra": "escreve-as" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre" },
        { "hebraico": "ל֥וּחַ", "transliteral": "lū-aḥ", "traducao_palavra": "a tábua de" },
        { "hebraico": "לִבֶּֽךָ׃", "transliteral": "lib-be-ḵā", "traducao_palavra": "teu coração" }
      ]
    },
    "4": {
      "traducao_completa": "Dize à sabedoria: Tu és minha irmã; e ao entendimento chama teu parente,",
      "palavras": [
        { "hebraico": "אֱמֹ֥ר", "transliteral": "ʾĕ-mōr", "traducao_palavra": "dize" },
        { "hebraico": "לַֽחָכְמָ֥ה", "transliteral": "la-ḥā-ḵə-mā", "traducao_palavra": "à sabedoria" },
        { "hebraico": "אֲחֹ֣תִי", "transliteral": "ʾă-ḥō-ṯî", "traducao_palavra": "minha irmã [és]" },
        { "hebraico": "אָ֑תְּ", "transliteral": "ʾātt", "traducao_palavra": "tu" },
        { "hebraico": "וּ֝מֹודָ֗ע", "transliteral": "ū-mô-ḏāʿ", "traducao_palavra": "e parente/conhecido" },
        { "hebraico": "לַבִּינָ֥ה", "transliteral": "lab-bî-nā", "traducao_palavra": "ao entendimento" },
        { "hebraico": "תִקְרָֽא׃", "transliteral": "tiq-rā", "traducao_palavra": "chamarás" }
      ]
    },
    "5": {
      "traducao_completa": "para que te guardem da mulher estranha, da estrangeira que lisonjeia com as suas palavras.",
      "palavras": [
        { "hebraico": "לִ֭שְׁמָרְךָ", "transliteral": "liš-mā-rə-ḵā", "traducao_palavra": "para te guardar" },
        { "hebraico": "מֵאִשָּׁ֧ה", "transliteral": "mê-ʾiš-šā", "traducao_palavra": "da mulher" },
        { "hebraico": "זָרָ֑ה", "transliteral": "zā-rā", "traducao_palavra": "estranha" },
        { "hebraico": "מִ֝נָּכְרִיָּ֗ה", "transliteral": "min-nā-ḵə-rî-yā", "traducao_palavra": "da estrangeira" },
        { "hebraico": "אֲמָרֶ֥יהָ", "transliteral": "ʾă-mā-re-yā", "traducao_palavra": "[com] suas palavras" },
        { "hebraico": "הֶחֱלִֽיקָה׃", "transliteral": "he-ḥĕ-lî-qā", "traducao_palavra": "ela lisonjeia" }
      ]
    },
    "6": {
      "traducao_completa": "Porque da janela da minha casa, pela minha grade, olhei eu;",
      "palavras": [
        { "hebraico": "כִּ֭י", "transliteral": "kî", "traducao_palavra": "pois" },
        { "hebraico": "בְּחַלֹּ֣ון", "transliteral": "bə-ḥal-lôn", "traducao_palavra": "pela janela de" },
        { "hebraico": "בֵּיתִ֑י", "transliteral": "bê-ṯî", "traducao_palavra": "minha casa" },
        { "hebraico": "בְּעַ֥ד", "transliteral": "bə-ʿaḏ", "traducao_palavra": "através de" },
        { "hebraico": "אֶ֝שׁנַבִּ֗י", "transliteral": "ʾeš-nab-bî", "traducao_palavra": "minha grade/treliça" },
        { "hebraico": "נִשְׁקָֽפְתִּי׃", "transliteral": "niš-qā-p̄at-tî", "traducao_palavra": "olhei" }
      ]
    },
    "7": {
      "traducao_completa": "e vi entre os simples, percebi entre os jovens, um rapaz falto de entendimento,",
      "palavras": [
        { "hebraico": "וָאֵ֤רֶא", "transliteral": "wā-ʾê-re", "traducao_palavra": "e vi" },
        { "hebraico": "בַפְּתָאיִ֨ם", "transliteral": "ḇap-pə-ṯā-yim", "traducao_palavra": "entre os simples" },
        { "hebraico": "אָ֘בִ֤ינָה", "transliteral": "ʾā-ḇî-nā", "traducao_palavra": "percebi" },
        { "hebraico": "בַבָּנִ֗ים", "transliteral": "ḇab-bā-nîm", "traducao_palavra": "entre os jovens" },
        { "hebraico": "נַ֣עַר", "transliteral": "na-ʿar", "traducao_palavra": "um rapaz" },
        { "hebraico": "חֲסַר־לֵֽב׃", "transliteral": "ḥă-sar-lēḇ", "traducao_palavra": "falto de entendimento" }
      ]
    },
    "8": {
      "traducao_completa": "que passava pela rua junto à sua esquina e seguia o caminho da sua casa;",
      "palavras": [
        { "hebraico": "עֹבֵ֣ר", "transliteral": "ʿō-ḇēr", "traducao_palavra": "passando" },
        { "hebraico": "בַּ֭שּׁוּק", "transliteral": "baš-šûq", "traducao_palavra": "pela rua" },
        { "hebraico": "אֵ֣צֶל", "transliteral": "ʾē-ṣel", "traducao_palavra": "junto a" },
        { "hebraico": "פִּנָּ֑הּ", "transliteral": "pin-nāh", "traducao_palavra": "esquina dela" },
        { "hebraico": "וְדֶ֖רֶךְ", "transliteral": "wə-ḏe-reḵ", "traducao_palavra": "e [pelo] caminho de" },
        { "hebraico": "בֵּיתָ֣הּ", "transliteral": "bê-ṯāh", "traducao_palavra": "casa dela" },
        { "hebraico": "יִצְעָֽד׃", "transliteral": "yiṣ-ʿāḏ", "traducao_palavra": "ele caminhava" }
      ]
    },
    "9": {
      "traducao_completa": "no crepúsculo, à tarde do dia, na pupila da noite e nas trevas.",
      "palavras": [
        { "hebraico": "בְּנֶֽשֶׁף־", "transliteral": "bə-ne-šep̄-", "traducao_palavra": "no crepúsculo" },
        { "hebraico": "בְּעֵ֥רֶב", "transliteral": "bə-ʿê-reḇ", "traducao_palavra": "no entardecer de" },
        { "hebraico": "יֹ֑ום", "transliteral": "yôm", "traducao_palavra": "[o] dia" },
        { "hebraico": "בְּאִישֹׁ֥ון", "transliteral": "bə-ʾî-šôn", "traducao_palavra": "no meio/pupila de" },
        { "hebraico": "לַ֝֗יְלָה", "transliteral": "lay-lā", "traducao_palavra": "[a] noite" },
        { "hebraico": "וַאֲפֵלָֽה׃", "transliteral": "wa-ʾă-p̄ê-lā", "traducao_palavra": "e trevas" }
      ]
    },
    "10": {
      "traducao_completa": "E eis que uma mulher lhe sai ao encontro com enfeite de prostituta e astuta de coração.",
      "palavras": [
        { "hebraico": "וְהִנֵּ֣ה", "transliteral": "wə-hin-nēh", "traducao_palavra": "e eis" },
        { "hebraico": "אִ֭שָּׁה", "transliteral": "ʾiš-šā", "traducao_palavra": "uma mulher" },
        { "hebraico": "לִקְרָאתֹ֑ו", "transliteral": "liq-rā-ṯô", "traducao_palavra": "ao encontro dele" },
        { "hebraico": "שִׁית", "transliteral": "šîṯ", "traducao_palavra": "veste/adorno de" },
        { "hebraico": "זֹ֝ונָה", "transliteral": "zô-nā", "traducao_palavra": "prostituta" },
        { "hebraico": "וּנְצֻ֥רַת", "transliteral": "ū-nə-ṣu-raṯ", "traducao_palavra": "e astuta/reservada de" },
        { "hebraico": "לֵֽB׃", "transliteral": "lēḇ", "traducao_palavra": "coração" }
      ]
    },
    "11": {
      "traducao_completa": "Alvoroçada é e obstinada; não param em sua casa os seus pés.",
      "palavras": [
        { "hebraico": "הֹמִיָּ֥ה", "transliteral": "hō-mî-yā", "traducao_palavra": "alvoroçada" },
        { "hebraico": "הִ֣יא", "transliteral": "hî", "traducao_palavra": "[é] ela" },
        { "hebraico": "וְסֹרָ֑רֶת", "transliteral": "wə-śō-rā-reṯ", "traducao_palavra": "e obstinada" },
        { "hebraico": "בְּ֝בֵיתָ֗הּ", "transliteral": "bə-ḇê-ṯāh", "traducao_palavra": "na sua casa" },
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "יִשְׁכְּנ֥וּ", "transliteral": "yiš-kə-nû", "traducao_palavra": "param" },
        { "hebraico": "רַגְלֶֽיהָ׃", "transliteral": "raḡ-le-yā", "traducao_palavra": "os pés dela" }
      ]
    },
    "12": {
      "traducao_completa": "Ora está lá fora, ora pelas ruas, espreitando a cada esquina.",
      "palavras": [
        { "hebraico": "פַּ֤עַם", "transliteral": "pa-ʿam", "traducao_palavra": "ora" },
        { "hebraico": "בַּח֨וּץ", "transliteral": "ba-ḥûṣ", "traducao_palavra": "lá fora" },
        { "hebraico": "פַּ֘עַם", "transliteral": "pa-ʿam", "traducao_palavra": "ora" },
        { "hebraico": "בָּרְחֹבֹ֗ות", "transliteral": "bā-rə-ḥō-ḇôṯ", "traducao_palavra": "pelas ruas" },
        { "hebraico": "וְאֵ֣צֶל", "transliteral": "wə-ʾē-ṣel", "traducao_palavra": "e junto a" },
        { "hebraico": "כָּל־פִּנָּ֣ה", "transliteral": "kāl-pin-nā", "traducao_palavra": "cada esquina" },
        { "hebraico": "תֶאֱרֹֽב׃", "transliteral": "te-ʾĕ-rōḇ", "traducao_palavra": "ela espreita" }
      ]
    },
    "13": {
      "traducao_completa": "E agarrou-o, e beijou-o, e com face impudente disse-lhe:",
      "palavras": [
        { "hebraico": "וְהֶחֱזִ֣יקָה", "transliteral": "wə-he-ḥĕ-zî-qā", "traducao_palavra": "e ela agarrou" },
        { "hebraico": "בֹּ֭ו", "transliteral": "bô", "traducao_palavra": "nele" },
        { "hebraico": "וְנָשְׁקָה־", "transliteral": "wə-nā-šə-qā-", "traducao_palavra": "e beijou" },
        { "hebraico": "לֹּ֑ו", "transliteral": "lô", "traducao_palavra": "a ele" },
        { "hebraico": "הֵעֵ֥זָה", "transliteral": "hê-ʿê-zā", "traducao_palavra": "fez impudente/forte" },
        { "hebraico": "פָ֝נֶ֗יהָ", "transliteral": "p̄ā-ne-yā", "traducao_palavra": "sua face" },
        { "hebraico": "וַתֹּ֥אמֶר", "transliteral": "wat-tō-mer", "traducao_palavra": "e disse" },
        { "hebraico": "לֹֽו׃", "transliteral": "lô", "traducao_palavra": "a ele" }
      ]
    },
    "14": {
      "traducao_completa": "Sacrifícios de ofertas pacíficas estavam comigo; hoje paguei os meus votos.",
      "palavras": [
        { "hebraico": "זִבְחֵ֣י", "transliteral": "ziḇ-ḥê", "traducao_palavra": "sacrifícios de" },
        { "hebraico": "שְׁלָמִ֣ים", "transliteral": "šə-lā-mîm", "traducao_palavra": "ofertas pacíficas" },
        { "hebraico": "עָלָ֑י", "transliteral": "ʿā-lāy", "traducao_palavra": "[estavam] sobre mim" },
        { "hebraico": "הַ֝יֹּ֗ום", "transliteral": "hay-yôm", "traducao_palavra": "hoje" },
        { "hebraico": "שִׁלַּ֥מְתִּי", "transliteral": "šil-lam-tî", "traducao_palavra": "paguei" },
        { "hebraico": "נְדָרָֽי׃", "transliteral": "nə-ḏā-rāy", "traducao_palavra": "meus votos" }
      ]
    },
    "15": {
      "traducao_completa": "Portanto, saí ao teu encontro a buscar diligentemente a tua face, e te achei.",
      "palavras": [
        { "hebraico": "עַל־כֵּ֭ן", "transliteral": "ʿal-kên", "traducao_palavra": "por isso" },
        { "hebraico": "יָצָ֣אתִי", "transliteral": "yā-ṣā-ṯî", "traducao_palavra": "saí" },
        { "hebraico": "לִקְרָאתֶ֑ךָ", "transliteral": "liq-rā-ṯe-ḵā", "traducao_palavra": "ao teu encontro" },
        { "hebraico": "לְשַׁחֵ֥ר", "transliteral": "lə-ša-ḥēr", "traducao_palavra": "para buscar diligentemente" },
        { "hebraico": "פָּ֝נֶ֗יךָ", "transliteral": "p̄ā-ne-y-ḵā", "traducao_palavra": "tua face" },
        { "hebraico": "וָאֶמְצָאֶֽךָּ׃", "transliteral": "wā-ʾem-ṣā-ʾek-kā", "traducao_palavra": "e te achei" }
      ]
    },
    "16": {
      "traducao_completa": "Já cobri a minha cama com cobertas de tapeçaria, com obras lavradas de linho do Egito.",
      "palavras": [
        { "hebraico": "מַרְבַדִּ֭ים", "transliteral": "mar-ḇad-dîm", "traducao_palavra": "cobertas/colchas" },
        { "hebraico": "רָבַ֣דְתִּי", "transliteral": "rā-ḇaḏ-tî", "traducao_palavra": "estendi/cobri" },
        { "hebraico": "עַרְשִׂ֑י", "transliteral": "ʿar-śî", "traducao_palavra": "minha cama" },
        { "hebraico": "חֲ֝טֻבֹ֗ות", "transliteral": "ḥă-ṭu-ḇôṯ", "traducao_palavra": "obras lavradas/coloridas" },
        { "hebraico": "אֵט֥וּן", "transliteral": "ʾē-ṭûn", "traducao_palavra": "linho fino de" },
        { "hebraico": "מִצְרָֽיִם׃", "transliteral": "miṣ-rā-yim", "traducao_palavra": "Egito" }
      ]
    },
    "17": {
      "traducao_completa": "Já perfumei o meu leito com mirra, aloés e cinamomo.",
      "palavras": [
        { "hebraico": "נַ֥פְתִּי", "transliteral": "nap̄-tî", "traducao_palavra": "rociei/perfumei" },
        { "hebraico": "מִשְׁכָּבִ֑י", "transliteral": "miš-kā-ḇî", "traducao_palavra": "meu leito" },
        { "hebraico": "מֹ֝ר", "transliteral": "mōr", "traducao_palavra": "mirra" },
        { "hebraico": "אֲהָלִ֥ים", "transliteral": "ʾă-hā-lîm", "traducao_palavra": "aloés" },
        { "hebraico": "וְקִנָּמֹֽון׃", "transliteral": "wə-qin-nā-môn", "traducao_palavra": "e canela/cinamomo" }
      ]
    },
    "18": {
      "traducao_completa": "Vem, embriaguemo-nos de amores até à manhã; alegremo-nos com amores.",
      "palavras": [
        { "hebraico": "לְכָ֣ה", "transliteral": "lə-ḵā", "traducao_palavra": "vem" },
        { "hebraico": "נִרְוֶ֣ה", "transliteral": "nir-weh", "traducao_palavra": "embriaguemo-nos/saciemo-nos" },
        { "hebraico": "דֹ֭דִים", "transliteral": "dō-ḏîm", "traducao_palavra": "de amores" },
        { "hebraico": "עַד־", "transliteral": "ʿaḏ-", "traducao_palavra": "até" },
        { "hebraico": "הַבֹּ֑קֶר", "transliteral": "hab-bō-qer", "traducao_palavra": "a manhã" },
        { "hebraico": "נִ֝תְעַלְּסָ֗ה", "transliteral": "niṯ-ʿal-lə-śā", "traducao_palavra": "alegremo-nos/deleitemo-nos" },
        { "hebraico": "בָּאֳהָבִֽים׃", "transliteral": "bā-ʾo-hā-ḇîm", "traducao_palavra": "com amores" }
      ]
    },
    "19": {
      "traducao_completa": "Porque o marido não está em casa; foi fazer uma jornada mui longe;",
      "palavras": [
        { "hebraico": "כִּ֤י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "אֵ֣ין", "transliteral": "ʾên", "traducao_palavra": "não [está]" },
        { "hebraico": "הָאִ֣ישׁ", "transliteral": "hā-ʾîš", "traducao_palavra": "o homem/marido" },
        { "hebraico": "בְּבֵיתֹ֑ו", "transliteral": "bə-ḇê-ṯô", "traducao_palavra": "na sua casa" },
        { "hebraico": "הָ֝לַ֗ךְ", "transliteral": "hā-laḵ", "traducao_palavra": "ele foi" },
