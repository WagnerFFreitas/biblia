        { "hebraico": "רִיבָ֑ם", "transliteral": "rî-ḇām", "traducao_palavra": "a causa deles" },
        { "hebraico": "וְקָבַ֖ע", "transliteral": "wə-qā-ḇaʿ", "traducao_palavra": "e despojará" },
