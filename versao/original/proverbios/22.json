      ]
    },
    "22": {
      "traducao_completa": "Não roubes ao pobre, porque é pobre, nem atropeles ao aflito na porta;",
      "palavras": [
        { "hebraico": "אַל־תִּגְזָל־", "transliteral": "ʾal-tiḡ-zāl-", "traducao_palavra": "Não roubes" },
        { "hebraico": "דָּ֭ל", "transliteral": "dāl", "traducao_palavra": "[o] pobre" },
        { "hebraico": "כִּ֣י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "דַל־", "transliteral": "ḏal-", "traducao_palavra": "pobre" },
        { "hebraico": "ה֑וּא", "transliteral": "hû", "traducao_palavra": "[é] ele" },
        { "hebraico": "וְאַל־תְּדַכֵּ֥א", "transliteral": "wə-ʾal-tə-ḏak-kē", "traducao_palavra": "e não esmagues/atropeles" },
