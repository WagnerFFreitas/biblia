        { "hebraico": "אֱמֶ֑ת", "transliteral": "ʾĕ-meṯ", "traducao_palavra": "verdade" },
        { "hebraico": "לְהָשִׁ֥יב", "transliteral": "lə-hā-šîḇ", "traducao_palavra": "para responder" },
