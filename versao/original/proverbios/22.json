        { "hebraico": "נִפְגָּ֑שׁוּ", "transliteral": "nip̄-gā-šû", "traducao_palavra": "se encontram" },
        { "hebraico": "עֹשֵׂ֖ה", "transliteral": "ʿō-śēh", "traducao_palavra": "[o] Criador de" },
        { "hebraico": "כֻלָּ֣ם", "transliteral": "ḵul-lām", "traducao_palavra": "todos eles [é]" },
