        { "hebraico": "לְשַׁלֵּ֑ם", "transliteral": "lə-šal-lêm", "traducao_palavra": "para pagar" },
        { "hebraico": "לָ֧מָּה", "transliteral": "lām-mā", "traducao_palavra": "por que" },
        { "hebraico": "יִקַּ֘ח", "transliteral": "yiq-qaḥ", "traducao_palavra": "ele tomaria" },
