        { "hebraico": "בַּ֣עַל", "transliteral": "ba-ʿal", "traducao_palavra": "um mestre de/homem de" },
        { "hebraico": "אָ֑ף", "transliteral": "ʾāp̄", "traducao_palavra": "ira" },
        { "hebraico": "וְאֶת־", "transliteral": "wə-ʾeṯ-", "traducao_palavra": "e com" },
        { "hebraico": "אִ֥ישׁ", "transliteral": "ʾîš", "traducao_palavra": "homem de" },
