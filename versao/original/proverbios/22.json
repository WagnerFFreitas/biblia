        { "hebraico": "שֵׁ֭ם", "transliteral": "šēm", "traducao_palavra": "[um] nome" },
        { "hebraico": "מֵעֹ֣שֶׁר", "transliteral": "mē-ʿō-šer", "traducao_palavra": "mais que riqueza" },
        { "hebraico": "רָ֑ב", "transliteral": "rāḇ", "traducao_palavra": "muita" },
        { "hebraico": "מִכֶּ֥סֶף", "transliteral": "mik-ke-sep̄", "traducao_palavra": "mais que prata" },
