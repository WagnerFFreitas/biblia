    "19": {
      "traducao_completa": "Para que a tua confiança esteja em YHWH, eu te instruí hoje, sim, a ti mesmo.",
      "palavras": [
        { "hebraico": "לִהְיֹ֣ות", "transliteral": "lih-yôṯ", "traducao_palavra": "Para ser" },
        { "hebraico": "בַּ֭יהוָה", "transliteral": "bay-YHWH", "traducao_palavra": "em YHWH" },
        { "hebraico": "מִבְטַחֶ֑ךָ", "transliteral": "miḇ-ṭa-ḥe-ḵā", "traducao_palavra": "tua confiança" },
        { "hebraico": "הֹודַעְתִּ֖יךָ", "transliteral": "hô-ḏaʿ-tî-ḵā", "traducao_palavra": "fiz saber a ti/instruí" },
        { "hebraico": "הַיֹּ֣ום", "transliteral": "hay-yôm", "traducao_palavra": "hoje" },
        { "hebraico": "אַף־", "transliteral": "ʾap̄-", "traducao_palavra": "também" },
        { "hebraico": "אָֽתָּה׃", "transliteral": "ʾāt-tā", "traducao_palavra": "tu/a ti mesmo" }
      ]
    },
    "20": {
      "traducao_completa": "Porventura não te escrevi excelentes coisas, acerca de conselhos e conhecimento,",
      "palavras": [
