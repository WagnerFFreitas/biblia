    "24": {
      "traducao_completa": "Não te faças amigo do homem iracundo, nem andes com o homem furioso,",
      "palavras": [
        { "hebraico": "אַל־תִּ֭תְרַע", "transliteral": "ʾal-tiṯ-raʿ", "traducao_palavra": "Não te faças amigo/companheiro" },
