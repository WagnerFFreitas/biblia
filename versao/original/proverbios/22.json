        { "hebraico": "יִכֹּ֥נוּ", "transliteral": "yik-kō-nû", "traducao_palavra": "estabelecer-se-ão/estarão prontas" },
        { "hebraico": "יַ֝חְדָּ֗ו", "transliteral": "yaḥ-dāw", "traducao_palavra": "juntamente" },
