        { "hebraico": "רָעָ֣ה", "transliteral": "rā-ʿā", "traducao_palavra": "o mal" },
        { "hebraico": "וְיִסָּתֵ֑ר", "transliteral": "wə-yis-śā-ṯêr", "traducao_palavra": "e escondeu-se" },
        { "hebraico": "וּ֝פְתָאיִ֗ם", "transliteral": "ū-p̄ə-ṯā-yim", "traducao_palavra": "mas [os] simples" },
