        { "hebraico": "לְךָ֣", "transliteral": "lə-ḵā", "traducao_palavra": "a ti" },
        { "hebraico": "שִׁלְשֹׁ֑ום", "transliteral": "šil-šôm", "traducao_palavra": "outrora/excelentes coisas" },
