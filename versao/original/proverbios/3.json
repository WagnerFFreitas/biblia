      ]
    },
    "35": {
      "traducao_completa": "Os sábios herdarão honra, mas a exaltação dos loucos é ignomínia.",
      "palavras": [
        { "hebraico": "כָּ֭בֹוד", "transliteral": "kā-ḇôḏ", "traducao_palavra": "honra" },
        { "hebraico": "חֲכָמִ֣ים", "transliteral": "ḥă-ḵā-mîm", "traducao_palavra": "sábios" },
        { "hebraico": "יִנְחָ֑לוּ", "transliteral": "yin-ḥā-lû", "traducao_palavra": "herdarão" },
        { "hebraico": "וּ֝כְסִילִ֗ים", "transliteral": "ū-ḵə-śî-lîm", "traducao_palavra": "mas os loucos" },
        { "hebraico": "מֵרִ֥ים", "transliteral": "mê-rîm", "traducao_palavra": "exalta/levanta" },
        { "hebraico": "קָלֹֽון׃", "transliteral": "qā-lôn", "traducao_palavra": "vergonha/ignomínia" }
