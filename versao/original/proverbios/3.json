      ]
    },
    "27": {
      "traducao_completa": "Não detenhas o bem daqueles a quem é devido, estando na tua mão o poder de fazê-lo.",
      "palavras": [
        { "hebraico": "אַל־תִּמְנַע־טֹ֥וב", "transliteral": "ʾal-tim-naʿ-ṭôḇ", "traducao_palavra": "não retenhas o bem" },
        { "hebraico": "מִבְּעָלָ֑יו", "transliteral": "mib-bə-ʿā-lāw", "traducao_palavra": "de seus donos/credores" },
        { "hebraico": "בִּהְיֹ֨ות", "transliteral": "bih-yôṯ", "traducao_palavra": "estando" },
        { "hebraico": "לְאֵ֖ל", "transliteral": "lə-ʾēl", "traducao_palavra": "no poder de" },
        { "hebraico": "יָדְךָ֬", "transliteral": "yā-ḏə-ḵā", "traducao_palavra": "tua mão" },
        { "hebraico": "לַעֲשֹֽׂות׃", "transliteral": "la-ʿă-śôṯ", "traducao_palavra": "fazer" }
      ]
    },
    "28": {
      "traducao_completa": "Não digas ao teu próximo: Vai, e volta amanhã, e eu to darei; tendo-o tu contigo.",
      "palavras": [
        { "hebraico": "אַל־תֹּ֘אמַ֤ר", "transliteral": "ʾal-tō-mar", "traducao_palavra": "não digas" },
        { "hebraico": "לְרֵעֲךָ֨", "transliteral": "lə-rê-ʿă-ḵā", "traducao_palavra": "ao teu próximo" },
        { "hebraico": "לֵ֣ךְ", "transliteral": "lêḵ", "traducao_palavra": "vai" },
        { "hebraico": "וָ֭שׁוּב", "transliteral": "wā-šûḇ", "traducao_palavra": "e volta" },
        { "hebraico": "וּמָחָ֥ר", "transliteral": "ū-mā-ḥār", "traducao_palavra": "e amanhã" },
        { "hebraico": "אֶתֵּ֗ן", "transliteral": "ʾet-tên", "traducao_palavra": "darei" },
        { "hebraico": "וְיֵ֣שׁ", "transliteral": "wə-yêš", "traducao_palavra": "e havendo" },
        { "hebraico": "אִתָּֽךְ׃", "transliteral": "ʾit-tāḵ", "traducao_palavra": "[o bem] contigo" }
      ]
    },
    "29": {
      "traducao_completa": "Não maquines o mal contra o teu próximo, pois habita contigo confiadamente.",
      "palavras": [
        { "hebraico": "אַל־תַּחֲרֹ֥שׁ", "transliteral": "ʾal-ta-ḥă-rōš", "traducao_palavra": "não maquines/lavres" },
        { "hebraico": "עַל־רֵעֲךָ֥", "transliteral": "ʿal-rê-ʿă-ḵā", "traducao_palavra": "contra teu próximo" },
        { "hebraico": "רָ֑עָה", "transliteral": "rā-ʿā", "traducao_palavra": "mal" },
        { "hebraico": "וְהוּא־יֹושֵׁ֖ב", "transliteral": "wə-hû-yô-šêḇ", "traducao_palavra": "e ele habita" },
        { "hebraico": "לָבֶ֣טַח", "transliteral": "lā-ḇe-ṭaḥ", "traducao_palavra": "em confiança" },
        { "hebraico": "אִתָּֽךְ׃", "transliteral": "ʾit-tāḵ", "traducao_palavra": "contigo" }
      ]
    },
    "30": {
      "traducao_completa": "Não contendas com um homem sem causa, se não te fez nenhum mal.",
