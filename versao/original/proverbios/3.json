        { "hebraico": "יְיַשֵּׁ֥ר", "transliteral": "yə-yaš-šêr", "traducao_palavra": "endireitará" },
        { "hebraico": "אֹֽרְחֹתֶֽיךָ׃", "transliteral": "ʾō-rə-ḥō-ṯê-ḵā", "traducao_palavra": "tuas veredas" }
