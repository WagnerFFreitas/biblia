        { "hebraico": "וּשְׁנֹ֣ות", "transliteral": "ū-šə-nôṯ", "traducao_palavra": "e anos de" },
        { "hebraico": "חַיִּ֑ים", "transliteral": "ḥay-yîm", "traducao_palavra": "vida" },
        { "hebraico": "וְ֝שָׁלֹ֗ום", "transliteral": "wə-šā-lôm", "traducao_palavra": "e paz" },
