      "palavras": [
        { "hebraico": "חֶ֥סֶד", "transliteral": "ḥe-seḏ", "traducao_palavra": "bondade/misericórdia" },
        { "hebraico": "וֶאֱמֶ֗ת", "transliteral": "we-ʾĕ-meṯ", "traducao_palavra": "e verdade/fidelidade" },
        { "hebraico": "אַֽל־יַעַזְבֻ֫ךָ", "transliteral": "ʾal-ya-ʿaz-ḇu-ḵā", "traducao_palavra": "não te abandonem" },
