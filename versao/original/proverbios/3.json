        { "hebraico": "כִּ֤י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "תֹועֲבַ֣ת", "transliteral": "tô-ʿă-ḇaṯ", "traducao_palavra": "abominação de" },
        { "hebraico": "יְהוָ֣ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "נָלֹ֑וז", "transliteral": "nā-lôz", "traducao_palavra": "[é o] perverso/desviado" },
        { "hebraico": "וְאֶת־יְשָׁרִ֥ים", "transliteral": "wə-ʾeṯ-yə-šā-rîm", "traducao_palavra": "e com os retos" },
        { "hebraico": "סֹודֹֽו׃", "transliteral": "śô-ḏô", "traducao_palavra": "[está] o segredo/intimidade dele" }
      ]
    },
    "33": {
      "traducao_completa": "A maldição de YHWH está na casa do ímpio, mas a habitação dos justos ele abençoa.",
      "palavras": [
        { "hebraico": "מְאֵרַ֣ת", "transliteral": "mə-ʾê-raṯ", "traducao_palavra": "maldição de" },
        { "hebraico": "יְ֭הוָה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "בְּבֵ֣ית", "transliteral": "bə-ḇêṯ", "traducao_palavra": "na casa de" },
        { "hebraico": "רָשָׁ֑ע", "transliteral": "rā-šāʿ", "traducao_palavra": "ímpio" },
        { "hebraico": "וּנְוֵ֖ה", "transliteral": "ū-nə-wēh", "traducao_palavra": "e a habitação de" },
        { "hebraico": "צַדִּיקִ֣ים", "transliteral": "ṣad-dî-qîm", "traducao_palavra": "justos" },
        { "hebraico": "יְבָרֵֽךְ׃", "transliteral": "yə-ḇā-rēḵ", "traducao_palavra": "ele abençoa" }
      ]
    },
    "34": {
      "traducao_completa": "Certamente ele escarnece dos escarnecedores, mas dá graça aos humildes.",
      "palavras": [
        { "hebraico": "אִם־לַלֵּצִ֥ים", "transliteral": "ʾim-lal-lê-ṣîm", "traducao_palavra": "se aos escarnecedores" },
        { "hebraico": "הֽוּא־יָלִ֑יץ", "transliteral": "hû-yā-lîṣ", "traducao_palavra": "ele escarnece" },
        { "hebraico": "וְ֝לַעֲנָוִ֗ים", "transliteral": "wə-la-ʿă-nā-wîm", "traducao_palavra": "mas aos humildes" },
