        { "hebraico": "חִנָּ֑ם", "transliteral": "ḥin-nām", "traducao_palavra": "sem causa/gratuitamente" },
        { "hebraico": "אִם־לֹ֖א", "transliteral": "ʾim-lō", "traducao_palavra": "se não" },
        { "hebraico": "גְמָלְךָ֣", "transliteral": "ḡə-mā-lə-ḵā", "traducao_palavra": "te fez/retribuiu" },
        { "hebraico": "רָֽעָה׃", "transliteral": "rā-ʿā", "traducao_palavra": "mal" }
      ]
    },
    "31": {
      "traducao_completa": "Não tenhas inveja do homem violento, nem escolhas nenhum dos seus caminhos.",
      "palavras": [
        { "hebraico": "אַל־תְּ֭קַנֵּא", "transliteral": "ʾal-tə-qan-nē", "traducao_palavra": "não tenhas inveja" },
        { "hebraico": "בְּאִ֣ישׁ", "transliteral": "bə-ʾîš", "traducao_palavra": "do homem de" },
        { "hebraico": "חָמָ֑ס", "transliteral": "ḥā-mās", "traducao_palavra": "violência" },
        { "hebraico": "וְאַל־תִּ֝בְחַ֗r", "transliteral": "wə-ʾal-tiḇ-ḥar", "traducao_palavra": "e não escolhas" },
        { "hebraico": "בְּכָל־דְּרָכָֽיו׃", "transliteral": "bə-ḵāl-də-rā-ḵāw", "traducao_palavra": "em todos os seus caminhos" }
      ]
