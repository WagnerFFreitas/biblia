        { "hebraico": "תֹּורָתִ֣י", "transliteral": "tô-rā-ṯî", "traducao_palavra": "minha instrução/lei" },
        { "hebraico": "אַל־תִּשְׁכָּ֑ח", "transliteral": "ʾal-tiš-kāḥ", "traducao_palavra": "não te esqueças" },
        { "hebraico": "וּ֝מִצְוֹתַ֗י", "transliteral": "ū-miṣ-wō-ṯay", "traducao_palavra": "e meus mandamentos" },
        { "hebraico": "יִצֹּ֥ר", "transliteral": "yiṣ-ṣōr", "traducao_palavra": "guarde/preserve" },
        { "hebraico": "לִבֶּֽךָ׃", "transliteral": "lib-be-ḵā", "traducao_palavra": "teu coração" }
      ]
    },
    "2": {
