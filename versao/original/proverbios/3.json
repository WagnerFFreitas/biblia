        { "hebraico": "יָֽסַד־אָ֑רֶץ", "transliteral": "yā-saḏ-ʾā-reṣ", "traducao_palavra": "fundou a terra" },
        { "hebraico": "כֹּונֵ֥ן", "transliteral": "kô-nên", "traducao_palavra": "estabeleceu/firmou" },
        { "hebraico": "שָׁ֝מַ֗יִם", "transliteral": "šā-ma-yim", "traducao_palavra": "céus" },
        { "hebraico": "בִּתְבוּנָֽה׃", "transliteral": "biṯ-ḇû-nā", "traducao_palavra": "com entendimento" }
      ]
    },
    "20": {
      "traducao_completa": "Pelo seu conhecimento se fenderam os abismos, e as nuvens destilam o orvalho.",
      "palavras": [
        { "hebraico": "בְּ֭דַעְתֹּו", "transliteral": "bə-ḏa-ʿət-tô", "traducao_palavra": "pelo seu conhecimento" },
        { "hebraico": "תְּהֹומֹ֣ות", "transliteral": "tə-hō-môṯ", "traducao_palavra": "abismos" },
        { "hebraico": "נִבְקָ֑עוּ", "transliteral": "nib-qā-ʿû", "traducao_palavra": "se fenderam" },
        { "hebraico": "וּ֝שְׁחָקִ֗ים", "transliteral": "ū-šə-ḥā-qîm", "traducao_palavra": "e as nuvens/céus" },
        { "hebraico": "יִרְעֲפוּ־טָֽל׃", "transliteral": "yir-ʿă-p̄û-ṭāl", "traducao_palavra": "destilam orvalho" }
      ]
    },
    "21": {
      "traducao_completa": "Filho meu, não se apartem estas coisas dos teus olhos; guarda a verdadeira sabedoria e o siso;",
      "palavras": [
        { "hebraico": "בְּ֭נִי", "transliteral": "bə-nî", "traducao_palavra": "filho meu" },
        { "hebraico": "אַל־יָלֻ֣זוּ", "transliteral": "ʾal-yā-lu-zû", "traducao_palavra": "não se apartem" },
        { "hebraico": "מֵעֵינֶ֑יךָ", "transliteral": "mê-ʿê-ne-ḵā", "traducao_palavra": "dos teus olhos" },
        { "hebraico": "נְצֹ֥ר", "transliteral": "nə-ṣōr", "traducao_palavra": "guarda" },
        { "hebraico": "תֻּ֝שִׁיָּ֗ה", "transliteral": "tu-šî-yā", "traducao_palavra": "sabedoria verdadeira" },
        { "hebraico": "וּמְזִמָּֽה׃", "transliteral": "ū-mə-zim-mā", "traducao_palavra": "e siso/discrição" }
      ]
    },
    "22": {
      "traducao_completa": "porque serão vida para a tua alma, e graça para o teu pescoço.",
      "palavras": [
        { "hebraico": "וְיִהְי֣וּ", "transliteral": "wə-yih-yû", "traducao_palavra": "e serão" },
        { "hebraico": "חַיִּ֣ים", "transliteral": "ḥay-yîm", "traducao_palavra": "vida" },
        { "hebraico": "לְנַפְשֶׁ֑ךָ", "transliteral": "lə-nap̄-še-ḵā", "traducao_palavra": "para tua alma" },
        { "hebraico": "וְ֝חֵ֗ן", "transliteral": "wə-ḥên", "traducao_palavra": "e graça" },
        { "hebraico": "לְגַרְגְּרֹתֶֽיךָ׃", "transliteral": "lə-ḡar-gə-rō-ṯê-ḵā", "traducao_palavra": "para teu pescoço" }
      ]
    },
    "23": {
      "traducao_completa": "Então andarás confiante pelo teu caminho, e não tropeçará o teu pé.",
      "palavras": [
        { "hebraico": "אָ֣ז", "transliteral": "ʾāz", "traducao_palavra": "então" },
        { "hebraico": "תֵּלֵ֣ךְ", "transliteral": "tê-lêḵ", "traducao_palavra": "andarás" },
        { "hebraico": "לָבֶ֣טַח", "transliteral": "lā-ḇe-ṭaḥ", "traducao_palavra": "em segurança" },
        { "hebraico": "דַּרְכֶּ֑ךָ", "transliteral": "ḏar-ke-ḵā", "traducao_palavra": "teu caminho" },
        { "hebraico": "וְ֝רַגְלְךָ֗", "transliteral": "wə-raḡ-lə-ḵā", "traducao_palavra": "e teu pé" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "תִגֹּֽוף׃", "transliteral": "tiḡ-ḡôp̄", "traducao_palavra": "tropeçará" }
      ]
    },
    "24": {
      "traducao_completa": "Quando te deitares, não temerás; sim, tu te deitarás, e o teu sono será suave.",
      "palavras": [
        { "hebraico": "אִם־תִּשְׁכַּ֥ב", "transliteral": "ʾim-tiš-kab", "traducao_palavra": "se/quando te deitares" },
        { "hebraico": "לֹֽא־תִפְחָ֑ד", "transliteral": "lō-ṯip̄-ḥāḏ", "traducao_palavra": "não temerás" },
        { "hebraico": "וְ֝שָׁכַבְתָּ֗", "transliteral": "wə-šā-ḵaḇ-tā", "traducao_palavra": "e te deitarás" },
        { "hebraico": "וְעָרְבָ֥ה", "transliteral": "wə-ʿā-rə-ḇā", "traducao_palavra": "e será doce/suave" },
        { "hebraico": "שְׁנָתֶֽךָ׃", "transliteral": "šə-nā-ṯe-ḵā", "traducao_palavra": "teu sono" }
      ]
    },
    "25": {
      "traducao_completa": "Não temas o pavor repentino, nem a assolação dos ímpios quando vier.",
      "palavras": [
        { "hebraico": "אַל־תִּירָ֥as", "transliteral": "ʾal-tî-rā", "traducao_palavra": "não temas" },
        { "hebraico": "מִפַּ֣חַד", "transliteral": "mip-pa-ḥaḏ", "traducao_palavra": "do pavor" },
        { "hebraico": "פִּתְאֹ֑ם", "transliteral": "piṯ-ʾōm", "traducao_palavra": "repentino" },
        { "hebraico": "וּמִשֹּׁאַ֥ת", "transliteral": "ū-miš-šō-ʾaṯ", "traducao_palavra": "e da assolação de" },
        { "hebraico": "רְ֝שָׁעִ֗ים", "transliteral": "rə-šā-ʿîm", "traducao_palavra": "ímpios" },
        { "hebraico": "כִּ֣י", "transliteral": "kî", "traducao_palavra": "quando" },
        { "hebraico": "תָבֹֽא׃", "transliteral": "ṯā-ḇō", "traducao_palavra": "vier" }
      ]
    },
    "26": {
      "traducao_completa": "Porque YHWH será a tua esperança e guardará o teu pé de ser preso.",
      "palavras": [
        { "hebraico": "כִּֽי־יְהוָ֥ה", "transliteral": "kî-YHWH", "traducao_palavra": "porque YHWH" },
        { "hebraico": "יִהְיֶ֣ה", "transliteral": "yih-yeh", "traducao_palavra": "será" },
        { "hebraico": "בְכִסְלֶ֑ךָ", "transliteral": "ḇə-ḵis-le-ḵā", "traducao_palavra": "tua confiança/esperança" },
        { "hebraico": "וְשָׁמַ֖ר", "transliteral": "wə-šā-mar", "traducao_palavra": "e guardará" },
        { "hebraico": "רַגְלְךָ֣", "transliteral": "raḡ-lə-ḵā", "traducao_palavra": "teu pé" },
