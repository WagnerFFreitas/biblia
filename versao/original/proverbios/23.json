    "13": {
      "traducao_completa": "Não retires a correção da criança; pois se a fustigares com a vara, não morrerá.",
      "palavras": [
        { "hebraico": "אַל־", "transliteral": "ʾal-", "traducao_palavra": "Não" },
        { "hebraico": "תִּמְנַ֣ע", "transliteral": "tim-naʿ", "traducao_palavra": "retires/prives" },
        { "hebraico": "מִנַּ֣עַר", "transliteral": "min-na-ʿar", "traducao_palavra": "da criança" },
