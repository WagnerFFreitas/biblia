        { "hebraico": "חָכַ֣ם", "transliteral": "ḥā-ḵam", "traducao_palavra": "for sábio" },
        { "hebraico": "לִבֶּ֑ךָ", "transliteral": "lib-be-ḵā", "traducao_palavra": "teu coração" },
        { "hebraico": "יִשְׂמַ֖ח", "transliteral": "yiś-maḥ", "traducao_palavra": "alegrar-se-á" },
        { "hebraico": "לִבִּ֣י", "transliteral": "lib-bî", "traducao_palavra": "meu coração" },
        { "hebraico": "גַם־", "transliteral": "gam-", "traducao_palavra": "também" },
        { "hebraico": "אָֽנִי׃", "transliteral": "ʾā-nî", "traducao_palavra": "eu" }
      ]
    },
    "16": {
      "traducao_completa": "Exultarão os meus rins, quando os teus lábios falarem coisas retas.",
