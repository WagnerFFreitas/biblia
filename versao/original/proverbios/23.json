    "10": {
      "traducao_completa": "Não removas os marcos antigos, nem entres nos campos dos órfãos,",
      "palavras": [
        { "hebraico": "אַל־", "transliteral": "ʾal-", "traducao_palavra": "Não" },
        { "hebraico": "תַּ֭סֵּג", "transliteral": "tas-sêḡ", "traducao_palavra": "removas" },
        { "hebraico": "גְּב֣וּל", "transliteral": "ḡə-ḇûl", "traducao_palavra": "limite/marco" },
        { "hebraico": "עֹולָ֑ם", "transliteral": "ʿô-lām", "traducao_palavra": "antigo" },
        { "hebraico": "וּבִשְׂדֵ֥י", "transliteral": "ū-ḇi-śə-ḏê", "traducao_palavra": "e nos campos de" },
        { "hebraico": "יְ֝תֹומִ֗ים", "transliteral": "yə-ṯô-mîm", "traducao_palavra": "órfãos" },
        { "hebraico": "אַל־", "transliteral": "ʾal-", "traducao_palavra": "não" },
        { "hebraico": "תָּבֹֽא׃", "transliteral": "ṯā-ḇō", "traducao_palavra": "entres" }
      ]
    },
    "11": {
      "traducao_completa": "porque o seu Redentor é forte; ele pleiteará a causa deles contra ti.",
      "palavras": [
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "porque" },
        { "hebraico": "גֹאֲלָ֥ם", "transliteral": "ḡō-ʾă-lām", "traducao_palavra": "o Redentor deles" },
