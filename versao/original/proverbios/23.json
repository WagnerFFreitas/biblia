        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "porque se" },
        { "hebraico": "תַכֶּ֥נּוּ", "transliteral": "ṯak-ken-nû", "traducao_palavra": "a fustigares/bateres" },
