        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "יָמֽוּת׃", "transliteral": "yā-mûṯ", "traducao_palavra": "morrerá" }
      ]
    },
    "14": {
      "traducao_completa": "Tu a fustigarás com a vara, e livrarás a sua alma do Seol.",
      "palavras": [
        { "hebraico": "אַ֭תָּה", "transliteral": "ʾat-tā", "traducao_palavra": "Tu" },
        { "hebraico": "בַּשֵּׁ֣בֶט", "transliteral": "baš-šê-ḇeṭ", "traducao_palavra": "com a vara" },
