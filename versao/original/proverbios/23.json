        { "hebraico": "תְּדַבֵּ֑ר", "transliteral": "tə-ḏab-bêr", "traducao_palavra": "fales" },
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "porque" },
        { "hebraico": "יָ֝ב֗וּז", "transliteral": "yā-ḇûz", "traducao_palavra": "ele desprezará" },
        { "hebraico": "לְשֵׂ֣כֶל", "transliteral": "lə-śê-ḵel", "traducao_palavra": "a prudência de" },
        { "hebraico": "מִלֶּֽיךָ׃", "transliteral": "mil-le-y-ḵā", "traducao_palavra": "tuas palavras" }
      ]
