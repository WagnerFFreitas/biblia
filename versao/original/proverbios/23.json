        { "hebraico": "פִּתְּךָ־", "transliteral": "pit-tə-ḵā-", "traducao_palavra": "Teu bocado" },
        { "hebraico": "אָכַ֥לְתָּ", "transliteral": "ʾā-ḵal-tā", "traducao_palavra": "[que] comeste" },
        { "hebraico": "תְקִיאֶ֑נָּה", "transliteral": "ṯə-qî-ʾen-nā", "traducao_palavra": "vomitarás" },
        { "hebraico": "וְ֝שִׁחַ֗תָּ", "transliteral": "wə-ši-ḥat-tā", "traducao_palavra": "e perderás/corromperás" },
        { "hebraico": "דְּבָרֶ֥יךָ", "transliteral": "də-ḇā-re-y-ḵā", "traducao_palavra": "tuas palavras" },
        { "hebraico": "הַנְּעִימִֽים׃", "transliteral": "han-nə-ʿî-mîm", "traducao_palavra": "agradáveis" }
      ]
    },
    "9": {
      "traducao_completa": "Não fales aos ouvidos do tolo, porque desprezará a sabedoria das tuas palavras.",
