        { "hebraico": "בְּדַבֵּ֥ר", "transliteral": "bə-ḏab-bêr", "traducao_palavra": "ao falarem" },
        { "hebraico": "שְׂ֝פָתֶ֗יךָ", "transliteral": "śə-p̄ā-ṯê-ḵā", "traducao_palavra": "teus lábios" },
