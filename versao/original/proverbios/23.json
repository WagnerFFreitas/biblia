        { "hebraico": "אִתָּֽךְ׃", "transliteral": "ʾit-tāḵ", "traducao_palavra": "contra ti" }
      ]
    },
    "12": {
      "traducao_completa": "Aplica o teu coração à instrução e os teus ouvidos às palavras do conhecimento.",
      "palavras": [
        { "hebraico": "הָבִ֣יאָה", "transliteral": "hā-ḇî-ʾā", "traducao_palavra": "Traz/aplica" },
        { "hebraico": "לַמּוּסָ֣ר", "transliteral": "lam-mū-sār", "traducao_palavra": "à correção/instrução" },
        { "hebraico": "לִבֶּ֑ךָ", "transliteral": "lib-be-ḵā", "traducao_palavra": "teu coração" },
        { "hebraico": "וְ֝אָזְנֶ֗ךָ", "transliteral": "wə-ʾāz-ne-ḵā", "traducao_palavra": "e teu ouvido" },
        { "hebraico": "לְאִמְרֵי־", "transliteral": "lə-ʾim-rê-", "traducao_palavra": "às palavras de" },
        { "hebraico": "דָֽעַת׃", "transliteral": "dā-ʿaṯ", "traducao_palavra": "conhecimento" }
      ]
