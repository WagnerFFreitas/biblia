    "15": {
      "traducao_completa": "Filho meu, se o teu coração for sábio, alegrar-se-á o meu coração, sim, o meu próprio.",
      "palavras": [
        { "hebraico": "בְּ֭נִי", "transliteral": "bə-nî", "traducao_palavra": "Filho meu" },
