        { "hebraico": "אַל־", "transliteral": "ʾal-", "traducao_palavra": "Não" },
        { "hebraico": "יְקַנֵּ֣א", "transliteral": "yə-qan-nē", "traducao_palavra": "tenha inveja" },
        { "hebraico": "לִבְּךָ֣", "transliteral": "lib-bə-ḵā", "traducao_palavra": "teu coração" },
        { "hebraico": "בַּֽחַטָּאִ֑ים", "transliteral": "ba-ḥaṭ-ṭā-ʾîm", "traducao_palavra": "de pecadores" },
        { "hebraico": "כִּ֥י", "transliteral": "kî", "traducao_palavra": "mas" },
        { "hebraico": "אִם־", "transliteral": "ʾim-", "traducao_palavra": "se/antes" },
        { "hebraico": "בְּיִרְאַת־", "transliteral": "bə-yir-ʾaṯ-", "traducao_palavra": "no temor de" },
        { "hebraico": "יְ֝הוָ֗ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "כָּל־", "transliteral": "kāl-", "traducao_palavra": "todo" },
        { "hebraico": "הַיֹּֽום׃", "transliteral": "hay-yôm", "traducao_palavra": "o dia" }
      ]
    },
    "18": {
      "traducao_completa": "Porque certamente há um fim futuro; e a tua esperança não será cortada.",
      "palavras": [
        { "hebraico": "כִּ֭י", "transliteral": "kî", "traducao_palavra": "Porque" },
        { "hebraico": "אִם־", "transliteral": "ʾim-", "traducao_palavra": "se/certamente" },
        { "hebraico": "יֵ֣שׁ", "transliteral": "yêš", "traducao_palavra": "há" },
        { "hebraico": "אַחֲרִ֑ית", "transliteral": "ʾa-ḥă-rîṯ", "traducao_palavra": "um fim/futuro" },
        { "hebraico": "וְ֝תִקְוָתְךָ֗", "transliteral": "wə-ṯiq-wā-ṯə-ḵā", "traducao_palavra": "e tua esperança" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "תִכָּרֵֽת׃", "transliteral": "ṯik-kā-rêṯ", "traducao_palavra": "será cortada" }
      ]
    },
    "19": {
      "traducao_completa": "Ouve tu, filho meu, e sê sábio, e dirige no caminho o teu coração.",
      "palavras": [
        { "hebraico": "שְׁמַע־", "transliteral": "šə-maʿ-", "traducao_palavra": "Ouve" },
        { "hebraico": "אַתָּ֥ה", "transliteral": "ʾat-tā", "traducao_palavra": "tu" },
        { "hebraico": "בְנִ֭י", "transliteral": "ḇə-nî", "traducao_palavra": "filho meu" },
        { "hebraico": "וַחֲכָ֑ם", "transliteral": "wa-ḥă-ḵām", "traducao_palavra": "e sê sábio" },
        { "hebraico": "וְאַשֵּׁ֖ר", "transliteral": "wə-ʾaš-šēr", "traducao_palavra": "e dirige/guia" },
        { "hebraico": "בַּדֶּ֣רֶךְ", "transliteral": "bad-de-reḵ", "traducao_palavra": "no caminho" },
        { "hebraico": "לִבֶּֽךָ׃", "transliteral": "lib-be-ḵā", "traducao_palavra": "teu coração" }
      ]
    },
    "20": {
      "traducao_completa": "Não estejas entre os bebedores de vinho, nem entre os comilões de carne.",
      "palavras": [
        { "hebraico": "אַל־", "transliteral": "ʾal-", "traducao_palavra": "Não" },
        { "hebraico": "תְּהִ֥י", "transliteral": "tə-hî", "traducao_palavra": "estejas" },
        { "hebraico": "בְסֹבְאֵי־", "transliteral": "ḇə-śō-ḇə-ʾê-", "traducao_palavra": "entre os bebedores de" },
        { "hebraico": "יָ֑יִן", "transliteral": "yā-yin", "traducao_palavra": "vinho" },
        { "hebraico": "בְּזֹלֲלֵ֖י", "transliteral": "bə-zō-lă-lê", "traducao_palavra": "entre os comilões/glutões de" },
        { "hebraico": "בָשָׂ֣ר", "transliteral": "ḇā-śār", "traducao_palavra": "carne" },
        { "hebraico": "לָ֝מֹ֗ו", "transliteral": "lā-mô", "traducao_palavra": "para si [eles]" }
      ]
    },
    "21": {
      "traducao_completa": "Porque o beberrão e o comilão empobrecerão; e a sonolência faz o homem vestir-se de trapos.",
      "palavras": [
        { "hebraico": "כִּי־", "transliteral": "kî-", "traducao_palavra": "Porque" },
        { "hebraico": "סֹבֵ֣א", "transliteral": "sō-ḇē", "traducao_palavra": "[o] beberrão" },
        { "hebraico": "וְזֹולֵ֣ל", "transliteral": "wə-zô-lēl", "traducao_palavra": "e [o] glutão" },
        { "hebraico": "יִוָּרֵ֑שׁ", "transliteral": "yiw-wā-rēš", "traducao_palavra": "empobrecerão" },
        { "hebraico": "וְ֝נוּמָ֗ה", "transliteral": "wə-nû-mā", "traducao_palavra": "e a sonolência" },
        { "hebraico": "תַּלְבִּ֥ישׁ", "transliteral": "tal-bîš", "traducao_palavra": "fará vestir" },
        { "hebraico": "קְרָעִֽים׃", "transliteral": "qə-rā-ʿîm", "traducao_palavra": "trapos" }
      ]
    },
    "22": {
      "traducao_completa": "Ouve a teu pai, que te gerou, e não desprezes a tua mãe, quando vier a envelhecer.",
      "palavras": [
        { "hebraico": "שְׁמַ֣ע", "transliteral": "šə-maʿ", "traducao_palavra": "Ouve" },
        { "hebraico": "לְ֭אָבִיךָ", "transliteral": "lə-ʾā-ḇî-ḵā", "traducao_palavra": "a teu pai" },
        { "hebraico": "זֶ֣ה", "transliteral": "zeh", "traducao_palavra": "que" },
        { "hebraico": "יְלָדֶ֑ךָ", "transliteral": "yə-lā-ḏe-ḵā", "traducao_palavra": "te gerou" },
        { "hebraico": "וְאַל־", "transliteral": "wə-ʾal-", "traducao_palavra": "e não" },
        { "hebraico": "תָּ֝ב֗וּז", "transliteral": "tā-ḇûz", "traducao_palavra": "desprezes" },
        { "hebraico": "כִּי־", "transliteral": "kî-", "traducao_palavra": "porque" },
        { "hebraico": "זָקְנָ֥ה", "transliteral": "zā-qə-nā", "traducao_palavra": "envelheceu" },
        { "hebraico": "אִמֶּֽךָ׃", "transliteral": "ʾim-me-ḵā", "traducao_palavra": "tua mãe" }
      ]
    },
    "23": {
      "traducao_completa": "Compra a verdade e não a vendas; sim, a sabedoria, a correção e o entendimento.",
      "palavras": [
        { "hebraico": "אֱמֶ֣ת", "transliteral": "ʾĕ-meṯ", "traducao_palavra": "Verdade" },
        { "hebraico": "קְ֭נֵה", "transliteral": "qə-nēh", "traducao_palavra": "compra" },
        { "hebraico": "וְאַל־", "transliteral": "wə-ʾal-", "traducao_palavra": "e não" },
        { "hebraico": "תִּמְכֹּ֑ר", "transliteral": "tim-kōr", "traducao_palavra": "vendas" },
        { "hebraico": "חָכְמָ֖ה", "transliteral": "ḥā-ḵə-mā", "traducao_palavra": "sabedoria" },
        { "hebraico": "וּמוּסָ֣ר", "transliteral": "ū-mū-sār", "traducao_palavra": "e correção" },
        { "hebraico": "וּבִינָֽה׃", "transliteral": "ū-ḇî-nā", "traducao_palavra": "e entendimento" }
      ]
    },
    "24": {
      "traducao_completa": "Grandemente se alegrará o pai do justo, e o que gerar um sábio se alegrará nele.",
      "palavras": [
        { "hebraico": "גֹּ֣ול", "transliteral": "ḡôl", "traducao_palavra": "Grandemente" },
        { "hebraico": "יָ֭גִיל", "transliteral": "yā-ḡîl", "traducao_palavra": "exultará" },
        { "hebraico": "אֲבִ֣י", "transliteral": "ʾă-ḇî", "traducao_palavra": "o pai de" },
        { "hebraico": "צַדִּ֑יק", "transliteral": "ṣad-dîq", "traducao_palavra": "um justo" },
        { "hebraico": "וְיֹולֵ֥ד", "transliteral": "wə-yô-lêḏ", "traducao_palavra": "e o que gera" },
        { "hebraico": "חָ֝כָ֗ם", "transliteral": "ḥā-ḵām", "traducao_palavra": "um sábio" },
        { "hebraico": "וְיִשְׂמַח־", "transliteral": "wə-yiś-maḥ-", "traducao_palavra": "se alegrará" },
        { "hebraico": "בֹּֽו׃", "transliteral": "bô", "traducao_palavra": "nele" }
      ]
    },
    "25": {
      "traducao_completa": "Alegrem-se teu pai e tua mãe, e exulte a que te deu à luz.",
      "palavras": [
        { "hebraico": "יִֽשְׂמַח־", "transliteral": "yiś-maḥ-", "traducao_palavra": "Alegrem-se" },
        { "hebraico": "אָבִ֥יךָ", "transliteral": "ʾā-ḇî-ḵā", "traducao_palavra": "teu pai" },
        { "hebraico": "וְאִמֶּ֑ךָ", "transliteral": "wə-ʾim-me-ḵā", "traducao_palavra": "e tua mãe" },
        { "hebraico": "וְ֝תָגֵ֗ל", "transliteral": "wə-ṯā-ḡêl", "traducao_palavra": "e exulte/se alegre" },
        { "hebraico": "יֹולַדְתֶּֽךָ׃", "transliteral": "yô-laḏ-te-ḵā", "traducao_palavra": "a que te gerou" }
      ]
    },
    "26": {
      "traducao_completa": "Dá-me, filho meu, o teu coração, e os teus olhos observem os meus caminhos.",
      "palavras": [
        { "hebraico": "תְּנָה־", "transliteral": "tə-nā-", "traducao_palavra": "Dá" },
        { "hebraico": "בְנִ֣י", "transliteral": "ḇə-nî", "traducao_palavra": "filho meu" },
        { "hebraico": "לִבְּךָ֣", "transliteral": "lib-bə-ḵā", "traducao_palavra": "teu coração" },
        { "hebraico": "לִ֑י", "transliteral": "lî", "traducao_palavra": "para mim" },
        { "hebraico": "וְ֝עֵינֶ֗יךָ", "transliteral": "wə-ʿê-ne-ḵā", "traducao_palavra": "e teus olhos" },
        { "hebraico": "דְּרָכַ֥י", "transliteral": "də-rā-ḵay", "traducao_palavra": "meus caminhos" },
        { "hebraico": "תִּרְצֶֽנָה׃", "transliteral": "tir-ṣe-nā", "traducao_palavra": "observem/desejem" }
      ]
    },
    "27": {
      "traducao_completa": "Porque cova profunda é a prostituta, e poço estreito a estrangeira.",
      "palavras": [
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "Porque" },
        { "hebraico": "שׁוּחָ֣ה", "transliteral": "šû-ḥā", "traducao_palavra": "cova" },
        { "hebraico": "עֲמֻקָּ֣ה", "transliteral": "ʿă-muq-qā", "traducao_palavra": "profunda [é a]" },
        { "hebraico": "זֹונָ֑ה", "transliteral": "zô-nā", "traducao_palavra": "prostituta" },
        { "hebraico": "וּבְאֵ֥ר", "transliteral": "ū-ḇə-ʾêr", "traducao_palavra": "e poço" },
        { "hebraico": "צָ֝רָ֗ה", "transliteral": "ṣā-rā", "traducao_palavra": "estreito [é a]" },
        { "hebraico": "נָכְרִיָּֽה׃", "transliteral": "nā-ḵə-rî-yā", "traducao_palavra": "estrangeira" }
      ]
    },
    "28": {
      "traducao_completa": "Também ela, como um salteador, se põe à espreita e multiplica entre os homens os infiéis.",
      "palavras": [
        { "hebraico": "אַף־", "transliteral": "ʾap̄-", "traducao_palavra": "Também" },
        { "hebraico": "הִ֭יא", "transliteral": "hî", "traducao_palavra": "ela" },
        { "hebraico": "כְּחֶ֣טֶף", "transliteral": "kə-ḥe-ṭep̄", "traducao_palavra": "como um ladrão/salteador" },
        { "hebraico": "תֶּאֱרֹ֑ב", "transliteral": "te-ʾĕ-rōḇ", "traducao_palavra": "se põe à espreita" },
        { "hebraico": "וּ֝בֹוגְדִ֗ים", "transliteral": "ū-ḇô-ḡə-ḏîm", "traducao_palavra": "e os infiéis/traidores" },
        { "hebraico": "בְּאָדָ֥ם", "transliteral": "bə-ʾā-ḏām", "traducao_palavra": "entre os homens" },
        { "hebraico": "תֹּוסִֽף׃", "transliteral": "tô-sîp̄", "traducao_palavra": "multiplica" }
      ]
    },
    "29": {
      "traducao_completa": "Para quem são os ais? Para quem os pesares? Para quem as contendas? Para quem as queixas? Para quem as feridas sem causa? E para quem os olhos vermelhos?",
      "palavras": [
        { "hebraico": "לְמִ֨י", "transliteral": "lə-mî", "traducao_palavra": "Para quem" },
        { "hebraico": "אֹ֥וי", "transliteral": "ʾôy", "traducao_palavra": "ais" },
        { "hebraico": "לְמִ֨י", "transliteral": "lə-mî", "traducao_palavra": "para quem" },
        { "hebraico": "אֲבֹ֗וי", "transliteral": "ʾă-ḇôy", "traducao_palavra": "lástimas" },
        { "hebraico": "לְמִ֣י", "transliteral": "lə-mî", "traducao_palavra": "para quem" },
        { "hebraico": "מדְיָנִים", "transliteral": "miḏ-yā-nîm", "traducao_palavra": "contendas" },
        { "hebraico": "לְמִ֣י", "transliteral": "lə-mî", "traducao_palavra": "para quem" },
        { "hebraico": "שִׂ֑יחַ", "transliteral": "śî-aḥ", "traducao_palavra": "queixas/preocupação" },
        { "hebraico": "לְמִ֭י", "transliteral": "lə-mî", "traducao_palavra": "para quem" },
        { "hebraico": "פְּצָעִ֣ים", "transliteral": "pə-ṣā-ʿîm", "traducao_palavra": "feridas" },
        { "hebraico": "חִנָּ֑ם", "transliteral": "ḥin-nām", "traducao_palavra": "sem causa" },
        { "hebraico": "לְ֝מִ֗י", "transliteral": "lə-mî", "traducao_palavra": "para quem" },
        { "hebraico": "חַכְלִל֥וּת", "transliteral": "ḥaḵ-li-lûṯ", "traducao_palavra": "vermelhidão de" },
        { "hebraico": "עֵינָֽיִם׃", "transliteral": "ʿê-nā-yim", "traducao_palavra": "olhos" }
      ]
    },
    "30": {
      "traducao_completa": "Para os que se demoram perto do vinho; para os que andam buscando bebida misturada.",
      "palavras": [
        { "hebraico": "לַֽמְאַחֲרִ֥ים", "transliteral": "lam-ʾa-ḥă-rîm", "traducao_palavra": "Para os que se demoram" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "junto a/sobre" },
        { "hebraico": "הַיָּ֑יִן", "transliteral": "hay-yā-yin", "traducao_palavra": "o vinho" },
        { "hebraico": "לַ֝בָּאִ֗ים", "transliteral": "lab-bā-ʾîm", "traducao_palavra": "para os que vêm" },
        { "hebraico": "לַחְקֹ֥ר", "transliteral": "laḥ-qōr", "traducao_palavra": "para buscar/provar" },
        { "hebraico": "מִמְסָֽךְ׃", "transliteral": "mim-sāḵ", "traducao_palavra": "bebida misturada" }
      ]
    },
    "31": {
      "traducao_completa": "Não olhes para o vinho quando se mostra vermelho, quando resplandece no copo e se escoa suavemente.",
      "palavras": [
        { "hebraico": "אַל־", "transliteral": "ʾal-", "traducao_palavra": "Não" },
        { "hebraico": "תֵּ֥רֶא", "transliteral": "tê-re", "traducao_palavra": "olhes" },
        { "hebraico": "יַ֭יִן", "transliteral": "ya-yin", "traducao_palavra": "[para o] vinho" },
        { "hebraico": "כִּ֣י", "transliteral": "kî", "traducao_palavra": "quando" },
        { "hebraico": "יִתְאַדָּ֑ם", "transliteral": "yiṯ-ʾad-dām", "traducao_palavra": "se mostra vermelho" },
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "quando" },
        { "hebraico": "יִתֵּ֨ן", "transliteral": "yiṯ-tên", "traducao_palavra": "dá/mostra" },
        { "hebraico": "בַכֹּ֥וס", "transliteral": "bak-kôs", "traducao_palavra": "no copo" },
        { "hebraico": "עֵינֹ֑ו", "transliteral": "ʿê-nô", "traducao_palavra": "seu olho/brilho" },
        { "hebraico": "יִתְהַלֵּ֥ךְ", "transliteral": "yiṯ-hal-lêḵ", "traducao_palavra": "desliza/se escoa" },
        { "hebraico": "בְּמֵישָׁרִֽים׃", "transliteral": "bə-mê-šā-rîm", "traducao_palavra": "suavemente/retamente" }
      ]
    },
    "32": {
      "traducao_completa": "No seu fim morderá como a cobra e, como o basilisco, picará.",
      "palavras": [
        { "hebraico": "אַ֝חֲרִיתֹ֗ו", "transliteral": "ʾa-ḥă-rî-ṯô", "traducao_palavra": "No seu fim" },
        { "hebraico": "כְּנָחָ֥שׁ", "transliteral": "kə-nā-ḥāš", "traducao_palavra": "como cobra" },
        { "hebraico": "יִשָּׁ֑ךְ", "transliteral": "yiš-šāḵ", "traducao_palavra": "morderá" },
        { "hebraico": "וּ֝כְצִפְעֹנִ֗י", "transliteral": "ū-ḵə-ṣip̄-ʿō-nî", "traducao_palavra": "e como víbora/basilisco" },
        { "hebraico": "יַפְרִֽשׁ׃", "transliteral": "yap̄-riš", "traducao_palavra": "picara/ferirá" }
      ]
    },
    "33": {
      "traducao_completa": "Os teus olhos verão coisas estranhas, e o teu coração falará perversidades.",
      "palavras": [
        { "hebraico": "עֵ֭ינֶיךָ", "transliteral": "ʿê-ne-ḵā", "traducao_palavra": "Teus olhos" },
        { "hebraico": "יִרְא֭וּ", "transliteral": "yir-ʾû", "traducao_palavra": "verão" },
        { "hebraico": "זָרֹ֑ות", "transliteral": "zā-rôṯ", "traducao_palavra": "estranhas/estrangeiras" },
        { "hebraico": "וְ֝לִבְּךָ֗", "transliteral": "wə-lib-bə-ḵā", "traducao_palavra": "e teu coração" },
        { "hebraico": "יְדַבֵּ֥ר", "transliteral": "yə-ḏab-bêr", "traducao_palavra": "falará" },
        { "hebraico": "תַּהְפֻּכֹֽות׃", "transliteral": "tah-pu-ḵôṯ", "traducao_palavra": "perversidades" }
      ]
    },
    "34": {
