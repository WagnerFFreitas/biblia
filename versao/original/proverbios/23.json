{
  "livro": "Provérbios - מִשְׁלֵי - Mishlei",
  "capítulo": 23,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Quando te assentares a comer com um governador, atenta bem para o que está diante de ti;",
      "palavras": [
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "Quando" },
        { "hebraico": "תֵ֭שֵׁב", "transliteral": "ṯē-šêḇ", "traducao_palavra": "te assentares" },
        { "hebraico": "לִלְחֹ֣ום", "transliteral": "lil-ḥôm", "traducao_palavra": "para comer" },
        { "hebraico": "אֶת־", "transliteral": "ʾeṯ-", "traducao_palavra": "com" },
        { "hebraico": "מֹושֵׁ֑ל", "transliteral": "mô-šêl", "traducao_palavra": "[um] governador/governante" },
        { "hebraico": "בִּ֥ין", "transliteral": "bîn", "traducao_palavra": "atenta/discerna" },
        { "hebraico": "תָּ֝בִ֗ין", "transliteral": "tā-ḇîn", "traducao_palavra": "bem/considera" },
        { "hebraico": "אֶת־", "transliteral": "ʾeṯ-", "traducao_palavra": "[objeto]" },
        { "hebraico": "אֲשֶׁ֣ר", "transliteral": "ʾă-šer", "traducao_palavra": "o que [está]" },
        { "hebraico": "לְפָנֶֽיךָ׃", "transliteral": "lə-p̄ā-ne-ḵā", "traducao_palavra": "diante de ti" }
      ]
    },
    "2": {
      "traducao_completa": "e põe uma faca à tua garganta, se és homem de grande apetite.",
      "palavras": [
        { "hebraico": "וְשַׂמְתָּ֣", "transliteral": "wə-śam-tā", "traducao_palavra": "e põe" },
        { "hebraico": "סַכִּ֣ין", "transliteral": "sak-kîn", "traducao_palavra": "uma faca" },
        { "hebraico": "בְּלֹעֶ֑ךָ", "transliteral": "bə-lō-ʿe-ḵā", "traducao_palavra": "na tua garganta" },
        { "hebraico": "אִם־", "transliteral": "ʾim-", "traducao_palavra": "se" },
        { "hebraico": "בַּ֖עַל", "transliteral": "ba-ʿal", "traducao_palavra": "[és] mestre de/dado a" },
        { "hebraico": "נֶ֣פֶשׁ", "transliteral": "ne-p̄eš", "traducao_palavra": "apetite/alma" },
        { "hebraico": "אָֽתָּה׃", "transliteral": "ʾāt-tā", "traducao_palavra": "tu" }
      ]
    },
    "3": {
      "traducao_completa": "Não cobices os seus manjares deleitosos, porque são pão de mentiras.",
      "palavras": [
        { "hebraico": "אַל־", "transliteral": "ʾal-", "traducao_palavra": "Não" },
        { "hebraico": "תִּ֭תְאָו", "transliteral": "tiṯ-ʾāw", "traducao_palavra": "cobices" },
        { "hebraico": "לְמַטְעַמֹּותָ֑יו", "transliteral": "lə-maṭ-ʿam-mô-ṯāyw", "traducao_palavra": "os seus manjares/delícias" },
        { "hebraico": "וְ֝ה֗וּא", "transliteral": "wə-hû", "traducao_palavra": "pois ele [é]" },
        { "hebraico": "לֶ֣חֶם", "transliteral": "le-ḥem", "traducao_palavra": "pão de" },
        { "hebraico": "כְּזָבִֽים׃", "transliteral": "kə-zā-ḇîm", "traducao_palavra": "mentiras/enganos" }
      ]
    },
    "4": {
      "traducao_completa": "Não te fatigues para enriquecer; e não apliques nisso a tua própria sabedoria.",
      "palavras": [
        { "hebraico": "אַל־", "transliteral": "ʾal-", "traducao_palavra": "Não" },
        { "hebraico": "תִּיגַ֥ע", "transliteral": "tî-ḡaʿ", "traducao_palavra": "te fatigues/trabalhes" },
        { "hebraico": "לְהַעֲשִׁ֑יר", "transliteral": "lə-ha-ʿă-šîr", "traducao_palavra": "para enriquecer" },
        { "hebraico": "מִֽבִּינָתְךָ֥", "transliteral": "mib-bî-nā-ṯə-ḵā", "traducao_palavra": "da tua própria inteligência" },
        { "hebraico": "חֲדָֽל׃", "transliteral": "ḥă-ḏāl", "traducao_palavra": "cessa/desiste" }
      ]
    },
    "5": {
      "traducao_completa": "Porventura fitarás os teus olhos naquilo que não é nada? Porque certamente a riqueza faz para si asas, como a águia que voa para o céu.",
      "palavras": [
        { "hebraico": "הֲתָ֤עִיף", "transliteral": "hă-ṯā-ʿîp̄", "traducao_palavra": "Acaso farás voar/fitarás" },
        { "hebraico": "עֵינֶ֨יךָ", "transliteral": "ʿê-ne-ḵā", "traducao_palavra": "teus olhos" },
        { "hebraico": "בֹּ֥ו", "transliteral": "bô", "traducao_palavra": "nele" },
        { "hebraico": "וְאֵינֶ֑נּוּ", "transliteral": "wə-ʾê-nen-nû", "traducao_palavra": "e ele não [é nada]" },
        { "hebraico": "כִּ֤י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "עָשֹׂ֨ה", "transliteral": "ʿā-śō", "traducao_palavra": "certamente" },
        { "hebraico": "יַעֲשֶׂה־", "transliteral": "ya-ʿă-śeh-", "traducao_palavra": "fará" },
        { "hebraico": "לֹּ֣ו", "transliteral": "lô", "traducao_palavra": "para si" },
        { "hebraico": "כְנָפַ֔יִם", "transliteral": "ḵə-nā-p̄a-yim", "traducao_palavra": "asas" },
        { "hebraico": "כְּנֶ֖שֶׁר", "transliteral": "kə-ne-šer", "traducao_palavra": "como águia" },
        { "hebraico": "יָע֥וּף", "transliteral": "yā-ʿûp̄", "traducao_palavra": "[que] voa" },
        { "hebraico": "הַשָּׁמָֽיִם׃", "transliteral": "haš-šā-mā-yim", "traducao_palavra": "[para] os céus" }
      ]
    },
    "6": {
      "traducao_completa": "Não comas o pão daquele que tem olhos invejosos, nem cobices os seus manjares deleitosos.",
      "palavras": [
        { "hebraico": "אַל־", "transliteral": "ʾal-", "traducao_palavra": "Não" },
        { "hebraico": "תִּלְחַ֗ם", "transliteral": "til-ḥam", "traducao_palavra": "comas" },
        { "hebraico": "אֶת־", "transliteral": "ʾeṯ-", "traducao_palavra": "[objeto]" },
        { "hebraico": "לֶ֭חֶם", "transliteral": "le-ḥem", "traducao_palavra": "o pão de" },
        { "hebraico": "רַ֣ע", "transliteral": "ra-", "traducao_palavra": "mau de" },
        { "hebraico": "עָ֑יִן", "transliteral": "ʿā-yin", "traducao_palavra": "olho [invejoso]" },
        { "hebraico": "וְאַל־", "transliteral": "wə-ʾal-", "traducao_palavra": "e não" },
        { "hebraico": "תִּ֝תְאָ֗ו", "transliteral": "tiṯ-ʾāw", "traducao_palavra": "cobices" },
        { "hebraico": "לְמַטְעַמֹּתָֽיו׃", "transliteral": "lə-maṭ-ʿam-mō-ṯāyw", "traducao_palavra": "seus manjares" }
      ]
    },
    "7": {
      "traducao_completa": "Porque, como imaginou no seu coração, assim ele é; come e bebe, te diz ele, mas o seu coração não está contigo.",
      "palavras": [
        { "hebraico": "כִּ֤י", "transliteral": "kî", "traducao_palavra": "Porque" },
        { "hebraico": "כְּמֹו־", "transliteral": "kə-mô-", "traducao_palavra": "como" },
        { "hebraico": "שָׁעַ֥ר", "transliteral": "šā-ʿar", "traducao_palavra": "calculou/imaginou" },
        { "hebraico": "בְּנַפְשֹׁ֗ו", "transliteral": "bə-nap̄-šô", "traducao_palavra": "em sua alma/coração" },
        { "hebraico": "כֶּן־", "transliteral": "ken-", "traducao_palavra": "assim [é]" },
        { "hebraico": "ה֫וּא", "transliteral": "hû", "traducao_palavra": "ele" },
        { "hebraico": "אֱ֘כֹ֤ל", "transliteral": "ʾĕ-ḵōl", "traducao_palavra": "come" },
        { "hebraico": "וּשְׁתֵ֨ה", "transliteral": "ū-šə-ṯēh", "traducao_palavra": "e bebe" },
        { "hebraico": "יֹ֣אמַר", "transliteral": "yō-mar", "traducao_palavra": "dirá" },
        { "hebraico": "לָ֑ךְ", "transliteral": "lāḵ", "traducao_palavra": "a ti" },
        { "hebraico": "וְ֝לִבֹּ֗ו", "transliteral": "wə-lib-bô", "traducao_palavra": "mas o coração dele" },
        { "hebraico": "בַּל־", "transliteral": "bal-", "traducao_palavra": "não [está]" },
        { "hebraico": "עִמָּֽךְ׃", "transliteral": "ʿim-māḵ", "traducao_palavra": "contigo" }
