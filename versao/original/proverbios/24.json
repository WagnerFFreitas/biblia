    "18": {
      "traducao_completa": "para que YHWH não o veja, e isso seja mau aos seus olhos, e desvie dele a sua ira.",
      "palavras": [
        { "hebraico": "פֶּן־יִרְאֶ֣ה", "transliteral": "pen-yir-ʾeh", "traducao_palavra": "para que não veja" },
        { "hebraico": "יְ֭הוָה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "וְרַ֣ע", "transliteral": "wə-raʿ", "traducao_palavra": "e seja mau" },
        { "hebraico": "בְּעֵינָ֑יו", "transliteral": "bə-ʿê-nāyw", "traducao_palavra": "aos olhos dele" },
        { "hebraico": "וְהֵשִׁ֖יב", "transliteral": "wə-hê-šîḇ", "traducao_palavra": "e ele desvie" },
        { "hebraico": "מֵעָלָ֣יו", "transliteral": "mē-ʿā-lāyw", "traducao_palavra": "de cima dele" },
        { "hebraico": "אַפֹּֽו׃", "transliteral": "ʾap-pô", "traducao_palavra": "sua ira" }
      ]
    },
    "19": {
      "traducao_completa": "Não te indignes por causa dos malfeitores, nem tenhas inveja dos ímpios;",
      "palavras": [
        { "hebraico": "אַל־תִּתְחַ֥ר", "transliteral": "ʾal-tiṯ-ḥar", "traducao_palavra": "Não te indignes/preocupes" },
        { "hebraico": "בַּמְּרֵעִ֑ים", "transliteral": "bam-mə-rē-ʿîm", "traducao_palavra": "com os malfeitores" },
        { "hebraico": "אַל־תְּ֝קַנֵּ֗א", "transliteral": "ʾal-tə-qan-nē", "traducao_palavra": "não tenhas inveja" },
        { "hebraico": "בָּרְשָׁעִֽים׃", "transliteral": "bā-rə-šā-ʿîm", "traducao_palavra": "dos ímpios" }
      ]
    },
    "20": {
      "traducao_completa": "porque não haverá futuro para o mau, e a lâmpada dos ímpios se apagará.",
