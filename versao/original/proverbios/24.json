        { "hebraico": "צַדִּ֬ique", "transliteral": "ṣad-dîq", "traducao_palavra": "justo" },
        { "hebraico": "אָ֗תָּה", "transliteral": "ʾāt-tā", "traducao_palavra": "[és] tu" },
        { "hebraico": "יִקְּבֻ֥הוּ", "transliteral": "yiq-qə-ḇu-hû", "traducao_palavra": "amaldiçoarão o" },
