        { "hebraico": "כֻלֹּ֨ו", "transliteral": "ḵul-lô", "traducao_palavra": "tudo nele" },
        { "hebraico": "קִמְּשֹׂנִ֗ים", "transliteral": "qim-mə-śō-nîm", "traducao_palavra": "espinhos" },
        { "hebraico": "כִּסּ֣וּ", "transliteral": "kis-sû", "traducao_palavra": "cobriram" },
        { "hebraico": "פָנָ֣יו", "transliteral": "p̄ā-nāyw", "traducao_palavra": "sua face/superfície" },
        { "hebraico": "חֲרֻלִּ֑ים", "transliteral": "ḥă-rul-lîm", "traducao_palavra": "urtigas" },
        { "hebraico": "וְגֶ֖דֶר", "transliteral": "wə-ḡe-ḏer", "traducao_palavra": "e o muro de" },
        { "hebraico": "אֲבָנָ֣יו", "transliteral": "ʾă-ḇā-nāyw", "traducao_palavra": "suas pedras" },
        { "hebraico": "נֶהֱרָֽסָה׃", "transliteral": "ne-hĕ-rā-śā", "traducao_palavra": "estava derrubado" }
      ]
    },
    "32": {
      "traducao_completa": "Vi isso, e meditei no meu coração; olhei, e recebi instrução.",
      "palavras": [
        { "hebraico": "וָֽאֶחֱזֶ֣ה", "transliteral": "wā-ʾe-ḥĕ-zeh", "traducao_palavra": "E vi" },
        { "hebraico": "אָ֭נִי", "transliteral": "ʾā-nî", "traducao_palavra": "eu" },
        { "hebraico": "אָשִׁ֣ית", "transliteral": "ā-šîṯ", "traducao_palavra": "pus/apliquei" },
        { "hebraico": "לִבִּ֑י", "transliteral": "lib-bî", "traducao_palavra": "meu coração" },
        { "hebraico": "רָ֝אִ֗יתִי", "transliteral": "rā-ʾî-ṯî", "traducao_palavra": "olhei/contemplei" },
        { "hebraico": "לָקַ֥חְתִּי", "transliteral": "lā-qaḥ-tî", "traducao_palavra": "[e] recebi" },
        { "hebraico": "מוּסָֽר׃", "transliteral": "mū-śār", "traducao_palavra": "instrução" }
      ]
    },
    "33": {
      "traducao_completa": "Um pouco de sono, um pouco de repouso, um pouco de cruzar de mãos para dormir,",
      "palavras": [
        { "hebraico": "מְעַ֣ט", "transliteral": "mə-ʿaṭ", "traducao_palavra": "Um pouco de" },
        { "hebraico": "שֵׁ֭נֹות", "transliteral": "šê-nôṯ", "traducao_palavra": "sono" },
        { "hebraico": "מְעַ֣ט", "transliteral": "mə-ʿaṭ", "traducao_palavra": "um pouco de" },
        { "hebraico": "תְּנוּמֹ֑ות", "transliteral": "tə-nū-môṯ", "traducao_palavra": "repouso" },
        { "hebraico": "מְעַ֓ט", "transliteral": "mə-ʿaṭ", "traducao_palavra": "um pouco de" },
        { "hebraico": "חִבֻּ֖ק", "transliteral": "ḥib-buq", "traducao_palavra": "abraçar/cruzar de" },
        { "hebraico": "יָדַ֣יִם", "transliteral": "yā-ḏa-yim", "traducao_palavra": "mãos" },
        { "hebraico": "לִשְׁכָּֽב׃", "transliteral": "liš-kāḇ", "traducao_palavra": "para deitar" }
      ]
    },
    "34": {
      "traducao_completa": "assim te sobrevirá a tua pobreza como um vagabundo, e a tua necessidade como um homem armado.",
      "palavras": [
        { "hebraico": "וּבָֽא־", "transliteral": "ū-ḇā-", "traducao_palavra": "E virá" },
        { "hebraico": "מִתְהַלֵּ֥ךְ", "transliteral": "miṯ-hal-lêḵ", "traducao_palavra": "[como] um caminhante/vagabundo" },
        { "hebraico": "רֵישֶׁ֑ךָ", "transliteral": "rê-še-ḵā", "traducao_palavra": "tua pobreza" },
