        { "hebraico": "בֵיתֶֽךָ׃", "transliteral": "ḇê-te-ḵā", "traducao_palavra": "tua casa" }
      ]
    },
    "28": {
      "traducao_completa": "Não sejas testemunha sem causa contra o teu próximo, nem enganes com os teus lábios.",
      "palavras": [
        { "hebraico": "אַל־תְּהִ֥י", "transliteral": "ʾal-tə-hî", "traducao_palavra": "Não sejas" },
