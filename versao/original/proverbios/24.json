        { "hebraico": "לֹא־תִהְיֶ֣ה", "transliteral": "lō-ṯih-yeh", "traducao_palavra": "não haverá" },
        { "hebraico": "אַחֲרִ֣ית", "transliteral": "ʾa-ḥă-rîṯ", "traducao_palavra": "futuro/recompensa" },
        { "hebraico": "לָרָ֑ע", "transliteral": "lā-rāʿ", "traducao_palavra": "para o mau" },
        { "hebraico": "נֵ֖ר", "transliteral": "nêr", "traducao_palavra": "[a] lâmpada de" },
        { "hebraico": "רְשָׁעִ֣ים", "transliteral": "rə-šā-ʿîm", "traducao_palavra": "ímpios" },
        { "hebraico": "יִדְעָֽךְ׃", "transliteral": "yiḏ-ʿāḵ", "traducao_palavra": "se apagará" }
      ]
    },
    "21": {
      "traducao_completa": "Teme a YHWH, filho meu, e ao rei; e não te envolvas com os que buscam mudanças.",
      "palavras": [
        { "hebraico": "יְרָֽא־", "transliteral": "yə-rā-", "traducao_palavra": "Teme" },
        { "hebraico": "אֶת־יְהוָ֣ה", "transliteral": "ʾeṯ-YHWH", "traducao_palavra": "a YHWH" },
        { "hebraico": "בְּנִ֣י", "transliteral": "bə-nî", "traducao_palavra": "filho meu" },
        { "hebraico": "וָמֶ֑לֶךְ", "transliteral": "wā-me-leḵ", "traducao_palavra": "e [ao] rei" },
        { "hebraico": "עִם־שֹׁ֝ונִים", "transliteral": "ʿim-šô-nîm", "traducao_palavra": "com os que mudam/rebeldes" },
