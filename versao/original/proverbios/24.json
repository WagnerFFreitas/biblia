        { "hebraico": "לָ֝אִ֗ישׁ", "transliteral": "lā-ʾîš", "traducao_palavra": "ao homem" },
        { "hebraico": "כְּפָעֳלֹֽו׃", "transliteral": "kə-p̄o-ʿo-lô", "traducao_palavra": "conforme sua obra" }
      ]
    },
    "30": {
      "traducao_completa": "Passei pelo campo do preguiçoso e junto à vinha do homem falto de entendimento;",
      "palavras": [
        { "hebraico": "עַל־שְׂדֵ֣ה", "transliteral": "ʿal-śə-ḏēh", "traducao_palavra": "Pelo campo de" },
