        { "hebraico": "יִנْعָ֑ם", "transliteral": "yin-ʿām", "traducao_palavra": "será agradável/haverá deleite" },
        { "hebraico": "וַ֝עֲלֵיהֶ֗ם", "transliteral": "wa-ʿă-lê-hem", "traducao_palavra": "e sobre eles" },
        { "hebraico": "תָּבֹ֥וא", "transliteral": "tā-ḇô", "traducao_palavra": "virá" },
