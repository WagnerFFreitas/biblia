      ]
    },
    "29": {
      "traducao_completa": "Não digas: Como ele me fez a mim, assim lhe farei a ele; pagarei ao homem segundo a sua obra.",
      "palavras": [
        { "hebraico": "אַל־תֹּאמַ֗ר", "transliteral": "ʾal-tō-mar", "traducao_palavra": "Não digas" },
        { "hebraico": "כַּאֲשֶׁ֣ר", "transliteral": "ka-ʾă-šer", "traducao_palavra": "conforme" },
