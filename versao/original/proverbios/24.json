        { "hebraico": "עָבַ֑רְתִּי", "transliteral": "ʿā-ḇar-tî", "traducao_palavra": "passei" },
        { "hebraico": "וְעַל־כֶּ֥֝רֶם", "transliteral": "wə-ʿal-ke-rem", "traducao_palavra": "e pela vinha de" },
        { "hebraico": "אָדָ֥ם", "transliteral": "ʾā-ḏām", "traducao_palavra": "um homem" },
        { "hebraico": "חֲסַר־לֵֽב׃", "transliteral": "ḥă-sar-lēḇ", "traducao_palavra": "falto de entendimento" }
      ]
    },
    "31": {
      "traducao_completa": "e eis que tudo estava cheio de espinhos, a sua superfície coberta de urtigas, e o seu muro de pedra estava derrubado.",
      "palavras": [
        { "hebraico": "וְ֝הִנֵּ֨ה", "transliteral": "wə-hin-nēh", "traducao_palavra": "e eis que" },
