      ]
    },
    "22": {
      "traducao_completa": "porque de repente se levantará a sua destruição, e a ruína de ambos, quem a conhecerá?",
      "palavras": [
        { "hebraico": "כִּֽי־פִ֭תְאֹם", "transliteral": "kî-p̄iṯ-ʾōm", "traducao_palavra": "porque de repente" },
        { "hebraico": "יָק֣וּם", "transliteral": "yā-qûm", "traducao_palavra": "se levantará" },
        { "hebraico": "אֵידָ֑ם", "transliteral": "ʾê-ḏām", "traducao_palavra": "a destruição deles" },
        { "hebraico": "וּפִ֥id", "transliteral": "ū-p̄îḏ", "traducao_palavra": "e a ruína de" },
        { "hebraico": "שְׁ֝נֵיהֶ֗ם", "transliteral": "šə-nê-hem", "traducao_palavra": "ambos eles" },
        { "hebraico": "מִ֣י", "transliteral": "mî", "traducao_palavra": "quem" },
        { "hebraico": "יֹודֵֽעַ׃", "transliteral": "yô-ḏê-aʿ", "traducao_palavra": "conhece?" }
      ]
    },
    "23": {
      "traducao_completa": "Também estes provérbios pertencem aos sábios: Ter respeito a pessoas no julgamento não é bom.",
      "palavras": [
        { "hebraico": "גַּם־אֵ֥לֶּה", "transliteral": "gam-ʾēl-leh", "traducao_palavra": "Também estes" },
        { "hebraico": "לַֽחֲכָמִ֑ים", "transliteral": "la-ḥă-ḵā-mîm", "traducao_palavra": "[são] para os sábios" },
        { "hebraico": "הַֽכֵּר־פָּנִ֖ים", "transliteral": "hak-kêr-pā-nîm", "traducao_palavra": "reconhecer faces [parcialidade]" },
        { "hebraico": "בְּמִשְׁפָּ֣ט", "transliteral": "bə-miš-pāṭ", "traducao_palavra": "em juízo" },
        { "hebraico": "בַל־טֹֽוב׃", "transliteral": "bal-ṭôḇ", "traducao_palavra": "não é bom" }
      ]
    },
    "24": {
      "traducao_completa": "Ao que disser ao ímpio: Tu és justo, os povos o amaldiçoarão, as nações o detestarão.",
      "palavras": [
        { "hebraico": "אֹ֘מֵ֤ר", "transliteral": "ʾō-mêr", "traducao_palavra": "O que diz" },
