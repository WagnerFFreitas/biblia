      ]
    },
    "16": {
      "traducao_completa": "Derrame-se-iam as tuas fontes para fora, e pelas ruas os ribeiros de águas?",
      "palavras": [
        { "hebraico": "יָפ֭וּצוּ", "transliteral": "yā-p̄û-ṣû", "traducao_palavra": "espalhem-se/derramem-se" },
        { "hebraico": "מַעְיְנֹתֶ֣יךָ", "transliteral": "maʿ-yə-nō-ṯê-ḵā", "traducao_palavra": "tuas fontes" },
        { "hebraico": "ח֑וּצָה", "transliteral": "ḥû-ṣā", "traducao_palavra": "para fora" },
