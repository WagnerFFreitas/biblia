        { "hebraico": "אַיֶּ֤לֶת", "transliteral": "ʾay-ye-leṯ", "traducao_palavra": "serva/corça" },
        { "hebraico": "אֲהָבִ֨ים", "transliteral": "ʾă-hā-ḇîm", "traducao_palavra": "de amores" },
        { "hebraico": "וְיַֽעֲלַת־", "transliteral": "wə-ya-ʿă-laṯ-", "traducao_palavra": "e gazela de" },
        { "hebraico": "חֵ֗ן", "transliteral": "ḥên", "traducao_palavra": "graça" },
        { "hebraico": "דַּ֭דֶּיהָ", "transliteral": "dad-de-yā", "traducao_palavra": "os seios dela" },
