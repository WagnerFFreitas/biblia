      ]
    },
    "9": {
      "traducao_completa": "para que não dês a outros a tua honra, nem os teus anos a cruéis;",
      "palavras": [
        { "hebraico": "פֶּן־תִּתֵּ֣ן", "transliteral": "pen-tit-tên", "traducao_palavra": "para que não dês" },
