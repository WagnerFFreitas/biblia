        { "hebraico": "יִֽהְיוּ־", "transliteral": "yih-yû-", "traducao_palavra": "sejam" },
        { "hebraico": "לְךָ֥", "transliteral": "lə-ḵā", "traducao_palavra": "para ti" },
        { "hebraico": "לְבַדֶּ֑ךָ", "transliteral": "lə-ḇad-de-ḵā", "traducao_palavra": "somente" },
