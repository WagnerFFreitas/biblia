        { "hebraico": "לְ֝זָרִ֗ים", "transliteral": "lə-zā-rîm", "traducao_palavra": "para estranhos" },
        { "hebraico": "אִתָּֽךְ׃", "transliteral": "ʾit-tāḵ", "traducao_palavra": "contigo" }
      ]
    },
    "18": {
      "traducao_completa": "Seja bendito o teu manancial, e alegra-te com a mulher da tua mocidade.",
      "palavras": [
        { "hebraico": "יְהִֽי־", "transliteral": "yə-hî-", "traducao_palavra": "seja" },
        { "hebraico": "מְקֹורְךָ֥", "transliteral": "mə-qôr-ḵā", "traducao_palavra": "teu manancial/fonte" },
