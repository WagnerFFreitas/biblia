{
  "livro": "Provérbios - מִשְׁלֵי - Mishlei",
  "capítulo": 5,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Filho meu, atenta para a minha sabedoria; inclina o teu ouvido ao meu entendimento;",
      "palavras": [
        { "hebraico": "בְּ֭נִי", "transliteral": "bə-nî", "traducao_palavra": "filho meu" },
        { "hebraico": "לְחָכְמָתִ֣י", "transliteral": "lə-ḥā-ḵə-mā-ṯî", "traducao_palavra": "para minha sabedoria" },
        { "hebraico": "הַקְשִׁ֑יבָה", "transliteral": "haq-šî-ḇā", "traducao_palavra": "atenta" },
        { "hebraico": "לִ֝תְבוּנָתִ֗י", "transliteral": "liṯ-ḇû-nā-ṯî", "traducao_palavra": "ao meu entendimento" },
        { "hebraico": "הַט־", "transliteral": "haṭ-", "traducao_palavra": "inclina" },
        { "hebraico": "אָזְנֶֽךָ׃", "transliteral": "ʾāz-ne-ḵā", "traducao_palavra": "teu ouvido" }
      ]
    },
    "2": {
      "traducao_completa": "para que guardes a discrição, e os teus lábios preservem o conhecimento.",
      "palavras": [
        { "hebraico": "לִשְׁמֹ֥ר", "transliteral": "liš-mōr", "traducao_palavra": "para guardar" },
        { "hebraico": "מְזִמֹּ֑ות", "transliteral": "mə-zim-môṯ", "traducao_palavra": "discrição/siso" },
        { "hebraico": "וְ֝דַ֗עַת", "transliteral": "wə-ḏa-ʿaṯ", "traducao_palavra": "e conhecimento" },
        { "hebraico": "שְׂפָתֶ֥יךָ", "transliteral": "śə-p̄ā-ṯe-ḵā", "traducao_palavra": "teus lábios" },
        { "hebraico": "יִנְצֹֽרוּ׃", "transliteral": "yin-ṣō-rû", "traducao_palavra": "preservem" }
      ]
    },
    "3": {
      "traducao_completa": "Porque os lábios da mulher estranha destilam favos de mel, e o seu paladar é mais suave do que o azeite;",
      "palavras": [
        { "hebraico": "כִּ֤י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "נֹ֣פֶת", "transliteral": "nō-p̄eṯ", "traducao_palavra": "favos de mel" },
        { "hebraico": "תִּטֹּ֣פְנָה", "transliteral": "tiṭ-ṭō-p̄ə-nā", "traducao_palavra": "destilam" },
        { "hebraico": "שִׂפְתֵ֣י", "transliteral": "śip̄-ṯê", "traducao_palavra": "lábios de" },
        { "hebraico": "זָרָ֑ה", "transliteral": "zā-rā", "traducao_palavra": "estranha" },
        { "hebraico": "וְחָלָ֖ק", "transliteral": "wə-ḥā-lāq", "traducao_palavra": "e mais suave" },
        { "hebraico": "מִשֶּׁ֣מֶן", "transliteral": "miš-še-men", "traducao_palavra": "que o azeite" },
        { "hebraico": "חִכָּֽהּ׃", "transliteral": "ḥik-kāh", "traducao_palavra": "seu paladar/garganta" }
      ]
    },
    "4": {
      "traducao_completa": "mas o seu fim é amargoso como o absinto, agudo como a espada de dois gumes.",
      "palavras": [
        { "hebraico": "וְֽאַחֲרִיתָ֗הּ", "transliteral": "wə-ʾa-ḥă-rî-ṯāh", "traducao_palavra": "mas o seu fim/posteridade" },
        { "hebraico": "מָרָ֥ה", "transliteral": "mā-rā", "traducao_palavra": "amarga [é]" },
        { "hebraico": "כַֽלַּעֲנָ֑ה", "transliteral": "ḵal-la-ʿă-nā", "traducao_palavra": "como absinto" },
        { "hebraico": "חַדָּ֗ה", "transliteral": "ḥad-dā", "traducao_palavra": "aguda" },
        { "hebraico": "כְּחֶ֣רֶב", "transliteral": "kə-ḥe-reḇ", "traducao_palavra": "como espada de" },
        { "hebraico": "פִּיֹּֽות׃", "transliteral": "pî-yôṯ", "traducao_palavra": "bocas [gumes]" }
      ]
    },
    "5": {
      "traducao_completa": "Os seus pés descem à morte; os seus passos firmam-se no Seol.",
      "palavras": [
        { "hebraico": "רַ֭גְלֶיהָ", "transliteral": "raḡ-le-yā", "traducao_palavra": "pés dela" },
        { "hebraico": "יֹרְדֹ֣ות", "transliteral": "yō-rə-ḏôṯ", "traducao_palavra": "descendo" },
        { "hebraico": "מָ֑וֶת", "transliteral": "mā-weṯ", "traducao_palavra": "[à] morte" },
        { "hebraico": "שְׁ֝אֹ֗ול", "transliteral": "šə-ʾôl", "traducao_palavra": "[no] Seol" },
        { "hebraico": "צְעָדֶ֥יהָ", "transliteral": "ṣə-ʿā-ḏe-yā", "traducao_palavra": "passos dela" },
        { "hebraico": "יִתְמֹֽכוּ׃", "transliteral": "yiṯ-mō-ḵû", "traducao_palavra": "firmam/agarram" }
      ]
    },
    "6": {
      "traducao_completa": "Para que não ponderes a vereda da vida, os seus caminhos são instáveis, e tu não o sabes.",
      "palavras": [
        { "hebraico": "אֹ֣רַח", "transliteral": "ʾō-raḥ", "traducao_palavra": "vereda de" },
        { "hebraico": "חַ֭יִּים", "transliteral": "ḥay-yîm", "traducao_palavra": "vida" },
        { "hebraico": "פֶּן־תְּפַלֵּ֑ס", "transliteral": "pen-tə-p̄al-lês", "traducao_palavra": "para que não ponderes" },
        { "hebraico": "נָע֥וּ", "transliteral": "nā-ʿû", "traducao_palavra": "vagueiam/são instáveis" },
        { "hebraico": "מַעְגְּלֹתֶ֗יהָ", "transliteral": "maʿ-gə-lō-ṯe-yā", "traducao_palavra": "caminhos dela" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "תֵדָֽע׃", "transliteral": "ṯê-ḏāʿ", "traducao_palavra": "sabes" }
      ]
    },
    "7": {
      "traducao_completa": "Agora, pois, filhos, ouvi-me e não vos desvieis das palavras da minha boca.",
      "palavras": [
        { "hebraico": "וְעַתָּ֣ה", "transliteral": "wə-ʿat-tā", "traducao_palavra": "e agora" },
        { "hebraico": "בָ֭נִים", "transliteral": "ḇā-nîm", "traducao_palavra": "filhos" },
        { "hebraico": "שִׁמְעוּ־לִ֑י", "transliteral": "šim-ʿû-lî", "traducao_palavra": "ouvi-me" },
        { "hebraico": "וְאַל־תָּ֝ס֗וּרוּ", "transliteral": "wə-ʾal-tā-śû-rû", "traducao_palavra": "e não vos desvieis" },
        { "hebraico": "מֵאִמְרֵי־", "transliteral": "mê-ʾim-rê-", "traducao_palavra": "das palavras de" },
        { "hebraico": "פִֽי׃", "transliteral": "p̄î", "traducao_palavra": "minha boca" }
      ]
    },
    "8": {
      "traducao_completa": "Afasta para longe dela o teu caminho, e não te aproximes da porta da sua casa;",
      "palavras": [
        { "hebraico": "הַרְחֵ֣ק", "transliteral": "har-ḥêq", "traducao_palavra": "afasta" },
        { "hebraico": "מֵעָלֶ֣יהָ", "transliteral": "mê-ʿā-le-yā", "traducao_palavra": "de sobre ela/para longe dela" },
        { "hebraico": "דַּרְכֶּ֑ךָ", "transliteral": "ḏar-ke-ḵā", "traducao_palavra": "teu caminho" },
        { "hebraico": "וְאַל־תִּ֝קְרַ֗ב", "transliteral": "wə-ʾal-tiq-raḇ", "traducao_palavra": "e não te aproximes" },
        { "hebraico": "אֶל־פֶּ֥תַח", "transliteral": "ʾel-pe-ṯaḥ", "traducao_palavra": "à porta de" },
