        { "hebraico": "אָזְנִֽי׃", "transliteral": "ʾāz-nî", "traducao_palavra": "meu ouvido" }
      ]
    },
    "14": {
      "traducao_completa": "No meio da assembleia e da congregação quase cheguei ao cúmulo do mal.",
      "palavras": [
        { "hebraico": "כִּמְעַ֭ט", "transliteral": "kim-ʿaṭ", "traducao_palavra": "quase" },
        { "hebraico": "הָיִ֣יתִי", "transliteral": "hā-yî-ṯî", "traducao_palavra": "estive/fui" },
