        { "hebraico": "הֹודֶ֑ךָ", "transliteral": "hō-ḏe-ḵā", "traducao_palavra": "tua honra/esplendor" },
        { "hebraico": "וּשְׁנֹתֶ֗יךָ", "transliteral": "ū-šə-nō-ṯê-ḵā", "traducao_palavra": "e teus anos" },
        { "hebraico": "לְאַכְזָרִֽי׃", "transliteral": "lə-ʾaḵ-zā-rî", "traducao_palavra": "ao cruel" }
      ]
    },
    "10": {
      "traducao_completa": "para que não se fartem os estranhos com os teus bens, e o fruto do teu trabalho vá para a casa do estrangeiro;",
      "palavras": [
        { "hebraico": "פֶּן־יִשְׂבְּע֣וּ", "transliteral": "pen-yiś-bə-ʿû", "traducao_palavra": "para que não se fartem" },
        { "hebraico": "זָרִ֣ים", "transliteral": "zā-rîm", "traducao_palavra": "estranhos" },
        { "hebraico": "כֹּחֶ֑ךָ", "transliteral": "kō-ḥe-ḵā", "traducao_palavra": "[com] tua força/bens" },
        { "hebraico": "וַ֝עֲצָבֶ֗יךָ", "transliteral": "wa-ʿă-ṣā-ḇê-ḵā", "traducao_palavra": "e teus trabalhos/fadigas" },
        { "hebraico": "בְּבֵ֣ית", "transliteral": "bə-ḇêṯ", "traducao_palavra": "na casa de" },
        { "hebraico": "נָכְרִֽי׃", "transliteral": "nā-ḵə-rî", "traducao_palavra": "estrangeiro" }
      ]
    },
    "11": {
      "traducao_completa": "e gemas no teu fim, quando se consumirem a tua carne e o teu corpo,",
      "palavras": [
        { "hebraico": "וְנָהַמְתָּ֥", "transliteral": "wə-nā-ham-tā", "traducao_palavra": "e gemas/rujas" },
        { "hebraico": "בְּאַחֲרִיתֶ֑ךָ", "transliteral": "bə-ʾa-ḥă-rî-ṯe-ḵā", "traducao_palavra": "no teu fim" },
        { "hebraico": "בִּכְלֹ֥ות", "transliteral": "biḵ-lôṯ", "traducao_palavra": "no consumir-se de" },
        { "hebraico": "בְּשָׂרְךָ֗", "transliteral": "bə-śā-rə-ḵā", "traducao_palavra": "tua carne" },
        { "hebraico": "וּשְׁאֵרֶֽךָ׃", "transliteral": "ū-šə-ʾê-re-ḵā", "traducao_palavra": "e teu corpo" }
      ]
    },
    "12": {
      "traducao_completa": "e digas: Como odiei a correção, e o meu coração desprezou a repreensão!",
      "palavras": [
        { "hebraico": "וְאָמַרְתָּ֗", "transliteral": "wə-ʾā-mar-tā", "traducao_palavra": "e dirás" },
        { "hebraico": "אֵ֣יךְ", "transliteral": "ʾêḵ", "traducao_palavra": "como" },
        { "hebraico": "שָׂנֵ֣אתִי", "transliteral": "śā-nê-ṯî", "traducao_palavra": "odiei" },
        { "hebraico": "מוּסָ֑ר", "transliteral": "mū-sār", "traducao_palavra": "correção/instrução" },
        { "hebraico": "וְ֝תֹוכַ֗חַת", "transliteral": "wə-ṯô-ḵa-ḥaṯ", "traducao_palavra": "e repreensão" },
        { "hebraico": "נָאַ֥ץ", "transliteral": "nā-ʾaṣ", "traducao_palavra": "desprezou" },
        { "hebraico": "לִבִּֽי׃", "transliteral": "lib-bî", "traducao_palavra": "meu coração" }
      ]
    },
    "13": {
      "traducao_completa": "E não ouvi a voz dos que me ensinavam, nem aos meus mestres inclinei o meu ouvido!",
      "palavras": [
        { "hebraico": "וְלֹא־שָׁ֭מַעְתִּי", "transliteral": "wə-lō-šā-maʿ-tî", "traducao_palavra": "e não ouvi" },
        { "hebraico": "בְּקֹ֣ול", "transliteral": "bə-qôl", "traducao_palavra": "a voz de" },
        { "hebraico": "מֹורָ֑י", "transliteral": "mô-rāy", "traducao_palavra": "meus mestres" },
        { "hebraico": "וְ֝לִֽמְלַמְּדַ֗י", "transliteral": "wə-lim-lam-mə-ḏay", "traducao_palavra": "e aos que me ensinavam" },
