      ]
    },
    "14": {
      "traducao_completa": "É como os navios do mercador; de longe traz o seu pão.",
      "palavras": [
        { "hebraico": "הָ֭יְתָה", "transliteral": "hā-yə-ṯā", "traducao_palavra": "Ela é" },
