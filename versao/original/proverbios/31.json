        { "hebraico": "זָמְמָ֣ה", "transliteral": "zā-mə-mā", "traducao_palavra": "Considerou/planejou" },
        { "hebraico": "שָׂ֭דֶה", "transliteral": "śā-ḏeh", "traducao_palavra": "[um] campo" },
        { "hebraico": "וַתִּקָּחֵ֑הוּ", "transliteral": "wat-tiq-qā-ḥê-hû", "traducao_palavra": "e adquiriu-o" },
        { "hebraico": "מִפְּרִ֥י", "transliteral": "mip-pə-rî", "traducao_palavra": "do fruto de" },
        { "hebraico": "כַ֝פֶּ֗יהָ", "transliteral": "kap-pe-hā", "traducao_palavra": "suas mãos" },
        { "hebraico": "נטע", "transliteral": "nā-ṭā", "traducao_palavra": "plantou" },
        { "hebraico": "כֶּֽרֶם׃", "transliteral": "ke-rem", "traducao_palavra": "[uma] vinha" }
      ]
    },
    "17": {
      "traducao_completa": "Cinge os seus lombos de força e fortalece os seus braços.",
