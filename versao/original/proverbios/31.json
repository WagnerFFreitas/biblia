      ]
    },
    "11": {
      "traducao_completa": "O coração do seu marido confia nela, e não lhe faltará despojo.",
      "palavras": [
        { "hebraico": "בָּ֣טַח", "transliteral": "bā-ṭaḥ", "traducao_palavra": "Confia" },
        { "hebraico": "בָּ֭הּ", "transliteral": "bāh", "traducao_palavra": "nela" },
        { "hebraico": "לֵ֣ב", "transliteral": "lēḇ", "traducao_palavra": "[o] coração de" },
        { "hebraico": "בַּעְלָ֑הּ", "transliteral": "ba-ʿə-lāh", "traducao_palavra": "seu marido" },
        { "hebraico": "וְ֝שָׁלָ֗ל", "transliteral": "wə-šā-lāl", "traducao_palavra": "e despojo/ganho" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "יֶחְסָֽר׃", "transliteral": "yeḥ-śār", "traducao_palavra": "faltará" }
      ]
    },
    "12": {
      "traducao_completa": "Ela lhe faz bem e não mal, todos os dias da sua vida.",
      "palavras": [
        { "hebraico": "גְּמָלַ֥תְהוּ", "transliteral": "gə-mā-laṯ-hû", "traducao_palavra": "Ela retribui a ele" },
        { "hebraico": "טֹּֽוב", "transliteral": "ṭôḇ", "traducao_palavra": "bem" },
        { "hebraico": "וְלֹא־", "transliteral": "wə-lō-", "traducao_palavra": "e não" },
        { "hebraico": "רָ֑ע", "transliteral": "rāʿ", "traducao_palavra": "mal" },
        { "hebraico": "כֹּ֝ל", "transliteral": "kōl", "traducao_palavra": "todos" },
        { "hebraico": "יְמֵ֣י", "transliteral": "yə-mê", "traducao_palavra": "os dias de" },
        { "hebraico": "חַיֶּֽיהָ׃", "transliteral": "ḥay-ye-hā", "traducao_palavra": "sua vida" }
      ]
    },
    "13": {
      "traducao_completa": "Busca lã e linho e trabalha de boa vontade com as suas mãos.",
      "palavras": [
        { "hebraico": "דָּ֭רְשָׁה", "transliteral": "dā-rə-šā", "traducao_palavra": "Buscou" },
        { "hebraico": "צֶ֣מֶר", "transliteral": "ṣe-mer", "traducao_palavra": "lã" },
        { "hebraico": "וּפִשְׁתִּ֑ים", "transliteral": "ū-p̄iš-tîm", "traducao_palavra": "e linho" },
        { "hebraico": "וַ֝תַּ֗עַשׂ", "transliteral": "wat-ta-ʿaś", "traducao_palavra": "e trabalhou" },
        { "hebraico": "בְּחֵ֣פֶץ", "transliteral": "bə-ḥê-p̄eṣ", "traducao_palavra": "com o prazer de" },
