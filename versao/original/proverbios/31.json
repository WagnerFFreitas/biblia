{
  "livro": "Provérbios - מִשְׁלֵי - Mishlei",
  "capítulo": 31,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Palavras do rei Lemuel, o oráculo que lhe ensinou sua mãe:",
      "palavras": [
        { "hebraico": "דִּבְרֵ֬י", "transliteral": "diḇ-rê", "traducao_palavra": "Palavras de" },
        { "hebraico": "לְמוּאֵ֨ל", "transliteral": "lə-mû-ʾêl", "traducao_palavra": "Lemuel" },
        { "hebraico": "מֶ֥לֶךְ", "transliteral": "me-leḵ", "traducao_palavra": "[o] rei" },
        { "hebraico": "מַשָּׂ֑א", "transliteral": "maś-śā", "traducao_palavra": "[o] oráculo/profecia" },
        { "hebraico": "אֲשֶׁר־", "transliteral": "ʾă-šer-", "traducao_palavra": "que" },
        { "hebraico": "יִסְּרַ֥תּוּ", "transliteral": "yis-śə-rat-tû", "traducao_palavra": "ensinou-lhe/corrigiu-o" },
        { "hebraico": "אִמֹּֽו׃", "transliteral": "ʾim-mô", "traducao_palavra": "sua mãe" }
      ]
    },
    "2": {
      "traducao_completa": "Que há, filho meu? E que há, filho do meu ventre? E que há, filho dos meus votos?",
      "palavras": [
        { "hebraico": "מַה־", "transliteral": "mah-", "traducao_palavra": "O que [há]" },
        { "hebraico": "בְּ֭נִי", "transliteral": "bə-nî", "traducao_palavra": "filho meu?" },
        { "hebraico": "וּמַֽה־", "transliteral": "ū-mah-", "traducao_palavra": "e o que [há]" },
        { "hebraico": "בֶּן־", "transliteral": "ben-", "traducao_palavra": "filho de" },
        { "hebraico": "בִּטְנִ֑י", "transliteral": "biṭ-nî", "traducao_palavra": "meu ventre?" },
        { "hebraico": "וּ֝מֶה", "transliteral": "ū-meh", "traducao_palavra": "e o que [há]" },
        { "hebraico": "בֶּן־", "transliteral": "ben-", "traducao_palavra": "filho de" },
        { "hebraico": "נְדָרָֽי׃", "transliteral": "nə-ḏā-rāy", "traducao_palavra": "meus votos?" }
      ]
    },
    "3": {
      "traducao_completa": "Não dês às mulheres a tua força, nem os teus caminhos ao que destrói os reis.",
      "palavras": [
        { "hebraico": "אַל־", "transliteral": "ʾal-", "traducao_palavra": "Não" },
        { "hebraico": "תִּתֵּ֣ן", "transliteral": "tit-tên", "traducao_palavra": "dês" },
        { "hebraico": "לַנָּשִׁ֣ים", "transliteral": "lan-nā-šîm", "traducao_palavra": "às mulheres" },
        { "hebraico": "חֵילֶ֑ךָ", "transliteral": "ḥê-le-ḵā", "traducao_palavra": "tua força" },
        { "hebraico": "וּ֝דְרָכֶ֗יךָ", "transliteral": "ū-ḏə-rā-ḵe-y-ḵā", "traducao_palavra": "e teus caminhos" },
        { "hebraico": "לַֽמְחֹ֥ות", "transliteral": "lam-ḥôṯ", "traducao_palavra": "para destruir" },
        { "hebraico": "מְלָכִֽין׃", "transliteral": "mə-lā-ḵîn", "traducao_palavra": "[os] reis" }
      ]
    },
    "4": {
      "traducao_completa": "Não é próprio dos reis, ó Lemuel, não é próprio dos reis beber vinho, nem dos príncipes desejar bebida forte.",
      "palavras": [
        { "hebraico": "אַ֤ל", "transliteral": "ʾal", "traducao_palavra": "Não [é]" },
        { "hebraico": "לַֽמְלָכִ֨ים", "transliteral": "lam-lā-ḵîm", "traducao_palavra": "para os reis" },
        { "hebraico": "לְמוּאֵ֗ל", "transliteral": "lə-mû-ʾêl", "traducao_palavra": "ó Lemuel" },
        { "hebraico": "אַ֣ל", "transliteral": "ʾal", "traducao_palavra": "não [é]" },
        { "hebraico": "לַֽמְלָכִ֣ים", "transliteral": "lam-lā-ḵîm", "traducao_palavra": "para os reis" },
        { "hebraico": "שְׁתֹו־", "transliteral": "šə-ṯô-", "traducao_palavra": "beber" },
        { "hebraico": "יָ֑יִן", "transliteral": "yā-yin", "traducao_palavra": "vinho" },
        { "hebraico": "וּ֝לְרֹוזְנִ֗ים", "transliteral": "ū-lə-rô-zə-nîm", "traducao_palavra": "e para os príncipes" },
        { "hebraico": "אֹ֣וי", "transliteral": "ʾôy", "traducao_palavra": "onde [está/desejar]" },
        { "hebraico": "שֵׁכָֽר׃", "transliteral": "šē-ḵār", "traducao_palavra": "bebida forte" }
      ]
    },
    "5": {
      "traducao_completa": "Para que não bebam e se esqueçam da lei, e pervertam o direito de todos os aflitos.",
      "palavras": [
        { "hebraico": "פֶּן־", "transliteral": "pen-", "traducao_palavra": "Para que não" },
        { "hebraico": "יִ֭שְׁתֶּה", "transliteral": "yiš-teh", "traducao_palavra": "beba" },
        { "hebraico": "וְיִשְׁכַּ֣ח", "transliteral": "wə-yiš-kaḥ", "traducao_palavra": "e esqueça" },
        { "hebraico": "מְחֻקָּ֑ק", "transliteral": "mə-ḥuq-qāq", "traducao_palavra": "[o que está] decretado/lei" },
        { "hebraico": "וִֽ֝ישַׁנֶּ֗ה", "transliteral": "wî-šan-neh", "traducao_palavra": "e mude/perverta" },
        { "hebraico": "דִּ֣ין", "transliteral": "ḏîn", "traducao_palavra": "[o] juízo de" },
        { "hebraico": "כָּל־", "transliteral": "kāl-", "traducao_palavra": "todos" },
        { "hebraico": "בְּנֵי־", "transliteral": "bə-nê-", "traducao_palavra": "filhos de" },
        { "hebraico": "עֹֽנִי׃", "transliteral": "ʿō-nî", "traducao_palavra": "aflição" }
      ]
    },
    "6": {
      "traducao_completa": "Dai bebida forte ao que está prestes a perecer, e vinho aos amargurados de espírito.",
      "palavras": [
        { "hebraico": "תְּנוּ־", "transliteral": "tə-nû-", "traducao_palavra": "Dai" },
        { "hebraico": "שֵׁכָ֣ר", "transliteral": "šē-ḵār", "traducao_palavra": "bebida forte" },
        { "hebraico": "לְאֹובֵ֑ד", "transliteral": "lə-ʾô-ḇêḏ", "traducao_palavra": "ao que perece" },
        { "hebraico": "וְ֝יַיִן", "transliteral": "wə-ya-yin", "traducao_palavra": "e vinho" },
        { "hebraico": "לְמָ֣רֵי", "transliteral": "lə-mā-rê", "traducao_palavra": "para os amargos de" },
        { "hebraico": "נָֽפֶשׁ׃", "transliteral": "nā-p̄eš", "traducao_palavra": "alma/espírito" }
      ]
    },
    "7": {
      "traducao_completa": "Que beba, e se esqueça da sua pobreza, e da sua fadiga não se lembre mais.",
      "palavras": [
        { "hebraico": "יִ֭שְׁתֶּה", "transliteral": "yiš-teh", "traducao_palavra": "Que beba" },
        { "hebraico": "וְיִשְׁכַּ֣ח", "transliteral": "wə-yiš-kaḥ", "traducao_palavra": "e esqueça" },
        { "hebraico": "רִישֹׁ֑ו", "transliteral": "rî-šô", "traducao_palavra": "sua pobreza" },
        { "hebraico": "וַ֝עֲמָלֹ֗ו", "transliteral": "wa-ʿă-mā-lô", "traducao_palavra": "e seu trabalho/sofrimento" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "יִזְכָּר־", "transliteral": "yiz-kōr-", "traducao_palavra": "se lembrará" },
        { "hebraico": "עֹוד׃", "transliteral": "ʿôḏ", "traducao_palavra": "mais" }
      ]
    },
    "8": {
      "traducao_completa": "Abre a tua boca a favor do mudo, pelo direito de todos os que estão desamparados.",
      "palavras": [
        { "hebraico": "פְּקַח־", "transliteral": "pə-qaḥ-", "traducao_palavra": "Abre" },
        { "hebraico": "פִּ֥יךָ", "transliteral": "pî-ḵā", "traducao_palavra": "tua boca" },
        { "hebraico": "לְאִלֵּ֑ם", "transliteral": "lə-ʾil-lêm", "traducao_palavra": "para o mudo" },
        { "hebraico": "אֶל־", "transliteral": "ʾel-", "traducao_palavra": "para" },
        { "hebraico": "דִּ֝ין", "transliteral": "ḏîn", "traducao_palavra": "[o] juízo/direito de" },
        { "hebraico": "כָּל־", "transliteral": "kāl-", "traducao_palavra": "todos" },
        { "hebraico": "בְּנֵי", "transliteral": "bə-nê", "traducao_palavra": "filhos de" },
        { "hebraico": "חֲלֹֽוף׃", "transliteral": "ḥă-lôp̄", "traducao_palavra": "passagem/desamparo" }
      ]
    },
    "9": {
      "traducao_completa": "Abre a tua boca, julga retamente e faze justiça aos pobres e aos necessitados.",
      "palavras": [
        { "hebraico": "פְּקַח־", "transliteral": "pə-qaḥ-", "traducao_palavra": "Abre" },
        { "hebraico": "פִּ֥יךָ", "transliteral": "pî-ḵā", "traducao_palavra": "tua boca" },
        { "hebraico": "שְׁפָט־", "transliteral": "šə-p̄āṭ-", "traducao_palavra": "julga" },
        { "hebraico": "צֶ֑דֶק", "transliteral": "ṣe-ḏeq", "traducao_palavra": "justiça/retamente" },
        { "hebraico": "וְ֝דִ֗ין", "transliteral": "wə-ḏîn", "traducao_palavra": "e faze justiça a" },
        { "hebraico": "עָנִ֥י", "transliteral": "ʿā-nî", "traducao_palavra": "[o] pobre" },
        { "hebraico": "וְאֶבְיֹֽון׃", "transliteral": "wə-ʾeḇ-yôn", "traducao_palavra": "e necessitado" }
      ]
    },
    "10": {
      "traducao_completa": "Mulher virtuosa, quem a achará? O seu valor muito excede ao de rubis.",
      "palavras": [
        { "hebraico": "אֵֽשֶׁת־", "transliteral": "ʾē-šeṯ-", "traducao_palavra": "Mulher de" },
        { "hebraico": "חַ֭יִל", "transliteral": "ḥa-yil", "traducao_palavra": "valor/virtude" },
        { "hebraico": "מִ֣י", "transliteral": "mî", "traducao_palavra": "quem" },
        { "hebraico": "יִמְצָ֑א", "transliteral": "yim-ṣā", "traducao_palavra": "achará?" },
        { "hebraico": "וְרָחֹ֥ק", "transliteral": "wə-rā-ḥōq", "traducao_palavra": "e longe/muito além" },
        { "hebraico": "מִפְּנִינִ֥ים", "transliteral": "mip-pə-nî-nîm", "traducao_palavra": "de rubis/pérolas" },
