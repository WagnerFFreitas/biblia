        { "hebraico": "חָגְרָ֣ה", "transliteral": "ḥā-ḡə-rā", "traducao_palavra": "Cingiu" },
        { "hebraico": "בְעֹ֣וז", "transliteral": "ḇə-ʿôz", "traducao_palavra": "com força" },
        { "hebraico": "מָתְנֶ֑יהָ", "transliteral": "mā-ṯə-ne-hā", "traducao_palavra": "seus lombos" },
        { "hebraico": "וַ֝תְּאַמֵּ֗ץ", "transliteral": "wat-tə-ʾam-mêṣ", "traducao_palavra": "e fortaleceu" },
        { "hebraico": "זְרֹועֹתֶֽיהָ׃", "transliteral": "zə-rô-ʿô-ṯe-hā", "traducao_palavra": "seus braços" }
      ]
    },
    "18": {
      "traducao_completa": "Percebe que o seu ganho é bom; a sua lâmpada não se apaga de noite.",
      "palavras": [
        { "hebraico": "טָ֭עֲמָה", "transliteral": "ṭā-ʿă-mā", "traducao_palavra": "Percebeu/provou" },
