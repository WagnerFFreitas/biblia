        { "hebraico": "תָּבִ֥יא", "transliteral": "tā-ḇî", "traducao_palavra": "traz" },
        { "hebraico": "לַחְמָֽהּ׃", "transliteral": "laḥ-māh", "traducao_palavra": "seu pão" }
      ]
    },
    "15": {
      "traducao_completa": "Ainda de noite se levanta e dá mantimento à sua casa, e a tarefa às suas criadas.",
      "palavras": [
        { "hebraico": "וַתָּ֤קָם ׀", "transliteral": "wat-tā-qām", "traducao_palavra": "E levanta-se" },
        { "hebraico": "בְּעֹ֣וד", "transliteral": "bə-ʿôḏ", "traducao_palavra": "enquanto [ainda]" },
        { "hebraico": "לַ֭יְלָה", "transliteral": "lay-lā", "traducao_palavra": "[é] noite" },
        { "hebraico": "וַתִּתֵּ֣ן", "transliteral": "wat-tit-tên", "traducao_palavra": "e dá" },
        { "hebraico": "טֶ֣רֶף", "transliteral": "ṭe-rep̄", "traducao_palavra": "comida/presa" },
        { "hebraico": "לְבֵיתָ֑הּ", "transliteral": "lə-ḇê-ṯāh", "traducao_palavra": "para sua casa" },
        { "hebraico": "וְ֝חֹ֗ק", "transliteral": "wə-ḥōq", "traducao_palavra": "e a porção/tarefa" },
        { "hebraico": "לְנַעֲרֹתֶֽיהָ׃", "transliteral": "lə-na-ʿă-rō-ṯe-hā", "traducao_palavra": "para suas criadas" }
      ]
    },
    "16": {
      "traducao_completa": "Examina um campo e adquire-o; do fruto das suas mãos planta uma vinha.",
