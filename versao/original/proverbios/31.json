        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "יִכְבֶּ֖ה", "transliteral": "yik-beh", "traducao_palavra": "apaga-se" },
        { "hebraico": "בַלַּ֣יְלָה", "transliteral": "bal-lay-lā", "traducao_palavra": "de noite" },
        { "hebraico": "נֵרָֽהּ׃", "transliteral": "nê-rāh", "traducao_palavra": "sua lâmpada" }
      ]
    },
    "19": {
      "traducao_completa": "Estende as suas mãos ao fuso, e as suas mãos pegam na roca.",
      "palavras": [
        { "hebraico": "יָ֭דֶיהָ", "transliteral": "yā-ḏe-hā", "traducao_palavra": "Suas mãos" },
        { "hebraico": "שִׁלְּחָ֣ה", "transliteral": "šil-lə-ḥā", "traducao_palavra": "estendeu" },
        { "hebraico": "בַכִּישֹׁ֑ור", "transliteral": "ba-kî-šôr", "traducao_palavra": "à roca" },
        { "hebraico": "וְ֝כַפֶּ֗יהָ", "transliteral": "wə-ḵap-pe-hā", "traducao_palavra": "e as palmas de suas mãos" },
        { "hebraico": "תָּ֣מְכוּ", "transliteral": "tā-mə-ḵû", "traducao_palavra": "seguraram" },
        { "hebraico": "פָֽלֶךְ׃", "transliteral": "p̄ā-leḵ", "traducao_palavra": "[o] fuso" }
      ]
    },
    "20": {
      "traducao_completa": "Abre a sua mão ao pobre, e estende as suas mãos ao necessitado.",
      "palavras": [
        { "hebraico": "כַּ֭פָּהּ", "transliteral": "kap-pāh", "traducao_palavra": "Sua palma" },
        { "hebraico": "פָּרְשָׂ֣ה", "transliteral": "pā-rə-śā", "traducao_palavra": "abriu" },
        { "hebraico": "לֶעָנִ֑י", "transliteral": "le-ʿā-nî", "traducao_palavra": "ao pobre/aflito" },
        { "hebraico": "וְ֝יָדֶ֗יהָ", "transliteral": "wə-yā-ḏe-hā", "traducao_palavra": "e suas mãos" },
        { "hebraico": "שִׁלְּחָ֥ה", "transliteral": "šil-lə-ḥā", "traducao_palavra": "estendeu" },
        { "hebraico": "לָאֶבְיֹֽון׃", "transliteral": "lā-ʾeḇ-yôn", "traducao_palavra": "ao necessitado" }
      ]
    },
    "21": {
      "traducao_completa": "Não teme a neve pela sua casa, porque toda a sua família está vestida de escarlata.",
      "palavras": [
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "Não" },
        { "hebraico": "תִירָ֣א", "transliteral": "ṯî-rā", "traducao_palavra": "temerá" },
        { "hebraico": "לְבֵיתָ֣הּ", "transliteral": "lə-ḇê-ṯāh", "traducao_palavra": "por sua casa" },
        { "hebraico": "מִשָּׁ֑לֶג", "transliteral": "miš-šā-leḡ", "traducao_palavra": "da neve" },
        { "hebraico": "כִּ֣י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "כָל־", "transliteral": "ḵāl-", "traducao_palavra": "toda" },
        { "hebraico": "בֵּ֝יתָ֗הּ", "transliteral": "bê-ṯāh", "traducao_palavra": "sua casa" },
        { "hebraico": "לָבֻ֥שׁ", "transliteral": "lā-ḇuš", "traducao_palavra": "[está] vestida de" },
        { "hebraico": "שָׁנִֽים׃", "transliteral": "šā-nîm", "traducao_palavra": "escarlatas/vestes duplas" }
      ]
    },
    "22": {
      "traducao_completa": "Faz para si cobertas de tapeçaria; de linho fino e de púrpura é a sua veste.",
      "palavras": [
        { "hebraico": "מַרְבַדִּ֥ים", "transliteral": "mar-ḇad-dîm", "traducao_palavra": "Cobertas/tapeçarias" },
        { "hebraico": "עָשְׂתָה־", "transliteral": "ʿā-śə-ṯā-", "traducao_palavra": "ela fez" },
        { "hebraico": "לָּ֑הּ", "transliteral": "lāh", "traducao_palavra": "para si" },
        { "hebraico": "שֵׁ֖שׁ", "transliteral": "šēš", "traducao_palavra": "[de] linho fino" },
        { "hebraico": "וְאַרְגָּמָ֣ן", "transliteral": "wə-ʾar-gā-mān", "traducao_palavra": "e púrpura" },
        { "hebraico": "לְבוּשָֽׁהּ׃", "transliteral": "lə-ḇû-šāh", "traducao_palavra": "[é] sua veste" }
      ]
    },
    "23": {
      "traducao_completa": "Conhece-se o seu marido nas portas, quando se assenta com os anciãos da terra.",
      "palavras": [
        { "hebraico": "נֹודָ֣ע", "transliteral": "nô-ḏāʿ", "traducao_palavra": "É conhecido" },
        { "hebraico": "בַּשְּׁעָרִ֣ים", "transliteral": "baš-šə-ʿā-rîm", "traducao_palavra": "nos portões" },
        { "hebraico": "בַּעְלָ֑הּ", "transliteral": "ba-ʿə-lāh", "traducao_palavra": "seu marido" },
        { "hebraico": "בְּ֝שִׁבְתֹּ֗ו", "transliteral": "bə-šiḇ-tô", "traducao_palavra": "em seu assentar" },
        { "hebraico": "עִם־", "transliteral": "ʿim-", "traducao_palavra": "com" },
        { "hebraico": "זִקְנֵי־", "transliteral": "ziq-nê-", "traducao_palavra": "anciãos de" },
        { "hebraico": "אָֽרֶץ׃", "transliteral": "ʾā-reṣ", "traducao_palavra": "[a] terra" }
      ]
    },
    "24": {
      "traducao_completa": "Faz panos de linho fino e vende-os, e entrega cintas aos mercadores.",
      "palavras": [
        { "hebraico": "סָדִ֣ין", "transliteral": "śā-ḏîn", "traducao_palavra": "Vestes de linho" },
        { "hebraico": "עָ֭שְׂתָה", "transliteral": "ʿā-śə-ṯā", "traducao_palavra": "fez" },
        { "hebraico": "וַתִּמְכֹּ֑ר", "transliteral": "wat-tim-kōr", "traducao_palavra": "e vendeu" },
        { "hebraico": "וַ֝חֲגֹ֗ור", "transliteral": "wa-ḥă-ḡôr", "traducao_palavra": "e cintas" },
        { "hebraico": "נָתְנָ֥ה", "transliteral": "nā-ṯə-nā", "traducao_palavra": "entregou" },
        { "hebraico": "לַכְּנַעֲנִֽי׃", "transliteral": "lak-kə-na-ʿă-nî", "traducao_palavra": "ao mercador/cananeu" }
      ]
    },
    "25": {
      "traducao_completa": "A força e a honra são os seus vestidos, e ri-se do tempo vindouro.",
      "palavras": [
        { "hebraico": "עֹז־", "transliteral": "ʿōz-", "traducao_palavra": "Força" },
        { "hebraico": "וְהָדָ֥ר", "transliteral": "wə-hā-ḏār", "traducao_palavra": "e honra/esplendor" },
        { "hebraico": "לְבוּשָׁ֑הּ", "transliteral": "lə-ḇû-šāh", "traducao_palavra": "[são] sua veste" },
        { "hebraico": "וַתִּשְׂחַ֝ק", "transliteral": "wat-tiś-ḥaq", "traducao_palavra": "e ri" },
        { "hebraico": "לְיֹ֣ום", "transliteral": "lə-yôm", "traducao_palavra": "do dia" },
        { "hebraico": "אַחֲרֹֽון׃", "transliteral": "ʾa-ḥă-rôn", "traducao_palavra": "último/vindouro" }
      ]
    },
    "26": {
      "traducao_completa": "Abre a sua boca com sabedoria, e a lei da beneficência está na sua língua.",
      "palavras": [
        { "hebraico": "פִּ֭יהָ", "transliteral": "pî-hā", "traducao_palavra": "Sua boca" },
        { "hebraico": "פָּתְחָ֣ה", "transliteral": "pā-ṯə-ḥā", "traducao_palavra": "abriu" },
        { "hebraico": "בְחָכְמָ֑ה", "transliteral": "ḇə-ḥā-ḵə-mā", "traducao_palavra": "com sabedoria" },
        { "hebraico": "וְתֹורַת־", "transliteral": "wə-ṯô-raṯ-", "traducao_palavra": "e a lei de" },
        { "hebraico": "חֶ֝֗סֶד", "transliteral": "ḥe-seḏ", "traducao_palavra": "bondade/misericórdia" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre" },
        { "hebraico": "לְשֹׁונָֽהּ׃", "transliteral": "lə-šô-nāh", "traducao_palavra": "sua língua" }
      ]
    },
    "27": {
      "traducao_completa": "Olha pelo governo da sua casa e não come o pão da preguiça.",
      "palavras": [
        { "hebraico": "צֹ֭ופִיָּה", "transliteral": "ṣô-p̄î-yā", "traducao_palavra": "Vigia/olha" },
        { "hebraico": "הֲלִיכֹ֣ות", "transliteral": "hă-lî-ḵôṯ", "traducao_palavra": "[os] caminhos/andamentos de" },
        { "hebraico": "בֵּיתָ֑הּ", "transliteral": "bê-ṯāh", "traducao_palavra": "sua casa" },
        { "hebraico": "וְלֶ֥חֶם", "transliteral": "wə-le-ḥem", "traducao_palavra": "e [o] pão de" },
        { "hebraico": "עַ֝צְלוּת", "transliteral": "ʿaṣ-lût", "traducao_palavra": "preguiça" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "תֹאכֵֽל׃", "transliteral": "ṯō-ḵêl", "traducao_palavra": "comerá" }
      ]
    },
    "28": {
      "traducao_completa": "Levantam-se os seus filhos e chamam-na bem-aventurada; como também o seu marido, que a louva, dizendo:",
      "palavras": [
        { "hebraico": "קָ֣מוּ", "transliteral": "qā-mû", "traducao_palavra": "Levantaram-se" },
        { "hebraico": "בָ֭נֶיהָ", "transliteral": "ḇā-ne-hā", "traducao_palavra": "seus filhos" },
        { "hebraico": "וַֽיְאַשְּׁר֑וּהָ", "transliteral": "way-ʾaš-šə-rû-hā", "traducao_palavra": "e chamaram-na bem-aventurada" },
        { "hebraico": "בַּ֝עְלָ֗הּ", "transliteral": "ba-ʿə-lāh", "traducao_palavra": "seu marido" },
        { "hebraico": "וַֽיְהַלְלָֽהּ׃", "transliteral": "way-hal-lāh", "traducao_palavra": "e louvou-a" }
      ]
    },
    "29": {
      "traducao_completa": "Muitas filhas agiram virtuosamente, mas tu a todas és superior.",
      "palavras": [
        { "hebraico": "רַבֹּ֣ות", "transliteral": "rab-bôṯ", "traducao_palavra": "Muitas" },
        { "hebraico": "בָּ֭נֹות", "transliteral": "bā-nôṯ", "traducao_palavra": "filhas" },
        { "hebraico": "עָ֣שׂוּ", "transliteral": "ʿā-śû", "traducao_palavra": "fizeram/agiram" },
        { "hebraico": "חָ֑יִל", "transliteral": "ḥā-yil", "traducao_palavra": "[com] valor/virtude" },
        { "hebraico": "וְ֝אַ֗תְּ", "transliteral": "wə-ʾat", "traducao_palavra": "mas tu" },
        { "hebraico": "עָלִ֥ית", "transliteral": "ʿā-lîṯ", "traducao_palavra": "subiste/excedeste" },
        { "hebraico": "עַל־", "transliteral": "ʿal-", "traducao_palavra": "sobre" },
        { "hebraico": "כֻּלָּֽנָה׃", "transliteral": "kul-lā-nā", "traducao_palavra": "todas elas" }
      ]
    },
    "30": {
      "traducao_completa": "Enganosa é a graça e vã é a formosura, mas a mulher que teme a YHWH, essa será louvada.",
      "palavras": [
        { "hebraico": "שֶׁ֣קֶר", "transliteral": "šé-qer", "traducao_palavra": "Mentira/enganosa [é]" },
        { "hebraico": "הַ֭חֵן", "transliteral": "ha-ḥên", "traducao_palavra": "a graça" },
        { "hebraico": "וְהֶ֣בֶל", "transliteral": "wə-he-ḇel", "traducao_palavra": "e vaidade/vão" },
        { "hebraico": "הַיֹּ֑פִי", "transliteral": "hay-yō-p̄î", "traducao_palavra": "[é] a beleza" },
        { "hebraico": "אִשָּׁ֥ה", "transliteral": "ʾiš-šā", "traducao_palavra": "[a] mulher" },
        { "hebraico": "יִרְאַת־", "transliteral": "yir-ʾaṯ-", "traducao_palavra": "[que] teme" },
        { "hebraico": "יְ֝הוָ֗ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "הִ֣יא", "transliteral": "hî", "traducao_palavra": "ela" },
        { "hebraico": "תִתְהַלָּֽל׃", "transliteral": "tiṯ-hal-lāl", "traducao_palavra": "será louvada" }
      ]
    },
    "31": {
      "traducao_completa": "Dai-lhe do fruto das suas mãos, e louvem-na nas portas as suas obras.",
      "palavras": [
        { "hebraico": "תְּנוּ־", "transliteral": "tə-nû-", "traducao_palavra": "Dai" },
        { "hebraico": "לָ֭הּ", "transliteral": "lāh", "traducao_palavra": "a ela" },
        { "hebraico": "מִפְּרִ֣י", "transliteral": "mip-pə-rî", "traducao_palavra": "do fruto de" },
        { "hebraico": "יָדֶ֑יהָ", "transliteral": "yā-ḏe-hā", "traducao_palavra": "suas mãos" },
        { "hebraico": "וִיהַלְל֥וּהָ", "transliteral": "wî-hal-lû-hā", "traducao_palavra": "e louvem-na" },
        { "hebraico": "בַשְּׁעָרִ֗ים", "transliteral": "baš-šə-ʿā-rîm", "traducao_palavra": "nos portões" },
        { "hebraico": "מַעֲשֶֽׂיהָ׃", "transliteral": "ma-ʿă-śe-hā", "traducao_palavra": "as suas obras" }
      ]
    }
