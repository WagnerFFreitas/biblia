        { "hebraico": "לִ֭נְצֹר", "transliteral": "lin-ṣōr", "traducao_palavra": "para guardar" },
        { "hebraico": "אָרְחֹ֣ות", "transliteral": "ʾā-rə-ḥōṯ", "traducao_palavra": "veredas de" },
        { "hebraico": "מִשְׁפָּ֑ט", "transliteral": "miš-pāṭ", "traducao_palavra": "juízo" },
        { "hebraico": "וְדֶ֖רֶךְ", "transliteral": "wə-ḏe-reḵ", "traducao_palavra": "e o caminho de" },
