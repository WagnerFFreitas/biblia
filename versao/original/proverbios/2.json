        { "hebraico": "וּמִשְׁפָּ֑ט", "transliteral": "ū-miš-pāṭ", "traducao_palavra": "e juízo" },
        { "hebraico": "וּ֝מֵישָׁרִ֗ים", "transliteral": "ū-mê-šā-rîm", "traducao_palavra": "e equidade/retidão" },
