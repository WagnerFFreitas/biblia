        { "hebraico": "יְשׁוּב֑וּן", "transliteral": "yə-šû-ḇûn", "traducao_palavra": "voltarão" },
        { "hebraico": "וְלֹֽא־יַ֝שִּׂ֗יגוּ", "transliteral": "wə-lō-yaś-śî-ḡû", "traducao_palavra": "e não alcançarão" },
        { "hebraico": "אָרְחֹ֥ות", "transliteral": "ʾā-rə-ḥōṯ", "traducao_palavra": "veredas de" },
