      ]
    },
    "7": {
      "traducao_completa": "Ele reserva a verdadeira sabedoria para os retos; é escudo para os que caminham em integridade,",
      "palavras": [
        { "hebraico": "יִצְפֹּן", "transliteral": "yiṣ-pōn", "traducao_palavra": "ele reserva/armazena" },
        { "hebraico": "לַיְשָׁרִ֥ים", "transliteral": "lay-šā-rîm", "traducao_palavra": "para os retos" },
        { "hebraico": "תּוּשִׁיָּ֑ה", "transliteral": "tū-šî-yā", "traducao_palavra": "sucesso/sabedoria verdadeira" },
        { "hebraico": "מָ֝גֵ֗ן", "transliteral": "mā-ḡên", "traducao_palavra": "[é] escudo" },
        { "hebraico": "לְהֹ֣לְכֵי", "transliteral": "lə-hō-lə-ḵê", "traducao_palavra": "para os que caminham [em]" },
