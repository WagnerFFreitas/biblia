        { "hebraico": "יִשְׁמֹֽר׃", "transliteral": "yiš-mōr", "traducao_palavra": "ele preservará" }
      ]
    },
    "9": {
      "traducao_completa": "Então entenderás a justiça, o juízo e a equidade, sim, todo bom caminho.",
      "palavras": [
        { "hebraico": "אָ֗ז", "transliteral": "ʾāz", "traducao_palavra": "então" },
        { "hebraico": "תָּ֭בִין", "transliteral": "tā-ḇîn", "traducao_palavra": "entenderás" },
