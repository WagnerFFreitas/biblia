      ]
    },
    "6": {
      "traducao_completa": "Porque YHWH dá a sabedoria; da sua boca vem o conhecimento e o entendimento.",
      "palavras": [
        { "hebraico": "כִּֽי־יְהוָ֥ה", "transliteral": "kî-YHWH", "traducao_palavra": "porque YHWH" },
        { "hebraico": "יִתֵּ֪ן", "transliteral": "yit-tên", "traducao_palavra": "dá" },
        { "hebraico": "חָכְמָ֑ה", "transliteral": "ḥā-ḵə-mā", "traducao_palavra": "sabedoria" },
        { "hebraico": "מִ֝פִּ֗יו", "transliteral": "mip-pîw", "traducao_palavra": "da sua boca" },
