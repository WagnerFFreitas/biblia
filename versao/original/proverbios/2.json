      "palavras": [
        { "hebraico": "לְהַקְשִׁ֣יב", "transliteral": "lə-haq-šîḇ", "traducao_palavra": "para fazeres atento" },
        { "hebraico": "לַחָכְמָ֣ה", "transliteral": "la-ḥā-ḵə-mā", "traducao_palavra": "à sabedoria" },
        { "hebraico": "אָזְנֶ֑ךָ", "transliteral": "ʾāz-ne-ḵā", "traducao_palavra": "o teu ouvido" },
        { "hebraico": "תַּטֶּ֥ה", "transliteral": "taṭ-ṭeh", "traducao_palavra": "inclinares" },
        { "hebraico": "לִ֝בְּךָ֗", "transliteral": "lib-bə-ḵā", "traducao_palavra": "teu coração" },
        { "hebraico": "לַתְּבוּנָֽה׃", "transliteral": "lat-tə-ḇû-nā", "traducao_palavra": "ao entendimento" }
      ]
    },
    "3": {
      "traducao_completa": "porque, se clamares por discernimento e por entendimento alçares a tua voz,",
      "palavras": [
        { "hebraico": "כִּ֤י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "אִם־לַבִּינָ֥ה", "transliteral": "ʾim-lab-bî-nā", "traducao_palavra": "se ao discernimento" },
        { "hebraico": "תִקְרָ֑א", "transliteral": "ṯiq-rā", "traducao_palavra": "clamares" },
        { "hebraico": "לַתְּבוּנָ֗ה", "transliteral": "lat-tə-ḇû-nā", "traducao_palavra": "ao entendimento" },
        { "hebraico": "תִּתֵּ֥ן", "transliteral": "tit-tên", "traducao_palavra": "deres" },
        { "hebraico": "קֹולֶֽךָ׃", "transliteral": "qô-le-ḵā", "traducao_palavra": "a tua voz" }
      ]
    },
    "4": {
      "traducao_completa": "se a buscares como a prata e a procurares como a tesouros escondidos,",
      "palavras": [
        { "hebraico": "אִם־תְּבַקְשֶׁ֥נָּה", "transliteral": "ʾim-tə-ḇaq-šen-nā", "traducao_palavra": "se a buscares" },
        { "hebraico": "כַכָּ֑סֶף", "transliteral": "ḵak-kā-sep̄", "traducao_palavra": "como a prata" },
        { "hebraico": "וְכַמַּטְמֹונִ֥ים", "transliteral": "wə-ḵam-maṭ-mô-nîm", "traducao_palavra": "e como tesouros escondidos" },
        { "hebraico": "תַּחְפְּשֶֽׂנָּה׃", "transliteral": "taḥ-pə-śen-nā", "traducao_palavra": "a procurares" }
      ]
    },
