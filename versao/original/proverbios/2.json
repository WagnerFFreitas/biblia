    "13": {
      "traducao_completa": "dos que deixam as veredas da retidão para andarem pelos caminhos das trevas;",
      "palavras": [
        { "hebraico": "הַ֭עֹזְבִים", "transliteral": "ha-ʿō-zə-ḇîm", "traducao_palavra": "os que abandonam" },
