{
  "livro": "Provérbios - מִשְׁלֵי - Mishlei",
  "capítulo": 2,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Filho meu, se aceitares as minhas palavras e esconderes contigo os meus mandamentos,",
      "palavras": [
        { "hebraico": "בְּנִ֬י", "transliteral": "bə-nî", "traducao_palavra": "filho meu" },
        { "hebraico": "אִם־תִּקַּ֥ח", "transliteral": "ʾim-tiq-qaḥ", "traducao_palavra": "se aceitares" },
        { "hebraico": "אֲמָרָ֑י", "transliteral": "ʾă-mā-rāy", "traducao_palavra": "minhas palavras" },
        { "hebraico": "וּמִצְוֹתַ֗י", "transliteral": "ū-miṣ-wō-ṯay", "traducao_palavra": "e meus mandamentos" },
        { "hebraico": "תִּצְפֹּ֥ן", "transliteral": "tiṣ-pōn", "traducao_palavra": "esconderes/guardares" },
        { "hebraico": "אִתָּֽךְ׃", "transliteral": "ʾit-tāḵ", "traducao_palavra": "contigo" }
      ]
    },
    "2": {
