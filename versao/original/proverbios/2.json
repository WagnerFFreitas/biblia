      ]
    },
    "17": {
      "traducao_completa": "que abandona o companheiro da sua mocidade e se esquece da aliança do seu Deus;",
      "palavras": [
        { "hebraico": "הַ֭עֹזֶבֶת", "transliteral": "ha-ʿō-ze-ḇeṯ", "traducao_palavra": "que abandona" },
