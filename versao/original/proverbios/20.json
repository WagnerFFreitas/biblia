        { "hebraico": "שֵׁכָ֣ר", "transliteral": "šē-ḵār", "traducao_palavra": "bebida forte" },
        { "hebraico": "הֹמֶ֑ה", "transliteral": "hō-meh", "traducao_palavra": "alvoroçadora/barulhenta" },
