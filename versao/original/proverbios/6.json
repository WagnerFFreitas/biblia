        { "hebraico": "אֵידֹ֑ו", "transliteral": "ʾê-ḏô", "traducao_palavra": "destruição dele" },
        { "hebraico": "פֶּ֥תַע", "transliteral": "pe-ṯaʿ", "traducao_palavra": "subitamente" },
