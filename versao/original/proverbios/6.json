        { "hebraico": "מֹלֵ֥ל", "transliteral": "mō-lêl", "traducao_palavra": "fala/faz sinais" },
        { "hebraico": "בְּרַגְלָ֝ו", "transliteral": "bə-raḡ-lāw", "traducao_palavra": "com seus pés" },
        { "hebraico": "מֹ֘רֶ֥ה", "transliteral": "mō-reh", "traducao_palavra": "ensina/aponta" },
        { "hebraico": "בְּאֶצְבְּעֹתָֽיו׃", "transliteral": "bə-ʾeṣ-bə-ʿō-ṯāw", "traducao_palavra": "com seus dedos" }
