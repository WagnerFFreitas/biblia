        { "hebraico": "וְ֝יָדַ֗יִם", "transliteral": "wə-yā-ḏa-yim", "traducao_palavra": "e mãos" },
        { "hebraico": "שֹׁפְכֹ֥ות", "transliteral": "šō-p̄ə-ḵôṯ", "traducao_palavra": "derramando" },
