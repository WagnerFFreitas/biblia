    "7": {
      "traducao_completa": "A qual, não tendo superior, nem oficial, nem dominador,",
      "palavras": [
        { "hebraico": "אֲשֶׁר", "transliteral": "ʾă-šer", "traducao_palavra": "a qual" },
        { "hebraico": "אֵֽין־", "transliteral": "ʾên-", "traducao_palavra": "não [tendo]" },
        { "hebraico": "לָ֥הּ", "transliteral": "lāh", "traducao_palavra": "para ela" },
        { "hebraico": "קָצִ֑ין", "transliteral": "qā-ṣîn", "traducao_palavra": "superior/comandante" },
        { "hebraico": "שֹׁ֝טֵ֗ר", "transliteral": "šō-ṭēr", "traducao_palavra": "oficial/escrivão" },
