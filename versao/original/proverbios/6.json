        { "hebraico": "רֵאשֶׁ֑ךָ", "transliteral": "rê-še-ḵā", "traducao_palavra": "tua pobreza" },
        { "hebraico": "וּ֝מַחְסֹרְךָ֗", "transliteral": "ū-maḥ-sō-rə-ḵā", "traducao_palavra": "e tua necessidade" },
