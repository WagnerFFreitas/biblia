      "palavras": [
        { "hebraico": "תָּכִ֣ין", "transliteral": "tā-ḵîn", "traducao_palavra": "prepara" },
        { "hebraico": "בַּקַּ֣יִץ", "transliteral": "baq-qa-yiṣ", "traducao_palavra": "no verão" },
        { "hebraico": "לַחְמָ֑הּ", "transliteral": "laḥ-māh", "traducao_palavra": "pão dela" },
        { "hebraico": "אָגְרָ֥ה", "transliteral": "ʾā-ḡə-rā", "traducao_palavra": "ajunta" },
        { "hebraico": "בַ֝קָּצִ֗יר", "transliteral": "baq-qā-ṣîr", "traducao_palavra": "na sega/colheita" },
