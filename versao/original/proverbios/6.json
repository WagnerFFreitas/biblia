        { "hebraico": "אִ֣ישׁ", "transliteral": "ʾîš", "traducao_palavra": "homem de" },
        { "hebraico": "אָ֑וֶן", "transliteral": "ʾā-wen", "traducao_palavra": "iniquidade" },
        { "hebraico": "הֹ֝ולֵ֗ךְ", "transliteral": "hō-lêḵ", "traducao_palavra": "anda [em]" },
