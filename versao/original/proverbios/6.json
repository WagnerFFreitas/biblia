        { "hebraico": "רָ֣ע", "transliteral": "rāʿ", "traducao_palavra": "mal" },
        { "hebraico": "בְּכָל־עֵ֑ת", "transliteral": "bə-ḵāl-ʿêṯ", "traducao_palavra": "em todo tempo" },
