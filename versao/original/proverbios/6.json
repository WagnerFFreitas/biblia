{
  "livro": "Provérbios - מִשְׁלֵי - Mishlei",
  "capítulo": 6,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Filho meu, se ficaste por fiador do teu próximo, se bateste a tua mão pelo estranho,",
      "palavras": [
        { "hebraico": "בְּ֭נִי", "transliteral": "bə-nî", "traducao_palavra": "filho meu" },
        { "hebraico": "אִם־עָרַ֣בְתָּ", "transliteral": "ʾim-ʿā-raḇ-tā", "traducao_palavra": "se ficaste por fiador" },
        { "hebraico": "לְרֵעֶ֑ךָ", "transliteral": "lə-rê-ʿe-ḵā", "traducao_palavra": "do teu próximo" },
        { "hebraico": "תָּקַ֖עְתָּ", "transliteral": "tā-qa-ʿatā", "traducao_palavra": "bateste [as mãos]" },
        { "hebraico": "לַזָּ֣ר", "transliteral": "laz-zār", "traducao_palavra": "pelo estranho" },
        { "hebraico": "כַּפֶּֽיךָ׃", "transliteral": "kap-pe-ḵā", "traducao_palavra": "tuas palmas/mãos" }
      ]
    },
    "2": {
      "traducao_completa": "foste enredado pelas palavras da tua boca; foste preso pelas palavras da tua boca.",
      "palavras": [
        { "hebraico": "נֹוקַ֥שְׁתָּ", "transliteral": "nô-qaš-tā", "traducao_palavra": "foste enredado" },
        { "hebraico": "בְאִמְרֵי־", "transliteral": "ḇə-ʾim-rê-", "traducao_palavra": "pelas palavras de" },
        { "hebraico": "פִ֑יךָ", "transliteral": "p̄î-ḵā", "traducao_palavra": "tua boca" },
        { "hebraico": "נִ֝לְכ  ַּ֗דְתָּ", "transliteral": "nil-kaḏ-tā", "traducao_palavra": "foste preso" },
        { "hebraico": "בְּאִמְרֵי־", "transliteral": "bə-ʾim-rê-", "traducao_palavra": "pelas palavras de" },
        { "hebraico": "פִֽיךָ׃", "transliteral": "p̄î-ḵā", "traducao_palavra": "tua boca" }
      ]
    },
    "3": {
      "traducao_completa": "Faze pois isto agora, filho meu, e livra-te, pois caíste nas mãos do teu próximo: vai, humilha-te e importauna o teu próximo.",
      "palavras": [
        { "hebraico": "עֲשֵׂ֨ה", "transliteral": "ʿă-śēh", "traducao_palavra": "faze" },
        { "hebraico": "זֹ֥את", "transliteral": "zōṯ", "traducao_palavra": "isto" },
        { "hebraico": "אֵפֹ֣וד", "transliteral": "ʾê-p̄ôḏ", "traducao_palavra": "pois/agora" },
        { "hebraico": "בְּנִי֮", "transliteral": "bə-nî", "traducao_palavra": "filho meu" },
        { "hebraico": "וְהִנָּ֘צֵל֒", "transliteral": "wə-hin-nā-ṣêl", "traducao_palavra": "e livra-te" },
        { "hebraico": "כִּ֘י", "transliteral": "kî", "traducao_palavra": "pois" },
        { "hebraico": "בָ֪אתָ", "transliteral": "ḇā-ṯā", "traducao_palavra": "vieste/caíste" },
        { "hebraico": "בְכַף־", "transliteral": "ḇə-ḵap̄-", "traducao_palavra": "na mão de" },
        { "hebraico": "רֵ֫עֶ֥ךָ", "transliteral": "rê-ʿe-ḵā", "traducao_palavra": "teu próximo" },
        { "hebraico": "לֵ֥ךְ", "transliteral": "lêḵ", "traducao_palavra": "vai" },
        { "hebraico": "הִתְרַפֵּ֗ס", "transliteral": "hiṯ-rap-pês", "traducao_palavra": "humilha-te/prostra-te" },
        { "hebraico": "וּרְהַ֥ב", "transliteral": "ū-rə-haḇ", "traducao_palavra": "e insta/importuna" },
        { "hebraico": "רֵעֶֽיךָ׃", "transliteral": "rê-ʿe-y-ḵā", "traducao_palavra": "teus próximos" }
      ]
    },
    "4": {
      "traducao_completa": "Não dês sono aos teus olhos, nem repouso às tuas pálpebras.",
      "palavras": [
        { "hebraico": "אַל־תִּתֵּ֣ן", "transliteral": "ʾal-tit-tên", "traducao_palavra": "não dês" },
        { "hebraico": "שֵׁנָ֣ה", "transliteral": "šê-nā", "traducao_palavra": "sono" },
        { "hebraico": "לְעֵינֶ֑יךָ", "transliteral": "lə-ʿê-ne-ḵā", "traducao_palavra": "aos teus olhos" },
        { "hebraico": "וּ֝תְנוּמָ֗ה", "transliteral": "ū-ṯə-nū-mā", "traducao_palavra": "e repouso/cochilo" },
        { "hebraico": "לְעַפְעַפֶּֽיךָ׃", "transliteral": "lə-ʿap̄-ʿap-pe-ḵā", "traducao_palavra": "às tuas pálpebras" }
      ]
    },
    "5": {
      "traducao_completa": "Livra-te, como a gazela da mão do caçador, e como a ave da mão do passarinheiro.",
      "palavras": [
        { "hebraico": "הִ֭נָּצֵל", "transliteral": "hin-nā-ṣêl", "traducao_palavra": "livra-te" },
        { "hebraico": "כִּצְבִ֣י", "transliteral": "kiṣ-ḇî", "traducao_palavra": "como a gazela" },
        { "hebraico": "מִיָּ֑ד", "transliteral": "miy-yāḏ", "traducao_palavra": "da mão" },
        { "hebraico": "וּ֝כְצִפֹּ֗ור", "transliteral": "ū-ḵə-ṣip-pôr", "traducao_palavra": "e como ave" },
        { "hebraico": "מִיַּ֥ד", "transliteral": "miy-yaḏ", "traducao_palavra": "da mão de" },
        { "hebraico": "יָקֽוּשׁ׃", "transliteral": "yā-qûš", "traducao_palavra": "caçador/passarinheiro" }
      ]
    },
    "6": {
      "traducao_completa": "Vai ter com a formiga, ó preguiçoso; olha para os seus caminhos, e sê sábio.",
      "palavras": [
        { "hebraico": "לֵךְ־", "transliteral": "lêḵ-", "traducao_palavra": "vai" },
        { "hebraico": "אֶל־נְמָלָ֥ה", "transliteral": "ʾel-nə-mā-lā", "traducao_palavra": "à formiga" },
        { "hebraico": "עָצֵ֑ל", "transliteral": "ʿā-ṣēl", "traducao_palavra": "preguiçoso" },
        { "hebraico": "רְאֵ֖ה", "transliteral": "rə-ʾēh", "traducao_palavra": "olha" },
        { "hebraico": "דְרָכֶ֣יהָ", "transliteral": "ḏə-rā-ḵe-yā", "traducao_palavra": "caminhos dela" },
        { "hebraico": "וַחֲכָֽם׃", "transliteral": "wa-ḥă-ḵām", "traducao_palavra": "e sê sábio" }
      ]
