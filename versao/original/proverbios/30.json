        { "hebraico": "יָקֶ֨ה", "transliteral": "yā-qeh", "traducao_palavra": "Jaque" },
        { "hebraico": "הַמַּשָּׂ֗א", "transliteral": "ham-maś-śā", "traducao_palavra": "o oráculo/a profecia" },
