        { "hebraico": "שֵׁ֣ם", "transliteral": "šēm", "traducao_palavra": "[o] nome de" },
        { "hebraico": "אֱלֹהָֽי׃", "transliteral": "ʾĕ-lō-hāy", "traducao_palavra": "meu Deus" }
      ]
    },
    "10": {
      "traducao_completa": "Não calunies o servo diante de seu senhor, para que não te amaldiçoe e fiques culpado.",
      "palavras": [
        { "hebraico": "אַל־", "transliteral": "ʾal-", "traducao_palavra": "Não" },
        { "hebraico": "תַּלְשֵׁ֣ן", "transliteral": "tal-šên", "traducao_palavra": "calunies/difames" },
