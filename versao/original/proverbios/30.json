        { "hebraico": "לָמַ֣דְתִּי", "transliteral": "lā-maḏ-tî", "traducao_palavra": "aprendi" },
        { "hebraico": "חָכְמָ֑ה", "transliteral": "ḥā-ḵə-mā", "traducao_palavra": "sabedoria" },
        { "hebraico": "וְדַ֖עַת", "transliteral": "wə-ḏa-ʿaṯ", "traducao_palavra": "nem o conhecimento de" },
        { "hebraico": "קְדֹשִׁ֣ים", "transliteral": "qə-ḏō-šîm", "traducao_palavra": "Santos/o Santo" },
