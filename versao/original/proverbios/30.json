        { "hebraico": "בַ֣עַר", "transliteral": "ḇa-ʿar", "traducao_palavra": "estúpido/bruto" },
        { "hebraico": "אָנֹכִ֣י", "transliteral": "ʾā-nō-ḵî", "traducao_palavra": "eu [sou]" },
        { "hebraico": "מֵאִ֑ישׁ", "transliteral": "mē-ʾîš", "traducao_palavra": "mais que [qualquer] homem" },
        { "hebraico": "וְלֹֽא־", "transliteral": "wə-lō-", "traducao_palavra": "e não" },
        { "hebraico": "בִינַ֖ת", "transliteral": "ḇî-naṯ", "traducao_palavra": "[tenho] entendimento de" },
        { "hebraico": "אָדָ֣ם", "transliteral": "ʾā-ḏām", "traducao_palavra": "humano/homem" },
        { "hebraico": "לִֽי׃", "transliteral": "lî", "traducao_palavra": "para mim" }
      ]
    },
    "3": {
      "traducao_completa": "Não aprendi a sabedoria, nem tenho o conhecimento do Santo.",
