        { "hebraico": "חֲרָבֹ֣ות", "transliteral": "ḥă-rā-ḇôṯ", "traducao_palavra": "espadas [são]" },
        { "hebraico": "שִׁנָּיו֮", "transliteral": "šin-nāyw", "traducao_palavra": "seus dentes" },
        { "hebraico": "וּמַאֲכָלֹ֪ות", "transliteral": "ū-ma-ʾă-ḵā-lôṯ", "traducao_palavra": "e facas [são]" },
        { "hebraico": "מְֽתַלְּעֹ֫תָ֥יו", "transliteral": "mə-ṯal-lə-ʿô-ṯāyw", "traducao_palavra": "seus queixais" },
        { "hebraico": "לֶאֱכֹ֣ל", "transliteral": "le-ʾĕ-ḵōl", "traducao_palavra": "para comer/devorar" },
