        { "hebraico": "בַּשִּׂמְלָה֒", "transliteral": "baś-śim-lā", "traducao_palavra": "no manto/veste?" },
        { "hebraico": "מִ֥י", "transliteral": "mî", "traducao_palavra": "Quem" },
        { "hebraico": "הֵקִ֗ים", "transliteral": "hê-qîm", "traducao_palavra": "estabeleceu" },
