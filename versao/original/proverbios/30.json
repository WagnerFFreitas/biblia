        { "hebraico": "בְּחָפְנָיו֮", "transliteral": "bə-ḥā-p̄ə-nāyw", "traducao_palavra": "nos seus punhos" },
        { "hebraico": "מִ֤י", "transliteral": "mî", "traducao_palavra": "Quem" },
