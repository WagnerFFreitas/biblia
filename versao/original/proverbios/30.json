        { "hebraico": "שָׁמַ֨יִם", "transliteral": "šā-ma-yim", "traducao_palavra": "céu" },
        { "hebraico": "וַיֵּרַ֡ד", "transliteral": "way-yê-raḏ", "traducao_palavra": "e desceu?" },
