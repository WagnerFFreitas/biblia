        { "hebraico": "אֲדֹנָ֑יו", "transliteral": "ʾă-ḏō-nāyw", "traducao_palavra": "seu senhor" },
        { "hebraico": "פֶּן־", "transliteral": "pen-", "traducao_palavra": "para que não" },
        { "hebraico": "יְקַלֶּלְךָ֥", "transliteral": "yə-qal-lel-ḵā", "traducao_palavra": "ele te amaldiçoe" },
        { "hebraico": "וְאָשָֽׁמְתָּ׃", "transliteral": "wə-ʾā-šām-tā", "traducao_palavra": "e sejas culpado" }
      ]
    },
    "11": {
      "traducao_completa": "Há uma geração que amaldiçoa a seu pai e que não bendiz a sua mãe.",
      "palavras": [
        { "hebraico": "דֹּ֭ור", "transliteral": "dôr", "traducao_palavra": "[Há uma] geração [que]" },
        { "hebraico": "אָבִ֣יו", "transliteral": "ʾā-ḇîw", "traducao_palavra": "seu pai" },
        { "hebraico": "יְקַלֵּ֑ל", "transliteral": "yə-qal-lêl", "traducao_palavra": "amaldiçoa" },
        { "hebraico": "וְאֶת־", "transliteral": "wə-ʾeṯ-", "traducao_palavra": "e a" },
        { "hebraico": "אִ֝מֹּ֗ו", "transliteral": "ʾim-mô", "traducao_palavra": "sua mãe" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "יְבָרֵֽךְ׃", "transliteral": "yə-ḇā-rêḵ", "traducao_palavra": "bendiz" }
      ]
    },
    "12": {
      "traducao_completa": "Há uma geração que é pura aos seus próprios olhos e que nunca foi lavada da sua imundícia.",
      "palavras": [
        { "hebraico": "דֹּ֭ור", "transliteral": "dôr", "traducao_palavra": "[Há uma] geração [que]" },
        { "hebraico": "טָהֹ֣ור", "transliteral": "ṭā-hôr", "traducao_palavra": "[é] pura" },
        { "hebraico": "בְּעֵינָ֑יו", "transliteral": "bə-ʿê-nāyw", "traducao_palavra": "em seus olhos" },
        { "hebraico": "וּ֝מִצֹּאָתֹ֗ו", "transliteral": "ū-miṣ-ṣō-ʾā-ṯô", "traducao_palavra": "e da imundícia dela" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "רֻחָֽץ׃", "transliteral": "ru-ḥāṣ", "traducao_palavra": "foi lavada" }
      ]
    },
    "13": {
      "traducao_completa": "Há uma geração cujos olhos são altivos e cujas pálpebras são levantadas para cima.",
      "palavras": [
        { "hebraico": "דֹּ֭ור", "transliteral": "dôr", "traducao_palavra": "[Há uma] geração" },
