        { "hebraico": "וְאֻכָֽל׃", "transliteral": "wə-ʾu-ḵāl", "traducao_palavra": "e a Ucal" }
      ]
    },
    "2": {
      "traducao_completa": "Certamente eu sou mais estúpido do que qualquer homem, e não tenho o entendimento de homem.",
