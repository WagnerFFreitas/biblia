        { "hebraico": "לִ֭י", "transliteral": "lî", "traducao_palavra": "a mim" },
        { "hebraico": "יִשְׁכָּן־", "transliteral": "yiš-kān-", "traducao_palavra": "habitará" },
        { "hebraico": "בֶּ֗טַח", "transliteral": "be-ṭaḥ", "traducao_palavra": "em segurança" },
