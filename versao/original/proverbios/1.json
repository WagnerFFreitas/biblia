        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "בָחָֽרוּ׃", "transliteral": "ḇā-ḥā-rû", "traducao_palavra": "escolheram" }
      ]
    },
    "30": {
      "traducao_completa": "Não quiseram o meu conselho, e desprezaram toda a minha repreensão.",
      "palavras": [
        { "hebraico": "לֹא־", "transliteral": "lō-", "traducao_palavra": "não" },
        { "hebraico": "אָב֥וּ", "transliteral": "ʾā-ḇû", "traducao_palavra": "quiseram" },
        { "hebraico": "לַעֲצָתִ֑י", "transliteral": "la-ʿă-ṣā-ṯî", "traducao_palavra": "meu conselho" },
