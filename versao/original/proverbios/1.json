        { "hebraico": "יִקְרָאֻ֭נְנִי", "transliteral": "yiq-rā-ʾun-nî", "traducao_palavra": "chamarão me" },
        { "hebraico": "וְלֹ֣א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "אֶֽעֱנֶ֑ה", "transliteral": "ʾe-ʿĕ-neh", "traducao_palavra": "responderei" },
        { "hebraico": "יְשַׁחֲרֻ֝נְנִי", "transliteral": "yə-ša-ḥă-run-nî", "traducao_palavra": "buscarão me cedo" },
        { "hebraico": "וְלֹ֣א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
