        { "hebraico": "בֹּ֣צֵֽעַ", "transliteral": "bō-ṣē-aʿ", "traducao_palavra": "[o que] cobiça/ganancioso" },
        { "hebraico": "בָּ֑צַע", "transliteral": "bā-ṣaʿ", "traducao_palavra": "lucro/cobiça" },
        { "hebraico": "אֶת־", "transliteral": "ʾeṯ-", "traducao_palavra": "[objeto]" },
        { "hebraico": "נֶ֖פֶשׁ", "transliteral": "ne-p̄eš", "traducao_palavra": "[a] alma/vida de" },
        { "hebraico": "בְּעָלָ֣יו", "transliteral": "bə-ʿā-lāyw", "traducao_palavra": "seus donos/possuidores" },
