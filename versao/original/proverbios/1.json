        { "hebraico": "יֶאֱתֶ֑ה", "transliteral": "ye-ʾĕ-ṯeh", "traducao_palavra": "virá" },
        { "hebraico": "בְּבֹ֥א", "transliteral": "bə-ḇō", "traducao_palavra": "no vir" },
        { "hebraico": "עֲ֝לֵיכֶ֗ם", "transliteral": "ʿă-lê-ḵem", "traducao_palavra": "sobre vós" },
