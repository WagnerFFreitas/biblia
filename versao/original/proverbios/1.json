        { "hebraico": "יִ֝צְפְּנ֗וּ", "transliteral": "yiṣ-pə-nû", "traducao_palavra": "espreitam" },
        { "hebraico": "לְנַפְשֹׁתָֽם׃", "transliteral": "lə-nap̄-šō-ṯām", "traducao_palavra": "pelas vidas deles" }
      ]
    },
    "19": {
      "traducao_completa": "Tais são as veredas de todo aquele que é dado à cobiça; ela tira a vida de quem a possui.",
