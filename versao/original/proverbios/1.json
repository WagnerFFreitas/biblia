  "versiculos": {
    "1": {
      "traducao_completa": "Provérbios de Salomão, filho de Davi, rei de Israel:",
      "palavras": [
        { "hebraico": "מִשְׁלֵי", "transliteral": "miš-lê", "traducao_palavra": "provérbios de" },
        { "hebraico": "שְׁלֹמֹה", "transliteral": "šə-lō-mōh", "traducao_palavra": "Salomão" },
        { "hebraico": "בֶן־", "transliteral": "ben-", "traducao_palavra": "filho de" },
        { "hebraico": "דָּוִד", "transliteral": "dā-wiḏ", "traducao_palavra": "Davi" },
        { "hebraico": "מֶלֶךְ", "transliteral": "me-leḵ", "traducao_palavra": "rei de" },
        { "hebraico": "יִשְׂרָאֵל׃", "transliteral": "yiś-rā-ʾēl", "traducao_palavra": "Israel" }
      ]
    },
    "2": {
      "traducao_completa": "Para se conhecer a sabedoria e a instrução; para entender as palavras de inteligência;",
      "palavras": [
        { "hebraico": "לָדַעַת", "transliteral": "lā-ḏa-ʿaṯ", "traducao_palavra": "para conhecer" },
        { "hebraico": "חָכְמָה", "transliteral": "ḥāḵ-mā", "traducao_palavra": "sabedoria" },
        { "hebraico": "וּמוּסָר", "transliteral": "ū-mû-śār", "traducao_palavra": "e instrução/disciplina" },
        { "hebraico": "לְהָבִין", "transliteral": "lə-hā-ḇîn", "traducao_palavra": "para entender" },
        { "hebraico": "אִמְרֵי", "transliteral": "ʾim-rê", "traducao_palavra": "palavras de" },
        { "hebraico": "בִינָה׃", "transliteral": "ḇî-nā", "traducao_palavra": "entendimento/inteligência" }
      ]
    },
    "3": {
      "traducao_completa": "Para receber a instrução do bom senso, a justiça, o juízo e a equidade;",
      "palavras": [
        { "hebraico": "לָקַחַת", "transliteral": "lā-qa-ḥaṯ", "traducao_palavra": "para receber/tomar" },
        { "hebraico": "מוּסַר", "transliteral": "mû-śar", "traducao_palavra": "instrução de" },
        { "hebraico": "הַשְׂכֵּל", "transliteral": "haś-kēl", "traducao_palavra": "prudência/bom senso" },
        { "hebraico": "צֶדֶק", "transliteral": "ṣe-ḏeq", "traducao_palavra": "justiça" },
        { "hebraico": "וּמִשְׁפָּט", "transliteral": "ū-miš-pāṭ", "traducao_palavra": "e juízo" },
        { "hebraico": "וּמֵישָׁרִים׃", "transliteral": "ū-mê-šā-rîm", "traducao_palavra": "e equidade/retidão" }
      ]
    },
    "4": {
      "traducao_completa": "Para dar aos simples prudência, e aos jovens conhecimento e discrição.",
      "palavras": [
        { "hebraico": "לָתֵת", "transliteral": "lā-ṯēṯ", "traducao_palavra": "para dar" },
        { "hebraico": "לִפְתָאיִם", "transliteral": "lip̄-ṯā-yim", "traducao_palavra": "aos simples/ingênuos" },
        { "hebraico": "עָרְמָה", "transliteral": "ʿār-mā", "traducao_palavra": "astúcia/prudência" },
        { "hebraico": "לְנַעַר", "transliteral": "lə-na-ʿar", "traducao_palavra": "ao jovem" },
        { "hebraico": "דַּעַת", "transliteral": "da-ʿaṯ", "traducao_palavra": "conhecimento" },
        { "hebraico": "וּמְזִמָּה׃", "transliteral": "ū-mə-zim-mā", "traducao_palavra": "e discrição/planejamento" }
      ]
    },
    "5": {
      "traducao_completa": "O sábio ouvirá e crescerá em sabedoria, e o instruído adquirirá sábios conselhos;",
      "palavras": [
        { "hebraico": "יִשְׁמַע", "transliteral": "yiš-maʿ", "traducao_palavra": "ouvirá" },
        { "hebraico": "חָכָם", "transliteral": "ḥā-ḵām", "traducao_palavra": "[o] sábio" },
        { "hebraico": "וְיֹוסֶף", "transliteral": "wə-yô-sep̄", "traducao_palavra": "e aumentará" },
        { "hebraico": "לֶקַח", "transliteral": "le-qaḥ", "traducao_palavra": "aprendizado/sabedoria" },
        { "hebraico": "וְנָבֹון", "transliteral": "wə-nā-ḇôn", "traducao_palavra": "e o entendido" },
        { "hebraico": "תַּחְבֻּלֹות", "transliteral": "taḥ-bu-lôṯ", "traducao_palavra": "direções/conselhos" },
        { "hebraico": "יִקְנֶה׃", "transliteral": "yiq-neh", "traducao_palavra": "adquirirá" }
      ]
    },
    "6": {
      "traducao_completa": "Para entender provérbios e enigmas, as palavras dos sábios e os seus conceitos obscuros.",
      "palavras": [
        { "hebraico": "לְהָבִין", "transliteral": "lə-hā-ḇîn", "traducao_palavra": "para entender" },
        { "hebraico": "מָשָׁל", "transliteral": "mā-šāl", "traducao_palavra": "provérbio" },
        { "hebraico": "וּמְלִיצָה", "transliteral": "ū-mə-lî-ṣā", "traducao_palavra": "e sátira/enigma" },
        { "hebraico": "דִּבְרֵי", "transliteral": "diḇ-rê", "traducao_palavra": "palavras de" },
        { "hebraico": "חֲכָמִים", "transliteral": "ḥă-ḵā-mîm", "traducao_palavra": "sábios" },
        { "hebraico": "וְחִידֹתָם׃", "transliteral": "wə-ḥî-ḏō-ṯām", "traducao_palavra": "e enigmas deles" }
      ]
    },
    "7": {
      "traducao_completa": "O temor de YHWH é o princípio do conhecimento; os loucos desprezam a sabedoria e a instrução.",
