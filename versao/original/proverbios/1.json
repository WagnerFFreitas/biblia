        { "hebraico": "בְּבֹ֣א", "transliteral": "bə-ḇō", "traducao_palavra": "no vir/chegar" },
        { "hebraico": "פַחְדְּכֶֽם׃", "transliteral": "p̄aḥ-də-ḵem", "traducao_palavra": "vosso terror/temor" }
      ]
    },
    "27": {
      "traducao_completa": "Vindo como assolação o vosso temor, e vindo a vossa perdição como tormenta, sobrevindo-vos aperto e angústia.",
      "palavras": [
