        { "hebraico": "כָּל־", "transliteral": "kāl-", "traducao_palavra": "toda" },
        { "hebraico": "הֹון", "transliteral": "hôn", "traducao_palavra": "fazenda/riqueza" },
        { "hebraico": "יָקָר", "transliteral": "yā-qār", "traducao_palavra": "preciosa" },
        { "hebraico": "נִמְצָא", "transliteral": "nim-ṣā", "traducao_palavra": "acharemos" },
        { "hebraico": "נְמַלֵּא", "transliteral": "nə-mal-lē", "traducao_palavra": "encheremos" },
        { "hebraico": "בָתֵּינוּ", "transliteral": "bāt-tê-nû", "traducao_palavra": "nossas casas" },
        { "hebraico": "שָׁלָל׃", "transliteral": "šā-lāl", "traducao_palavra": "[com] despojo" }
      ]
    },
    "14": {
      "traducao_completa": "Lança a tua sorte entre nós; teremos todos uma só bolsa.",
      "palavras": [
        { "hebraico": "גֹּורָלְךָ", "transliteral": "ḡô-rā-lə-ḵā", "traducao_palavra": "tua sorte" },
        { "hebraico": "תַּפִּיל", "transliteral": "tap-pîl", "traducao_palavra": "lança" },
        { "hebraico": "בְּתֹוכֵנוּ", "transliteral": "bə-ṯô-ḵê-nû", "traducao_palavra": "no meio de nós" },
