        { "hebraico": "הָרָ֑שֶׁת", "transliteral": "ha-rā-šeṯ", "traducao_palavra": "a rede" },
        { "hebraico": "בְּ֝עֵינֵ֗י", "transliteral": "bə-ʿê-nê", "traducao_palavra": "aos olhos de" },
        { "hebraico": "כָּל־", "transliteral": "kāl-", "traducao_palavra": "toda/qualquer" },
        { "hebraico": "בַּ֥עַל", "transliteral": "ba-ʿal", "traducao_palavra": "dono de" },
        { "hebraico": "כָּנָֽף׃", "transliteral": "kā-nāp̄", "traducao_palavra": "asa [ave]" }
      ]
