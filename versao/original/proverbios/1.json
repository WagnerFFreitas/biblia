    "20": {
      "traducao_completa": "A suprema sabedoria clama lá fora; nas praças levanta a sua voz.",
      "palavras": [
        { "hebraico": "חָכְמֹ֥ות", "transliteral": "ḥāḵ-môṯ", "traducao_palavra": "sabedorias [plural majestático]" },
        { "hebraico": "בַּח֣וּץ", "transliteral": "ba-ḥûṣ", "traducao_palavra": "na rua/lá fora" },
        { "hebraico": "תָּרֹ֑נָּה", "transliteral": "tā-rōn-nā", "traducao_palavra": "ela clama alto" },
        { "hebraico": "בָּ֝רְחֹבֹ֗ות", "transliteral": "ba-rə-ḥō-ḇôṯ", "traducao_palavra": "nas praças/largos" },
        { "hebraico": "תִּתֵּ֥ן", "transliteral": "tit-tēn", "traducao_palavra": "ela dá/emite" },
