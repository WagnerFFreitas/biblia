        { "hebraico": "עַד־", "transliteral": "ʿaḏ-", "traducao_palavra": "até" },
        { "hebraico": "מָתַ֨י ׀", "transliteral": "mā-ṯay", "traducao_palavra": "quando" },
        { "hebraico": "פְּתָיִם֮", "transliteral": "pə-ṯā-yim", "traducao_palavra": "[ó] simples" },
        { "hebraico": "תְּאֵהֲב֫וּ", "transliteral": "tə-ʾē-hă-ḇû", "traducao_palavra": "amareis" },
        { "hebraico": "פֶ֥תִי", "transliteral": "pe-ṯî", "traducao_palavra": "simplicidade" },
        { "hebraico": "וְלֵצִ֗ים", "transliteral": "wə-lē-ṣîm", "traducao_palavra": "e escarnecedores" },
        { "hebraico": "לָ֭צֹון", "transliteral": "lā-ṣôn", "traducao_palavra": "[o] escárnio" },
        { "hebraico": "חָמְד֣וּ", "transliteral": "ḥā-mə-ḏû", "traducao_palavra": "desejarão" },
        { "hebraico": "לָהֶ֑ם", "transliteral": "lā-hem", "traducao_palavra": "para si" },
        { "hebraico": "וּ֝כְסִילִ֗ים", "transliteral": "ū-ḵə-śî-lîm", "traducao_palavra": "e tolos" },
        { "hebraico": "יִשְׂנְאוּ־", "transliteral": "yiś-nə-ʾû-", "traducao_palavra": "odiarão" },
        { "hebraico": "דָֽעַת׃", "transliteral": "dā-ʿaṯ", "traducao_palavra": "conhecimento" }
      ]
    },
    "23": {
      "traducao_completa": "Convertei-vos pela minha repreensão; eis que abundantemente derramarei sobre vós o meu espírito e vos farei saber as minhas palavras.",
      "palavras": [
        { "hebraico": "תָּשׁ֗וּבוּ", "transliteral": "tā-šû-ḇû", "traducao_palavra": "voltai/convertei-vos" },
        { "hebraico": "לְתֹ֫וכַחְתִּ֥י", "transliteral": "lə-ṯô-ḵaḥ-tî", "traducao_palavra": "para minha repreensão" },
        { "hebraico": "הִנֵּ֤ה", "transliteral": "hin-nēh", "traducao_palavra": "eis que" },
        { "hebraico": "אַבִּ֨יעָה", "transliteral": "ʾab-bî-ʿā", "traducao_palavra": "jorrarei/derramarei" },
        { "hebraico": "לָכֶ֥ם", "transliteral": "lā-ḵem", "traducao_palavra": "a vós" },
        { "hebraico": "רוּחִ֑י", "transliteral": "rû-ḥî", "traducao_palavra": "meu espírito" },
        { "hebraico": "אֹודִ֖יעָה", "transliteral": "ʾô-ḏî-ʿā", "traducao_palavra": "farei saber" },
        { "hebraico": "דְבָרַ֣י", "transliteral": "də-ḇā-ray", "traducao_palavra": "minhas palavras" },
        { "hebraico": "אֶתְכֶֽם׃", "transliteral": "ʾeṯ-ḵem", "traducao_palavra": "a vós" }
      ]
    },
    "24": {
      "traducao_completa": "Pois clamei, e vós recusastes; estendi a minha mão, e não houve quem atendesse;",
      "palavras": [
        { "hebraico": "יַ֤עַן", "transliteral": "ya-ʿan", "traducao_palavra": "porquanto/visto que" },
        { "hebraico": "קָרָ֨אתִי", "transliteral": "qā-rā-ṯî", "traducao_palavra": "clamei" },
        { "hebraico": "וַתְּמָ֘אֵ֭נוּ", "transliteral": "wat-tə-mā-ʾê-nû", "traducao_palavra": "e recusastes" },
        { "hebraico": "נָטִ֥יתִי", "transliteral": "nā-ṭî-ṯî", "traducao_palavra": "estendi" },
        { "hebraico": "יָ֝דִ֗י", "transliteral": "yā-ḏî", "traducao_palavra": "minha mão" },
        { "hebraico": "וְאֵין", "transliteral": "wə-ʾên", "traducao_palavra": "e não [houve]" },
        { "hebraico": "מַקְשִֽׁיב׃", "transliteral": "maq-šîḇ", "traducao_palavra": "quem atendesse" }
      ]
    },
    "25": {
      "traducao_completa": "Antes, rejeitastes todo o meu conselho, e não quisestes a minha repreensão.",
      "palavras": [
        { "hebraico": "וַתִּפְרְע֥וּ", "transliteral": "wat-tip̄-rə-ʿû", "traducao_palavra": "e soltastes/rejeitastes" },
        { "hebraico": "כָל־", "transliteral": "kāl-", "traducao_palavra": "todo" },
        { "hebraico": "עֲצָתִ֑י", "transliteral": "ʿă-ṣā-ṯî", "traducao_palavra": "meu conselho" },
        { "hebraico": "וְ֝תֹוכַחְתִּ֗י", "transliteral": "wə-ṯô-ḵaḥ-tî", "traducao_palavra": "e minha repreensão" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
