      ]
    },
    "15": {
      "traducao_completa": "Filho meu, não andes no caminho com eles; aparta o teu pé das suas veredas.",
      "palavras": [
        { "hebraico": "בְּנִי", "transliteral": "bə-nî", "traducao_palavra": "filho meu" },
        { "hebraico": "אַל־", "transliteral": "ʾal-", "traducao_palavra": "não" },
        { "hebraico": "תֵּלֵךְ", "transliteral": "tē-lēḵ", "traducao_palavra": "andes" },
        { "hebraico": "בְּדֶרֶךְ", "transliteral": "bə-ḏe-reḵ", "traducao_palavra": "no caminho" },
        { "hebraico": "אִתָּם", "transliteral": "ʾit-tām", "traducao_palavra": "com eles" },
        { "hebraico": "מְנַע", "transliteral": "mə-naʿ", "traducao_palavra": "retém/aparta" },
        { "hebraico": "רַגְלְךָ", "transliteral": "raḡ-lə-ḵā", "traducao_palavra": "teu pé" },
        { "hebraico": "מִנְּתִיבָתָם׃", "transliteral": "min-nə-ṯî-ḇā-ṯām", "traducao_palavra": "das veredas deles" }
      ]
    },
    "16": {
      "traducao_completa": "Porque os seus pés correm para o mal, e se apressam a derramar sangue.",
      "palavras": [
        { "hebraico": "כִּ֣י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "רַגְלֵיהֶם֮", "transliteral": "raḡ-lê-hem", "traducao_palavra": "pés deles" },
        { "hebraico": "לָרַ֪ע", "transliteral": "lā-raʿ", "traducao_palavra": "para o mal" },
        { "hebraico": "יָ֫ר֥וּצוּ", "transliteral": "yā-rû-ṣû", "traducao_palavra": "correm" },
        { "hebraico": "וִֽ֝ימַהֲר֗וּ", "transliteral": "wî-ma-hă-rû", "traducao_palavra": "e se apressam" },
        { "hebraico": "לִשְׁפָּךְ־", "transliteral": "liš-pak-", "traducao_palavra": "para derramar" },
        { "hebraico": "דָּֽם׃", "transliteral": "dām", "traducao_palavra": "sangue" }
      ]
    },
    "17": {
      "traducao_completa": "Pois debalde se estende a rede à vista de qualquer ave.",
      "palavras": [
        { "hebraico": "כִּֽי־", "transliteral": "kî-", "traducao_palavra": "pois" },
        { "hebraico": "חִנָּ֥ם", "transliteral": "ḥin-nām", "traducao_palavra": "debalde/em vão" },
