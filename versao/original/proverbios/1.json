        { "hebraico": "מְשׁוּבַ֣ת", "transliteral": "mə-šû-ḇaṯ", "traducao_palavra": "[o] retrocesso/desvio de" },
        { "hebraico": "פְּתָיִ֣ם", "transliteral": "pə-ṯā-yim", "traducao_palavra": "simples" },
        { "hebraico": "תַּהֲרֹגֵ֑ם", "transliteral": "ta-hă-rō-ḡēm", "traducao_palavra": "matará os" },
        { "hebraico": "וְשַׁלְוַ֥ת", "transliteral": "wə-šal-waṯ", "traducao_palavra": "e a segurança/tranquilidade de" },
