        { "hebraico": "יִרְאַת", "transliteral": "yir-ʾaṯ", "traducao_palavra": "o temor de" },
        { "hebraico": "יְהוָה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "רֵאשִׁית", "transliteral": "rē-šîṯ", "traducao_palavra": "[é o] princípio de" },
        { "hebraico": "דָּעַת", "transliteral": "dā-ʿaṯ", "traducao_palavra": "conhecimento" },
        { "hebraico": "חָכְמָה", "transliteral": "ḥāḵ-mā", "traducao_palavra": "sabedoria" },
        { "hebraico": "וּמוּסָר", "transliteral": "ū-mû-śār", "traducao_palavra": "e instrução" },
        { "hebraico": "אֱוִילִים", "transliteral": "ʾĕ-wî-lîm", "traducao_palavra": "[os] tolos" },
        { "hebraico": "בָּזוּ׃", "transliteral": "bā-zû", "traducao_palavra": "desprezaram" }
      ]
    },
    "8": {
      "traducao_completa": "Filho meu, ouve a instrução de teu pai e não deixes a lei de tua mãe.",
      "palavras": [
        { "hebraico": "שְׁמַע", "transliteral": "šə-maʿ", "traducao_palavra": "ouve" },
        { "hebraico": "בְּנִי", "transliteral": "bə-nî", "traducao_palavra": "filho meu" },
        { "hebraico": "מוּסַר", "transliteral": "mû-śar", "traducao_palavra": "[a] instrução de" },
        { "hebraico": "אָבִיךָ", "transliteral": "ʾā-ḇî-ḵā", "traducao_palavra": "teu pai" },
        { "hebraico": "וְאַל־", "transliteral": "wə-ʾal-", "traducao_palavra": "e não" },
        { "hebraico": "תִּטֹּשׁ", "transliteral": "tit-ṭōš", "traducao_palavra": "rejeites/abandones" },
        { "hebraico": "תֹּורַת", "transliteral": "tô-raṯ", "traducao_palavra": "[a] lei de" },
        { "hebraico": "אִמֶּךָ׃", "transliteral": "ʾim-me-ḵā", "traducao_palavra": "tua mãe" }
      ]
    },
    "9": {
      "traducao_completa": "Porque serão um diadema de graça para a tua cabeça e colares para o teu pescoço.",
      "palavras": [
        { "hebraico": "כִּ֤י ׀", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "לִוְיַת", "transliteral": "liw-yaṯ", "traducao_palavra": "diadema/adorno de" },
        { "hebraico": "חֵן", "transliteral": "ḥēn", "traducao_palavra": "graça" },
        { "hebraico": "הֵם", "transliteral": "hēm", "traducao_palavra": "[são] eles" },
        { "hebraico": "לְרֹאשֶׁךָ", "transliteral": "lə-rō-še-ḵā", "traducao_palavra": "para tua cabeça" },
        { "hebraico": "וַעֲנָקִים", "transliteral": "wa-ʿă-nā-qîm", "traducao_palavra": "e colares" },
        { "hebraico": "לְגַרְגְּרֹתֶיךָ׃", "transliteral": "lə-ḡar-gə-rō-ṯey-ḵā", "traducao_palavra": "para teu pescoço" }
      ]
    },
    "10": {
      "traducao_completa": "Filho meu, se os pecadores te quiserem seduzir, não consintas.",
      "palavras": [
        { "hebraico": "בְּנִי", "transliteral": "bə-nî", "traducao_palavra": "filho meu" },
        { "hebraico": "אִם־", "transliteral": "ʾim-", "traducao_palavra": "se" },
        { "hebraico": "יְפַתּוּךָ", "transliteral": "yə-p̄at-tû-ḵā", "traducao_palavra": "seduzirem te" },
        { "hebraico": "חַטָּאִים", "transliteral": "ḥaṭ-ṭā-ʾîm", "traducao_palavra": "pecadores" },
        { "hebraico": "אַל־", "transliteral": "ʾal-", "traducao_palavra": "não" },
        { "hebraico": "תֹּאבֵא׃", "transliteral": "tō-ḇē", "traducao_palavra": "consintas/queiras" }
      ]
    },
    "11": {
      "traducao_completa": "Se disserem: Vem conosco, embosquemo-nos para derramar sangue; espreitemos sem causa o inocente;",
      "palavras": [
        { "hebraico": "אִם־", "transliteral": "ʾim-", "traducao_palavra": "se" },
        { "hebraico": "יֹאמְרוּ", "transliteral": "yō-mə-rû", "traducao_palavra": "disserem" },
        { "hebraico": "לְכָה", "transliteral": "lə-ḵā", "traducao_palavra": "vem" },
        { "hebraico": "אִתָּנוּ", "transliteral": "ʾit-tā-nû", "traducao_palavra": "conosco" },
        { "hebraico": "נֶאֶרְבָה", "transliteral": "ne-ʾer-ḇā", "traducao_palavra": "embosquemo-nos" },
        { "hebraico": "לְדָם", "transliteral": "lə-ḏām", "traducao_palavra": "para sangue" },
        { "hebraico": "נִצְפְּנָה", "transliteral": "niṣ-pə-nā", "traducao_palavra": "espreitemos" },
        { "hebraico": "לְנָקִי", "transliteral": "lə-nā-qî", "traducao_palavra": "ao inocente" },
        { "hebraico": "חִנָּם׃", "transliteral": "ḥin-nām", "traducao_palavra": "sem causa" }
      ]
    },
    "12": {
      "traducao_completa": "Traguemo-los vivos, como o Sheol, e inteiros, como os que descem à cova;",
      "palavras": [
        { "hebraico": "נִבְלָעֵם", "transliteral": "niḇ-lā-ʿēm", "traducao_palavra": "traguemo-los" },
        { "hebraico": "כִּשְׁאֹול", "transliteral": "ki-šə-ʾôl", "traducao_palavra": "como Sheol" },
        { "hebraico": "חַיִּים", "transliteral": "ḥay-yîm", "traducao_palavra": "vivos" },
        { "hebraico": "וּתְמִימִים", "transliteral": "ū-ṯə-mî-mîm", "traducao_palavra": "e inteiros" },
        { "hebraico": "כְּיֹורְדֵי", "transliteral": "kə-yôr-ḏê", "traducao_palavra": "como os que descem" },
