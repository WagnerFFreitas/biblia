        { "hebraico": "דָ֑עַת", "transliteral": "dā-ʿaṯ", "traducao_palavra": "conhecimento" },
        { "hebraico": "וְיִרְאַ֥ת", "transliteral": "wə-yir-ʾaṯ", "traducao_palavra": "e o temor de" },
