    "21": {
      "traducao_completa": "No topo das ruas ruidosas clama; nas entradas das portas da cidade profere as suas palavras:",
      "palavras": [
        { "hebraico": "בְּרֹ֥אשׁ", "transliteral": "bə-rōš", "traducao_palavra": "no topo de" },
        { "hebraico": "הֹמִיֹּ֗ות", "transliteral": "hō-mi-yyôṯ", "traducao_palavra": "[ruas] ruidosas" },
        { "hebraico": "תִּ֫קְרָ֥א", "transliteral": "tiq-rā", "traducao_palavra": "ela clama" },
        { "hebraico": "בְּפִתְחֵ֖י", "transliteral": "bə-p̄iṯ-ḥê", "traducao_palavra": "nas aberturas de" },
        { "hebraico": "שְׁעָרִ֥ים", "transliteral": "šə-ʿā-rîm", "traducao_palavra": "portões" },
        { "hebraico": "בָּעִ֣יר", "transliteral": "bā-ʿîr", "traducao_palavra": "na cidade" },
        { "hebraico": "אֲמָרֶ֣יהָ", "transliteral": "ʾă-mā-re-hā", "traducao_palavra": "suas palavras" },
        { "hebraico": "תֹאמֵֽר׃", "transliteral": "tō-mēr", "traducao_palavra": "ela diz" }
      ]
    },
    "22": {
      "traducao_completa": "Até quando, ó simples, amareis a simplicidade? E vós, escarnecedores, desejareis o escárnio? E vós, loucos, odiareis o conhecimento?",
