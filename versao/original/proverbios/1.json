        { "hebraico": "כְשֹׁואָ֨ה ׀", "transliteral": "ḵə-šô-ʾā", "traducao_palavra": "como assolação/ruína" },
        { "hebraico": "פַחְדְּכֶ֗ם", "transliteral": "p̄aḥ-də-ḵem", "traducao_palavra": "vosso terror" },
        { "hebraico": "וְ֭אֵידְכֶם", "transliteral": "wə-ʾê-ḏə-ḵem", "traducao_palavra": "e vossa calamidade" },
