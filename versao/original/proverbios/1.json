        { "hebraico": "תֹּוכַחְתִּֽי׃", "transliteral": "tô-ḵaḥ-tî", "traducao_palavra": "minha repreensão" }
      ]
    },
    "31": {
      "traducao_completa": "Portanto comerão do fruto do seu caminho e fartar-se-ão dos seus próprios conselhos.",
