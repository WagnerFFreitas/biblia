        { "hebraico": "טֹ֑וב", "transliteral": "ṭôḇ", "traducao_palavra": "bem" },
        { "hebraico": "תִּקְוַ֖ת", "transliteral": "tiq-waṯ", "traducao_palavra": "a expectativa de" },
