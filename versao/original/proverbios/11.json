        { "hebraico": "וּמְרַדֵּ֖ף", "transliteral": "ū-mə-rad-dēp̄", "traducao_palavra": "mas o que persegue" },
        { "hebraico": "רָעָ֣ה", "transliteral": "rā-ʿā", "traducao_palavra": "mal" },
