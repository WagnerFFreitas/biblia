        { "hebraico": "עֵ֣ץ", "transliteral": "ʿêṣ", "traducao_palavra": "[é] árvore de" },
        { "hebraico": "חַיִּ֑ים", "transliteral": "ḥay-yîm", "traducao_palavra": "vida" },
