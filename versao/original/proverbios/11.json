        { "hebraico": "יִנָּקֶ֣ה", "transliteral": "yin-nā-qeh", "traducao_palavra": "será limpo/impune" },
        { "hebraico": "רָּ֑ע", "transliteral": "rā", "traducao_palavra": "[o] mau" },
        { "hebraico": "וְזֶ֖רַע", "transliteral": "wə-ze-raʿ", "traducao_palavra": "mas a semente de" },
