        { "hebraico": "לֵ֑ב", "transliteral": "lēḇ", "traducao_palavra": "coração" },
        { "hebraico": "וּרְצֹונֹ֗ו", "transliteral": "ū-rə-ṣô-nô", "traducao_palavra": "mas o prazer dele [são]" },
