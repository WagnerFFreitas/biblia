      ]
    },
    "10": {
      "traducao_completa": "O que faz com que os retos errem por um mau caminho, ele mesmo cairá na sua cova, mas os íntegros herdarão o bem.",
      "palavras": [
        { "hebraico": "מַשְׁגֶּ֤ה", "transliteral": "maš-geh", "traducao_palavra": "O que faz errar" },
        { "hebraico": "יְשָׁרִ֨ים ׀", "transliteral": "yə-šā-rîm", "traducao_palavra": "[os] retos" },
        { "hebraico": "בְּדֶ֥רֶךְ", "transliteral": "bə-ḏe-reḵ", "traducao_palavra": "em caminho" },
        { "hebraico": "רָ֗ע", "transliteral": "rāʿ", "traducao_palavra": "mau" },
