        { "hebraico": "וּבְתַרְבִּ֑ית", "transliteral": "ū-ḇə-ṯar-bît", "traducao_palavra": "e com juros/lucro" },
        { "hebraico": "לְחֹונֵ֖ן", "transliteral": "lə-ḥô-nên", "traducao_palavra": "para o que se compadece de" },
