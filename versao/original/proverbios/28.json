    },
    "15": {
      "traducao_completa": "Como leão rugidor e urso faminto, assim é o ímpio que domina sobre um povo pobre.",
      "palavras": [
        { "hebraico": "אֲרִי־", "transliteral": "ʾă-rî-", "traducao_palavra": "[Como] leão" },
        { "hebraico": "נֹ֭הֵם", "transliteral": "nō-hēm", "traducao_palavra": "rugidor" },
        { "hebraico": "וְדֹ֣ב", "transliteral": "wə-ḏōḇ", "traducao_palavra": "e urso" },
        { "hebraico": "שֹׁוקֵ֑ק", "transliteral": "šô-qēq", "traducao_palavra": "faminto/que investe" },
