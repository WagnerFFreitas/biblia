        { "hebraico": "יִנְחֲלוּ־", "transliteral": "yin-ḥă-lû-", "traducao_palavra": "herdarão" },
        { "hebraico": "טֹֽוב׃", "transliteral": "ṭôḇ", "traducao_palavra": "[o] bem" }
      ]
    },
    "11": {
      "traducao_completa": "O homem rico é sábio aos seus próprios olhos, mas o pobre que é entendido o esquadrinha.",
      "palavras": [
        { "hebraico": "חָכָ֣ם", "transliteral": "ḥā-ḵām", "traducao_palavra": "Sábio" },
        { "hebraico": "בְּ֭עֵינָיו", "transliteral": "bə-ʿê-nāyw", "traducao_palavra": "em seus olhos" },
