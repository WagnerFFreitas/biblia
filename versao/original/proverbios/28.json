        { "hebraico": "תְּבוּנֹות", "transliteral": "tə-ḇû-nôṯ", "traducao_palavra": "entendimentos" },
        { "hebraico": "וְרַב", "transliteral": "wə-raḇ", "traducao_palavra": "e muito em" },
