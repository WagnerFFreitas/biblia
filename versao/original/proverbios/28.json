      ]
    },
    "7": {
      "traducao_completa": "O que guarda a instrução é filho entendido, mas o companheiro de glutões envergonha a seu pai.",
      "palavras": [
        { "hebraico": "נֹוצֵ֣ר", "transliteral": "nō-ṣēr", "traducao_palavra": "O que guarda" },
