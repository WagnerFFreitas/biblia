{
  "livro": "Provérbios - מִשְׁלֵי - Mishlei",
  "capítulo": 28,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Fugem os ímpios sem que ninguém os persiga, mas os justos são ousados como o leão.",
      "palavras": [
        { "hebraico": "נָ֭סוּ", "transliteral": "nā-sû", "traducao_palavra": "Fugiram" },
        { "hebraico": "וְאֵין־", "transliteral": "wə-ʾên-", "traducao_palavra": "e não [havendo]" },
        { "hebraico": "רֹדֵ֣ף", "transliteral": "rō-ḏēp̄", "traducao_palavra": "perseguidor" },
        { "hebraico": "רָשָׁ֑ע", "transliteral": "rā-šāʿ", "traducao_palavra": "[o] ímpio" },
        { "hebraico": "וְ֝צַדִּיקִ֗ים", "transliteral": "wə-ṣad-dî-qîm", "traducao_palavra": "mas os justos" },
        { "hebraico": "כִּכְפִ֥יר", "transliteral": "kiḵ-p̄îr", "traducao_palavra": "como leão novo" },
        { "hebraico": "יִבְטָֽח׃", "transliteral": "yiḇ-ṭāḥ", "traducao_palavra": "estão confiantes/seguros" }
      ]
    },
    "2": {
      "traducao_completa": "Por causa da transgressão da terra, muitos são os seus príncipes; mas por um homem entendido e sábio, a sua estabilidade se prolongará.",
      "palavras": [
        { "hebraico": "בְּפֶ֣שַׁע", "transliteral": "bə-p̄e-šaʿ", "traducao_palavra": "Pela transgressão de" },
        { "hebraico": "אֶ֭רֶץ", "transliteral": "ʾe-reṣ", "traducao_palavra": "[uma] terra" },
        { "hebraico": "רַבִּ֣ים", "transliteral": "rab-bîm", "traducao_palavra": "muitos [são]" },
        { "hebraico": "שָׂרֶ֑יהָ", "transliteral": "śā-re-y-hā", "traducao_palavra": "seus príncipes" },
        { "hebraico": "וּבְאָדָ֥ם", "transliteral": "ū-ḇə-ʾā-ḏām", "traducao_palavra": "mas por um homem" },
        { "hebraico": "נָ֝בֹ֗ון", "transliteral": "nā-ḇôn", "traducao_palavra": "entendido" },
        { "hebraico": "יֹ֘דֵ֤עַ", "transliteral": "yō-ḏē-aʿ", "traducao_palavra": "[que] conhece" },
        { "hebraico": "כֵּ֣ן", "transliteral": "kên", "traducao_palavra": "assim" },
        { "hebraico": "יַאֲרִֽיךְ׃", "transliteral": "ya-ʾă-rîḵ", "traducao_palavra": "prolongará [a ordem]" }
      ]
    },
    "3": {
      "traducao_completa": "O homem pobre que oprime os necessitados é como chuva impetuosa que não deixa pão.",
      "palavras": [
        { "hebraico": "גֶּ֣בֶר", "transliteral": "ge-ḇer", "traducao_palavra": "Homem" },
        { "hebraico": "רָ֭שׁ", "transliteral": "rāš", "traducao_palavra": "pobre" },
        { "hebraico": "וְעֹשֵׁ֣ק", "transliteral": "wə-ʿō-šēq", "traducao_palavra": "e oprime" },
        { "hebraico": "דַּלִּ֑ים", "transliteral": "dal-lîm", "traducao_palavra": "necessitados" },
        { "hebraico": "מָטָ֥ר", "transliteral": "mā-ṭār", "traducao_palavra": "[é como] chuva" },
        { "hebraico": "סֹ֝חֵ֗ף", "transliteral": "śō-ḥêp̄", "traducao_palavra": "impetuosa/que arrasta" },
        { "hebraico": "וְאֵ֣ין", "transliteral": "wə-ʾên", "traducao_palavra": "e não [há]" },
        { "hebraico": "לָֽחֶם׃", "transliteral": "lā-ḥem", "traducao_palavra": "pão/alimento" }
      ]
    },
    "4": {
      "traducao_completa": "Os que abandonam a instrução louvam o ímpio, mas os que guardam a instrução lutam contra eles.",
      "palavras": [
