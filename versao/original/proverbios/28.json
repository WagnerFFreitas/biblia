        { "hebraico": "יַצְלִ֑יחַ", "transliteral": "yaṣ-lî-aḥ", "traducao_palavra": "prosperará" },
        { "hebraico": "וּמֹודֶ֖ה", "transliteral": "ū-mô-ḏeh", "traducao_palavra": "mas o que confessa" },
        { "hebraico": "וְעֹזֵ֣ב", "transliteral": "wə-ʿō-zēḇ", "traducao_palavra": "e deixa" },
        { "hebraico": "יְרֻחָֽם׃", "transliteral": "yə-ru-ḥām", "traducao_palavra": "alcançará misericórdia" }
      ]
    },
    "14": {
      "traducao_completa": "Bem-aventurado o homem que teme continuamente, mas o que endurece o seu coração cairá no mal.",
      "palavras": [
        { "hebraico": "אַשְׁרֵ֥י", "transliteral": "ʾaš-rê", "traducao_palavra": "Bem-aventurado" },
        { "hebraico": "אָ֝דָ֗ם", "transliteral": "ʾā-ḏām", "traducao_palavra": "[o] homem" },
        { "hebraico": "מְפַחֵ֥ד", "transliteral": "mə-p̄a-ḥêḏ", "traducao_palavra": "[que] teme/tem cuidado" },
        { "hebraico": "תָּמִ֑יד", "transliteral": "tā-mîḏ", "traducao_palavra": "continuamente" },
