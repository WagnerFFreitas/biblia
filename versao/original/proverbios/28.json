        { "hebraico": "בָֽם׃", "transliteral": "ḇām", "traducao_palavra": "neles" }
      ]
    },
    "5": {
      "traducao_completa": "Os homens maus não entendem o juízo, mas os que buscam a YHWH entendem tudo.",
