        { "hebraico": "יִקְבְּצֶֽנּוּ׃", "transliteral": "yiq-bə-ṣen-nû", "traducao_palavra": "o ajunta" }
      ]
    },
    "9": {
      "traducao_completa": "O que desvia os seus ouvidos de ouvir a instrução, até a sua oração será abominável.",
      "palavras": [
        { "hebraico": "מֵסִ֣יר", "transliteral": "mê-śîr", "traducao_palavra": "O que desvia" },
        { "hebraico": "אָ֭זְנֹו", "transliteral": "ʾāz-nô", "traducao_palavra": "seu ouvido" },
        { "hebraico": "מִשְּׁמֹ֣עַ", "transliteral": "miš-šə-mō-aʿ", "traducao_palavra": "de ouvir" },
        { "hebraico": "תֹּורָ֑ה", "transliteral": "tô-rā", "traducao_palavra": "[a] lei/instrução" },
