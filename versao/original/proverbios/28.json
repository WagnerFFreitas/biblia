        { "hebraico": "דָּֽל׃", "transliteral": "dāl", "traducao_palavra": "pobre" }
      ]
    },
    "16": {
      "traducao_completa": "O príncipe falto de entendimento é também um grande opressor, mas o que odeia a avareza prolongará os seus dias.",
