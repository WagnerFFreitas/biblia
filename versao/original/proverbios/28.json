        { "hebraico": "מָבִ֑ין", "transliteral": "mā-ḇîn", "traducao_palavra": "entendido" },
        { "hebraico": "וְרֹעֶ֥ה", "transliteral": "wə-rō-ʿeh", "traducao_palavra": "mas o companheiro de" },
