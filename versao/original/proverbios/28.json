        { "hebraico": "יְ֝הוָ֗ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "יָבִ֥ינוּ", "transliteral": "yā-ḇî-nû", "traducao_palavra": "entenderão" },
        { "hebraico": "כֹל׃", "transliteral": "ḵōl", "traducao_palavra": "tudo" }
      ]
    },
    "6": {
      "traducao_completa": "Melhor é o pobre que anda na sua integridade do que o de caminhos perversos, ainda que seja rico.",
      "palavras": [
        { "hebraico": "טֹֽוב־", "transliteral": "ṭôḇ-", "traducao_palavra": "Melhor [é]" },
        { "hebraico": "רָ֭שׁ", "transliteral": "rāš", "traducao_palavra": "[o] pobre" },
        { "hebraico": "הֹולֵ֣ךְ", "transliteral": "hō-lêḵ", "traducao_palavra": "[que] anda" },
        { "hebraico": "בְּתֻמֹּ֑ו", "transliteral": "bə-ṯum-mô", "traducao_palavra": "na sua integridade" },
        { "hebraico": "מֵעִקֵּ֥שׁ", "transliteral": "mê-ʿiq-qēš", "traducao_palavra": "do que o perverso de" },
