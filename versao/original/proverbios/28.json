        { "hebraico": "אָבִֽיו׃", "transliteral": "ʾā-ḇîw", "traducao_palavra": "seu pai" }
      ]
    },
    "8": {
      "traducao_completa": "O que aumenta os seus bens com usura e juros, ajunta-os para o que se compadece do pobre.",
      "palavras": [
        { "hebraico": "מַרְבֶּ֣ה", "transliteral": "mar-beh", "traducao_palavra": "O que aumenta" },
        { "hebraico": "הֹ֭ונֹו", "transliteral": "hō-nô", "traducao_palavra": "sua riqueza" },
