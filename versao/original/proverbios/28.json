    "13": {
      "traducao_completa": "O que encobre as suas transgressões nunca prosperará, mas o que as confessa e deixa, alcançará misericórdia.",
      "palavras": [
        { "hebraico": "מְכַסֶּ֣ה", "transliteral": "mə-ḵas-seh", "traducao_palavra": "O que encobre" },
        { "hebraico": "פְ֭שָׁעָיו", "transliteral": "p̄ə-šā-ʿāyw", "traducao_palavra": "suas transgressões" },
