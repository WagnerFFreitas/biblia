      ]
    },
    "12": {
      "traducao_completa": "Quando os justos exultam, há grande glória; mas quando os ímpios sobem, os homens se escondem.",
      "palavras": [
        { "hebraico": "בַּעֲלֹ֣ץ", "transliteral": "ba-ʿă-lōṣ", "traducao_palavra": "No exultar de" },
        { "hebraico": "צַ֭דִּיקִים", "transliteral": "ṣad-dî-qîm", "traducao_palavra": "justos" },
        { "hebraico": "רַבָּ֣ה", "transliteral": "rab-bā", "traducao_palavra": "grande [é a]" },
        { "hebraico": "תִפְאָ֑רֶת", "transliteral": "ṯip̄-ʾā-reṯ", "traducao_palavra": "glória" },
