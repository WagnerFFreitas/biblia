    },
    "19": {
      "traducao_completa": "O caminho dos ímpios é como a escuridão; nem sabem em que tropeçam.",
      "palavras": [
        { "hebraico": "דֶּ֣רֶךְ", "transliteral": "de-reḵ", "traducao_palavra": "o caminho de" },
        { "hebraico": "רְ֭שָׁעִים", "transliteral": "rə-šā-ʿîm", "traducao_palavra": "ímpios" },
        { "hebraico": "כָּאֲפֵלָ֑ה", "transliteral": "kā-ʾă-p̄ê-lā", "traducao_palavra": "como a escuridão" },
        { "hebraico": "לֹ֥א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "יָ֝דְע֗וּ", "transliteral": "yā-ḏə-ʿû", "traducao_palavra": "sabem" },
        { "hebraico": "בַּמֶּ֥ה", "transliteral": "bam-meh", "traducao_palavra": "em que" },
        { "hebraico": "יִכָּשֵֽׁלוּ׃", "transliteral": "yik-kā-šê-lû", "traducao_palavra": "tropeçam" }
      ]
    },
    "20": {
      "traducao_completa": "Filho meu, atenta para as minhas palavras; às minhas razões inclina o teu ouvido.",
      "palavras": [
        { "hebraico": "בְּ֭נִי", "transliteral": "bə-nî", "traducao_palavra": "filho meu" },
        { "hebraico": "לִדְבָרַ֣י", "transliteral": "liḏ-ḇā-ray", "traducao_palavra": "às minhas palavras" },
        { "hebraico": "הַקְשִׁ֑יבָה", "transliteral": "haq-šî-ḇā", "traducao_palavra": "atenta" },
        { "hebraico": "לַ֝אֲמָרַ֗י", "transliteral": "la-ʾă-mā-ray", "traducao_palavra": "às minhas razões/ditos" },
        { "hebraico": "הַט־", "transliteral": "haṭ-", "traducao_palavra": "inclina" },
        { "hebraico": "אָזְנֶֽךָ׃", "transliteral": "ʾāz-ne-ḵā", "traducao_palavra": "teu ouvido" }
      ]
    },
    "21": {
      "traducao_completa": "Não se apartem elas dos teus olhos; guarda-as no íntimo do teu coração.",
      "palavras": [
        { "hebraico": "אַל־יַלִּ֥יזוּ", "transliteral": "ʾal-yal-lî-zû", "traducao_palavra": "não se apartem" },
        { "hebraico": "מֵעֵינֶ֑יךָ", "transliteral": "mê-ʿê-ne-ḵā", "traducao_palavra": "dos teus olhos" },
        { "hebraico": "שָׁ֝מְרֵ֗ם", "transliteral": "šā-mə-rêm", "traducao_palavra": "guarda-as" },
        { "hebraico": "בְּתֹ֥וךְ", "transliteral": "bə-ṯôḵ", "traducao_palavra": "no meio/dentro de" },
        { "hebraico": "לְבָבֶֽךָ׃", "transliteral": "lə-ḇā-ḇe-ḵā", "traducao_palavra": "teu coração" }
      ]
    },
    "22": {
      "traducao_completa": "Porque são vida para os que as acham, e saúde para todo o seu corpo.",
      "palavras": [
        { "hebraico": "כִּֽי־חַיִּ֣ים", "transliteral": "kî-ḥay-yîm", "traducao_palavra": "porque vida" },
        { "hebraico": "הֵ֭ם", "transliteral": "hêm", "traducao_palavra": "elas [são]" },
        { "hebraico": "לְמֹצְאֵיהֶ֑ם", "transliteral": "lə-mō-ṣə-ʾê-hem", "traducao_palavra": "para os que as acham" },
        { "hebraico": "וּלְכָל־", "transliteral": "ū-lə-ḵāl-", "traducao_palavra": "e para todo" },
        { "hebraico": "בְּשָׂרֹ֥ו", "transliteral": "bə-śā-rô", "traducao_palavra": "seu corpo/carne" },
        { "hebraico": "מַרְפֵּֽא׃", "transliteral": "mar-pê", "traducao_palavra": "saúde/cura" }
      ]
    },
    "23": {
      "traducao_completa": "Sobre tudo o que se deve guardar, guarda o teu coração, porque dele procedem as fontes da vida.",
      "palavras": [
        { "hebraico": "מִֽכָּל־", "transliteral": "mi-kāl", "traducao_palavra": "de tudo/acima de tudo" },
        { "hebraico": "מִ֭שְׁמָר", "transliteral": "miš-mār", "traducao_palavra": "[o que se deve] guardar" },
        { "hebraico": "נְצֹ֥ר", "transliteral": "nə-ṣōr", "traducao_palavra": "guarda" },
        { "hebraico": "לִבֶּ֑ךָ", "transliteral": "lib-be-ḵā", "traducao_palavra": "teu coração" },
        { "hebraico": "כִּֽי־מִ֝מֶּ֗נּוּ", "transliteral": "kî-mim-men-nû", "traducao_palavra": "porque dele" },
        { "hebraico": "תֹּוצְאֹ֥ות", "transliteral": "tô-ṣə-ʾôṯ", "traducao_palavra": "[estão as] saídas/fontes de" },
        { "hebraico": "חַיִּֽים׃", "transliteral": "ḥay-yîm", "traducao_palavra": "vida" }
      ]
    },
    "24": {
      "traducao_completa": "Desvia de ti a falsidade da boca, e afasta de ti a perversidade dos lábios.",
      "palavras": [
        { "hebraico": "הָסֵ֣ר", "transliteral": "hā-sêr", "traducao_palavra": "desvia/remove" },
        { "hebraico": "מִ֭מְּךָ", "transliteral": "mim-mə-ḵā", "traducao_palavra": "de ti" },
        { "hebraico": "עִקְּשׁ֣וּת", "transliteral": "ʿiq-qə-šûṯ", "traducao_palavra": "perversidade/falsidade de" },
        { "hebraico": "פֶּ֑ה", "transliteral": "peh", "traducao_palavra": "boca" },
        { "hebraico": "וּלְז֥וּת", "transliteral": "ū-lə-zûṯ", "traducao_palavra": "e o desvio/perversidade de" },
        { "hebraico": "שְׂ֝פָתַ֗יִם", "transliteral": "śə-p̄ā-ṯa-yim", "traducao_palavra": "lábios" },
        { "hebraico": "הַרְחֵ֥ק", "transliteral": "har-ḥêq", "traducao_palavra": "afasta" },
        { "hebraico": "מִמֶּֽךָּ׃", "transliteral": "mim-mek-kā", "traducao_palavra": "de ti" }
      ]
    },
    "25": {
      "traducao_completa": "Os teus olhos olhem para a frente, e as tuas pálpebras olhem direto diante de ti.",
      "palavras": [
        { "hebraico": "עֵ֭ינֶיךָ", "transliteral": "ʿê-ne-ḵā", "traducao_palavra": "teus olhos" },
        { "hebraico": "לְנֹ֣כַח", "transliteral": "lə-nō-ḵaḥ", "traducao_palavra": "para a frente" },
        { "hebraico": "יַבִּ֑יטוּ", "transliteral": "yab-bî-ṭû", "traducao_palavra": "olhem" },
        { "hebraico": "וְ֝עַפְעַפֶּ֗יךָ", "transliteral": "wə-ʿap̄-ʿap-pe-ḵā", "traducao_palavra": "e tuas pálpebras" },
        { "hebraico": "יַיְשִׁ֥רוּ", "transliteral": "yay-ši-rû", "traducao_palavra": "endireitem/olhem direto" },
        { "hebraico": "נֶגְדֶּֽךָ׃", "transliteral": "neḡ-de-ḵā", "traducao_palavra": "diante de ti" }
      ]
    },
    "26": {
      "traducao_completa": "Pondera a vereda de teus pés, e todos os teus caminhos sejam bem estabelecidos.",
      "palavras": [
        { "hebraico": "פַּ֭לֵּס", "transliteral": "pal-lês", "traducao_palavra": "pondera/nivela" },
        { "hebraico": "מַעְגַּ֣ל", "transliteral": "maʿ-gal", "traducao_palavra": "vereda de" },
        { "hebraico": "רַגְלֶ֑ךָ", "transliteral": "raḡ-le-ḵā", "traducao_palavra": "teus pés" },
        { "hebraico": "וְכָל־", "transliteral": "wə-ḵāl", "traducao_palavra": "e todos" },
        { "hebraico": "דְּרָכֶ֥יךָ", "transliteral": "də-rā-ḵê-ḵā", "traducao_palavra": "teus caminhos" },
        { "hebraico": "יִכֹּֽנוּ׃", "transliteral": "yik-kō-nû", "traducao_palavra": "sejam estabelecidos" }
      ]
    },
    "27": {
      "traducao_completa": "Não declines nem para a direita nem para a esquerda; retira o teu pé do mal.",
      "palavras": [
        { "hebraico": "אַֽל־תֵּט־", "transliteral": "ʾal-têṭ", "traducao_palavra": "não te declines" },
        { "hebraico": "יָמִ֥ין", "transliteral": "yā-mîn", "traducao_palavra": "[para a] direita" },
        { "hebraico": "וּשְׂמֹ֑אול", "transliteral": "ū-śə-môl", "traducao_palavra": "e [para a] esquerda" },
        { "hebraico": "הָסֵ֖ר", "transliteral": "hā-sêr", "traducao_palavra": "retira/desvia" },
        { "hebraico": "רַגְלְךָ֣", "transliteral": "raḡ-lə-ḵā", "traducao_palavra": "teu pé" },
        { "hebraico": "מֵרָֽע׃", "transliteral": "mê-rāʿ", "traducao_palavra": "do mal" }
      ]
