{
  "livro": "Provérbios - מִשְׁלֵי - Mishlei",
  "capítulo": 4,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "Ouvi, filhos, a instrução de um pai, e estai atentos para conhecerdes o entendimento.",
      "palavras": [
        { "hebraico": "שִׁמְע֣וּ", "transliteral": "šim-ʿû", "traducao_palavra": "ouvi" },
        { "hebraico": "בָ֭נִים", "transliteral": "ḇā-nîm", "traducao_palavra": "filhos" },
        { "hebraico": "מוּסַ֣ר", "transliteral": "mū-sar", "traducao_palavra": "a instrução de" },
        { "hebraico": "אָ֑ב", "transliteral": "ʾāḇ", "traducao_palavra": "pai" },
        { "hebraico": "וְ֝הַקְשִׁ֗יבוּ", "transliteral": "wə-haq-šî-ḇû", "traducao_palavra": "e estai atentos" },
        { "hebraico": "לָדַ֥עַת", "transliteral": "lā-ḏa-ʿaṯ", "traducao_palavra": "para conhecer" },
        { "hebraico": "בִּינָֽה׃", "transliteral": "bî-nā", "traducao_palavra": "o entendimento" }
      ]
    },
    "2": {
      "traducao_completa": "Pois eu vos dou boa doutrina; não abandoneis a minha instrução.",
      "palavras": [
        { "hebraico": "כִּ֤י", "transliteral": "kî", "traducao_palavra": "pois" },
        { "hebraico": "לֶ֣קַח", "transliteral": "le-qaḥ", "traducao_palavra": "doutrina/ensino" },
        { "hebraico": "טֹ֭וב", "transliteral": "ṭôḇ", "traducao_palavra": "bom" },
        { "hebraico": "נָתַ֣תִּי", "transliteral": "nā-ṯat-tî", "traducao_palavra": "dei" },
        { "hebraico": "לָכֶ֑ם", "transliteral": "lā-ḵem", "traducao_palavra": "a vós" },
        { "hebraico": "תֹּ֝ורָתִ֗י", "transliteral": "tô-rā-ṯî", "traducao_palavra": "minha instrução/lei" },
        { "hebraico": "אַֽל־תַּעֲזֹֽבוּ׃", "transliteral": "ʾal-ta-ʿă-zō-ḇû", "traducao_palavra": "não abandoneis" }
      ]
    },
    "3": {
      "traducao_completa": "Quando eu era filho aos pés de meu pai, tenro e único diante de minha mãe,",
      "palavras": [
        { "hebraico": "כִּֽי־בֵ֭ן", "transliteral": "kî-ḇên", "traducao_palavra": "pois filho" },
        { "hebraico": "הָיִ֣יתִי", "transliteral": "hā-yî-ṯî", "traducao_palavra": "eu era" },
        { "hebraico": "לְאָבִ֑י", "transliteral": "lə-ʾā-ḇî", "traducao_palavra": "para meu pai" },
        { "hebraico": "רַ֥ךְ", "transliteral": "raḵ", "traducao_palavra": "tenro" },
        { "hebraico": "וְ֝יָחִ֗יד", "transliteral": "wə-yā-ḥîḏ", "traducao_palavra": "e único" },
        { "hebraico": "לִפְנֵ֥י", "transliteral": "lip̄-nê", "traducao_palavra": "diante de" },
        { "hebraico": "אִמִּֽי׃", "transliteral": "ʾim-mî", "traducao_palavra": "minha mãe" }
      ]
    },
    "4": {
      "traducao_completa": "ele me ensinava e me dizia: Retenha o teu coração as minhas palavras; guarda os meus mandamentos e vive.",
      "palavras": [
        { "hebraico": "וַיֹּרֵ֗נִי", "transliteral": "way-yō-rê-nî", "traducao_palavra": "e ele me ensinava" },
        { "hebraico": "וַיֹּ֥אמֶר", "transliteral": "way-yō-mer", "traducao_palavra": "e dizia" },
        { "hebraico": "לִ֗י", "transliteral": "lî", "traducao_palavra": "a mim" },
        { "hebraico": "יִתְמָךְ־", "transliteral": "yiṯ-māḵ-", "traducao_palavra": "retenha" },
        { "hebraico": "דְּבָרַ֥י", "transliteral": "də-ḇā-rāy", "traducao_palavra": "minhas palavras" },
        { "hebraico": "לִבֶּ֑ךָ", "transliteral": "lib-be-ḵā", "traducao_palavra": "teu coração" },
        { "hebraico": "שְׁמֹ֥ר", "transliteral": "šə-mōr", "traducao_palavra": "guarda" },
        { "hebraico": "מִ֝צְוֹתַ֗י", "transliteral": "miṣ-wō-ṯay", "traducao_palavra": "meus mandamentos" },
        { "hebraico": "וֶחְיֵֽה׃", "transliteral": "we-ḥə-yēh", "traducao_palavra": "e vive" }
      ]
    },
    "5": {
      "traducao_completa": "Adquire a sabedoria, adquire o entendimento; não te esqueças nem te desvies das palavras da minha boca.",
      "palavras": [
        { "hebraico": "קְנֵ֣ה", "transliteral": "qə-nēh", "traducao_palavra": "adquire" },
        { "hebraico": "חָ֭כְמָה", "transliteral": "ḥā-ḵə-mā", "traducao_palavra": "sabedoria" },
        { "hebraico": "קְנֵ֣ה", "transliteral": "qə-nēh", "traducao_palavra": "adquire" },
        { "hebraico": "בִינָ֑ה", "transliteral": "ḇî-nā", "traducao_palavra": "entendimento" },
        { "hebraico": "אַל־תִּשְׁכַּ֥ח", "transliteral": "ʾal-tiš-kāḥ", "traducao_palavra": "não te esqueças" },
        { "hebraico": "וְאַל־תֵּ֝ט", "transliteral": "wə-ʾal-têṭ", "traducao_palavra": "e não te desvies" },
        { "hebraico": "מֵאִמְרֵי־", "transliteral": "mê-ʾim-rê-", "traducao_palavra": "das palavras de" },
        { "hebraico": "פִֽי׃", "transliteral": "p̄î", "traducao_palavra": "minha boca" }
      ]
    },
    "6": {
      "traducao_completa": "Não a abandones, e ela te guardará; ama-a, e ela te preservará.",
      "palavras": [
        { "hebraico": "אַל־תַּעַזְבֶ֥הָ", "transliteral": "ʾal-ta-ʿaz-ḇe-hā", "traducao_palavra": "não a abandones" },
        { "hebraico": "וְתִשְׁמְרֶ֑ךָּ", "transliteral": "wə-ṯiš-mə-rek-kā", "traducao_palavra": "e ela te guardará" },
        { "hebraico": "אֱהָבֶ֥הָ", "transliteral": "ʾĕ-hā-ḇe-hā", "traducao_palavra": "ama-a" },
        { "hebraico": "וְתִצְּרֶֽךָּ׃", "transliteral": "wə-ṯiṣ-ṣə-rek-kā", "traducao_palavra": "e ela te preservará" }
      ]
    },
    "7": {
      "traducao_completa": "A sabedoria é a coisa principal; adquire, pois, a sabedoria; sim, com tudo o que possuis, adquire o entendimento.",
      "palavras": [
        { "hebraico": "רֵאשִׁ֣ית", "transliteral": "rê-šîṯ", "traducao_palavra": "[a] principal/princípio" },
        { "hebraico": "חָ֭כְמָה", "transliteral": "ḥā-ḵə-mā", "traducao_palavra": "sabedoria" },
        { "hebraico": "קְנֵ֣ה", "transliteral": "qə-nēh", "traducao_palavra": "adquire" },
        { "hebraico": "חָכְמָ֑ה", "transliteral": "ḥā-ḵə-mā", "traducao_palavra": "sabedoria" },
        { "hebraico": "וּבְכָל־", "transliteral": "ū-ḇə-ḵāl-", "traducao_palavra": "e com todo" },
        { "hebraico": "קִ֝נְיָנְךָ֗", "transliteral": "qin-yā-nə-ḵā", "traducao_palavra": "teu possuir/aquisição" },
        { "hebraico": "קְנֵ֣ה", "transliteral": "qə-nēh", "traducao_palavra": "adquire" },
        { "hebraico": "בִינָֽה׃", "transliteral": "ḇî-nā", "traducao_palavra": "entendimento" }
      ]
    },
    "8": {
      "traducao_completa": "Exalta-a, e ela te exaltará; ela te honrará, se tu a abraçares.",
      "palavras": [
        { "hebraico": "סַלְסְלֶ֥הָ", "transliteral": "sal-sə-le-hā", "traducao_palavra": "exalta-a" },
        { "hebraico": "וּתְרֹומְמֶ֑ךָּ", "transliteral": "ū-ṯə-rô-mə-mek-kā", "traducao_palavra": "e ela te exaltará" },
        { "hebraico": "תְּ֝כַבֵּדְךָ֗", "transliteral": "tə-ḵab-bê-ḏə-ḵā", "traducao_palavra": "ela te honrará" },
        { "hebraico": "כִּ֣י", "transliteral": "kî", "traducao_palavra": "se" },
        { "hebraico": "תְחַבְּקֶֽנָּה׃", "transliteral": "ṯə-ḥab-bə-qen-nā", "traducao_palavra": "tu a abraçares" }
      ]
    },
    "9": {
      "traducao_completa": "Dará à tua cabeça um diadema de graça, e uma coroa de glória te entregará.",
      "palavras": [
        { "hebraico": "תִּתֵּ֣ן", "transliteral": "tit-tên", "traducao_palavra": "ela dará" },
        { "hebraico": "לְרֹאשְׁךָ֣", "transliteral": "lə-rō-šə-ḵā", "traducao_palavra": "à tua cabeça" },
        { "hebraico": "לִוְיַת־", "transliteral": "liw-yaṯ-", "traducao_palavra": "diadema/guirlanda de" },
        { "hebraico": "חֵ֑ן", "transliteral": "ḥên", "traducao_palavra": "graça" },
        { "hebraico": "עֲטֶ֖רֶת", "transliteral": "ʿă-ṭe-reṯ", "traducao_palavra": "uma coroa de" },
        { "hebraico": "תִּפְאֶ֣רֶת", "transliteral": "tip̄-ʾe-reṯ", "traducao_palavra": "glória/esplendor" },
        { "hebraico": "תְּמַגְּנֶֽךָּ׃", "transliteral": "tə-maḡ-gə-nek-kā", "traducao_palavra": "te entregará/protegerá" }
      ]
    },
    "10": {
      "traducao_completa": "Ouve, filho meu, e aceita as minhas palavras, e se multiplicarão os anos da tua vida.",
      "palavras": [
        { "hebraico": "שְׁמַ֣ע", "transliteral": "šə-maʿ", "traducao_palavra": "ouve" },
        { "hebraico": "בְּ֭נִי", "transliteral": "bə-nî", "traducao_palavra": "filho meu" },
        { "hebraico": "וְקַ֣ח", "transliteral": "wə-qaḥ", "traducao_palavra": "e aceita" },
        { "hebraico": "אֲמָרָ֑י", "transliteral": "ʾă-mā-rāy", "traducao_palavra": "minhas palavras" },
        { "hebraico": "וְיִרְבּ֥וּ", "transliteral": "wə-yir-bû", "traducao_palavra": "e se multiplicarão" },
        { "hebraico": "לְ֝ךָ֗", "transliteral": "lə-ḵā", "traducao_palavra": "para ti" },
        { "hebraico": "שְׁנֹ֣ות", "transliteral": "šə-nôṯ", "traducao_palavra": "anos de" },
        { "hebraico": "חַיִּֽים׃", "transliteral": "ḥay-yîm", "traducao_palavra": "vida" }
      ]
    },
    "11": {
      "traducao_completa": "No caminho da sabedoria te ensinei, e pelas veredas da retidão te guiei.",
      "palavras": [
        { "hebraico": "בְּדֶ֣רֶךְ", "transliteral": "bə-ḏe-reḵ", "traducao_palavra": "no caminho de" },
        { "hebraico": "חָ֭כְמָה", "transliteral": "ḥā-ḵə-mā", "traducao_palavra": "sabedoria" },
        { "hebraico": "הֹרֵיתִ֑יךָ", "transliteral": "hō-rê-ṯî-ḵā", "traducao_palavra": "te ensinei" },
        { "hebraico": "הִ֝דְרַכְתִּ֗יךָ", "transliteral": "hiḏ-raḵ-tî-ḵā", "traducao_palavra": "te guiei/conduzi" },
        { "hebraico": "בְּמַעְגְּלֵי־", "transliteral": "bə-ma-ʿə-ḡə-lê-", "traducao_palavra": "nas veredas de" },
        { "hebraico": "יֹֽשֶׁר׃", "transliteral": "yō-šer", "traducao_palavra": "retidão" }
      ]
    },
    "12": {
      "traducao_completa": "Ao andares, não se embaraçarão os teus passos; e se correres, não tropeçarás.",
      "palavras": [
        { "hebraico": "בְּֽלֶכְתְּךָ֗", "transliteral": "bə-leḵ-tə-ḵā", "traducao_palavra": "em teu andar" },
        { "hebraico": "לֹא־יֵצַ֥ר", "transliteral": "lō-yê-ṣar", "traducao_palavra": "não se estreitará/embaraçará" },
        { "hebraico": "צַעֲדֶ֑ךָ", "transliteral": "ṣa-ʿă-ḏe-ḵā", "traducao_palavra": "teu passo" },
        { "hebraico": "וְאִם־תָּ֝ר֗וּץ", "transliteral": "wə-ʾim-tā-rûṣ", "traducao_palavra": "e se correres" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "תִכָּשֵֽׁל׃", "transliteral": "tik-kā-šêl", "traducao_palavra": "tropeçarás" }
      ]
    },
    "13": {
      "traducao_completa": "Retém a instrução e não a largues; guarda-a, porque ela é a tua vida.",
      "palavras": [
        { "hebraico": "הַחֲזֵ֣ק", "transliteral": "ha-ḥă-zêq", "traducao_palavra": "retém/agarra" },
        { "hebraico": "בַּמּוּסָ֣ר", "transliteral": "bam-mū-sār", "traducao_palavra": "na instrução" },
        { "hebraico": "אַל־תֶּ֑רֶף", "transliteral": "ʾal-te-rep̄", "traducao_palavra": "não a largues" },
        { "hebraico": "נִ֝צְרֶ֗הָ", "transliteral": "niṣ-re-hā", "traducao_palavra": "guarda-a" },
        { "hebraico": "כֳִּי־הִ֥יא", "transliteral": "kî-hî", "traducao_palavra": "porque ela" },
        { "hebraico": "חַיֶּֽיךָ׃", "transliteral": "ḥay-yê-ḵā", "traducao_palavra": "[é] tua vida" }
      ]
    },
    "14": {
      "traducao_completa": "Não entres na vereda dos ímpios, nem passes pelo caminho dos maus.",
      "palavras": [
        { "hebraico": "בְּאֹ֣רַח", "transliteral": "bə-ʾō-raḥ", "traducao_palavra": "na vereda de" },
        { "hebraico": "רְ֭שָׁעִים", "transliteral": "rə-šā-ʿîm", "traducao_palavra": "ímpios" },
        { "hebraico": "אַל־תָּבֹ֑א", "transliteral": "ʾal-tā-ḇō", "traducao_palavra": "não entres" },
        { "hebraico": "וְאַל־תְּ֝אַשֵּׁ֗ר", "transliteral": "wə-ʾal-tə-ʾaš-šêr", "traducao_palavra": "e não andes" },
        { "hebraico": "בְּדֶ֣רֶךְ", "transliteral": "bə-ḏe-reḵ", "traducao_palavra": "no caminho de" },
        { "hebraico": "רָעִֽים׃", "transliteral": "rā-ʿîm", "traducao_palavra": "maus" }
      ]
    },
    "15": {
      "traducao_completa": "Evita-o; não passes por ele; desvia-te dele e passa adiante.",
      "palavras": [
        { "hebraico": "פְּרָעֵ֥הוּ", "transliteral": "pə-rā-ʿê-hû", "traducao_palavra": "evita-o/rejeita-o" },
        { "hebraico": "אַל־תַּעֲבָר־בֹּ֑ו", "transliteral": "ʾal-ta-ʿă-ḇār-bô", "traducao_palavra": "não passes por ele" },
        { "hebraico": "שְׂטֵ֥ה", "transliteral": "śə-ṭēh", "traducao_palavra": "desvia-te" },
        { "hebraico": "מֵ֝עָלָ֗יו", "transliteral": "mê-ʿā-lāw", "traducao_palavra": "de cima dele" },
        { "hebraico": "וַעֲבֹֽור׃", "transliteral": "wa-ʿă-ḇôr", "traducao_palavra": "e passa adiante" }
      ]
    },
    "16": {
      "traducao_completa": "Pois não dormem, se não fizerem mal, e foge deles o sono, se não fizerem tropeçar alguém.",
      "palavras": [
        { "hebraico": "כִּ֤י", "transliteral": "kî", "traducao_palavra": "pois" },
        { "hebraico": "לֹ֣א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "יִֽשְׁנוּ", "transliteral": "yiš-nû", "traducao_palavra": "dormem" },
        { "hebraico": "אִם־לֹ֣א", "transliteral": "ʾim-lō", "traducao_palavra": "se não" },
        { "hebraico": "יָרֵ֑עוּ", "transliteral": "yā-rê-ʿû", "traducao_palavra": "fizerem mal" },
        { "hebraico": "וְֽנִגְזְלָ֥ה", "transliteral": "wə-niḡ-zə-lā", "traducao_palavra": "e é roubado" },
        { "hebraico": "שְׁ֝נָתָ֗ם", "transliteral": "šə-nā-ṯām", "traducao_palavra": "o sono deles" },
        { "hebraico": "אִם־לֹ֥א", "transliteral": "ʾim-lō", "traducao_palavra": "se não" },
        { "hebraico": "יַכְשִֽׁילוּ׃", "transliteral": "yak-šî-lû", "traducao_palavra": "fizerem tropeçar" }
      ]
    },
    "17": {
      "traducao_completa": "Porque comem o pão da impiedade, e bebem o vinho da violência.",
      "palavras": [
        { "hebraico": "כִּ֣י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "לָ֭חֲמוּ", "transliteral": "lā-ḥă-mû", "traducao_palavra": "comem" },
        { "hebraico": "לֶ֣חֶם", "transliteral": "le-ḥem", "traducao_palavra": "o pão de" },
        { "hebraico": "רֶ֑שַׁע", "transliteral": "re-šaʿ", "traducao_palavra": "impiedade/maldade" },
        { "hebraico": "וְיֵ֖ין", "transliteral": "wə-yên", "traducao_palavra": "e o vinho de" },
        { "hebraico": "חֲמָסִ֣ים", "transliteral": "ḥă-mā-sîm", "traducao_palavra": "violências" },
        { "hebraico": "יִשְׁתּֽוּ׃", "transliteral": "yiš-tû", "traducao_palavra": "beberão" }
      ]
    },
    "18": {
      "traducao_completa": "Mas a vereda dos justos é como a luz da aurora, que vai brilhando mais e mais até ser dia perfeito.",
      "palavras": [
        { "hebraico": "וְאֹ֣רַח", "transliteral": "wə-ʾō-raḥ", "traducao_palavra": "mas a vereda de" },
        { "hebraico": "צַ֭דִּיקִים", "transliteral": "ṣad-dî-qîm", "traducao_palavra": "justos" },
        { "hebraico": "כְּאֹ֣ור", "transliteral": "kə-ʾôr", "traducao_palavra": "como a luz de" },
        { "hebraico": "נֹ֑גַהּ", "transliteral": "nō-ḡah", "traducao_palavra": "aurora/brilho" },
        { "hebraico": "הֹולֵ֥ךְ", "transliteral": "hō-lêḵ", "traducao_palavra": "indo" },
        { "hebraico": "וָאֹ֗ור", "transliteral": "wā-ʾôr", "traducao_palavra": "e iluminando/brilhando" },
        { "hebraico": "עַד־נְכֹ֥ון", "transliteral": "ʿaḏ-nə-ḵôn", "traducao_palavra": "até o estabelecer de" },
        { "hebraico": "הַיֹּֽום׃", "transliteral": "hay-yôm", "traducao_palavra": "o dia" }
