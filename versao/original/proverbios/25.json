        { "hebraico": "נֶ֣זֶם", "transliteral": "ne-zem", "traducao_palavra": "Pendente/anel de" },
        { "hebraico": "זָ֭הָב", "transliteral": "zā-hāḇ", "traducao_palavra": "ouro" },
        { "hebraico": "וַחֲלִִי־", "transliteral": "wa-ḥă-lî-", "traducao_palavra": "e enfeite/colar de" },
        { "hebraico": "כָ֑תֶם", "transliteral": "ḵā-ṯem", "traducao_palavra": "ouro puro/fino" },
        { "hebraico": "מֹוכִ֥יחַ", "transliteral": "mô-ḵî-aḥ", "traducao_palavra": "[é o] sábio que repreende" },
        { "hebraico": "חָ֝כָ֗ם", "transliteral": "ḥā-ḵām", "traducao_palavra": "sábio" },
