        { "hebraico": "רֵעֶ֑ךָ", "transliteral": "rê-ʿe-ḵā", "traducao_palavra": "teu próximo" },
        { "hebraico": "וְסֹ֖וד", "transliteral": "wə-śôḏ", "traducao_palavra": "e o segredo de" },
