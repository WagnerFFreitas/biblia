        { "hebraico": "טֹ֣וב", "transliteral": "ṭôḇ", "traducao_palavra": "melhor [é]" },
        { "hebraico": "אֲמָר־", "transliteral": "ʾă-mār-", "traducao_palavra": "[que se] diga" },
        { "hebraico": "לְךָ֭", "transliteral": "lə-ḵā", "traducao_palavra": "a ti" },
        { "hebraico": "עֲלֵה־", "transliteral": "ʿă-lēh-", "traducao_palavra": "sobe" },
        { "hebraico": "הֵ֑נָּה", "transliteral": "hên-nā", "traducao_palavra": "para cá" },
