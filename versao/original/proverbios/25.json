        { "hebraico": "תָשֽׁוּב׃", "transliteral": "ṯā-šûḇ", "traducao_palavra": "retorne/cesse" }
      ]
    },
    "11": {
      "traducao_completa": "Como maçãs de ouro em salvas de prata, assim é a palavra falada a seu tempo.",
