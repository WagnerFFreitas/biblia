    "10": {
      "traducao_completa": "para que não te desonre o que o ouvir, e a tua infâmia não se aparte de ti.",
      "palavras": [
        { "hebraico": "פֶּן־", "transliteral": "pen-", "traducao_palavra": "Para que não" },
        { "hebraico": "יְחַסֶּדְךָ֥", "transliteral": "yə-ḥas-seḏ-ḵā", "traducao_palavra": "te desonre/insulte" },
        { "hebraico": "שֳֹׁמֵ֑עַ", "transliteral": "šō-mê-aʿ", "traducao_palavra": "o que ouvir" },
        { "hebraico": "וְ֝דִבָּתְךָ֗", "transliteral": "wə-ḏib-bā-ṯə-ḵā", "traducao_palavra": "e a tua infâmia/má fama" },
