      ]
    },
    "13": {
      "traducao_completa": "Como o frescor da neve no tempo da sega, assim é o mensageiro fiel para com os que o enviam; porque recreia a alma dos seus senhores.",
      "palavras": [
        { "hebraico": "כְּצִנַּת־", "transliteral": "kə-ṣin-naṯ-", "traducao_palavra": "Como o frescor de" },
        { "hebraico": "שֶׁ֨לֶג ׀", "transliteral": "še-leḡ", "traducao_palavra": "neve" },
        { "hebraico": "בְּיֹ֣ום", "transliteral": "bə-yôm", "traducao_palavra": "no dia de" },
        { "hebraico": "קָצִ֗יר", "transliteral": "qā-ṣîr", "traducao_palavra": "colheita" },
        { "hebraico": "צִ֣יר", "transliteral": "ṣîr", "traducao_palavra": "[é o] mensageiro" },
        { "hebraico": "אֱ֭מוּנִים", "transliteral": "ʾĕ-mû-nîm", "traducao_palavra": "fiel" },
        { "hebraico": "לְשֹׁלְחָ֑יו", "transliteral": "lə-šō-lə-ḥāyw", "traducao_palavra": "para os que o enviam" },
        { "hebraico": "וְנֶ֖פֶשׁ", "transliteral": "wə-ne-p̄eš", "traducao_palavra": "e a alma de" },
        { "hebraico": "אֲדֹנָ֣יו", "transliteral": "ʾă-ḏō-nāyw", "traducao_palavra": "seus senhores" },
        { "hebraico": "יָשִֽׁיב׃", "transliteral": "yā-šîḇ", "traducao_palavra": "ele restaura/recreia" }
      ]
    },
    "14": {
      "traducao_completa": "Como nuvens e ventos que não trazem chuva, assim é o homem que se gloria falsamente de dádivas que não deu.",
      "palavras": [
        { "hebraico": "נְשִׂיאִ֣ים", "transliteral": "nə-śî-ʾîm", "traducao_palavra": "Nuvens" },
        { "hebraico": "וְ֭רוּחַ", "transliteral": "wə-rû-aḥ", "traducao_palavra": "e vento" },
        { "hebraico": "וְגֶ֣שֶׁם", "transliteral": "wə-ḡe-šem", "traducao_palavra": "e chuva" },
        { "hebraico": "אָ֑יִן", "transliteral": "ʾā-yin", "traducao_palavra": "não [há]" },
        { "hebraico": "אִ֥ישׁ", "transliteral": "ʾîš", "traducao_palavra": "[assim é] um homem" },
        { "hebraico": "מִ֝תְהַלֵּ֗ל", "transliteral": "miṯ-hal-lēl", "traducao_palavra": "que se gloria" },
        { "hebraico": "בְּמַתַּת־", "transliteral": "bə-mat-taṯ-", "traducao_palavra": "com presente de" },
        { "hebraico": "שָֽׁקֶר׃", "transliteral": "šā-qer", "traducao_palavra": "mentira/falsidade" }
      ]
    },
    "15": {
