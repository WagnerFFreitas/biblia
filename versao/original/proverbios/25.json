        { "hebraico": "בְּאֹ֣רֶךְ", "transliteral": "bə-ʾō-reḵ", "traducao_palavra": "Pela demora/longura de" },
        { "hebraico": "אַ֭פַּיִם", "transliteral": "ʾap-pa-yim", "traducao_palavra": "narizes [paciência]" },
        { "hebraico": "יְפֻתֶּ֣ה", "transliteral": "yə-p̄ut-teh", "traducao_palavra": "será persuadido" },
        { "hebraico": "קָצִ֑ין", "transliteral": "qā-ṣîn", "traducao_palavra": "[um] príncipe/juiz" },
        { "hebraico": "וְלָשֹׁ֥ון", "transliteral": "wə-lā-šôn", "traducao_palavra": "e a língua" },
        { "hebraico": "רַ֝כָּ֗ה", "transliteral": "rak-kā", "traducao_palavra": "branda/suave" },
        { "hebraico": "תִּשְׁבַּר־", "transliteral": "tiš-bar-", "traducao_palavra": "quebrará" },
        { "hebraico": "גָּֽרֶם׃", "transliteral": "gā-rem", "traducao_palavra": "[o] osso" }
      ]
    },
    "16": {
