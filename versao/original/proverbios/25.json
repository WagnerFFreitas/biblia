        { "hebraico": "לָעֹ֑מֶק", "transliteral": "lā-ʿō-meq", "traducao_palavra": "para a profundidade" },
        { "hebraico": "וְלֵ֥ב", "transliteral": "wə-lêḇ", "traducao_palavra": "e o coração de" },
