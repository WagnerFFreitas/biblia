        { "hebraico": "אֱ֭לֹהִים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "Deus" },
        { "hebraico": "הַסְתֵּ֣ר", "transliteral": "has-tēr", "traducao_palavra": "[é] encobrir" },
        { "hebraico": "דָּבָ֑ר", "transliteral": "dā-ḇār", "traducao_palavra": "[um] assunto/coisa" },
        { "hebraico": "וּכְבֹ֥ד", "transliteral": "ū-ḵə-ḇōḏ", "traducao_palavra": "mas a glória de" },
        { "hebraico": "מְ֝לָכִ֗ים", "transliteral": "mə-lā-ḵîm", "traducao_palavra": "reis" },
