    },
    "6": {
      "traducao_completa": "Não te glories na presença do rei, nem te ponhas no lugar dos grandes.",
      "palavras": [
        { "hebraico": "אַל־", "transliteral": "ʾal-", "traducao_palavra": "Não" },
        { "hebraico": "תִּתְהַדַּ֥ר", "transliteral": "tiṯ-had-dar", "traducao_palavra": "te glories/te faças majestoso" },
