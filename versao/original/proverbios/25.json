        { "hebraico": "מֶ֑לֶךְ", "transliteral": "me-leḵ", "traducao_palavra": "um rei" },
        { "hebraico": "וּבִמְקֹ֥ום", "transliteral": "ū-ḇim-qôm", "traducao_palavra": "e no lugar de" },
