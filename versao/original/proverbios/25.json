      ]
    },
    "8": {
      "traducao_completa": "Não te apresses a litigar, para que depois não saibas o que fazer, quando o teu próximo te puser em vergonha.",
      "palavras": [
        { "hebraico": "אַל־", "transliteral": "ʾal-", "traducao_palavra": "Não" },
        { "hebraico": "תֵּצֵ֥א", "transliteral": "tê-ṣê", "traducao_palavra": "saias/te apresses" },
        { "hebraico": "לָרִ֗יב", "transliteral": "lā-rîḇ", "traducao_palavra": "para litigar/brigar" },
