      ]
    },
    "9": {
      "traducao_completa": "Pleiteia a tua causa com o teu próximo mesmo, e não reveles o segredo de outrem,",
      "palavras": [
        { "hebraico": "רִ֭יבְךָ", "transliteral": "rî-ḇə-ḵā", "traducao_palavra": "Tua causa/pleito" },
