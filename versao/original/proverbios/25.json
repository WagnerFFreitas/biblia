        { "hebraico": "כָּ֑סֶף", "transliteral": "kā-sep̄", "traducao_palavra": "prata" },
        { "hebraico": "דָּ֝בָ֗ר", "transliteral": "dā-ḇār", "traducao_palavra": "[é a] palavra" },
