    "5": {
      "traducao_completa": "Tira o ímpio da presença do rei, e o seu trono se estabelecerá na justiça.",
      "palavras": [
        { "hebraico": "הָ֭גֹו", "transliteral": "hā-ḡô", "traducao_palavra": "Tira" },
