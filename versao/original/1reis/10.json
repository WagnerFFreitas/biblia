        { "hebraico": "סוּסִ֖ים", "transliteral": "śû-śîm", "traducao_palavra": "cavalos" },
        { "hebraico": "וּפְרָדִ֑ים", "transliteral": "ū-p̄ə-rā-ḏîm", "traducao_palavra": "e mulos" },
        { "hebraico": "דְּבַר־שָׁנָ֖ה", "transliteral": "də-ḇar-šā-nā", "traducao_palavra": "coisa de ano" },
