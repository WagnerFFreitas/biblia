        { "hebraico": "וַיִּגְדַּל֙", "transliteral": "way-yiḡ-dal", "traducao_palavra": "e cresceu/foi maior" },
        { "hebraico": "הַמֶּ֣לֶךְ", "transliteral": "ham-me-leḵ", "traducao_palavra": "o rei" },
