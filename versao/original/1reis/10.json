    },
    "10": {
      "traducao_completa": "E deu ao rei cento e vinte talentos de ouro, e muitíssimas especiarias, e pedras preciosas; nunca veio tanta abundância de especiarias como a que a rainha de Sabá deu ao rei Salomão.",
      "palavras": [
        { "hebraico": "וַתִּתֵּ֨ן", "transliteral": "wat-tit-tēn", "traducao_palavra": "e deu ela" },
