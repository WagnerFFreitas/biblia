        { "hebraico": "יְהוָ֤ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "אֱלֹהֶ֙יךָ֙", "transliteral": "ʾĕ-lō-he-yḵā", "traducao_palavra": "teu Deus" },
        { "hebraico": "בָּר֔וּךְ", "transliteral": "bā-rûḵ", "traducao_palavra": "bendito" },
