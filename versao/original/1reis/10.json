        { "hebraico": "אֶ֤לֶף", "transliteral": "ʾe-lep̄", "traducao_palavra": "mil" },
        { "hebraico": "וְאַרְבַּע־מֵאֹות֙", "transliteral": "wə-ʾar-baʿ-mē-ʾôṯ", "traducao_palavra": "e quatrocentas" },
        { "hebraico": "רֶ֔כֶב", "transliteral": "re-ḵeḇ", "traducao_palavra": "carro" },
        { "hebraico": "וּשְׁנֵים־עָשָׂ֥ר", "transliteral": "ū-šə-nêm-ʿā-śār", "traducao_palavra": "e doze" },
        { "hebraico": "אֶ֖לֶף", "transliteral": "ʾe-lep̄", "traducao_palavra": "mil" },
        { "hebraico": "פָּרָשִׁ֑ים", "transliteral": "pā-rā-šîm", "traducao_palavra": "cavaleiros" },
        { "hebraico": "וַיַּנְחֵם֙", "transliteral": "way-yan-ḥêm", "traducao_palavra": "e os colocou" },
        { "hebraico": "בְּעָרֵ֣י", "transliteral": "bə-ʿā-rê", "traducao_palavra": "nas cidades de" },
        { "hebraico": "הָרֶ֔כֶב", "transliteral": "hā-re-ḵeḇ", "traducao_palavra": "os carros" },
        { "hebraico": "וְעִם־הַמֶּ֖לֶךְ", "transliteral": "wə-ʿim-ham-me-leḵ", "traducao_palavra": "e com o rei" },
        { "hebraico": "בִּירוּשָׁלִָֽם׃", "transliteral": "bî-rû-šā-lā-im", "traducao_palavra": "em Jerusalém" }
      ]
    },
    "27": {
      "traducao_completa": "E fez o rei que a prata em Jerusalém fosse como as pedras, e os cedros em tanta abundância como as sicômoros que há nas planícies.",
      "palavras": [
        { "hebraico": "וַיִּתֵּ֨ן", "transliteral": "way-yit-tên", "traducao_palavra": "e pôs/fez" },
        { "hebraico": "הַמֶּ֧לֶךְ", "transliteral": "ham-me-leḵ", "traducao_palavra": "o rei" },
        { "hebraico": "אֶת־הַכֶּ֛סֶף", "transliteral": "ʾeṯ-hak-ke-śep̄", "traducao_palavra": "a prata" },
        { "hebraico": "בִּירוּשָׁלִַ֖ם", "transliteral": "bî-rû-šā-la-im", "traducao_palavra": "em Jerusalém" },
        { "hebraico": "כָּאֲבָנִ֑ים", "transliteral": "kā-ʾă-ḇā-nîm", "traducao_palavra": "como as pedras" },
        { "hebraico": "וְאֵ֣ת", "transliteral": "wə-ʾêṯ", "traducao_palavra": "e" },
        { "hebraico": "הָאֲרָזִים֙", "transliteral": "hā-ʾă-rā-zîm", "traducao_palavra": "os cedros" },
        { "hebraico": "נָתַ֣ן", "transliteral": "nā-ṯan", "traducao_palavra": "pôs/fez" },
        { "hebraico": "כַּשִּׁקְמִ֥ים", "transliteral": "kaš-šiq-mîm", "traducao_palavra": "como os sicômoros" },
        { "hebraico": "אֲשֶׁר־בַּשְּׁפֵלָ֖ה", "transliteral": "ʾă-šer-baš-šə-p̄ê-lā", "traducao_palavra": "que [há] na planície/Sefelá" },
        { "hebraico": "לָרֹֽב׃", "transliteral": "lā-rōḇ", "traducao_palavra": "em abundância" }
      ]
    },
    "28": {
      "traducao_completa": "E traziam do Egito cavalos para Salomão; e mercadores do rei os recebiam em tropas, cada tropa por um certo preço.",
      "palavras": [
        { "hebraico": "וּמֹוצָ֧א", "transliteral": "ū-mô-ṣā", "traducao_palavra": "e a vinda/exportação de" },
        { "hebraico": "הַסּוּסִ֛ים", "transliteral": "has-śû-śîm", "traducao_palavra": "os cavalos" },
