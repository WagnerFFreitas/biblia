        { "hebraico": "וְכָל־הָאָ֔רֶץ", "transliteral": "wə-ḵāl-hā-ʾā-reṣ", "traducao_palavra": "e toda a terra" },
        { "hebraico": "מְבַקְשִׁ֖ים", "transliteral": "mə-ḇaq-šîm", "traducao_palavra": "estavam buscando" },
        { "hebraico": "אֶת־פְּנֵ֣י", "transliteral": "ʾeṯ-pə-nê", "traducao_palavra": "a face de" },
        { "hebraico": "שְׁלֹmֹ֑ה", "transliteral": "šə-lō-mōh", "traducao_palavra": "Salomão" },
