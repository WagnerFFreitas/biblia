        { "hebraico": "אֱלֹהִ֖ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "Deus" },
        { "hebraico": "בְּלִבֹּֽו׃", "transliteral": "bə-lib-bô", "traducao_palavra": "em seu coração" }
      ]
    },
    "25": {
      "traducao_completa": "E trazia cada um o seu presente, vasos de prata, e vasos de ouro, e vestes, e armaduras, e especiarias, cavalos e mulos, cada ano assim.",
      "palavras": [
        { "hebraico": "וְהֵ֜מָּה", "transliteral": "wə-hêm-mā", "traducao_palavra": "e eles" },
