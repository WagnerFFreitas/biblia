        { "hebraico": "וַתֹּ֙אמֶר֙", "transliteral": "wat-tō-mer", "traducao_palavra": "e disse ela" },
        { "hebraico": "אֶל־הַמֶּ֔לֶךְ", "transliteral": "ʾel-ham-me-leḵ", "traducao_palavra": "ao rei" },
