        { "hebraico": "אֱלֹהִ֨ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "Deus" },
        { "hebraico": "חָכְמָ֧ה", "transliteral": "ḥāḵ-māh", "traducao_palavra": "sabedoria" },
        { "hebraico": "לִשְׁלֹמֹ֛ה", "transliteral": "liš-lō-mōh", "traducao_palavra": "a Salomão" },
