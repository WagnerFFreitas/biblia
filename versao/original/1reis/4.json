{
  "livro": "1 Reis - מְלָכִים א - Melakhim Aleph",
  "capítulo": 4,
  "titulos": {},
  "versiculos": {
    "1": {
      "traducao_completa": "E o rei Salomão era rei sobre todo o Israel.",
      "palavras": [
        { "hebraico": "וַיְהִ֧י", "transliteral": "way-hî", "traducao_palavra": "e foi/era" },
        { "hebraico": "הַמֶּ֥לֶךְ", "transliteral": "ham-me-leḵ", "traducao_palavra": "o rei" },
        { "hebraico": "שְׁלֹמֹ֖ה", "transliteral": "šə-lō-mōh", "traducao_palavra": "Salomão" },
        { "hebraico": "מֶ֥לֶךְ", "transliteral": "me-leḵ", "traducao_palavra": "rei" },
        { "hebraico": "עַל־כָּל־יִשְׂרָאֵֽל׃", "transliteral": "ʿal-kāl-yiś-rā-ʾēl", "traducao_palavra": "sobre todo o Israel" }
      ]
    },
    "2": {
      "traducao_completa": "E estes eram os príncipes que ele tinha: Azarias, filho de Zadoque, o sacerdote;",
      "palavras": [
        { "hebraico": "וְאֵ֥לֶּה", "transliteral": "wə-ʾēl-leh", "traducao_palavra": "e estes [são]" },
        { "hebraico": "הַשָּׂרִ֖ים", "transliteral": "haś-śā-rîm", "traducao_palavra": "os príncipes/oficiais" },
        { "hebraico": "אֲשֶׁר־לֹ֑ו", "transliteral": "ʾă-šer-lô", "traducao_palavra": "que [eram] dele" },
        { "hebraico": "עֲזַרְיָ֥הוּ", "transliteral": "ʿă-zar-yā-hû", "traducao_palavra": "Azarias" },
        { "hebraico": "בֶן־צָדֹ֖וק", "transliteral": "ben-ṣā-ḏôq", "traducao_palavra": "filho de Zadoque" },
        { "hebraico": "הַכֹּהֵֽן׃", "transliteral": "hak-kō-hên", "traducao_palavra": "o sacerdote" }
      ]
    },
    "3": {
      "traducao_completa": "Eliorefe e Aías, filhos de Sisa, secretários; Josafá, filho de Ailude, o cronista;",
      "palavras": [
        { "hebraico": "אֱלִיחֹ֧רֶף", "transliteral": "ʾĕ-lî-ḥō-rep̄", "traducao_palavra": "Eliorefe" },
        { "hebraico": "וַאֲחִיָּ֛ה", "transliteral": "wa-ʾă-ḥî-yāh", "traducao_palavra": "e Aías" },
        { "hebraico": "בְּנֵ֥י", "transliteral": "bə-nê", "traducao_palavra": "filhos de" },
        { "hebraico": "שִׁישָׁ֖א", "transliteral": "šî-šā", "traducao_palavra": "Sisa" },
        { "hebraico": "סֹפְרִ֑ים", "transliteral": "sō-p̄ə-rîm", "traducao_palavra": "secretários/escrivães" },
        { "hebraico": "יְהֹושָׁפָ֥ט", "transliteral": "yə-hō-wō-šā-p̄āṭ", "traducao_palavra": "Josafá" },
        { "hebraico": "בֶּן־אֲחִיל֖וּד", "transliteral": "ben-ʾă-ḥî-lûḏ", "traducao_palavra": "filho de Ailude" },
        { "hebraico": "הַמַּזְכִּֽיר׃", "transliteral": "ham-maz-kîr", "traducao_palavra": "o cronista/rememorador" }
      ]
    },
    "4": {
      "traducao_completa": "E Benaia, filho de Joiada, sobre o exército; e Zadoque e Abiatar, sacerdotes;",
      "palavras": [
        { "hebraico": "וּבְנָיָ֥הוּ", "transliteral": "ū-ḇə-nā-yā-hû", "traducao_palavra": "e Benaia" },
        { "hebraico": "בֶן־יְהֹויָדָ֖ע", "transliteral": "ben-yə-hō-wō-yā-ḏā-ʿ", "traducao_palavra": "filho de Joiada" },
        { "hebraico": "עַל־הַצָּבָ֑א", "transliteral": "ʿal-haṣ-ṣā-ḇā", "traducao_palavra": "sobre o exército" },
        { "hebraico": "וְצָדֹ֥וק", "transliteral": "wə-ṣā-ḏôq", "traducao_palavra": "e Zadoque" },
        { "hebraico": "וְאֶבְיָתָ֖ר", "transliteral": "wə-ʾeḇ-yā-ṯār", "traducao_palavra": "e Abiatar" },
        { "hebraico": "כֹּהֲנִֽים׃", "transliteral": "kō-hă-nîm", "traducao_palavra": "sacerdotes" }
      ]
    },
    "5": {
      "traducao_completa": "E Azarias, filho de Natã, sobre os prepostos; e Zabude, filho de Natã, sacerdote e amigo do rei;",
      "palavras": [
        { "hebraico": "וַעֲזַרְיָ֥הוּ", "transliteral": "wa-ʿă-zar-yā-hû", "traducao_palavra": "e Azarias" },
        { "hebraico": "בֶן־נָתָ֖ן", "transliteral": "ben-nā-ṯān", "traducao_palavra": "filho de Natã" },
        { "hebraico": "עַל־הַנִּצָּבִ֑ים", "transliteral": "ʿal-han-niṣ-ṣā-ḇîm", "traducao_palavra": "sobre os prepostos/governadores" },
        { "hebraico": "וְזָב֧וּד", "transliteral": "wə-zā-ḇûḏ", "traducao_palavra": "e Zabude" },
