        { "hebraico": "אֲשֶׁ֥ר", "transliteral": "ʾă-šer", "traducao_palavra": "que" },
        { "hebraico": "יֹצֵ֖א", "transliteral": "yō-ṣē", "traducao_palavra": "sai/nasce" },
        { "hebraico": "בַּקִּ֑יר", "transliteral": "baq-qîr", "traducao_palavra": "na parede" },
        { "hebraico": "וַיְדַבֵּר֙", "transliteral": "way-ḏab-bēr", "traducao_palavra": "e falou" },
        { "hebraico": "עַל־הַבְּהֵמָ֣ה", "transliteral": "ʿal-hab-bə-hē-māh", "traducao_palavra": "sobre o animal" },
        { "hebraico": "וְעַל־הָעֹ֔וף", "transliteral": "wə-ʿal-hā-ʿôp̄", "traducao_palavra": "e sobre a ave" },
