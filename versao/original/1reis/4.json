    },
    "17": {
      "traducao_completa": "Josafá, filho de Parua, em Issacar;",
      "palavras": [
        { "hebraico": "יְהֹושָׁפָ֥ט", "transliteral": "yə-hō-wō-šā-p̄āṭ", "traducao_palavra": "Josafá" },
        { "hebraico": "בֶּן־פָּר֖וּחַ", "transliteral": "ben-pā-rû-aḥ", "traducao_palavra": "filho de Parua" },
        { "hebraico": "בְּיִשָּׂשׂכָֽר׃", "transliteral": "bə-yiś-śā-śə-ḵār", "traducao_palavra": "em Issacar" }
      ]
