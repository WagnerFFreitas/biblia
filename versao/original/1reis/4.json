        { "hebraico": "אֲשֶׁ֣ר", "transliteral": "ʾă-šer", "traducao_palavra": "que" },
        { "hebraico": "יִֽהְיֶה־שָּׁ֔ם", "transliteral": "yih-yeh-šām", "traducao_palavra": "estaria lá" },
        { "hebraico": "אִ֖ישׁ", "transliteral": "ʾîš", "traducao_palavra": "cada um" },
        { "hebraico": "כְּמִשְׁפָּטֹֽו׃", "transliteral": "kə-miš-pā-ṭô", "traducao_palavra": "segundo seu encargo/regra" }
      ]
    },
    "29": {
      "traducao_completa": "E deu Deus a Salomão sabedoria, e entendimento muitíssimo, e largura de coração, como a areia que está na praia do mar.",
      "palavras": [
