        { "hebraico": "חָנָֽן׃", "transliteral": "ḥā-nān", "traducao_palavra": "Hanã" }
      ]
    },
    "10": {
      "traducao_completa": "Ben-Hesede, em Arubote; a este pertenciam Socó e toda a terra de Hefer;",
      "palavras": [
        { "hebraico": "בֶּן־חֶ֖סֶד", "transliteral": "ben-ḥe-seḏ", "traducao_palavra": "Ben-Hesede" },
        { "hebraico": "בָּֽאֲרֻבֹּ֑ות", "transliteral": "bā-ʾă-rub-bôṯ", "traducao_palavra": "em Arubote" },
        { "hebraico": "לֹ֥ו", "transliteral": "lô", "traducao_palavra": "para ele" },
        { "hebraico": "שֹׂוכֹ֖ה", "transliteral": "śô-ḵōh", "traducao_palavra": "Socó" },
