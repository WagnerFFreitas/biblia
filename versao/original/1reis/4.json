      "palavras": [
        { "hebraico": "אֲחִימַ֖עַץ", "transliteral": "ʾă-ḥî-ma-ʿaṣ", "traducao_palavra": "Aimaás" },
        { "hebraico": "בְּנַפְתָּלִ֑י", "transliteral": "bə-nap̄-tā-lî", "traducao_palavra": "em Naftali" },
        { "hebraico": "גַּם־ה֕וּא", "transliteral": "gam-hû", "traducao_palavra": "também ele" },
        { "hebraico": "לָקַ֛ח", "transliteral": "lā-qaḥ", "traducao_palavra": "tomou" },
