        { "hebraico": "לְיִזְרְעֶ֔אל", "transliteral": "lə-yiz-rə-ʿel", "traducao_palavra": "Jezreel" },
        { "hebraico": "מִבֵּ֣ית", "transliteral": "mib-bêṯ", "traducao_palavra": "desde Bete-" },
