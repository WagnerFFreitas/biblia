        { "hebraico": "חָכְמַ֣ת", "transliteral": "ḥāḵ-maṯ", "traducao_palavra": "a sabedoria de" },
        { "hebraico": "שְׁלֹמֹ֔ה", "transliteral": "šə-lō-mōh", "traducao_palavra": "Salomão" },
        { "hebraico": "מֵֽחָכְמַ֖ת", "transliteral": "mē-ḥā-ḵə-maṯ", "traducao_palavra": "do que a sabedoria de" },
        { "hebraico": "כָּל־בְּנֵי־קֶ֑דֶם", "transliteral": "kāl-bə-nê-qe-ḏem", "traducao_palavra": "todos os filhos do oriente" },
        { "hebraico": "וּמִכֹּ֖ל", "transliteral": "ū-mik-kōl", "traducao_palavra": "e do que toda" },
        { "hebraico": "חָכְמַ֥ת", "transliteral": "ḥāḵ-maṯ", "traducao_palavra": "sabedoria de" },
        { "hebraico": "מִצְרָֽיִם׃", "transliteral": "miṣ-rā-yim", "traducao_palavra": "Egito" }
      ]
    },
    "31": {
      "traducao_completa": "E era ele mais sábio do que todos os homens, e do que Etã, ezraíta, e Heman, e Calcol, e Darda, filhos de Maol; e correu a sua fama por todas as nações em redor.",
      "palavras": [
        { "hebraico": "וַיֶּחְכַּם֙", "transliteral": "way-yeḥ-kam", "traducao_palavra": "e ele foi sábio" },
        { "hebraico": "מִכָּל־הָאָדָ֔ם", "transliteral": "mik-kāl-hā-ʾā-ḏām", "traducao_palavra": "mais que todo o homem" },
        { "hebraico": "מֵאֵיתָ֣ן", "transliteral": "mē-ʾê-ṯān", "traducao_palavra": "do que Etã" },
        { "hebraico": "הָאֶזְרָחִ֗י", "transliteral": "hā-ʾez-rā-ḥî", "traducao_palavra": "o ezraíta" },
        { "hebraico": "וְהֵימָ֧ן", "transliteral": "wə-hê-mān", "traducao_palavra": "e Heman" },
        { "hebraico": "וְכַלְכֹּ֛ל", "transliteral": "wə-ḵal-kōl", "traducao_palavra": "e Calcol" },
        { "hebraico": "וְדַרְדַּ֖ע", "transliteral": "wə-ḏar-da-ʿ", "traducao_palavra": "e Darda" },
        { "hebraico": "בְּנֵ֣י", "transliteral": "bə-nê", "traducao_palavra": "filhos de" },
        { "hebraico": "מָחֹ֑ול", "transliteral": "mā-ḥôl", "traducao_palavra": "Maol" },
        { "hebraico": "וַיְהִֽי־שְׁמֹ֥ו", "transliteral": "way-hî-šə-mô", "traducao_palavra": "e foi seu nome/fama" },
        { "hebraico": "בְכָל־הַגֹּויִ֖ם", "transliteral": "ḇə-ḵāl-hag-gô-yim", "traducao_palavra": "em todas as nações" },
        { "hebraico": "סָבִֽיב׃", "transliteral": "śā-ḇîḇ", "traducao_palavra": "em redor" }
