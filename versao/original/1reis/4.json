        { "hebraico": "לֶֽחֶם־שְׁלֹמֹ֛ה", "transliteral": "le-ḥem-šə-lō-mōh", "traducao_palavra": "o pão/alimento de Salomão" },
        { "hebraico": "לְיֹ֥ום", "transliteral": "lə-yôm", "traducao_palavra": "por dia" },
        { "hebraico": "אֶחָ֑ד", "transliteral": "ʾe-ḥāḏ", "traducao_palavra": "um" },
        { "hebraico": "שְׁלֹשִׁ֣ים", "transliteral": "šə-lō-šîm", "traducao_palavra": "trinta" },
        { "hebraico": "כֹּר֙", "transliteral": "kōr", "traducao_palavra": "coros" },
        { "hebraico": "סֹ֔לֶת", "transliteral": "sō-leṯ", "traducao_palavra": "flor de farinha" },
        { "hebraico": "וְשִׁשִּׁ֥ים", "transliteral": "wə-šiš-šîm", "traducao_palavra": "e sessenta" },
        { "hebraico": "כֹּ֖ר", "transliteral": "kōr", "traducao_palavra": "coros" },
        { "hebraico": "קָֽמַח׃", "transliteral": "qā-maḥ", "traducao_palavra": "farinha" }
      ]
    },
    "23": {
      "traducao_completa": "Dez bois cevados, e vinte bois de pasto, e cem carneiros; afora os veados e as cabras monteses, e os gamos, e aves cevadas.",
      "palavras": [
        { "hebraico": "עֲשָׂרָ֨ה", "transliteral": "ʿă-śā-rāh", "traducao_palavra": "dez" },
        { "hebraico": "בָקָ֜ר", "transliteral": "ḇā-qār", "traducao_palavra": "gado/bois" },
        { "hebraico": "בְּרִיאִ֗ים", "transliteral": "bə-rî-ʾîm", "traducao_palavra": "gordos/cevados" },
        { "hebraico": "וְעֶשְׂרִ֥ים", "transliteral": "wə-ʿeś-rîm", "traducao_palavra": "e vinte" },
        { "hebraico": "בָּקָ֛ר", "transliteral": "bā-qār", "traducao_palavra": "gado/bois" },
        { "hebraico": "רְעִ֖י", "transliteral": "rə-ʿî", "traducao_palavra": "de pasto" },
        { "hebraico": "וּמֵ֣אָה", "transliteral": "ū-mê-ʾāh", "traducao_palavra": "e cem" },
        { "hebraico": "צֹ֑אן", "transliteral": "ṣōn", "traducao_palavra": "ovelhas/carneiros" },
        { "hebraico": "לְבַ֞ד", "transliteral": "lə-ḇaḏ", "traducao_palavra": "afora/além de" },
        { "hebraico": "מֵֽאַיָּ֤ל", "transliteral": "mê-ʾay-yāl", "traducao_palavra": "cervo/veado" },
        { "hebraico": "וּצְבִי֙", "transliteral": "ū-ṣə-ḇî", "traducao_palavra": "e gazela" },
        { "hebraico": "וְיַחְמ֔וּר", "transliteral": "wə-yaḥ-mûr", "traducao_palavra": "e gamo" },
        { "hebraico": "וּבַרְבֻּרִ֖ים", "transliteral": "ū-ḇar-bu-rîm", "traducao_palavra": "e aves" },
        { "hebraico": "אֲבוּסִֽים׃", "transliteral": "ʾă-ḇû-śîm", "traducao_palavra": "cevadas/de curral" }
      ]
    },
    "24": {
      "traducao_completa": "Porque ele dominava sobre tudo o que estava desta banda do rio, desde Tifsa até Gaza, sobre todos os reis desta banda do rio; e tinha paz de todos os seus lados em redor.",
      "palavras": [
        { "hebraico": "כִּי־ה֞וּא", "transliteral": "kî-hû", "traducao_palavra": "porque ele" },
        { "hebraico": "רֹדֶ֣ה", "transliteral": "rō-ḏeh", "traducao_palavra": "dominava" },
        { "hebraico": "בְכָל־עֵ֣בֶר", "transliteral": "ḇə-ḵāl-ʿê-ḇer", "traducao_palavra": "em todo o lado de" },
        { "hebraico": "הַנָּהָ֗ר", "transliteral": "han-nā-hār", "traducao_palavra": "o rio [Eufrates]" },
        { "hebraico": "מִתִּפְסַח֙", "transliteral": "mit-tip̄-saḥ", "traducao_palavra": "desde Tifsa" },
        { "hebraico": "וְעַד־עַזָּ֔ה", "transliteral": "wə-ʿaḏ-ʿaz-zāh", "traducao_palavra": "e até Gaza" },
        { "hebraico": "בְּכָל־מַלְכֵ֖י", "transliteral": "bə-ḵāl-mal-ḵê", "traducao_palavra": "sobre todos os reis de" },
        { "hebraico": "עֵ֣בֶר", "transliteral": "ʿê-ḇer", "traducao_palavra": "além de/lado de" },
        { "hebraico": "הַנָּהָ֑ר", "transliteral": "han-nā-hār", "traducao_palavra": "o rio" },
        { "hebraico": "וְשָׁלֹ֗ום", "transliteral": "wə-šā-lôm", "traducao_palavra": "e paz" },
        { "hebraico": "הָ֥יָה", "transliteral": "hā-yāh", "traducao_palavra": "havia" },
        { "hebraico": "לֹ֛ו", "transliteral": "lô", "traducao_palavra": "para ele" },
        { "hebraico": "מִכָּל־עֲבָרָ֖יו", "transliteral": "mik-kāl-ʿă-ḇā-rāw", "traducao_palavra": "de todos os seus lados" },
        { "hebraico": "מִסָּבִֽיב׃", "transliteral": "mis-sā-ḇîḇ", "traducao_palavra": "em redor" }
      ]
    },
    "25": {
      "traducao_completa": "Judá e Israel habitavam seguros, cada um debaixo da sua videira e debaixo da sua figueira, desde Dã até Berseba, todos os dias de Salomão.",
      "palavras": [
        { "hebraico": "וַיֵּשֶׁב֩", "transliteral": "way-yē-šeḇ", "traducao_palavra": "e habitou" },
        { "hebraico": "יְהוּדָ֨ה", "transliteral": "yə-hû-ḏāh", "traducao_palavra": "Judá" },
        { "hebraico": "וְיִשְׂרָאֵ֜ל", "transliteral": "wə-yiś-rā-ʾēl", "traducao_palavra": "e Israel" },
        { "hebraico": "לָבֶ֗טַח", "transliteral": "lā-ḇe-ṭaḥ", "traducao_palavra": "em segurança" },
        { "hebraico": "אִ֣ישׁ", "transliteral": "ʾîš", "traducao_palavra": "cada homem" },
        { "hebraico": "תַּ֣חַת", "transliteral": "ta-ḥaṯ", "traducao_palavra": "debaixo de" },
        { "hebraico": "גַּפְנֹו֙", "transliteral": "gap̄-nô", "traducao_palavra": "sua videira" },
        { "hebraico": "וְתַ֣חַת", "transliteral": "wə-ṯa-ḥaṯ", "traducao_palavra": "e debaixo de" },
        { "hebraico": "תְּאֵנָתֹ֔ו", "transliteral": "tə-ʾê-nā-ṯô", "traducao_palavra": "sua figueira" },
        { "hebraico": "מִדָּ֖ן", "transliteral": "mid-dān", "traducao_palavra": "desde Dã" },
        { "hebraico": "וְעַד־בְּאֵ֣ר", "transliteral": "wə-ʿaḏ-bə-ʾēr", "traducao_palavra": "e até o poço de" },
        { "hebraico": "שָׁ֑בַע", "transliteral": "šā-ḇa-ʿ", "traducao_palavra": "sete [Berseba]" },
        { "hebraico": "כֹּ֖ל", "transliteral": "kōl", "traducao_palavra": "todos" },
        { "hebraico": "יְמֵ֥י", "transliteral": "yə-mê", "traducao_palavra": "dias de" },
        { "hebraico": "שְׁלֹמֹֽה׃", "transliteral": "šə-lō-mōh", "traducao_palavra": "Salomão" }
      ]
    },
    "26": {
      "traducao_completa": "Tinha também Salomão quarenta mil estribarias de cavalos para os seus carros, e doze mil cavaleiros.",
      "palavras": [
        { "hebraico": "וַיְהִ֣י", "transliteral": "way-hî", "traducao_palavra": "e tinha" },
        { "hebraico": "לִשְׁלֹמֹ֗ה", "transliteral": "liš-lō-mōh", "traducao_palavra": "para Salomão" },
        { "hebraico": "אַרְבָּעִ֥ים", "transliteral": "ʾar-bā-ʿîm", "traducao_palavra": "quarenta" },
        { "hebraico": "אֶ֛לֶף", "transliteral": "ʾe-lep̄", "traducao_palavra": "mil" },
        { "hebraico": "אֻרְוֹ֥ת", "transliteral": "ʾur-wōṯ", "traducao_palavra": "estribarias/manjedouras de" },
        { "hebraico": "סוּסִ֖ים", "transliteral": "sû-śîm", "traducao_palavra": "cavalos" },
        { "hebraico": "לְמֶרְכָּבֹ֑ו", "transliteral": "lə-mer-kā-ḇô", "traducao_palavra": "para seu carro" },
        { "hebraico": "וּשְׁנֵים־עָשָׂ֥ר", "transliteral": "ū-šə-nêm-ʿā-śār", "traducao_palavra": "e doze" },
        { "hebraico": "אֶ֖לֶף", "transliteral": "ʾe-lep̄", "traducao_palavra": "mil" },
        { "hebraico": "פָּרָשִֽׁים׃", "transliteral": "pā-rā-šîm", "traducao_palavra": "cavaleiros" }
      ]
    },
    "27": {
      "traducao_completa": "Proviam, pois, estes prepostos cada um no seu mês ao rei Salomão e a todos os que chegavam à mesa do rei Salomão; coisa nenhuma deixavam faltar.",
      "palavras": [
        { "hebraico": "וְכִלְכְּל֣וּ", "transliteral": "wə-ḵil-kə-lû", "traducao_palavra": "e sustentavam" },
        { "hebraico": "הַנִּצָּבִ֣ים", "transliteral": "han-niṣ-ṣā-ḇîm", "traducao_palavra": "os prepostos" },
        { "hebraico": "הָאֵ֡לֶּה", "transliteral": "hā-ʾēl-leh", "traducao_palavra": "estes" },
        { "hebraico": "אֶת־הַמֶּ֣לֶךְ", "transliteral": "ʾeṯ-ham-me-leḵ", "traducao_palavra": "ao rei" },
        { "hebraico": "שְׁלֹמֹה֩", "transliteral": "šə-lō-mōh", "traducao_palavra": "Salomão" },
        { "hebraico": "וְאֵ֨ת", "transliteral": "wə-ʾêṯ", "traducao_palavra": "e" },
        { "hebraico": "כָּל־הַקָּרֵ֧ב", "transliteral": "kāl-haq-qā-rēḇ", "traducao_palavra": "todo o que se chegava" },
        { "hebraico": "אֶל־שֻׁלְחַן־הַמֶּֽלֶךְ", "transliteral": "ʾel-šul-ḥan-ham-me-leḵ", "traducao_palavra": "à mesa do rei" },
        { "hebraico": "שְׁלֹמֹ֖ה", "transliteral": "šə-lō-mōh", "traducao_palavra": "Salomão" },
        { "hebraico": "אִ֣ישׁ", "transliteral": "ʾîš", "traducao_palavra": "cada um" },
        { "hebraico": "חָדְשֹׁ֑ו", "transliteral": "ḥāḏ-šô", "traducao_palavra": "em seu mês" },
        { "hebraico": "לֹ֥א", "transliteral": "lō", "traducao_palavra": "não" },
        { "hebraico": "יְעַדְּר֖וּ", "transliteral": "yə-ʿad-də-rû", "traducao_palavra": "deixavam faltar" },
        { "hebraico": "דָּבָֽר׃", "transliteral": "dā-ḇār", "traducao_palavra": "coisa alguma" }
      ]
    },
    "28": {
      "traducao_completa": "E traziam a cevada e a palha para os cavalos e para os ginetes, para o lugar onde estava cada um, segundo o seu cargo.",
      "palavras": [
        { "hebraico": "וְהַשְּׂעֹרִ֣ים", "transliteral": "wə-haś-śə-ʿō-rîm", "traducao_palavra": "e as cevadas" },
        { "hebraico": "וְהַתֶּ֔בֶן", "transliteral": "wə-hat-te-ḇen", "traducao_palavra": "e a palha" },
        { "hebraico": "לַסּוּסִ֖ים", "transliteral": "las-śû-śîm", "traducao_palavra": "para os cavalos" },
        { "hebraico": "וְלָרֶ֑כֶשׁ", "transliteral": "wə-lā-re-ḵeš", "traducao_palavra": "e para os velozes/ginetes" },
