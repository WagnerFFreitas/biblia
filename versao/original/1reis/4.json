        { "hebraico": "מֵעֵ֥בֶר", "transliteral": "mê-ʿê-ḇer", "traducao_palavra": "além de" },
        { "hebraico": "לְיָקְמְעָֽם׃", "transliteral": "lə-yā-qə-mə-ʿām", "traducao_palavra": "Jocmeão" }
      ]
