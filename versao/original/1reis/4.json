    "20": {
      "traducao_completa": "Judá e Israel eram muitos, como a areia que está junto ao mar em multidão, comendo e bebendo e alegrando-se.",
      "palavras": [
        { "hebraico": "יְהוּדָ֧ה", "transliteral": "yə-hû-ḏāh", "traducao_palavra": "Judá" },
        { "hebraico": "וְיִשְׂרָאֵ֛ל", "transliteral": "wə-yiś-rā-ʾēl", "traducao_palavra": "e Israel" },
        { "hebraico": "רַבִּ֖ים", "transliteral": "rab-bîm", "traducao_palavra": "[eram] muitos" },
        { "hebraico": "כַּחֹ֥ול", "transliteral": "ka-ḥôl", "traducao_palavra": "como a areia" },
        { "hebraico": "אֲשֶׁר־עַל־הַיָּ֖ם", "transliteral": "ʾă-šer-ʿal-hay-yām", "traducao_palavra": "que [está] sobre o mar" },
        { "hebraico": "לָרֹ֑ב", "transliteral": "lā-rōḇ", "traducao_palavra": "em multidão" },
