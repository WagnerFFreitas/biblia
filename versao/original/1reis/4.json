        { "hebraico": "חַוֹּת֩", "transliteral": "ḥaw-wōṯ", "traducao_palavra": "as aldeias de" },
        { "hebraico": "יָאִ֨יר", "transliteral": "yā-ʾîr", "traducao_palavra": "Jair" },
        { "hebraico": "בֶּן־מְנַשֶּׁ֜ה", "transliteral": "ben-mə-naš-šeh", "traducao_palavra": "filho de Manassés" },
        { "hebraico": "אֲשֶׁ֣ר", "transliteral": "ʾă-šer", "traducao_palavra": "que" },
        { "hebraico": "בַּגִּלְעָ֗ד", "transliteral": "bag-gil-ʿāḏ", "traducao_palavra": "em Gileade" },
        { "hebraico": "לֹ֚ו", "transliteral": "lô", "traducao_palavra": "para ele" },
