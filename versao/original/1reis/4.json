      ]
    },
    "6": {
      "traducao_completa": "E Aíçar, o mordomo; e Adoniram, filho de Abda, sobre o tributo.",
      "palavras": [
        { "hebraico": "וַאֲחִישָׁ֖ר", "transliteral": "wa-ʾă-ḥî-šār", "traducao_palavra": "e Aíçar" },
        { "hebraico": "עַל־הַבָּ֑יִת", "transliteral": "ʿal-hab-bā-yiṯ", "traducao_palavra": "sobre a casa/mordomo" },
        { "hebraico": "וַאֲדֹנִירָ֥ם", "transliteral": "wa-ʾă-ḏō-nî-rām", "traducao_palavra": "e Adoniram" },
        { "hebraico": "בֶּן־עַבְדָּ֖א", "transliteral": "ben-ʿaḇ-dā", "traducao_palavra": "filho de Abda" },
        { "hebraico": "עַל־הַמַּֽס׃", "transliteral": "ʿal-ham-mas", "traducao_palavra": "sobre o imposto/trabalho forçado" }
      ]
    },
    "7": {
      "traducao_completa": "E tinha Salomão doze prepostos sobre todo o Israel, que proviam ao rei e à sua casa; e cada um tinha a seu cargo prover mantimento um mês no ano.",
      "palavras": [
        { "hebraico": "וְלִשְׁלֹמֹה֩", "transliteral": "wə-liš-lō-mōh", "traducao_palavra": "e para Salomão [havia]" },
        { "hebraico": "שְׁנֵים־עָשָׂ֨ר", "transliteral": "šə-nêm-ʿā-śār", "traducao_palavra": "doze" },
        { "hebraico": "נִצָּבִ֜ים", "transliteral": "niṣ-ṣā-ḇîm", "traducao_palavra": "prepostos" },
        { "hebraico": "עַל־כָּל־יִשְׂרָאֵ֗ל", "transliteral": "ʿal-kāl-yiś-rā-ʾēl", "traducao_palavra": "sobre todo o Israel" },
        { "hebraico": "וְכִלְכְּל֤וּ", "transliteral": "wə-ḵil-kə-lû", "traducao_palavra": "e eles proviam mantimento" },
        { "hebraico": "אֶת־הַמֶּ֙לֶךְ֙", "transliteral": "ʾeṯ-ham-me-leḵ", "traducao_palavra": "ao rei" },
        { "hebraico": "ואֶת־בֵּיתֹ֔ו", "transliteral": "wə-ʾeṯ-bê-ṯô", "traducao_palavra": "e à sua casa" },
        { "hebraico": "חֹ֧דֶשׁ", "transliteral": "ḥō-ḏeš", "traducao_palavra": "um mês" },
        { "hebraico": "בַּשָּׁנָ֛ה", "transliteral": "baš-šā-nāh", "traducao_palavra": "no ano" },
        { "hebraico": "יִהְיֶ֥ה", "transliteral": "yih-yeh", "traducao_palavra": "seria" },
        { "hebraico": "עַל־הָאֶחָ֖ד", "transliteral": "ʿal-hā-ʾe-ḥāḏ", "traducao_palavra": "sobre cada um" },
        { "hebraico": "לְכַלְכֵּֽל׃", "transliteral": "lə-ḵal-kēl", "traducao_palavra": "prover" }
      ]
    },
    "8": {
      "traducao_completa": "E estes são os seus nomes: Ben-Hur, na montanha de Efraim;",
      "palavras": [
        { "hebraico": "וְאֵ֥לֶּה", "transliteral": "wə-ʾēl-leh", "traducao_palavra": "e estes [são]" },
        { "hebraico": "שְׁמֹותָ֖ם", "transliteral": "šə-mô-ṯām", "traducao_palavra": "seus nomes" },
        { "hebraico": "בֶּן־ח֖וּר", "transliteral": "ben-ḥûr", "traducao_palavra": "Ben-Hur" },
        { "hebraico": "בְּהַ֥ר", "transliteral": "bə-har", "traducao_palavra": "na montanha de" },
        { "hebraico": "אֶפְרָֽיִם׃", "transliteral": "ʾep̄-rā-yim", "traducao_palavra": "Efraim" }
