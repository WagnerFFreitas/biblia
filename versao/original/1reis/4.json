    "33": {
      "traducao_completa": "Também falou das árvores, desde o cedro que está no Líbano até ao hissopo que nasce na parede; também falou dos animais e das aves, e dos répteis e dos peixes.",
      "palavras": [
        { "hebraico": "וַיְדַבֵּר֮", "transliteral": "way-ḏab-bēr", "traducao_palavra": "e falou" },
        { "hebraico": "עַל־הָעֵצִים֒", "transliteral": "ʿal-hā-ʿê-ṣîm", "traducao_palavra": "sobre as árvores" },
        { "hebraico": "מִן־הָאֶ֙רֶז֙", "transliteral": "min-hā-ʾe-rez", "traducao_palavra": "desde o cedro" },
