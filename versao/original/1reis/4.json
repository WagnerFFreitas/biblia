    "9": {
      "traducao_completa": "Ben-Dequer, em Macas, e em Saalbim, e em Bete-Semes, e em Elom-Bete-Hanã;",
      "palavras": [
        { "hebraico": "בֶּן־דֶּ֛קֶר", "transliteral": "ben-de-qer", "traducao_palavra": "Ben-Dequer" },
        { "hebraico": "בְּמָקַ֥ץ", "transliteral": "bə-mā-qaṣ", "traducao_palavra": "em Macas" },
        { "hebraico": "וּבְשַׁעַלְבִ֖ים", "transliteral": "ū-ḇə-ša-ʿal-ḇîm", "traducao_palavra": "e em Saalbim" },
        { "hebraico": "וּבֵ֣ית", "transliteral": "ū-ḇêṯ", "traducao_palavra": "e Bete-" },
