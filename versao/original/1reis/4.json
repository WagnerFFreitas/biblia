        { "hebraico": "מְאֹ֑ד", "transliteral": "mə-ʾōḏ", "traducao_palavra": "extremamente" },
        { "hebraico": "וְרֹ֣חַב", "transliteral": "wə-rō-ḥaḇ", "traducao_palavra": "e largura de" },
        { "hebraico": "לֵ֔ב", "transliteral": "lēḇ", "traducao_palavra": "coração/mente" },
        { "hebraico": "כַּחֹ֕ול", "transliteral": "ka-ḥôl", "traducao_palavra": "como a areia" },
        { "hebraico": "אֲשֶׁ֖ר", "transliteral": "ʾă-šer", "traducao_palavra": "que [está]" },
        { "hebraico": "עַל־שְׂפַ֥ת", "transliteral": "ʿal-śə-p̄aṯ", "traducao_palavra": "na margem de" },
        { "hebraico": "הַיָּֽם׃", "transliteral": "hay-yām", "traducao_palavra": "o mar" }
      ]
    },
    "30": {
      "traducao_completa": "E era a sabedoria de Salomão maior do que a sabedoria de todos os filhos do oriente, e do que toda a sabedoria dos egípcios.",
      "palavras": [
