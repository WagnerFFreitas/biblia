        { "hebraico": "וּשְׂמֵחִֽים׃", "transliteral": "ū-śə-mê-ḥîm", "traducao_palavra": "e alegrando-se" }
      ]
    },
    "21": {
      "traducao_completa": "E dominava Salomão sobre todos os reinos, desde o rio até à terra dos filisteus e até ao termo do Egito; os quais traziam presentes e serviram a Salomão todos os dias da sua vida.",
      "palavras": [
        { "hebraico": "וּשְׁלֹמֹ֗ה", "transliteral": "ū-šə-lō-mōh", "traducao_palavra": "e Salomão" },
        { "hebraico": "הָיָ֤ה", "transliteral": "hā-yāh", "traducao_palavra": "era/foi" },
        { "hebraico": "מֹושֵׁל֙", "transliteral": "mô-šēl", "traducao_palavra": "dominador" },
        { "hebraico": "בְּכָל־הַמַּמְלָכֹ֔ות", "transliteral": "bə-ḵāl-ham-mam-lā-ḵôṯ", "traducao_palavra": "sobre todos os reinos" },
        { "hebraico": "מִן־הַנָּהָר֙", "transliteral": "min-han-nā-hār", "traducao_palavra": "desde o rio [Eufrates]" },
        { "hebraico": "אֶ֣רֶץ", "transliteral": "ʾe-reṣ", "traducao_palavra": "[até] a terra de" },
        { "hebraico": "פְּלִשְׁתִּ֔ים", "transliteral": "pə-liš-tîm", "traducao_palavra": "filisteus" },
        { "hebraico": "וְעַ֖ד", "transliteral": "wə-ʿaḏ", "traducao_palavra": "e até" },
        { "hebraico": "גְּב֣וּל", "transliteral": "gə-ḇûl", "traducao_palavra": "fronteira de" },
        { "hebraico": "מִצְרָ֑יִם", "transliteral": "miṣ-rā-yim", "traducao_palavra": "Egito" },
        { "hebraico": "מַגִּישִׁ֥ים", "transliteral": "mag-gî-šîm", "traducao_palavra": "trazendo" },
        { "hebraico": "מִנְחָ֛ה", "transliteral": "min-ḥāh", "traducao_palavra": "presente/tributo" },
        { "hebraico": "וְעֹבְדִ֥ים", "transliteral": "wə-ʿō-ḇə-ḏîm", "traducao_palavra": "e servindo" },
        { "hebraico": "אֶת־שְׁלֹmֹ֖ה", "transliteral": "ʾeṯ-šə-lō-mōh", "traducao_palavra": "a Salomão" },
        { "hebraico": "כָּל־יְמֵ֥י", "transliteral": "kāl-yə-mê", "traducao_palavra": "todos os dias de" },
