        { "hebraico": "כֹּהֵ֖ן", "transliteral": "kō-hên", "traducao_palavra": "sacerdote" },
        { "hebraico": "רֵעֶ֥ה", "transliteral": "rē-ʿeh", "traducao_palavra": "amigo/conselheiro" },
