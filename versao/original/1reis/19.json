        { "hebraico": "הָרַ֛ג", "transliteral": "hā-raḡ", "traducao_palavra": "matara" },
        { "hebraico": "אֶת־כָּל־הַנְּבִיאִ֖ים", "transliteral": "ʾeṯ-kāl-han-nə-ḇî-ʾîm", "traducao_palavra": "a todos os profetas" },
