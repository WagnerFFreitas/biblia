        { "hebraico": "אֶת־חֶפְצִ֔י", "transliteral": "ʾeṯ-ḥep̄-ṣî", "traducao_palavra": "o meu desejo" },
        { "hebraico": "לָתֵ֖ת", "transliteral": "lā-ṯêṯ", "traducao_palavra": "em dar" },
