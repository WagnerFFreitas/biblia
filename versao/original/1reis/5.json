        { "hebraico": "עַֽד־הַמָּקֹ֧ום", "transliteral": "ʿaḏ-ham-mā-qôm", "traducao_palavra": "até o lugar" },
        { "hebraico": "אֲשֶׁר־תִּשְׁלַ֥ח", "transliteral": "ʾă-šer-tiš-laḥ", "traducao_palavra": "que designares/enviares" },
        { "hebraico": "אֵלַ֛י", "transliteral": "ʾē-lay", "traducao_palavra": "a mim" },
        { "hebraico": "וּנִפַּצְתִּ֥ים", "transliteral": "ū-nip-paṣ-tîm", "traducao_palavra": "e os desatarei/espalharei" },
        { "hebraico": "שָׁ֖ם", "transliteral": "šām", "traducao_palavra": "ali" },
        { "hebraico": "וְאַתָּ֣ה", "transliteral": "wə-at-tā", "traducao_palavra": "e tu" },
        { "hebraico": "תִשָּׂ֑א", "transliteral": "tiś-śā", "traducao_palavra": "[os] tomarás/levarás" },
        { "hebraico": "וְאַתָּה֙", "transliteral": "wə-at-tā", "traducao_palavra": "e tu" },
