        { "hebraico": "חֳדָשִׁ֖ים", "transliteral": "ḥŏ-ḏā-šîm", "traducao_palavra": "meses" },
        { "hebraico": "בְּבֵיתֹ֑ו", "transliteral": "bə-ḇê-ṯô", "traducao_palavra": "em sua casa" },
