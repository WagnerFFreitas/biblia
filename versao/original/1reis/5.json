        { "hebraico": "לְבֵיתֹ֔ו", "transliteral": "lə-ḇê-ṯô", "traducao_palavra": "para sua casa" },
        { "hebraico": "וְעֶשְׂרִ֥ים", "transliteral": "wə-ʿeś-rîm", "traducao_palavra": "e vinte" },
