        { "hebraico": "מֵאֹ֑ות", "transliteral": "mē-ʾôṯ", "traducao_palavra": "centenas" },
        { "hebraico": "הָרֹדִ֣ים", "transliteral": "hā-rō-ḏîm", "traducao_palavra": "dominadores/encarregados" },
