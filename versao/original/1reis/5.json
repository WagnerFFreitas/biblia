        { "hebraico": "אֲלָפִ֤ים", "transliteral": "ʾă-lā-p̄îm", "traducao_palavra": "mil" },
        { "hebraico": "בַּחֹ֙דֶשׁ֙", "transliteral": "ba-ḥō-ḏeš", "traducao_palavra": "no mês" },
        { "hebraico": "חֲלִיפֹ֔ות", "transliteral": "ḥă-lî-p̄ôṯ", "traducao_palavra": "por turnos/revezamentos" },
