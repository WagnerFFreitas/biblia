        { "hebraico": "גַּת", "transliteral": "gaṯ", "traducao_palavra": "Gate" },
        { "hebraico": "וּבְנֹתֶ֖יהָ", "transliteral": "ū-ḇĕ-nō-ṯê-hā", "traducao_palavra": "e suas aldeias" },
        { "hebraico": "מִיַּ֥ד", "transliteral": "miy-yaḏ", "traducao_palavra": "da mão de" },
