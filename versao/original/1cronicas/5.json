        { "hebraico": "וְכֹ֣ל", "transliteral": "wə-ḵōl", "traducao_palavra": "e todos" },
        { "hebraico": "שֶׁעִמָּהֶ֑ם", "transliteral": "še-ʿim-mā-hem", "traducao_palavra": "que [estavam] com eles" },
        { "hebraico": "כִּ֣י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "לֵאלֹהִ֤ים", "transliteral": "lē-ʾlō-hîm", "traducao_palavra": "a Deus" },
        { "hebraico": "זָעֲק֥וּ", "transliteral": "zā-ʿă-qû", "traducao_palavra": "clamaram" },
        { "hebraico": "בַּמִּלְחָמָה֙", "transliteral": "bam-mil-ḥā-mā", "traducao_palavra": "na guerra" },
        { "hebraico": "וְנַעְתֹּ֣ור", "transliteral": "wə-na-ʿtôr", "traducao_palavra": "e ele ouviu" },
