        { "hebraico": "נִתְּנָה֙", "transliteral": "nit-tə-nā", "traducao_palavra": "foi dada" },
        { "hebraico": "בְּכֹֽרָתֹ֔ו", "transliteral": "bə-ḵō-rā-ṯô", "traducao_palavra": "sua primogenitura" },
        { "hebraico": "לִבְנֵ֥י", "transliteral": "liḇ-nê", "traducao_palavra": "aos filhos de" },
