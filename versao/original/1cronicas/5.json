        { "hebraico": "הַֽהַגְרִיאִ֑ים", "transliteral": "ha-haḡ-rî-ʾîm", "traducao_palavra": "os hagarenos" },
        { "hebraico": "וִיט֥וּר", "transliteral": "wî-ṭûr", "traducao_palavra": "e Jetur" },
