      ]
    },
    "20": {
      "traducao_completa": "E foram ajudados contra eles, e os hagarenos foram entregues nas suas mãos, e todos os que estavam com eles; porquanto clamaram a Deus na peleja, e ele lhes deu ouvidos, porquanto confiaram nele.",
      "palavras": [
        { "hebraico": "וַיֵּעָזְר֣וּ", "transliteral": "way-yê-ʿā-zə-rû", "traducao_palavra": "e foram ajudados" },
