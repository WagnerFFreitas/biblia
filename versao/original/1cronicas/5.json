        { "hebraico": "וַחֲמִשִּׁ֥ים", "transliteral": "wa-ḥă-miš-śîm", "traducao_palavra": "e cinquenta" },
        { "hebraico": "אֶ֖לֶף", "transliteral": "ʾe-lep̄", "traducao_palavra": "mil" },
        { "hebraico": "וַחֲמֹורִ֖ים", "transliteral": "wa-ḥă-mô-rîm", "traducao_palavra": "e jumentos" },
        { "hebraico": "אַלְפָּ֑יִם", "transliteral": "ʾal-pā-yim", "traducao_palavra": "dois mil" },
        { "hebraico": "וְנֶ֥פֶשׁ", "transliteral": "wə-ne-p̄eš", "traducao_palavra": "e pessoas" },
