        { "hebraico": "וְלַֽמַּעֲרָב֙", "transliteral": "wə-lam-ma-ʿă-rāḇ", "traducao_palavra": "e ao ocidente" },
        { "hebraico": "גֶּ֣זֶר", "transliteral": "ge-zer", "traducao_palavra": "Gezer" },
        { "hebraico": "וּבְנֹתֶ֔יהָ", "transliteral": "ū-ḇə-nō-ṯê-hā", "traducao_palavra": "e suas aldeias" },
        { "hebraico": "וּשְׁכֶ֖ם", "transliteral": "ū-šə-ḵem", "traducao_palavra": "e Siquém" },
        { "hebraico": "וּבְנֹתֶ֑יהָ", "transliteral": "ū-ḇə-nō-ṯê-hā", "traducao_palavra": "e suas aldeias" },
