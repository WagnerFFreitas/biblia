    "38": {
      "traducao_completa": "E-este o-que oferecerás sobre o-altar; cordeiros filhos-de um-ano dois para-o-dia sempre.",
      "palavras": [
        { "hebraico": "וְזֶה", "transliteral": "vezeh", "traducao_palavra": "E-este" },
