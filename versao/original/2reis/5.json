        { "hebraico": "וַיֵּלֵֽכוּ׃", "transliteral": "way-yê-lê-ḵû", "traducao_palavra": "e foram eles" }
      ]
    },
    "25": {
      "traducao_completa": "Então ele entrou, e pôs-se diante de seu senhor. E disse-lhe Eliseu: De onde vens, Geazi? E ele disse: Teu servo não foi a parte alguma.",
      "palavras": [
        { "hebraico": "וְהֽוּא־בָא֙", "transliteral": "wə-hû-ḇā", "traducao_palavra": "e ele veio/entrou" },
        { "hebraico": "וַיַּעֲמֹ֣ד", "transliteral": "way-ya-ʿă-mōḏ", "traducao_palavra": "e parou" },
        { "hebraico": "אֶל־אֲדֹנָ֑יו", "transliteral": "ʾel-ʾă-ḏō-nāyw", "traducao_palavra": "perante seu senhor" },
        { "hebraico": "וַיֹּ֤אמֶר", "transliteral": "way-yō-mer", "traducao_palavra": "e disse" },
        { "hebraico": "אֵלָיו֙", "transliteral": "ʾê-lāyw", "traducao_palavra": "a ele" },
        { "hebraico": "אֱלִישָׁ֔ע", "transliteral": "ʾĕ-lî-šāʿ", "traducao_palavra": "Eliseu" },
        { "hebraico": "מאן", "transliteral": "mê-ʾayin", "traducao_palavra": "de onde" },
        { "hebraico": "גֵּיחֲזִ֑י", "transliteral": "gê-ḥă-zî", "traducao_palavra": "Geazi?" },
        { "hebraico": "וַיֹּ֕אמֶר", "transliteral": "way-yō-mer", "traducao_palavra": "e disse ele" },
        { "hebraico": "לֹא־הָלַ֥ךְ", "transliteral": "lō-hā-laḵ", "traducao_palavra": "não foi" },
        { "hebraico": "עַבְדְּךָ֖", "transliteral": "ʿaḇ-də-ḵā", "traducao_palavra": "teu servo" },
        { "hebraico": "אָ֥נֶה", "transliteral": "ʾā-neh", "traducao_palavra": "para lugar" },
        { "hebraico": "וָאָֽנֶה׃", "transliteral": "wā-ʾā-neh", "traducao_palavra": "e lugar [algum]" }
      ]
    },
    "26": {
      "traducao_completa": "Porem ele lhe disse: Porventura não foi contigo o meu coração, quando aquele homem voltou do seu carro a encontrar-te? Era a ocasião para aceitares prata, e para aceitares roupas, e olivais, e vinhas, e ovelhas, e bois, e servos, e servas?",
      "palavras": [
        { "hebraico": "וַיֹּ֣אמֶר", "transliteral": "way-yō-mer", "traducao_palavra": "e disse ele" },
        { "hebraico": "אֵלָ֔יו", "transliteral": "ʾê-lāyw", "traducao_palavra": "a ele" },
        { "hebraico": "לֹא־לִבִּ֣י", "transliteral": "lō-lib-bî", "traducao_palavra": "acaso não meu coração" },
        { "hebraico": "הָלַ֔ךְ", "transliteral": "hā-laḵ", "traducao_palavra": "foi" },
        { "hebraico": "כַּאֲשֶׁ֧ר", "transliteral": "ka-ʾă-šer", "traducao_palavra": "quando" },
        { "hebraico": "הָפַךְ־אִ֛ישׁ", "transliteral": "hā-p̄aḵ-ʾîš", "traducao_palavra": "voltou o homem" },
        { "hebraico": "מֵעַ֥ל", "transliteral": "mê-ʿal", "traducao_palavra": "de sobre" },
        { "hebraico": "מֶרְכַּבְתֹּ֖ו", "transliteral": "mer-kaḇ-tô", "traducao_palavra": "seu carro" },
        { "hebraico": "לִקְרָאתֶ֑ךָ", "transliteral": "liq-rā-ṯe-ḵā", "traducao_palavra": "ao encontro de ti?" },
        { "hebraico": "הַעֵ֤ת", "transliteral": "ha-ʿēṯ", "traducao_palavra": "acaso tempo" },
        { "hebraico": "לָקַ֙חַת֙", "transliteral": "lā-qa-ḥaṯ", "traducao_palavra": "de tomar" },
        { "hebraico": "אֶת־הַכֶּ֔סֶף", "transliteral": "ʾeṯ-hak-ke-sep̄", "traducao_palavra": "a prata" },
        { "hebraico": "וְלָקַ֣חַת", "transliteral": "wə-lā-qa-ḥaṯ", "traducao_palavra": "e de tomar" },
        { "hebraico": "בְּגָדִ֔ים", "transliteral": "bə-ḡā-ḏîm", "traducao_palavra": "vestes" },
        { "hebraico": "וְזֵיתִים֙", "transliteral": "wə-zê-ṯîm", "traducao_palavra": "e olivais" },
        { "hebraico": "וּכְרָמִ֔ים", "transliteral": "ū-ḵə-rā-mîm", "traducao_palavra": "e vinhas" },
        { "hebraico": "וְצֹ֤אן", "transliteral": "wə-ṣōn", "traducao_palavra": "e ovelhas" },
        { "hebraico": "וּבָקָ֔ר", "transliteral": "ū-ḇā-qār", "traducao_palavra": "e bois" },
        { "hebraico": "וַעֲבָדִ֖ים", "transliteral": "wa-ʿă-ḇā-ḏîm", "traducao_palavra": "e servos" },
        { "hebraico": "וּשְׁפָחֹֽות׃", "transliteral": "ū-šə-p̄ā-ḥô-wṯ", "traducao_palavra": "e servas?" }
      ]
    },
    "27": {
      "traducao_completa": "Portanto a lepra de Naamã se apegará a ti e à tua semente para sempre. Então saiu de diante dele leproso, branco como a neve.",
      "palavras": [
        { "hebraico": "וְצָרַ֤עַת", "transliteral": "wə-ṣā-ra-ʿaṯ", "traducao_palavra": "e a lepra de" },
        { "hebraico": "נַעֲמָן֙", "transliteral": "na-ʿă-mān", "traducao_palavra": "Naamã" },
        { "hebraico": "תִּֽדְבַּק־בְּךָ֔", "transliteral": "tiḏ-baq-bə-ḵā", "traducao_palavra": "apegar-se-á em ti" },
        { "hebraico": "וּבְזַרְעֲךָ֖", "transliteral": "ū-ḇə-zar-ʿă-ḵā", "traducao_palavra": "e em tua semente" },
        { "hebraico": "לְעֹולָ֑ם", "transliteral": "lə-ʿô-lām", "traducao_palavra": "para sempre" },
        { "hebraico": "וַיֵּצֵ֥א", "transliteral": "way-yê-ṣê", "traducao_palavra": "e saiu ele" },
        { "hebraico": "מִלְּפָנָ֖יו", "transliteral": "mil-lə-p̄ā-nāyw", "traducao_palavra": "de diante dele" },
        { "hebraico": "מְצֹרָ֥ע", "transliteral": "mə-ṣō-rāʿ", "traducao_palavra": "[como] leproso" },
        { "hebraico": "כַּשָּֽׁלֶג׃", "transliteral": "kaš-šā-leḡ", "traducao_palavra": "como a neve" }
