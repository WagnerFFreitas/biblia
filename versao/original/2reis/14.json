        { "hebraico": "וְחָמֵ֤שׁ", "transliteral": "wə-ḥā-mêš", "traducao_palavra": "e cinco" },
        { "hebraico": "שָׁנָה֙", "transliteral": "šā-nā", "traducao_palavra": "anos" },
        { "hebraico": "הָיָ֣ה", "transliteral": "hā-yā", "traducao_palavra": "tinha" },
        { "hebraico": "בְמָלְכֹ֔ו", "transliteral": "ḇə-mā-lə-ḵô", "traducao_palavra": "ao seu reinar" },
        { "hebraico": "וְעֶשְׂרִ֤ים", "transliteral": "wə-ʿeś-rîm", "traducao_palavra": "e vinte" },
        { "hebraico": "וָתֵ֙שַׁע֙", "transliteral": "wā-ṯê-šaʿ", "traducao_palavra": "e nove" },
