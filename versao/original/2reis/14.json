        { "hebraico": "וְשֵׁ֣ם", "transliteral": "wə-šêm", "traducao_palavra": "e o nome de" },
        { "hebraico": "אִמֹּ֔ו", "transliteral": "ʾim-mô", "traducao_palavra": "sua mãe" },
        { "hebraico": "יהועדין", "transliteral": "yə-hô-ʿad-dîn", "traducao_palavra": "Jeoadã [Qere: yə-hô-ʿad-dān]" },
