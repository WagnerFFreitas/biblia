        { "hebraico": "בֶּן־יֹואָחָ֖ז", "transliteral": "ben-yô-ʾā-ḥāz", "traducao_palavra": "filho de Jeoacaz" },
        { "hebraico": "מֶ֣לֶךְ", "transliteral": "me-leḵ", "traducao_palavra": "rei de" },
        { "hebraico": "יִשְׂרָאֵ֑ל", "transliteral": "yiś-rā-ʾēl", "traducao_palavra": "Israel" },
        { "hebraico": "מָלַ֛ךְ", "transliteral": "mā-laḵ", "traducao_palavra": "reinou" },
