        { "hebraico": "אֵ֥ת", "transliteral": "ʾêṯ", "traducao_palavra": "[partícula]" },
        { "hebraico": "כָּל־זֶ֥רַע", "transliteral": "kāl-ze-raʿ", "traducao_palavra": "toda a semente/descendência" },
        { "hebraico": "הַמַּמְלָכָֽה׃", "transliteral": "ham-mam-lā-ḵā", "traducao_palavra": "do reino/real" }
      ]
    },
    "2": {
      "traducao_completa": "Mas Jeoseba, filha do rei Jeorão, irmã de Acazias, tomou a Joás, filho de Acazias, e o furtou do meio dos filhos do rei, aos quais matavam, e o pôs, a ele e à sua ama, na câmara dos leitos, e o esconderam de Atalia, de modo que não foi morto.",
      "palavras": [
        { "hebraico": "וַתִּקַּ֣ח", "transliteral": "wat-tiq-qaḥ", "traducao_palavra": "e tomou" },
        { "hebraico": "יְהֹושֶׁ֣בַע", "transliteral": "yə-hō-wō-še-ḇaʿ", "traducao_palavra": "Jeoseba" },
        { "hebraico": "בַּת־הַמֶּֽלֶךְ־יְהֹורָם֩", "transliteral": "baṯ-ham-me-leḵ-yə-hō-wō-rām", "traducao_palavra": "filha do rei Jeorão" },
        { "hebraico": "אֲחֹ֨ות", "transliteral": "ʾă-ḥôṯ", "traducao_palavra": "irmã de" },
