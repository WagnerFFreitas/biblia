    "5": {
      "traducao_completa": "E deu-lhes ordem, dizendo: Isto é o que haveis de fazer: uma terça parte de vós, que entrais no sábado, fará a guarda da casa do rei;",
      "palavras": [
        { "hebraico": "וַיְצַוֵּ֥ם", "transliteral": "way-ṣaw-wêm", "traducao_palavra": "e ordenou-lhes" },
