        { "hebraico": "וּבַשָּׁנָ֨ה", "transliteral": "ū-ḇaš-šā-nā", "traducao_palavra": "e no ano" },
        { "hebraico": "הַשְּׁבִיעִ֜ית", "transliteral": "haš-šə-ḇî-ʿîṯ", "traducao_palavra": "sétimo" },
        { "hebraico": "שָׁלַ֣ח", "transliteral": "šā-laḥ", "traducao_palavra": "enviou" },
