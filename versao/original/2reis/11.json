        { "hebraico": "ס֑וּר", "transliteral": "sûr", "traducao_palavra": "Sur" },
        { "hebraico": "וְהַשְּׁלִשִׁ֥ית", "transliteral": "wə-haš-šə-li-šîṯ", "traducao_palavra": "e a terça parte" },
