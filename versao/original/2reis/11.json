    "8": {
      "traducao_completa": "E cercareis o rei em redor, cada um com as suas armas na mão; e aquele que entrar entre as fileiras, morra; e estai com o rei quando sair e quando entrar.",
      "palavras": [
        { "hebraico": "וְהִקַּפְתֶּ֨ם", "transliteral": "wə-hiq-qap̄-tem", "traducao_palavra": "e cercareis" },
