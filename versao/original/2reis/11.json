        { "hebraico": "אֹתֹו֙", "transliteral": "ʾō-ṯô", "traducao_palavra": "ele" },
        { "hebraico": "מִתֹּ֤וךְ", "transliteral": "mit-tôḵ", "traducao_palavra": "do meio de" },
