        { "hebraico": "אַחֲרֵ֣י", "transliteral": "ʾa-ḥă-rê", "traducao_palavra": "atrás de" },
        { "hebraico": "הָרָצִ֑ים", "transliteral": "hā-rā-ṣîm", "traducao_palavra": "os guardas" },
        { "hebraico": "וּשְׁמַרְתֶּ֛ם", "transliteral": "ū-šə-mar-tem", "traducao_palavra": "e guardareis" },
