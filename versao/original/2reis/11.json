        { "hebraico": "הַמּוּמָתִ֔ים", "transliteral": "ham-mû-mā-ṯîm", "traducao_palavra": "que eram mortos" },
        { "hebraico": "אֹתֹ֥ו", "transliteral": "ʾō-ṯô", "traducao_palavra": "ele" },
