        { "hebraico": "מֶ֣לֶךְ", "transliteral": "me-leḵ", "traducao_palavra": "[o] rei de" },
        { "hebraico": "יִשְׂרָאֵ֔ל", "transliteral": "yiś-rā-ʾēl", "traducao_palavra": "Israel" },
        { "hebraico": "אֲהָ֕הּ", "transliteral": "ʾă-hāh", "traducao_palavra": "Ah!/Ai!" },
