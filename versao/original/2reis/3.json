        { "hebraico": "תִּסְתֹּ֔מוּ", "transliteral": "tis-tō-mû", "traducao_palavra": "tapareis/entupireis" },
        { "hebraico": "וְכֹל֙", "transliteral": "wə-ḵōl", "traducao_palavra": "e toda" },
