        { "hebraico": "אִתִּ֛י", "transliteral": "ʾit-tî", "traducao_palavra": "comigo" },
        { "hebraico": "אֶל־מֹואָ֖ב", "transliteral": "ʾel-mô-ʾāḇ", "traducao_palavra": "a Moabe" },
        { "hebraico": "לַמִּלְחָמָ֑ה", "transliteral": "lam-mil-ḥā-mā", "traducao_palavra": "para a guerra?" },
