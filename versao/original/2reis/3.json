        { "hebraico": "וַיֵּלֶךְ֩", "transliteral": "way-yê-leḵ", "traducao_palavra": "e foi" },
        { "hebraico": "מֶֽלֶךְ־יִשְׂרָאֵ֨ל", "transliteral": "me-leḵ-yiś-rā-ʾēl", "traducao_palavra": "o rei de Israel" },
        { "hebraico": "וּמֶֽלֶךְ־יְהוּדָ֜ה", "transliteral": "ū-me-leḵ-yə-hû-ḏā", "traducao_palavra": "e o rei de Judá" },
