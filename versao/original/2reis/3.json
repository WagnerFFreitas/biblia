        { "hebraico": "יִסְתֹּ֔מוּ", "transliteral": "yis-tō-mû", "traducao_palavra": "entupiram" },
        { "hebraico": "וְכָל־עֵֽץ־טֹ֖וב", "transliteral": "wə-ḵāl-ʿêṣ-ṭôḇ", "traducao_palavra": "e toda árvore boa" },
