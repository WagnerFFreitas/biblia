    "11": {
      "traducao_completa": "Então Davi madrugou, ele e os seus homens, para se irem pela manhã, e voltarem para a terra dos filisteus; e os filisteus subiram a Jezreel.",
      "palavras": [
        { "hebraico": "וַיַּשְׁכֵּ֨ם", "transliteral": "way-yaš-kêm", "traducao_palavra": "e madrugou" },
