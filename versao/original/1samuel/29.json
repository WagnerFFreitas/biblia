        { "hebraico": "וְנִלְחַמְתִּ֔י", "transliteral": "wə-nil-ḥam-tî", "traducao_palavra": "e lute" },
        { "hebraico": "בְּאֹיְבֵ֖י", "transliteral": "bə-ʾō-yə-ḇê", "traducao_palavra": "contra inimigos de" },
        { "hebraico": "אֲדֹנִ֥י", "transliteral": "ʾă-ḏō-nî", "traducao_palavra": "meu senhor" },
        { "hebraico": "הַמֶּֽלֶךְ׃", "transliteral": "ham-me-leḵ", "traducao_palavra": "o rei" }
      ]
