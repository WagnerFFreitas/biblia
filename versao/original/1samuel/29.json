    "9": {
      "traducao_completa": "E respondeu Áquis, e disse a Davi: Bem o sei; e que, na verdade, és bom aos meus olhos como um anjo de Deus; porém os príncipes dos filisteus disseram: Não suba este conosco à peleja.",
      "palavras": [
        { "hebraico": "וַיַּ֨עַן", "transliteral": "way-ya-ʿan", "traducao_palavra": "e respondeu" },
        { "hebraico": "אָכִ֜ישׁ", "transliteral": "ʾā-ḵîš", "traducao_palavra": "Áquis" },
        { "hebraico": "וַיֹּ֣אמער", "transliteral": "way-yō-mer", "traducao_palavra": "e disse" },
        { "hebraico": "אֶל־דָּוִ֗ד", "transliteral": "ʾel-dā-wiḏ", "traducao_palavra": "a Davi" },
        { "hebraico": "יָדַ֙עְתִּי֙", "transliteral": "yā-ḏa-ʿtî", "traducao_palavra": "sei eu" },
        { "hebraico": "כִּ֣י", "transliteral": "kî", "traducao_palavra": "que" },
        { "hebraico": "טֹ֥וב", "transliteral": "ṭôḇ", "traducao_palavra": "bom [és]" },
        { "hebraico": "אַתָּה֙", "transliteral": "ʾat-tā", "traducao_palavra": "tu" },
        { "hebraico": "בְּעֵינַ֔י", "transliteral": "bə-ʿê-nay", "traducao_palavra": "em meus olhos" },
        { "hebraico": "כְּמַלְאַ֖ךְ", "transliteral": "kə-mal-ʾaḵ", "traducao_palavra": "como anjo de" },
        { "hebraico": "אֱלֹהִ֑ים", "transliteral": "ʾĕ-lō-hîm", "traducao_palavra": "Deus" },
        { "hebraico": "אַ֣ךְ", "transliteral": "ʾaḵ", "traducao_palavra": "mas" },
        { "hebraico": "שָׂרֵ֤י", "transliteral": "śā-rê", "traducao_palavra": "os príncipes de" },
        { "hebraico": "פְלִשְׁתִּים֙", "transliteral": "p̄ə-liš-tîm", "traducao_palavra": "filisteus" },
        { "hebraico": "אָמְר֔וּ", "transliteral": "ʾā-mə-rû", "traducao_palavra": "disseram" },
        { "hebraico": "לֹֽא־יַעֲלֶ֥ה", "transliteral": "lō-ya-ʿă-leh", "traducao_palavra": "não suba" },
        { "hebraico": "עִמָּ֖נוּ", "transliteral": "ʿim-mā-nû", "traducao_palavra": "com nós" },
        { "hebraico": "בַּמִּלְחָמָֽה׃", "transliteral": "bam-mil-ḥā-mā", "traducao_palavra": "na batalha" }
      ]
    },
    "10": {
      "traducao_completa": "Levanta-te, pois, amanhã de madrugada com os servos de teu senhor, que vieram contigo; e levantando-vos de madrugada, e havendo luz, ide-vos.",
      "palavras": [
        { "hebraico": "וְעַתָּה֙", "transliteral": "wə-ʿat-tā", "traducao_palavra": "e agora" },
        { "hebraico": "הַשְׁכֵּ֣ם", "transliteral": "haš-kêm", "traducao_palavra": "madruga" },
        { "hebraico": "בַבֹּ֔קֶר", "transliteral": "ḇab-bō-qer", "traducao_palavra": "pela manhã" },
        { "hebraico": "וְעַבְדֵ֥י", "transliteral": "wə-ʿaḇ-ḏê", "traducao_palavra": "e os servos de" },
        { "hebraico": "אֲדֹנֶ֖יךָ", "transliteral": "ʾă-ḏō-ne-ḵā", "traducao_palavra": "teu senhor" },
        { "hebraico": "אֲשֶׁר־בָּ֣אוּ", "transliteral": "ʾă-šer-bā-ʾû", "traducao_palavra": "que vieram" },
        { "hebraico": "אִתָּ֑ךְ", "transliteral": "ʾit-tāḵ", "traducao_palavra": "contigo" },
        { "hebraico": "וְהִשְׁכַּמְתֶּ֣ם", "transliteral": "wə-hiš-kam-tem", "traducao_palavra": "e madrugando vós" },
        { "hebraico": "בַּבֹּ֔קֶר", "transliteral": "ḇab-bō-qer", "traducao_palavra": "pela manhã" },
        { "hebraico": "וְאֹ֥ור", "transliteral": "wə-ʾôr", "traducao_palavra": "e [houver] luz" },
        { "hebraico": "לָכֶ֖ם", "transliteral": "lā-ḵem", "traducao_palavra": "para vós" },
        { "hebraico": "וָלֵֽכוּ׃", "transliteral": "wā-lê-ḵû", "traducao_palavra": "então ide" }
