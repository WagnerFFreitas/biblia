        { "hebraico": "עָשִׂ֙יתִי֙", "transliteral": "ʿā-śî-ṯî", "traducao_palavra": "fiz eu" },
        { "hebraico": "וּמַה־מָּצָ֣אתָ", "transliteral": "ū-mah-mā-ṣā-ṯā", "traducao_palavra": "e que achaste" },
        { "hebraico": "בְעַבְדְּךָ֔", "transliteral": "ḇə-ʿaḇ-də-ḵā", "traducao_palavra": "no teu servo" },
        { "hebraico": "מִיֹּ֗ום", "transliteral": "miy-yôm", "traducao_palavra": "desde o dia" },
        { "hebraico": "אֲשֶׁ֤ר", "transliteral": "ʾă-šer", "traducao_palavra": "que" },
