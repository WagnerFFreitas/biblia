        { "hebraico": "לָשׁ֖וּב", "transliteral": "lā-šûḇ", "traducao_palavra": "para voltar" },
        { "hebraico": "אֶל־אֶ֣רֶץ", "transliteral": "ʾel-ʾe-reṣ", "traducao_palavra": "à terra de" },
