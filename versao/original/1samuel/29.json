        { "hebraico": "וַאֲנָשָׁ֗יו", "transliteral": "wa-ʾă-nā-šāyw", "traducao_palavra": "e os homens dele" },
        { "hebraico": "לָלֶ֛כֶת", "transliteral": "lā-le-ḵeṯ", "traducao_palavra": "para ir" },
