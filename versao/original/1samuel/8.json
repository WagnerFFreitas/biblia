    "12": {
      "traducao_completa": "E os porá por capitães de mil e capitães de cinquenta; e para que lavrem a sua lavoura, e façam a sua sega, e fabriquem as suas armas de guerra e os petrechos de seus carros.",
      "palavras": [
        { "hebraico": "וְלָשׂ֣וּם", "transliteral": "wə-lā-śûm", "traducao_palavra": "e para pôr" },
        { "hebraico": "לֹ֔ו", "transliteral": "lô", "traducao_palavra": "para si" },
        { "hebraico": "שָׂרֵ֥י", "transliteral": "śā-rê", "traducao_palavra": "capitães de" },
        { "hebraico": "אֲלָפִ֖ים", "transliteral": "ʾă-lā-p̄îm", "traducao_palavra": "milhares" },
        { "hebraico": "וְשָׂרֵ֥י", "transliteral": "wə-śā-rê", "traducao_palavra": "e capitães de" },
        { "hebraico": "חֲמִשִּׁ֑ים", "transliteral": "ḥă-miš-šîm", "traducao_palavra": "cinquentas" },
        { "hebraico": "וְלַחֲרֹ֤שׁ", "transliteral": "wə-la-ḥă-rōš", "traducao_palavra": "e para lavrar" },
        { "hebraico": "חֲרִישֹׁו֙", "transliteral": "ḥă-rî-šô", "traducao_palavra": "lavoura dele" },
        { "hebraico": "וְלִקְצֹ֣ר", "transliteral": "wə-liq-ṣōr", "traducao_palavra": "e para ceifar" },
        { "hebraico": "קְצִירֹ֔ו", "transliteral": "qə-ṣî-rô", "traducao_palavra": "sua sega" },
        { "hebraico": "וְלַעֲשֹׂ֥ות", "transliteral": "wə-la-ʿă-śôṯ", "traducao_palavra": "e para fazer" },
        { "hebraico": "כְּלֵֽי־מִלְחַמְתֹּ֖ו", "transliteral": "kə-lê-mil-ḥam-tô", "traducao_palavra": "instrumentos de sua guerra" },
        { "hebraico": "וּכְלֵ֥י", "transliteral": "ū-ḵə-lê", "traducao_palavra": "e instrumentos de" },
