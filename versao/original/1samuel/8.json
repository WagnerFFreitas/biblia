        { "hebraico": "לִשְׁמֹ֖עַ", "transliteral": "liš-mō-aḥ", "traducao_palavra": "ouvir" },
        { "hebraico": "בְּקֹ֣ול", "transliteral": "bə-qôl", "traducao_palavra": "a voz de" },
        { "hebraico": "שְׁמוּאֵ֑ל", "transliteral": "šə-mû-ʾēl", "traducao_palavra": "Samuel" },
