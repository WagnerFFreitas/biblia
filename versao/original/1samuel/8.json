        { "hebraico": "וְאֶת־חֲמֹורֵיכֶ֖ם", "transliteral": "wə-ʾeṯ-ḥă-mô-rê-ḵem", "traducao_palavra": "e vossos jumentos" },
        { "hebraico": "יִקָּ֑ח", "transliteral": "yiq-qāḥ", "traducao_palavra": "tomará" },
        { "hebraico": "וְעָשָׂ֖ה", "transliteral": "wə-ʿā-śā", "traducao_palavra": "e fará [usará]" },
        { "hebraico": "לִמְלַאכְתֹּֽו׃", "transliteral": "lim-laḵ-tô", "traducao_palavra": "em seu trabalho" }
