    },
    "17": {
      "traducao_completa": "Dizimará o vosso rebanho, e vós lhe sereis por servos.",
      "palavras": [
        { "hebraico": "צֹאנְכֶ֖ם", "transliteral": "ṣōn-ḵem", "traducao_palavra": "vosso rebanho" },
