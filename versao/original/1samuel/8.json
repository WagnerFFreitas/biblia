        { "hebraico": "וְהַמְלֵ֥ךְ", "transliteral": "wə-ham-lêḵ", "traducao_palavra": "e faz reinar" },
        { "hebraico": "לָהֶ֖ם", "transliteral": "lā-hem", "traducao_palavra": "para eles" },
        { "hebraico": "מֶ֑לֶךְ", "transliteral": "me-leḵ", "traducao_palavra": "um rei" },
