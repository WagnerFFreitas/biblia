        { "hebraico": "יְהוָ֤ה", "transliteral": "YHWH", "traducao_palavra": "YHWH" },
        { "hebraico": "אֶל־שְׁמוּאֵל֙", "transliteral": "ʾel-šə-mû-ʾēl", "traducao_palavra": "a Samuel" },
        { "hebraico": "שְׁמַ֣ע", "transliteral": "šə-maʿ", "traducao_palavra": "ouve" },
