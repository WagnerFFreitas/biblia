        { "hebraico": "אֶת־בְּנֵיכֶ֣ם", "transliteral": "ʾeṯ-bə-nê-ḵem", "traducao_palavra": "vossos filhos" },
        { "hebraico": "יִקָּ֗ח", "transliteral": "yiq-qāḥ", "traducao_palavra": "tomará" },
        { "hebraico": "וְשָׂ֥ם", "transliteral": "wə-śām", "traducao_palavra": "e porá" },
        { "hebraico": "לֹו֙", "transliteral": "lô", "traducao_palavra": "para ele" },
        { "hebraico": "בְּמֶרְכַּבְתֹּ֣ו", "transliteral": "bə-mer-kaḇ-tô", "traducao_palavra": "em seu carro" },
        { "hebraico": "וּבְפָרָשָׁ֔יו", "transliteral": "ū-ḇə-p̄ā-rā-šāw", "traducao_palavra": "e entre seus cavaleiros" },
        { "hebraico": "וְרָצ֖וּ", "transliteral": "wə-rā-ṣû", "traducao_palavra": "e correrão" },
        { "hebraico": "לִפְנֵ֥י", "transliteral": "lip̄-nê", "traducao_palavra": "diante de" },
        { "hebraico": "מֶרְכַּבְתֹּֽו׃", "transliteral": "mer-kaḇ-tô", "traducao_palavra": "seu carro" }
