        { "hebraico": "גַם־אֲנַ֖חְנוּ", "transliteral": "gam-ʾă-naḥ-nû", "traducao_palavra": "também nós" },
        { "hebraico": "כְּכָל־הַגֹּויִ֑ם", "transliteral": "kə-ḵāl-hag-gô-yim", "traducao_palavra": "como todas as nações" },
        { "hebraico": "וּשְׁפָטָ֤נוּ", "transliteral": "ū-šə-p̄ā-ṭā-nû", "traducao_palavra": "e julgará a nós" },
        { "hebraico": "מַלְכֵּ֙נוּ֙", "transliteral": "mal-kê-nû", "traducao_palavra": "nosso rei" },
        { "hebraico": "וְיָצָ֣א", "transliteral": "wə-yā-ṣā", "traducao_palavra": "e sairá" },
        { "hebraico": "לְפָנֵ֔ינוּ", "transliteral": "lə-p̄ā-nê-nû", "traducao_palavra": "diante de nós" },
        { "hebraico": "וְנִלְחַ֖ם", "transliteral": "wə-nil-ḥam", "traducao_palavra": "e lutará" },
        { "hebraico": "אֶת־מִלְחֲמֹתֵֽנוּ׃", "transliteral": "ʾeṯ-mil-ḥă-mō-ṯê-nû", "traducao_palavra": "nossas guerras" }
