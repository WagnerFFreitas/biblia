      ]
    },
    "13": {
      "traducao_completa": "E tomará as vossas filhas para perfumistas, cozinheiras e padeiras.",
      "palavras": [
        { "hebraico": "וְאֶת־בְּנֹותֵיכֶ֖ם", "transliteral": "wə-ʾeṯ-bə-nô-ṯê-ḵem", "traducao_palavra": "e vossas filhas" },
        { "hebraico": "יִקָּ֑ח", "transliteral": "yiq-qāḥ", "traducao_palavra": "tomará" },
        { "hebraico": "לְרַקָּחֹ֥ות", "transliteral": "lə-raq-qā-ḥôṯ", "traducao_palavra": "por perfumistas/unguentárias" },
        { "hebraico": "וּלְטַבָּחֹ֖ות", "transliteral": "ū-lə-ṭab-bā-ḥôṯ", "traducao_palavra": "e por cozinheiras" },
        { "hebraico": "וּלְאֹפֹֽות׃", "transliteral": "ū-lə-ʾō-p̄ôṯ", "traducao_palavra": "e por padeiras" }
      ]
    },
    "14": {
      "traducao_completa": "E tomará o melhor das vossas terras, e das vossas vinhas, e dos vossos olivais, e os dará aos seus servos.",
      "palavras": [
        { "hebraico": "וְאֶת־שְׂדֹותֵיכֶ֧ם", "transliteral": "wə-ʾeṯ-śə-ḏô-ṯê-ḵem", "traducao_palavra": "e vossos campos" },
        { "hebraico": "וְאֶת־כַּרְמֵיכֶ֛ם", "transliteral": "wə-ʾeṯ-kar-mê-ḵem", "traducao_palavra": "e vossas vinhas" },
        { "hebraico": "וְזֵיתֵיכֶ֥ם", "transliteral": "wə-zê-ṯê-ḵem", "traducao_palavra": "e vossos olivais" },
        { "hebraico": "הַטֹּובִ֖ים", "transliteral": "ha-ṭṭô-ḇîm", "traducao_palavra": "os melhores" },
        { "hebraico": "יִקָּ֑ח", "transliteral": "yiq-qāḥ", "traducao_palavra": "tomará" },
        { "hebraico": "וְנָתַ֖ן", "transliteral": "wə-nā-ṯan", "traducao_palavra": "e dará" },
        { "hebraico": "לַעֲבָדָֽיו׃", "transliteral": "la-ʿă-ḇā-ḏāw", "traducao_palavra": "aos servos dele" }
      ]
    },
    "15": {
      "traducao_completa": "E as vossas sementes e as vossas vinhas dizimará, para dar aos seus eunucos e aos seus servos.",
      "palavras": [
        { "hebraico": "וְזַרְעֵיכֶ֥ם", "transliteral": "wə-zar-ʿê-ḵem", "traducao_palavra": "e vossas sementes" },
        { "hebraico": "וְכַרְמֵיכֶ֖ם", "transliteral": "wə-kar-mê-ḵem", "traducao_palavra": "e vossas vinhas" },
        { "hebraico": "יַעְשֹׂ֑ר", "transliteral": "yaʿ-śōr", "traducao_palavra": "dizimará" },
        { "hebraico": "וְנָתַ֥ן", "transliteral": "wə-nā-ṯan", "traducao_palavra": "e dará" },
        { "hebraico": "לְסָרִיסָ֖יו", "transliteral": "lə-śā-rî-śāw", "traducao_palavra": "aos seus oficiais/eunucos" },
        { "hebraico": "וְלַעֲבָדָֽיו׃", "transliteral": "la-ʿă-ḇā-ḏāw", "traducao_palavra": "e aos seus servos" }
      ]
    },
    "16": {
      "traducao_completa": "E também tomará os vossos servos, e as vossas servas, e os vossos melhores jovens, e os vossos jumentos, e os empregará no seu trabalho.",
      "palavras": [
        { "hebraico": "וְאֶת־עַבְדֵיכֶם֩", "transliteral": "wə-ʾeṯ-ʿaḇ-dê-ḵem", "traducao_palavra": "e vossos servos" },
        { "hebraico": "וְאֶת־שִׁפְחֹותֵיכֶ֜ם", "transliteral": "wə-ʾeṯ-šip̄-ḥô-ṯê-ḵem", "traducao_palavra": "e vossas servas" },
        { "hebraico": "וְאֶת־בַּחוּרֵיכֶ֧ם", "transliteral": "wə-ʾeṯ-ba-ḥû-rê-ḵem", "traducao_palavra": "e vossos jovens" },
