        { "hebraico": "בָּנָ֔יו", "transliteral": "bā-nāyw", "traducao_palavra": "filhos dele" },
        { "hebraico": "מֵחֹומַ֖ת", "transliteral": "mê-ḥô-maṯ", "traducao_palavra": "do muro de" },
