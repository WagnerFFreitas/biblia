        { "hebraico": "וַיִּשְׁמְע֣וּ", "transliteral": "way-yiš-mə-ʿû", "traducao_palavra": "e ouviram" },
        { "hebraico": "אֵלָ֔יו", "transliteral": "ʾē-lāyw", "traducao_palavra": "sobre ele [Saul]" },
        { "hebraico": "יֹשְׁבֵ֖י", "transliteral": "yō-šə-ḇê", "traducao_palavra": "os habitantes de" },
