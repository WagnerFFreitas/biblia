    "11": {
      "traducao_completa": "E acharam no campo um homem egípcio, e o trouxeram a Davi; e deram-lhe pão, e ele comeu, e deram-lhe a beber água.",
      "palavras": [
        { "hebraico": "וַֽיִּמְצְא֤וּ", "transliteral": "way-yim-ṣə-ʾû", "traducao_palavra": "e acharam" },
        { "hebraico": "אִישׁ־מִצְרִי֙", "transliteral": "ʾîš-miṣ-rî", "traducao_palavra": "um homem egípcio" },
        { "hebraico": "בַּשָּׂדֶ֔ה", "transliteral": "baś-śā-ḏeh", "traducao_palavra": "no campo" },
        { "hebraico": "וַיִּקְח֥וּ", "transliteral": "way-yiq-ḥû", "traducao_palavra": "e tomaram" },
        { "hebraico": "אֹתֹ֖ו", "transliteral": "ʾō-ṯô", "traducao_palavra": "ele" },
        { "hebraico": "אֶל־דָּוִ֑ד", "transliteral": "ʾel-dā-wiḏ", "traducao_palavra": "para Davi" },
        { "hebraico": "וַיִּתְּנוּ־לֹ֥ו", "transliteral": "way-yit-nû-lô", "traducao_palavra": "e deram a ele" },
        { "hebraico": "לֶ֙חֶם֙", "transliteral": "le-ḥem", "traducao_palavra": "pão" },
        { "hebraico": "וַיֹּ֔אכַל", "transliteral": "way-yō-ḵal", "traducao_palavra": "e ele comeu" },
        { "hebraico": "וַיַּשְׁקֻ֖הוּ", "transliteral": "way-yaš-qu-hû", "traducao_palavra": "e fizeram-no beber" },
        { "hebraico": "מָֽיִם׃", "transliteral": "mā-yim", "traducao_palavra": "água" }
      ]
    },
    "12": {
      "traducao_completa": "Deram-lhe também um pedaço de pasta de figos secos e dois cachos de passas; e comeu, e voltou-lhe o seu espírito; porque havia três dias e três noites que não tinha comido pão nem bebido água.",
      "palavras": [
        { "hebraico": "וַיִּתְּנוּ־לֹו֩", "transliteral": "way-yit-nû-lô", "traducao_palavra": "e deram a ele" },
        { "hebraico": "פֶ֨לַח", "transliteral": "p̄e-laḥ", "traducao_palavra": "um pedaço de" },
        { "hebraico": "דְּבֵלָ֜ה", "transliteral": "də-ḇê-lā", "traducao_palavra": "pasta de figos" },
        { "hebraico": "וּשְׁנֵ֧י", "transliteral": "ū-šə-nê", "traducao_palavra": "e dois" },
        { "hebraico": "צִמּוּקִ֛ים", "transliteral": "ṣim-mû-qîm", "traducao_palavra": "cachos de passas" },
        { "hebraico": "וַיֹּ֕אכַל", "transliteral": "way-yō-ḵal", "traducao_palavra": "e comeu" },
        { "hebraico": "וַתָּ֥שָׁב", "transliteral": "wat-tā-šāḇ", "traducao_palavra": "e voltou" },
        { "hebraico": "רוּחֹ֖ו", "transliteral": "rû-ḥô", "traducao_palavra": "o espírito dele" },
        { "hebraico": "אֵלָ֑יו", "transliteral": "ʾē-lāyw", "traducao_palavra": "a ele" },
        { "hebraico": "כִּ֣י", "transliteral": "kî", "traducao_palavra": "porque" },
        { "hebraico": "לֹא־אָ֣כַל", "transliteral": "lō-ʾā-ḵal", "traducao_palavra": "não comera" },
        { "hebraico": "לֶ֗חֶם", "transliteral": "le-ḥem", "traducao_palavra": "pão" },
        { "hebraico": "וְלֹא־שָׁתָ֣ה", "transliteral": "wə-lō-šā-ṯā", "traducao_palavra": "e não bebera" },
        { "hebraico": "מַ֔יִם", "transliteral": "ma-yim", "traducao_palavra": "água" },
        { "hebraico": "שְׁלֹשָׁ֥ה", "transliteral": "šə-lō-šā", "traducao_palavra": "[por] três" },
        { "hebraico": "יָמִ֖ים", "transliteral": "yā-mîm", "traducao_palavra": "dias" },
        { "hebraico": "וּשְׁלֹשָׁ֥ה", "transliteral": "ū-šə-lō-šā", "traducao_palavra": "e três" },
        { "hebraico": "לֵילֹֽות׃", "transliteral": "lê-lôṯ", "traducao_palavra": "noites" }
      ]
    },
    "13": {
      "traducao_completa": "Então lhe disse Davi: De quem és tu? E donde és? E disse o moço egípcio: Sou servo de um homem amalequita, e meu senhor me deixou, porque adoeci há três dias.",
      "palavras": [
        { "hebraico": "וַיֹּ֨אמער", "transliteral": "way-yō-mer", "traducao_palavra": "e disse" },
        { "hebraico": "לֹ֤ו", "transliteral": "lô", "traducao_palavra": "a ele" },
        { "hebraico": "דָּוִד֙", "transliteral": "dā-wiḏ", "traducao_palavra": "Davi" },
        { "hebraico": "לְמִי־אַ֔תָּה", "transliteral": "lə-mî-ʾat-tā", "traducao_palavra": "de quem [és] tu" },
        { "hebraico": "וְאֵ֥י", "transliteral": "wə-ʾê", "traducao_palavra": "e onde" },
        { "hebraico": "מִזֶּ֖ה", "transliteral": "mi-zeh", "traducao_palavra": "[vês] deste [lugar]" },
        { "hebraico": "אָ֑תָּה", "transliteral": "ʾā-tā", "traducao_palavra": "tu" },
        { "hebraico": "וַיֹּ֜אמֶר", "transliteral": "way-yō-mer", "traducao_palavra": "e disse ele" },
        { "hebraico": "נַ֣עַר", "transliteral": "na-ʿar", "traducao_palavra": "moço" },
        { "hebraico": "מִצְרִ֣י", "transliteral": "miṣ-rî", "traducao_palavra": "egípcio" },
        { "hebraico": "אָנֹ֔כִי", "transliteral": "ʾā-nō-ḵî", "traducao_palavra": "eu [sou]" },
        { "hebraico": "עֶ֖בֶד", "transliteral": "ʿe-ḇeḏ", "traducao_palavra": "servo" },
        { "hebraico": "לְאִ֣ישׁ", "transliteral": "lə-ʾîš", "traducao_palavra": "de um homem" },
        { "hebraico": "עֲמָלֵקִ֑י", "transliteral": "ʿă-mā-lê-qî", "traducao_palavra": "amalequita" },
        { "hebraico": "וַיַּעַזְבֵ֧נִי", "transliteral": "way-ya-ʿaz-ḇê-nî", "traducao_palavra": "e deixou-me" },
        { "hebraico": "אֲדֹנִ֛י", "transliteral": "ʾă-ḏō-nî", "traducao_palavra": "meu senhor" },
