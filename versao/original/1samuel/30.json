{
  "livro": "1 Samuel - שְׁמוּאֵל א - Shemu'el Alef",
  "capítulo": 30,
  "titulos": { },
  "versiculos": {
    "1": {
      "traducao_completa": "E sucedeu que, chegando Davi e os seus homens a Ziclague ao terceiro dia, os amalequitas tinham invadido o sul e a Ziclague, e tinham ferido a Ziclague e a queimado pelo fogo.",
      "palavras": [
        { "hebraico": "וַיְהִ֨י", "transliteral": "way-hî", "traducao_palavra": "e sucedeu" },
        { "hebraico": "בְּבֹ֨א", "transliteral": "bə-ḇō", "traducao_palavra": "no vir/chegar" },
        { "hebraico": "דָוִ֧ד", "transliteral": "dā-wiḏ", "traducao_palavra": "Davi" },
        { "hebraico": "וַאֲנָשָׁ֛יו", "transliteral": "wa-ʾă-nā-šāyw", "traducao_palavra": "e os homens dele" },
        { "hebraico": "צִקְלַ֖ג", "transliteral": "ṣiq-laḡ", "traducao_palavra": "[a] Ziclague" },
        { "hebraico": "בַּיֹּ֣ום", "transliteral": "bay-yôm", "traducao_palavra": "no dia" },
        { "hebraico": "הַשְּׁלִישִׁ֑י", "transliteral": "haš-šə-lî-šî", "traducao_palavra": "terceiro" },
        { "hebraico": "וַעֲמָלֵקִ֣י", "transliteral": "wa-ʿă-mā-lê-qî", "traducao_palavra": "e os amalequitas" },
        { "hebraico": "פָשְׁט֗וּ", "transliteral": "p̄ā-šə-ṭû", "traducao_palavra": "tinham invadido" },
        { "hebraico": "אֶל־נֶ֙גֶב֙", "transliteral": "ʾel-ne-ḡeḇ", "traducao_palavra": "ao sul/Neguebe" },
        { "hebraico": "וְאֶל־צִקְלַ֔ג", "transliteral": "wə-ʾel-ṣiq-laḡ", "traducao_palavra": "e a Ziclague" },
        { "hebraico": "וַיַּכּוּ֙", "transliteral": "way-yak-kû", "traducao_palavra": "e feriram" },
        { "hebraico": "אֶת־צִקְלַ֔ג", "transliteral": "ʾeṯ-ṣiq-laḡ", "traducao_palavra": "a Ziclague" },
        { "hebraico": "וַיִּשְׂרְפ֥וּ", "transliteral": "way-yiś-rə-p̄û", "traducao_palavra": "e queimaram" },
        { "hebraico": "אֹתָ֖הּ", "transliteral": "ʾō-ṯāh", "traducao_palavra": "ela" },
        { "hebraico": "בָּאֵֽשׁ׃", "transliteral": "bā-ʾēš", "traducao_palavra": "no fogo" }
      ]
    },
    "2": {
      "traducao_completa": "E levaram cativas as mulheres que nela estavam, desde a menor até à maior; a ninguém mataram, porém os levaram e se foram pelo seu caminho.",
      "palavras": [
        { "hebraico": "וַיִּשְׁבּ֨וּ", "transliteral": "way-yiš-bû", "traducao_palavra": "e levaram cativas" },
        { "hebraico": "אֶת־הַנָּשִׁ֤ים", "transliteral": "ʾeṯ-han-nā-šîm", "traducao_palavra": "as mulheres" },
        { "hebraico": "אֲשֶׁר־בָּהּ֙", "transliteral": "ʾă-šer-bāh", "traducao_palavra": "que [estavam] nela" },
        { "hebraico": "מִקָּטֹ֣ן", "transliteral": "miq-qā-ṭōn", "traducao_palavra": "desde o pequeno" },
        { "hebraico": "וְעַד־גָּדֹ֔ול", "transliteral": "wə-ʿaḏ-gā-ḏôl", "traducao_palavra": "até o grande" },
        { "hebraico": "לֹא־הֵמִ֖יתוּ", "transliteral": "lō-hê-mî-ṯû", "traducao_palavra": "não mataram" },
        { "hebraico": "אִ֑ישׁ", "transliteral": "ʾîš", "traducao_palavra": "ninguém/homem" },
        { "hebraico": "וַיִּנְהֲג֔וּ", "transliteral": "way-yin-hă-ḡû", "traducao_palavra": "e conduziram/levaram" },
        { "hebraico": "וַיֵּלְכ֖וּ", "transliteral": "way-yê-lə-ḵû", "traducao_palavra": "e foram" },
        { "hebraico": "לְדַרְכָּֽם׃", "transliteral": "lə-ḏar-kām", "traducao_palavra": "pelo caminho deles" }
      ]
    },
    "3": {
      "traducao_completa": "Vindo, pois, Davi e os seus homens à cidade, eis que estava queimada pelo fogo, e suas mulheres, seus filhos e suas filhas tinham sido levados cativos.",
      "palavras": [
        { "hebraico": "וַיָּבֹ֨א", "transliteral": "way-yā-ḇō", "traducao_palavra": "e veio" },
        { "hebraico": "דָוִ֤ד", "transliteral": "dā-wiḏ", "traducao_palavra": "Davi" },
        { "hebraico": "וַאֲנָשָׁיו֙", "transliteral": "wa-ʾă-nā-šāyw", "traducao_palavra": "e os homens dele" },
        { "hebraico": "אֶל־הָעִ֔יר", "transliteral": "ʾel-hā-ʿîr", "traducao_palavra": "à cidade" },
        { "hebraico": "וְהִנֵּ֥ה", "transliteral": "wə-hin-nēh", "traducao_palavra": "e eis que" },
        { "hebraico": "שְׂרוּפָ֖ה", "transliteral": "śə-rû-p̄ā", "traducao_palavra": "queimada" },
        { "hebraico": "בָּאֵ֑שׁ", "transliteral": "bā-ʾēš", "traducao_palavra": "no fogo" },
        { "hebraico": "וּנְשֵׁיהֶם֙", "transliteral": "ū-nə-šê-hem", "traducao_palavra": "e as mulheres deles" },
        { "hebraico": "וּבְנֵיהֶ֣ם", "transliteral": "ū-ḇə-nê-hem", "traducao_palavra": "e os filhos deles" },
        { "hebraico": "וּבְנֹתֵיהֶ֔ם", "transliteral": "ū-ḇə-nō-ṯê-hem", "traducao_palavra": "e as filhas deles" },
        { "hebraico": "נִשְׁבּֽוּ׃", "transliteral": "niš-bû", "traducao_palavra": "foram levadas cativas" }
      ]
    },
    "4": {
      "traducao_completa": "Então Davi e o povo que estava com ele levantaram a sua voz, e choraram, até que neles não houve mais força para chorar.",
      "palavras": [
        { "hebraico": "וַיִּשָּׂ֨א", "transliteral": "way-yiś-śā", "traducao_palavra": "e levantou" },
        { "hebraico": "דָוִ֜ד", "transliteral": "dā-wiḏ", "traducao_palavra": "Davi" },
        { "hebraico": "וְהָעָ֧ם", "transliteral": "wə-hā-ʿām", "traducao_palavra": "e o povo" },
        { "hebraico": "אֲשֶׁר־אִתֹּ֛ו", "transliteral": "ʾă-šer-ʾit-tô", "traducao_palavra": "que [estava] com ele" },
        { "hebraico": "אֶת־קֹולָ֖ם", "transliteral": "ʾeṯ-qô-lām", "traducao_palavra": "a voz deles" },
        { "hebraico": "וַיִּבְכּ֑וּ", "transliteral": "way-yiḇ-kû", "traducao_palavra": "e choraram" },
        { "hebraico": "עַ֣ד", "transliteral": "ʿaḏ", "traducao_palavra": "até" },
        { "hebraico": "אֲשֶׁ֧ר", "transliteral": "ʾă-šer", "traducao_palavra": "que" },
        { "hebraico": "אֵין־בָּהֶ֥ם", "transliteral": "ʾên-bā-hem", "traducao_palavra": "não havia neles" },
        { "hebraico": "כֹּ֖חַ", "transliteral": "kō-aḥ", "traducao_palavra": "força" },
        { "hebraico": "לִבְכֹּֽות׃", "transliteral": "liḇ-kôṯ", "traducao_palavra": "para chorar" }
      ]
    },
    "5": {
      "traducao_completa": "Também as duas mulheres de Davi foram levadas cativas: Ainoã, a jezreelita, e Abigail, a que fora mulher de Nabal, o carmelita.",
      "palavras": [
        { "hebraico": "וּשְׁתֵּ֥י", "transliteral": "ū-šət-tê", "traducao_palavra": "e as duas" },
        { "hebraico": "נְשֵֽׁי־דָוִ֖ד", "transliteral": "nə-šê-ḏā-wiḏ", "traducao_palavra": "mulheres de Davi" },
        { "hebraico": "נִשְׁבּ֑וּ", "transliteral": "niš-bû", "traducao_palavra": "foram cativas" },
        { "hebraico": "אֲחִינֹ֙עַם֙", "transliteral": "ʾă-ḥî-nō-ʿam", "traducao_palavra": "Ainoã" },
        { "hebraico": "הַיִּזְרְעֵלִ֔ית", "transliteral": "hay-yiz-rə-ʿê-lîṯ", "traducao_palavra": "a jezreelita" },
        { "hebraico": "וַאֲבִיגַ֕יִל", "transliteral": "wa-ʾă-ḇî-ḡa-yil", "traducao_palavra": "e Abigail" },
        { "hebraico": "אֵ֖שֶׁת", "transliteral": "ʾē-šeṯ", "traducao_palavra": "[ex-]mulher de" },
        { "hebraico": "נָבָ֥ל", "transliteral": "nā-ḇāl", "traducao_palavra": "Nabal" },
        { "hebraico": "הַכַּרְמֶלִֽי׃", "transliteral": "hak-kar-mə-lî", "traducao_palavra": "o carmelita" }
      ]
    },
    "6": {
      "traducao_completa": "E Davi mui se angustiou, porque o povo falava de apedrejá-lo, porquanto a alma de todo o povo estava em amargura, cada um por causa de seus filhos e de suas filhas; todavia Davi se fortaleceu em YHWH seu Deus.",
      "palavras": [
        { "hebraico": "וַתֵּ֨צֶר", "transliteral": "wat-tê-ṣer", "traducao_palavra": "e angustiou-se" },
        { "hebraico": "לְדָוִ֜ד", "transliteral": "lə-ḏā-wiḏ", "traducao_palavra": "Davi" },
        { "hebraico": "מְאֹ֗ד", "transliteral": "mə-ʾōḏ", "traducao_palavra": "muito" },
        { "hebraico": "כִּֽי־אָמַ֤ר", "transliteral": "kî-ʾā-mar", "traducao_palavra": "porque dizia" },
        { "hebraico": "הָעָם֙", "transliteral": "hā-ʿām", "traducao_palavra": "o povo" },
        { "hebraico": "לְסָקְלֹו", "transliteral": "lə-śā-qə-lô", "traducao_palavra": "em apedrejar ele" },
        { "hebraico": "כִּֽי־מָ֙רָה֙", "transliteral": "kî-mā-rā", "traducao_palavra": "porque amargurada [estava]" },
        { "hebraico": "נֶ֣פֶשׁ", "transliteral": "ne-p̄eš", "traducao_palavra": "[a] alma de" },
        { "hebraico": "כָּל־הָעָ֔ם", "transliteral": "kāl-hā-ʿām", "traducao_palavra": "todo o povo" },
        { "hebraico": "אִ֖ישׁ", "transliteral": "ʾîš", "traducao_palavra": "cada homem" },
        { "hebraico": "עַל־בָּנָ֣ו", "transliteral": "ʿal-bā-nāw", "traducao_palavra": "por seus filhos" },
        { "hebraico": "וְעַל־בְּנֹתָ֑יו", "transliteral": "wə-ʿal-bə-nō-ṯāyw", "traducao_palavra": "e por suas filhas" },
        { "hebraico": "וַיִּתְחַזֵּ֣ק", "transliteral": "way-yiṯ-ḥaz-zêq", "traducao_palavra": "mas fortaleceu-se" },
        { "hebraico": "דָּוִ֔ד", "transliteral": "dā-wiḏ", "traducao_palavra": "Davi" },
        { "hebraico": "בַּיהוָ֖ה", "transliteral": "bay-hwāh", "traducao_palavra": "em YHWH" },
        { "hebraico": "אֱלֹהָֽיו׃", "transliteral": "ʾĕ-lō-hāyw", "traducao_palavra": "Deus dele" }
      ]
    },
    "7": {
      "traducao_completa": "E disse Davi a Abiatar, o sacerdote, filho de Ahimeleque: Traze-me, peço-te, aqui o éfode. E Abiatar trouxe o éfode a Davi.",
      "palavras": [
        { "hebraico": "וַיֹּ֣אמֶר", "transliteral": "way-yō-mer", "traducao_palavra": "e disse" },
        { "hebraico": "דָּוִ֜ד", "transliteral": "dā-wiḏ", "traducao_palavra": "Davi" },
        { "hebraico": "אֶל־אֶבְיָתָ֥ר", "transliteral": "ʾel-ʾeḇ-yā-ṯār", "traducao_palavra": "a Abiatar" },
        { "hebraico": "הַכֹּהֵ֛ן", "transliteral": "hak-kō-hên", "traducao_palavra": "o sacerdote" },
        { "hebraico": "בֶּן־אֲחִימֶ֖לֶךְ", "transliteral": "ben-ʾă-ḥî-me-leḵ", "traducao_palavra": "filho de Ahimeleque" },
        { "hebraico": "הַגִּֽישָׁה־נָּ֥א", "transliteral": "hag-gî-šā-nā", "traducao_palavra": "faz chegar agora" },
        { "hebraico": "לִ֖י", "transliteral": "lî", "traducao_palavra": "para mim" },
        { "hebraico": "הָאֵפֹ֑ד", "transliteral": "hā-ʾê-p̄ōḏ", "traducao_palavra": "o éfode" },
        { "hebraico": "וַיַּגֵּ֧שׁ", "transliteral": "way-yag-gêš", "traducao_palavra": "e fez chegar" },
        { "hebraico": "אֶבְיָתָ֛ר", "transliteral": "ʾeḇ-yā-ṯār", "traducao_palavra": "Abiatar" },
        { "hebraico": "אֶת־הָאֵפֹ֖ד", "transliteral": "ʾeṯ-hā-ʾê-p̄ōḏ", "traducao_palavra": "o éfode" },
        { "hebraico": "אֶל־דָּוִֽד׃", "transliteral": "ʾel-dā-wiḏ", "traducao_palavra": "a Davi" }
      ]
    },
    "8": {
      "traducao_completa": "Então consultou Davi a YHWH, dizendo: Perseguirei eu a esta tropa? Alcançá-la-ei? E disse-lhe: Persegue-a, porque decerto a alcançarás e tudo libertarás.",
      "palavras": [
        { "hebraico": "וַיִּשְׁאַ֨ל", "transliteral": "way-yiš-ʾal", "traducao_palavra": "e consultou/perguntou" },
        { "hebraico": "דָּוִ֤ד", "transliteral": "dā-wiḏ", "traducao_palavra": "Davi" },
        { "hebraico": "בַּֽיהוָה֙", "transliteral": "bay-hwāh", "traducao_palavra": "a YHWH" },
        { "hebraico": "לֵאמֹ֔ר", "transliteral": "lê-mōr", "traducao_palavra": "dizendo" },
        { "hebraico": "אֶרְדֹּ֛ף", "transliteral": "ʾer-dōp̄", "traducao_palavra": "perseguirei eu" },
        { "hebraico": "אַחֲרֵ֥י", "transliteral": "ʾa-ḥă-rê", "traducao_palavra": "após" },
        { "hebraico": "הַגְּדוּד־הַזֶּ֖ה", "transliteral": "hag-gə-ḏûḏ-haz-zeh", "traducao_palavra": "esta tropa/bando" },
        { "hebraico": "הַאַשִּׂיגֶ֑נּוּ", "transliteral": "ha-ʾaś-śî-ḡen-nû", "traducao_palavra": "alcançarei eu ele" },
        { "hebraico": "וַיֹּ֤אמֶר", "transliteral": "way-yō-mer", "traducao_palavra": "e disse" },
        { "hebraico": "לֹו֙", "transliteral": "lô", "traducao_palavra": "a ele" },
        { "hebraico": "רְדֹ֔ף", "transliteral": "rə-ḏōp̄", "traducao_palavra": "persegue" },
        { "hebraico": "כִּֽי־הַשֵּׂ֥ג", "transliteral": "kî-haś-śēḡ", "traducao_palavra": "porque certamente" },
        { "hebraico": "תַּשִּׂ֖יג", "transliteral": "taś-śîḡ", "traducao_palavra": "alcançarás" },
        { "hebraico": "וְהַצֵּ֥ל", "transliteral": "wə-haṣ-ṣēl", "traducao_palavra": "e libertarás/recuperarás" },
        { "hebraico": "תַּצִּֽיל׃", "transliteral": "taṣ-ṣîl", "traducao_palavra": "certamente libertarás" }
      ]
    },
    "9": {
      "traducao_completa": "E foi Davi, ele e os seiscentos homens que com ele estavam, e chegaram ao ribeiro de Besor, onde os que ficaram atrás pararam.",
      "palavras": [
        { "hebraico": "וַיֵּ֣לֶךְ", "transliteral": "way-yê-leḵ", "traducao_palavra": "e foi" },
        { "hebraico": "דָּוִ֗ד", "transliteral": "dā-wiḏ", "traducao_palavra": "Davi" },
        { "hebraico": "ה֚וּא", "transliteral": "hû", "traducao_palavra": "ele" },
        { "hebraico": "וְשֵׁשׁ־מֵאֹ֥ות", "transliteral": "wə-šēš-mê-ʾôṯ", "traducao_palavra": "e seiscentas" },
        { "hebraico": "אִ֖ישׁ", "transliteral": "ʾîš", "traducao_palavra": "pessoas/homens" },
        { "hebraico": "אֲשֶׁ֣ר", "transliteral": "ʾă-šer", "traducao_palavra": "que" },
        { "hebraico": "אִתֹּ֑ו", "transliteral": "ʾit-tô", "traducao_palavra": "com ele" },
        { "hebraico": "וַיָּבֹ֙אוּ֙", "transliteral": "way-yā-ḇō-ʾû", "traducao_palavra": "e vieram" },
        { "hebraico": "עַד־נַ֣חַל", "transliteral": "ʿaḏ-na-ḥal", "traducao_palavra": "até o ribeiro de" },
        { "hebraico": "הַבְּשֹׂ֔ור", "transliteral": "hab-bə-śôr", "traducao_palavra": "Besor" },
        { "hebraico": "וְהַנֹּותָרִ֖ים", "transliteral": "wə-han-nô-ṯā-rîm", "traducao_palavra": "e os deixados/restantes" },
        { "hebraico": "עָמָֽדוּ׃", "transliteral": "ʿā-mā-ḏû", "traducao_palavra": "pararam" }
      ]
    },
    "10": {
      "traducao_completa": "E perseguiu-os Davi, ele e quatrocentos homens; pois que duzentos homens pararam, por ficarem tão cansados que não puderam passar o ribeiro de Besor.",
      "palavras": [
        { "hebraico": "וַיִּרְדֹּ֣ף", "transliteral": "way-yir-dōp̄", "traducao_palavra": "e perseguiu" },
        { "hebraico": "דָּוִ֔ד", "transliteral": "dā-wiḏ", "traducao_palavra": "Davi" },
        { "hebraico": "ה֖וּא", "transliteral": "hû", "traducao_palavra": "ele" },
        { "hebraico": "וְאַרְבַּע־מֵאֹ֣ות", "transliteral": "wə-ʾar-baʿ-mê-ʾôṯ", "traducao_palavra": "e quatrocentas" },
        { "hebraico": "אִ֑ישׁ", "transliteral": "ʾîš", "traducao_palavra": "pessoas" },
        { "hebraico": "וַֽיַּעַמְדוּ֙", "transliteral": "way-ya-ʿam-ḏû", "traducao_palavra": "e pararam" },
        { "hebraico": "מָאתַ֣יִם", "transliteral": "mā-ṯa-yim", "traducao_palavra": "duzentos" },
        { "hebraico": "אִ֔ישׁ", "transliteral": "ʾîš", "traducao_palavra": "homens" },
        { "hebraico": "אֲשֶׁ֣ר", "transliteral": "ʾă-šer", "traducao_palavra": "que" },
        { "hebraico": "פִּגְּר֔וּ", "transliteral": "pig-gə-rû", "traducao_palavra": "cansaram-se/ficaram exaustos" },
        { "hebraico": "מֵעֲבֹ֖ר", "transliteral": "mê-ʿă-ḇōr", "traducao_palavra": "de passar" },
        { "hebraico": "אֶת־נַ֥חַל", "transliteral": "ʾeṯ-na-ḥal", "traducao_palavra": "o ribeiro de" },
