        { "hebraico": "חָלִ֖יתִי", "transliteral": "ḥā-lî-ṯî", "traducao_palavra": "adoeci" },
        { "hebraico": "הַיֹּ֥ום", "transliteral": "hay-yôm", "traducao_palavra": "[há] hoje" },
        { "hebraico": "שְׁלֹשָֽׁה׃", "transliteral": "šə-lō-šā", "traducao_palavra": "três [dias]" }
      ]
    },
    "14": {
      "traducao_completa": "Nós invadimos o sul dos quereteus, e o que pertence a Judá, e o sul de Calebe; e queimamos a Ziclague pelo fogo.",
      "palavras": [
        { "hebraico": "אֲנַ֜חְנוּ", "transliteral": "ʾă-naḥ-nû", "traducao_palavra": "nós" },
        { "hebraico": "פָּשַׁ֣טְנוּ", "transliteral": "pā-šaṭ-nû", "traducao_palavra": "invadimos/atacamos" },
        { "hebraico": "נֶ֣גֶב", "transliteral": "ne-ḡeḇ", "traducao_palavra": "[o] sul de" },
        { "hebraico": "הַכְּרֵתִ֗י", "transliteral": "hak-kə-rê-ṯî", "traducao_palavra": "os quereteus" },
        { "hebraico": "וְעַל־אֲשֶׁר", "transliteral": "wə-ʿal-ʾă-šer", "traducao_palavra": "e sobre o que" },
        { "hebraico": "לִיהוּדָה", "transliteral": "lî-hû-ḏā", "traducao_palavra": "[pertence] a Judá" },
        { "hebraico": "וְעַל־נֶ֣גֶב", "transliteral": "wə-ʿal-ne-ḡeḇ", "traducao_palavra": "e sobre o sul de" },
        { "hebraico": "כָּלֵ֑ב", "transliteral": "kā-lêḇ", "traducao_palavra": "Calebe" },
        { "hebraico": "וְאֶת־צִקְלַ֖ג", "transliteral": "wə-ʾeṯ-ṣiq-laḡ", "traducao_palavra": "e a Ziclague" },
        { "hebraico": "שָׂרַ֥פְנוּ", "transliteral": "śā-rap̄-nû", "traducao_palavra": "queimamos" },
        { "hebraico": "בָאֵֽשׁ׃", "transliteral": "ḇā-ʾēš", "traducao_palavra": "no fogo" }
      ]
    },
    "15": {
      "traducao_completa": "E disse-lhe Davi: Poderias descer-me a essa tropa? E disse ele: Jura-me por Deus que não me matarás, nem me entregarás na mão de meu senhor, e eu te descerei a essa tropa.",
      "palavras": [
        { "hebraico": "וַיֹּ֤אמער", "transliteral": "way-yō-mer", "traducao_palavra": "e disse" },
        { "hebraico": "אֵלָיו֙", "transliteral": "ʾē-lāyw", "traducao_palavra": "a ele" },
        { "hebraico": "דָּוִ֔ד", "transliteral": "dā-wiḏ", "traducao_palavra": "Davi" },
        { "hebraico": "הֲתֹורִדֵ֖נִי", "transliteral": "hă-ṯô-ri-ḏê-nî", "traducao_palavra": "acaso descerás a mim" },
        { "hebraico": "אֶל־הַגְּד֥וּד", "transliteral": "ʾel-hag-gə-ḏûḏ", "traducao_palavra": "a esta tropa" },
        { "hebraico": "הַזֶּ֑ה", "transliteral": "haz-zeh", "traducao_palavra": "esta" },
        { "hebraico": "וַיֹּ֡אמֶר", "transliteral": "way-yō-mer", "traducao_palavra": "e disse ele" },
        { "hebraico": "הִשָּׁבְעָה־לִּ֨י", "transliteral": "hiš-šā-ḇə-ʿā-lî", "traducao_palavra": "jura para mim" },
        { "hebraico": "בֵאלֹהִ֜ים", "transliteral": "ḇê-lō-hîm", "traducao_palavra": "por Deus" },
        { "hebraico": "אִם־תְּמִיתֵ֗נִי", "transliteral": "ʾim-tə-mî-ṯê-nî", "traducao_palavra": "que não matarás a mim" },
        { "hebraico": "וְאִם־תַּסְגִּירֵ֙נִי֙", "transliteral": "wə-ʾim-tas-gî-rê-nî", "traducao_palavra": "e que não entregarás a mim" },
        { "hebraico": "בְּיַד־אֲדֹנִ֔י", "transliteral": "bə-yaḏ-ʾă-ḏō-nî", "traducao_palavra": "na mão de meu senhor" },
        { "hebraico": "וְאֹורִדְךָ֖", "transliteral": "wə-ʾô-riḏ-ḵā", "traducao_palavra": "e descerei a ti" },
        { "hebraico": "אֶל־הַגְּד֥וּד", "transliteral": "ʾel-hag-gə-ḏûḏ", "traducao_palavra": "a esta tropa" },
        { "hebraico": "הַזֶּֽה׃", "transliteral": "haz-zeh", "traducao_palavra": "esta" }
      ]
    },
    "16": {
      "traducao_completa": "E descendo-o, eis que estavam espalhados sobre a face de toda a terra, comendo, e bebendo, e dançando, por todo aquele grande despojo que tinham tomado da terra dos filisteus e da terra de Judá.",
      "palavras": [
        { "hebraico": "וַיֹּרִדֵהוּ", "transliteral": "way-yô-ri-ḏê-hû", "traducao_palavra": "e ele o desceu" },
        { "hebraico": "וְהִנֵּה", "transliteral": "wə-hin-nēh", "traducao_palavra": "e eis que" },
        { "hebraico": "נְטֻשִׁים", "transliteral": "nə-ṭu-šîm", "traducao_palavra": "[estavam] espalhados" },
        { "hebraico": "עַל־פְּנֵי", "transliteral": "ʿal-pə-nê", "traducao_palavra": "sobre a face de" },
        { "hebraico": "כָל־הָאָרֶץ", "transliteral": "ḵāl-hā-ʾā-reṣ", "traducao_palavra": "toda a terra" },
        { "hebraico": "אֹכְלִים", "transliteral": "ʾō-ḵə-lîm", "traducao_palavra": "comendo" },
        { "hebraico": "וְשֹׁתִים", "transliteral": "wə-šō-ṯîm", "traducao_palavra": "e bebendo" },
        { "hebraico": "וְחֹגְגִים", "transliteral": "wə-ḥō-ḡə-ḡîm", "traducao_palavra": "e dançando/festejando" },
        { "hebraico": "בְּכֹל", "transliteral": "bə-ḵōl", "traducao_palavra": "por todo" },
        { "hebraico": "הַשָּׁלָל", "transliteral": "haš-šā-lāl", "traducao_palavra": "o despojo" },
        { "hebraico": "הַגָּדֹול", "transliteral": "hag-gā-ḏôl", "traducao_palavra": "o grande" },
        { "hebraico": "אֲשֶׁר", "transliteral": "ʾă-šer", "traducao_palavra": "que" },
        { "hebraico": "לָקְחוּ", "transliteral": "lā-qə-ḥû", "traducao_palavra": "tomaram" },
        { "hebraico": "מֵאֶרֶץ", "transliteral": "mê-ʾe-reṣ", "traducao_palavra": "da terra de" },
        { "hebraico": "פְּלִשְׁתִּים", "transliteral": "pə-liš-tîm", "traducao_palavra": "filisteus" },
        { "hebraico": "וּמֵאֶרֶץ", "transliteral": "ū-mê-ʾe-reṣ", "traducao_palavra": "e da terra de" },
        { "hebraico": "יְהוּדָה", "transliteral": "yə-hû-ḏā", "traducao_palavra": "Judá" }
      ]
    },
    "17": {
      "traducao_completa": "E feriu-os Davi desde o crepúsculo até à tarde do dia seguinte; e nenhum deles escapou, senão quatrocentos moços que, montados sobre camelos, fugiram.",
      "palavras": [
        { "hebraico": "וַיַּכֵּם", "transliteral": "way-yak-kêm", "traducao_palavra": "e feriu eles" },
        { "hebraico": "דָּוִד", "transliteral": "dā-wiḏ", "traducao_palavra": "Davi" },
        { "hebraico": "מֵהַנֶּשֶׁף", "transliteral": "mê-han-ne-šep̄", "traducao_palavra": "desde o crepúsculo" },
        { "hebraico": "וְעַד־הָעֶרֶב", "transliteral": "wə-ʿaḏ-hā-ʿe-reḇ", "traducao_palavra": "e até a tarde" },
        { "hebraico": "לְֽמָחֳרָתָם", "transliteral": "lə-mā-ḥo-rā-ṯām", "traducao_palavra": "do dia seguinte deles" },
        { "hebraico": "וְלֹֽא־נִמְלַט", "transliteral": "wə-lō-nim-laṭ", "traducao_palavra": "e não escapou" },
        { "hebraico": "מֵהֶם", "transliteral": "mê-hem", "traducao_palavra": "deles" },
        { "hebraico": "אִ֕ישׁ", "transliteral": "ʾîš", "traducao_palavra": "um homem [sequer]" },
        { "hebraico": "כִּֽי־אִם־אַרְבַּע", "transliteral": "kî-ʾim-ʾar-baʿ", "traducao_palavra": "exceto quatro" },
        { "hebraico": "מֵאֹות", "transliteral": "mê-ʾôṯ", "traducao_palavra": "centenas [de]" },
        { "hebraico": "אִ֨ישׁ", "transliteral": "ʾîš", "traducao_palavra": "homens" },
        { "hebraico": "נַ֔עַר", "transliteral": "na-ʿar", "traducao_palavra": "jovens" },
        { "hebraico": "אֲשֶׁר־רָכְב֥וּ", "transliteral": "ʾă-šer-rā-ḵə-ḇû", "traducao_palavra": "que cavalgaram" },
        { "hebraico": "עַל־הַגְּמַלִּ֖ים", "transliteral": "ʿal-hag-gə-mal-lîm", "traducao_palavra": "sobre os camelos" },
        { "hebraico": "וַיָּנֻֽסוּ", "transliteral": "way-yā-nu-śû", "traducao_palavra": "e fugiram" }
      ]
    },
    "18": {
      "traducao_completa": "Assim libertou Davi tudo quanto os amalequitas tinham tomado; também libertou Davi as suas duas mulheres.",
      "palavras": [
        { "hebraico": "וַיַּצֵּ֣ל", "transliteral": "way-yaṣ-ṣēl", "traducao_palavra": "e livrou/recuperou" },
        { "hebraico": "דָּוִ֔ד", "transliteral": "dā-wiḏ", "traducao_palavra": "Davi" },
        { "hebraico": "אֵת", "transliteral": "ʾêṯ", "traducao_palavra": "[objeto]" },
        { "hebraico": "כָּל־אֲשֶׁ֥ר", "transliteral": "kāl-ʾă-šer", "traducao_palavra": "tudo o que" },
        { "hebraico": "לָקְח֖וּ", "transliteral": "lā-qə-ḥû", "traducao_palavra": "tomaram" },
        { "hebraico": "עֲמָלֵ֑ק", "transliteral": "ʿă-mā-lêq", "traducao_palavra": "Amaleque" },
        { "hebraico": "וְאֶת־שְׁתֵּ֥י", "transliteral": "wə-ʾeṯ-šə-ṯê", "traducao_palavra": "e as duas" },
        { "hebraico": "נָשָׁ֖יו", "transliteral": "nā-šāyw", "traducao_palavra": "mulheres dele" },
        { "hebraico": "הִצִּ֥יל", "transliteral": "hiṣ-ṣîl", "traducao_palavra": "livrou" },
        { "hebraico": "דָּוִֽד׃", "transliteral": "dā-wiḏ", "traducao_palavra": "Davi" }
      ]
    },
    "19": {
      "traducao_completa": "E não lhes faltou coisa alguma, desde o pequeno até ao grande, e até os filhos e as filhas; e desde o despojo até tudo quanto lhes tinham tomado, tudo Davi tornou a trazer.",
      "palavras": [
        { "hebraico": "וְלֹ֤א", "transliteral": "wə-lō", "traducao_palavra": "e não" },
        { "hebraico": "נֶעְדַּר־לָהֶם", "transliteral": "ne-ʿə-dar-lā-hem", "traducao_palavra": "faltou a eles" },
        { "hebraico": "מִן־הַקָּטֹ֨ן", "transliteral": "min-haq-qā-ṭōn", "traducao_palavra": "desde o pequeno" },
