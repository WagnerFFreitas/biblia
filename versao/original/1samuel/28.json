        { "hebraico": "עֵֽגֶל־מַרְבֵּק֙", "transliteral": "ʿê-ḡel-mar-bēq", "traducao_palavra": "um bezerro cevado" },
        { "hebraico": "בַּבַּ֔יִת", "transliteral": "bab-ba-yit", "traducao_palavra": "em casa" },
        { "hebraico": "וַתְּמַהֵ֖ר", "transliteral": "wat-tə-ma-hêr", "traducao_palavra": "e apressou-se" },
