        { "hebraico": "וַיָּקֻ֖מוּ", "transliteral": "way-yā-qu-mû", "traducao_palavra": "e levantaram-se" },
        { "hebraico": "וַיֵּלְכ֖וּ", "transliteral": "way-yê-lə-ḵû", "traducao_palavra": "e foram/partiram" },
