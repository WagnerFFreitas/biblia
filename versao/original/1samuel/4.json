        { "hebraico": "שָׁנָֽה׃", "transliteral": "šā-nā", "traducao_palavra": "anos" }
      ]
    },
    "19": {
      "traducao_completa": "E estando sua nora, a mulher de Fineias, grávida, e próxima ao parto, e ouvindo estas novas, de que a arca de Deus fora tomada e de que seu sogro e seu marido haviam morrido, encurvou-se e deu à luz; porquanto as dores lhe sobrevieram.",
      "palavras": [
