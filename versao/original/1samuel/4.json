        { "hebraico": "עָנְתָ֖ה", "transliteral": "ʿā-nə-ṯā", "traducao_palavra": "respondeu" },
        { "hebraico": "וְלֹא־שָׁ֥תָה", "transliteral": "wə-lō-šā-ṯā", "traducao_palavra": "e não pôs" },
