        { "hebraico": "וַתִּשָּׁבֵ֥ר", "transliteral": "wat-tiš-šā-ḇēr", "traducao_palavra": "e quebrou-se" },
        { "hebraico": "מַפְרַקְתֹּו֙", "transliteral": "map̄-raq-tô", "traducao_palavra": "o pescoço dele" },
