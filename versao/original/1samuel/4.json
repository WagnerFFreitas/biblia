        { "hebraico": "וַיִּפֹּ֣ל", "transliteral": "way-yip-pōl", "traducao_palavra": "e caiu" },
        { "hebraico": "מֵֽעַל־הַכִּסֵּ֨א", "transliteral": "mê-ʿal-hak-kis-sē", "traducao_palavra": "de sobre a cadeira" },
        { "hebraico": "אֲחֹ֨רַנִּ֜י", "transliteral": "ʾă-ḥō-ran-nî", "traducao_palavra": "para trás" },
