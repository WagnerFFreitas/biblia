        { "hebraico": "וַתְּדַבֵּ֙רְנָה֙", "transliteral": "wat-tə-ḏab-bêr-nā", "traducao_palavra": "e disseram" },
        { "hebraico": "הַנִּצָּבֹ֣ות", "transliteral": "han-niṣ-ṣā-ḇôṯ", "traducao_palavra": "as que estavam" },
